      "id": "P-TDIST-01",
      "anchor": "p-tdist-01",
      "title": "P-TDIST-01（有限 Hermitian 正负谱分解及实际绝对值）。",
      "author_title": "有限 Hermitian 正负谱分解及实际 CFC 绝对值",
      "premises": [
        "任意有限载体及 DecidableEq",
        "实际复 Hermitian 矩阵 H"
      ],
      "quantified_scope": "全部该类有限 Hermitian 矩阵，包括零特征值；谱存在来自已锁定数学库。",
      "claim": "由实际有限复 Hermitian 矩阵的酉谱分解构造 PSD 正负部分，证明 H=P-N、CFC.abs H=P+N 以及实迹等于绝对特征值有限和。",
      "main_declarations": [
        "UEOTQM.QuantumTraceDistance.positivePart_sub_negativePart",
        "UEOTQM.QuantumTraceDistance.abs_eq_positivePart_add_negativePart",
        "UEOTQM.QuantumTraceDistance.traceAbsolute_eq_sum_abs_eigenvalues"
      ],
      "support_declarations": [
        "UEOTQM.QuantumTraceDistance.unitaryDiagonal_posSemidef",
        "UEOTQM.QuantumTraceDistance.mass_unitaryDiagonal",
        "UEOTQM.QuantumTraceDistance.positivePart_posSemidef",
        "UEOTQM.QuantumTraceDistance.negativePart_posSemidef",
        "UEOTQM.QuantumTraceDistance.traceAbsolute_nonneg"
      ],
      "witnesses": [
        "UEOTQM.QuantumTraceDistanceExamples.rational_traceAbsolute",
        "UEOTQM.QuantumTraceDistanceExamples.phase_traceAbsolute",
        "UEOTQM.QuantumTraceDistanceExamples.equal_states_traceAbsolute_zero"
      ],
      "proof_outline": [
        "酉共轭运输实际加、减、乘与迹。",
        "两个非负标量部分给 PSD 矩阵；逐特征值减法恢复 H。",
        "标准 CFC.abs 与 Hermitian 连续函数演算绝对值一致，标量绝对值等于两部分之和；取迹。"
      ],
      "limits": [
        "谱基为 noncomputable 存在选择；没有声称数值求谱算法。",
        "未建立任意矩阵的全部范数公理或 NormedSpace 实例。"
      ],
