    {
      "id": "P-DEC-01",
      "anchor": "p-dec-01",
      "title": "P-DEC-01（等先验二元判别的真实最优成功率）。",
      "author_title": "等先验二元决定的真实最优成功率",
      "premises": [
        "任意有限完整复密度态对",
        "两个先验均为 1/2",
        "效应 E 时猜第一态，互补效应时猜第二态"
      ],
      "quantified_scope": "全部合法二元效应决定的概率优化；包含一个实际达到上界的效应。",
      "claim": "实际效应和互补效应产生的等先验二元成功率对所有效应不超过 (1+d)/2，所构造正谱效应达到该值；因此最优成功率为 1/2+Tr|ρ-σ|/4。",
      "main_declarations": [
        "UEOTQM.BinaryDiscrimination.equalPriorSuccess_le",
        "UEOTQM.BinaryDiscrimination.positiveSpectrumEffect_success",
        "UEOTQM.BinaryDiscrimination.exists_optimal_equalPriorDecision",
        "UEOTQM.BinaryDiscrimination.optimal_equalPriorSuccess_traceAbsolute"
      ],
      "support_declarations": [
        "UEOTQM.BinaryDiscrimination.equalPriorSuccess",
        "UEOTQM.BinaryDiscrimination.equalPriorSuccess_eq"
      ],
      "witnesses": [
        "UEOTQM.QuantumTraceDistanceExamples.rational_optimal_success",
        "UEOTQM.QuantumTraceDistanceExamples.rational_all_decisions_le",
        "UEOTQM.QuantumTraceDistanceExamples.phase_optimal_success"
      ],
      "proof_outline": [
        "用互补概率将成功率写成 (1+带符号概率差)/2。",
        "实际概率差的绝对值不超过原全效应距离。",
        "正谱效应的达到性给实际最优决定和半迹表达。"
      ],
      "limits": [
        "没有一般不等先验最优式。",
        "概率最优性不指定或唯一确定测量后仪器动力学。"
      ],
