    {
      "id": "P-TCERT-01",
      "anchor": "p-tcert-01",
      "title": "P-TCERT-01（PSD 支持分解距离证书）。",
      "author_title": "非循环 PSD 支持分解与精确给定酉数据证书",
      "premises": [
        "原实际密度态及合法效应",
        "P、N 实际 PSD",
        "实际差分解等式与两个支持等式；或实际 U 酉、d 实数及 H=Udiag(d)U†"
      ],
      "quantified_scope": "任意有限复模型中的满足所列输入矩阵条件的证书；不将距离、最终上界或最优性作为输入。",
      "claim": "给实际 PSD 分解 ρ-σ=P-N、合法 E 和乘法证据 EP=P、EN=0，即精确得到距离 TrP 及最优决定；给实际有限酉对角化可独立构造这些条件并得到有限正部和/绝对值和公式。",
      "main_declarations": [
        "UEOTQM.BinaryDiscrimination.effectDistance_eq_mass_of_support_certificate",
        "UEOTQM.BinaryDiscrimination.success_eq_optimum_of_support_certificate",
        "UEOTQM.BinaryDiscrimination.effectDistance_eq_sum_positive_of_unitary_data",
        "UEOTQM.BinaryDiscrimination.effectDistance_eq_half_sum_abs_of_unitary_data"
      ],
      "support_declarations": [
        "UEOTQM.QuantumTraceDistance.effectDistance_le_mass_of_psd_split",
        "UEOTQM.QuantumTraceDistance.unitaryDiagonal_mul",
        "UEOTQM.QuantumTraceDistance.unitaryDiagonal_posSemidef",
        "UEOTQM.QuantumTraceDistance.mass_unitaryDiagonal"
      ],
      "witnesses": [
        "UEOTQM.QuantumTraceDistanceExamples.rational_difference_split",
        "UEOTQM.QuantumTraceDistanceExamples.rational_support_positive",
        "UEOTQM.QuantumTraceDistanceExamples.rational_support_negative",
        "UEOTQM.QuantumTraceDistanceExamples.rational_positive_mass",
        "UEOTQM.QuantumTraceDistanceExamples.arbitrary_psd_split_is_not_exact",
        "UEOTQM.QuantumTraceDistanceExamples.overlappingParts_have_no_support_effect",
        "UEOTQM.QuantumTraceDistanceExamples.certificateMatrix_adjoint_mul",
        "UEOTQM.QuantumTraceDistanceExamples.exact_supplied_diagonalization",
        "UEOTQM.QuantumTraceDistanceExamples.exact_unitary_certificate_distance"
      ],
      "proof_outline": [
        "PSD 分解给全部效应上界；实际支持等式使所给 E 的概率差正好为 TrP，提供下界。",
        "给定酉数据时以 max(d,0)、max(-d,0) 和正谱指示系数构造独立矩阵证据。",
        "迹零再次将两个正部和联系起来，得到一半绝对值和。"
      ],
      "limits": [
        "仅有任意 PSD 差分解只保证上界，不能保证精确；重叠正负部分给实际反例。",
        "给定有限数据的精确核验不等于已实现对任意矩阵的数值求谱算法。"
      ],
