    {
      "id": "P-TDIST-02",
      "anchor": "p-tdist-02",
      "title": "P-TDIST-02（全效应距离的半迹绝对值公式及最优效应）。",
      "author_title": "完整有限复密度态的半迹绝对值距离及合法最优效应",
      "premises": [
        "任意有限载体及 DecidableEq",
        "ρ、σ 为原完整 Density 类型的实际态，均 PSD 且迹为一"
      ],
      "quantified_scope": "全部有限复密度态对，不要求纯态、可交换或共同可对角化。",
      "claim": "原全效应距离等于 Tr|ρ-σ|/2，等于绝对特征值和的一半；正谱投影是合法效应，且其带符号概率差实际达到该距离。",
      "main_declarations": [
        "UEOTQM.QuantumTraceDistance.effectDistance_eq_positivePart_mass",
        "UEOTQM.QuantumTraceDistance.positiveSpectrumEffect_attains",
        "UEOTQM.QuantumTraceDistance.effectDistance_eq_half_traceAbsolute",
        "UEOTQM.QuantumTraceDistance.effectDistance_eq_half_sum_abs_eigenvalues"
      ],
      "support_declarations": [
        "UEOTQM.QuantumTraceDistance.positiveSpectrumEffect",
        "UEOTQM.QuantumTraceDistance.positiveSpectrumEffect_idempotent",
        "UEOTQM.QuantumTraceDistance.positiveSpectrumEffect_mul_positivePart",
        "UEOTQM.QuantumTraceDistance.positiveSpectrumEffect_mul_negativePart",
        "UEOTQM.QuantumTraceDistance.positiveSpectrumEffect_pairing",
        "UEOTQM.QuantumTraceDistance.difference_parts_mass_eq",
        "UEOTQM.QuantumTraceDistance.effectDistance_le_mass_of_psd_split"
      ],
      "witnesses": [
        "UEOTQM.QuantumTraceDistanceExamples.rational_effectDistance",
        "UEOTQM.QuantumTraceDistanceExamples.mixed_states_noncommute",
        "UEOTQM.QuantumTraceDistanceExamples.rational_test_probability_rho",
        "UEOTQM.QuantumTraceDistanceExamples.rational_test_probability_sigma",
        "UEOTQM.QuantumTraceDistanceExamples.phase_effectDistance",
        "UEOTQM.QuantumTraceDistanceExamples.all_real_effects_miss_phase",
        "UEOTQM.QuantumTraceDistanceExamples.all_diagonal_effects_miss_phase",
        "UEOTQM.QuantumTraceDistanceExamples.nonzero_trace_half_formula_fails"
      ],
      "proof_outline": [
        "PSD 分解对全部合法效应给配对上下界，密度差零迹使正负迹相等。",
        "正谱指示函数及其补函数皆非负，构成真实合法效应；实际支持等式给匹配下界。",
        "上确界上下界相等；实际绝对值等于两部分和，因此出现且仅此处使用因子 1/2。"
      ],
      "limits": [
        "半迹公式使用密度差零迹；一般非零迹 Hermitian 配对不能直接套用。",
        "未证明通道 diamond 范数或物理自然唯一性。"
      ],
