import UEOTQM.Operational
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.LinearAlgebra.Complex.FiniteDimensional

/-!
# The finite observable space of the actual quantum record model

The Heisenberg map below is the trace dual of the existing Kraus map, proved
from matrix multiplication and cyclicity of the trace. Record effects are
therefore generated by the same chronological words as `recordOperator`.

`observableSpace` is the real span of all such effects. It is the smallest
real subspace containing the identity and closed under each allowed branch
pullback. Equality of all record responses is equivalent to equality of the
trace pairings on this space. Its finite dimensionality is inherited from
finite complex matrices; no finite-horizon test is substituted for closure.
-/

namespace UEOTQM

open Matrix
open scoped BigOperators ComplexOrder

noncomputable section

variable {ι κ O A : Type*} [Fintype ι] [DecidableEq ι]
  [Fintype κ] [Fintype O]

/-- Real trace pairing, real-linear in both arguments. -/
def pairing (E X : Operator ι) : ℝ := mass (E * X)

@[simp] theorem pairing_one (X : Operator ι) : pairing 1 X = mass X := by
  simp [pairing]

@[simp] theorem pairing_zero_left (X : Operator ι) : pairing 0 X = 0 := by
  simp [pairing, mass]

theorem pairing_add_left (E F X : Operator ι) :
    pairing (E + F) X = pairing E X + pairing F X := by
  simp [pairing, mass, add_mul]

theorem pairing_smul_left (r : ℝ) (E X : Operator ι) :
    pairing (r • E) X = r * pairing E X := by
  simp only [pairing, Matrix.smul_mul, mass_smul]

theorem pairing_smul_right (r : ℝ) (E X : Operator ι) :
    pairing E (r • X) = r * pairing E X := by
  simp only [pairing, Matrix.mul_smul, mass_smul]

/-- Bundling only the proved real linearity of the trace pairing. -/
def pairingLinear (X : Operator ι) : Operator ι →ₗ[ℝ] ℝ where
  toFun E := pairing E X
  map_add' E F := pairing_add_left E F X
  map_smul' r E := by
    simpa only [smul_eq_mul, RingHom.id_apply] using pairing_smul_left r E X

theorem pairing_sum_left {β : Type*} (s : Finset β) (E : β → Operator ι)
    (X : Operator ι) : pairing (∑ j ∈ s, E j) X = ∑ j ∈ s, pairing (E j) X := by
  exact map_sum (pairingLinear X) E s

/-- The actual Kraus trace-dual map. -/
def heisenberg (K : κ → Operator ι) (E : Operator ι) : Operator ι :=
  ∑ k, (K k)ᴴ * E * K k

@[simp] theorem heisenberg_zero (K : κ → Operator ι) : heisenberg K 0 = 0 := by
  simp [heisenberg]

theorem heisenberg_add (K : κ → Operator ι) (E F : Operator ι) :
    heisenberg K (E + F) = heisenberg K E + heisenberg K F := by
  simp only [heisenberg, Matrix.mul_add, Matrix.add_mul, Finset.sum_add_distrib]

theorem heisenberg_smul (K : κ → Operator ι) (r : ℝ) (E : Operator ι) :
    heisenberg K (r • E) = r • heisenberg K E := by
  simp only [heisenberg, Matrix.mul_smul, Matrix.smul_mul, Finset.smul_sum]

def heisenbergLinear (K : κ → Operator ι) : Operator ι →ₗ[ℝ] Operator ι where
  toFun := heisenberg K
  map_add' := heisenberg_add K
  map_smul' r E := heisenberg_smul K r E

/-- The trace-dual identity follows from the concrete Kraus formula. -/
theorem trace_heisenberg (K : κ → Operator ι) (E X : Operator ι) :
    (E * krausMap K X).trace = (heisenberg K E * X).trace := by
  simp only [krausMap, heisenberg, Matrix.mul_sum, Matrix.sum_mul, Matrix.trace_sum]
  apply Finset.sum_congr rfl
  intro k _
  calc
    (E * (K k * X * (K k)ᴴ)).trace = ((E * K k) * X * (K k)ᴴ).trace := by
      simp only [Matrix.mul_assoc]
    _ = ((K k)ᴴ * (E * K k) * X).trace :=
      Matrix.trace_mul_cycle (E * K k) X (K k)ᴴ
    _ = ((K k)ᴴ * E * K k * X).trace := by
      simp only [Matrix.mul_assoc]

theorem pairing_heisenberg (K : κ → Operator ι) (E X : Operator ι) :
    pairing E (krausMap K X) = pairing (heisenberg K E) X := by
  exact congrArg Complex.re (trace_heisenberg K E X)

theorem heisenberg_posSemidef (K : κ → Operator ι) {E : Operator ι}
    (hE : E.PosSemidef) : (heisenberg K E).PosSemidef := by
  apply Matrix.posSemidef_sum Finset.univ
  intro k _
  simpa only [Matrix.conjTranspose_conjTranspose] using
    hE.mul_mul_conjTranspose_same ((K k)ᴴ)

/-- Empty records read total mass. Prefixing an operation pulls the continuation
effect back through that operation, in chronological word order. -/
def recordEffect (I : A → Instrument ι O κ) : List (A × O) → Operator ι
  | [] => 1
  | e :: w => heisenberg ((I e.1).kraus e.2) (recordEffect I w)

theorem recordEffect_posSemidef (I : A → Instrument ι O κ) (w : List (A × O)) :
    (recordEffect I w).PosSemidef := by
  induction w with
  | nil => exact Matrix.PosSemidef.one
  | cons e w ih => exact heisenberg_posSemidef ((I e.1).kraus e.2) ih

theorem recordEffect_isHermitian (I : A → Instrument ι O κ) (w : List (A × O)) :
    (recordEffect I w).IsHermitian :=
  (recordEffect_posSemidef I w).isHermitian

/-- Agreement of the Schrödinger record recursion and Heisenberg word effects
holds on all operators, before state positivity or normalization is used. -/
theorem mass_recordOperator_eq_pairing (I : A → Instrument ι O κ)
    (w : List (A × O)) (X : Operator ι) :
    mass (recordOperator I w X) = pairing (recordEffect I w) X := by
  induction w generalizing X with
  | nil => simp [recordOperator, recordEffect]
  | cons e w ih =>
    change mass (recordOperator I w ((I e.1).branch e.2 X)) =
      pairing (heisenberg ((I e.1).kraus e.2) (recordEffect I w)) X
    rw [ih]
    exact pairing_heisenberg ((I e.1).kraus e.2) (recordEffect I w) X

theorem response_eq_pairing (I : A → Instrument ι O κ) (ρ : Density ι)
    (w : List (A × O)) : response I ρ w = pairing (recordEffect I w) ρ.matrix :=
  mass_recordOperator_eq_pairing I w ρ.matrix

/-- The complete real observable space for the declared operation library. -/
def observableSpace (I : A → Instrument ι O κ) : Submodule ℝ (Operator ι) :=
  Submodule.span ℝ (Set.range (recordEffect I))

theorem recordEffect_mem (I : A → Instrument ι O κ) (w : List (A × O)) :
    recordEffect I w ∈ observableSpace I :=
  Submodule.subset_span ⟨w, rfl⟩

theorem one_mem_observableSpace (I : A → Instrument ι O κ) :
    (1 : Operator ι) ∈ observableSpace I := recordEffect_mem I []

/-- A local invariance condition on a real subspace; it does not contain the
conclusion that all record words are covered. -/
def PullbackClosed (I : A → Instrument ι O κ) (W : Submodule ℝ (Operator ι)) : Prop :=
  ∀ e : A × O, ∀ E ∈ W, heisenberg ((I e.1).kraus e.2) E ∈ W

theorem recordEffect_mem_of_closed (I : A → Instrument ι O κ)
    (W : Submodule ℝ (Operator ι)) (h1 : (1 : Operator ι) ∈ W)
    (hW : PullbackClosed I W) (w : List (A × O)) : recordEffect I w ∈ W := by
  induction w with
  | nil => exact h1
  | cons e w ih => exact hW e (recordEffect I w) ih

theorem observableSpace_le_of_closed (I : A → Instrument ι O κ)
    (W : Submodule ℝ (Operator ι)) (h1 : (1 : Operator ι) ∈ W)
    (hW : PullbackClosed I W) : observableSpace I ≤ W := by
  apply Submodule.span_le.mpr
  rintro E ⟨w, rfl⟩
  exact recordEffect_mem_of_closed I W h1 hW w

theorem observableSpace_pullbackClosed (I : A → Instrument ι O κ) :
    PullbackClosed I (observableSpace I) := by
  intro e E hE
  change E ∈ Submodule.span ℝ (Set.range (recordEffect I)) at hE
  induction hE using Submodule.span_induction with
  | mem E hE =>
    rcases hE with ⟨w, rfl⟩
    exact recordEffect_mem I (e :: w)
  | zero =>
    rw [heisenberg_zero]
    exact (observableSpace I).zero_mem
  | add E F hE hF ihE ihF =>
    rw [heisenberg_add]
    exact (observableSpace I).add_mem ihE ihF
  | smul r E hE ih =>
    rw [heisenberg_smul]
    exact (observableSpace I).smul_mem r ih

/-- Real linear combinations of the positive word effects remain Hermitian.
The observable space is a real space, not the complex span of its effects. -/
theorem isHermitian_of_mem_observableSpace (I : A → Instrument ι O κ)
    {E : Operator ι} (hE : E ∈ observableSpace I) : E.IsHermitian := by
  change E ∈ Submodule.span ℝ (Set.range (recordEffect I)) at hE
  induction hE using Submodule.span_induction with
  | mem E hE =>
    rcases hE with ⟨w, rfl⟩
    exact recordEffect_isHermitian I w
  | zero => simp [Matrix.IsHermitian]
  | add E F hE hF ihE ihF => exact ihE.add ihF
  | smul r E hE ih => exact ih.smul (show IsSelfAdjoint r from rfl)

/-- Agreement of the real pairing on the generating effects extends to their
entire real span, and conversely every word effect belongs to that span. -/
theorem response_eq_iff_pairing_observableSpace (I : A → Instrument ι O κ)
    (ρ σ : Density ι) :
    response I ρ = response I σ ↔
      ∀ E ∈ observableSpace I, pairing E ρ.matrix = pairing E σ.matrix := by
  constructor
  · intro h E hE
    have hgen : Set.EqOn (pairingLinear ρ.matrix) (pairingLinear σ.matrix)
        (Set.range (recordEffect I)) := by
      rintro F ⟨w, rfl⟩
      change pairing (recordEffect I w) ρ.matrix = pairing (recordEffect I w) σ.matrix
      rw [← response_eq_pairing, ← response_eq_pairing, h]
    exact LinearMap.eqOn_span hgen hE
  · intro h
    funext w
    rw [response_eq_pairing, response_eq_pairing]
    exact h (recordEffect I w) (recordEffect_mem I w)

/-- Finite complex matrices give a finite-dimensional real observable space.
This theorem does not assert correctness of any external basis-search code. -/
theorem observableSpace_finiteDimensional (I : A → Instrument ι O κ) :
    FiniteDimensional ℝ (observableSpace I) := by
  infer_instance

/-- Some finite collection of genuine word effects spans the whole observable
space. This is an existence result, independent of a search algorithm. -/
theorem exists_finite_wordEffect_generators (I : A → Instrument ι O κ) :
    ∃ S : Finset (Operator ι),
      (S : Set (Operator ι)) ⊆ Set.range (recordEffect I) ∧
      Submodule.span ℝ (S : Set (Operator ι)) = observableSpace I := by
  classical
  have hfg : (observableSpace I).FG :=
    (Submodule.fg_iff_finiteDimensional (observableSpace I)).mpr
      (observableSpace_finiteDimensional I)
  obtain ⟨T, hT⟩ := hfg
  have hTmem : (T : Set (Operator ι)) ⊆ Submodule.span ℝ (Set.range (recordEffect I)) := by
    intro E hE
    change E ∈ observableSpace I
    rw [← hT]
    exact Submodule.subset_span hE
  obtain ⟨S, hS, hTS⟩ := Submodule.subset_span_finite_of_subset_span hTmem
  refine ⟨S, hS, le_antisymm (Submodule.span_mono hS) ?_⟩
  rw [← hT]
  exact Submodule.span_le.mpr hTS

end

end UEOTQM
