open Classical

variable {α : Type*}

/-- Complete undirected edge set (no self-loops) on a finite vertex set `V : Finset α`. `[B]` -/
noncomputable def completeEdges [DecidableEq α] (V : Finset α) : Finset (Sym2 α) :=
  V.offDiag.image (fun p => s(p.1, p.2))

lemma mem_completeEdges_iff [DecidableEq α] {V : Finset α} {u v : α} :
    s(u, v) ∈ completeEdges V ↔ u ∈ V ∧ v ∈ V ∧ u ≠ v := by
  unfold completeEdges
  rw [Finset.mem_image]
  constructor
  · rintro ⟨⟨a, b⟩, hab, heq⟩
    rw [Finset.mem_offDiag] at hab
    rw [Sym2.eq_iff] at heq
    rcases heq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hab
    · exact ⟨hab.2.1, hab.1, hab.2.2.symm⟩
  · rintro ⟨hu, hv, huv⟩
    exact ⟨(u, v), Finset.mem_offDiag.mpr ⟨hu, hv, huv⟩, rfl⟩

/-- Graph adjacency on `E : Finset (Sym2 α)`. `[B]` -/
def gAdj (E : Finset (Sym2 α)) (u v : α) : Prop :=
  u ≠ v ∧ s(u, v) ∈ E

lemma gAdj_symm {E : Finset (Sym2 α)} {u v : α} (h : gAdj E u v) : gAdj E v u :=
  ⟨h.1.symm, by simpa [Sym2.eq_swap] using h.2⟩

lemma gAdj_mono {E₁ E₂ : Finset (Sym2 α)} (hsub : E₁ ⊆ E₂) {u v : α} (h : gAdj E₁ u v) :
    gAdj E₂ u v :=
  ⟨h.1, hsub h.2⟩

lemma gAdj_mem_left [DecidableEq α] {V : Finset α} {E : Finset (Sym2 α)}
    (hsub : E ⊆ completeEdges V) {u v : α} (h : gAdj E u v) : u ∈ V :=
  ((mem_completeEdges_iff).mp (hsub h.2)).1

lemma gAdj_mem_right [DecidableEq α] {V : Finset α} {E : Finset (Sym2 α)}
    (hsub : E ⊆ completeEdges V) {u v : α} (h : gAdj E u v) : v ∈ V :=
  ((mem_completeEdges_iff).mp (hsub h.2)).2.1

/-- Snoc-walk of length `k` from `r` to `v` in edge set `E`. `[B]` -/
def GWalk (E : Finset (Sym2 α)) (r : α) : α → ℕ → Prop
  | v, 0 => r = v
  | v, k + 1 => ∃ w : α, GWalk E r w k ∧ gAdj E w v

lemma gwalk_mono {E₁ E₂ : Finset (Sym2 α)} (hsub : E₁ ⊆ E₂) {r v : α} {k : ℕ}
    (hw : GWalk E₁ r v k) : GWalk E₂ r v k := by
  induction k generalizing v with
  | zero => exact hw
  | succ k ih =>
    obtain ⟨w, hw1, hw2⟩ := hw
    exact ⟨w, ih hw1, gAdj_mono hsub hw2⟩

/-- Spanning connectedness on `(V, r)`. `[B]` -/
def IsConnected [DecidableEq α] (V : Finset α) (r : α) (E : Finset (Sym2 α)) : Prop :=
  E ⊆ completeEdges V ∧ ∀ v ∈ V, ∃ k : ℕ, GWalk E r v k

/-- Spanning tree on `(V, r)`: connected subgraph with `|T| + 1 = |V|`. `[B]` -/
def IsSpanningTree [DecidableEq α] (V : Finset α) (r : α) (T : Finset (Sym2 α)) : Prop :=
  IsConnected V r T ∧ T.card + 1 = V.card

/-- Shortest-path distance from `r` to `v` in connected graph `E` (0 outside `V`). `[B]` -/
noncomputable def gDist [DecidableEq α] (V : Finset α) (r : α) (E : Finset (Sym2 α))
    (hconn : IsConnected V r E) (v : α) : ℕ :=
  if hv : v ∈ V then Nat.find (hconn.2 v hv) else 0

lemma gDist_spec [DecidableEq α] {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) :
    GWalk E r v (gDist V r E hconn v) := by
  unfold gDist
  rw [dif_pos hv]
  exact Nat.find_spec (hconn.2 v hv)

lemma gDist_le [DecidableEq α] {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) {k : ℕ} (hk : GWalk E r v k) :
    gDist V r E hconn v ≤ k := by
  unfold gDist
  rw [dif_pos hv]
  exact Nat.find_min' (hconn.2 v hv) hk

lemma gDist_root [DecidableEq α] {V : Finset α} {r : α} (hr : r ∈ V) {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) : gDist V r E hconn r = 0 :=
  Nat.eq_zero_of_le_zero (gDist_le hconn hr (rfl : GWalk E r r 0))

lemma gDist_pos_of_ne [DecidableEq α] {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) (hne : v ≠ r) :
    0 < gDist V r E hconn v := by
  by_contra h0
  have hd0 : gDist V r E hconn v = 0 := by omega
  have hw := gDist_spec hconn hv
  rw [hd0] at hw
  exact hne hw.symm

lemma gDist_adj_le [DecidableEq α] {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {u v : α} (hu : u ∈ V) (hv : v ∈ V) (hadj : gAdj E u v) :
    gDist V r E hconn v ≤ gDist V r E hconn u + 1 :=
  gDist_le hconn hv ⟨u, gDist_spec hconn hu, hadj⟩

lemma gDist_sub_abs_le_one [DecidableEq α] {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {u v : α} (hu : u ∈ V) (hv : v ∈ V) (hadj : gAdj E u v) :
    gDist V r E hconn v ≤ gDist V r E hconn u + 1 ∧
      gDist V r E hconn u ≤ gDist V r E hconn v + 1 :=
  ⟨gDist_adj_le hconn hu hv hadj, gDist_adj_le hconn hv hu (gAdj_symm hadj)⟩

section OrderedPenrose

variable [DecidableEq α]

/-- Candidate BFS parents of `v` in `E`. `[B]` -/
noncomputable def bfsPreds (V : Finset α) (r : α) (E : Finset (Sym2 α))
    (hconn : IsConnected V r E) (v : α) : Finset α :=
  V.filter (fun u => gAdj E u v ∧ gDist V r E hconn u + 1 = gDist V r E hconn v)

lemma bfsPreds_nonempty {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) (hne : v ≠ r) :
    (bfsPreds V r E hconn v).Nonempty := by
  have hpos := gDist_pos_of_ne hconn hv hne
  obtain ⟨d, hd⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
  have hw := gDist_spec hconn hv
  rw [hd] at hw
  obtain ⟨u, hwu, hadj⟩ := hw
  have hu : u ∈ V := gAdj_mem_left hconn.1 hadj
  refine ⟨u, Finset.mem_filter.mpr ⟨hu, hadj, ?_⟩⟩
  have hle : gDist V r E hconn u ≤ d := gDist_le hconn hu hwu
  have hge : gDist V r E hconn v ≤ gDist V r E hconn u + 1 := gDist_adj_le hconn hu hv hadj
  omega

variable [LinearOrder α]

/-- Unique minimum-label BFS parent of `v ∈ V \ {r}` (`r` outside `V \ {r}`). `[B]` -/
noncomputable def penroseParent (V : Finset α) (r : α) (E : Finset (Sym2 α))
    (hconn : IsConnected V r E) (v : α) : α :=
  if h : v ∈ V.erase r then
    (bfsPreds V r E hconn v).min'
      (bfsPreds_nonempty hconn (Finset.mem_of_mem_erase h) (Finset.ne_of_mem_erase h))
  else r

lemma penroseParent_mem_V {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) (hne : v ≠ r) :
    penroseParent V r E hconn v ∈ V := by
  unfold penroseParent
  have h : v ∈ V.erase r := Finset.mem_erase.mpr ⟨hne, hv⟩
  rw [dif_pos h]
  have hm := Finset.min'_mem (bfsPreds V r E hconn v)
    (bfsPreds_nonempty hconn (Finset.mem_of_mem_erase h) (Finset.ne_of_mem_erase h))
  exact (Finset.mem_filter.mp hm).1

lemma penroseParent_spec {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) (hne : v ≠ r) :
    gAdj E (penroseParent V r E hconn v) v ∧
    gDist V r E hconn (penroseParent V r E hconn v) + 1 = gDist V r E hconn v := by
  unfold penroseParent
  have h : v ∈ V.erase r := Finset.mem_erase.mpr ⟨hne, hv⟩
  rw [dif_pos h]
  have hm := Finset.min'_mem (bfsPreds V r E hconn v)
    (bfsPreds_nonempty hconn (Finset.mem_of_mem_erase h) (Finset.ne_of_mem_erase h))
  exact (Finset.mem_filter.mp hm).2

lemma penroseParent_le {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) {v : α} (hv : v ∈ V) (hne : v ≠ r)
    {u : α} (hu : u ∈ V) (hadj : gAdj E u v)
    (hdist : gDist V r E hconn u + 1 = gDist V r E hconn v) :
    penroseParent V r E hconn v ≤ u := by
  unfold penroseParent
  have h : v ∈ V.erase r := Finset.mem_erase.mpr ⟨hne, hv⟩
  rw [dif_pos h]
  exact Finset.min'_le _ _ (Finset.mem_filter.mpr ⟨hu, hadj, hdist⟩)

/-- Penrose BFS spanning tree map `τ(H)`. `[B]` -/
noncomputable def penroseTree (V : Finset α) (r : α) (E : Finset (Sym2 α))
    (hconn : IsConnected V r E) : Finset (Sym2 α) :=
  (V.erase r).image (fun v => s(penroseParent V r E hconn v, v))

lemma penroseTree_subset {V : Finset α} {r : α} {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) : penroseTree V r E hconn ⊆ E := by
  intro e he
  unfold penroseTree at he
  rw [Finset.mem_image] at he
  obtain ⟨v, hv_er, rfl⟩ := he
  exact (penroseParent_spec hconn (Finset.mem_of_mem_erase hv_er) (Finset.ne_of_mem_erase hv_er)).1.2

lemma penroseTree_card {V : Finset α} {r : α} (hr : r ∈ V) {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) :
    (penroseTree V r E hconn).card + 1 = V.card := by
  unfold penroseTree
  rw [Finset.card_image_of_injOn, Finset.card_erase_of_mem hr]
  · have h1 : 1 ≤ V.card := Finset.card_pos.mpr ⟨r, hr⟩
    omega
  · intro v₁ hv₁ v₂ hv₂ heq
    rw [Sym2.eq_iff] at heq
    rcases heq with ⟨_, hvv⟩ | ⟨hp1, hp2⟩
    · exact hvv
    · have hd1 := (penroseParent_spec hconn (Finset.mem_of_mem_erase hv₁)
        (Finset.ne_of_mem_erase hv₁)).2
      have hd2 := (penroseParent_spec hconn (Finset.mem_of_mem_erase hv₂)
        (Finset.ne_of_mem_erase hv₂)).2
      rw [hp1] at hd1
      rw [← hp2] at hd2
      omega

lemma penroseTree_isSpanningTree {V : Finset α} {r : α} (hr : r ∈ V) {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) : IsSpanningTree V r (penroseTree V r E hconn) := by
  refine ⟨⟨(penroseTree_subset hconn).trans hconn.1, ?_⟩, penroseTree_card hr hconn⟩
  have hreach : ∀ d : ℕ, ∀ v ∈ V,
      gDist V r E hconn v = d → ∃ k : ℕ, GWalk (penroseTree V r E hconn) r v k := by
    intro d
    induction d with
    | zero =>
      intro v hv hd0
      have hw := gDist_spec hconn hv
      rw [hd0] at hw
      exact ⟨0, hw⟩
    | succ d ih =>
      intro v hv hd
      have hne : v ≠ r := by
        intro heq
        subst heq
        rw [gDist_root hr hconn] at hd
        omega
      let p := penroseParent V r E hconn v
      have hpV : p ∈ V := penroseParent_mem_V hconn hv hne
      have hspec := penroseParent_spec hconn hv hne
      have hp_dist : gDist V r E hconn p = d := by
        have : gDist V r E hconn p + 1 = d + 1 := hd ▸ hspec.2
        omega
      obtain ⟨k, hwk⟩ := ih p hpV hp_dist
      refine ⟨k + 1, p, hwk, hspec.1.1, ?_⟩
      unfold penroseTree
      rw [Finset.mem_image]
      exact ⟨v, Finset.mem_erase.mpr ⟨hne, hv⟩, rfl⟩
  intro v hv
  exact hreach (gDist V r E hconn v) v hv rfl

lemma gDist_penroseTree_eq {V : Finset α} {r : α} (hr : r ∈ V) {E : Finset (Sym2 α)}
    (hconn : IsConnected V r E) (v : α) (hv : v ∈ V) :
    gDist V r (penroseTree V r E hconn) (penroseTree_isSpanningTree hr hconn).1 v =
      gDist V r E hconn v := by
  apply le_antisymm
  · have hwalk_le : ∀ d : ℕ, ∀ w ∈ V, gDist V r E hconn w = d →
        GWalk (penroseTree V r E hconn) r w d := by
      intro d
      induction d with
      | zero =>
        intro w hw hd0
        have := gDist_spec hconn hw
        rwa [hd0] at this
      | succ d ih =>
        intro w hw hd
        have hne : w ≠ r := by
          intro heq; subst heq; rw [gDist_root hr hconn] at hd; omega
        let p := penroseParent V r E hconn w
        have hpV : p ∈ V := penroseParent_mem_V hconn hw hne
        have hspec := penroseParent_spec hconn hw hne
        have hpd : gDist V r E hconn p = d := by
          have : gDist V r E hconn p + 1 = d + 1 := hd ▸ hspec.2
          omega
        refine ⟨p, ih p hpV hpd, hspec.1.1, ?_⟩
        unfold penroseTree
        rw [Finset.mem_image]
        exact ⟨w, Finset.mem_erase.mpr ⟨hne, hw⟩, rfl⟩
    exact gDist_le (penroseTree_isSpanningTree hr hconn).1 hv (hwalk_le _ v hv rfl)
  · exact gDist_le hconn hv (gwalk_mono (penroseTree_subset hconn)
      (gDist_spec (penroseTree_isSpanningTree hr hconn).1 hv))

lemma penroseTree_eq_self {V : Finset α} {r : α} (hr : r ∈ V) {T : Finset (Sym2 α)}
    (hT : IsSpanningTree V r T) : penroseTree V r T hT.1 = T := by
  apply Finset.eq_of_subset_of_card_le (penroseTree_subset hT.1)
  have h1 := penroseTree_card hr hT.1
  have h2 := hT.2
  omega

/-- In a spanning tree `T`, the unique neighbor of `v ≠ r` at smaller distance is `penroseParent`. `[B]` -/
lemma spanningTree_unique_parent {V : Finset α} {r : α} (hr : r ∈ V) {T : Finset (Sym2 α)}
    (hT : IsSpanningTree V r T) {v : α} (hv : v ∈ V) (hne : v ≠ r)
    {u : α} (hadj : gAdj T u v)
    (hdist : gDist V r T hT.1 u + 1 = gDist V r T hT.1 v) :
    u = penroseParent V r T hT.1 v := by
  have heq : s(u, v) ∈ penroseTree V r T hT.1 := by
    rw [penroseTree_eq_self hr hT]
    exact hadj.2
  unfold penroseTree at heq
  rw [Finset.mem_image] at heq
  obtain ⟨w, hw_er, hsw⟩ := heq
  rw [Sym2.eq_iff] at hsw
  have hwV := Finset.mem_of_mem_erase hw_er
  have hwne := Finset.ne_of_mem_erase hw_er
  rcases hsw with ⟨hu_eq, hv_eq⟩ | ⟨hu_eq, hv_eq⟩
  · subst hv_eq
    exact hu_eq.symm
  · have hpw := (penroseParent_spec hT.1 hwV hwne).2
    rw [hu_eq] at hpw
    rw [hv_eq] at hpw
    omega

/-- Penrose back/same-level edges allowed in `G \ T` for a spanning tree `T`. `[B]` -/
noncomputable def penroseBackEdges (V : Finset α) (r : α) (G T : Finset (Sym2 α))
    (hT : IsSpanningTree V r T) : Finset (Sym2 α) :=
  G.filter (fun e => e ∉ T ∧
    ∃ u v, e = s(u, v) ∧ u ∈ V ∧ v ∈ V ∧
      (gDist V r T hT.1 u = gDist V r T hT.1 v ∨
      (v ≠ r ∧ gDist V r T hT.1 u + 1 = gDist V r T hT.1 v ∧
        penroseParent V r T hT.1 v < u)))

lemma penroseBackEdges_disjoint {V : Finset α} {r : α} {G T : Finset (Sym2 α)}
    (hT : IsSpanningTree V r T) : Disjoint T (penroseBackEdges V r G T hT) := by
  rw [Finset.disjoint_left]
  intro e heT heB
  rw [penroseBackEdges, Finset.mem_filter] at heB
  exact heB.2.1 heT

lemma penroseBackEdges_subset {V : Finset α} {r : α} {G T : Finset (Sym2 α)}
    (hT : IsSpanningTree V r T) : penroseBackEdges V r G T hT ⊆ G :=
  Finset.filter_subset _ _

lemma penrose_fiber_iff {V : Finset α} {r : α} (hr : r ∈ V) {G : Finset (Sym2 α)}
    (hG : G ⊆ completeEdges V) {T : Finset (Sym2 α)} (hT : IsSpanningTree V r T)
    (hTG : T ⊆ G) {H : Finset (Sym2 α)} (hHG : H ⊆ G) :
    (∃ hH : IsConnected V r H, penroseTree V r H hH = T) ↔
      T ⊆ H ∧ H ⊆ T ∪ penroseBackEdges V r G T hT := by
  constructor
  · rintro ⟨hH, hτ⟩
    have hTH : T ⊆ H := by rw [← hτ]; exact penroseTree_subset hH
    have hdist_eq : ∀ w : α, gDist V r H hH w = gDist V r T hT.1 w := by
      intro w
      by_cases hw : w ∈ V
      · rw [← gDist_penroseTree_eq hr hH w hw]
        subst hτ
        rfl
      · simp [gDist, hw]
    refine ⟨hTH, fun e heH => ?_⟩
    by_cases heT : e ∈ T
    · exact Finset.mem_union_left _ heT
    · refine Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hHG heH, heT, ?_⟩)
      induction e using Sym2.ind with
      | _ a b =>
        have hab := (mem_completeEdges_iff).mp (hG (hHG heH))
        have hadjH : gAdj H a b := ⟨hab.2.2, heH⟩
        have hda_db := gDist_sub_abs_le_one hH hab.1 hab.2.1 hadjH
        rw [hdist_eq a, hdist_eq b] at hda_db
        rcases le_or_gt (gDist V r T hT.1 a) (gDist V r T hT.1 b) with hle | hgt
        · rcases hle.eq_or_lt with heq | hlt
          · exact ⟨a, b, rfl, hab.1, hab.2.1, Or.inl heq⟩
          · have hstep : gDist V r T hT.1 a + 1 = gDist V r T hT.1 b := by omega
            have hne_b : b ≠ r := by
              intro hbr; subst hbr; rw [gDist_root hr hT.1] at hstep; omega
            have hstepH : gDist V r H hH a + 1 = gDist V r H hH b := by
              rwa [hdist_eq a, hdist_eq b]
            have hple : penroseParent V r H hH b ≤ a :=
              penroseParent_le hH hab.2.1 hne_b hab.1 hadjH hstepH
            have hp_eq : penroseParent V r H hH b = penroseParent V r T hT.1 b := by
              have hps := penroseParent_spec hH hab.2.1 hne_b
              have hadj_tau : gAdj (penroseTree V r H hH) (penroseParent V r H hH b) b := by
                refine ⟨hps.1.1, ?_⟩
                unfold penroseTree
                rw [Finset.mem_image]
                exact ⟨b, Finset.mem_erase.mpr ⟨hne_b, hab.2.1⟩, rfl⟩
              have hadj_T : gAdj T (penroseParent V r H hH b) b := by
                rwa [hτ] at hadj_tau
              have hps2 : gDist V r T hT.1 (penroseParent V r H hH b) + 1 = gDist V r T hT.1 b := by
                rw [← hdist_eq _, ← hdist_eq _]; exact hps.2
              exact spanningTree_unique_parent hr hT hab.2.1 hne_b hadj_T hps2
            have hne_pa : penroseParent V r T hT.1 b ≠ a := by
              intro hpeq
              apply heT
              have hp_adj : s(penroseParent V r H hH b, b) ∈ T := by
                rw [← hτ]
                unfold penroseTree
                rw [Finset.mem_image]
                exact ⟨b, Finset.mem_erase.mpr ⟨hne_b, hab.2.1⟩, rfl⟩
              rwa [hp_eq, hpeq] at hp_adj
            exact ⟨a, b, rfl, hab.1, hab.2.1,
              Or.inr ⟨hne_b, hstep, lt_of_le_of_ne (hp_eq ▸ hple) hne_pa⟩⟩
        · have hstep : gDist V r T hT.1 b + 1 = gDist V r T hT.1 a := by omega
          have hne_a : a ≠ r := by
            intro har; subst har; rw [gDist_root hr hT.1] at hstep; omega
          have hstepH : gDist V r H hH b + 1 = gDist V r H hH a := by
            rwa [hdist_eq b, hdist_eq a]
          have hple : penroseParent V r H hH a ≤ b :=
            penroseParent_le hH hab.1 hne_a hab.2.1 (gAdj_symm hadjH) hstepH
          have hp_eq : penroseParent V r H hH a = penroseParent V r T hT.1 a := by
            have hps := penroseParent_spec hH hab.1 hne_a
            have hadj_tau : gAdj (penroseTree V r H hH) (penroseParent V r H hH a) a := by
              refine ⟨hps.1.1, ?_⟩
              unfold penroseTree
              rw [Finset.mem_image]
              exact ⟨a, Finset.mem_erase.mpr ⟨hne_a, hab.1⟩, rfl⟩
            have hadj_T : gAdj T (penroseParent V r H hH a) a := by
              rwa [hτ] at hadj_tau
            have hps2 : gDist V r T hT.1 (penroseParent V r H hH a) + 1 = gDist V r T hT.1 a := by
              rw [← hdist_eq _, ← hdist_eq _]; exact hps.2
            exact spanningTree_unique_parent hr hT hab.1 hne_a hadj_T hps2
          have hne_pb : penroseParent V r T hT.1 a ≠ b := by
            intro hpeq
            apply heT
            have hp_adj : s(penroseParent V r H hH a, a) ∈ T := by
              rw [← hτ]
              unfold penroseTree
              rw [Finset.mem_image]
              exact ⟨a, Finset.mem_erase.mpr ⟨hne_a, hab.1⟩, rfl⟩
            rw [hp_eq, hpeq, Sym2.eq_swap] at hp_adj
            exact hp_adj
          exact ⟨b, a, Sym2.eq_swap, hab.2.1, hab.1,
            Or.inr ⟨hne_a, hstep, lt_of_le_of_ne (hp_eq ▸ hple) hne_pb⟩⟩
  · rintro ⟨hTH, hHB⟩
    have hH_conn : IsConnected V r H := by
      refine ⟨hHG.trans hG, fun v hv => ?_⟩
      obtain ⟨k, hk⟩ := hT.1.2 v hv
      exact ⟨k, gwalk_mono hTH hk⟩
    refine ⟨hH_conn, ?_⟩
    have hback_diff : ∀ {x y : α}, x ∈ V → y ∈ V →
        gAdj H x y → gDist V r T hT.1 y ≤ gDist V r T hT.1 x + 1 := by
      intro x y hx hy hadjH
      rcases Finset.mem_union.mp (hHB hadjH.2) with heT | heB
      · exact gDist_adj_le hT.1 hx hy ⟨hadjH.1, heT⟩
      · rw [penroseBackEdges, Finset.mem_filter] at heB
        rcases heB.2 with ⟨_, u, v, huv, _, _, hcase⟩
        rw [Sym2.eq_iff] at huv
        rcases huv with ⟨hxu, hyv⟩ | ⟨hxv, hyu⟩
        · rw [← hxu, ← hyv] at hcase
          rcases hcase with heq | ⟨_, hstep, _⟩ <;> omega
        · rw [← hxv, ← hyu] at hcase
          rcases hcase with heq | ⟨_, hstep, _⟩ <;> omega
    have hwalk_T_le : ∀ k w, w ∈ V → GWalk H r w k → gDist V r T hT.1 w ≤ k := by
      intro k
      induction k with
      | zero =>
        intro w hw hw0
        have : r = w := hw0
        subst this
        rw [gDist_root hr hT.1]
      | succ k ih =>
        intro w hw ⟨z, hwz, hadj⟩
        have hz : z ∈ V := gAdj_mem_left (hHG.trans hG) hadj
        have := ih z hz hwz
        have := hback_diff hz hw hadj
        omega
    have hdist_eq : ∀ w, gDist V r H hH_conn w = gDist V r T hT.1 w := by
      intro w
      by_cases hw : w ∈ V
      · apply le_antisymm
        · exact gDist_le hH_conn hw (gwalk_mono hTH (gDist_spec hT.1 hw))
        · exact hwalk_T_le _ w hw (gDist_spec hH_conn hw)
      · simp [gDist, hw]
    have hτ_eq : penroseTree V r H hH_conn = T := by
      rw [← penroseTree_eq_self hr hT]
      unfold penroseTree
      apply Finset.image_congr
      intro v hv_er
      have hv := Finset.mem_of_mem_erase hv_er
      have hne := Finset.ne_of_mem_erase hv_er
      have hp_eq : penroseParent V r H hH_conn v = penroseParent V r T hT.1 v := by
        apply le_antisymm
        · have hspecT := penroseParent_spec hT.1 hv hne
          have hpT_mem := penroseParent_mem_V hT.1 hv hne
          apply penroseParent_le hH_conn hv hne hpT_mem (gAdj_mono hTH hspecT.1)
          rw [hdist_eq _, hdist_eq _]
          exact hspecT.2
        · by_contra hlt
          rw [not_le] at hlt
          let pH := penroseParent V r H hH_conn v
          have hspecH := penroseParent_spec hH_conn hv hne
          have hpH_distT : gDist V r T hT.1 pH + 1 = gDist V r T hT.1 v := by
            rw [← hdist_eq pH, ← hdist_eq v]; exact hspecH.2
          rcases Finset.mem_union.mp (hHB hspecH.1.2) with heT | heB
          · have heq := spanningTree_unique_parent hr hT hv hne ⟨hspecH.1.1, heT⟩ hpH_distT
            exact (ne_of_lt hlt) heq
          · rw [penroseBackEdges, Finset.mem_filter] at heB
            rcases heB.2 with ⟨_, u, w, huw, _, _, hcase⟩
            rw [Sym2.eq_iff] at huw
            rcases huw with ⟨hpHu, hvw⟩ | ⟨hpHw, hvu⟩
            · rw [← hpHu, ← hvw] at hcase
              rcases hcase with heq | ⟨_, _, hplt⟩
              · have : gDist V r T hT.1 pH = gDist V r T hT.1 v := heq
                linarith
              · exact lt_irrefl _ (hlt.trans hplt)
            · rw [← hpHw, ← hvu] at hcase
              rcases hcase with heq | ⟨_, hstep, _⟩
              · have : gDist V r T hT.1 v = gDist V r T hT.1 pH := heq
                linarith
              · have : gDist V r T hT.1 v + 1 = gDist V r T hT.1 pH := hstep
                linarith
      dsimp only
      congr 1
    exact hτ_eq

private lemma sum_powerset_neg_one {β : Type*} [DecidableEq β] (B : Finset β) :
    ∑ S ∈ B.powerset, (-1 : ℝ) ^ S.card = if B = ∅ then 1 else 0 := by
  induction B using Finset.induction_on with
  | empty => simp
  | @insert a s has ih =>
    rw [Finset.powerset_insert, Finset.sum_union]
    · have himg : ∑ S ∈ Finset.image (insert a) s.powerset, (-1 : ℝ) ^ S.card =
          - ∑ S ∈ s.powerset, (-1 : ℝ) ^ S.card := by
        rw [Finset.sum_image]
        · calc
            ∑ S ∈ s.powerset, (-1 : ℝ) ^ (insert a S).card
                = ∑ S ∈ s.powerset, -((-1 : ℝ) ^ S.card) := by
                  refine Finset.sum_congr rfl (fun S hS => ?_)
                  have haS : a ∉ S := fun ha => has (Finset.mem_powerset.mp hS ha)
                  rw [Finset.card_insert_eq_ite, if_neg haS, pow_succ]
                  ring
            _ = - ∑ S ∈ s.powerset, (-1 : ℝ) ^ S.card := by
                  rw [← Finset.sum_neg_distrib]
        · intro x hx y hy hxy
          have hax : a ∉ x := fun ha => has (Finset.mem_powerset.mp hx ha)
          have hay : a ∉ y := fun ha => has (Finset.mem_powerset.mp hy ha)
          have := congrArg (fun t => t.erase a) hxy
          simpa [Finset.erase_insert hax, Finset.erase_insert hay] using this
      rw [himg, add_neg_cancel, if_neg (Finset.insert_ne_empty a s)]
    · rw [Finset.disjoint_left]
      intro x hx himg
      rw [Finset.mem_image] at himg
      obtain ⟨y, _, rfl⟩ := himg
      exact has (Finset.mem_powerset.mp hx (Finset.mem_insert_self a y))

/-- **Penrose Tree-Graph Inequality (`[B]`)**:
For any finite graph `G ⊆ completeEdges V` on `V` with root `r ∈ V`, the signed sum over
connected spanning subgraphs `∑_{H ⊆ G conn} (-1)^{|H|}` is bounded in absolute value by the
number of spanning trees `T ⊆ G` of `V`. -/
theorem penrose_tree_graph_inequality
    {V : Finset α} {r : α} (hr : r ∈ V) {G : Finset (Sym2 α)} (hG : G ⊆ completeEdges V) :
    |∑ H ∈ G.powerset.filter (IsConnected V r), (-1 : ℝ) ^ H.card| ≤
      ((G.powerset.filter (IsSpanningTree V r)).card : ℝ) := by
  let Conn := G.powerset.filter (IsConnected V r)
  let Trees := G.powerset.filter (IsSpanningTree V r)
  have hmap : ∀ H ∈ Conn,
      (if h : IsConnected V r H then penroseTree V r H h else ∅) ∈ Trees := by
    intro H hH
    have hH_sub : H ⊆ G := (Finset.mem_powerset.mp (Finset.mem_filter.mp hH).1)
    have hH_conn : IsConnected V r H := (Finset.mem_filter.mp hH).2
    rw [dif_pos hH_conn, Finset.mem_filter, Finset.mem_powerset]
    exact ⟨(penroseTree_subset hH_conn).trans hH_sub, penroseTree_isSpanningTree hr hH_conn⟩
  have hfib : ∑ H ∈ Conn, (-1 : ℝ) ^ H.card =
      ∑ T ∈ Trees, ∑ H ∈ Conn.filter (fun H =>
        (if h : IsConnected V r H then penroseTree V r H h else ∅) = T), (-1 : ℝ) ^ H.card := by
    symm
    exact Finset.sum_fiberwise_of_maps_to hmap (fun H => (-1 : ℝ) ^ H.card)
  rw [hfib]
  have hterm : ∀ T ∈ Trees,
      |∑ H ∈ Conn.filter (fun H =>
        (if h : IsConnected V r H then penroseTree V r H h else ∅) = T), (-1 : ℝ) ^ H.card| ≤ 1 := by
    intro T hT
    have hTG : T ⊆ G := Finset.mem_powerset.mp (Finset.mem_filter.mp hT).1
    have hTsp : IsSpanningTree V r T := (Finset.mem_filter.mp hT).2
    let B := penroseBackEdges V r G T hTsp
    have hdisj : Disjoint T B := penroseBackEdges_disjoint hTsp
    have hfib_eq : Conn.filter (fun H =>
          (if h : IsConnected V r H then penroseTree V r H h else ∅) = T) =
        B.powerset.image (fun S => T ∪ S) := by
      ext H
      simp only [Conn, Finset.mem_filter, Finset.mem_powerset, Finset.mem_image]
      constructor
      · rintro ⟨⟨hHG, hHconn⟩, hτ⟩
        rw [dif_pos hHconn] at hτ
        have hsub := (penrose_fiber_iff hr hG hTsp hTG hHG).mp ⟨hHconn, hτ⟩
        refine ⟨H \ T, ?_, ?_⟩
        · intro e he
          obtain ⟨heH, heT⟩ := Finset.mem_sdiff.mp he
          rcases Finset.mem_union.mp (hsub.2 heH) with heT' | heB
          · exact absurd heT' heT
          · exact heB
        · exact Finset.union_sdiff_of_subset hsub.1
      · rintro ⟨S, hSB, rfl⟩
        have hHG : T ∪ S ⊆ G := Finset.union_subset hTG (hSB.trans (penroseBackEdges_subset hTsp))
        have hsub : T ⊆ T ∪ S ∧ T ∪ S ⊆ T ∪ B :=
          ⟨Finset.subset_union_left, Finset.union_subset_union_right hSB⟩
        obtain ⟨hHconn, hτ⟩ := (penrose_fiber_iff hr hG hTsp hTG hHG).mpr hsub
        exact ⟨⟨hHG, hHconn⟩, by rw [dif_pos hHconn]; exact hτ⟩
    rw [hfib_eq, Finset.sum_image]
    · have hsum_eq : ∑ S ∈ B.powerset, (-1 : ℝ) ^ (T ∪ S).card =
          (-1 : ℝ) ^ T.card * ∑ S ∈ B.powerset, (-1 : ℝ) ^ S.card := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun S hS => ?_)
        have hTS : Disjoint T S := hdisj.mono_right (Finset.mem_powerset.mp hS)
        rw [Finset.card_union_of_disjoint hTS, pow_add]
      rw [hsum_eq, sum_powerset_neg_one B, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
      split_ifs <;> norm_num
    · intro S₁ hS₁ S₂ hS₂ heq
      have h1 : Disjoint T S₁ := hdisj.mono_right (Finset.mem_powerset.mp hS₁)
      have h2 : Disjoint T S₂ := hdisj.mono_right (Finset.mem_powerset.mp hS₂)
      have := congrArg (fun X => X \ T) heq
      simpa [Finset.union_sdiff_cancel_left h1, Finset.union_sdiff_cancel_left h2] using this
  calc
    |∑ T ∈ Trees, ∑ H ∈ Conn.filter (fun H =>
        (if h : IsConnected V r H then penroseTree V r H h else ∅) = T), (-1 : ℝ) ^ H.card|
        ≤ ∑ T ∈ Trees, |∑ H ∈ Conn.filter (fun H =>
          (if h : IsConnected V r H then penroseTree V r H h else ∅) = T), (-1 : ℝ) ^ H.card| :=
          Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _T ∈ Trees, (1 : ℝ) := Finset.sum_le_sum (fun T hT => hterm T hT)
    _ = (Trees.card : ℝ) := by simp

end OrderedPenrose

end PenroseTreeGraph

section KoteckyPreissMayer

open Classical

/-- Finite-graph Kotecký–Preiss polymer system (`[C/B/P]`):
finite polymer space `Pol` with reflexive symmetric incompatibility `incomp`,
activities `z : Pol → ℝ`, nonnegative test/exponential weights `a, d : Pol → ℝ`,
and the Kotecký–Preiss convergence criterion
`∑_{γ' ~ γ} |z(γ')| exp(a(γ') + d(γ')) ≤ a(γ)`. -/
structure KPPolymerSystem where
  Pol : Type
  [fintypePol : Fintype Pol]
  [decEqPol : DecidableEq Pol]
  incomp : Pol → Pol → Prop
  [decIncomp : DecidableRel incomp]
  incomp_refl : ∀ γ : Pol, incomp γ γ
  incomp_symm : ∀ γ₁ γ₂ : Pol, incomp γ₁ γ₂ → incomp γ₂ γ₁
  z : Pol → ℝ
  a : Pol → ℝ
  a_nonneg : ∀ γ : Pol, 0 ≤ a γ
  d : Pol → ℝ
  d_nonneg : ∀ γ : Pol, 0 ≤ d γ
  kp_cond : ∀ γ : Pol,
    (∑ γ' : Pol, if incomp γ γ' then |z γ'| * Real.exp (a γ' + d γ') else 0) ≤ a γ

attribute [instance] KPPolymerSystem.fintypePol KPPolymerSystem.decEqPol KPPolymerSystem.decIncomp

/-- Effective exponential-weighted polymer activity `|z(γ)| * exp(d(γ)) ≥ 0`. `[B]` -/
noncomputable def kpWeight (P : KPPolymerSystem) (γ : P.Pol) : ℝ :=
  |P.z γ| * Real.exp (P.d γ)

lemma kpWeight_nonneg (P : KPPolymerSystem) (γ : P.Pol) : 0 ≤ kpWeight P γ := by
  unfold kpWeight; positivity

/-- Incompatibility graph on `Fin (m + 1)` induced by polymer tuple `γ : Fin (m + 1) → P.Pol`. `[B]` -/
noncomputable def incompGraph (P : KPPolymerSystem) {m : ℕ} (γ : Fin (m + 1) → P.Pol) :
    Finset (Sym2 (Fin (m + 1))) :=
  (completeEdges (Finset.univ : Finset (Fin (m + 1)))).filter
    (fun e => ∃ i j : Fin (m + 1), e = s(i, j) ∧ P.incomp (γ i) (γ j))

lemma incompGraph_subset (P : KPPolymerSystem) {m : ℕ} (γ : Fin (m + 1) → P.Pol) :
    incompGraph P γ ⊆ completeEdges (Finset.univ : Finset (Fin (m + 1))) :=
  Finset.filter_subset _ _

/-- Ursell / Mayer connected cluster coefficient `φ^T(γ_0, ..., γ_m)` on `Fin (m + 1)`. `[B]` -/
noncomputable def ursellCoeff (P : KPPolymerSystem) {m : ℕ} (γ : Fin (m + 1) → P.Pol) : ℝ :=
  ∑ H ∈ (incompGraph P γ).powerset.filter (IsConnected Finset.univ (0 : Fin (m + 1))),
    (-1 : ℝ) ^ H.card

/-- Penrose bound on the Ursell coefficient: `|φ^T(γ)| ≤ #{spanning trees in incompGraph(γ)}`. `[B]` -/
theorem abs_ursellCoeff_le_spanningTrees (P : KPPolymerSystem) {m : ℕ}
    (γ : Fin (m + 1) → P.Pol) :
    |ursellCoeff P γ| ≤
      (((incompGraph P γ).powerset.filter (IsSpanningTree Finset.univ (0 : Fin (m + 1)))).card : ℝ) :=
  penrose_tree_graph_inequality (Finset.mem_univ 0) (incompGraph_subset P γ)

/-- Validity predicate for polymer assignment `γ : ↥V → P.Pol` on spanning tree `(V, r, T)`. `[B]` -/
def treeValid (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (r : α) (T : Finset (Sym2 α)) (γ₀ : P.Pol) (γ : ↥V → P.Pol) : Prop :=
  (∀ hr : r ∈ V, γ ⟨r, hr⟩ = γ₀) ∧
  (∀ e ∈ T, ∃ (u : α) (hu : u ∈ V) (v : α) (hv : v ∈ V),
    e = s(u, v) ∧ P.incomp (γ ⟨u, hu⟩) (γ ⟨v, hv⟩))

/-- Tree-constrained polymer weight sum for a fixed spanning tree `T` on `(V, r)` with root `γ₀`. `[B]` -/
noncomputable def treeActivitySum (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (r : α) (T : Finset (Sym2 α)) (γ₀ : P.Pol) : ℝ :=
  ∑ γ : ↥V → P.Pol,
    if treeValid P V r T γ₀ γ then
      ∏ v ∈ V.attach.filter (fun v => v.1 ≠ r), kpWeight P (γ v)
    else 0

/-- Total spanning-tree polymer weight sum on `(V, r)` with root `γ₀`. `[B]` -/
noncomputable def treeTotalSum (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (r : α) (γ₀ : P.Pol) : ℝ :=
  ∑ T ∈ (completeEdges V).powerset.filter (IsSpanningTree V r), treeActivitySum P V r T γ₀

/-- Normalized Mayer tree-sum at order `m + 1` (`1 / m! * treeTotalSum`). `[B]` -/
noncomputable def kpTreeTerm (P : KPPolymerSystem) (m : ℕ) (γ₀ : P.Pol) : ℝ :=
  (1 / (m.factorial : ℝ)) * treeTotalSum P (Finset.univ : Finset (Fin (m + 1))) 0 γ₀

/-- Partial sum of normalized Mayer tree weights up to size `N + 1`. `[B]` -/
noncomputable def kpPartialSum (P : KPPolymerSystem) (N : ℕ) (γ₀ : P.Pol) : ℝ :=
  ∑ m ∈ Finset.range (N + 1), kpTreeTerm P m γ₀

lemma treeActivitySum_nonneg (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (r : α) (T : Finset (Sym2 α)) (γ₀ : P.Pol) :
    0 ≤ treeActivitySum P V r T γ₀ := by
  unfold treeActivitySum
  refine Finset.sum_nonneg (fun _ _ => ?_)
  split_ifs
  · exact Finset.prod_nonneg (fun _ _ => kpWeight_nonneg P _)
  · exact le_rfl

lemma treeTotalSum_nonneg (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (r : α) (γ₀ : P.Pol) :
    0 ≤ treeTotalSum P V r γ₀ := by
  unfold treeTotalSum
  exact Finset.sum_nonneg (fun _ _ => treeActivitySum_nonneg P _ _ _ _)

lemma kpTreeTerm_nonneg (P : KPPolymerSystem) (m : ℕ) (γ₀ : P.Pol) :
    0 ≤ kpTreeTerm P m γ₀ := by
  unfold kpTreeTerm
  exact mul_nonneg (by positivity) (treeTotalSum_nonneg P _ _ _)

lemma kpPartialSum_nonneg (P : KPPolymerSystem) (N : ℕ) (γ₀ : P.Pol) :
    0 ≤ kpPartialSum P N γ₀ := by
  unfold kpPartialSum
  exact Finset.sum_nonneg (fun _ _ => kpTreeTerm_nonneg P _ _)

/-- Invariance of `treeTotalSum` under bijections `(V, r) ≃ (Fin (m + 1), 0)`. `[B]` -/
lemma treeTotalSum_eq_fin (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (r : α) (hr : r ∈ V) {m : ℕ} (hcard : V.card = m + 1) (γ₀ : P.Pol) :
    treeTotalSum P V r γ₀ =
      treeTotalSum P (Finset.univ : Finset (Fin (m + 1))) 0 γ₀ := by
  let e0 : V ≃ Fin (m + 1) := Fintype.equivOfCardEq (by simp [hcard])
  let e : V ≃ Fin (m + 1) := e0.trans (Equiv.swap 0 (e0 ⟨r, hr⟩))
  have her : e ⟨r, hr⟩ = 0 := by simp [e]
  let fwd : α → Fin (m + 1) := fun x => if hx : x ∈ V then e ⟨x, hx⟩ else 0
  let bwd : Fin (m + 1) → α := fun i => (e.symm i).1
  have hfwd_bwd : ∀ i : Fin (m + 1), fwd (bwd i) = i := by
    intro i
    simp only [fwd, bwd, (e.symm i).2, ↓reduceDIte]
    exact e.apply_symm_apply i
  have hbwd_fwd : ∀ x (hx : x ∈ V), bwd (fwd x) = x := by
    intro x hx
    simp only [fwd, bwd, hx, ↓reduceDIte]
    exact congrArg Subtype.val (e.symm_apply_apply ⟨x, hx⟩)
  have hfwd_inj : ∀ {x y : α}, x ∈ V → y ∈ V → fwd x = fwd y → x = y := by
    intro x y hx hy hxy
    have := congrArg bwd hxy
    rwa [hbwd_fwd x hx, hbwd_fwd y hy] at this
  have hbwd_mem : ∀ i : Fin (m + 1), bwd i ∈ V := fun i => (e.symm i).2
  let mapE : Finset (Sym2 α) → Finset (Sym2 (Fin (m + 1))) := Finset.image (Sym2.map fwd)
  let unmapE : Finset (Sym2 (Fin (m + 1))) → Finset (Sym2 α) := Finset.image (Sym2.map bwd)
  have hmap_comp : ∀ E, E ⊆ completeEdges V → mapE E ⊆ completeEdges Finset.univ := by
    intro E hE e' he'
    rw [Finset.mem_image] at he'
    obtain ⟨e1, he1, rfl⟩ := he'
    induction e1 using Sym2.ind with
    | _ u v =>
      have huv := (mem_completeEdges_iff).mp (hE he1)
      rw [Sym2.map_mk, mem_completeEdges_iff]
      refine ⟨Finset.mem_univ _, Finset.mem_univ _, fun h => huv.2.2 (hfwd_inj huv.1 huv.2.1 h)⟩
  have hunmap_comp : ∀ E', E' ⊆ completeEdges Finset.univ → unmapE E' ⊆ completeEdges V := by
    intro E' hE' e1 he1
    rw [Finset.mem_image] at he1
    obtain ⟨e', he', rfl⟩ := he1
    induction e' using Sym2.ind with
    | _ i j =>
      have hij := (mem_completeEdges_iff).mp (hE' he')
      rw [Sym2.map_mk, mem_completeEdges_iff]
      refine ⟨hbwd_mem i, hbwd_mem j, fun h => hij.2.2 ?_⟩
      have := congrArg fwd h
      rwa [hfwd_bwd i, hfwd_bwd j] at this
  have hunmap_map : ∀ E, E ⊆ completeEdges V → unmapE (mapE E) = E := by
    intro E hE
    ext e1
    simp only [unmapE, mapE, Finset.mem_image]
    constructor
    · rintro ⟨e', ⟨e2, he2, rfl⟩, he1⟩
      induction e2 using Sym2.ind with
      | _ u v =>
        have huv := (mem_completeEdges_iff).mp (hE he2)
        rw [Sym2.map_mk, Sym2.map_mk, hbwd_fwd u huv.1, hbwd_fwd v huv.2.1] at he1
        rwa [← he1]
    · intro he1
      induction e1 using Sym2.ind with
      | _ u v =>
        have huv := (mem_completeEdges_iff).mp (hE he1)
        refine ⟨s(fwd u, fwd v), ⟨s(u, v), he1, by simp⟩, ?_⟩
        rw [Sym2.map_mk, hbwd_fwd u huv.1, hbwd_fwd v huv.2.1]
  have hmap_unmap : ∀ E', E' ⊆ completeEdges Finset.univ → mapE (unmapE E') = E' := by
    intro E' hE'
    ext e'
    simp only [mapE, unmapE, Finset.mem_image]
    constructor
    · rintro ⟨e1, ⟨e2, he2, rfl⟩, he'⟩
      induction e2 using Sym2.ind with
      | _ i j =>
        rw [Sym2.map_mk, Sym2.map_mk, hfwd_bwd i, hfwd_bwd j] at he'
        rwa [← he']
    · intro he'
      induction e' using Sym2.ind with
      | _ i j =>
        refine ⟨s(bwd i, bwd j), ⟨s(i, j), he', by simp⟩, ?_⟩
        rw [Sym2.map_mk, hfwd_bwd i, hfwd_bwd j]
  have hmap_injOn : ∀ E, E ⊆ completeEdges V → (mapE E).card = E.card := by
    intro E hE
    apply Finset.card_image_of_injOn
    intro e1 he1 e2 he2 heq
    induction e1 using Sym2.ind with
    | _ u1 v1 =>
      induction e2 using Sym2.ind with
      | _ u2 v2 =>
        have h1 := (mem_completeEdges_iff).mp (hE he1)
        have h2 := (mem_completeEdges_iff).mp (hE he2)
        simp only [Sym2.map_mk, Sym2.eq_iff] at heq
        rcases heq with ⟨hu, hv⟩ | ⟨hu, hv⟩
        · rw [hfwd_inj h1.1 h2.1 hu, hfwd_inj h1.2.1 h2.2.1 hv]
        · rw [hfwd_inj h1.1 h2.2.1 hu, hfwd_inj h1.2.1 h2.1 hv, Sym2.eq_swap]
  have hwalk_fwd : ∀ E, E ⊆ completeEdges V → ∀ k v, v ∈ V →
      GWalk E r v k → GWalk (mapE E) 0 (fwd v) k := by
    intro E hE k
    induction k with
    | zero =>
      intro v hv hw
      have hrv : r = v := hw
      subst hrv
      change 0 = fwd r
      simp [fwd, dif_pos hr, her]
    | succ k ih =>
      intro v hv ⟨w, hwk, hadj⟩
      have hwV := gAdj_mem_left hE hadj
      refine ⟨fwd w, ih w hwV hwk, ?_, Finset.mem_image.mpr ⟨s(w, v), hadj.2, by simp⟩⟩
      exact fun h => hadj.1 (hfwd_inj hwV hv h)
  have hwalk_bwd : ∀ E', E' ⊆ completeEdges Finset.univ → ∀ k i,
      GWalk E' 0 i k → GWalk (unmapE E') r (bwd i) k := by
    intro E' hE' k
    induction k with
    | zero =>
      intro i hi
      have h0i : (0 : Fin (m + 1)) = i := hi
      subst h0i
      change r = bwd 0
      dsimp [bwd]
      rw [← her]
      exact congrArg Subtype.val (e.symm_apply_apply ⟨r, hr⟩) |>.symm
    | succ k ih =>
      intro i ⟨j, hjk, hadj⟩
      refine ⟨bwd j, ih j hjk, ?_, Finset.mem_image.mpr ⟨s(j, i), hadj.2, by simp⟩⟩
      intro h
      apply hadj.1
      have := congrArg fwd h
      rwa [hfwd_bwd j, hfwd_bwd i] at this
  have htree_fwd : ∀ T, T ∈ (completeEdges V).powerset.filter (IsSpanningTree V r) →
      mapE T ∈ (completeEdges (Finset.univ : Finset (Fin (m + 1)))).powerset.filter
        (IsSpanningTree Finset.univ 0) := by
    intro T hT
    obtain ⟨hTV, hTsp⟩ := Finset.mem_filter.mp hT
    rw [Finset.mem_powerset] at hTV
    rw [Finset.mem_filter, Finset.mem_powerset]
    refine ⟨hmap_comp T hTV, ⟨hmap_comp T hTV, fun i _ => ?_⟩, ?_⟩
    · obtain ⟨k, hk⟩ := hTsp.1.2 (bwd i) (hbwd_mem i)
      have := hwalk_fwd T hTV k (bwd i) (hbwd_mem i) hk
      rw [hfwd_bwd i] at this
      exact ⟨k, this⟩
    · rw [hmap_injOn T hTV, hTsp.2, hcard]
      simp
  have htree_act : ∀ T, T ∈ (completeEdges V).powerset.filter (IsSpanningTree V r) →
      treeActivitySum P V r T γ₀ =
        treeActivitySum P (Finset.univ : Finset (Fin (m + 1))) 0 (mapE T) γ₀ := by
    intro T hT
    have hTV : T ⊆ completeEdges V := Finset.mem_powerset.mp (Finset.mem_filter.mp hT).1
    let g_fn : (V → P.Pol) → (↥(Finset.univ : Finset (Fin (m + 1)))) → P.Pol :=
      fun γ i => γ ⟨bwd i.1, hbwd_mem i.1⟩
    let f_fn : ((↥(Finset.univ : Finset (Fin (m + 1)))) → P.Pol) → (V → P.Pol) :=
      fun γ' x => γ' ⟨fwd x.1, Finset.mem_univ _⟩
    have hgf : ∀ γ' : (↥(Finset.univ : Finset (Fin (m + 1)))) → P.Pol, g_fn (f_fn γ') = γ' := by
      intro γ'
      funext ⟨i, _⟩
      dsimp [g_fn, f_fn]
      congr 1
      exact Subtype.ext (hfwd_bwd i)
    have hfg : ∀ γ : V → P.Pol, f_fn (g_fn γ) = γ := by
      intro γ
      funext ⟨x, hx⟩
      dsimp [g_fn, f_fn]
      congr 1
      exact Subtype.ext (hbwd_fwd x hx)
    unfold treeActivitySum
    refine Finset.sum_bij (fun γ _ => g_fn γ) (fun _ _ => Finset.mem_univ _)
      (fun γ1 _ γ2 _ heq => by simpa [hfg] using congrArg f_fn heq)
      (fun γ' _ => ⟨f_fn γ', Finset.mem_univ _, hgf γ'⟩) ?_
    intro γ _
    have hcond : treeValid P V r T γ₀ γ ↔
        treeValid P (Finset.univ : Finset (Fin (m + 1))) 0 (mapE T) γ₀ (g_fn γ) := by
      unfold treeValid
      constructor
      · rintro ⟨hroot, hedges⟩
        refine ⟨fun _ => ?_, fun e' he' => ?_⟩
        · dsimp [g_fn]
          have hbr : (⟨bwd 0, hbwd_mem 0⟩ : V) = ⟨r, hr⟩ := by
            apply Subtype.ext
            dsimp [bwd]
            rw [← her]
            exact congrArg Subtype.val (e.symm_apply_apply ⟨r, hr⟩)
          rw [hbr]
          exact hroot hr
        · rw [Finset.mem_image] at he'
          obtain ⟨e1, he1, rfl⟩ := he'
          obtain ⟨u, hu, v, hv, rfl, hin⟩ := hedges e1 he1
          refine ⟨fwd u, Finset.mem_univ _, fwd v, Finset.mem_univ _, by simp, ?_⟩
          dsimp [g_fn]
          have hbu : (⟨bwd (fwd u), hbwd_mem (fwd u)⟩ : V) = ⟨u, hu⟩ :=
            Subtype.ext (hbwd_fwd u hu)
          have hbv : (⟨bwd (fwd v), hbwd_mem (fwd v)⟩ : V) = ⟨v, hv⟩ :=
            Subtype.ext (hbwd_fwd v hv)
          rwa [hbu, hbv]
      · rintro ⟨hroot', hedges'⟩
        refine ⟨fun _ => ?_, fun e1 he1 => ?_⟩
        · have h0 := hroot' (Finset.mem_univ _)
          dsimp [g_fn] at h0
          have hbr : (⟨bwd 0, hbwd_mem 0⟩ : V) = ⟨r, hr⟩ := by
            apply Subtype.ext
            dsimp [bwd]
            rw [← her]
            exact congrArg Subtype.val (e.symm_apply_apply ⟨r, hr⟩)
          rwa [hbr] at h0
        · have he1' : Sym2.map fwd e1 ∈ mapE T := Finset.mem_image_of_mem _ he1
          obtain ⟨i, _, j, _, hij, hin⟩ := hedges' _ he1'
          induction e1 using Sym2.ind with
          | _ u v =>
            have huv := (mem_completeEdges_iff).mp (hTV he1)
            rw [Sym2.map_mk, Sym2.eq_iff] at hij
            refine ⟨u, huv.1, v, huv.2.1, rfl, ?_⟩
            dsimp [g_fn] at hin
            have hbu : (⟨bwd (fwd u), hbwd_mem (fwd u)⟩ : V) = ⟨u, huv.1⟩ :=
              Subtype.ext (hbwd_fwd u huv.1)
            have hbv : (⟨bwd (fwd v), hbwd_mem (fwd v)⟩ : V) = ⟨v, huv.2.1⟩ :=
              Subtype.ext (hbwd_fwd v huv.2.1)
            rcases hij with ⟨h1, h2⟩ | ⟨h1, h2⟩
            · have hi' : (⟨bwd i, hbwd_mem i⟩ : V) = ⟨u, huv.1⟩ := by
                rw [← h1]; exact hbu
              have hj' : (⟨bwd j, hbwd_mem j⟩ : V) = ⟨v, huv.2.1⟩ := by
                rw [← h2]; exact hbv
              rwa [hi', hj'] at hin
            · have hi' : (⟨bwd i, hbwd_mem i⟩ : V) = ⟨v, huv.2.1⟩ := by
                rw [← h2]; exact hbv
              have hj' : (⟨bwd j, hbwd_mem j⟩ : V) = ⟨u, huv.1⟩ := by
                rw [← h1]; exact hbu
              rw [hi', hj'] at hin
              exact P.incomp_symm _ _ hin
    by_cases h1 : treeValid P V r T γ₀ γ
    · have h2 : treeValid P (Finset.univ : Finset (Fin (m + 1))) 0 (mapE T) γ₀ (g_fn γ) :=
        hcond.mp h1
      rw [if_pos h1, if_pos h2]
      have heq_r : (⟨r, hr⟩ : V) = ⟨bwd 0, hbwd_mem 0⟩ := by
        apply Subtype.ext
        dsimp [bwd]
        rw [← her]
        exact congrArg Subtype.val (e.symm_apply_apply ⟨r, hr⟩) |>.symm
      refine Finset.prod_bij (fun x _ => ⟨fwd x.1, Finset.mem_univ _⟩) ?_ ?_ ?_ ?_
      · intro x hx
        rw [Finset.mem_filter] at hx ⊢
        refine ⟨Finset.mem_attach _ _, fun h => hx.2 ?_⟩
        have h' : fwd x.1 = 0 := h
        have := congrArg bwd h'
        rw [hbwd_fwd x.1 x.2] at this
        have hx' : x = ⟨bwd 0, hbwd_mem 0⟩ := Subtype.ext this
        rw [← heq_r] at hx'
        exact congrArg Subtype.val hx'
      · intro x1 _ x2 _ heq
        have h' : fwd x1.1 = fwd x2.1 := congrArg Subtype.val heq
        exact Subtype.ext (hfwd_inj x1.2 x2.2 h')
      · intro i hi
        rw [Finset.mem_filter] at hi
        refine ⟨⟨bwd i.1, hbwd_mem i.1⟩, Finset.mem_filter.mpr ⟨Finset.mem_attach _ _, fun h => hi.2 ?_⟩, ?_⟩
        · have h' : bwd i.1 = r := h
          have := congrArg fwd h'
          rw [hfwd_bwd i.1] at this
          simp only [fwd, hr, ↓reduceDIte, her] at this
          exact this
        · apply Subtype.ext; dsimp; exact hfwd_bwd i.1
      · intro x _
        dsimp [g_fn]
        have hbx : (⟨bwd (fwd x.1), hbwd_mem (fwd x.1)⟩ : V) = x :=
          Subtype.ext (hbwd_fwd x.1 x.2)
        rw [hbx]
    · have h2 : ¬ treeValid P (Finset.univ : Finset (Fin (m + 1))) 0 (mapE T) γ₀ (g_fn γ) :=
        mt hcond.mpr h1
      rw [if_neg h1, if_neg h2]
  unfold treeTotalSum
  refine Finset.sum_bij (fun T _ => mapE T) htree_fwd ?_ ?_ htree_act
  · intro T1 hT1 T2 hT2 heq
    have h1 := Finset.mem_powerset.mp (Finset.mem_filter.mp hT1).1
    have h2 := Finset.mem_powerset.mp (Finset.mem_filter.mp hT2).1
    have := congrArg unmapE heq
    rwa [hunmap_map T1 h1, hunmap_map T2 h2] at this
  · intro T' hT'
    obtain ⟨hT'c, hT'sp⟩ := Finset.mem_filter.mp hT'
    rw [Finset.mem_powerset] at hT'c
    refine ⟨unmapE T', Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (hunmap_comp T' hT'c), ?_⟩,
      hmap_unmap T' hT'c⟩
    refine ⟨⟨hunmap_comp T' hT'c, fun v hv => ?_⟩, ?_⟩
    · obtain ⟨k, hk⟩ := hT'sp.1.2 (fwd v) (Finset.mem_univ _)
      have := hwalk_bwd T' hT'c k (fwd v) hk
      rw [hbwd_fwd v hv] at this
      exact ⟨k, this⟩
    · have hunmap_card : (unmapE T').card = T'.card := by
        have := hmap_injOn (unmapE T') (hunmap_comp T' hT'c)
        rw [hmap_unmap T' hT'c] at this
        exact this.symm
      rw [hunmap_card, hT'sp.2, hcard]
      simp

lemma kpTreeTerm_zero (P : KPPolymerSystem) (γ₀ : P.Pol) :
    kpTreeTerm P 0 γ₀ = 1 := by
  have htrees : (completeEdges (Finset.univ : Finset (Fin 1))).powerset.filter
      (IsSpanningTree Finset.univ (0 : Fin 1)) = {∅} := by
    ext T
    simp only [Finset.mem_filter, Finset.mem_powerset, Finset.mem_singleton]
    constructor
    · rintro ⟨hT, _⟩
      have hce : completeEdges (Finset.univ : Finset (Fin 1)) = ∅ := by
        ext e
        induction e using Sym2.ind with
        | _ a b =>
          simp only [mem_completeEdges_iff, Finset.notMem_empty, iff_false, not_and, not_not]
          intro _ _; exact Subsingleton.elim a b
      rw [hce, Finset.subset_empty] at hT
      exact hT
    · rintro rfl
      refine ⟨Finset.empty_subset _, ⟨Finset.empty_subset _, fun v _ => ⟨0, ?_⟩⟩, by simp⟩
      exact (Subsingleton.elim 0 v : (0 : Fin 1) = v)
  have hsum : treeActivitySum P (Finset.univ : Finset (Fin 1)) 0 ∅ γ₀ = 1 := by
    unfold treeActivitySum
    let γ_const : (↥(Finset.univ : Finset (Fin 1))) → P.Pol := fun _ => γ₀
    rw [Finset.sum_eq_single γ_const]
    · have hfilt : (Finset.univ : Finset (Fin 1)).attach.filter (fun v => v.1 ≠ 0) = ∅ := by
        ext ⟨v, _⟩
        simp [Subsingleton.elim v 0]
      rw [if_pos (by unfold treeValid; exact ⟨fun _ => rfl, fun _ h => absurd h (Finset.notMem_empty _)⟩),
        hfilt, Finset.prod_empty]
    · intro γ _ hne
      rw [if_neg]
      rintro ⟨hroot, _⟩
      apply hne
      funext ⟨x, _⟩
      have hx0 : x = 0 := Subsingleton.elim x 0
      subst hx0
      exact hroot (Finset.mem_univ 0)
    · intro h
      exact absurd (Finset.mem_univ γ_const) h
  unfold kpTreeTerm treeTotalSum
  rw [htrees, Finset.sum_singleton, hsum]
  simp

section TreeDecomp

private lemma isConnected_card_le {α : Type*} [DecidableEq α] [LinearOrder α]
    {V : Finset α} {r : α} (hr : r ∈ V) {E : Finset (Sym2 α)} (hconn : IsConnected V r E) :
    V.card - 1 ≤ E.card := by
  have hsub : penroseTree V r E hconn ⊆ E := penroseTree_subset hconn
  have hcard : (penroseTree V r E hconn).card + 1 = V.card := penroseTree_card hr hconn
  have hle : (penroseTree V r E hconn).card ≤ E.card := Finset.card_le_card hsub
  omega

/-- Children of `0` in a spanning tree `T` on `Fin (m + 2)`. `[B]` -/
noncomputable def treeChildren {m : ℕ} (T : Finset (Sym2 (Fin (m + 2)))) :
    Finset (Fin (m + 2)) :=
  (Finset.univ.erase (0 : Fin (m + 2))).filter (fun c => gAdj T 0 c)

/-- Iterated `penroseParent` map on `Fin (m + 2)`. `[B]` -/
noncomputable def iterPenroseParent {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) :
    ℕ → Fin (m + 2) → Fin (m + 2)
  | 0, v => v
  | k + 1, v => iterPenroseParent T hT k (penroseParent Finset.univ 0 T hT.1 v)

/-- Unique child of `0` that is an ancestor of `v ≠ 0` in `T`. `[B]` -/
noncomputable def rootChild {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) (v : Fin (m + 2)) : Fin (m + 2) :=
  iterPenroseParent T hT (gDist Finset.univ 0 T hT.1 v - 1) v

lemma iterPenroseParent_dist {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    (d k : ℕ) (v : Fin (m + 2)) (hv : gDist Finset.univ 0 T hT.1 v = d + k) :
    gDist Finset.univ 0 T hT.1 (iterPenroseParent T hT k v) = d := by
  induction k generalizing v d with
  | zero => simpa [iterPenroseParent] using hv
  | succ k ih =>
    have hne : v ≠ 0 := by
      intro h0; subst h0
      rw [gDist_root (Finset.mem_univ 0) hT.1] at hv
      omega
    have hspec := penroseParent_spec hT.1 (Finset.mem_univ v) hne
    have hp : gDist Finset.univ 0 T hT.1 (penroseParent Finset.univ 0 T hT.1 v) = d + k := by
      omega
    exact ih d (penroseParent Finset.univ 0 T hT.1 v) hp

lemma iterPenroseParent_walk {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    (k : ℕ) (v : Fin (m + 2)) (hv : k < gDist Finset.univ 0 T hT.1 v)
    (hSub : ∀ j ≤ k, iterPenroseParent T hT j v ∈
      (Finset.univ.erase (0 : Fin (m + 2))).filter (fun w => rootChild T hT w = rootChild T hT v)) :
    ∃ len, GWalk (T.filter (fun e => ∀ u ∈ e, u ∈
      (Finset.univ.erase (0 : Fin (m + 2))).filter (fun w => rootChild T hT w = rootChild T hT v)))
      (iterPenroseParent T hT k v) v len := by
  let compV := (Finset.univ.erase (0 : Fin (m + 2))).filter (fun w => rootChild T hT w = rootChild T hT v)
  let T_sub := T.filter (fun e => ∀ u ∈ e, u ∈ compV)
  induction k generalizing v with
  | zero => exact ⟨0, rfl⟩
  | succ k ih =>
    have hne : v ≠ 0 := by
      intro h0; subst h0
      rw [gDist_root (Finset.mem_univ 0) hT.1] at hv
      omega
    let p := penroseParent Finset.univ 0 T hT.1 v
    have hspec := penroseParent_spec hT.1 (Finset.mem_univ v) hne
    have hp_dist : gDist Finset.univ 0 T hT.1 p + 1 = gDist Finset.univ 0 T hT.1 v := hspec.2
    have hrc_p : rootChild T hT p = rootChild T hT v := by
      unfold rootChild
      have hpos : 1 ≤ gDist Finset.univ 0 T hT.1 p := by omega
      have heq : gDist Finset.univ 0 T hT.1 v - 1 = (gDist Finset.univ 0 T hT.1 p - 1) + 1 := by omega
      rw [heq]
      rfl
    have hSub_p : ∀ j ≤ k, iterPenroseParent T hT j p ∈ compV := by
      intro j hj
      have hj1 := hSub (j + 1) (by omega)
      have hit : iterPenroseParent T hT (j + 1) v = iterPenroseParent T hT j p := rfl
      rw [hit] at hj1
      exact hj1
    obtain ⟨len, hwalk⟩ := ih p (by omega) (fun j hj => by
      have := hSub_p j hj
      simpa [compV, hrc_p] using this)
    have hwalk' : GWalk T_sub (iterPenroseParent T hT k p) p len := by
      simpa [T_sub, compV, hrc_p] using hwalk
    have hv_mem : v ∈ compV := hSub 0 (Nat.zero_le _)
    have hp_mem : p ∈ compV := hSub 1 (by omega)
    have he_mem : s(p, v) ∈ T_sub := by
      rw [Finset.mem_filter]
      refine ⟨hspec.1.2, fun u hu => ?_⟩
      rw [Sym2.mem_iff] at hu
      rcases hu with rfl | rfl <;> assumption
    exact ⟨len + 1, p, hwalk', hspec.1.1, he_mem⟩

lemma rootChild_mem_children {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    {v : Fin (m + 2)} (hv : v ≠ 0) :
    rootChild T hT v ∈ treeChildren T := by
  have hpos := gDist_pos_of_ne hT.1 (Finset.mem_univ v) hv
  have hd1 : gDist Finset.univ 0 T hT.1 (rootChild T hT v) = 1 := by
    unfold rootChild
    apply iterPenroseParent_dist
    omega
  have hne : rootChild T hT v ≠ 0 := by
    intro h0
    rw [h0, gDist_root (Finset.mem_univ 0) hT.1] at hd1
    omega
  have hspec := penroseParent_spec hT.1 (Finset.mem_univ (rootChild T hT v)) hne
  have hp0 : penroseParent Finset.univ 0 T hT.1 (rootChild T hT v) = 0 := by
    have hp_d0 : gDist Finset.univ 0 T hT.1
        (penroseParent Finset.univ 0 T hT.1 (rootChild T hT v)) = 0 := by omega
    have hw := gDist_spec hT.1 (Finset.mem_univ (penroseParent Finset.univ 0 T hT.1 (rootChild T hT v)))
    rw [hp_d0] at hw
    exact hw.symm
  rw [hp0] at hspec
  exact Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hne, Finset.mem_univ _⟩, hspec.1⟩

lemma rootChild_eq_of_mem_children {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    {c : Fin (m + 2)} (hc : c ∈ treeChildren T) :
    rootChild T hT c = c := by
  have hce := Finset.mem_filter.mp hc
  have hne : c ≠ 0 := Finset.ne_of_mem_erase hce.1
  have hpos := gDist_pos_of_ne hT.1 (Finset.mem_univ c) hne
  have hle : gDist Finset.univ 0 T hT.1 c ≤ 1 :=
    gDist_adj_le hT.1 (Finset.mem_univ 0) (Finset.mem_univ c) hce.2 |>.trans_eq
      (by rw [gDist_root (Finset.mem_univ 0) hT.1])
  have hd1 : gDist Finset.univ 0 T hT.1 c - 1 = 0 := by omega
  unfold rootChild
  rw [hd1]
  rfl

lemma rootChild_penroseParent {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    {v : Fin (m + 2)} (hv : 1 < gDist Finset.univ 0 T hT.1 v) :
    rootChild T hT (penroseParent Finset.univ 0 T hT.1 v) = rootChild T hT v := by
  have hne : v ≠ 0 := by
    intro h0; subst h0; rw [gDist_root (Finset.mem_univ 0) hT.1] at hv; omega
  have hspec := penroseParent_spec hT.1 (Finset.mem_univ v) hne
  have heq : gDist Finset.univ 0 T hT.1 v - 1 =
      (gDist Finset.univ 0 T hT.1 (penroseParent Finset.univ 0 T hT.1 v) - 1) + 1 := by omega
  unfold rootChild
  rw [heq]
  rfl

lemma rootChild_iterPenroseParent {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    (j : ℕ) (v : Fin (m + 2)) (hj : j < gDist Finset.univ 0 T hT.1 v) :
    rootChild T hT (iterPenroseParent T hT j v) = rootChild T hT v := by
  induction j generalizing v with
  | zero => rfl
  | succ j ih =>
    have hne : v ≠ 0 := by
      intro h0; subst h0; rw [gDist_root (Finset.mem_univ 0) hT.1] at hj; omega
    have hspec := penroseParent_spec hT.1 (Finset.mem_univ v) hne
    have hlt1 : 1 < gDist Finset.univ 0 T hT.1 v := by omega
    have hltj : j < gDist Finset.univ 0 T hT.1 (penroseParent Finset.univ 0 T hT.1 v) := by omega
    change rootChild T hT (iterPenroseParent T hT j (penroseParent Finset.univ 0 T hT.1 v)) = _
    rw [ih _ hltj, rootChild_penroseParent T hT hlt1]

lemma treeChildren_nonempty {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) :
    (treeChildren T).Nonempty := by
  have h10 : (1 : Fin (m + 2)) ≠ 0 := by
    intro h
    have hv := congrArg Fin.val h
    simp [Nat.mod_eq_of_lt (by omega : 1 < m + 2)] at hv
  exact ⟨rootChild T hT 1, rootChild_mem_children T hT h10⟩

/-- Component of `Finset.univ.erase 0` below child `c` in spanning tree `T`. `[B]` -/
noncomputable def treeComp {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) (c : Fin (m + 2)) :
    Finset (Fin (m + 2)) :=
  (Finset.univ.erase (0 : Fin (m + 2))).filter (fun v => rootChild T hT v = c)

/-- Subtree of `T` induced on `treeComp T hT c`. `[B]` -/
noncomputable def treeSub {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) (c : Fin (m + 2)) :
    Finset (Sym2 (Fin (m + 2))) :=
  T.filter (fun e => ∀ u ∈ e, u ∈ treeComp T hT c)

lemma treeSub_isSpanningTree {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) :
    ∀ c ∈ treeChildren T, IsSpanningTree (treeComp T hT c) c (treeSub T hT c) := by
  have hc_mem : ∀ c ∈ treeChildren T, c ∈ treeComp T hT c := by
    intro c hc
    rw [treeComp, Finset.mem_filter]
    exact ⟨(Finset.mem_filter.mp hc).1, rootChild_eq_of_mem_children T hT hc⟩
  have hcomp_conn : ∀ c ∈ treeChildren T, IsConnected (treeComp T hT c) c (treeSub T hT c) := by
    intro c hc
    refine ⟨?_, fun v hv => ?_⟩
    · intro e he
      rw [treeSub, Finset.mem_filter] at he
      induction e using Sym2.ind with
      | _ a b =>
        have hab := (mem_completeEdges_iff).mp (hT.1.1 he.1)
        rw [mem_completeEdges_iff]
        exact ⟨he.2 a (by simp), he.2 b (by simp), hab.2.2⟩
    · have hv' := Finset.mem_filter.mp hv
      have hv_ne : v ≠ 0 := Finset.ne_of_mem_erase hv'.1
      have hrc_eq : rootChild T hT v = c := hv'.2
      have hv_pos := gDist_pos_of_ne hT.1 (Finset.mem_univ v) hv_ne
      have hSub : ∀ j ≤ gDist Finset.univ 0 T hT.1 v - 1,
          iterPenroseParent T hT j v ∈
            (Finset.univ.erase (0 : Fin (m + 2))).filter
              (fun w => rootChild T hT w = rootChild T hT v) := by
        intro j hj
        have hjd : gDist Finset.univ 0 T hT.1 (iterPenroseParent T hT j v) =
            gDist Finset.univ 0 T hT.1 v - j := by
          apply iterPenroseParent_dist
          omega
        have hj_ne : iterPenroseParent T hT j v ≠ 0 := by
          intro h0
          rw [h0, gDist_root (Finset.mem_univ 0) hT.1] at hjd
          omega
        have hrc_j : rootChild T hT (iterPenroseParent T hT j v) = rootChild T hT v :=
          rootChild_iterPenroseParent T hT j v (by omega)
        exact Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hj_ne, Finset.mem_univ _⟩, hrc_j⟩
      obtain ⟨len, hwalk⟩ := iterPenroseParent_walk T hT
        (gDist Finset.univ 0 T hT.1 v - 1) v (by omega) hSub
      change GWalk (treeSub T hT (rootChild T hT v)) (rootChild T hT v) v len at hwalk
      rw [hrc_eq] at hwalk
      exact ⟨len, hwalk⟩
  have hpart : (treeChildren T).biUnion (treeComp T hT) = Finset.univ.erase (0 : Fin (m + 2)) := by
    ext v
    simp only [Finset.mem_biUnion, treeComp, Finset.mem_filter, Finset.mem_erase]
    constructor
    · rintro ⟨c, _, hv, _⟩; exact hv
    · rintro ⟨hvne, hvu⟩
      exact ⟨rootChild T hT v, rootChild_mem_children T hT hvne, ⟨hvne, hvu⟩, rfl⟩
  have hdisj : Set.PairwiseDisjoint ↑(treeChildren T) (treeComp T hT) := by
    intro c1 _ c2 _ hne
    change Disjoint (treeComp T hT c1) (treeComp T hT c2)
    rw [Finset.disjoint_left]
    intro v hv1 hv2
    rw [treeComp, Finset.mem_filter] at hv1 hv2
    exact hne (hv1.2.symm.trans hv2.2)
  have hedge_cover : T =
      (treeChildren T).image (fun c => s(0, c)) ∪ (treeChildren T).biUnion (treeSub T hT) := by
    ext e
    rw [Finset.mem_union, Finset.mem_image, Finset.mem_biUnion]
    constructor
    · intro he
      have he_pt : e ∈ penroseTree Finset.univ 0 T hT.1 := by
        rwa [penroseTree_eq_self (Finset.mem_univ 0) hT]
      unfold penroseTree at he_pt
      rw [Finset.mem_image] at he_pt
      obtain ⟨v, hv_er, rfl⟩ := he_pt
      have hv_ne : v ≠ 0 := Finset.ne_of_mem_erase hv_er
      let p := penroseParent Finset.univ 0 T hT.1 v
      have hspec := penroseParent_spec hT.1 (Finset.mem_univ v) hv_ne
      by_cases hp0 : p = 0
      · refine Or.inl ⟨v, ?_, ?_⟩
        · exact Finset.mem_filter.mpr ⟨hv_er, by simpa [p, hp0] using hspec.1⟩
        · change s(0, v) = s(p, v); rw [hp0]
      · refine Or.inr ⟨rootChild T hT v, rootChild_mem_children T hT hv_ne, ?_⟩
        rw [treeSub, Finset.mem_filter]
        refine ⟨he, fun u hu => ?_⟩
        rw [Sym2.mem_iff] at hu
        have hp_dist : gDist Finset.univ 0 T hT.1 p + 1 = gDist Finset.univ 0 T hT.1 v := hspec.2
        have hrc_p : rootChild T hT p = rootChild T hT v := by
          have hv_pos := gDist_pos_of_ne hT.1 (Finset.mem_univ v) hv_ne
          have hp_pos := gDist_pos_of_ne hT.1 (Finset.mem_univ p) hp0
          have heq : gDist Finset.univ 0 T hT.1 v - 1 =
              (gDist Finset.univ 0 T hT.1 p - 1) + 1 := by omega
          unfold rootChild
          rw [heq]
          rfl
        rcases hu with rfl | rfl
        · exact Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hp0, Finset.mem_univ _⟩, hrc_p⟩
        · exact Finset.mem_filter.mpr ⟨hv_er, rfl⟩
    · rintro (⟨c, hc, rfl⟩ | ⟨c, _, he_sub⟩)
      · exact (Finset.mem_filter.mp hc).2.2
      · exact (Finset.mem_filter.mp he_sub).1
  have hedge_disj : Disjoint ((treeChildren T).image (fun c => s(0, c)))
      ((treeChildren T).biUnion (treeSub T hT)) := by
    rw [Finset.disjoint_left]
    intro e he1 he2
    rw [Finset.mem_image] at he1
    rw [Finset.mem_biUnion] at he2
    obtain ⟨c1, _, rfl⟩ := he1
    obtain ⟨c2, _, he2⟩ := he2
    rw [treeSub, Finset.mem_filter] at he2
    have h0 : (0 : Fin (m + 2)) ∈ treeComp T hT c2 := he2.2 0 (by simp)
    rw [treeComp, Finset.mem_filter, Finset.mem_erase] at h0
    exact h0.1.1 rfl
  have hsub_disj : Set.PairwiseDisjoint ↑(treeChildren T) (treeSub T hT) := by
    intro c1 hc1 c2 hc2 hne
    change Disjoint (treeSub T hT c1) (treeSub T hT c2)
    rw [Finset.disjoint_left]
    intro e he1 he2
    rw [treeSub, Finset.mem_filter] at he1 he2
    induction e using Sym2.ind with
    | _ a b =>
      have ha1 := he1.2 a (by simp)
      have ha2 := he2.2 a (by simp)
      exact Finset.disjoint_left.mp (hdisj hc1 hc2 hne) ha1 ha2
  have hT_card_sum : T.card = (treeChildren T).card + ∑ c ∈ treeChildren T, (treeSub T hT c).card := by
    conv_lhs => rw [hedge_cover]
    rw [Finset.card_union_of_disjoint hedge_disj, Finset.card_biUnion hsub_disj]
    congr 1
    apply Finset.card_image_of_injOn
    intro c1 hc1 c2 hc2 heq
    rw [Sym2.eq_iff] at heq
    rcases heq with ⟨_, h⟩ | ⟨h1, _⟩
    · exact h
    · exact absurd h1.symm (Finset.ne_of_mem_erase (Finset.mem_filter.mp hc2).1)
  have hV_card_sum : m + 1 = ∑ c ∈ treeChildren T, (treeComp T hT c).card := by
    have := Finset.card_biUnion hdisj
    rw [hpart, Finset.card_erase_of_mem (Finset.mem_univ 0), Finset.card_univ, Fintype.card_fin] at this
    omega
  have hT_card_eq : T.card = m + 1 := by
    have := hT.2
    rw [Finset.card_univ, Fintype.card_fin] at this
    omega
  have hcard_each : ∀ c ∈ treeChildren T, (treeComp T hT c).card - 1 ≤ (treeSub T hT c).card :=
    fun c hc => isConnected_card_le (hc_mem c hc) (hcomp_conn c hc)
  have hsum_comp_sub : (∑ c ∈ treeChildren T, ((treeComp T hT c).card - 1)) + (treeChildren T).card =
      ∑ c ∈ treeChildren T, (treeComp T hT c).card := by
    calc (∑ c ∈ treeChildren T, ((treeComp T hT c).card - 1)) + (treeChildren T).card
        = ∑ c ∈ treeChildren T, ((treeComp T hT c).card - 1 + 1) := by
          rw [Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul, mul_one]
      _ = ∑ c ∈ treeChildren T, (treeComp T hT c).card := by
          refine Finset.sum_congr rfl (fun c hc => ?_)
          exact Nat.sub_add_cancel (Finset.card_pos.mpr ⟨c, hc_mem c hc⟩)
  intro c hc
  refine ⟨hcomp_conn c hc, ?_⟩
  have hle : (treeSub T hT c).card ≤ (treeComp T hT c).card - 1 := by
    by_contra hgt
    rw [not_le] at hgt
    have hstrict : ∑ x ∈ treeChildren T, ((treeComp T hT x).card - 1) <
        ∑ x ∈ treeChildren T, (treeSub T hT x).card :=
      Finset.sum_lt_sum hcard_each ⟨c, hc, hgt⟩
    omega
  have hge := hcard_each c hc
  have hpos : 1 ≤ (treeComp T hT c).card := Finset.card_pos.mpr ⟨c, hc_mem c hc⟩
  omega

lemma treeComp_mem_self {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T)
    {c : Fin (m + 2)} (hc : c ∈ treeChildren T) :
    c ∈ treeComp T hT c :=
  Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hc).1, rootChild_eq_of_mem_children T hT hc⟩

lemma treeComp_biUnion {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) :
    (treeChildren T).biUnion (treeComp T hT) = Finset.univ.erase (0 : Fin (m + 2)) := by
  ext v
  simp only [Finset.mem_biUnion, treeComp, Finset.mem_filter, Finset.mem_erase]
  constructor
  · rintro ⟨c, _, hv, _⟩; exact hv
  · rintro ⟨hvne, hvu⟩
    exact ⟨rootChild T hT v, rootChild_mem_children T hT hvne, ⟨hvne, hvu⟩, rfl⟩

lemma treeComp_disjoint {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) :
    Set.PairwiseDisjoint ↑(treeChildren T) (treeComp T hT) := by
  intro c1 _ c2 _ hne
  change Disjoint (treeComp T hT c1) (treeComp T hT c2)
  rw [Finset.disjoint_left]
  intro v hv1 hv2
  rw [treeComp, Finset.mem_filter] at hv1 hv2
  exact hne (hv1.2.symm.trans hv2.2)

lemma tree_eq_biUnion_treeSub {m : ℕ} (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) :
    T = (treeChildren T).image (fun c => s(0, c)) ∪ (treeChildren T).biUnion (treeSub T hT) := by
  ext e
  rw [Finset.mem_union, Finset.mem_image, Finset.mem_biUnion]
  constructor
  · intro he
    have he_pt : e ∈ penroseTree Finset.univ 0 T hT.1 := by
      rwa [penroseTree_eq_self (Finset.mem_univ 0) hT]
    unfold penroseTree at he_pt
    rw [Finset.mem_image] at he_pt
    obtain ⟨v, hv_er, rfl⟩ := he_pt
    have hv_ne : v ≠ 0 := Finset.ne_of_mem_erase hv_er
    let p := penroseParent Finset.univ 0 T hT.1 v
    have hspec := penroseParent_spec hT.1 (Finset.mem_univ v) hv_ne
    by_cases hp0 : p = 0
    · refine Or.inl ⟨v, ?_, ?_⟩
      · exact Finset.mem_filter.mpr ⟨hv_er, by simpa [p, hp0] using hspec.1⟩
      · change s(0, v) = s(p, v); rw [hp0]
    · refine Or.inr ⟨rootChild T hT v, rootChild_mem_children T hT hv_ne, ?_⟩
      rw [treeSub, Finset.mem_filter]
      refine ⟨he, fun u hu => ?_⟩
      rw [Sym2.mem_iff] at hu
      have hp_dist : gDist Finset.univ 0 T hT.1 p + 1 = gDist Finset.univ 0 T hT.1 v := hspec.2
      have hrc_p : rootChild T hT p = rootChild T hT v := by
        have hv_pos := gDist_pos_of_ne hT.1 (Finset.mem_univ v) hv_ne
        have hp_pos := gDist_pos_of_ne hT.1 (Finset.mem_univ p) hp0
        have heq : gDist Finset.univ 0 T hT.1 v - 1 =
            (gDist Finset.univ 0 T hT.1 p - 1) + 1 := by omega
        unfold rootChild
        rw [heq]
        rfl
      rcases hu with rfl | rfl
      · exact Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hp0, Finset.mem_univ _⟩, hrc_p⟩
      · exact Finset.mem_filter.mpr ⟨hv_er, rfl⟩
  · rintro (⟨c, hc, rfl⟩ | ⟨c, _, he_sub⟩)
    · exact (Finset.mem_filter.mp hc).2.2
    · exact (Finset.mem_filter.mp he_sub).1

def branchValid (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (c : α) (hc : c ∈ V) (T_sub : Finset (Sym2 α)) (γ₀ : P.Pol)
    (γ_sub : ↥V → P.Pol) : Prop :=
  P.incomp γ₀ (γ_sub ⟨c, hc⟩) ∧
  (∀ e ∈ T_sub, ∃ (u : α) (hu : u ∈ V) (v : α) (hv : v ∈ V),
    e = s(u, v) ∧ P.incomp (γ_sub ⟨u, hu⟩) (γ_sub ⟨v, hv⟩))

lemma treeActivitySum_branch_factor (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (c : α) (hc : c ∈ V) (T_sub : Finset (Sym2 α)) (γ₀ : P.Pol) :
    (∑ γ_c : P.Pol,
      if P.incomp γ₀ γ_c then
        kpWeight P γ_c * treeActivitySum P V c T_sub γ_c
      else 0) =
    ∑ γ_sub : ↥V → P.Pol,
      if branchValid P V c hc T_sub γ₀ γ_sub then
        kpWeight P (γ_sub ⟨c, hc⟩) *
          ∏ v ∈ V.attach.filter (fun v => v.1 ≠ c), kpWeight P (γ_sub v)
      else 0 := by
  unfold treeActivitySum
  calc
    (∑ γ_c : P.Pol,
        if P.incomp γ₀ γ_c then
          kpWeight P γ_c * ∑ γ_sub : ↥V → P.Pol,
            if treeValid P V c T_sub γ_c γ_sub then
              ∏ v ∈ V.attach.filter (fun v => v.1 ≠ c), kpWeight P (γ_sub v)
            else 0
        else 0)
        = ∑ γ_c : P.Pol, ∑ γ_sub : ↥V → P.Pol,
            if γ_sub ⟨c, hc⟩ = γ_c then
              if branchValid P V c hc T_sub γ₀ γ_sub then
                kpWeight P (γ_sub ⟨c, hc⟩) *
                  ∏ v ∈ V.attach.filter (fun v => v.1 ≠ c), kpWeight P (γ_sub v)
              else 0
            else 0 := by
          refine Finset.sum_congr rfl (fun γ_c _ => ?_)
          by_cases hin : P.incomp γ₀ γ_c
          · rw [if_pos hin, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun γ_sub _ => ?_)
            by_cases hroot : γ_sub ⟨c, hc⟩ = γ_c
            · rw [if_pos hroot]
              by_cases hbr : branchValid P V c hc T_sub γ₀ γ_sub
              · have htv : treeValid P V c T_sub γ_c γ_sub := by
                  unfold treeValid
                  exact ⟨fun _ => hroot, hbr.2⟩
                rw [if_pos htv, if_pos hbr, hroot]
              · have htv : ¬ treeValid P V c T_sub γ_c γ_sub := by
                  intro h
                  apply hbr
                  unfold branchValid
                  exact ⟨hroot.symm ▸ hin, h.2⟩
                rw [if_neg htv, if_neg hbr, mul_zero]
            · rw [if_neg hroot]
              have htv : ¬ treeValid P V c T_sub γ_c γ_sub := fun h => hroot (h.1 hc)
              rw [if_neg htv, mul_zero]
          · rw [if_neg hin]
            symm
            refine Finset.sum_eq_zero (fun γ_sub _ => ?_)
            by_cases hroot : γ_sub ⟨c, hc⟩ = γ_c
            · rw [if_pos hroot]
              have hbr : ¬ branchValid P V c hc T_sub γ₀ γ_sub := fun h => hin (hroot ▸ h.1)
              rw [if_neg hbr]
            · rw [if_neg hroot]
    _ = ∑ γ_sub : ↥V → P.Pol, ∑ γ_c : P.Pol,
          if γ_sub ⟨c, hc⟩ = γ_c then
            if branchValid P V c hc T_sub γ₀ γ_sub then
              kpWeight P (γ_sub ⟨c, hc⟩) *
                ∏ v ∈ V.attach.filter (fun v => v.1 ≠ c), kpWeight P (γ_sub v)
            else 0
          else 0 := Finset.sum_comm
    _ = ∑ γ_sub : ↥V → P.Pol,
          if branchValid P V c hc T_sub γ₀ γ_sub then
            kpWeight P (γ_sub ⟨c, hc⟩) *
              ∏ v ∈ V.attach.filter (fun v => v.1 ≠ c), kpWeight P (γ_sub v)
          else 0 := by
        refine Finset.sum_congr rfl (fun γ_sub _ => ?_)
        simp only [Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]

lemma treeActivitySum_decomp (P : KPPolymerSystem) {m : ℕ}
    (T : Finset (Sym2 (Fin (m + 2))))
    (hT : IsSpanningTree Finset.univ (0 : Fin (m + 2)) T) (γ₀ : P.Pol) :
    treeActivitySum P Finset.univ 0 T γ₀ =
      ∏ c ∈ treeChildren T, ∑ γ_c : P.Pol,
        if P.incomp γ₀ γ_c then
          kpWeight P γ_c * treeActivitySum P (treeComp T hT c) c (treeSub T hT c) γ_c
        else 0 := by
  have hpart := treeComp_biUnion T hT
  have hdisj := treeComp_disjoint T hT
  have hcov := tree_eq_biUnion_treeSub T hT
  have hmem_self : ∀ c ∈ treeChildren T, c ∈ treeComp T hT c :=
    fun _ hc => treeComp_mem_self T hT hc
  have hprod_sum :
      (∏ c ∈ treeChildren T, ∑ γ_c : P.Pol,
        if P.incomp γ₀ γ_c then
          kpWeight P γ_c * treeActivitySum P (treeComp T hT c) c (treeSub T hT c) γ_c
        else 0) =
      ∑ Γ : (Π c : ↥(treeChildren T), ↥(treeComp T hT c.1) → P.Pol),
        ∏ c : ↥(treeChildren T),
          if branchValid P (treeComp T hT c.1) c.1 (hmem_self c.1 c.2) (treeSub T hT c.1) γ₀ (Γ c) then
            kpWeight P (Γ c ⟨c.1, hmem_self c.1 c.2⟩) *
              ∏ v ∈ (treeComp T hT c.1).attach.filter (fun v => v.1 ≠ c.1),
                kpWeight P (Γ c v)
          else 0 := by
    rw [← Finset.prod_coe_sort (treeChildren T)]
    have hprod_eq : (∏ c : ↥(treeChildren T), ∑ γ_c : P.Pol,
          if P.incomp γ₀ γ_c then
            kpWeight P γ_c * treeActivitySum P (treeComp T hT c.1) c.1 (treeSub T hT c.1) γ_c
          else 0) =
        ∏ c : ↥(treeChildren T), ∑ γ_sub : ↥(treeComp T hT c.1) → P.Pol,
          if branchValid P (treeComp T hT c.1) c.1 (hmem_self c.1 c.2) (treeSub T hT c.1) γ₀ γ_sub then
            kpWeight P (γ_sub ⟨c.1, hmem_self c.1 c.2⟩) *
              ∏ v ∈ (treeComp T hT c.1).attach.filter (fun v => v.1 ≠ c.1),
                kpWeight P (γ_sub v)
          else 0 :=
      Finset.prod_congr rfl (fun c _ =>
        treeActivitySum_branch_factor P (treeComp T hT c.1) c.1 (hmem_self c.1 c.2)
          (treeSub T hT c.1) γ₀)
    rw [hprod_eq, Fintype.prod_sum]
  rw [hprod_sum]
  unfold treeActivitySum
  have hfilt_lhs : (∑ γ : ↥(Finset.univ : Finset (Fin (m + 2))) → P.Pol,
      if treeValid P Finset.univ 0 T γ₀ γ then
        ∏ v ∈ (Finset.univ : Finset (Fin (m + 2))).attach.filter (fun v => v.1 ≠ 0),
          kpWeight P (γ v)
      else 0) =
      ∑ γ ∈ Finset.univ.filter (fun γ : ↥(Finset.univ : Finset (Fin (m + 2))) → P.Pol =>
          γ ⟨0, Finset.mem_univ 0⟩ = γ₀),
        if ∀ e ∈ T, ∃ u hu v hv, e = s(u, v) ∧ P.incomp (γ ⟨u, hu⟩) (γ ⟨v, hv⟩) then
          ∏ v ∈ (Finset.univ : Finset (Fin (m + 2))).attach.filter (fun v => v.1 ≠ 0),
            kpWeight P (γ v)
        else 0 := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    by_cases h0 : γ ⟨0, Finset.mem_univ 0⟩ = γ₀
    · rw [if_pos h0]
      by_cases hed : ∀ e ∈ T, ∃ u hu v hv, e = s(u, v) ∧ P.incomp (γ ⟨u, hu⟩) (γ ⟨v, hv⟩)
      · rw [if_pos (by unfold treeValid; exact ⟨fun _ => h0, hed⟩), if_pos hed]
      · rw [if_neg (fun h => hed h.2), if_neg hed]
    · rw [if_neg h0, if_neg (fun h => h0 (h.1 (Finset.mem_univ 0)))]
  trans (∑ γ ∈ Finset.univ.filter (fun γ : ↥(Finset.univ : Finset (Fin (m + 2))) → P.Pol =>
          γ ⟨0, Finset.mem_univ 0⟩ = γ₀),
        if ∀ e ∈ T, ∃ u hu v hv, e = s(u, v) ∧ P.incomp (γ ⟨u, hu⟩) (γ ⟨v, hv⟩) then
          ∏ v ∈ (Finset.univ : Finset (Fin (m + 2))).attach.filter (fun v => v.1 ≠ 0),
            kpWeight P (γ v)
        else 0)
  · exact hfilt_lhs
  let toProd : (↥(Finset.univ : Finset (Fin (m + 2))) → P.Pol) →
      (Π c : ↥(treeChildren T), ↥(treeComp T hT c.1) → P.Pol) :=
    fun γ c x => γ ⟨x.1, Finset.mem_univ _⟩
  let fromProd : (Π c : ↥(treeChildren T), ↥(treeComp T hT c.1) → P.Pol) →
      (↥(Finset.univ : Finset (Fin (m + 2))) → P.Pol) :=
    fun Γ x => if hx : x.1 = 0 then γ₀ else
      let c : Fin (m + 2) := rootChild T hT x.1
      have hc : c ∈ treeChildren T := rootChild_mem_children T hT hx
      have hxc : x.1 ∈ treeComp T hT c :=
        Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hx, Finset.mem_univ _⟩, rfl⟩
      Γ ⟨c, hc⟩ ⟨x.1, hxc⟩
  refine Finset.sum_bij (fun γ _ => toProd γ) (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
  · intro γ1 hγ1 γ2 hγ2 heq
    have h1_0 : γ1 ⟨0, Finset.mem_univ 0⟩ = γ₀ := (Finset.mem_filter.mp hγ1).2
    have h2_0 : γ2 ⟨0, Finset.mem_univ 0⟩ = γ₀ := (Finset.mem_filter.mp hγ2).2
    funext ⟨x, _⟩
    by_cases hx0 : x = 0
    · subst hx0; exact h1_0.trans h2_0.symm
    · have hc : rootChild T hT x ∈ treeChildren T := rootChild_mem_children T hT hx0
      have hxc : x ∈ treeComp T hT (rootChild T hT x) :=
        Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hx0, Finset.mem_univ _⟩, rfl⟩
      exact congrFun (congrFun heq ⟨rootChild T hT x, hc⟩) ⟨x, hxc⟩
  · intro Γ _
    refine ⟨fromProd Γ, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, ?_⟩
    · simp [fromProd]
    · funext ⟨c, hc⟩ ⟨x, hx⟩
      have hx_ne : x ≠ 0 := Finset.ne_of_mem_erase (Finset.mem_filter.mp hx).1
      have hrc : rootChild T hT x = c := (Finset.mem_filter.mp hx).2
      dsimp [toProd, fromProd]
      rw [dif_neg hx_ne]
      have hsub : ∀ c' (hc' : c' ∈ treeChildren T) (hx' : x ∈ treeComp T hT c'),
          c' = c → Γ ⟨c', hc'⟩ ⟨x, hx'⟩ = Γ ⟨c, hc⟩ ⟨x, hx⟩ := by
        rintro c' hc' hx' rfl
        rfl
      exact hsub _ _ _ hrc
  · intro γ hγ
    have hγ0 : γ ⟨0, Finset.mem_univ 0⟩ = γ₀ := (Finset.mem_filter.mp hγ).2
    have hcond :
        (∀ e ∈ T, ∃ u hu v hv, e = s(u, v) ∧ P.incomp (γ ⟨u, hu⟩) (γ ⟨v, hv⟩)) ↔
        ∀ c : ↥(treeChildren T),
          branchValid P (treeComp T hT c.1) c.1 (hmem_self c.1 c.2) (treeSub T hT c.1) γ₀
            (toProd γ c) := by
      unfold branchValid
      constructor
      · intro hedges ⟨c, hc⟩
        refine ⟨?_, fun e he => ?_⟩
        · have he_in : s(0, c) ∈ T := (Finset.mem_filter.mp hc).2.2
          obtain ⟨u, _, v, _, huv, hin⟩ := hedges s(0, c) he_in
          rw [Sym2.eq_iff] at huv
          dsimp [toProd]
          rcases huv with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
          · rwa [hγ0] at hin
          · rw [hγ0] at hin; exact P.incomp_symm _ _ hin
        · have he_in : e ∈ T := (Finset.mem_filter.mp he).1
          obtain ⟨u, _, v, _, rfl, hin⟩ := hedges e he_in
          have hu_comp := (Finset.mem_filter.mp he).2 u (by simp)
          have hv_comp := (Finset.mem_filter.mp he).2 v (by simp)
          exact ⟨u, hu_comp, v, hv_comp, rfl, hin⟩
      · intro hbranches e he
        rw [hcov, Finset.mem_union, Finset.mem_image, Finset.mem_biUnion] at he
        rcases he with ⟨c, hc, rfl⟩ | ⟨c, hc, he_sub⟩
        · have hb := (hbranches ⟨c, hc⟩).1
          refine ⟨0, Finset.mem_univ _, c, Finset.mem_univ _, rfl, ?_⟩
          simpa [toProd, hγ0] using hb
        · obtain ⟨u, _, v, _, rfl, hin⟩ := (hbranches ⟨c, hc⟩).2 e he_sub
          exact ⟨u, Finset.mem_univ _, v, Finset.mem_univ _, rfl, hin⟩
    by_cases hL : ∀ e ∈ T, ∃ u hu v hv, e = s(u, v) ∧ P.incomp (γ ⟨u, hu⟩) (γ ⟨v, hv⟩)
    · have hR := hcond.mp hL
      rw [if_pos hL]
      have hprod_pos : (∏ c : ↥(treeChildren T),
          if branchValid P (treeComp T hT c.1) c.1 (hmem_self c.1 c.2) (treeSub T hT c.1) γ₀
              (toProd γ c) then
            kpWeight P (toProd γ c ⟨c.1, hmem_self c.1 c.2⟩) *
              ∏ v ∈ (treeComp T hT c.1).attach.filter (fun v => v.1 ≠ c.1),
                kpWeight P (toProd γ c v)
          else 0) =
          ∏ c : ↥(treeChildren T),
            kpWeight P (γ ⟨c.1, Finset.mem_univ _⟩) *
              ∏ v ∈ (treeComp T hT c.1).attach.filter (fun v => v.1 ≠ c.1),
                kpWeight P (γ ⟨v.1, Finset.mem_univ _⟩) := by
        refine Finset.prod_congr rfl (fun c _ => ?_)
        rw [if_pos (hR c)]
      rw [hprod_pos]
      have hprod_collapse : ∀ c ∈ treeChildren T,
          kpWeight P (γ ⟨c, Finset.mem_univ _⟩) *
            ∏ v ∈ (treeComp T hT c).attach.filter (fun v => v.1 ≠ c),
              kpWeight P (γ ⟨v.1, Finset.mem_univ _⟩) =
          ∏ v ∈ treeComp T hT c, kpWeight P (γ ⟨v, Finset.mem_univ _⟩) := by
        intro c hc
        have h1 : (∏ v ∈ (treeComp T hT c).attach.filter (fun v => v.1 ≠ c),
              kpWeight P (γ ⟨v.1, Finset.mem_univ _⟩)) =
            ∏ v ∈ (treeComp T hT c).erase c, kpWeight P (γ ⟨v, Finset.mem_univ _⟩) := by
          refine Finset.prod_bij (fun v _ => v.1) ?_ ?_ ?_ (fun _ _ => rfl)
          · intro v hv
            rw [Finset.mem_filter] at hv
            exact Finset.mem_erase.mpr ⟨hv.2, v.2⟩
          · intro v1 _ v2 _ h; exact Subtype.ext h
          · intro v hv
            rw [Finset.mem_erase] at hv
            exact ⟨⟨v, hv.2⟩, Finset.mem_filter.mpr ⟨Finset.mem_attach _ _, hv.1⟩, rfl⟩
        rw [h1]
        exact Finset.mul_prod_erase (treeComp T hT c)
          (fun v => kpWeight P (γ ⟨v, Finset.mem_univ _⟩)) (hmem_self c hc)
      calc (∏ v ∈ (Finset.univ : Finset (Fin (m + 2))).attach.filter (fun v => v.1 ≠ 0),
              kpWeight P (γ v))
          = ∏ v ∈ Finset.univ.erase (0 : Fin (m + 2)), kpWeight P (γ ⟨v, Finset.mem_univ _⟩) := by
            refine Finset.prod_bij (fun v _ => v.1) ?_ ?_ ?_ (fun _ _ => rfl)
            · intro v hv; rw [Finset.mem_filter] at hv; exact Finset.mem_erase.mpr ⟨hv.2, v.2⟩
            · intro v1 _ v2 _ h; exact Subtype.ext h
            · intro v hv; rw [Finset.mem_erase] at hv
              exact ⟨⟨v, hv.2⟩, Finset.mem_filter.mpr ⟨Finset.mem_attach _ _, hv.1⟩, rfl⟩
        _ = ∏ v ∈ (treeChildren T).biUnion (treeComp T hT), kpWeight P (γ ⟨v, Finset.mem_univ _⟩) := by
            rw [hpart]
        _ = ∏ c ∈ treeChildren T, ∏ v ∈ treeComp T hT c, kpWeight P (γ ⟨v, Finset.mem_univ _⟩) :=
            Finset.prod_biUnion hdisj
        _ = ∏ c ∈ treeChildren T,
              (kpWeight P (γ ⟨c, Finset.mem_univ _⟩) *
                ∏ v ∈ (treeComp T hT c).attach.filter (fun v => v.1 ≠ c),
                  kpWeight P (γ ⟨v.1, Finset.mem_univ _⟩)) := by
            refine Finset.prod_congr rfl (fun c hc => (hprod_collapse c hc).symm)
        _ = ∏ c : ↥(treeChildren T),
              (kpWeight P (γ ⟨c.1, Finset.mem_univ _⟩) *
                ∏ v ∈ (treeComp T hT c.1).attach.filter (fun v => v.1 ≠ c.1),
                  kpWeight P (γ ⟨v.1, Finset.mem_univ _⟩)) := by
            rw [← Finset.prod_coe_sort (treeChildren T)]
    · rw [if_neg hL]
      have hR := mt hcond.mpr hL
      rw [not_forall] at hR
      obtain ⟨c0, hc0⟩ := hR
      symm
      exact Finset.prod_eq_zero (Finset.mem_univ c0) (if_neg hc0)

/-- Finset of ordered partitions of `U` into `k` disjoint blocks of prescribed sizes `μ`. `[B]` -/
noncomputable def orderedParts {α : Type*} [DecidableEq α] (U : Finset α) (k : ℕ)
    (μ : Fin k → ℕ) : Finset (Fin k → Finset α) :=
  (Fintype.piFinset (fun _ : Fin k => U.powerset)).filter
    (fun f => (∀ i, (f i).card = μ i) ∧ (∀ i j, i ≠ j → Disjoint (f i) (f j)) ∧
      Finset.univ.biUnion f = U)

lemma orderedPart_factorial_sum {α : Type*} [DecidableEq α]
    (U : Finset α) (k : ℕ) (μ : Fin k → ℕ) (hsum : ∑ i : Fin k, μ i = U.card) :
    ∑ _f ∈ orderedParts U k μ, (∏ i : Fin k, ((μ i).factorial : ℝ)) = (U.card.factorial : ℝ) := by
  let I := Σ i : Fin k, Fin (μ i)
  have hf_prop : ∀ f : ↥(orderedParts U k μ),
      (∀ i, (f.1 i).card = μ i) ∧ (∀ i j, i ≠ j → Disjoint (f.1 i) (f.1 j)) ∧
        Finset.univ.biUnion f.1 = U := fun f => (Finset.mem_filter.mp f.2).2
  let fwd : (Σ f : ↥(orderedParts U k μ), (Π i : Fin k, Fin (μ i) ≃ ↥(f.1 i))) → (I ≃ ↥U) :=
    fun ⟨f, π⟩ =>
      { toFun := fun ⟨i, t⟩ =>
          have hmem : (π i t).1 ∈ U :=
            (le_of_eq (hf_prop f).2.2)
              (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, (π i t).2⟩)
          ⟨(π i t).1, hmem⟩
        invFun := fun u =>
          have hu : u.1 ∈ Finset.univ.biUnion f.1 :=
            (le_of_eq (hf_prop f).2.2.symm) u.2
          let i := Classical.choose (Finset.mem_biUnion.mp hu)
          have hi : u.1 ∈ f.1 i := (Classical.choose_spec (Finset.mem_biUnion.mp hu)).2
          ⟨i, (π i).symm ⟨u.1, hi⟩⟩
        left_inv := fun ⟨i, t⟩ => by
          dsimp only
          have hstep : ∀ j (hj : (π i t).1 ∈ f.1 j),
              (⟨j, (π j).symm ⟨(π i t).1, hj⟩⟩ : I) = ⟨i, t⟩ := by
            intro j hj
            have hij : j = i := by
              by_contra hne
              exact Finset.disjoint_left.mp ((hf_prop f).2.1 j i hne) hj (π i t).2
            subst hij
            simp [(π j).symm_apply_apply t]
          exact hstep _ _
        right_inv := fun u => by
          dsimp only
          have hu : u.1 ∈ Finset.univ.biUnion f.1 :=
            (le_of_eq (hf_prop f).2.2.symm) u.2
          let i := Classical.choose (Finset.mem_biUnion.mp hu)
          have hi : u.1 ∈ f.1 i := (Classical.choose_spec (Finset.mem_biUnion.mp hu)).2
          apply Subtype.ext
          exact congrArg (fun x : ↥(f.1 i) => x.1) ((π i).apply_symm_apply ⟨u.1, hi⟩) }
  let bwd_f : (I ≃ ↥U) → ↥(orderedParts U k μ) := fun σ =>
    let f_fun : Fin k → Finset α := fun i => Finset.univ.image (fun t : Fin (μ i) => (σ ⟨i, t⟩).1)
    have hf_card : ∀ i, (f_fun i).card = μ i := by
      intro i
      rw [Finset.card_image_of_injective, Finset.card_univ, Fintype.card_fin]
      intro t1 t2 heq
      have h1 : σ ⟨i, t1⟩ = σ ⟨i, t2⟩ := Subtype.ext heq
      have h2 := σ.injective h1
      exact eq_of_heq (Sigma.ext_iff.mp h2).2
    have hf_disj : ∀ i j, i ≠ j → Disjoint (f_fun i) (f_fun j) := by
      intro i j hne
      rw [Finset.disjoint_left]
      intro x hx1 hx2
      rw [Finset.mem_image] at hx1 hx2
      obtain ⟨t1, _, rfl⟩ := hx1
      obtain ⟨t2, _, heq⟩ := hx2
      have h1 : σ ⟨i, t1⟩ = σ ⟨j, t2⟩ := Subtype.ext heq.symm
      have h2 := congrArg Sigma.fst (σ.injective h1)
      exact hne h2
    have hf_union : Finset.univ.biUnion f_fun = U := by
      ext x
      simp only [Finset.mem_biUnion, Finset.mem_univ, Finset.mem_image, true_and, f_fun]
      constructor
      · rintro ⟨i, t, rfl⟩; exact (σ ⟨i, t⟩).2
      · intro hx
        obtain ⟨⟨i, t⟩, hit⟩ := σ.surjective ⟨x, hx⟩
        exact ⟨i, t, congrArg Subtype.val hit⟩
    have hf_mem : f_fun ∈ orderedParts U k μ := by
      rw [orderedParts, Finset.mem_filter, Fintype.mem_piFinset]
      refine ⟨fun i => Finset.mem_powerset.mpr ?_, hf_card, hf_disj, hf_union⟩
      intro x hx
      rw [Finset.mem_image] at hx
      obtain ⟨t, _, rfl⟩ := hx
      exact (σ ⟨i, t⟩).2
    ⟨f_fun, hf_mem⟩
  let bwd_pi : (σ : I ≃ ↥U) → Π i : Fin k, Fin (μ i) ≃ ↥((bwd_f σ).1 i) := fun σ i =>
    Equiv.ofBijective
      (fun t => ⟨(σ ⟨i, t⟩).1, Finset.mem_image_of_mem _ (Finset.mem_univ t)⟩)
      ⟨fun t1 t2 heq => by
        have hval : (σ ⟨i, t1⟩).1 = (σ ⟨i, t2⟩).1 :=
          congrArg (fun x : ↥((bwd_f σ).1 i) => x.1) heq
        have h1 : σ ⟨i, t1⟩ = σ ⟨i, t2⟩ := Subtype.ext hval
        exact eq_of_heq (Sigma.ext_iff.mp (σ.injective h1)).2,
       fun ⟨y, hy⟩ => by
        change y ∈ Finset.univ.image (fun t : Fin (μ i) => (σ ⟨i, t⟩).1) at hy
        rw [Finset.mem_image] at hy
        obtain ⟨t, _, rfl⟩ := hy
        exact ⟨t, rfl⟩⟩
  let eqv : (Σ f : ↥(orderedParts U k μ), (Π i : Fin k, Fin (μ i) ≃ ↥(f.1 i))) ≃ (I ≃ ↥U) :=
    { toFun := fwd
      invFun := fun σ => ⟨bwd_f σ, bwd_pi σ⟩
      left_inv := fun ⟨f, π⟩ => by
        have hf_eq : (bwd_f (fwd ⟨f, π⟩)).1 = f.1 := by
          funext i
          ext y
          change y ∈ Finset.univ.image (fun t : Fin (μ i) => (π i t).1) ↔ y ∈ f.1 i
          simp only [Finset.mem_image, Finset.mem_univ, true_and]
          constructor
          · rintro ⟨t, rfl⟩; exact (π i t).2
          · intro hy
            obtain ⟨t, ht⟩ := (π i).surjective ⟨y, hy⟩
            exact ⟨t, congrArg Subtype.val ht⟩
        have hf_sub : bwd_f (fwd ⟨f, π⟩) = f := Subtype.ext hf_eq
        refine Sigma.ext hf_sub ?_
        have hheq : ∀ (f' : ↥(orderedParts U k μ)) (_ : f' = f)
            (π' : Π i : Fin k, Fin (μ i) ≃ ↥(f'.1 i)),
            (∀ i t, (π' i t).1 = (π i t).1) → HEq π' π := by
          rintro f' rfl π' hval
          have hpi : π' = π := by
            funext i
            ext t
            exact hval i t
          subst hpi
          exact HEq.rfl
        apply hheq (bwd_f (fwd ⟨f, π⟩)) hf_sub (bwd_pi (fwd ⟨f, π⟩))
        intro i t
        rfl
      right_inv := fun σ => by
        ext ⟨i, t⟩
        rfl }
  have hcard_I : Fintype.card I = Fintype.card ↥U := by
    simp [I, Fintype.card_sigma, hsum]
  have hcard_eq : Fintype.card (Σ f : ↥(orderedParts U k μ), (Π i : Fin k, Fin (μ i) ≃ ↥(f.1 i))) =
      U.card.factorial := by
    rw [Fintype.card_congr eqv]
    let eI : I ≃ ↥U := Fintype.equivOfCardEq hcard_I
    have hperm : (I ≃ ↥U) ≃ Equiv.Perm ↥U :=
      { toFun := fun g => eI.symm.trans g
        invFun := fun p => eI.trans p
        left_inv := fun g => by ext x; simp
        right_inv := fun p => by ext x; simp }
    rw [Fintype.card_congr hperm, Fintype.card_perm, Fintype.card_coe]
  have hcard_lhs : Fintype.card (Σ f : ↥(orderedParts U k μ), (Π i : Fin k, Fin (μ i) ≃ ↥(f.1 i))) =
      ∑ f : ↥(orderedParts U k μ), ∏ i : Fin k, (μ i).factorial := by
    rw [Fintype.card_sigma]
    refine Finset.sum_congr rfl (fun f _ => ?_)
    rw [Fintype.card_pi]
    refine Finset.prod_congr rfl (fun i _ => ?_)
    have hfi : Fintype.card (Fin (μ i)) = Fintype.card ↥(f.1 i) := by
      simp [(hf_prop f).1 i]
    let ei : Fin (μ i) ≃ ↥(f.1 i) := Fintype.equivOfCardEq hfi
    have hp : (Fin (μ i) ≃ ↥(f.1 i)) ≃ Equiv.Perm (Fin (μ i)) :=
      { toFun := fun g => g.trans ei.symm
        invFun := fun p => p.trans ei
        left_inv := fun g => by ext x; simp
        right_inv := fun p => by ext x; simp }
    rw [Fintype.card_congr hp, Fintype.card_perm, Fintype.card_fin]
  have hsum_eq : (∑ _f ∈ orderedParts U k μ, (∏ i : Fin k, ((μ i).factorial : ℝ))) =
      ∑ _f : ↥(orderedParts U k μ), (∏ i : Fin k, ((μ i).factorial : ℝ)) := by
    rw [← Finset.sum_coe_sort (orderedParts U k μ)]
  rw [hsum_eq]
  have hreal := congrArg (Nat.cast (R := ℝ)) hcard_lhs.symm |>.trans (congrArg (Nat.cast (R := ℝ)) hcard_eq)
  push_cast at hreal
  exact hreal

/-- Valid ordered compositions of `s` into `k` positive parts `(μ_i + 1)`. `[B]` -/
noncomputable def validComps (k s : ℕ) : Finset (Fin k → ℕ) :=
  (Fintype.piFinset (fun _ : Fin k => Finset.range s)).filter
    (fun μ => ∑ i : Fin k, (μ i + 1) = s)

/-- Branch sum attached to a child `c` in a rooted spanning tree. `[B]` -/
noncomputable def branchSum (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (c : α) (T_sub : Finset (Sym2 α)) (γ₀ : P.Pol) : ℝ :=
  ∑ γ_c : P.Pol,
    if P.incomp γ₀ γ_c then kpWeight P γ_c * treeActivitySum P V c T_sub γ_c else 0

lemma branchSum_nonneg (P : KPPolymerSystem) {α : Type*} [DecidableEq α]
    (V : Finset α) (c : α) (T_sub : Finset (Sym2 α)) (γ₀ : P.Pol) :
    0 ≤ branchSum P V c T_sub γ₀ := by
  unfold branchSum
  refine Finset.sum_nonneg (fun γ_c _ => ?_)
  split_ifs
  · exact mul_nonneg (kpWeight_nonneg P _) (treeActivitySum_nonneg P _ _ _ _)
  · exact le_rfl

lemma kpTreeTerm_succ_le (P : KPPolymerSystem) (m : ℕ) (γ₀ : P.Pol) :
    kpTreeTerm P (m + 1) γ₀ ≤
      ∑ k ∈ Finset.Icc 1 (m + 1),
        (1 / (k.factorial : ℝ)) *
          ∑ μ ∈ validComps k (m + 1),
            ∏ i : Fin k, ∑ γ_1 : P.Pol,
              if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1 else 0 := by
  let U : Finset (Fin (m + 2)) := Finset.univ.erase 0
  have hU_card : U.card = m + 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ 0), Finset.card_univ, Fintype.card_fin]
    omega
  let S_trees : Finset (Finset (Sym2 (Fin (m + 2)))) :=
    (completeEdges Finset.univ).powerset.filter (IsSpanningTree Finset.univ (0 : Fin (m + 2)))
  let Dom := Σ T : ↥S_trees, (Fin (treeChildren T.1).card ≃ ↥(treeChildren T.1))
  let Codom := Σ (k : ↥(Finset.Icc 1 (m + 1)))
    (μ : ↥(validComps k.1 (m + 1)))
    (f : ↥(orderedParts U k.1 (fun i => μ.1 i + 1)))
    (c : Π i : Fin k.1, ↥(f.1 i)),
    Π i : Fin k.1, ↥((completeEdges (f.1 i)).powerset.filter (IsSpanningTree (f.1 i) (c i).1))
  let hT_sp : ∀ T : ↥S_trees, IsSpanningTree Finset.univ (0 : Fin (m + 2)) T.1 :=
    fun T => (Finset.mem_filter.mp T.2).2
  let k_of : ↥S_trees → ↥(Finset.Icc 1 (m + 1)) := fun T =>
    have hpos : 1 ≤ (treeChildren T.1).card :=
      Finset.card_pos.mpr (treeChildren_nonempty T.1 (hT_sp T))
    have hle : (treeChildren T.1).card ≤ m + 1 := by
      have hsub : treeChildren T.1 ⊆ U := Finset.filter_subset _ _
      exact (Finset.card_le_card hsub).trans_eq hU_card
    ⟨(treeChildren T.1).card, Finset.mem_Icc.mpr ⟨hpos, hle⟩⟩
  let ι : Dom → Codom := fun ⟨T, σ⟩ =>
    let k := k_of T
    let hT := hT_sp T
    let c_of : Fin k.1 → Fin (m + 2) := fun i => (σ i).1
    have hcomp_pos : ∀ i : Fin k.1, 1 ≤ (treeComp T.1 hT (c_of i)).card := fun i =>
      Finset.card_pos.mpr ⟨c_of i, treeComp_mem_self T.1 hT (σ i).2⟩
    let μ_fun : Fin k.1 → ℕ := fun i => (treeComp T.1 hT (c_of i)).card - 1
    have hμ_sum : ∑ i : Fin k.1, (μ_fun i + 1) = m + 1 := by
      have heq_sum : (∑ i : Fin k.1, (μ_fun i + 1)) =
          ∑ c ∈ treeChildren T.1, (treeComp T.1 hT c).card := by
        calc (∑ i : Fin k.1, (μ_fun i + 1))
            = ∑ i : Fin k.1, (treeComp T.1 hT (σ i).1).card := by
              refine Finset.sum_congr rfl (fun i _ => Nat.sub_add_cancel (hcomp_pos i))
          _ = ∑ c : ↥(treeChildren T.1), (treeComp T.1 hT c.1).card :=
              Fintype.sum_equiv σ _ _ (fun _ => rfl)
          _ = ∑ c ∈ treeChildren T.1, (treeComp T.1 hT c).card := by
              rw [← Finset.sum_coe_sort (treeChildren T.1)]
      rw [heq_sum, ← Finset.card_biUnion (treeComp_disjoint T.1 hT),
        treeComp_biUnion T.1 hT, hU_card]
    have hμ_mem : μ_fun ∈ validComps k.1 (m + 1) := by
      rw [validComps, Finset.mem_filter, Fintype.mem_piFinset]
      refine ⟨fun i => Finset.mem_range.mpr ?_, hμ_sum⟩
      have hi_le : μ_fun i + 1 ≤ ∑ j : Fin k.1, (μ_fun j + 1) :=
        Finset.single_le_sum (fun j _ => Nat.zero_le (μ_fun j + 1)) (Finset.mem_univ i)
      omega
    let f_fun : Fin k.1 → Finset (Fin (m + 2)) := fun i => treeComp T.1 hT (c_of i)
    have hf_mem : f_fun ∈ orderedParts U k.1 (fun i => μ_fun i + 1) := by
      rw [orderedParts, Finset.mem_filter, Fintype.mem_piFinset]
      refine ⟨fun i => Finset.mem_powerset.mpr (Finset.filter_subset _ _),
        fun i => (Nat.sub_add_cancel (hcomp_pos i)).symm, ?_, ?_⟩
      · intro i j hij
        apply treeComp_disjoint T.1 hT (σ i).2 (σ j).2
        intro h
        exact hij (σ.injective (Subtype.ext h))
      · ext v
        simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, f_fun]
        constructor
        · rintro ⟨i, hv⟩
          exact Finset.filter_subset _ _ hv
        · intro hv
          have hv' : v ∈ (treeChildren T.1).biUnion (treeComp T.1 hT) := by
            rwa [treeComp_biUnion T.1 hT]
          rw [Finset.mem_biUnion] at hv'
          obtain ⟨c, hc, hvc⟩ := hv'
          exact ⟨σ.symm ⟨c, hc⟩, by simpa [c_of] using hvc⟩
    let c_sub : Π i : Fin k.1, ↥(f_fun i) := fun i =>
      ⟨c_of i, treeComp_mem_self T.1 hT (σ i).2⟩
    let Ts_sub : Π i : Fin k.1,
        ↥((completeEdges (f_fun i)).powerset.filter (IsSpanningTree (f_fun i) (c_sub i).1)) :=
      fun i =>
        have hsub_sp := treeSub_isSpanningTree T.1 hT (c_of i) (σ i).2
        ⟨treeSub T.1 hT (c_of i), Finset.mem_filter.mpr
          ⟨Finset.mem_powerset.mpr hsub_sp.1.1, hsub_sp⟩⟩
    ⟨k, ⟨μ_fun, hμ_mem⟩, ⟨f_fun, hf_mem⟩, c_sub, Ts_sub⟩
  let reconstruct : Codom → Finset (Sym2 (Fin (m + 2))) := fun x =>
    (Finset.univ.image (fun i : Fin x.1.1 => s((0 : Fin (m + 2)), (x.2.2.2.1 i).1))) ∪
      Finset.univ.biUnion (fun i : Fin x.1.1 => (x.2.2.2.2 i).1)
  have hreconstruct : ∀ d : Dom, reconstruct (ι d) = d.1.1 := by
    intro ⟨T, σ⟩
    have hcov := tree_eq_biUnion_treeSub T.1 (hT_sp T)
    rw [hcov]
    ext e
    simp only [reconstruct, ι, Finset.mem_union, Finset.mem_image, Finset.mem_biUnion,
      Finset.mem_univ, true_and]
    constructor
    · rintro (⟨i, rfl⟩ | ⟨i, he⟩)
      · exact Or.inl ⟨(σ i).1, (σ i).2, rfl⟩
      · exact Or.inr ⟨(σ i).1, (σ i).2, he⟩
    · rintro (⟨c, hc, rfl⟩ | ⟨c, hc, he⟩)
      · exact Or.inl ⟨σ.symm ⟨c, hc⟩, by simp⟩
      · exact Or.inr ⟨σ.symm ⟨c, hc⟩, by simpa using he⟩
  let projC : Codom → Σ k : ℕ, (Fin k → Fin (m + 2)) :=
    fun x => ⟨x.1.1, fun i => (x.2.2.2.1 i).1⟩
  have hι_inj : Function.Injective ι := by
    intro ⟨T1, σ1⟩ ⟨T2, σ2⟩ heq
    have hT_eq : T1.1 = T2.1 :=
      (hreconstruct ⟨T1, σ1⟩).symm.trans ((congrArg reconstruct heq).trans (hreconstruct ⟨T2, σ2⟩))
    have hT_sub : T1 = T2 := Subtype.ext hT_eq
    subst hT_sub
    have hpc := congrArg projC heq
    have hfun : (fun i : Fin (treeChildren T1.1).card => (σ1 i).1) =
        (fun i : Fin (treeChildren T1.1).card => (σ2 i).1) :=
      eq_of_heq (Sigma.ext_iff.mp hpc).2
    have hσ : σ1 = σ2 :=
      Equiv.ext (fun i => Subtype.ext (congrFun hfun i))
    subst hσ
    rfl
  let wt : Codom → ℝ := fun x =>
    (1 / ((x.1.1.factorial : ℝ))) * ∏ i : Fin x.1.1, branchSum P (x.2.2.1.1 i) (x.2.2.2.1 i).1 (x.2.2.2.2 i).1 γ₀
  have hwt_nonneg : ∀ x : Codom, 0 ≤ wt x := fun x =>
    mul_nonneg (by positivity) (Finset.prod_nonneg (fun i _ => branchSum_nonneg P _ _ _ _))
  have hlhs_eq : treeTotalSum P Finset.univ (0 : Fin (m + 2)) γ₀ = ∑ d : Dom, wt (ι d) := by
    unfold treeTotalSum
    change (∑ T ∈ S_trees, treeActivitySum P Finset.univ 0 T γ₀) = _
    rw [← Finset.sum_coe_sort S_trees, Fintype.sum_sigma]
    refine Finset.sum_congr rfl (fun T _ => ?_)
    have hdecomp := treeActivitySum_decomp P T.1 (hT_sp T) γ₀
    have hcard_σ : Fintype.card (Fin (treeChildren T.1).card ≃ ↥(treeChildren T.1)) =
        (treeChildren T.1).card.factorial := by
      let e0 : Fin (treeChildren T.1).card ≃ ↥(treeChildren T.1) :=
        Fintype.equivOfCardEq (by simp)
      have hp : (Fin (treeChildren T.1).card ≃ ↥(treeChildren T.1)) ≃
          Equiv.Perm (Fin (treeChildren T.1).card) :=
        { toFun := fun σ => σ.trans e0.symm
          invFun := fun p => p.trans e0
          left_inv := fun σ => by ext x; simp
          right_inv := fun p => by ext x; simp }
      rw [Fintype.card_congr hp, Fintype.card_perm, Fintype.card_fin]
    have hfac_pos : ((treeChildren T.1).card.factorial : ℝ) ≠ 0 := by positivity
    have hstep : treeActivitySum P Finset.univ 0 T.1 γ₀ =
        ∑ σ : Fin (treeChildren T.1).card ≃ ↥(treeChildren T.1),
          (1 / ((treeChildren T.1).card.factorial : ℝ)) *
            treeActivitySum P Finset.univ 0 T.1 γ₀ := by
      rw [Finset.sum_const, Finset.card_univ, hcard_σ, nsmul_eq_mul, ← mul_assoc,
        mul_one_div_cancel hfac_pos, one_mul]
    rw [hstep]
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    dsimp [wt, ι]
    congr 1
    rw [hdecomp]
    calc (∏ c ∈ treeChildren T.1, branchSum P (treeComp T.1 (hT_sp T) c) c (treeSub T.1 (hT_sp T) c) γ₀)
        = ∏ c : ↥(treeChildren T.1), branchSum P (treeComp T.1 (hT_sp T) c.1) c.1 (treeSub T.1 (hT_sp T) c.1) γ₀ := by
          rw [← Finset.prod_coe_sort (treeChildren T.1)]
      _ = ∏ i : Fin (treeChildren T.1).card,
            branchSum P (treeComp T.1 (hT_sp T) (σ i).1) (σ i).1 (treeSub T.1 (hT_sp T) (σ i).1) γ₀ :=
          (Fintype.prod_equiv σ _ _ (fun _ => rfl)).symm
  have hsum_le : ∑ d : Dom, wt (ι d) ≤ ∑ x : Codom, wt x := by
    calc ∑ d : Dom, wt (ι d)
        = ∑ x ∈ Finset.univ.image ι, wt x :=
          (Finset.sum_image (fun d1 _ d2 _ h => hι_inj h)).symm
      _ ≤ ∑ x : Codom, wt x :=
          Finset.sum_le_univ_sum_of_nonneg hwt_nonneg
  have hrhs_eval : (1 / ((m + 1).factorial : ℝ)) * ∑ x : Codom, wt x =
      ∑ k ∈ Finset.Icc 1 (m + 1),
        (1 / (k.factorial : ℝ)) *
          ∑ μ ∈ validComps k (m + 1),
            ∏ i : Fin k, ∑ γ_1 : P.Pol,
              if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1 else 0 := by
    rw [Fintype.sum_sigma]
    simp_rw [Fintype.sum_sigma]
    rw [Finset.mul_sum, ← Finset.sum_coe_sort (Finset.Icc 1 (m + 1))]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    have hpull_k :
        (1 / ((m + 1).factorial : ℝ)) *
          ∑ μ : ↥(validComps k.1 (m + 1)), ∑ f : ↥(orderedParts U k.1 (fun i => μ.1 i + 1)),
            ∑ c : (Π i : Fin k.1, ↥(f.1 i)),
              ∑ Ts : (Π i : Fin k.1,
                ↥((completeEdges (f.1 i)).powerset.filter (IsSpanningTree (f.1 i) (c i).1))),
                (1 / (k.1.factorial : ℝ)) *
                  ∏ i : Fin k.1, branchSum P (f.1 i) (c i).1 (Ts i).1 γ₀ =
        (1 / (k.1.factorial : ℝ)) *
          ∑ μ ∈ validComps k.1 (m + 1),
            (1 / ((m + 1).factorial : ℝ)) *
              ∑ f ∈ orderedParts U k.1 (fun i => μ i + 1),
                ∑ c : (Π i : Fin k.1, ↥(f i)),
                  ∑ Ts : (Π i : Fin k.1,
                    ↥((completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1))),
                    ∏ i : Fin k.1, branchSum P (f i) (c i).1 (Ts i).1 γ₀ := by
      simp_rw [← Finset.mul_sum, ← Finset.sum_coe_sort (validComps k.1 (m + 1)),
        ← Finset.sum_coe_sort (orderedParts U k.1 _)]
      ring_nf
    rw [hpull_k]
    congr 1
    refine Finset.sum_congr rfl (fun μ hμ => ?_)
    have hμ_spec := (Finset.mem_filter.mp hμ).2
    have hinner : ∀ f ∈ orderedParts U k.1 (fun i => μ i + 1),
        ∑ c : (Π i : Fin k.1, ↥(f i)),
          ∑ Ts : (Π i : Fin k.1,
            ↥((completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1))),
            ∏ i : Fin k.1, branchSum P (f i) (c i).1 (Ts i).1 γ₀ =
        (∏ i : Fin k.1, (((μ i + 1).factorial : ℝ))) *
          ∏ i : Fin k.1, ∑ γ_1 : P.Pol,
            if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1 else 0 := by
      intro f hf
      have hf_card : ∀ i : Fin k.1, (f i).card = μ i + 1 := (Finset.mem_filter.mp hf).2.1
      have hconst_c : ∀ c : (Π i : Fin k.1, ↥(f i)),
          (∑ Ts : (Π i : Fin k.1,
            ↥((completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1))),
            ∏ i : Fin k.1, branchSum P (f i) (c i).1 (Ts i).1 γ₀) =
          (∏ i : Fin k.1, ((μ i).factorial : ℝ)) *
            ∏ i : Fin k.1, ∑ γ_1 : P.Pol,
              if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1 else 0 := by
        intro c
        rw [← Fintype.prod_sum (fun i (T_sub : ↥((completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1))) =>
          branchSum P (f i) (c i).1 T_sub.1 γ₀)]
        have hfac : ∀ i : Fin k.1,
            (∑ T_sub : ↥((completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1)),
              branchSum P (f i) (c i).1 T_sub.1 γ₀) =
            ((μ i).factorial : ℝ) *
              ∑ γ_1 : P.Pol, if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1 else 0 := by
          intro i
          have hsub_sum :
              (∑ T_sub : ↥((completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1)),
                branchSum P (f i) (c i).1 T_sub.1 γ₀) =
              ∑ T_sub ∈ (completeEdges (f i)).powerset.filter (IsSpanningTree (f i) (c i).1),
                branchSum P (f i) (c i).1 T_sub γ₀ := by
            refine Finset.sum_bij (fun T _ => T.1) (fun T _ => T.2)
              (fun _ _ _ _ h => Subtype.ext h)
              (fun T hT => ⟨⟨T, hT⟩, Finset.mem_univ _, rfl⟩) (fun _ _ => rfl)
          rw [hsub_sum]
          unfold branchSum
          rw [Finset.sum_comm]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun γ_1 _ => ?_)
          split_ifs with hin
          · rw [← Finset.mul_sum]
            change kpWeight P γ_1 * treeTotalSum P (f i) (c i).1 γ_1 =
              ((μ i).factorial : ℝ) * (kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1)
            rw [treeTotalSum_eq_fin P (f i) (c i).1 (c i).2 (hf_card i) γ_1]
            unfold kpTreeTerm
            have hnz : ((μ i).factorial : ℝ) ≠ 0 := by positivity
            field_simp [hnz]
          · simp
        exact (Finset.prod_congr rfl (fun i _ => hfac i)).trans Finset.prod_mul_distrib
      have hcard_c : Fintype.card (Π i : Fin k.1, ↥(f i)) = ∏ i : Fin k.1, (μ i + 1) := by
        rw [Fintype.card_pi]
        exact Finset.prod_congr rfl (fun i _ => by rw [Fintype.card_coe, hf_card i])
      rw [Finset.sum_congr rfl (fun c _ => hconst_c c), Finset.sum_const, Finset.card_univ,
        hcard_c, nsmul_eq_mul]
      push_cast
      rw [← mul_assoc, ← Finset.prod_mul_distrib]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [Nat.factorial_succ]
      push_cast
      ring
    rw [Finset.sum_congr rfl hinner, ← Finset.sum_mul, orderedPart_factorial_sum U k.1 (fun i => μ i + 1)
      (by rw [hμ_spec, hU_card]), hU_card]
    have hm1_nz : (((m + 1).factorial : ℝ)) ≠ 0 := by positivity
    rw [← mul_assoc, one_div_mul_cancel hm1_nz, one_mul]
  calc kpTreeTerm P (m + 1) γ₀
      = (1 / ((m + 1).factorial : ℝ)) * treeTotalSum P Finset.univ 0 γ₀ := rfl
    _ = (1 / ((m + 1).factorial : ℝ)) * ∑ d : Dom, wt (ι d) := by rw [hlhs_eq]
    _ ≤ (1 / ((m + 1).factorial : ℝ)) * ∑ x : Codom, wt x :=
        mul_le_mul_of_nonneg_left hsum_le (by positivity)
    _ = ∑ k ∈ Finset.Icc 1 (m + 1),
          (1 / (k.factorial : ℝ)) *
            ∑ μ ∈ validComps k (m + 1),
              ∏ i : Fin k, ∑ γ_1 : P.Pol,
                if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P (μ i) γ_1 else 0 :=
        hrhs_eval

/-- Inductive Kotecký–Preiss partial-sum exponential bound:
`∑_{m=0}^N kpTreeTerm P m γ₀ ≤ exp(a(γ₀))`. `[B]` -/
theorem kpPartialSum_le_exp (P : KPPolymerSystem) :
    ∀ (N : ℕ) (γ₀ : P.Pol), kpPartialSum P N γ₀ ≤ Real.exp (P.a γ₀) := by
  intro N
  induction N with
  | zero =>
    intro γ₀
    unfold kpPartialSum
    rw [Finset.sum_range_one, kpTreeTerm_zero]
    exact Real.one_le_exp (P.a_nonneg γ₀)
  | succ N ih =>
    intro γ₀
    let W : ℕ → ℝ := fun n =>
      ∑ γ_1 : P.Pol, if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpTreeTerm P n γ_1 else 0
    have hW_nonneg : ∀ n, 0 ≤ W n := fun n => by
      refine Finset.sum_nonneg (fun γ_1 _ => ?_)
      split_ifs
      · exact mul_nonneg (kpWeight_nonneg P _) (kpTreeTerm_nonneg P _ _)
      · exact le_rfl
    let A := Σ m : Fin (N + 1), Σ k : ↥(Finset.Icc 1 (m.1 + 1)), ↥(validComps k.1 (m.1 + 1))
    let B := Σ k' : Fin (N + 1), (Fin (k'.1 + 1) → Fin (N + 1))
    let mapAB : A → B := fun ⟨m, k, μ⟩ =>
      have hk_mem : k.1 ∈ Finset.Icc 1 (m.1 + 1) := k.2
      have hk_ge : 1 ≤ k.1 := (Finset.mem_Icc.mp hk_mem).1
      have hk_le : k.1 ≤ m.1 + 1 := (Finset.mem_Icc.mp hk_mem).2
      have hk_lt : k.1 - 1 < N + 1 := by omega
      let k' : Fin (N + 1) := ⟨k.1 - 1, hk_lt⟩
      have hμ_prop := Finset.mem_filter.mp μ.2
      let ν : Fin (k'.1 + 1) → Fin (N + 1) := fun i =>
        have hi_lt : i.1 < k.1 := by have h1 := i.2; dsimp [k'] at h1; omega
        let j : Fin k.1 := ⟨i.1, hi_lt⟩
        have hj_lt : μ.1 j < m.1 + 1 := Finset.mem_range.mp ((Fintype.mem_piFinset.mp hμ_prop.1) j)
        ⟨μ.1 j, by omega⟩
      ⟨k', ν⟩
    let weightB : B → ℝ := fun ⟨k', ν⟩ =>
      (1 / (((k'.1 + 1).factorial : ℝ))) * ∏ i : Fin (k'.1 + 1), W (ν i).1
    have hweightB_nonneg : ∀ b : B, 0 ≤ weightB b := fun ⟨k', ν⟩ =>
      mul_nonneg (by positivity) (Finset.prod_nonneg (fun _ _ => hW_nonneg _))
    let sumAB : B → ℕ := fun ⟨k', ν⟩ => ∑ i : Fin (k'.1 + 1), ((ν i).1 + 1)
    have hsumAB : ∀ a : A, sumAB (mapAB a) = a.1.1 + 1 := by
      rintro ⟨m, k, μ⟩
      have hk_ge : 1 ≤ k.1 := (Finset.mem_Icc.mp k.2).1
      have hμ_sum : ∑ j : Fin k.1, (μ.1 j + 1) = m.1 + 1 := (Finset.mem_filter.mp μ.2).2
      dsimp [sumAB, mapAB]
      let ek : Fin ((k.1 - 1) + 1) ≃ Fin k.1 := Fin.castOrderIso (by omega) |>.toEquiv
      exact (Fintype.sum_equiv ek _ (fun j => μ.1 j + 1) (fun _ => rfl)).trans hμ_sum
    have hmap_inj : Function.Injective mapAB := by
      rintro ⟨m1, k1, μ1⟩ ⟨m2, k2, μ2⟩ heq
      have hm_eq : m1.1 + 1 = m2.1 + 1 :=
        (hsumAB ⟨m1, k1, μ1⟩).symm.trans ((congrArg sumAB heq).trans (hsumAB ⟨m2, k2, μ2⟩))
      have hm : m1 = m2 := Fin.ext (by omega)
      subst hm
      have hk1_ge : 1 ≤ k1.1 := (Finset.mem_Icc.mp k1.2).1
      have hk2_ge : 1 ≤ k2.1 := (Finset.mem_Icc.mp k2.2).1
      have hk_fst := congrArg Sigma.fst heq
      have hk_val : k1.1 = k2.1 := by
        have hv := congrArg Fin.val hk_fst
        dsimp [mapAB] at hv
        omega
      have hk : k1 = k2 := Subtype.ext hk_val
      subst hk
      have hν := eq_of_heq (Sigma.ext_iff.mp heq).2
      have hμ_fun : μ1.1 = μ2.1 := by
        funext j
        have hj' : j.1 < (k1.1 - 1) + 1 := by omega
        have hj := congrArg Fin.val (congrFun hν ⟨j.1, hj'⟩)
        simpa [mapAB] using hj
      have hμ : μ1 = μ2 := Subtype.ext hμ_fun
      subst hμ
      rfl
    have hsum_terms : ∑ m : Fin (N + 1), kpTreeTerm P (m.1 + 1) γ₀ ≤ ∑ b : B, weightB b := by
      calc ∑ m : Fin (N + 1), kpTreeTerm P (m.1 + 1) γ₀
          ≤ ∑ m : Fin (N + 1), ∑ k ∈ Finset.Icc 1 (m.1 + 1),
              (1 / (k.factorial : ℝ)) * ∑ μ ∈ validComps k (m.1 + 1), ∏ i : Fin k, W (μ i) :=
            Finset.sum_le_sum (fun m _ => kpTreeTerm_succ_le P m.1 γ₀)
        _ = ∑ a : A, weightB (mapAB a) := by
            rw [Fintype.sum_sigma]
            refine Finset.sum_congr rfl (fun m _ => ?_)
            rw [Fintype.sum_sigma, ← Finset.sum_coe_sort (Finset.Icc 1 (m.1 + 1))]
            refine Finset.sum_congr rfl (fun k _ => ?_)
            rw [Finset.mul_sum, ← Finset.sum_coe_sort (validComps k.1 (m.1 + 1))]
            refine Finset.sum_congr rfl (fun μ _ => ?_)
            have hk_ge : 1 ≤ k.1 := (Finset.mem_Icc.mp k.2).1
            dsimp [weightB, mapAB]
            have hfac_eq : (k.1 - 1) + 1 = k.1 := by omega
            congr 1
            · rw [hfac_eq]
            · let ek : Fin ((k.1 - 1) + 1) ≃ Fin k.1 := Fin.castOrderIso hfac_eq |>.toEquiv
              exact (Fintype.prod_equiv ek _ _ (fun _ => rfl)).symm
        _ = ∑ b ∈ Finset.univ.image mapAB, weightB b :=
            (Finset.sum_image (fun a1 _ a2 _ h => hmap_inj h)).symm
        _ ≤ ∑ b : B, weightB b :=
            Finset.sum_le_univ_sum_of_nonneg hweightB_nonneg
    have hW_sum : (∑ n : Fin (N + 1), W n.1) ≤ P.a γ₀ := by
      calc (∑ n : Fin (N + 1), W n.1)
          = ∑ γ_1 : P.Pol, if P.incomp γ₀ γ_1 then
              kpWeight P γ_1 * (∑ n : Fin (N + 1), kpTreeTerm P n.1 γ_1) else 0 := by
            unfold W
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun γ_1 _ => ?_)
            split_ifs
            · rw [← Finset.mul_sum]
            · simp
        _ = ∑ γ_1 : P.Pol, if P.incomp γ₀ γ_1 then kpWeight P γ_1 * kpPartialSum P N γ_1 else 0 := by
            refine Finset.sum_congr rfl (fun γ_1 _ => ?_)
            split_ifs
            · congr 1
              unfold kpPartialSum
              rw [← Fin.sum_univ_eq_sum_range]
            · rfl
        _ ≤ ∑ γ_1 : P.Pol, if P.incomp γ₀ γ_1 then kpWeight P γ_1 * Real.exp (P.a γ_1) else 0 := by
            refine Finset.sum_le_sum (fun γ_1 _ => ?_)
            split_ifs
            · exact mul_le_mul_of_nonneg_left (ih γ_1) (kpWeight_nonneg P _)
            · exact le_rfl
        _ = ∑ γ_1 : P.Pol, if P.incomp γ₀ γ_1 then |P.z γ_1| * Real.exp (P.a γ_1 + P.d γ_1) else 0 := by
            refine Finset.sum_congr rfl (fun γ_1 _ => ?_)
            split_ifs
            · unfold kpWeight
              rw [Real.exp_add]
              ring
            · rfl
        _ ≤ P.a γ₀ := P.kp_cond γ₀
    have hB_eval : ∑ b : B, weightB b =
        ∑ k' : Fin (N + 1), (1 / (((k'.1 + 1).factorial : ℝ))) * (∑ n : Fin (N + 1), W n.1) ^ (k'.1 + 1) := by
      rw [Fintype.sum_sigma]
      refine Finset.sum_congr rfl (fun k' _ => ?_)
      dsimp [weightB]
      rw [← Finset.mul_sum]
      congr 1
      rw [← Fintype.prod_sum (fun (_ : Fin (k'.1 + 1)) (n : Fin (N + 1)) => W n.1)]
      simp [Finset.prod_const]
    have hS_nonneg : 0 ≤ ∑ n : Fin (N + 1), W n.1 := Finset.sum_nonneg (fun _ _ => hW_nonneg _)
    calc kpPartialSum P (N + 1) γ₀
        = kpTreeTerm P 0 γ₀ + ∑ m : Fin (N + 1), kpTreeTerm P (m.1 + 1) γ₀ := by
          unfold kpPartialSum
          rw [Finset.sum_range_succ', Fin.sum_univ_eq_sum_range (fun m => kpTreeTerm P (m + 1) γ₀),
            add_comm]
      _ ≤ 1 + ∑ b : B, weightB b := by
          rw [kpTreeTerm_zero]
          exact add_le_add_right hsum_terms 1
      _ = 1 + ∑ k' : Fin (N + 1),
            ((∑ n : Fin (N + 1), W n.1) ^ (k'.1 + 1) / ((k'.1 + 1).factorial : ℝ)) := by
          rw [hB_eval]
          congr 1
          refine Finset.sum_congr rfl (fun k' _ => by ring)
      _ = ∑ k ∈ Finset.range (N + 2), ((∑ n : Fin (N + 1), W n.1) ^ k / (k.factorial : ℝ)) := by
          rw [Finset.sum_range_succ', Fin.sum_univ_eq_sum_range (fun k =>
            ((∑ n : Fin (N + 1), W n.1) ^ (k + 1) / ((k + 1).factorial : ℝ))), add_comm]
          simp
      _ ≤ Real.exp (∑ n : Fin (N + 1), W n.1) :=
          Real.sum_le_exp_of_nonneg hS_nonneg (N + 2)
      _ ≤ Real.exp (P.a γ₀) :=
          Real.exp_le_exp.mpr hW_sum

/-- **Kotecký–Preiss / Mayer Tree-Graph Cluster Theorem (`[C/B/P]`)**:
For any finite polymer system satisfying `∑_{γ' ~ γ} |z(γ')| exp(a(γ') + d(γ')) ≤ a(γ)`:
1. Each order `(n + 1)` Ursell-weighted sum pinned at `γ₀` is bounded by `kpTreeTerm P n γ₀`;
2. The full truncated Mayer cluster series pinned at `γ₀` is bounded by `exp(a(γ₀))`;
3. The full connected cluster series incompatible with any observable/test polymer `γ_obs`
   is bounded by `a(γ_obs)`. `[B]` -/
theorem kotecky_preiss_mayer_cluster_theorem (P : KPPolymerSystem) :
    (∀ (n : ℕ) (γ₀ : P.Pol),
      (1 / (n.factorial : ℝ)) *
        (∑ γ : Fin n → P.Pol,
          |ursellCoeff P (Fin.cons γ₀ γ)| * ∏ i : Fin n, kpWeight P (γ i)) ≤
        kpTreeTerm P n γ₀) ∧
    (∀ (N : ℕ) (γ₀ : P.Pol),
      (∑ n ∈ Finset.range (N + 1),
        (1 / (n.factorial : ℝ)) *
          (∑ γ : Fin n → P.Pol,
            |ursellCoeff P (Fin.cons γ₀ γ)| * ∏ i : Fin n, kpWeight P (γ i))) ≤
        Real.exp (P.a γ₀)) ∧
    (∀ (N : ℕ) (γ_obs : P.Pol),
      (∑ γ₀ : P.Pol, if P.incomp γ_obs γ₀ then
        |P.z γ₀| * Real.exp (P.d γ₀) *
          (∑ n ∈ Finset.range (N + 1),
            (1 / (n.factorial : ℝ)) *
              (∑ γ : Fin n → P.Pol,
                |ursellCoeff P (Fin.cons γ₀ γ)| *
                  ∏ i : Fin n, (|P.z (γ i)| * Real.exp (P.d (γ i)))))
        else 0) ≤ P.a γ_obs) := by
  have h1 : ∀ (n : ℕ) (γ₀ : P.Pol),
      (1 / (n.factorial : ℝ)) *
        (∑ γ : Fin n → P.Pol,
          |ursellCoeff P (Fin.cons γ₀ γ)| * ∏ i : Fin n, kpWeight P (γ i)) ≤
        kpTreeTerm P n γ₀ := by
    intro n γ₀
    unfold kpTreeTerm
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    let trees := (completeEdges (Finset.univ : Finset (Fin (n + 1)))).powerset.filter
      (IsSpanningTree Finset.univ (0 : Fin (n + 1)))
    have hurs : ∀ γ : Fin n → P.Pol,
        |ursellCoeff P (Fin.cons γ₀ γ)| ≤
          ∑ T ∈ trees, if treeValid P Finset.univ 0 T γ₀
            (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) then (1 : ℝ) else 0 := by
      intro γ
      refine (abs_ursellCoeff_le_spanningTrees P (Fin.cons γ₀ γ)).trans_eq ?_
      have hsub_eq :
          (incompGraph P (Fin.cons γ₀ γ)).powerset.filter (IsSpanningTree Finset.univ (0 : Fin (n + 1))) =
          trees.filter (fun T => T ⊆ incompGraph P (Fin.cons γ₀ γ)) := by
        ext T
        simp only [trees, Finset.mem_filter, Finset.mem_powerset]
        constructor
        · rintro ⟨hTsub, hTsp⟩
          exact ⟨⟨hTsub.trans (incompGraph_subset P _), hTsp⟩, hTsub⟩
        · rintro ⟨⟨_, hTsp⟩, hTsub⟩
          exact ⟨hTsub, hTsp⟩
      rw [hsub_eq, Finset.card_filter, Nat.cast_sum]
      refine Finset.sum_congr rfl (fun T hT => ?_)
      have hT_ce : T ⊆ completeEdges (Finset.univ : Finset (Fin (n + 1))) :=
        Finset.mem_powerset.mp (Finset.mem_filter.mp hT).1
      have hiff : T ⊆ incompGraph P (Fin.cons γ₀ γ) ↔
          treeValid P Finset.univ 0 T γ₀
            (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) := by
        unfold treeValid incompGraph
        constructor
        · intro hTsub
          refine ⟨fun _ => rfl, fun e he => ?_⟩
          have hmem := Finset.mem_filter.mp (hTsub he)
          obtain ⟨i, j, rfl, hin⟩ := hmem.2
          exact ⟨i, Finset.mem_univ _, j, Finset.mem_univ _, rfl, hin⟩
        · rintro ⟨_, hed⟩ e he
          obtain ⟨u, _, v, _, rfl, hin⟩ := hed e he
          exact Finset.mem_filter.mpr ⟨hT_ce he, u, v, rfl, hin⟩
      by_cases hsub : T ⊆ incompGraph P (Fin.cons γ₀ γ)
      · rw [if_pos hsub, if_pos (hiff.mp hsub)]; simp
      · rw [if_neg hsub, if_neg (mt hiff.mpr hsub)]; simp
    have hprod_nonneg : ∀ γ : Fin n → P.Pol, 0 ≤ ∏ i : Fin n, kpWeight P (γ i) :=
      fun γ => Finset.prod_nonneg (fun _ _ => kpWeight_nonneg P _)
    have hstep1 :
        (∑ γ : Fin n → P.Pol,
          |ursellCoeff P (Fin.cons γ₀ γ)| * ∏ i : Fin n, kpWeight P (γ i)) ≤
        ∑ T ∈ trees, ∑ γ : Fin n → P.Pol,
          if treeValid P Finset.univ 0 T γ₀
              (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) then
            ∏ i : Fin n, kpWeight P (γ i)
          else 0 := by
      calc (∑ γ : Fin n → P.Pol,
              |ursellCoeff P (Fin.cons γ₀ γ)| * ∏ i : Fin n, kpWeight P (γ i))
          ≤ ∑ γ : Fin n → P.Pol,
              (∑ T ∈ trees,
                if treeValid P Finset.univ 0 T γ₀
                    (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) then (1 : ℝ) else 0) *
                ∏ i : Fin n, kpWeight P (γ i) :=
            Finset.sum_le_sum (fun γ _ => mul_le_mul_of_nonneg_right (hurs γ) (hprod_nonneg γ))
        _ = ∑ γ : Fin n → P.Pol, ∑ T ∈ trees,
              (if treeValid P Finset.univ 0 T γ₀
                  (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) then (1 : ℝ) else 0) *
                ∏ i : Fin n, kpWeight P (γ i) := by
            refine Finset.sum_congr rfl (fun γ _ => Finset.sum_mul _ _ _)
        _ = ∑ T ∈ trees, ∑ γ : Fin n → P.Pol,
              (if treeValid P Finset.univ 0 T γ₀
                  (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) then (1 : ℝ) else 0) *
                ∏ i : Fin n, kpWeight P (γ i) := Finset.sum_comm
        _ = ∑ T ∈ trees, ∑ γ : Fin n → P.Pol,
              if treeValid P Finset.univ 0 T γ₀
                  (fun v : ↥(Finset.univ : Finset (Fin (n + 1))) => (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1) then
                ∏ i : Fin n, kpWeight P (γ i)
              else 0 := by
            refine Finset.sum_congr rfl (fun T _ => Finset.sum_congr rfl (fun γ _ => ?_))
            split_ifs <;> simp
    refine hstep1.trans_eq ?_
    unfold treeTotalSum
    change (∑ T ∈ trees, _) = ∑ T ∈ trees, treeActivitySum P Finset.univ 0 T γ₀
    refine Finset.sum_congr rfl (fun T _ => ?_)
    unfold treeActivitySum
    let V0 := Finset.univ.filter (fun η : ↥(Finset.univ : Finset (Fin (n + 1))) → P.Pol =>
      η ⟨0, Finset.mem_univ 0⟩ = γ₀)
    have hV0 : (∑ η : ↥(Finset.univ : Finset (Fin (n + 1))) → P.Pol,
        if treeValid P Finset.univ 0 T γ₀ η then
          ∏ v ∈ (Finset.univ : Finset (Fin (n + 1))).attach.filter (fun v => v.1 ≠ 0),
            kpWeight P (η v)
        else 0) =
        ∑ η ∈ V0,
          if treeValid P Finset.univ 0 T γ₀ η then
            ∏ v ∈ (Finset.univ : Finset (Fin (n + 1))).attach.filter (fun v => v.1 ≠ 0),
              kpWeight P (η v)
          else 0 := by
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl (fun η _ => ?_)
      by_cases h0 : η ⟨0, Finset.mem_univ 0⟩ = γ₀
      · rw [if_pos h0]
      · rw [if_neg h0, if_neg (fun h => h0 (h.1 (Finset.mem_univ 0)))]
    rw [hV0]
    refine Finset.sum_bij
      (fun γ _ => fun v : ↥(Finset.univ : Finset (Fin (n + 1))) =>
        (Fin.cons γ₀ γ : Fin (n + 1) → P.Pol) v.1)
      (fun γ _ => Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩) ?_ ?_ ?_
    · intro γ1 _ γ2 _ heq
      funext i
      exact congrFun heq ⟨i.succ, Finset.mem_univ _⟩
    · intro η hη
      have h0 : η ⟨0, Finset.mem_univ 0⟩ = γ₀ := (Finset.mem_filter.mp hη).2
      refine ⟨fun i => η ⟨i.succ, Finset.mem_univ _⟩, Finset.mem_univ _, ?_⟩
      funext v
      obtain ⟨x, _⟩ := v
      rcases Fin.eq_zero_or_eq_succ x with rfl | ⟨i, rfl⟩
      · simpa using h0.symm
      · simp
    · intro γ _
      congr 1
      refine Finset.prod_bij (fun i _ => ⟨i.succ, Finset.mem_univ _⟩)
        (fun i _ => Finset.mem_filter.mpr ⟨Finset.mem_attach _ _, Fin.succ_ne_zero i⟩) ?_ ?_ ?_
      · intro i1 _ i2 _ heq
        exact Fin.succ_inj.mp (congrArg Subtype.val heq)
      · intro v hv
        have hv_ne : v.1 ≠ 0 := (Finset.mem_filter.mp hv).2
        obtain ⟨i, hi⟩ := Fin.eq_succ_of_ne_zero hv_ne
        refine ⟨i, Finset.mem_univ _, Subtype.ext hi.symm⟩
      · intro i _; rfl
  refine ⟨h1, ?_, ?_⟩
  · intro N γ₀
    exact (Finset.sum_le_sum (fun n _ => h1 n γ₀)).trans (kpPartialSum_le_exp P N γ₀)
  · intro N γ_obs
    calc (∑ γ₀ : P.Pol, if P.incomp γ_obs γ₀ then
            |P.z γ₀| * Real.exp (P.d γ₀) *
              (∑ n ∈ Finset.range (N + 1),
                (1 / (n.factorial : ℝ)) *
                  (∑ γ : Fin n → P.Pol,
                    |ursellCoeff P (Fin.cons γ₀ γ)| *
                      ∏ i : Fin n, (|P.z (γ i)| * Real.exp (P.d (γ i)))))
            else 0)
        ≤ ∑ γ₀ : P.Pol, if P.incomp γ_obs γ₀ then kpWeight P γ₀ * Real.exp (P.a γ₀) else 0 := by
          refine Finset.sum_le_sum (fun γ₀ _ => ?_)
          split_ifs
          · change kpWeight P γ₀ * _ ≤ kpWeight P γ₀ * Real.exp (P.a γ₀)
            refine mul_le_mul_of_nonneg_left ?_ (kpWeight_nonneg P γ₀)
            have hbound := (Finset.sum_le_sum (fun n _ => h1 n γ₀)).trans (kpPartialSum_le_exp P N γ₀)
            simpa [kpWeight] using hbound
          · exact le_rfl
      _ = ∑ γ₀ : P.Pol, if P.incomp γ_obs γ₀ then |P.z γ₀| * Real.exp (P.a γ₀ + P.d γ₀) else 0 := by
          refine Finset.sum_congr rfl (fun γ₀ _ => ?_)
          split_ifs
          · unfold kpWeight; rw [Real.exp_add]; ring
          · rfl
      _ ≤ P.a γ_obs := P.kp_cond γ_obs

end TreeDecomp

/-- Canonical `KPPolymerSystem` extracted from a `Round04UVPolymer.ScalePolymerSystem`
equipped with reflexive symmetric incompatibility (`compat`). `[B]` -/
noncomputable def kpSystemOfScale (S : Round04UVPolymer.ScalePolymerSystem)
    (h_refl : ∀ X : S.Pol, S.compat X X)
    (h_symm : ∀ X Y : S.Pol, S.compat X Y → S.compat Y X) : KPPolymerSystem where
  Pol := S.Pol
  fintypePol := S.fintypePol
  decEqPol := Classical.decEq S.Pol
  incomp := S.compat
  decIncomp := S.decCompat
  incomp_refl := h_refl
  incomp_symm := h_symm
  z := S.rho
  a := fun X => S.a * S.size X
  a_nonneg := fun X => by have := S.size_ge_one X; nlinarith [S.a_pos]
  d := fun X => (S.c_lf / S.g_k) * S.size X
  d_nonneg := fun X => by
    have := S.size_ge_one X
    exact mul_nonneg (div_nonneg S.c_lf_nonneg (le_of_lt S.g_k_pos)) (by linarith)
  kp_cond := fun X => by
    have h := S.kp_shifted_dom X
    refine le_trans (Finset.sum_le_sum (fun Y _ => ?_)) h
    split_ifs
    · have hexp : S.a * S.size Y + (S.c_lf / S.g_k) * S.size Y =
          (S.a + S.c_lf / S.g_k) * S.size Y := by ring
      rw [hexp]
    · exact le_rfl

/-- **Peierls-Suppressed Scale Mayer Cluster Bound (`[C/B/P]`)**:
Combining `kpSystemOfScale` with `kotecky_preiss_mayer_cluster_theorem` yields the
`exp(-c_lf / g_k)`-suppressed truncated Mayer connected cluster bound for any
observable/test polymer `γ_obs`. `[B]` -/
theorem scalePolymer_mayer_cluster_suppression
    (S : Round04UVPolymer.ScalePolymerSystem)
    (h_refl : ∀ X : S.Pol, S.compat X X)
    (h_symm : ∀ X Y : S.Pol, S.compat X Y → S.compat Y X)
    (N : ℕ) (γ_obs : S.Pol) :
    let P := kpSystemOfScale S h_refl h_symm
    (∑ γ₀ : S.Pol, if S.compat γ_obs γ₀ then
      |S.rho γ₀| *
        (∑ n ∈ Finset.range (N + 1),
          (1 / (n.factorial : ℝ)) *
            (∑ γ : Fin n → S.Pol,
              |ursellCoeff P (Fin.cons γ₀ γ)| *
                ∏ i : Fin n, (|S.rho (γ i)| * Real.exp ((S.c_lf / S.g_k) * S.size (γ i)))))
      else 0) ≤ (S.a * S.size γ_obs) * Real.exp (-(S.c_lf / S.g_k)) := by
  intro P
  have hkp := (kotecky_preiss_mayer_cluster_theorem P).2.2 N γ_obs
  have hfac : Real.exp (S.c_lf / S.g_k) > 0 := Real.exp_pos _
  have hmul : Real.exp (S.c_lf / S.g_k) *
      (∑ γ₀ : S.Pol, if S.compat γ_obs γ₀ then
        |S.rho γ₀| *
          (∑ n ∈ Finset.range (N + 1),
            (1 / (n.factorial : ℝ)) *
              (∑ γ : Fin n → S.Pol,
                |ursellCoeff P (Fin.cons γ₀ γ)| *
                  ∏ i : Fin n, (|S.rho (γ i)| * Real.exp ((S.c_lf / S.g_k) * S.size (γ i)))))
        else 0) ≤ S.a * S.size γ_obs := by
    rw [Finset.mul_sum]
    refine le_trans (Finset.sum_le_sum (fun γ₀ _ => ?_)) hkp
    by_cases hcompat : S.compat γ_obs γ₀
    · simp only [if_pos hcompat]
      have hsize : 1 ≤ S.size γ₀ := S.size_ge_one γ₀
      have hexp_le : Real.exp (S.c_lf / S.g_k) ≤ Real.exp (P.d γ₀) := by
        apply Real.exp_le_exp.mpr
        change S.c_lf / S.g_k ≤ (S.c_lf / S.g_k) * S.size γ₀
        have hc_nn : 0 ≤ S.c_lf / S.g_k := div_nonneg S.c_lf_nonneg (le_of_lt S.g_k_pos)
        nlinarith [hc_nn]
      have hinner_nn : 0 ≤ ∑ n ∈ Finset.range (N + 1),
          (1 / (n.factorial : ℝ)) *
            (∑ γ : Fin n → S.Pol,
              |ursellCoeff P (Fin.cons γ₀ γ)| *
                ∏ i : Fin n, (|S.rho (γ i)| * Real.exp ((S.c_lf / S.g_k) * S.size (γ i)))) := by
        refine Finset.sum_nonneg (fun n _ => mul_nonneg (by positivity) ?_)
        refine Finset.sum_nonneg (fun γ _ => mul_nonneg (abs_nonneg _) ?_)
        exact Finset.prod_nonneg (fun i _ => mul_nonneg (abs_nonneg _) (le_of_lt (Real.exp_pos _)))
      have hrew : Real.exp (S.c_lf / S.g_k) * (|S.rho γ₀| *
          (∑ n ∈ Finset.range (N + 1),
            (1 / (n.factorial : ℝ)) *
              (∑ γ : Fin n → S.Pol,
                |ursellCoeff P (Fin.cons γ₀ γ)| *
                  ∏ i : Fin n, (|S.rho (γ i)| * Real.exp ((S.c_lf / S.g_k) * S.size (γ i)))))) =
          (|S.rho γ₀| * Real.exp (S.c_lf / S.g_k)) *
            (∑ n ∈ Finset.range (N + 1),
              (1 / (n.factorial : ℝ)) *
                (∑ γ : Fin n → S.Pol,
                  |ursellCoeff P (Fin.cons γ₀ γ)| *
                    ∏ i : Fin n, (|S.rho (γ i)| * Real.exp ((S.c_lf / S.g_k) * S.size (γ i))))) := by
        ring
      rw [hrew]
      change (|S.rho γ₀| * Real.exp (S.c_lf / S.g_k)) * _ ≤
        if S.compat γ_obs γ₀ then (|S.rho γ₀| * Real.exp (P.d γ₀)) * _ else 0
      rw [if_pos hcompat]
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hexp_le (abs_nonneg _)) hinner_nn
    · simp only [if_neg hcompat, mul_zero]
      change 0 ≤ if S.compat γ_obs γ₀ then _ else 0
      rw [if_neg hcompat]
  have hdiv := div_le_div_of_nonneg_right hmul (le_of_lt hfac)
  rw [mul_div_cancel_left₀ _ (ne_of_gt hfac)] at hdiv
  conv_rhs at hdiv => rw [div_eq_mul_inv, ← Real.exp_neg]
  exact hdiv

/-- **`a_k^4`-Normalized Connected Observable Convergence (`[C/B/P]`)**:
Unifies `Round04UVCombesCounterterm.telescoping_vacuum_counterterm_cancellation` (`16^k`-free
ratio cancellation of extensive vacuum energy `E_vac(K)`) with the multi-scale Kotecký–Preiss
Mayer cluster expansion `scalePolymer_mayer_cluster_suppression`.
Whenever each RG scale `k` carries a `ScalePolymerSystem` `S k` at running coupling
`g_k = √(runningG2 gK2 b0 L_blk k)` with `c_lf ≤ (S k).c_lf`, and the `a_k^4`-normalized
connected observable increment `δO_ren(k)` is bounded by a 2-loop perturbative term
`C_pt * g_k^4` plus the truncated Mayer cluster expansion at observable polymer `γ_obs k`,
`O_norm(K) = S_bare(K) / Z_bare(K)` is free of `16^k` volume factors, forms a `CauchySeq`,
and converges to `O_inf` at rate `|O_inf - O_norm K| ≤ B_tot / K`. -/
theorem normalized_ak4_connected_observable_convergence
    {b0 L_blk gK2 C_pt C_kp c_lf a_obs L_phys a0 e0 : ℝ}
    (hb0 : 0 < b0) (hL : 1 < L_blk) (hgK : 0 < gK2)
    (hCpt : 0 ≤ C_pt) (hCkp : 0 ≤ C_kp) (hclf : 0 < c_lf)
    (ha_obs : 0 ≤ a_obs) (hLphys : 0 < L_phys) (ha0 : 0 < a0) (he0 : 0 < e0)
    (S : ℕ → Round04UVPolymer.ScalePolymerSystem)
    (h_refl : ∀ k (X : (S k).Pol), (S k).compat X X)
    (h_symm : ∀ k (X Y : (S k).Pol), (S k).compat X Y → (S k).compat Y X)
    (hg_k : ∀ k : ℕ, (S k).g_k = Real.sqrt (runningG2 gK2 b0 L_blk k))
    (hclf_k : ∀ k : ℕ, c_lf ≤ (S k).c_lf)
    (γ_obs : (k : ℕ) → (S k).Pol)
    (hobs_size : ∀ k : ℕ, (S k).a * (S k).size (γ_obs k) ≤ a_obs)
    (N_trunc : ℕ → ℕ)
    (DeltaE Z_bare S_bare Z_ren S_ren : ℕ → ℝ)
    (hDeltaE_lb : ∀ j : ℕ, 6 * (L_phys / (a0 * (1 / L_blk) ^ j)) ^ 4 * e0 ≤ DeltaE j)
    (hZ_ren_ne : ∀ K : ℕ, Z_ren K ≠ 0)
    (hfactor_Z : ∀ K : ℕ, Z_bare K = Real.exp (-(∑ j : Fin K, DeltaE j.1)) * Z_ren K)
    (hfactor_S : ∀ K : ℕ, S_bare K = Real.exp (-(∑ j : Fin K, DeltaE j.1)) * S_ren K)
    (hdO_cluster : ∀ k : ℕ,
      let P_k := kpSystemOfScale (S k) (h_refl k) (h_symm k)
      |S_ren (k + 1) / Z_ren (k + 1) - S_ren k / Z_ren k| ≤
        C_pt * (runningG2 gK2 b0 L_blk k) ^ 2 +
        C_kp * (∑ γ₀ : (S k).Pol, if (S k).compat (γ_obs k) γ₀ then
          |(S k).rho γ₀| *
            (∑ n ∈ Finset.range (N_trunc k + 1),
              (1 / (n.factorial : ℝ)) *
                (∑ γ : Fin n → (S k).Pol,
                  |ursellCoeff P_k (Fin.cons γ₀ γ)| *
                    ∏ i : Fin n,
                      (|(S k).rho (γ i)| * Real.exp (((S k).c_lf / (S k).g_k) * (S k).size (γ i)))))
          else 0)) :
    let O_norm : ℕ → ℝ := fun K => S_bare K / Z_bare K
    let m : ℝ := min (1 / gK2) (blockStepDelta b0 L_blk)
    let C_lf_eff : ℝ := C_kp * a_obs
    let B_tot : ℝ := C_pt / m ^ 2 + C_lf_eff * (24 / (c_lf ^ 4 * m ^ 2))
    (∀ k : ℕ,
      |S_ren (k + 1) / Z_ren (k + 1) - S_ren k / Z_ren k| ≤
        C_pt * (runningG2 gK2 b0 L_blk k) ^ 2 +
          C_lf_eff * Real.exp (-(c_lf / Real.sqrt (runningG2 gK2 b0 L_blk k)))) ∧
    (∀ K : ℕ, O_norm K = S_ren K / Z_ren K) ∧
    (∀ (C_shift : ℕ → ℝ) (K : ℕ),
      (Real.exp (-C_shift K) * S_bare K) / (Real.exp (-C_shift K) * Z_bare K) =
        S_ren K / Z_ren K) ∧
    (∀ K : ℕ, |O_norm K - O_norm 0| ≤ 2 * B_tot) ∧
    CauchySeq O_norm ∧
    (∃ O_inf : ℝ, Filter.Tendsto O_norm Filter.atTop (nhds O_inf) ∧
      ∀ K : ℕ, 1 ≤ K → |O_inf - O_norm K| ≤ B_tot / (K : ℝ)) := by
  have hdO_bound : ∀ k : ℕ,
      |S_ren (k + 1) / Z_ren (k + 1) - S_ren k / Z_ren k| ≤
        C_pt * (runningG2 gK2 b0 L_blk k) ^ 2 +
          (C_kp * a_obs) * Real.exp (-(c_lf / Real.sqrt (runningG2 gK2 b0 L_blk k))) := by
    intro k
    have hsup := scalePolymer_mayer_cluster_suppression (S k) (h_refl k) (h_symm k)
      (N_trunc k) (γ_obs k)
    have hexp_k : Real.exp (-((S k).c_lf / (S k).g_k)) ≤
        Real.exp (-(c_lf / Real.sqrt (runningG2 gK2 b0 L_blk k))) := by
      apply Real.exp_le_exp.mpr
      rw [neg_le_neg_iff, hg_k k]
      exact div_le_div_of_nonneg_right (hclf_k k) (Real.sqrt_nonneg _)
    have hsup2 : ((S k).a * (S k).size (γ_obs k)) * Real.exp (-((S k).c_lf / (S k).g_k)) ≤
        a_obs * Real.exp (-(c_lf / Real.sqrt (runningG2 gK2 b0 L_blk k))) := by
      have ha_nn : 0 ≤ (S k).a * (S k).size (γ_obs k) := by
        have := (S k).size_ge_one (γ_obs k)
        nlinarith [(S k).a_pos]
      exact mul_le_mul (hobs_size k) hexp_k (le_of_lt (Real.exp_pos _)) ha_obs
    have hkp := le_trans (hdO_cluster k)
      (add_le_add_right (mul_le_mul_of_nonneg_left (hsup.trans hsup2) hCkp) _)
    simpa [mul_assoc] using hkp
  have htel := Round04UVCombesCounterterm.telescoping_vacuum_counterterm_cancellation
    hb0 hL hgK hCpt (mul_nonneg hCkp ha_obs) hclf hLphys ha0 he0
    DeltaE Z_bare S_bare Z_ren S_ren hDeltaE_lb hZ_ren_ne hfactor_Z hfactor_S hdO_bound
  exact ⟨hdO_bound, htel.2.2.2.1, htel.2.2.2.2.2.1, htel.2.2.2.2.2.2.2.2.1,
    htel.2.2.2.2.2.2.2.2.2.1, htel.2.2.2.2.2.2.2.2.2.2⟩

end KoteckyPreissMayer

/-! ## Part 3: 4D `T^4` Multi-Plaquette Splitting, Peierls-KP Discharge & Finite-`V` vs `V → ∞` `UV-X` Isolation -/

section T4PlaquetteSplitting

/-- Lattice site on the 4-torus `T^4_L = (ℤ/Lℤ)^4`. `[B]` -/
abbrev T4Site (L : ℕ) : Type := Fin 4 → ZMod L

/-- Oriented 2-plane `μ < ν` in 4D Euclidean spacetime (`C(4, 2) = 6` planes). `[B]` -/
abbrev T4Plane : Type := { p : Fin 4 × Fin 4 // p.1 < p.2 }

/-- Elementary plaquette on the 4-torus `T^4_L`. `[B]` -/
abbrev T4Plaquette (L : ℕ) : Type := T4Site L × T4Plane

lemma t4_plane_card : Fintype.card T4Plane = 6 := by decide

lemma t4_plaquette_card (L : ℕ) [NeZero L] : Fintype.card (T4Plaquette L) = 6 * L ^ 4 := by
  rw [Fintype.card_prod, Fintype.card_pi, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    ZMod.card, t4_plane_card]
  ring

/-- 4D `T^4_L` gauge-field plaquette small-field / large-field splitting data (`[C/B]`). -/
structure T4PlaquetteSplit (L : ℕ) [NeZero L] where
  plaquetteDefect : T4Plaquette L → ℝ
  defect_nonneg : ∀ p : T4Plaquette L, 0 ≤ plaquetteDefect p
  eps_sf : ℝ
  eps_sf_pos : 0 < eps_sf
  beta : ℝ
  beta_pos : 0 < beta

section SplitProps

open Classical

/-- Small-field plaquette region `Ω_sf = {p ∈ T^4_L | d_p ≤ ε_sf}`. `[B]` -/
noncomputable def T4PlaquetteSplit.omegaSF {L : ℕ} [NeZero L] (S : T4PlaquetteSplit L) :
    Finset (T4Plaquette L) :=
  Finset.univ.filter (fun p => S.plaquetteDefect p ≤ S.eps_sf)

/-- Large-field plaquette region `Ω_lf = {p ∈ T^4_L | ε_sf < d_p}`. `[B]` -/
noncomputable def T4PlaquetteSplit.omegaLF {L : ℕ} [NeZero L] (S : T4PlaquetteSplit L) :
    Finset (T4Plaquette L) :=
  Finset.univ.filter (fun p => S.eps_sf < S.plaquetteDefect p)

/-- Total Wilson lattice action on `T^4_L`: `β * ∑_p d_p`. `[B]` -/
noncomputable def T4PlaquetteSplit.wilsonAction {L : ℕ} [NeZero L] (S : T4PlaquetteSplit L) : ℝ :=
  S.beta * ∑ p : T4Plaquette L, S.plaquetteDefect p

/-- **`T^4` Multi-Plaquette Small-Field / Large-Field Partition & Peierls Suppression (`[C/B]`)**:
For any configuration on `T^4_L`:
1. `Ω_sf` and `Ω_lf` partition all `6 L^4` plaquettes (`Ω = Ω_sf ⊔ Ω_lf`, `|Ω_sf| + |Ω_lf| = 6 L^4`),
2. The Wilson action splits additively as `S_sf + S_lf`,
3. Each large-field plaquette contributes at least `β * ε_sf`, giving the exact Peierls bound
   `exp(-S_lf) ≤ exp(-(β * ε_sf) * |Ω_lf|)`. `[B]` -/
theorem t4_plaquette_partition_and_peierls_bound {L : ℕ} [NeZero L] (S : T4PlaquetteSplit L) :
    Disjoint S.omegaSF S.omegaLF ∧
    S.omegaSF ∪ S.omegaLF = Finset.univ ∧
    S.omegaSF.card + S.omegaLF.card = 6 * L ^ 4 ∧
    S.wilsonAction =
      S.beta * (∑ p ∈ S.omegaSF, S.plaquetteDefect p) +
        S.beta * (∑ p ∈ S.omegaLF, S.plaquetteDefect p) ∧
    (S.beta * S.eps_sf) * (S.omegaLF.card : ℝ) ≤
      S.beta * (∑ p ∈ S.omegaLF, S.plaquetteDefect p) ∧
    Real.exp (-(S.beta * (∑ p ∈ S.omegaLF, S.plaquetteDefect p))) ≤
      Real.exp (-(S.beta * S.eps_sf) * (S.omegaLF.card : ℝ)) := by
  have hdisj : Disjoint S.omegaSF S.omegaLF := by
    rw [Finset.disjoint_left]
    intro p hsf hlf
    have h1 : S.plaquetteDefect p ≤ S.eps_sf := (Finset.mem_filter.mp hsf).2
    have h2 : S.eps_sf < S.plaquetteDefect p := (Finset.mem_filter.mp hlf).2
    linarith
  have hunion : S.omegaSF ∪ S.omegaLF = Finset.univ := by
    ext p
    simp only [T4PlaquetteSplit.omegaSF, T4PlaquetteSplit.omegaLF, Finset.mem_union,
      Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · intro _; trivial
    · intro _; exact le_or_gt (S.plaquetteDefect p) S.eps_sf
  have hcard : S.omegaSF.card + S.omegaLF.card = 6 * L ^ 4 := by
    rw [← Finset.card_union_of_disjoint hdisj, hunion, Finset.card_univ, t4_plaquette_card]
  have hact : S.wilsonAction =
      S.beta * (∑ p ∈ S.omegaSF, S.plaquetteDefect p) +
        S.beta * (∑ p ∈ S.omegaLF, S.plaquetteDefect p) := by
    unfold T4PlaquetteSplit.wilsonAction
    rw [← mul_add, ← Finset.sum_union hdisj, hunion]
  have hpeierls_lb : (S.beta * S.eps_sf) * (S.omegaLF.card : ℝ) ≤
      S.beta * (∑ p ∈ S.omegaLF, S.plaquetteDefect p) := by
    have hsum : (S.omegaLF.card : ℝ) * S.eps_sf ≤ ∑ p ∈ S.omegaLF, S.plaquetteDefect p := by
      calc (S.omegaLF.card : ℝ) * S.eps_sf
          = ∑ _p ∈ S.omegaLF, S.eps_sf := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ∑ p ∈ S.omegaLF, S.plaquetteDefect p :=
            Finset.sum_le_sum (fun p hp => le_of_lt (Finset.mem_filter.mp hp).2)
    have hmul := mul_le_mul_of_nonneg_left hsum (le_of_lt S.beta_pos)
    linarith
  have hexp_ub : Real.exp (-(S.beta * (∑ p ∈ S.omegaLF, S.plaquetteDefect p))) ≤
      Real.exp (-(S.beta * S.eps_sf) * (S.omegaLF.card : ℝ)) := by
    apply Real.exp_le_exp.mpr
    linarith
  exact ⟨hdisj, hunion, hcard, hact, hpeierls_lb, hexp_ub⟩

end SplitProps

/-- **Peierls + Lattice-Animal Entropy → Shifted Kotecký–Preiss Discharge (`[B]`)**:
Given a finite polymer family `Pol` on `T^4_L` with polymer size `size Y ≥ 1`, lattice-animal
entropy factor `K_ent ≥ 1` per plaquette (`#{Y ~ X : |Y| = m} ≤ |X| * K_ent^m`),
and multi-plaquette Peierls bound `|ρ(Y)| ≤ exp(-(c_peierls / g_k) * |Y|)` with `c_peierls > c_lf`,
whenever the running coupling satisfies `(c_peierls - c_lf) / g_k ≥ log K_ent + a_kp + log((1 + a_kp)/a_kp)`,
both the shifted scale-polymer KP condition (`ScalePolymerSystem`) and the finite-graph
`KPPolymerSystem` convergence criterion are constructively discharged. `[B]` -/
theorem t4_peierls_kp_polymer_discharge
    (Pol : Type) [Fintype Pol] [DecidableEq Pol]
    (incomp : Pol → Pol → Prop) [DecidableRel incomp]
    (h_refl : ∀ X : Pol, incomp X X)
    (h_symm : ∀ X Y : Pol, incomp X Y → incomp Y X)
    (size : Pol → ℕ) (hsize_pos : ∀ Y : Pol, 1 ≤ size Y)
    (rho : Pol → ℝ)
    (a_kp c_lf c_peierls g_k K_ent : ℝ)
    (ha_kp : 0 < a_kp) (hclf : 0 ≤ c_lf) (hg_k : 0 < g_k) (hKent : 1 ≤ K_ent)
    (hpeierls : ∀ Y : Pol, |rho Y| ≤ Real.exp (-(c_peierls / g_k) * (size Y : ℝ)))
    (hentropy : ∀ (X : Pol) (m : ℕ), 1 ≤ m →
      (((Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m)).card : ℝ)) ≤
        (size X : ℝ) * K_ent ^ m)
    (hregime : Real.log K_ent + a_kp + Real.log ((1 + a_kp) / a_kp) ≤ (c_peierls - c_lf) / g_k) :
    ∃ (S : Round04UVPolymer.ScalePolymerSystem),
      S.Pol = Pol ∧ S.a = a_kp ∧ S.c_lf = c_lf ∧ S.g_k = g_k ∧
      (∀ X : S.Pol, (∑ Y : S.Pol, if S.compat X Y then |S.rho Y| *
          Real.exp ((S.a + S.c_lf / S.g_k) * S.size Y) else 0) ≤ S.a * S.size X) := by
  let M_max : ℕ := Finset.univ.sup size
  let q : ℝ := K_ent * Real.exp (a_kp + c_lf / g_k - c_peierls / g_k)
  have hq_nn : 0 ≤ q := mul_nonneg (by linarith) (le_of_lt (Real.exp_pos _))
  have hlog_eq : Real.log (K_ent * ((1 + a_kp) / a_kp)) =
      Real.log K_ent + Real.log ((1 + a_kp) / a_kp) :=
    Real.log_mul (ne_of_gt (by linarith)) (ne_of_gt (div_pos (by linarith) ha_kp))
  have hq_le : q ≤ a_kp / (1 + a_kp) := by
    have hexp_le : Real.exp (a_kp + c_lf / g_k - c_peierls / g_k) ≤
        Real.exp (-(Real.log (K_ent * ((1 + a_kp) / a_kp)))) := by
      apply Real.exp_le_exp.mpr
      have hsub : (c_peierls - c_lf) / g_k = c_peierls / g_k - c_lf / g_k := by ring
      linarith [hlog_eq]
    rw [Real.exp_neg, Real.exp_log (mul_pos (by linarith) (div_pos (by linarith) ha_kp))] at hexp_le
    have hK_pos : 0 < K_ent := by linarith
    have hinv_eq : (K_ent * ((1 + a_kp) / a_kp))⁻¹ = (a_kp / (1 + a_kp)) / K_ent := by
      field_simp
    rw [hinv_eq] at hexp_le
    calc q = K_ent * Real.exp (a_kp + c_lf / g_k - c_peierls / g_k) := rfl
      _ ≤ K_ent * ((a_kp / (1 + a_kp)) / K_ent) := mul_le_mul_of_nonneg_left hexp_le (by linarith)
      _ = a_kp / (1 + a_kp) := by field_simp [ne_of_gt hK_pos]
  have hq_lt1 : q < 1 := by
    have hlt : a_kp / (1 + a_kp) < 1 := by
      rw [div_lt_one (by linarith)]
      linarith
    exact lt_of_le_of_lt hq_le hlt
  have h1mq_pos : 0 < 1 - q := by linarith
  have hgeom_sum : ∑ m ∈ Finset.Icc 1 (M_max + 1), q ^ m ≤ a_kp := by
    have htele : (1 - q) * ∑ j ∈ Finset.range (M_max + 1), q ^ j = 1 - q ^ (M_max + 1) := by
      rw [Finset.mul_sum]
      have hpt : ∀ j : ℕ, (1 - q) * q ^ j = q ^ j - q ^ (j + 1) := fun j => by
        rw [pow_succ]; ring
      simp_rw [hpt]
      exact Finset.sum_range_sub' (fun j => q ^ j) (M_max + 1)
    have hsum_le_inv : ∑ j ∈ Finset.range (M_max + 1), q ^ j ≤ 1 / (1 - q) := by
      have hle1 : (1 - q) * ∑ j ∈ Finset.range (M_max + 1), q ^ j ≤ 1 := by
        rw [htele]
        have hqn : 0 ≤ q ^ (M_max + 1) := pow_nonneg hq_nn _
        linarith
      exact (le_div_iff₀' h1mq_pos).mpr hle1
    have hIcc_eq : ∑ m ∈ Finset.Icc 1 (M_max + 1), q ^ m =
        q * ∑ j ∈ Finset.range (M_max + 1), q ^ j := by
      have hbij : ∑ m ∈ Finset.Icc 1 (M_max + 1), q ^ m =
          ∑ j ∈ Finset.range (M_max + 1), q ^ (j + 1) := by
        refine Finset.sum_bij (fun m _ => m - 1) ?_ ?_ ?_ ?_
        · intro m hm
          rw [Finset.mem_Icc] at hm
          exact Finset.mem_range.mpr (by omega)
        · intro m1 hm1 m2 hm2 heq
          rw [Finset.mem_Icc] at hm1 hm2
          omega
        · intro j hj
          rw [Finset.mem_range] at hj
          exact ⟨j + 1, Finset.mem_Icc.mpr ⟨by omega, by omega⟩, by simp⟩
        · intro m hm
          rw [Finset.mem_Icc] at hm
          have : (m - 1) + 1 = m := by omega
          rw [this]
      rw [hbij, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => by rw [pow_succ'])
    have hq_div_le : q / (1 - q) ≤ a_kp := by
      rw [div_le_iff₀ h1mq_pos]
      have hmul : q * (1 + a_kp) ≤ a_kp := by
        exact (le_div_iff₀ (by linarith : 0 < 1 + a_kp)).mp hq_le
      linarith
    calc ∑ m ∈ Finset.Icc 1 (M_max + 1), q ^ m
        = q * ∑ j ∈ Finset.range (M_max + 1), q ^ j := hIcc_eq
      _ ≤ q * (1 / (1 - q)) := mul_le_mul_of_nonneg_left hsum_le_inv hq_nn
      _ = q / (1 - q) := by ring
      _ ≤ a_kp := hq_div_le
  have hdom : ∀ X : Pol,
      (∑ Y : Pol, if incomp X Y then
        |rho Y| * Real.exp ((a_kp + c_lf / g_k) * (size Y : ℝ)) else 0) ≤
        a_kp * (size X : ℝ) := by
    intro X
    have hpt : ∀ Y : Pol,
        (if incomp X Y then |rho Y| * Real.exp ((a_kp + c_lf / g_k) * (size Y : ℝ)) else 0) ≤
        (if incomp X Y then Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (size Y : ℝ)) else 0) := by
      intro Y
      split_ifs
      · calc |rho Y| * Real.exp ((a_kp + c_lf / g_k) * (size Y : ℝ))
            ≤ Real.exp (-(c_peierls / g_k) * (size Y : ℝ)) *
                Real.exp ((a_kp + c_lf / g_k) * (size Y : ℝ)) :=
              mul_le_mul_of_nonneg_right (hpeierls Y) (le_of_lt (Real.exp_pos _))
          _ = Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (size Y : ℝ)) := by
              rw [← Real.exp_add]
              congr 1
              ring
      · exact le_rfl
    have hfib : (∑ Y : Pol, if incomp X Y then
          Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (size Y : ℝ)) else 0) =
        ∑ m ∈ Finset.Icc 1 (M_max + 1),
          ((Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m)).card : ℝ) *
            Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ)) := by
      rw [← Finset.sum_filter]
      have hmaps : ∀ Y ∈ Finset.univ.filter (fun Y : Pol => incomp X Y),
          size Y ∈ Finset.Icc 1 (M_max + 1) := by
        intro Y _
        rw [Finset.mem_Icc]
        refine ⟨hsize_pos Y, ?_⟩
        exact Nat.le_succ_of_le (Finset.le_sup (Finset.mem_univ Y))
      rw [← Finset.sum_fiberwise_of_maps_to hmaps]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      have hfilt_eq : (Finset.univ.filter (fun Y : Pol => incomp X Y)).filter (fun Y => size Y = m) =
          Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m) := by
        ext Y; simp [Finset.mem_filter]
      rw [hfilt_eq]
      calc (∑ Y ∈ Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m),
              Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (size Y : ℝ)))
          = ∑ _Y ∈ Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m),
              Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ)) := by
            refine Finset.sum_congr rfl (fun Y hY => ?_)
            rw [(Finset.mem_filter.mp hY).2.2]
        _ = ((Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m)).card : ℝ) *
              Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ)) := by
            rw [Finset.sum_const, nsmul_eq_mul]
    have hsum_ent :
        ∑ m ∈ Finset.Icc 1 (M_max + 1),
          ((Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m)).card : ℝ) *
            Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ)) ≤
        (size X : ℝ) * ∑ m ∈ Finset.Icc 1 (M_max + 1), q ^ m := by
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun m hm => ?_)
      have hm1 : 1 ≤ m := (Finset.mem_Icc.mp hm).1
      have hle := mul_le_mul_of_nonneg_right (hentropy X m hm1)
        (le_of_lt (Real.exp_pos ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ))))
      have hq_pow : q ^ m = K_ent ^ m * Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ)) := by
        dsimp [q]
        rw [mul_pow, ← Real.exp_nat_mul]
        congr 2
        ring
      rw [hq_pow]
      linarith
    have hX_nn : 0 ≤ (size X : ℝ) := Nat.cast_nonneg _
    calc (∑ Y : Pol, if incomp X Y then |rho Y| * Real.exp ((a_kp + c_lf / g_k) * (size Y : ℝ)) else 0)
        ≤ ∑ Y : Pol, if incomp X Y then
            Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (size Y : ℝ)) else 0 :=
          Finset.sum_le_sum (fun Y _ => hpt Y)
      _ = ∑ m ∈ Finset.Icc 1 (M_max + 1),
            ((Finset.univ.filter (fun Y : Pol => incomp X Y ∧ size Y = m)).card : ℝ) *
              Real.exp ((a_kp + c_lf / g_k - c_peierls / g_k) * (m : ℝ)) := hfib
      _ ≤ (size X : ℝ) * ∑ m ∈ Finset.Icc 1 (M_max + 1), q ^ m := hsum_ent
      _ ≤ (size X : ℝ) * a_kp := mul_le_mul_of_nonneg_left hgeom_sum hX_nn
      _ = a_kp * (size X : ℝ) := mul_comm _ _
  let S : Round04UVPolymer.ScalePolymerSystem :=
    { Pol := Pol
      fintypePol := inferInstance
      compat := incomp
      decCompat := inferInstance
      size := fun Y => (size Y : ℝ)
      size_ge_one := fun Y => by exact_mod_cast hsize_pos Y
      rho := rho
      a := a_kp
      a_pos := ha_kp
      c_lf := c_lf
      c_lf_nonneg := hclf
      g_k := g_k
      g_k_pos := hg_k
      kp_shifted_dom := hdom }
  have _ := h_refl
  have _ := h_symm
  exact ⟨S, rfl, rfl, rfl, rfl, hdom⟩

/-- **`T^4` Small-Field / Large-Field `CSX-06` Viability Step (`[C/B]`)**:
Constructs a `Round04UVPolymer.ViabilityCSX06ScaleStep` from a small-field configuration sector
`X_sf ↪ X_full` and a normalized full measure `μ_full : PMF X_full` whose large-field
complement weight is Peierls-suppressed `≤ exp(-c_lf / g_k)`, proving stationary small-field
retention (`ViabilityKernel`) and explicit unrenormalized escape mass bound `≤ exp(-c_lf / g_k)`. -/
theorem t4_csx06_splitting_step
    (X_sf X_full : Type)
    [Fintype X_sf] [Nonempty X_sf] [Fintype X_full]
    [MeasurableSpace X_full] [MeasurableSingletonClass X_full]
    [MeasurableSpace (Option X_sf)] [MeasurableSingletonClass (Option X_sf)]
    (embed : X_sf → X_full) (hembed : Function.Injective embed)
    (μ_full : PMF X_full) (c_lf g_k : ℝ)
    (hpeierls_mass : μ_full.toMeasure.real (Set.range embed)ᶜ ≤ Real.exp (-(c_lf / g_k))) :
    ∃ step : Round04UVPolymer.ViabilityCSX06ScaleStep,
      (∃ π : step.X_sf → step.A_sf, ∀ x ∈ step.K_sf, StaysIn (step.P_sf x (π x)) step.K_sf) ∧
      step.escapeMass = μ_full.toMeasure.real (Set.range embed)ᶜ ∧
      step.escapeMass ≤ Real.exp (-(c_lf / g_k)) := by
  let P_sf : X_sf → Unit → PMF X_sf := fun x _ => PMF.pure x
  have hfix : viabilityStep P_sf (Set.univ : Set X_sf) = Set.univ := by
    ext x
    simp only [viabilityStep, Set.mem_ofPred_eq, Set.mem_univ, iff_true, true_and]
    refine ⟨(), fun y hy => ?_⟩
    simp [P_sf] at hy ⊢
  let step : Round04UVPolymer.ViabilityCSX06ScaleStep :=
    { X_sf := X_sf
      A_sf := Unit
      P_sf := P_sf
      K_sf := Set.univ
      hfix := hfix
      X_full := X_full
      embed := embed
      embed_inj := hembed
      μ_full := μ_full }
  have hret := Round04UVPolymer.viability_csx06_step_retention_and_escape step
  exact ⟨step, hret.1, hret.2.1, hret.2.1.le.trans hpeierls_mass⟩

end T4PlaquetteSplitting

section BalabanUVXGap

/-- **Fixed-Volume 4D `T^4_L` Balaban Inductive RG Step (`[C/B/P]`)**:
Encapsulates all ingredients that hold at fixed finite lattice volume `L` and finite RG depth:
1. Nested `ClosureResolution` scale chain and `T^4_L` plaquette splitting `Ω_sf ⊔ Ω_lf`,
2. Scale-indexed `ScalePolymerSystem` (`poly k`) with `c_lf ≤ (poly k).c_lf` and `g_k = √(runningG2 gK2 b0 L_blk k)`,
3. `CSX-06` small-field viability + large-field escape mass dominated by polymer weights,
4. Decaying small-field Mori–Zwanzig contraction (`kappa_irr < 1`, summable `delta k`),
5. `a_k^4`-normalized vacuum counterterm factorization (`16^k`-free),
6. Finite-volume symmetric lattice transfer factorization `M_n k = (K_n k)ᵀ * (K_n k)` and
   step drift bounded by `C_mat * (r k + escapeMass)`.
Note: All bounds here are at fixed finite torus size `L`; uniform-in-`L` continuation (`V → ∞`)
is isolated cleanly in `BalabanThermodynamicContinuationGap` (`UV-X`). `[C/B/P]` -/
structure BalabanFiniteVolInductiveStep
    (L : ℕ) [NeZero L] {N : ℕ} (V : Type*)
    (M_n : ℕ → Matrix (Fin N) (Fin N) ℝ) where
  b0 : ℝ
  L_blk : ℝ
  gK2 : ℝ
  hb0 : 0 < b0
  hL_blk : 1 < L_blk
  hgK2 : 0 < gK2
  chain : Round04UVPolymer.NestedScaleResolutionChain V
  split : ℕ → T4PlaquetteSplit L
  step : ℕ → Round04UVPolymer.ViabilityCSX06ScaleStep
  poly : ℕ → Round04UVPolymer.ScalePolymerSystem
  h_refl : ∀ k (X : (poly k).Pol), (poly k).compat X X
  h_symm : ∀ k (X Y : (poly k).Pol), (poly k).compat X Y → (poly k).compat Y X
  X0 : ∀ k : ℕ, (poly k).Pol
  a_max : ℝ
  S_max : ℝ
  B_unif : ℝ
  C_esc : ℝ
  ha_max : ∀ k : ℕ, (poly k).a ≤ a_max
  hS_max : ∀ k : ℕ, (poly k).size (X0 k) ≤ S_max
  hB_unif : ∀ K : ℕ, ∑ k ∈ Finset.range K, Real.exp (-((poly k).c_lf / (poly k).g_k)) ≤ B_unif
  hC_esc : 0 ≤ C_esc
  hesc_poly : ∀ k : ℕ, (step k).escapeMass ≤
    C_esc * ∑ Y : (poly k).Pol, if (poly k).compat (X0 k) Y then |(poly k).rho Y| else 0
  kappa_irr : ℝ
  B_delta : ℝ
  hkap_nn : 0 ≤ kappa_irr
  hkap_lt : kappa_irr < 1
  r : ℕ → ℝ
  delta : ℕ → ℝ
  hr_nn : ∀ k : ℕ, 0 ≤ r k
  hr_le1 : ∀ k : ℕ, r k ≤ 1
  hdel_nn : ∀ k : ℕ, 0 ≤ delta k
  hB_delta : ∀ K : ℕ, ∑ k ∈ Finset.range K, delta k ≤ B_delta
  hmz_rec : ∀ k : ℕ, r (k + 1) ≤ kappa_irr * r k + delta k
  C_mat : ℝ
  hC_mat : 0 ≤ C_mat
  matrix_drift : ∀ k : ℕ, ∀ i j : Fin N,
    |M_n (k + 1) i j - M_n k i j| ≤ C_mat * (r k + (step k).escapeMass)
  transfer_factor : ℕ → Matrix (Fin N) (Fin N) ℝ
  transfer_eq : ∀ n : ℕ, M_n n = (transfer_factor n)ᵀ * (transfer_factor n)

/-- **Fixed-Volume Balaban UV Closure (`[C/B]`)**:
From `BalabanFiniteVolInductiveStep` alone (at fixed finite volume `L`), every scale-`k`
Peierls-suppressed Mayer cluster bound, summable `CSX-06` escape mass, summable Mori–Zwanzig
remainder, and fixed-volume `CauchySeq` Schwinger convergence close constructively without any `[X]` gap. -/
theorem balaban_finite_vol_uv_closure
    {L : ℕ} [NeZero L] {N : ℕ} {V : Type*}
    {M_n : ℕ → Matrix (Fin N) (Fin N) ℝ}
    (fin : BalabanFiniteVolInductiveStep L V M_n) :
    (∀ (k n_trunc : ℕ),
      let P_k := kpSystemOfScale (fin.poly k) (fin.h_refl k) (fin.h_symm k)
      (∑ γ₀ : (fin.poly k).Pol, if (fin.poly k).compat (fin.X0 k) γ₀ then
        |(fin.poly k).rho γ₀| *
          (∑ n ∈ Finset.range (n_trunc + 1),
            (1 / (n.factorial : ℝ)) *
              (∑ γ : Fin n → (fin.poly k).Pol,
                |ursellCoeff P_k (Fin.cons γ₀ γ)| *
                  ∏ i : Fin n,
                    (|(fin.poly k).rho (γ i)| *
                      Real.exp (((fin.poly k).c_lf / (fin.poly k).g_k) * (fin.poly k).size (γ i)))))
        else 0) ≤ (fin.poly k).a * (fin.poly k).size (fin.X0 k) *
          Real.exp (-((fin.poly k).c_lf / (fin.poly k).g_k))) ∧
    (∀ K : ℕ, ∑ k ∈ Finset.range K, (fin.step k).escapeMass ≤
      fin.C_esc * fin.a_max * fin.S_max * fin.B_unif) ∧
    (∀ K : ℕ, ∑ k ∈ Finset.range K, fin.r k ≤
      (fin.r 0 + fin.B_delta) / (1 - fin.kappa_irr)) ∧
    (∀ i j : Fin N, CauchySeq (fun k : ℕ => M_n k i j)) := by
  have hzero_drift : ∀ k : ℕ, |(0 : ℝ) - 0| ≤ fin.C_mat * (fin.r k + (fin.step k).escapeMass) := by
    intro k
    simpa using mul_nonneg fin.hC_mat
      (add_nonneg (fin.hr_nn k) (Round04UVPolymer.viability_csx06_step_retention_and_escape (fin.step k)).2.2.1)
  have hclosure_zero := Round04UVPolymer.viability_csx06_multiscale_polymer_closure
    fin.chain fin.step fin.poly fin.X0
    fin.ha_max fin.hS_max fin.hB_unif fin.hC_esc fin.hesc_poly
    fin.hkap_nn fin.hkap_lt fin.r fin.delta fin.hr_nn fin.hr_le1 fin.hdel_nn fin.hB_delta fin.hmz_rec
    fin.hC_mat (fun _ => 0) hzero_drift
  have hmz := Round04UVPolymer.decaying_mz_summable_contraction
    fin.hkap_nn fin.hkap_lt fin.r fin.delta fin.hr_nn fin.hdel_nn fin.hB_delta fin.hmz_rec
  refine ⟨fun k n_trunc => ?_, hclosure_zero.2.2.2.1, hmz.1, fun i j => ?_⟩
  · exact scalePolymer_mayer_cluster_suppression
      (fin.poly k) (fin.h_refl k) (fin.h_symm k) n_trunc (fin.X0 k)
  · have hmat := Round04UVPolymer.viability_csx06_multiscale_polymer_closure
      fin.chain fin.step fin.poly fin.X0
      fin.ha_max fin.hS_max fin.hB_unif fin.hC_esc fin.hesc_poly
      fin.hkap_nn fin.hkap_lt fin.r fin.delta fin.hr_nn fin.hr_le1 fin.hdel_nn fin.hB_delta fin.hmz_rec
      fin.hC_mat (fun k => M_n k i j) (fun k => fin.matrix_drift k i j)
    exact hmat.2.2.2.2.2.2.2.1

/-- **Thermodynamic Continuation Gap `UV-X` (`[X]`) + Orthogonal `IR-X` / `CHIRAL-X` Inputs**:
Explicitly isolates the **exact open mathematical gap (`UV-X`)** separating fixed-volume
`BalabanFiniteVolInductiveStep` from the full `V → ∞` `H2dSharpenedUVAndIRPremise`:
1. **`UV-X` Part A (Uniform-in-`V` Gribov-free covariant Hessian coercivity)**:
   a uniform coercivity floor `c_hess > 0` across all torus sizes `L` on the axial/Landau
   gauge-orthogonal subspace (`DEAD-20261124-13` compliant);
2. **`UV-X` Part B (Thermodynamic `V → ∞` continuation of shifted-KP polymer bounds & `CSX-06` escape)**:
   continuing the per-volume polymer norms `(poly k, step k)` to volume-uniform families
   `(poly_inf k, step_inf k)` with uniform `a_max, S_max, B_unif` and `(step_inf k).escapeMass` bound;
3. **`UV-X` Part C (Thermodynamic `V → ∞` covariant Schwinger matrix drift)**:
   uniform-in-`V` `a_k^4`-normalized increment bound `|M_n (k+1) i j - M_n k i j| ≤ C_mat * (r_inf k + (step_inf k).escapeMass)`;
4. Plus the orthogonal open inputs **`IR-X`** (uniform exponential clustering + `ursell4 ≤ -c0 < 0`)
   and **`CHIRAL-X`** (global anomaly coboundary vanishing). `[X]` -/
structure BalabanThermodynamicContinuationGap
    {N : ℕ} (V : Type*)
    (M_n : ℕ → Matrix (Fin N) (Fin N) ℝ)
    (C_n : ℕ → ℝ → ℝ) (C_inf : ℝ → ℝ)
    (m2_n m4_n : ℕ → ℝ) (m2_inf m4_inf : ℝ)
    {U_adm OrbitSpace : Type*}
    (π : U_adm → OrbitSpace) (Φ_anom : U_adm → ℝ) where
  /-- `[X]` (`UV-X` Part A): Uniform-in-`V` Gribov-free small-field Hessian coercivity floor. -/
  c_hess_unif : ℝ
  hc_hess_pos : 0 < c_hess_unif
  /-- `[X]` (`UV-X` Part B): Thermodynamic `V → ∞` continuation of scale polymer & `CSX-06` step data. -/
  chain_inf : Round04UVPolymer.NestedScaleResolutionChain V
  step_inf : ℕ → Round04UVPolymer.ViabilityCSX06ScaleStep
  poly_inf : ℕ → Round04UVPolymer.ScalePolymerSystem
  X0_inf : ∀ k : ℕ, (poly_inf k).Pol
  a_max_inf : ℝ
  S_max_inf : ℝ
  B_unif_inf : ℝ
  C_esc_inf : ℝ
  ha_max_inf : ∀ k : ℕ, (poly_inf k).a ≤ a_max_inf
  hS_max_inf : ∀ k : ℕ, (poly_inf k).size (X0_inf k) ≤ S_max_inf
  hB_unif_inf : ∀ K : ℕ, ∑ k ∈ Finset.range K, Real.exp (-((poly_inf k).c_lf / (poly_inf k).g_k)) ≤ B_unif_inf
  hC_esc_inf : 0 ≤ C_esc_inf
  hesc_poly_inf : ∀ k : ℕ, (step_inf k).escapeMass ≤
    C_esc_inf * ∑ Y : (poly_inf k).Pol, if (poly_inf k).compat (X0_inf k) Y then |(poly_inf k).rho Y| else 0
  /-- `[X]` (`UV-X` Part B'): Uniform-in-`V` small-field irrelevant / Mori–Zwanzig contraction. -/
  kappa_irr_inf : ℝ
  B_delta_inf : ℝ
  hkap_nn_inf : 0 ≤ kappa_irr_inf
  hkap_lt_inf : kappa_irr_inf < 1
  r_inf : ℕ → ℝ
  delta_inf : ℕ → ℝ
  hr_nn_inf : ∀ k : ℕ, 0 ≤ r_inf k
  hr_le1_inf : ∀ k : ℕ, r_inf k ≤ 1
  hdel_nn_inf : ∀ k : ℕ, 0 ≤ delta_inf k
  hB_delta_inf : ∀ K : ℕ, ∑ k ∈ Finset.range K, delta_inf k ≤ B_delta_inf
  hmz_rec_inf : ∀ k : ℕ, r_inf (k + 1) ≤ kappa_irr_inf * r_inf k + delta_inf k
  /-- `[X]` (`UV-X` Part C): Uniform-in-`V` `a_k^4`-normalized Schwinger drift & transfer positivity. -/
  C_mat_inf : ℝ
  hC_mat_inf : 0 ≤ C_mat_inf
  matrix_drift_inf : ∀ k : ℕ, ∀ i j : Fin N,
    |M_n (k + 1) i j - M_n k i j| ≤ C_mat_inf * (r_inf k + (step_inf k).escapeMass)
  transfer_factor_inf : ℕ → Matrix (Fin N) (Fin N) ℝ
  transfer_eq_inf : ∀ n : ℕ, M_n n = (transfer_factor_inf n)ᵀ * (transfer_factor_inf n)
  /-- `[X]` (`IR-X`): Uniform clustering & non-Gaussian 4-point Ursell bound. -/
  Delta_phys : ℝ
  A_cluster : ℝ
  Delta_phys_pos : 0 < Delta_phys
  A_cluster_nonneg : 0 ≤ A_cluster
  uniform_clustering : ∀ n : ℕ, ∀ dist : ℝ, 0 ≤ dist →
    |C_n n dist| ≤ A_cluster * Real.exp (-Delta_phys * dist)
  cluster_tendsto : ∀ dist : ℝ,
    Filter.Tendsto (fun n : ℕ => C_n n dist) Filter.atTop (nhds (C_inf dist))
  c0_ursell : ℝ
  c0_pos : 0 < c0_ursell
  m2_tendsto : Filter.Tendsto m2_n Filter.atTop (nhds m2_inf)
  m4_tendsto : Filter.Tendsto m4_n Filter.atTop (nhds m4_inf)
  uniform_ursell : ∀ n : ℕ, ursell4 (m2_n n) (m4_n n) ≤ -c0_ursell
  /-- `[X]` (`CHIRAL-X`): Global anomaly/holonomy chiral coboundary vanishing. -/
  global_chiral_coboundary_zero : ∀ u u' : U_adm, π u = π u' → Φ_anom u' - Φ_anom u = 0

/-- **Round 05 `UV-X` Finite-to-Infinite Bridge (`[C/B/P/X]`)**:
Pairs the constructive finite-`V` closure (`BalabanFiniteVolInductiveStep`) with the isolated
`V → ∞` continuation gap (`BalabanThermodynamicContinuationGap`) to instantiate
`H2dSharpenedUVAndIRPremise` and derive the unique continuum OS reflection-positive measure,
GNS Hilbert space, and subsequential uniqueness via `multiscale_cauchy_to_unique_os_continuum_measure`,
while keeping `H2d` honestly `.OPEN`. `[C/B/P/X]` -/
theorem round05_uvx_finite_to_infinite_bridge
    {L : ℕ} [NeZero L] {N : ℕ} {V U_adm OrbitSpace : Type*}
    {M_n_fin : ℕ → Matrix (Fin N) (Fin N) ℝ}
    (fin : BalabanFiniteVolInductiveStep L V M_n_fin)
    (M_n_inf : ℕ → Matrix (Fin N) (Fin N) ℝ)
    (C_n : ℕ → ℝ → ℝ) (C_inf : ℝ → ℝ)
    (m2_n m4_n : ℕ → ℝ) (m2_inf m4_inf : ℝ)
    (π : U_adm → OrbitSpace) (hπ : Function.Surjective π)
    (W_inv : OrbitSpace → ℂ) (Φ_anom : U_adm → ℝ)
    (gap : BalabanThermodynamicContinuationGap V M_n_inf C_n C_inf m2_n m4_n m2_inf m4_inf π Φ_anom) :
    let hS : Round04UVPolymer.H2dSharpenedUVAndIRPremise V M_n_inf C_n C_inf m2_n m4_n m2_inf m4_inf π Φ_anom :=
      { transfer_factor := gap.transfer_factor_inf
        transfer_eq := gap.transfer_eq_inf
        chain := gap.chain_inf
