      have hsq : T ^ q * T ^ q = (T ^ q)ᵀ * T ^ q := by rw [hsymq]
      rw [hsq, dotProduct_transpose_mul_self']
      exact dotProduct_self_nonneg' ((T ^ q).mulVec v)
    have hTblk_psd : ∀ w : Fin N_blk → ℝ, 0 ≤ dotProduct w (T_blk.mulVec w) := by
      intro w
      dsimp [T_blk]
      rw [Matrix.mul_assoc, ← Matrix.mulVec_mulVec, dotProduct_mulVec, Matrix.vecMul_transpose,
