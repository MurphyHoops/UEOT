    exact ⟨hScale, htend_beta⟩
  have hb2 : ∀ m : ℕ,
      let m_lat := m_blk m / (L_blk : ℝ) ^ (K_seq m)
      let m_phys := m_lat / a_lat (β_seq m)
      0 < a_lat (β_seq m) ∧
      m_0 * a_lat (β_seq m) ≤ m_lat ∧
      m_0 ≤ m_phys ∧
      (m_blk m = m_0 * ell_phys → m_lat = m_0 * a_lat (β_seq m) ∧ m_phys = m_0) := by
    intro m
    dsimp only
    have ha_m_pos : 0 < a_lat (β_seq m) := ha_pos (β_seq m)
    have hLK_pos : 0 < (L_blk : ℝ) ^ (K_seq m) := pow_pos hLblk_pos (K_seq m)
    have hscale_m : ell_phys = (L_blk : ℝ) ^ (K_seq m) * a_lat (β_seq m) := hScale_seq m
    have ha_m_eq : a_lat (β_seq m) = ell_phys / (L_blk : ℝ) ^ (K_seq m) :=
      (eq_div_iff (ne_of_gt hLK_pos)).mpr (by linarith [hscale_m])
    have hlat_lb : m_0 * a_lat (β_seq m) ≤ m_blk m / (L_blk : ℝ) ^ (K_seq m) := by
      calc m_0 * a_lat (β_seq m)
          = (m_0 * ell_phys) / (L_blk : ℝ) ^ (K_seq m) := by rw [ha_m_eq]; ring
        _ ≤ m_blk m / (L_blk : ℝ) ^ (K_seq m) :=
          div_le_div_of_nonneg_right (hm_blk_lb m) (le_of_lt hLK_pos)
    have hphys_lb : m_0 ≤ (m_blk m / (L_blk : ℝ) ^ (K_seq m)) / a_lat (β_seq m) := by
      rw [le_div_iff₀ ha_m_pos]
      exact hlat_lb
    have hsat : m_blk m = m_0 * ell_phys →
        m_blk m / (L_blk : ℝ) ^ (K_seq m) = m_0 * a_lat (β_seq m) ∧
        (m_blk m / (L_blk : ℝ) ^ (K_seq m)) / a_lat (β_seq m) = m_0 := by
      intro hmsat
      have hlat_eq : m_blk m / (L_blk : ℝ) ^ (K_seq m) = m_0 * a_lat (β_seq m) := by
        rw [hmsat, hscale_m]
        field_simp [ne_of_gt hLK_pos]
      have hphys_eq : (m_blk m / (L_blk : ℝ) ^ (K_seq m)) / a_lat (β_seq m) = m_0 := by
        rw [hlat_eq]
        field_simp [ne_of_gt ha_m_pos]
      exact ⟨hlat_eq, hphys_eq⟩
    exact ⟨ha_m_pos, hlat_lb, hphys_lb, hsat⟩
  have hUnifCluster : ∀ ψ : V_test, ∃ C_ψ : ℝ, 0 ≤ C_ψ ∧
      ∀ (m : ℕ) (t : ℝ), 0 ≤ t → |S_m m ψ t| ≤ C_ψ * Real.exp (-m_0 * t) := by
    intro ψ
    obtain ⟨C_ψ, hCψ_nn, hCψ⟩ := hBlkCluster ψ
    refine ⟨C_ψ, hCψ_nn, fun m t ht => ?_⟩
    have hm_b2 := hb2 m
    have hm_phys_lb : m_0 ≤ (m_blk m / (L_blk : ℝ) ^ (K_seq m)) / a_lat (β_seq m) := hm_b2.2.2.1
    have hexp_arg_eq : -(m_blk m / (L_blk : ℝ) ^ (K_seq m)) * (t / a_lat (β_seq m)) =
        -((m_blk m / (L_blk : ℝ) ^ (K_seq m)) / a_lat (β_seq m)) * t := by ring
    have hexp_le : Real.exp (-(m_blk m / (L_blk : ℝ) ^ (K_seq m)) * (t / a_lat (β_seq m))) ≤
        Real.exp (-m_0 * t) := by
      rw [hexp_arg_eq]
      apply Real.exp_le_exp.mpr
      nlinarith
    exact le_trans (hCψ m t ht) (mul_le_mul_of_nonneg_left hexp_le hCψ_nn)
  have hcont := conditional_continuum_os_mass_gap_persistence
    q_GNS hq inner_perp hSymm_in hAdd_in hSmul_in hInner_nn
    S_m S_inf hTightWeak hOS_RP_m U hGNS_id hU_zero hU_add hU_symm
    hm0 hUnifCluster H_op hGen
  exact ⟨ha1, ha2, hb1, hb2, hcont⟩

/-- Concrete non-vacuous witness for `physical_scale_rg_blocking_os_gap_transfer`
with `L_blk = 2`, `c_AF = 1`, `Λ = 1`, `ell_phys = 1`, `m_0 = 1`, non-PSD symmetric
`2 × 2` UV kernel `T = diag(1, -1)` whose even-block `T^(2^K)` (`K ≥ 1`) and spatial
projection `P_sp` become strictly PSD, and `ℝ × ℝ` continuum OS mass-gap transfer. `[C/B/P/X]` -/
theorem physical_scale_rg_blocking_concrete_witness :
    let T : Matrix (Fin 2) (Fin 2) ℝ := !![(1 : ℝ), 0; 0, (-1 : ℝ)]
    let P_sp : Matrix (Fin 2) (Fin 1) ℝ := !![(1 : ℝ); (1 : ℝ)]
    let a_lat : ℝ → ℝ := fun β => Real.exp (-β)
    let β_seq : ℕ → ℝ := fun K => Real.log ((2 : ℝ) ^ K)
    (∀ K : ℕ, 1 ≤ K →
      let T_blk : Matrix (Fin 1) (Fin 1) ℝ := P_spᵀ * T ^ (2 ^ K) * P_sp
      T_blkᵀ = T_blk ∧ ∀ w : Fin 1 → ℝ, 0 ≤ dotProduct w (T_blk.mulVec w)) ∧
    (∀ K : ℕ, (2 : ℝ) ^ K * a_lat (β_seq K) = 1) ∧
    Filter.Tendsto β_seq Filter.atTop Filter.atTop ∧
    (∀ (u : ℝ × ℝ) (t : ℝ), 0 ≤ t →
      (u.1 * (Real.exp (-t) * u.1) + u.2 * (Real.exp (-2 * t) * u.2)) ≤
        (u.1 * u.1 + u.2 * u.2) * Real.exp (-(1 : ℝ) * t)) := by
  intro T P_sp a_lat β_seq
  let inner_r2 : (ℝ × ℝ) → (ℝ × ℝ) → ℝ := fun u v => u.1 * v.1 + u.2 * v.2
  let U : ℝ → (ℝ × ℝ) → (ℝ × ℝ) := fun t u => (Real.exp (-t) * u.1, Real.exp (-2 * t) * u.2)
  let H_op : (ℝ × ℝ) → (ℝ × ℝ) := fun u => (u.1, 2 * u.2)
  let S_m : ℕ → (ℝ × ℝ) → ℝ → ℝ := fun m ψ t => (1 + (1 / 2 : ℝ) ^ (m + 1)) * inner_r2 ψ (U t ψ)
  let S_inf : (ℝ × ℝ) → ℝ → ℝ := fun ψ t => inner_r2 ψ (U t ψ)
  have hT_symm : Tᵀ = T := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [T]
  have ha_def : ∀ β : ℝ, a_lat β * 1 = Real.exp (-1 * β) := by
    intro β; simp [a_lat]
  have hScale_seq : ∀ K : ℕ, (1 : ℝ) = (2 : ℝ) ^ K * a_lat (β_seq K) := by
    intro K
    dsimp [a_lat, β_seq]
    rw [Real.exp_neg, Real.exp_log (pow_pos (by norm_num) K)]
    field_simp
  have hTight : ∀ (ψ : ℝ × ℝ) (t : ℝ), 0 ≤ t →
      Filter.Tendsto (fun m : ℕ => S_m m ψ t) Filter.atTop (nhds (S_inf ψ t)) := by
    intro ψ t _
    have hpow : Filter.Tendsto (fun m : ℕ => (1 / 2 : ℝ) ^ (m + 1)) Filter.atTop (nhds 0) :=
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).comp
        (Filter.tendsto_add_atTop_nat 1)
    have hlim := ((tendsto_const_nhds (x := (1 : ℝ))).add hpow).mul_const (inner_r2 ψ (U t ψ))
    simpa [S_m, S_inf] using hlim
  have hOS : ∀ (m : ℕ) (ψ : ℝ × ℝ), 0 ≤ S_m m ψ 0 := by
    intro m ψ
    dsimp [S_m, U, inner_r2]
    have h1 : 0 ≤ (1 + (1 / 2 : ℝ) ^ (m + 1)) := by positivity
    have h2 : 0 ≤ ψ.1 * (Real.exp (-0) * ψ.1) + ψ.2 * (Real.exp (-2 * 0) * ψ.2) := by
      simp [add_nonneg, mul_self_nonneg]
    exact mul_nonneg h1 h2
  have hBlkCluster : ∀ ψ : ℝ × ℝ, ∃ C_ψ : ℝ, 0 ≤ C_ψ ∧
      ∀ (m : ℕ) (t : ℝ), 0 ≤ t →
        |S_m m ψ t| ≤ C_ψ * Real.exp (-((1 : ℝ) / (2 : ℝ) ^ m) * (t / a_lat (β_seq m))) := by
    intro ψ
    refine ⟨2 * inner_r2 ψ ψ, by dsimp [inner_r2]; nlinarith, fun m t ht => ?_⟩
    have hcoeff : 0 ≤ 1 + (1 / 2 : ℝ) ^ (m + 1) ∧ 1 + (1 / 2 : ℝ) ^ (m + 1) ≤ 2 := by
      refine ⟨by positivity, ?_⟩
      have hle : (1 / 2 : ℝ) ^ (m + 1) ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
      linarith
    have he2_le : Real.exp (-2 * t) ≤ Real.exp (-1 * t) :=
      Real.exp_le_exp.mpr (by linarith)
    have hinn_nn : 0 ≤ inner_r2 ψ (U t ψ) := by
      dsimp [inner_r2, U]
      have h1 : ψ.1 * (Real.exp (-t) * ψ.1) = Real.exp (-t) * (ψ.1 * ψ.1) := by ring
      have h2 : ψ.2 * (Real.exp (-2 * t) * ψ.2) = Real.exp (-2 * t) * (ψ.2 * ψ.2) := by ring
      rw [h1, h2]
      exact add_nonneg
        (mul_nonneg (le_of_lt (Real.exp_pos (-t))) (mul_self_nonneg ψ.1))
        (mul_nonneg (le_of_lt (Real.exp_pos (-2 * t))) (mul_self_nonneg ψ.2))
    have hinn_le : inner_r2 ψ (U t ψ) ≤ inner_r2 ψ ψ * Real.exp (-1 * t) := by
      dsimp [inner_r2, U]
      have h1 : ψ.1 * (Real.exp (-t) * ψ.1) = ψ.1 * ψ.1 * Real.exp (-1 * t) := by
        rw [neg_one_mul]; ring
      have h2 : ψ.2 * (Real.exp (-2 * t) * ψ.2) ≤ ψ.2 * ψ.2 * Real.exp (-1 * t) := by
        calc ψ.2 * (Real.exp (-2 * t) * ψ.2) = (ψ.2 * ψ.2) * Real.exp (-2 * t) := by ring
          _ ≤ (ψ.2 * ψ.2) * Real.exp (-1 * t) := mul_le_mul_of_nonneg_left he2_le (mul_self_nonneg _)
      linarith
    have hrate_eq : -((1 : ℝ) / (2 : ℝ) ^ m) * (t / a_lat (β_seq m)) = -1 * t := by
      have hs := (hScale_seq m).symm
      have ha_pos : 0 < a_lat (β_seq m) := by dsimp [a_lat]; exact Real.exp_pos _
      have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m := by positivity
      calc -((1 : ℝ) / (2 : ℝ) ^ m) * (t / a_lat (β_seq m))
          = -t / ((2 : ℝ) ^ m * a_lat (β_seq m)) := by ring
        _ = -t / 1 := by rw [← hs]
        _ = -1 * t := by ring
    dsimp [S_m]
    rw [abs_of_nonneg (mul_nonneg hcoeff.1 hinn_nn), hrate_eq]
    calc (1 + (1 / 2 : ℝ) ^ (m + 1)) * inner_r2 ψ (U t ψ)
        ≤ 2 * inner_r2 ψ (U t ψ) := mul_le_mul_of_nonneg_right hcoeff.2 hinn_nn
      _ ≤ 2 * (inner_r2 ψ ψ * Real.exp (-1 * t)) := mul_le_mul_of_nonneg_left hinn_le (by norm_num)
      _ = (2 * inner_r2 ψ ψ) * Real.exp (-1 * t) := by ring
  have hGen : ∀ u : ℝ × ℝ,
      Filter.Tendsto (fun t : ℝ => (inner_r2 u u - inner_r2 u (U t u)) / t)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (inner_r2 u (H_op u))) := by
    intro u
    have hd1 : HasDerivAt (fun t : ℝ => Real.exp (-t)) (-1) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).neg).exp
    have hd2 : HasDerivAt (fun t : ℝ => Real.exp (-2 * t)) (-2) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).const_mul (-2)).exp
    have hs1 : Filter.Tendsto (fun t : ℝ => (1 - Real.exp (-t)) / t)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 1) := by
      have h0 : Filter.Tendsto (fun t : ℝ => (Real.exp (-t) - 1) / t)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (-1)) := by
        convert (hd1.tendsto_slope_zero).mono_left
          (nhdsWithin_mono (0 : ℝ) (fun t ht => ne_of_gt ht)) using 1
        · funext t; simp [div_eq_inv_mul]
        · rfl
      have hneg := h0.neg
      have hfun : (fun t : ℝ => -((Real.exp (-t) - 1) / t)) =
          fun t : ℝ => (1 - Real.exp (-t)) / t := by funext t; ring
      rw [hfun] at hneg; simpa using hneg
    have hs2 : Filter.Tendsto (fun t : ℝ => (1 - Real.exp (-2 * t)) / t)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 2) := by
      have h0 : Filter.Tendsto (fun t : ℝ => (Real.exp (-2 * t) - 1) / t)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (-2)) := by
        convert (hd2.tendsto_slope_zero).mono_left
          (nhdsWithin_mono (0 : ℝ) (fun t ht => ne_of_gt ht)) using 1
        · funext t; simp [div_eq_inv_mul]
        · rfl
      have hneg := h0.neg
      have hfun : (fun t : ℝ => -((Real.exp (-2 * t) - 1) / t)) =
          fun t : ℝ => (1 - Real.exp (-2 * t)) / t := by funext t; ring
      rw [hfun] at hneg; simpa using hneg
    have hfun_eq : (fun t : ℝ => (inner_r2 u u - inner_r2 u (U t u)) / t) =
        fun t : ℝ => (u.1 * u.1) * ((1 - Real.exp (-t)) / t) + (u.2 * u.2) * ((1 - Real.exp (-2 * t)) / t) := by
      funext t; dsimp [inner_r2, U]; ring
    rw [hfun_eq]
    have hsum := (hs1.const_mul (u.1 * u.1)).add (hs2.const_mul (u.2 * u.2))
    have hlim_eq : (u.1 * u.1) * 1 + (u.2 * u.2) * 2 = inner_r2 u (H_op u) := by
      dsimp [inner_r2, H_op]; ring
    rwa [hlim_eq] at hsum
  have hmain := physical_scale_rg_blocking_os_gap_transfer
    (Lambda := 1) (c_AF := 1) (ell_phys := 1) (m_0 := 1) (L_blk := 2)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (le_refl 2)
    a_lat ha_def T hT_symm P_sp
    (id : ℝ → ℝ) (fun x y => x * y) (fun f => mul_self_nonneg f)
    (id : ℝ → ℝ) (fun x y => x * y) id (fun _ => rfl) (fun _ _ => rfl)
    β_seq (fun m => m) hScale_seq (fun _ => 1) (fun _ => by norm_num)
    (id : (ℝ × ℝ) → (ℝ × ℝ)) surjective_id inner_r2
    (fun u v => by dsimp [inner_r2]; ring)
    (fun u v w => by dsimp [inner_r2]; ring)
    (fun a u v => by dsimp [inner_r2]; ring)
    (fun u => by dsimp [inner_r2]; nlinarith)
    S_m S_inf hTight hOS U (fun _ _ _ => rfl)
    (fun u => by dsimp [U]; ext <;> simp)
    (fun s t _ _ u => by
      dsimp [U]; ext
      · have harg : -(s + t) = -s + -t := by ring
        rw [harg, Real.exp_add, mul_assoc]
      · have harg : -2 * (s + t) = -2 * s + -2 * t := by ring
        rw [harg, Real.exp_add, mul_assoc])
    (fun t _ u v => by dsimp [inner_r2, U]; ring)
    hBlkCluster H_op hGen
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro K hK
    have hev : Even (2 ^ K) := by
      rcases Nat.exists_eq_succ_of_ne_zero (by omega : K ≠ 0) with ⟨k, rfl⟩
      rw [pow_succ']
      exact ⟨2 ^ k, by ring⟩
    have hK_res := hmain.1 K hev
    exact ⟨hK_res.1, hK_res.2.1⟩
  · intro K
    simpa [β_seq] using hmain.2.2.1.1 K
  · simpa [β_seq] using hmain.2.2.1.2
  · exact hmain.2.2.2.2.2.2.1


