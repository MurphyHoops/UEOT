  have ha1 : ∀ K : ℕ, Even (L_blk ^ K) →
      let T_blk : Matrix (Fin N_blk) (Fin N_blk) ℝ := P_spᵀ * T ^ (L_blk ^ K) * P_sp
      T_blkᵀ = T_blk ∧
      (∀ w : Fin N_blk → ℝ, 0 ≤ dotProduct w (T_blk.mulVec w)) ∧
      (∀ m : ℕ, ∀ w : Fin N_blk → ℝ, 0 ≤ dotProduct w ((T_blk ^ m).mulVec w)) := by
