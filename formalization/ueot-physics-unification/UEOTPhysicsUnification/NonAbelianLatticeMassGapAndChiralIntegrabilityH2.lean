  have hdwf_supp := dwf_l5_exponential_mirror_suppression hm (by positivity : (0 : ℝ) < max C_DW 1) hCDW (half_pos hΔ)
  have htend_ov : Filter.Tendsto (dwfTransferOverlap C_DW m_DW) Filter.atTop (nhds 0) := by
    have hκ_pos : 0 < Real.exp (-m_DW) := Real.exp_pos _
    have hκ_lt : Real.exp (-m_DW) < 1 := Real.exp_lt_one_iff.mpr (neg_lt_zero.mpr hm)
