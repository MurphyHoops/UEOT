/-- Exact telescoping bound on `∑ j ∈ Finset.Ico p q, 1 / (j + 1)^2 ≤ 1 / p` for `1 ≤ p ≤ q`. `[C/B]` -/
lemma sum_inv_sq_Ico_le (p q : ℕ) (hp : 1 ≤ p) (hpq : p ≤ q) :
    ∑ j ∈ Finset.Ico p q, ((1 : ℝ) / ((j : ℝ) + 1) ^ 2) ≤ 1 / (p : ℝ) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hpq
  have hrec : ∀ m : ℕ,
      ∑ j ∈ Finset.Ico p (p + m), ((1 : ℝ) / ((j : ℝ) + 1) ^ 2) ≤
        1 / (p : ℝ) - 1 / ((p : ℝ) + (m : ℝ)) := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [← add_assoc, Finset.sum_Ico_succ_top (Nat.le_add_right p m)]
      have hm_pos : (0 : ℝ) < (p : ℝ) + (m : ℝ) := by
        have : (1 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
        positivity
      have hm1_pos : (0 : ℝ) < (p : ℝ) + (m : ℝ) + 1 := by positivity
      have hdiff : (1 : ℝ) / (((p + m : ℕ) : ℝ) + 1) ^ 2 ≤
          1 / ((p : ℝ) + (m : ℝ)) - 1 / ((p : ℝ) + ((m + 1 : ℕ) : ℝ)) := by
        have hid : 1 / ((p : ℝ) + (m : ℝ)) - 1 / ((p : ℝ) + ((m + 1 : ℕ) : ℝ)) =
            1 / (((p : ℝ) + (m : ℝ)) * ((p : ℝ) + (m : ℝ) + 1)) := by
          have hcast : (p : ℝ) + ((m + 1 : ℕ) : ℝ) = (p : ℝ) + (m : ℝ) + 1 := by
            push_cast; ring
          rw [hcast]
          field_simp [ne_of_gt hm_pos, ne_of_gt hm1_pos]
          ring
        have hcast2 : (((p + m : ℕ) : ℝ) + 1) = (p : ℝ) + (m : ℝ) + 1 := by
          push_cast; ring
        rw [hid, hcast2]
        refine one_div_le_one_div_of_le (by positivity) ?_
        nlinarith
      linarith
  have hnonneg : (0 : ℝ) ≤ 1 / ((p : ℝ) + (k : ℝ)) := by positivity
  linarith [hrec k]

/-- Exact sum bound `∑ j : Fin K, 1 / (j + 1)^2 ≤ 2`. `[C/B]` -/
lemma sum_inv_sq_succ_le_two (K : ℕ) :
    ∑ j : Fin K, ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2) ≤ 2 := by
  cases K with
  | zero => simp
  | succ n =>
    rw [Fin.sum_univ_eq_sum_range (fun j : ℕ => (1 : ℝ) / ((j : ℝ) + 1) ^ 2) (n + 1),
      Finset.range_eq_Ico]
    have hsplit : Finset.Ico 0 (n + 1) = insert 0 (Finset.Ico 1 (n + 1)) := by
      ext x
      simp only [Finset.mem_Ico, Finset.mem_insert]
      omega
    rw [hsplit, Finset.sum_insert (by simp)]
    have htail := sum_inv_sq_Ico_le 1 (n + 1) (le_refl 1) (by omega)
    norm_num at htail ⊢
    linarith

/-- **Telescoping Vacuum Counterterm Cancellation & `16^j`-Free Normalized Schwinger Convergence (`C/B/P`)**:
Resolves the unsubtracted vacuum energy divergence `a_K^{-4} → +∞` (`DEAD-20261124-10` item 2)
without tautological subtraction or extensive `16^j g_j^4` blowup:
1. Scale-by-scale field-independent vacuum counterterm `E_vac(K) = ∑_{j<K} ΔE_j` telescopes
   (`E_vac(K+1) - E_vac(K) = ΔE_K`) and diverges quartically (`E_vac(K) → +∞` as `a_K^{-4}`).
2. In normalized Schwinger ratios `O_norm(K) := S_bare(K) / Z_bare(K)` (and under any finite local
   scheme shift `C_shift(K)`), `exp(-E_vac(K))` cancels identically, leaving `S_ren(K) / Z_ren(K)`.
3. After extensive `exp(-E_vac(K))` cancellation, the normalized connected observable increment
   `δO_ren(j) := S_ren(j+1)/Z_ren(j+1) - S_ren(j)/Z_ren(j)` is `16^j`-free; whenever
   `|δO_ren(j)| ≤ C_ren g_j^4 + C_lf exp(-c_lf / g_j)`, telescoping `O_norm(K) - O_norm(0) = ∑_{j<K} δO_ren(j)`
   is uniformly bounded by `2 * B_tot` (via `∑ g_j^4 ≤ 2/m²` and `∑ 1/(j+1)^2 ≤ 2`), forms a
   `CauchySeq`, and converges to `O_inf` at rate `|O_inf - O_norm(K)| ≤ B_tot / K`.
(Applied to 4D non-Abelian YM, the factorization `hfactor_Z/S` and `16^j`-free bound `hdO_bound` are `[X]`.) -/
theorem telescoping_vacuum_counterterm_cancellation
    {b0 L_blk gK2 C_ren C_lf c_lf L_phys a0 e0 : ℝ}
    (hb0 : 0 < b0) (hL : 1 < L_blk) (hgK : 0 < gK2)
    (hCren : 0 ≤ C_ren) (hClf : 0 ≤ C_lf) (hclf : 0 < c_lf)
    (hLphys : 0 < L_phys) (ha0 : 0 < a0) (he0 : 0 < e0)
    (DeltaE Z_bare S_bare Z_ren S_ren : ℕ → ℝ)
    (hDeltaE_lb : ∀ j : ℕ, 6 * (L_phys / (a0 * (1 / L_blk) ^ j)) ^ 4 * e0 ≤ DeltaE j)
    (hZ_ren_ne : ∀ K : ℕ, Z_ren K ≠ 0)
    (hfactor_Z : ∀ K : ℕ, Z_bare K = Real.exp (-(∑ j : Fin K, DeltaE j.1)) * Z_ren K)
    (hfactor_S : ∀ K : ℕ, S_bare K = Real.exp (-(∑ j : Fin K, DeltaE j.1)) * S_ren K)
    (hdO_bound : ∀ j : ℕ,
      |S_ren (j + 1) / Z_ren (j + 1) - S_ren j / Z_ren j| ≤
        C_ren * (runningG2 gK2 b0 L_blk j) ^ 2 +
          C_lf * Real.exp (-(c_lf / Real.sqrt (runningG2 gK2 b0 L_blk j)))) :
    let E_vac : ℕ → ℝ := fun K => ∑ j : Fin K, DeltaE j.1
    let O_norm : ℕ → ℝ := fun K => S_bare K / Z_bare K
    let dO_ren : ℕ → ℝ := fun j => S_ren (j + 1) / Z_ren (j + 1) - S_ren j / Z_ren j
    let m : ℝ := min (1 / gK2) (blockStepDelta b0 L_blk)
    let B_tot : ℝ := C_ren / m ^ 2 + C_lf * (24 / (c_lf ^ 4 * m ^ 2))
    (0 < m) ∧
    (∀ K : ℕ, E_vac (K + 1) - E_vac K = DeltaE K) ∧
    (∀ K : ℕ, Z_bare K ≠ 0) ∧
    (∀ K : ℕ, O_norm K = S_ren K / Z_ren K) ∧
    (∀ K : ℕ, O_norm K - O_norm 0 = ∑ j : Fin K, dO_ren j.1) ∧
    (∀ (C_shift : ℕ → ℝ) (K : ℕ),
      (Real.exp (-C_shift K) * S_bare K) / (Real.exp (-C_shift K) * Z_bare K) =
        S_ren K / Z_ren K) ∧
    Filter.Tendsto E_vac Filter.atTop Filter.atTop ∧
    (∀ K : ℕ, ∑ j : Fin K, (runningG2 gK2 b0 L_blk j.1) ^ 2 ≤ (1 / m ^ 2) * 2) ∧
    (∀ K : ℕ, |O_norm K - O_norm 0| ≤ 2 * B_tot) ∧
    CauchySeq O_norm ∧
    (∃ O_inf : ℝ, Filter.Tendsto O_norm Filter.atTop (nhds O_inf) ∧
      ∀ K : ℕ, 1 ≤ K → |O_inf - O_norm K| ≤ B_tot / (K : ℝ)) := by
  intro E_vac O_norm dO_ren m B_tot
  have hlogL : 0 < Real.log L_blk := Real.log_pos hL
  have hΔ_pos : 0 < blockStepDelta b0 L_blk := by
    unfold blockStepDelta; positivity
  have hm_pos : 0 < m := lt_min (one_div_pos.mpr hgK) hΔ_pos
  have hBtot_nn : 0 ≤ B_tot := by dsimp [B_tot]; positivity
  -- 1. Telescoping of vacuum counterterm E_vac
  have htel_Evac : ∀ K : ℕ, E_vac (K + 1) - E_vac K = DeltaE K := by
    intro K
    dsimp [E_vac]
    rw [Fin.sum_univ_castSucc]
    have hcongr : (∑ i : Fin K, DeltaE (i.castSucc : Fin (K + 1)).1) =
        ∑ i : Fin K, DeltaE i.1 := rfl
    rw [hcongr]
    simp
  -- 2. Schwinger ratio cancellation & telescoping of O_norm
  have hZ_bare_ne : ∀ K : ℕ, Z_bare K ≠ 0 := by
    intro K
    rw [hfactor_Z K]
    exact mul_ne_zero (ne_of_gt (Real.exp_pos _)) (hZ_ren_ne K)
  have hratio : ∀ K : ℕ, O_norm K = S_ren K / Z_ren K := by
    intro K
    dsimp [O_norm]
    rw [hfactor_S K, hfactor_Z K]
    have hexp_ne : Real.exp (-(∑ j : Fin K, DeltaE j.1)) ≠ 0 := ne_of_gt (Real.exp_pos _)
    exact mul_div_mul_left (S_ren K) (Z_ren K) hexp_ne
  have htel_O : ∀ K : ℕ, O_norm K - O_norm 0 = ∑ j : Fin K, dO_ren j.1 := by
    intro K
    induction K with
    | zero => simp
    | succ k ih =>
      rw [Fin.sum_univ_castSucc]
      have hcongr : (∑ i : Fin k, dO_ren (i.castSucc : Fin (k + 1)).1) =
          ∑ i : Fin k, dO_ren i.1 := rfl
      rw [hcongr, ← ih]
      have hstep : O_norm (k + 1) - O_norm k = dO_ren k := by
        rw [hratio (k + 1), hratio k]
      simp only [Fin.val_last]
      linarith
  have hratio_shift : ∀ (C_shift : ℕ → ℝ) (K : ℕ),
      (Real.exp (-C_shift K) * S_bare K) / (Real.exp (-C_shift K) * Z_bare K) =
        S_ren K / Z_ren K := by
    intro C_shift K
    have hexp_ne : Real.exp (-C_shift K) ≠ 0 := ne_of_gt (Real.exp_pos _)
    rw [mul_div_mul_left (S_bare K) (Z_bare K) hexp_ne, ← hratio K]
  -- 3. Unsubtracted vacuum energy divergence
  have hDeltaE_pos : ∀ j : ℕ, 0 < DeltaE j := by
    intro j
    have h1 : 0 < 6 * (L_phys / (a0 * (1 / L_blk) ^ j)) ^ 4 * e0 := by
      have : 0 < L_blk := by linarith
      positivity
    exact lt_of_lt_of_le h1 (hDeltaE_lb j)
  have hEvac_tend : Filter.Tendsto E_vac Filter.atTop Filter.atTop := by
    have hlb_fun : ∀ K : ℕ,
        (fun k : ℕ => if k = 0 then (0 : ℝ) else 6 * (L_phys / a0) ^ 4 * e0 * (L_blk ^ 4) ^ (k - 1)) K ≤
          E_vac K := by
      intro K
      cases K with
      | zero => simp [E_vac]
      | succ n =>
        simp only [Nat.succ_ne_zero, ↓reduceIte, Nat.add_sub_cancel]
        have hlast : DeltaE n ≤ E_vac (n + 1) := by
          dsimp [E_vac]
          rw [Fin.sum_univ_castSucc]
          have hsum_nn : 0 ≤ ∑ i : Fin n, DeltaE (i.castSucc : Fin (n + 1)).1 :=
            Finset.sum_nonneg (fun i _ => le_of_lt (hDeltaE_pos i.1))
          simp only [Fin.val_last]
          linarith
        have hrew : 6 * (L_phys / (a0 * (1 / L_blk) ^ n)) ^ 4 * e0 =
            6 * (L_phys / a0) ^ 4 * e0 * (L_blk ^ 4) ^ n := by
          have hL_ne : L_blk ≠ 0 := by linarith
          rw [one_div, inv_pow, div_mul_eq_div_div, div_inv_eq_mul]
          ring
        exact le_trans (le_of_eq hrew.symm) (le_trans (hDeltaE_lb n) hlast)
    have hpref : 0 < 6 * (L_phys / a0) ^ 4 * e0 := by positivity
    have hL4 : 1 < L_blk ^ 4 := one_lt_pow₀ hL (by norm_num)
    have htend_base : Filter.Tendsto (fun n : ℕ => (L_blk ^ 4) ^ n) Filter.atTop Filter.atTop :=
      tendsto_pow_atTop_atTop_of_one_lt hL4
    have htend_shift : Filter.Tendsto
        (fun k : ℕ => if k = 0 then (0 : ℝ) else 6 * (L_phys / a0) ^ 4 * e0 * (L_blk ^ 4) ^ (k - 1))
        Filter.atTop Filter.atTop := by
      rw [Filter.tendsto_atTop_atTop]
      intro b
      obtain ⟨N, hN⟩ := (Filter.tendsto_atTop_atTop.mp (htend_base.const_mul_atTop hpref)) b
      refine ⟨N + 1, fun k hk => ?_⟩
      have hk0 : k ≠ 0 := by omega
      simp only [hk0, ↓reduceIte]
      exact hN (k - 1) (by omega)
    exact Filter.tendsto_atTop_mono hlb_fun htend_shift
  -- 4. Pointwise running coupling & remainder bounds in 1/(j+1)^2
  have hinv_ge : ∀ j : ℕ, m * ((j : ℝ) + 1) ≤ runningInvG2 gK2 b0 L_blk j := by
    intro j
    dsimp [runningInvG2]
    have hm1 : m ≤ 1 / gK2 := min_le_left _ _
    have hm2 : m ≤ blockStepDelta b0 L_blk := min_le_right _ _
    have hj_nn : 0 ≤ (j : ℝ) := Nat.cast_nonneg j
    nlinarith
  have hinv_pos : ∀ j : ℕ, 0 < runningInvG2 gK2 b0 L_blk j := by
    intro j
    exact lt_of_lt_of_le (by positivity) (hinv_ge j)
  have hg2_sq_le : ∀ j : ℕ, (runningG2 gK2 b0 L_blk j) ^ 2 ≤ (1 / m ^ 2) * (1 / ((j : ℝ) + 1) ^ 2) := by
    intro j
    have hg_le : runningG2 gK2 b0 L_blk j ≤ 1 / (m * ((j : ℝ) + 1)) := by
      dsimp [runningG2]
      rw [one_div]
      exact inv_anti₀ (by positivity) (hinv_ge j)
    have hg_nn : 0 ≤ runningG2 gK2 b0 L_blk j := le_of_lt (inv_pos.mpr (hinv_pos j))
    have hsq : (runningG2 gK2 b0 L_blk j) ^ 2 ≤ (1 / (m * ((j : ℝ) + 1))) ^ 2 :=
      pow_le_pow_left₀ hg_nn hg_le 2
    have hrew : (1 / (m * ((j : ℝ) + 1))) ^ 2 = (1 / m ^ 2) * (1 / ((j : ℝ) + 1) ^ 2) := by
      have hm_ne : m ≠ 0 := ne_of_gt hm_pos
      have hj_ne : (j : ℝ) + 1 ≠ 0 := by positivity
      field_simp [hm_ne, hj_ne]
    exact hsq.trans_eq hrew
  have hexp_le : ∀ j : ℕ,
      Real.exp (-(c_lf / Real.sqrt (runningG2 gK2 b0 L_blk j))) ≤
        (24 / (c_lf ^ 4 * m ^ 2)) * (1 / ((j : ℝ) + 1) ^ 2) := by
    intro j
    set u : ℝ := runningInvG2 gK2 b0 L_blk j
    have hu_pos : 0 < u := hinv_pos j
    have hsqrt_inv : 1 / Real.sqrt (runningG2 gK2 b0 L_blk j) = Real.sqrt u := by
      dsimp [runningG2]
      rw [one_div, Real.sqrt_inv, inv_inv]
    rw [div_eq_mul_one_div, hsqrt_inv]
    set x : ℝ := c_lf * Real.sqrt u
    have hx_pos : 0 < x := mul_pos hclf (Real.sqrt_pos.mpr hu_pos)
    have hfac4 : x ^ 4 / (Nat.factorial 4 : ℝ) ≤ Real.exp x :=
      Real.pow_div_factorial_le_exp x (le_of_lt hx_pos) 4
    have h24 : (Nat.factorial 4 : ℝ) = 24 := by norm_num
    rw [h24] at hfac4
    have hexp_neg : Real.exp (-x) ≤ 24 / x ^ 4 := by
      rw [Real.exp_neg]
      have hinv := inv_anti₀ (by positivity : 0 < x ^ 4 / 24) hfac4
      simpa [one_div, inv_div] using hinv
    have hx4_ge : c_lf ^ 4 * m ^ 2 * ((j : ℝ) + 1) ^ 2 ≤ x ^ 4 := by
      have hsqrt_sq : (Real.sqrt u) ^ 4 = u ^ 2 := by
        calc (Real.sqrt u) ^ 4 = ((Real.sqrt u) ^ 2) ^ 2 := by ring
          _ = u ^ 2 := by rw [Real.sq_sqrt (le_of_lt hu_pos)]
      have hx4_eq : x ^ 4 = c_lf ^ 4 * u ^ 2 := by
        dsimp [x]; rw [mul_pow, hsqrt_sq]
      rw [hx4_eq]
      have hu2_ge : m ^ 2 * ((j : ℝ) + 1) ^ 2 ≤ u ^ 2 := by
        have hmj_nn : 0 ≤ m * ((j : ℝ) + 1) := by positivity
        calc m ^ 2 * ((j : ℝ) + 1) ^ 2 = (m * ((j : ℝ) + 1)) ^ 2 := by ring
          _ ≤ u ^ 2 := pow_le_pow_left₀ hmj_nn (hinv_ge j) 2
      nlinarith [pow_pos hclf 4]
    have hdiv_le : 24 / x ^ 4 ≤ 24 / (c_lf ^ 4 * m ^ 2 * ((j : ℝ) + 1) ^ 2) :=
      div_le_div_of_nonneg_left (by norm_num) (by positivity) hx4_ge
    have hrew : 24 / (c_lf ^ 4 * m ^ 2 * ((j : ℝ) + 1) ^ 2) =
        (24 / (c_lf ^ 4 * m ^ 2)) * (1 / ((j : ℝ) + 1) ^ 2) := by
      rw [mul_one_div, div_div]
    exact le_trans hexp_neg (hdiv_le.trans_eq hrew)
  have hdO_pt : ∀ j : ℕ, |dO_ren j| ≤ B_tot * (1 / ((j : ℝ) + 1) ^ 2) := by
    intro j
    have h1 := mul_le_mul_of_nonneg_left (hg2_sq_le j) hCren
    have h2 := mul_le_mul_of_nonneg_left (hexp_le j) hClf
    have hcomb := le_trans (hdO_bound j) (add_le_add h1 h2)
    have hrew : C_ren * ((1 / m ^ 2) * (1 / ((j : ℝ) + 1) ^ 2)) +
          C_lf * ((24 / (c_lf ^ 4 * m ^ 2)) * (1 / ((j : ℝ) + 1) ^ 2)) =
        B_tot * (1 / ((j : ℝ) + 1) ^ 2) := by
      dsimp [B_tot]; ring
    exact hcomb.trans_eq hrew
  -- 5. Uniform-in-K sums
  have hsum_g4 : ∀ K : ℕ, ∑ j : Fin K, (runningG2 gK2 b0 L_blk j.1) ^ 2 ≤ (1 / m ^ 2) * 2 := by
    intro K
    calc ∑ j : Fin K, (runningG2 gK2 b0 L_blk j.1) ^ 2
        ≤ ∑ j : Fin K, (1 / m ^ 2) * (1 / ((j.1 : ℝ) + 1) ^ 2) :=
          Finset.sum_le_sum (fun j _ => hg2_sq_le j.1)
      _ = (1 / m ^ 2) * ∑ j : Fin K, (1 / ((j.1 : ℝ) + 1) ^ 2) := by rw [← Finset.mul_sum]
      _ ≤ (1 / m ^ 2) * 2 := mul_le_mul_of_nonneg_left (sum_inv_sq_succ_le_two K) (by positivity)
  have hO_bound : ∀ K : ℕ, |O_norm K - O_norm 0| ≤ 2 * B_tot := by
    intro K
    rw [htel_O K]
    calc |∑ j : Fin K, dO_ren j.1|
        ≤ ∑ j : Fin K, |dO_ren j.1| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j : Fin K, B_tot * (1 / ((j.1 : ℝ) + 1) ^ 2) :=
          Finset.sum_le_sum (fun j _ => hdO_pt j.1)
      _ = B_tot * ∑ j : Fin K, (1 / ((j.1 : ℝ) + 1) ^ 2) := by rw [← Finset.mul_sum]
      _ ≤ B_tot * 2 := mul_le_mul_of_nonneg_left (sum_inv_sq_succ_le_two K) hBtot_nn
      _ = 2 * B_tot := by ring
  -- 6. Tail bound & CauchySeq & quantitative limit
  have htail_diff : ∀ p q : ℕ, 1 ≤ p → p ≤ q →
      |O_norm q - O_norm p| ≤ B_tot / (p : ℝ) := by
    intro p q hp hpq
    have hdiff_eq : O_norm q - O_norm p =
        (O_norm q - O_norm 0) - (O_norm p - O_norm 0) := by ring
    rw [hdiff_eq, htel_O q, htel_O p,
      Fin.sum_univ_eq_sum_range dO_ren q, Fin.sum_univ_eq_sum_range dO_ren p,
      ← Finset.sum_Ico_eq_sub _ hpq]
    calc |∑ j ∈ Finset.Ico p q, dO_ren j|
        ≤ ∑ j ∈ Finset.Ico p q, |dO_ren j| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j ∈ Finset.Ico p q, B_tot * (1 / ((j : ℝ) + 1) ^ 2) :=
          Finset.sum_le_sum (fun j _ => hdO_pt j)
      _ = B_tot * ∑ j ∈ Finset.Ico p q, (1 / ((j : ℝ) + 1) ^ 2) := by rw [← Finset.mul_sum]
      _ ≤ B_tot * (1 / (p : ℝ)) := mul_le_mul_of_nonneg_left (sum_inv_sq_Ico_le p q hp hpq) hBtot_nn
      _ = B_tot / (p : ℝ) := by ring
  have hcauchy : CauchySeq O_norm := by
    rw [Metric.cauchySeq_iff]
    intro eps heps
    obtain ⟨N0, hN0⟩ := exists_nat_one_div_lt (by positivity : 0 < eps / (B_tot + 1))
    refine ⟨N0 + 1, fun m hm n hn => ?_⟩
    have hm1 : 1 ≤ N0 + 1 := by omega
    have hB_lt : B_tot / ((N0 + 1 : ℕ) : ℝ) < eps := by
      have h1 : B_tot / ((N0 + 1 : ℕ) : ℝ) ≤ (B_tot + 1) * (1 / ((N0 : ℝ) + 1)) := by
        have hcast : ((N0 + 1 : ℕ) : ℝ) = (N0 : ℝ) + 1 := by push_cast; ring
        rw [hcast, div_eq_mul_one_div]
        exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      have h2 : (B_tot + 1) * (1 / ((N0 : ℝ) + 1)) < (B_tot + 1) * (eps / (B_tot + 1)) :=
        mul_lt_mul_of_pos_left hN0 (by positivity)
      have h3 : (B_tot + 1) * (eps / (B_tot + 1)) = eps := by
        have hne : B_tot + 1 ≠ 0 := by linarith
        field_simp [hne]
      linarith
    rcases le_total m n with hmn | hnm
    · rw [Real.dist_eq, abs_sub_comm]
      have hd := htail_diff m n (le_trans hm1 hm) hmn
      have hm_inv : B_tot / (m : ℝ) ≤ B_tot / ((N0 + 1 : ℕ) : ℝ) := by
        refine div_le_div_of_nonneg_left hBtot_nn (by positivity) ?_
        exact_mod_cast hm
      linarith
    · rw [Real.dist_eq]
      have hd := htail_diff n m (le_trans hm1 hn) hnm
      have hn_inv : B_tot / (n : ℝ) ≤ B_tot / ((N0 + 1 : ℕ) : ℝ) := by
        refine div_le_div_of_nonneg_left hBtot_nn (by positivity) ?_
        exact_mod_cast hn
      linarith
  obtain ⟨O_inf, hO_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
  have hO_rate : ∀ K : ℕ, 1 ≤ K → |O_inf - O_norm K| ≤ B_tot / (K : ℝ) := by
    intro K hK
    have hlim_abs : Filter.Tendsto (fun q : ℕ => |O_norm q - O_norm K|) Filter.atTop
        (nhds |O_inf - O_norm K|) :=
      (hO_lim.sub tendsto_const_nhds).abs
    refine le_of_tendsto hlim_abs ?_
    rw [Filter.eventually_atTop]
    exact ⟨K, fun q hKq => htail_diff K q hK hKq⟩
  exact ⟨hm_pos, htel_Evac, hZ_bare_ne, hratio, htel_O, hratio_shift, hEvac_tend, hsum_g4, hO_bound,
    hcauchy, ⟨O_inf, hO_lim, hO_rate⟩⟩

/-- Concrete `SU(3)_c` witness for `telescoping_vacuum_counterterm_cancellation`.
Here `Z_ren K = 1`, `S_ren K = 1 + ∑_{j<K} (g_j^4 + exp(-1/g_j))`, so the bare ratio
`S_bare K / Z_bare K` cancels `exp(-E_vac K)` identically (`a_K^{-4} → +∞`) and converges. `[C/B/P]` -/
theorem telescoping_vacuum_counterterm_concrete_witness :
    let b0 : ℝ := 7
    let L_blk : ℝ := 2
    let gK2 : ℝ := 1 / 50
    let m : ℝ := min (1 / gK2) (blockStepDelta b0 L_blk)
    let DeltaE : ℕ → ℝ := fun j => 6 * (1 / (1 * (1 / L_blk) ^ j)) ^ 4 * 1
    let dO_ren : ℕ → ℝ := fun j =>
      (runningG2 gK2 b0 L_blk j) ^ 2 + Real.exp (-(1 / Real.sqrt (runningG2 gK2 b0 L_blk j)))
    let E_vac : ℕ → ℝ := fun K => ∑ j : Fin K, DeltaE j.1
    let Z_bare : ℕ → ℝ := fun K => Real.exp (-E_vac K) * 1
    let S_bare : ℕ → ℝ := fun K => Real.exp (-E_vac K) * (1 + ∑ j : Fin K, dO_ren j.1)
    (∀ K : ℕ, S_bare K / Z_bare K = 1 + ∑ j : Fin K, dO_ren j.1) ∧
    Filter.Tendsto E_vac Filter.atTop Filter.atTop ∧
    (∀ K : ℕ, |S_bare K / Z_bare K - S_bare 0 / Z_bare 0| ≤ 2 * (1 / m ^ 2 + 24 / m ^ 2)) ∧
    CauchySeq (fun K => S_bare K / Z_bare K) := by
  intro b0 L_blk gK2 m DeltaE dO_ren E_vac Z_bare S_bare
  let Z_ren : ℕ → ℝ := fun _ => 1
  let S_ren : ℕ → ℝ := fun K => 1 + ∑ j : Fin K, dO_ren j.1
  have hmain := telescoping_vacuum_counterterm_cancellation
    (b0 := 7) (L_blk := 2) (gK2 := 1 / 50) (C_ren := 1) (C_lf := 1) (c_lf := 1)
    (L_phys := 1) (a0 := 1) (e0 := 1)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)
    DeltaE Z_bare S_bare Z_ren S_ren
    (fun j => le_refl _)
    (fun _ => by norm_num)
    (fun _ => rfl)
    (fun _ => rfl)
    (fun j => by
      have hstep : S_ren (j + 1) / Z_ren (j + 1) - S_ren j / Z_ren j = dO_ren j := by
        dsimp [S_ren, Z_ren]
        rw [Fin.sum_univ_castSucc]
        have hcongr : (∑ i : Fin j, dO_ren (i.castSucc : Fin (j + 1)).1) =
            ∑ i : Fin j, dO_ren i.1 := rfl
        rw [hcongr]
        simp
      rw [hstep]
      have hd_nn : 0 ≤ dO_ren j := by dsimp [dO_ren]; positivity
      rw [abs_of_nonneg hd_nn]
      dsimp [dO_ren, gK2, b0, L_blk]; norm_num)
  refine ⟨?_, hmain.2.2.2.2.2.2.1, ?_, hmain.2.2.2.2.2.2.2.2.2.1⟩
  · intro K; simpa [Z_ren, S_ren] using hmain.2.2.2.1 K
  · intro K
    have hb := hmain.2.2.2.2.2.2.2.2.1 K
    convert hb using 2
    norm_num [m]

/-- **Extensive `16^j` Site-Density Error Anti-Trap (`C/B/P`)**:
Demonstrates why subtracting only fixed-order `a_j^{-4}` counterterms while leaving an extensive
site-density remainder `c_err * |Λ_j| * g_j^4` (`|Λ_j| ~ (L_blk^4)^j`, `L_blk = 2 ⟹ 16^j`)
still diverges (`(L_blk^4)^j * g_j^4 → +∞`). Thus normalized Schwinger ratios `S_n / Z_n`
must cancel the full field-independent extensive factor `exp(-E_vac K)` and retain only
`16^j`-free connected observable increments. -/
theorem extensive_site_density_error_blowup
    {b0 L_blk gK2 c_err : ℝ}
    (hb0 : 0 < b0) (hL : 1 < L_blk) (hgK : 0 < gK2) (hc : 0 < c_err) :
    Filter.Tendsto
      (fun j : ℕ => c_err * (L_blk ^ 4) ^ j * (runningG2 gK2 b0 L_blk j) ^ 2)
      Filter.atTop Filter.atTop := by
  have hlogL : 0 < Real.log L_blk := Real.log_pos hL
  let Δ : ℝ := blockStepDelta b0 L_blk
  have hΔ_pos : 0 < Δ := by dsimp [Δ, blockStepDelta]; positivity
  let r : ℝ := L_blk ^ 4
  have hr_gt1 : 1 < r := one_lt_pow₀ hL (by norm_num)
  let δ : ℝ := r - 1
  have hδ_pos : 0 < δ := sub_pos.mpr hr_gt1
  let A : ℝ := 1 / gK2 + 2 * Δ
  let B : ℝ := 3 * Δ / δ
  let C1 : ℝ := max A B + 1
  have hA_pos : 0 < A := by positivity
  have hC1_pos : 0 < C1 := by
    have : A ≤ max A B := le_max_left _ _
    linarith
  have hlb : ∀ j : ℕ,
      (c_err / C1 ^ 2) * (1 + ((j / 3 : ℕ) : ℝ) * δ) ≤
        c_err * (L_blk ^ 4) ^ j * (runningG2 gK2 b0 L_blk j) ^ 2 := by
    intro j
    set q : ℕ := j / 3
    have hq_le : 3 * q ≤ j := Nat.mul_div_le j 3
    have hj_le : j ≤ 3 * q + 2 := by omega
    have h1_nn : 0 ≤ (1 : ℝ) + (q : ℝ) * δ := by positivity
    have hpow_q : (1 + (q : ℝ) * δ) ≤ r ^ q := by
      have h := one_add_mul_le_pow (by linarith : (-2 : ℝ) ≤ δ) q
      have hr_eq : 1 + δ = r := by dsimp [δ]; ring
      rwa [hr_eq] at h
    have hr_pow_le : (1 + (q : ℝ) * δ) ^ 3 ≤ r ^ j := by
      have h3 : (1 + (q : ℝ) * δ) ^ 3 ≤ (r ^ q) ^ 3 := pow_le_pow_left₀ h1_nn hpow_q 3
      have hq3 : (r ^ q) ^ 3 = r ^ (3 * q) := by rw [← pow_mul, mul_comm]
      have hmono : r ^ (3 * q) ≤ r ^ j := pow_le_pow_right₀ (le_of_lt hr_gt1) hq_le
      linarith
    have hinv_le : runningInvG2 gK2 b0 L_blk j ≤ C1 * (1 + (q : ℝ) * δ) := by
      have hj_real : (j : ℝ) ≤ 3 * (q : ℝ) + 2 := by exact_mod_cast hj_le
      have h1 : runningInvG2 gK2 b0 L_blk j ≤ A + 3 * Δ * (q : ℝ) := by
        dsimp [runningInvG2, A, Δ]
        nlinarith
      have hA_le : A ≤ C1 := by
        have := le_max_left A B; dsimp [C1]; linarith
      have hB_le : B ≤ C1 := by
        have := le_max_right A B; dsimp [C1]; linarith
      have h3Δ : 3 * Δ ≤ C1 * δ := by
        have hmul := mul_le_mul_of_nonneg_right hB_le (le_of_lt hδ_pos)
        have hB_eq : B * δ = 3 * Δ := by
          dsimp [B]; field_simp [ne_of_gt hδ_pos]
        linarith
      have hq_nn : 0 ≤ (q : ℝ) := Nat.cast_nonneg q
      nlinarith
    have hinv_pos : 0 < runningInvG2 gK2 b0 L_blk j := by
      dsimp [runningInvG2]; positivity
    have hg2_sq_ge : 1 / (C1 * (1 + (q : ℝ) * δ)) ^ 2 ≤ (runningG2 gK2 b0 L_blk j) ^ 2 := by
      have h1 : 1 / (C1 * (1 + (q : ℝ) * δ)) ≤ runningG2 gK2 b0 L_blk j := by
        dsimp [runningG2]; rw [one_div]; exact inv_anti₀ hinv_pos hinv_le
      rw [← _root_.one_div_pow]
      exact pow_le_pow_left₀ (by positivity) h1 2
    have hprod_ge : (1 + (q : ℝ) * δ) ^ 3 * (1 / (C1 * (1 + (q : ℝ) * δ)) ^ 2) ≤
        r ^ j * (runningG2 gK2 b0 L_blk j) ^ 2 :=
      mul_le_mul hr_pow_le hg2_sq_ge (by positivity) (by positivity)
    have hsimp : (1 + (q : ℝ) * δ) ^ 3 * (1 / (C1 * (1 + (q : ℝ) * δ)) ^ 2) =
        (1 / C1 ^ 2) * (1 + (q : ℝ) * δ) := by
      have h1ne : 1 + (q : ℝ) * δ ≠ 0 := by positivity
      have hCne : C1 ≠ 0 := ne_of_gt hC1_pos
      field_simp [h1ne, hCne]
    rw [hsimp] at hprod_ge
    have hmul_c := mul_le_mul_of_nonneg_left hprod_ge (le_of_lt hc)
    have hrewL : c_err * ((1 / C1 ^ 2) * (1 + (q : ℝ) * δ)) =
        (c_err / C1 ^ 2) * (1 + (q : ℝ) * δ) := by ring
    have hrewR : c_err * (r ^ j * (runningG2 gK2 b0 L_blk j) ^ 2) =
        c_err * (L_blk ^ 4) ^ j * (runningG2 gK2 b0 L_blk j) ^ 2 := by
      dsimp [r]; ring
    linarith
  have hdiv_tend : Filter.Tendsto (fun j : ℕ => ((j / 3 : ℕ) : ℝ)) Filter.atTop Filter.atTop := by
    rw [Filter.tendsto_atTop_atTop]
    intro b
    obtain ⟨M, hM⟩ := exists_nat_gt b
    refine ⟨3 * M, fun j hj => ?_⟩
    have hMq : M ≤ j / 3 := by omega
    have hMr : (M : ℝ) ≤ ((j / 3 : ℕ) : ℝ) := by exact_mod_cast hMq
    linarith
  have htend_rhs : Filter.Tendsto
      (fun j : ℕ => (c_err / C1 ^ 2) * (1 + ((j / 3 : ℕ) : ℝ) * δ))
      Filter.atTop Filter.atTop := by
    refine Filter.Tendsto.const_mul_atTop (by positivity) ?_
    exact tendsto_const_nhds.add_atTop (hdiv_tend.atTop_mul_const hδ_pos)
  exact Filter.tendsto_atTop_mono hlb htend_rhs

/-! ## Part 2: Discrete Combes–Thomas Exponential Decay & Schur Block Positivity (`C/B/P`) -/

/-- Row/column Schur-test bound on `|⟨x, M x⟩|` for arbitrary (possibly non-symmetric) matrices. `[C/B]` -/
lemma dotProduct_mulVec_abs_le_of_row_col_sum
    {α : Type*} [Fintype α] [DecidableEq α]
    (M : Matrix α α ℝ) {γ : ℝ} (hγ : 0 ≤ γ)
    (hrow : ∀ i : α, ∑ j : α, |M i j| ≤ γ)
    (hcol : ∀ j : α, ∑ i : α, |M i j| ≤ γ) :
    ∀ x : α → ℝ, |dotProduct x (M.mulVec x)| ≤ γ * dotProduct x x := by
  intro x
  have h1 : |dotProduct x (M.mulVec x)| ≤ ∑ i : α, ∑ j : α, |M i j| * (|x i| * |x j|) := by
    dsimp [dotProduct, Matrix.mulVec]
    calc |∑ i : α, x i * ∑ j : α, M i j * x j|
        ≤ ∑ i : α, |x i * ∑ j : α, M i j * x j| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ i : α, |x i| * |∑ j : α, M i j * x j| := by
          refine Finset.sum_congr rfl (fun i _ => abs_mul _ _)
      _ ≤ ∑ i : α, |x i| * ∑ j : α, |M i j * x j| := by
          refine Finset.sum_le_sum (fun i _ =>
            mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) (abs_nonneg _))
      _ = ∑ i : α, ∑ j : α, |M i j| * (|x i| * |x j|) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [abs_mul]; ring
  have h2 : ∑ i : α, ∑ j : α, |M i j| * (|x i| * |x j|) ≤
      ∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x i) ^ 2 + (1 / 2 : ℝ) * (x j) ^ 2) := by
    refine Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ => ?_))
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    nlinarith [sq_abs (x i), sq_abs (x j), sq_nonneg (|x i| - |x j|)]
  have hsplit : (∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x i) ^ 2 + (1 / 2 : ℝ) * (x j) ^ 2)) =
      (1 / 2 : ℝ) * ∑ i : α, (∑ j : α, |M i j|) * (x i) ^ 2 +
        (1 / 2 : ℝ) * ∑ j : α, (∑ i : α, |M i j|) * (x j) ^ 2 := by
    have hsum_add : (∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x i) ^ 2 + (1 / 2 : ℝ) * (x j) ^ 2)) =
        (∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x i) ^ 2)) +
          (∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x j) ^ 2)) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => by ring)
    rw [hsum_add]
    have hL : (∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x i) ^ 2)) =
        (1 / 2 : ℝ) * ∑ i : α, (∑ j : α, |M i j|) * (x i) ^ 2 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Finset.sum_mul]; ring
    have hR : (∑ i : α, ∑ j : α, |M i j| * ((1 / 2 : ℝ) * (x j) ^ 2)) =
        (1 / 2 : ℝ) * ∑ j : α, (∑ i : α, |M i j|) * (x j) ^ 2 := by
      rw [Finset.sum_comm, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← Finset.sum_mul]; ring
    rw [hL, hR]
  have hrow_bd : ∑ i : α, (∑ j : α, |M i j|) * (x i) ^ 2 ≤ γ * dotProduct x x := by
    calc ∑ i : α, (∑ j : α, |M i j|) * (x i) ^ 2
        ≤ ∑ i : α, γ * (x i) ^ 2 :=
          Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (hrow i) (sq_nonneg _))
      _ = γ * ∑ i : α, (x i) ^ 2 := by rw [← Finset.mul_sum]
      _ = γ * dotProduct x x := by
          dsimp [dotProduct]; congr 1
          refine Finset.sum_congr rfl (fun i _ => by ring)
  have hcol_bd : ∑ j : α, (∑ i : α, |M i j|) * (x j) ^ 2 ≤ γ * dotProduct x x := by
    calc ∑ j : α, (∑ i : α, |M i j|) * (x j) ^ 2
        ≤ ∑ j : α, γ * (x j) ^ 2 :=
          Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_right (hcol j) (sq_nonneg _))
      _ = γ * ∑ j : α, (x j) ^ 2 := by rw [← Finset.mul_sum]
      _ = γ * dotProduct x x := by
          dsimp [dotProduct]; congr 1
          refine Finset.sum_congr rfl (fun j _ => by ring)
  have hdot_nn : 0 ≤ dotProduct x x := Finset.sum_nonneg (fun i _ => mul_self_nonneg (x i))
  have _ := hγ
  linarith [h1, h2, hsplit, hrow_bd, hcol_bd]

/-- Coercive square matrix (`c ‖x‖² ≤ ⟨x, A x⟩`, `c > 0`, not necessarily symmetric) is invertible
with `‖A⁻¹ x‖₂ ≤ (1 / c) ‖x‖₂` and entrywise `|(A⁻¹) i j| ≤ 1 / c`. `[C/B]` -/
lemma coercive_matrix_inv_and_entry_bound
    {α : Type*} [Fintype α] [DecidableEq α]
    (A : Matrix α α ℝ) {c : ℝ} (hc : 0 < c)
    (hcoerc : ∀ x : α → ℝ, c * dotProduct x x ≤ dotProduct x (A.mulVec x)) :
    (∀ x : α → ℝ, A.mulVec x = 0 → x = 0) ∧
    IsUnit A.det ∧
    (A * A⁻¹ = 1 ∧ A⁻¹ * A = 1) ∧
    (∀ x : α → ℝ, dotProduct (A⁻¹.mulVec x) (A⁻¹.mulVec x) ≤ (1 / c) ^ 2 * dotProduct x x) ∧
    (∀ i j : α, |(A⁻¹) i j| ≤ 1 / c) := by
  have hinj : ∀ x : α → ℝ, A.mulVec x = 0 → x = 0 := by
    intro x hx
    have h0 := hcoerc x
    rw [hx, dotProduct_zero] at h0
    have hxx_nn : 0 ≤ dotProduct x x := Finset.sum_nonneg (fun i _ => mul_self_nonneg (x i))
    have hxx_0 : dotProduct x x = 0 := by nlinarith
    ext i
    have hsq_le : (x i) ^ 2 ≤ dotProduct x x := by
      dsimp [dotProduct]
      have hle := Finset.single_le_sum (fun k _ => mul_self_nonneg (x k)) (Finset.mem_univ i)
      simpa [sq] using hle
    have hsq0 : (x i) ^ 2 = 0 := by linarith [sq_nonneg (x i)]
    exact sq_eq_zero_iff.mp hsq0
  have hdet_ne : A.det ≠ 0 := by
    intro hdet0
    obtain ⟨v, hv_ne, hv0⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet0
    exact hv_ne (hinj v hv0)
  have hunit : IsUnit A.det := Ne.isUnit hdet_ne
  have hmulR : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hunit
  have hmulL : A⁻¹ * A = 1 := Matrix.nonsing_inv_mul A hunit
  have hL2 : ∀ x : α → ℝ, dotProduct (A⁻¹.mulVec x) (A⁻¹.mulVec x) ≤ (1 / c) ^ 2 * dotProduct x x := by
    intro x
    set y : α → ℝ := A⁻¹.mulVec x
    have hAy : A.mulVec y = x := by
      dsimp [y]
      rw [Matrix.mulVec_mulVec, hmulR, Matrix.one_mulVec]
    have h1 := hcoerc y
    rw [hAy] at h1
    have ham : dotProduct y x ≤ (c / 2) * dotProduct y y + (1 / (2 * c)) * dotProduct x x := by
      have hsum : 0 ≤ ∑ i : α, ((c / 2) * (y i) ^ 2 - y i * x i + (1 / (2 * c)) * (x i) ^ 2) := by
        refine Finset.sum_nonneg (fun i _ => ?_)
        have hsq : 0 ≤ (c * y i - x i) ^ 2 := sq_nonneg _
        have hc_ne : c ≠ 0 := ne_of_gt hc
        have hid : (c / 2) * (y i) ^ 2 - y i * x i + (1 / (2 * c)) * (x i) ^ 2 =
            (c * y i - x i) ^ 2 / (2 * c) := by
          field_simp [hc_ne]; ring
        rw [hid]
        positivity
      have hrew : ∑ i : α, ((c / 2) * (y i) ^ 2 - y i * x i + (1 / (2 * c)) * (x i) ^ 2) =
          (c / 2) * dotProduct y y - dotProduct y x + (1 / (2 * c)) * dotProduct x x := by
        dsimp [dotProduct]
        simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, ← sq]
      linarith
    have h2 : (c / 2) * dotProduct y y ≤ (1 / (2 * c)) * dotProduct x x := by linarith
    have h3 : dotProduct y y ≤ (1 / c) ^ 2 * dotProduct x x := by
      have hc_ne : c ≠ 0 := ne_of_gt hc
      have hmul := mul_le_mul_of_nonneg_left h2 (by positivity : 0 ≤ 2 / c)
      have hlhs : (2 / c) * ((c / 2) * dotProduct y y) = dotProduct y y := by
        field_simp [hc_ne]
      have hrhs : (2 / c) * ((1 / (2 * c)) * dotProduct x x) = (1 / c) ^ 2 * dotProduct x x := by
        field_simp [hc_ne]
      linarith
    exact h3
  have hentry : ∀ i j : α, |(A⁻¹) i j| ≤ 1 / c := by
    intro i j
    let ej : α → ℝ := fun k => if k = j then 1 else 0
    have hej_dot : dotProduct ej ej = 1 := by
      dsimp [dotProduct, ej]
      simp
    have hbd := hL2 ej
    rw [hej_dot, mul_one] at hbd
    have heval : (A⁻¹.mulVec ej) i = (A⁻¹) i j := by
      dsimp [Matrix.mulVec, dotProduct, ej]
      simp
    have hsq_le : ((A⁻¹) i j) ^ 2 ≤ (1 / c) ^ 2 := by
      rw [← heval]
      have hsingle : ((A⁻¹.mulVec ej) i) ^ 2 ≤ dotProduct (A⁻¹.mulVec ej) (A⁻¹.mulVec ej) := by
        dsimp [dotProduct]
        have hle := Finset.single_le_sum (fun k _ => mul_self_nonneg ((A⁻¹.mulVec ej) k))
          (Finset.mem_univ i)
        simpa [sq] using hle
      linarith
    have h1c_nn : 0 ≤ 1 / c := by positivity
    exact abs_le.mpr (abs_le_of_sq_le_sq' hsq_le h1c_nn)
  exact ⟨hinj, hunit, ⟨hmulR, hmulL⟩, hL2, hentry⟩

/-- **Gribov / Toron Zero-Mode Obstruction (`C/B`)**:
Whenever the covariant Hessian `A` admits a nontrivial zero mode `v ≠ 0` (`A.mulVec v = 0`, as on
pure gauge orbits or Gribov/toron boundaries where `m^2 = 0`), `A.det = 0`, `¬ IsUnit A.det`,
and no strictly positive coercivity constant `c > 0` can exist. Thus gauge-fixing & Gribov-horizon
restriction (`D_i ≥ m^2 > 0`) is a strict mathematical necessity (`[P/X]` in 4D non-Abelian YM). -/
theorem gribov_zero_mode_blocks_coercivity
    {α : Type*} [Fintype α] [DecidableEq α]
    (A : Matrix α α ℝ)
    (hzero : ∃ v : α → ℝ, v ≠ 0 ∧ A.mulVec v = 0) :
    A.det = 0 ∧ ¬ IsUnit A.det ∧
    (∀ c : ℝ, 0 < c → ¬ ∀ x : α → ℝ, c * dotProduct x x ≤ dotProduct x (A.mulVec x)) := by
  obtain ⟨v, hv_ne, hv0⟩ := hzero
  have hdet0 : A.det = 0 := Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv_ne, hv0⟩
  have hnot_unit : ¬ IsUnit A.det := by
    rw [hdet0]
    exact not_isUnit_zero
  have hno_coerc : ∀ c : ℝ, 0 < c →
      ¬ ∀ x : α → ℝ, c * dotProduct x x ≤ dotProduct x (A.mulVec x) := by
    intro c hc hcoerc
    have hv_eq := (coercive_matrix_inv_and_entry_bound A hc hcoerc).1 v hv0
    exact hv_ne hv_eq
  exact ⟨hdet0, hnot_unit, hno_coerc⟩

/-- **RG Block-Spin Schur Complement Positivity & Inverse-Block Identity (`C/B`)**:
For any symmetric coercive block matrix `A = fromBlocks A_CC A_CF A_FC A_FF` on `α ⊕ β`,
integrating out fine modes `β` produces the Schur complement `S = A_CC - A_CF * A_FF⁻¹ * A_FC`
which is symmetric, preserves the **exact** coercive lower bound `c`, satisfies the exact
variational quadratic identity, is invertible, and satisfies `(A⁻¹)_CC = S⁻¹`. -/
theorem schur_complement_coercivity_and_block_inverse
    {α β : Type*} [Fintype α] [Fintype β] [DecidableEq α] [DecidableEq β]
    (A_CC : Matrix α α ℝ) (A_CF : Matrix α β ℝ)
    (A_FC : Matrix β α ℝ) (A_FF : Matrix β β ℝ)
    (hCC_symm : A_CCᵀ = A_CC) (hFF_symm : A_FFᵀ = A_FF) (hCF_symm : A_CFᵀ = A_FC)
    {c : ℝ} (hc : 0 < c)
    (hcoerc : ∀ z : α ⊕ β → ℝ,
      c * dotProduct z z ≤ dotProduct z ((Matrix.fromBlocks A_CC A_CF A_FC A_FF).mulVec z)) :
    let A := Matrix.fromBlocks A_CC A_CF A_FC A_FF
    let S := A_CC - A_CF * A_FF⁻¹ * A_FC
    (∀ y : β → ℝ, c * dotProduct y y ≤ dotProduct y (A_FF.mulVec y)) ∧
    IsUnit A_FF.det ∧
    (A_FF * A_FF⁻¹ = 1 ∧ A_FF⁻¹ * A_FF = 1) ∧
    (∀ (x : α → ℝ) (y : β → ℝ),
      dotProduct (Sum.elim x y) (A.mulVec (Sum.elim x y)) =
        dotProduct x (S.mulVec x) +
          dotProduct (y - (-(A_FF⁻¹ * A_FC).mulVec x))
            (A_FF.mulVec (y - (-(A_FF⁻¹ * A_FC).mulVec x)))) ∧
    Sᵀ = S ∧
    (∀ x : α → ℝ, c * dotProduct x x ≤ dotProduct x (S.mulVec x)) ∧
    IsUnit S.det ∧
    (S * S⁻¹ = 1 ∧ S⁻¹ * S = 1) ∧
    (∀ i j : α, (A⁻¹) (Sum.inl i) (Sum.inl j) = (S⁻¹) i j) := by
  intro A S
  have hA_inv := coercive_matrix_inv_and_entry_bound A hc hcoerc
  have hFF_coerc : ∀ y : β → ℝ, c * dotProduct y y ≤ dotProduct y (A_FF.mulVec y) := by
    intro y
    have hz := hcoerc (Sum.elim 0 y)
    have hdot : dotProduct (Sum.elim (0 : α → ℝ) y) (Sum.elim (0 : α → ℝ) y) = dotProduct y y := by
      simp [dotProduct, Fintype.sum_sum_type]
    have hmul : (A.mulVec (Sum.elim (0 : α → ℝ) y)) = Sum.elim (A_CF.mulVec y) (A_FF.mulVec y) := by
      ext k
      cases k <;> simp [A, Matrix.mulVec, dotProduct, Matrix.fromBlocks, Fintype.sum_sum_type]
    have hquad : dotProduct (Sum.elim (0 : α → ℝ) y) (A.mulVec (Sum.elim (0 : α → ℝ) y)) =
        dotProduct y (A_FF.mulVec y) := by
      rw [hmul]
      simp [dotProduct, Fintype.sum_sum_type]
    rw [hdot, hquad] at hz
    exact hz
  have hFF_inv := coercive_matrix_inv_and_entry_bound A_FF hc hFF_coerc
  have hFF_inv_symm : (A_FF⁻¹)ᵀ = A_FF⁻¹ := by
    rw [Matrix.transpose_nonsing_inv, hFF_symm]
  have hvar : ∀ (x : α → ℝ) (y : β → ℝ),
      dotProduct (Sum.elim x y) (A.mulVec (Sum.elim x y)) =
        dotProduct x (S.mulVec x) +
          dotProduct (y - (-(A_FF⁻¹ * A_FC).mulVec x))
            (A_FF.mulVec (y - (-(A_FF⁻¹ * A_FC).mulVec x))) := by
    intro x y
    set y0 : β → ℝ := -(A_FF⁻¹ * A_FC).mulVec x
    have hmul_z : ∀ u : α → ℝ, ∀ v : β → ℝ,
        A.mulVec (Sum.elim u v) = Sum.elim (A_CC.mulVec u + A_CF.mulVec v) (A_FC.mulVec u + A_FF.mulVec v) := by
      intro u v
      ext k
      cases k <;> simp [A, Matrix.mulVec, dotProduct, Matrix.fromBlocks, Fintype.sum_sum_type]
    have hquad_z : ∀ u : α → ℝ, ∀ v : β → ℝ,
        dotProduct (Sum.elim u v) (A.mulVec (Sum.elim u v)) =
          dotProduct u (A_CC.mulVec u) + dotProduct u (A_CF.mulVec v) +
            dotProduct v (A_FC.mulVec u) + dotProduct v (A_FF.mulVec v) := by
      intro u v
      rw [hmul_z u v]
      simp [dotProduct, Fintype.sum_sum_type, mul_add, Finset.sum_add_distrib]
      ring
    have hsym_cross : ∀ u : α → ℝ, ∀ v : β → ℝ,
        dotProduct u (A_CF.mulVec v) = dotProduct v (A_FC.mulVec u) := by
      intro u v
      rw [dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hCF_symm]
    have hFF_y0 : A_FF.mulVec y0 = -A_FC.mulVec x := by
      dsimp [y0]
      rw [Matrix.mulVec_neg, Matrix.mulVec_mulVec, ← Matrix.mul_assoc, hFF_inv.2.2.1.1, Matrix.one_mul]
    have hS_x : S.mulVec x = A_CC.mulVec x + A_CF.mulVec y0 := by
      dsimp [S, y0]
      rw [Matrix.sub_mulVec, Matrix.mulVec_neg, Matrix.mulVec_mulVec, Matrix.mul_assoc]
      abel
    have hcross_y : dotProduct (y - y0) (A_FF.mulVec (y - y0)) =
        dotProduct y (A_FF.mulVec y) - 2 * dotProduct y (A_FF.mulVec y0) + dotProduct y0 (A_FF.mulVec y0) := by
      have hsym_FF : dotProduct y (A_FF.mulVec y0) = dotProduct y0 (A_FF.mulVec y) := by
        rw [dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hFF_symm]
      rw [Matrix.mulVec_sub, dotProduct_sub, sub_dotProduct, sub_dotProduct]
      linarith
    have hy0_FF : dotProduct y0 (A_FF.mulVec y0) = -dotProduct y0 (A_FC.mulVec x) := by
      rw [hFF_y0, dotProduct_neg]
    have hy_FF0 : dotProduct y (A_FF.mulVec y0) = -dotProduct y (A_FC.mulVec x) := by
      rw [hFF_y0, dotProduct_neg]
    have hS_dot : dotProduct x (S.mulVec x) = dotProduct x (A_CC.mulVec x) + dotProduct y0 (A_FC.mulVec x) := by
      rw [hS_x, dotProduct_add, hsym_cross x y0]
    rw [hquad_z x y, hS_dot, hcross_y, hy0_FF, hy_FF0, hsym_cross x y]
    ring
  have hS_symm : Sᵀ = S := by
    dsimp [S]
    rw [Matrix.transpose_sub, hCC_symm, Matrix.transpose_mul, Matrix.transpose_mul,
      hFF_inv_symm, hCF_symm]
    have hFC_symm : A_FCᵀ = A_CF := by rw [← hCF_symm, Matrix.transpose_transpose]
    rw [hFC_symm, Matrix.mul_assoc]
  have hS_coerc : ∀ x : α → ℝ, c * dotProduct x x ≤ dotProduct x (S.mulVec x) := by
    intro x
    set y0 : β → ℝ := -(A_FF⁻¹ * A_FC).mulVec x
    have hv := hvar x y0
    rw [sub_self, Matrix.mulVec_zero, dotProduct_zero, add_zero] at hv
    have hz := hcoerc (Sum.elim x y0)
    have hy0_nn : 0 ≤ dotProduct y0 y0 := Finset.sum_nonneg (fun j _ => mul_self_nonneg (y0 j))
    have hdot_le : dotProduct x x ≤ dotProduct (Sum.elim x y0) (Sum.elim x y0) := by
      simp [dotProduct, Fintype.sum_sum_type]
      exact hy0_nn
    have hc_le : c * dotProduct x x ≤ c * dotProduct (Sum.elim x y0) (Sum.elim x y0) :=
      mul_le_mul_of_nonneg_left hdot_le (le_of_lt hc)
    linarith
  have hS_inv := coercive_matrix_inv_and_entry_bound S hc hS_coerc
  have hblock_inv : ∀ i j : α, (A⁻¹) (Sum.inl i) (Sum.inl j) = (S⁻¹) i j := by
    intro i j
    let ej : α → ℝ := fun k => if k = j then 1 else 0
    set u : α → ℝ := S⁻¹.mulVec ej
    set v : β → ℝ := -(A_FF⁻¹ * A_FC).mulVec u
    have hAu : A.mulVec (Sum.elim u v) = Sum.elim ej 0 := by
      ext k
      cases k with
      | inl i0 =>
        have hcomp : (A.mulVec (Sum.elim u v)) (Sum.inl i0) = (S.mulVec u) i0 := by
          have h1 : (A.mulVec (Sum.elim u v)) (Sum.inl i0) =
              (A_CC.mulVec u + A_CF.mulVec v) i0 := by
            simp [A, Matrix.mulVec, dotProduct, Matrix.fromBlocks, Fintype.sum_sum_type]
          have h2 : S.mulVec u = A_CC.mulVec u + A_CF.mulVec v := by
            dsimp [S, v]
            rw [Matrix.sub_mulVec, Matrix.mulVec_neg, Matrix.mul_assoc, ← Matrix.mulVec_mulVec]
            abel
          rw [h1, h2]
        have hSu : S.mulVec u = ej := by
          dsimp [u]
          rw [Matrix.mulVec_mulVec, hS_inv.2.2.1.1, Matrix.one_mulVec]
        rw [hcomp, hSu]; rfl
      | inr j0 =>
        have hcomp : (A.mulVec (Sum.elim u v)) (Sum.inr j0) =
            (A_FC.mulVec u + A_FF.mulVec v) j0 := by
          simp [A, Matrix.mulVec, dotProduct, Matrix.fromBlocks, Fintype.sum_sum_type]
        have hFFv : A_FC.mulVec u + A_FF.mulVec v = 0 := by
          have h2 : A_FF.mulVec v = -A_FC.mulVec u := by
            dsimp [v]
            rw [Matrix.mulVec_neg, Matrix.mulVec_mulVec, ← Matrix.mul_assoc,
              hFF_inv.2.2.1.1, Matrix.one_mul]
          rw [h2]; abel
        rw [hcomp, hFFv]; rfl
    have hsol : A⁻¹.mulVec (Sum.elim ej 0) = Sum.elim u v := by
      rw [← hAu, Matrix.mulVec_mulVec, hA_inv.2.2.1.2, Matrix.one_mulVec]
    have hL := congrFun hsol (Sum.inl i)
    have hLHS : (A⁻¹.mulVec (Sum.elim ej 0)) (Sum.inl i) = (A⁻¹) (Sum.inl i) (Sum.inl j) := by
      dsimp [Matrix.mulVec, dotProduct, ej]
      simp [Fintype.sum_sum_type]
    have hRHS : (Sum.elim u v) (Sum.inl i) = (S⁻¹) i j := by
      dsimp [u, Matrix.mulVec, dotProduct, ej]
      simp
    linarith
  exact ⟨hFF_coerc, hFF_inv.2.1, hFF_inv.2.2.1, hvar, hS_symm, hS_coerc,
    hS_inv.2.1, hS_inv.2.2.1, hblock_inv⟩

/-- **Discrete Combes–Thomas Exponential Decay (`C/B`)**:
For `A = diagonal d_diag + L` with symmetric `L`, `d_diag i ≥ m_sq > 0`, metric/pseudometric `d`,
and exponentially weighted hopping bound `∑_k exp(μ * d(i, k)) |L_{ik}| ≤ γ_μ < m_sq` (`μ ≥ 0`),
the twisted operator `A_μ = W A W⁻¹` (`W = diag(e^{μ d(·, j₀)})`) stays `(m_sq - γ_μ)`-coercive,
yielding `|(A⁻¹)_{ij}| ≤ (1 / (m_sq - γ_μ)) * exp(-μ * d(i, j))`. -/
theorem discrete_combes_thomas_decay
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d_diag : ι → ℝ) (L : Matrix ι ι ℝ)
    (hL_symm : Lᵀ = L)
    {m_sq γ_μ μ : ℝ} (_hm_pos : 0 < m_sq) (hγ_nn : 0 ≤ γ_μ) (hγ_lt : γ_μ < m_sq) (hμ_nn : 0 ≤ μ)
    (hd_lb : ∀ i : ι, m_sq ≤ d_diag i)
    (d : ι → ι → ℝ)
    (hd_refl : ∀ i : ι, d i i = 0)
    (hd_symm : ∀ i j : ι, d i j = d j i)
    (hd_tri : ∀ i j k : ι, d i k ≤ d i j + d j k)
    (hL_exp : ∀ i : ι, ∑ k : ι, Real.exp (μ * d i k) * |L i k| ≤ γ_μ) :
    let A : Matrix ι ι ℝ := Matrix.diagonal d_diag + L
    (∀ x : ι → ℝ, (m_sq - γ_μ) * dotProduct x x ≤ dotProduct x (A.mulVec x)) ∧
    IsUnit A.det ∧
    (A * A⁻¹ = 1 ∧ A⁻¹ * A = 1) ∧
    (∀ i j : ι, |(A⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * Real.exp (-μ * d i j)) := by
  intro A
  have hc_pos : 0 < m_sq - γ_μ := sub_pos.mpr hγ_lt
  have hd_nn : ∀ i j : ι, 0 ≤ d i j := by
    intro i j
    have h0 : 0 ≤ 2 * d i j := by
      have ht := hd_tri i j i
      rw [hd_refl i, hd_symm j i] at ht
      linarith
    linarith
  have hL_row0 : ∀ i : ι, ∑ k : ι, |L i k| ≤ γ_μ := by
    intro i
    calc ∑ k : ι, |L i k|
        ≤ ∑ k : ι, Real.exp (μ * d i k) * |L i k| := by
          refine Finset.sum_le_sum (fun k _ => ?_)
          have hexp1 : 1 ≤ Real.exp (μ * d i k) :=
            Real.one_le_exp (mul_nonneg hμ_nn (hd_nn i k))
          exact le_mul_of_one_le_left (abs_nonneg _) hexp1
      _ ≤ γ_μ := hL_exp i
  have hL_col0 : ∀ j : ι, ∑ i : ι, |L i j| ≤ γ_μ := by
    intro j
    calc ∑ i : ι, |L i j|
        = ∑ i : ι, |L j i| := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [← Matrix.transpose_apply L i j, hL_symm]
      _ ≤ γ_μ := hL_row0 j
  have hA_coerc : ∀ x : ι → ℝ, (m_sq - γ_μ) * dotProduct x x ≤ dotProduct x (A.mulVec x) := by
    intro x
    have hD : m_sq * dotProduct x x ≤ dotProduct x ((Matrix.diagonal d_diag).mulVec x) := by
      dsimp [dotProduct, Matrix.mulVec, Matrix.diagonal]
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun i _ => ?_)
      simp only [ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
      have hsq : 0 ≤ x i * x i := mul_self_nonneg (x i)
      nlinarith [hd_lb i]
    have hL_bd := dotProduct_mulVec_abs_le_of_row_col_sum L hγ_nn hL_row0 hL_col0 x
    have hL_ge : -(γ_μ * dotProduct x x) ≤ dotProduct x (L.mulVec x) := (abs_le.mp hL_bd).1
    have hadd : dotProduct x (A.mulVec x) =
        dotProduct x ((Matrix.diagonal d_diag).mulVec x) + dotProduct x (L.mulVec x) := by
      dsimp [A]
      rw [Matrix.add_mulVec, dotProduct_add]
    linarith
  have hA_inv := coercive_matrix_inv_and_entry_bound A hc_pos hA_coerc
  have hdecay : ∀ i j : ι, |(A⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * Real.exp (-μ * d i j) := by
    intro i j0
    let w : ι → ℝ := fun i => Real.exp (μ * d i j0)
    let winv : ι → ℝ := fun i => Real.exp (-μ * d i j0)
    let W : Matrix ι ι ℝ := Matrix.diagonal w
    let Winv : Matrix ι ι ℝ := Matrix.diagonal winv
    have hW_mul : W * Winv = 1 := by
      ext a b
      by_cases hab : a = b
      · subst hab
        simp [W, Winv, w, winv, Matrix.mul_diagonal, ← Real.exp_add]
      · simp [W, Winv, hab, Matrix.mul_diagonal]
    have hWinv_mul : Winv * W = 1 := by
      ext a b
      by_cases hab : a = b
      · subst hab
        simp [W, Winv, w, winv, Matrix.mul_diagonal, ← Real.exp_add]
      · simp [W, Winv, hab, Matrix.mul_diagonal]
    let L_mu : Matrix ι ι ℝ := W * L * Winv
    let A_mu : Matrix ι ι ℝ := Matrix.diagonal d_diag + L_mu
    have hA_mu_eq : A_mu = W * A * Winv := by
      have hD_comm : W * Matrix.diagonal d_diag * Winv = Matrix.diagonal d_diag := by
        ext a b
        by_cases hab : a = b
        · subst hab
          simp [W, Winv, w, winv, Matrix.diagonal_apply_eq, Matrix.mul_diagonal]
          rw [mul_right_comm, ← Real.exp_add]
          simp
        · simp [W, Winv, Matrix.diagonal_apply_ne _ hab, Matrix.mul_diagonal]
      dsimp [A_mu, A, L_mu]
      rw [Matrix.mul_add, Matrix.add_mul, hD_comm]
    have hLmu_entry : ∀ a b : ι, L_mu a b = Real.exp (μ * (d a j0 - d b j0)) * L a b := by
      intro a b
      simp [L_mu, W, Winv, w, winv, Matrix.mul_diagonal, Matrix.diagonal_mul]
      rw [mul_right_comm, ← Real.exp_add]
      congr 1; congr 1; ring
    have hLmu_row : ∀ a : ι, ∑ b : ι, |L_mu a b| ≤ γ_μ := by
      intro a
      calc ∑ b : ι, |L_mu a b|
          = ∑ b : ι, Real.exp (μ * (d a j0 - d b j0)) * |L a b| := by
            refine Finset.sum_congr rfl (fun b _ => ?_)
            rw [hLmu_entry a b, abs_mul, abs_of_pos (Real.exp_pos _)]
        _ ≤ ∑ b : ι, Real.exp (μ * d a b) * |L a b| := by
            refine Finset.sum_le_sum (fun b _ => ?_)
            refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
            refine Real.exp_le_exp.mpr ?_
            refine mul_le_mul_of_nonneg_left ?_ hμ_nn
            linarith [hd_tri a b j0]
        _ ≤ γ_μ := hL_exp a
    have hLmu_col : ∀ b : ι, ∑ a : ι, |L_mu a b| ≤ γ_μ := by
      intro b
      calc ∑ a : ι, |L_mu a b|
          = ∑ a : ι, Real.exp (μ * (d a j0 - d b j0)) * |L a b| := by
            refine Finset.sum_congr rfl (fun a _ => ?_)
            rw [hLmu_entry a b, abs_mul, abs_of_pos (Real.exp_pos _)]
        _ ≤ ∑ a : ι, Real.exp (μ * d b a) * |L b a| := by
            refine Finset.sum_le_sum (fun a _ => ?_)
            have hsym_abs : |L a b| = |L b a| := by
              rw [← Matrix.transpose_apply L b a, hL_symm]
            rw [hsym_abs]
            refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
            refine Real.exp_le_exp.mpr ?_
            refine mul_le_mul_of_nonneg_left ?_ hμ_nn
            have ht := hd_tri a b j0
            rw [hd_symm a b] at ht
            linarith
        _ ≤ γ_μ := hL_exp b
    have hAmu_coerc : ∀ x : ι → ℝ, (m_sq - γ_μ) * dotProduct x x ≤ dotProduct x (A_mu.mulVec x) := by
      intro x
      have hD : m_sq * dotProduct x x ≤ dotProduct x ((Matrix.diagonal d_diag).mulVec x) := by
        dsimp [dotProduct, Matrix.mulVec, Matrix.diagonal]
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun a _ => ?_)
        simp only [ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
        have hsq : 0 ≤ x a * x a := mul_self_nonneg (x a)
        nlinarith [hd_lb a]
      have hL_bd := dotProduct_mulVec_abs_le_of_row_col_sum L_mu hγ_nn hLmu_row hLmu_col x
      have hL_ge : -(γ_μ * dotProduct x x) ≤ dotProduct x (L_mu.mulVec x) := (abs_le.mp hL_bd).1
      have hadd : dotProduct x (A_mu.mulVec x) =
          dotProduct x ((Matrix.diagonal d_diag).mulVec x) + dotProduct x (L_mu.mulVec x) := by
        dsimp [A_mu]
        rw [Matrix.add_mulVec, dotProduct_add]
      linarith
    have hAmu_inv := coercive_matrix_inv_and_entry_bound A_mu hc_pos hAmu_coerc
    have hinv_eq : A_mu⁻¹ = W * A⁻¹ * Winv := by
      have hmul_id : A_mu * (W * A⁻¹ * Winv) = 1 := by
        rw [hA_mu_eq]
        calc (W * A * Winv) * (W * A⁻¹ * Winv)
            = W * A * (Winv * W) * A⁻¹ * Winv := by simp only [Matrix.mul_assoc]
          _ = W * (A * A⁻¹) * Winv := by rw [hWinv_mul, Matrix.mul_one]; simp only [Matrix.mul_assoc]
          _ = W * Winv := by rw [hA_inv.2.2.1.1, Matrix.mul_one]
          _ = 1 := hW_mul
      calc A_mu⁻¹ = A_mu⁻¹ * (A_mu * (W * A⁻¹ * Winv)) := by rw [hmul_id, Matrix.mul_one]
        _ = (A_mu⁻¹ * A_mu) * (W * A⁻¹ * Winv) := by simp only [Matrix.mul_assoc]
        _ = W * A⁻¹ * Winv := by rw [hAmu_inv.2.2.1.2, Matrix.one_mul]
    have hentry_bd := hAmu_inv.2.2.2.2 i j0
    have hentry_eq : (A_mu⁻¹) i j0 = Real.exp (μ * d i j0) * (A⁻¹) i j0 := by
      rw [hinv_eq]
      simp [W, Winv, w, winv, Matrix.mul_diagonal, Matrix.diagonal_mul, hd_refl j0]
    rw [hentry_eq, abs_mul, abs_of_pos (Real.exp_pos _)] at hentry_bd
    have hexp_pos : 0 < Real.exp (μ * d i j0) := Real.exp_pos _
    calc |(A⁻¹) i j0|
        ≤ (1 / (m_sq - γ_μ)) / Real.exp (μ * d i j0) := (le_div_iff₀ hexp_pos).mpr (by linarith)
      _ = (1 / (m_sq - γ_μ)) * Real.exp (-μ * d i j0) := by
          rw [div_eq_mul_inv, ← Real.exp_neg, neg_mul]
  exact ⟨hA_coerc, hA_inv.2.1, hA_inv.2.2.1, hdecay⟩

/-- **Unified Discrete Combes–Thomas & RG Block-Spin Schur Positivity (`C/B/P`)**:
For a symmetric block-Laplacian / Hessian `A = diagonal d_diag + L = fromBlocks A_CC A_CF A_FC A_FF`
on `Fin N_C ⊕ Fin N_F → ℝ` with `d_diag ≥ m_sq > 0` and exponentially weighted coupling bound
`∑_k exp(μ d(i,k)) |L_{ik}| ≤ γ_μ < m_sq` (`μ ≥ 0`):
(a) Coercivity `(m_sq - γ_μ) ‖x‖² ≤ ⟨x, A x⟩` and invertibility of `A`;
(b) Strict positivity & coercivity preservation of the RG block-spin Schur complement
    `S = A_CC - A_CF A_FF⁻¹ A_FC` (`(m_sq - γ_μ) ‖x‖² ≤ ⟨x, S x⟩`, `Sᵀ = S`, `(A⁻¹)_CC = S⁻¹`);
(c) Discrete Combes–Thomas exponential decay for BOTH `A⁻¹` and the effective coarse covariance `S⁻¹`:
    `|(S⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * exp(-μ * d (Sum.inl i) (Sum.inl j))`. -/
theorem discrete_combes_thomas_and_schur_block_positivity
    {N_C N_F : ℕ}
    (d_diag : Fin N_C ⊕ Fin N_F → ℝ)
    (L : Matrix (Fin N_C ⊕ Fin N_F) (Fin N_C ⊕ Fin N_F) ℝ)
    (hL_symm : Lᵀ = L)
    {m_sq γ_μ μ : ℝ} (_hm_pos : 0 < m_sq) (hγ_nn : 0 ≤ γ_μ) (hγ_lt : γ_μ < m_sq) (hμ_nn : 0 ≤ μ)
    (hd_lb : ∀ i : Fin N_C ⊕ Fin N_F, m_sq ≤ d_diag i)
    (d : (Fin N_C ⊕ Fin N_F) → (Fin N_C ⊕ Fin N_F) → ℝ)
    (hd_refl : ∀ i, d i i = 0)
    (hd_symm : ∀ i j, d i j = d j i)
    (hd_tri : ∀ i j k, d i k ≤ d i j + d j k)
    (hL_exp : ∀ i, ∑ k, Real.exp (μ * d i k) * |L i k| ≤ γ_μ) :
    let A : Matrix (Fin N_C ⊕ Fin N_F) (Fin N_C ⊕ Fin N_F) ℝ := Matrix.diagonal d_diag + L
    let A_CC : Matrix (Fin N_C) (Fin N_C) ℝ := fun i j => A (Sum.inl i) (Sum.inl j)
    let A_CF : Matrix (Fin N_C) (Fin N_F) ℝ := fun i j => A (Sum.inl i) (Sum.inr j)
    let A_FC : Matrix (Fin N_F) (Fin N_C) ℝ := fun i j => A (Sum.inr i) (Sum.inl j)
    let A_FF : Matrix (Fin N_F) (Fin N_F) ℝ := fun i j => A (Sum.inr i) (Sum.inr j)
    let S : Matrix (Fin N_C) (Fin N_C) ℝ := A_CC - A_CF * A_FF⁻¹ * A_FC
    (∀ z : Fin N_C ⊕ Fin N_F → ℝ, (m_sq - γ_μ) * dotProduct z z ≤ dotProduct z (A.mulVec z)) ∧
    IsUnit A.det ∧
    (A * A⁻¹ = 1 ∧ A⁻¹ * A = 1) ∧
    Sᵀ = S ∧
    (∀ x : Fin N_C → ℝ, (m_sq - γ_μ) * dotProduct x x ≤ dotProduct x (S.mulVec x)) ∧
    IsUnit S.det ∧
    (S * S⁻¹ = 1 ∧ S⁻¹ * S = 1) ∧
    (∀ i j : Fin N_C ⊕ Fin N_F, |(A⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * Real.exp (-μ * d i j)) ∧
    (∀ i j : Fin N_C, |(S⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * Real.exp (-μ * d (Sum.inl i) (Sum.inl j))) := by
  intro A A_CC A_CF A_FC A_FF S
  have hct := discrete_combes_thomas_decay d_diag L hL_symm _hm_pos hγ_nn hγ_lt hμ_nn hd_lb
    d hd_refl hd_symm hd_tri hL_exp
  have hA_symm : Aᵀ = A := by
    dsimp [A]
    rw [Matrix.transpose_add, Matrix.diagonal_transpose, hL_symm]
  have hA_blocks : A = Matrix.fromBlocks A_CC A_CF A_FC A_FF := by
    ext i j
    cases i <;> cases j <;> rfl
  have hCC_symm : A_CCᵀ = A_CC := by
    ext i j; exact congrFun (congrFun hA_symm (Sum.inl i)) (Sum.inl j)
  have hFF_symm : A_FFᵀ = A_FF := by
    ext i j; exact congrFun (congrFun hA_symm (Sum.inr i)) (Sum.inr j)
  have hCF_symm : A_CFᵀ = A_FC := by
    ext i j; exact congrFun (congrFun hA_symm (Sum.inr i)) (Sum.inl j)
  have hcoerc_blocks : ∀ z : Fin N_C ⊕ Fin N_F → ℝ,
      (m_sq - γ_μ) * dotProduct z z ≤
        dotProduct z ((Matrix.fromBlocks A_CC A_CF A_FC A_FF).mulVec z) := by
    intro z
    rw [← hA_blocks]
    exact hct.1 z
  have hc_pos : 0 < m_sq - γ_μ := sub_pos.mpr hγ_lt
  have hschur := schur_complement_coercivity_and_block_inverse
    A_CC A_CF A_FC A_FF hCC_symm hFF_symm hCF_symm hc_pos hcoerc_blocks
  have hS_decay : ∀ i j : Fin N_C,
      |(S⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * Real.exp (-μ * d (Sum.inl i) (Sum.inl j)) := by
    intro i j
    have hblk := hschur.2.2.2.2.2.2.2.2 i j
    rw [← hA_blocks] at hblk
    rw [← hblk]
    exact hct.2.2.2 (Sum.inl i) (Sum.inl j)
  exact ⟨hct.1, hct.2.1, hct.2.2.1, hschur.2.2.2.2.1, hschur.2.2.2.2.2.1,
    hschur.2.2.2.2.2.2.1, hschur.2.2.2.2.2.2.2.1, hct.2.2.2, hS_decay⟩

/-- **Graph-Banded Combes–Thomas Rate Specialization (`C/B`)**:
When off-diagonal hopping `L` has finite graph band radius `R > 0` (`R < d(i, k) → L_{ik} = 0`)
and un-twisted coupling bound `∑_k |L_{ik}| ≤ γ` with `0 < γ < m_sq`, choosing
`μ = log(m_sq / γ) / (2 * R) > 0` yields `exp(μ R) * γ = sqrt(m_sq * γ) < m_sq` and thus
exponential decay of `(A⁻¹)_{ij}` at explicit rate `μ > 0`. -/
theorem graph_banded_combes_thomas_rate
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d_diag : ι → ℝ) (L : Matrix ι ι ℝ)
    (hL_symm : Lᵀ = L)
    {m_sq γ R : ℝ} (hm_pos : 0 < m_sq) (hγ_pos : 0 < γ) (hγ_lt : γ < m_sq) (hR_pos : 0 < R)
    (hd_lb : ∀ i : ι, m_sq ≤ d_diag i)
    (d : ι → ι → ℝ)
    (hd_refl : ∀ i : ι, d i i = 0)
    (hd_symm : ∀ i j : ι, d i j = d j i)
    (hd_tri : ∀ i j k : ι, d i k ≤ d i j + d j k)
    (hband : ∀ i k : ι, R < d i k → L i k = 0)
    (hL_sum : ∀ i : ι, ∑ k : ι, |L i k| ≤ γ) :
    let μ : ℝ := Real.log (m_sq / γ) / (2 * R)
    let γ_μ : ℝ := Real.sqrt (m_sq * γ)
    let A : Matrix ι ι ℝ := Matrix.diagonal d_diag + L
    0 < μ ∧ γ_μ < m_sq ∧
    (∀ i j : ι, |(A⁻¹) i j| ≤ (1 / (m_sq - γ_μ)) * Real.exp (-μ * d i j)) := by
  intro μ γ_μ A
  have hratio_gt : 1 < m_sq / γ := (one_lt_div hγ_pos).mpr hγ_lt
  have hlog_pos : 0 < Real.log (m_sq / γ) := Real.log_pos hratio_gt
  have hμ_pos : 0 < μ := by dsimp [μ]; positivity
  have hγμ_nn : 0 ≤ γ_μ := Real.sqrt_nonneg _
  have hγμ_lt : γ_μ < m_sq := by
    dsimp [γ_μ]
    rw [Real.sqrt_lt' hm_pos]
    nlinarith
  have hexp_eq : Real.exp (μ * R) * γ = γ_μ := by
    have hR_ne : R ≠ 0 := ne_of_gt hR_pos
    have harg : μ * R = Real.log (m_sq / γ) * (1 / 2 : ℝ) := by
      dsimp [μ]; field_simp [hR_ne]
    rw [harg, Real.exp_mul, Real.exp_log (div_pos hm_pos hγ_pos)]
    have hhalf : (m_sq / γ) ^ (1 / 2 : ℝ) = Real.sqrt (m_sq / γ) := by
      rw [Real.sqrt_eq_rpow]
    rw [hhalf, Real.sqrt_div (le_of_lt hm_pos)]
    have hsq_g : Real.sqrt γ ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hγ_pos)
    dsimp [γ_μ]
    rw [Real.sqrt_mul (le_of_lt hm_pos)]
    calc (Real.sqrt m_sq / Real.sqrt γ) * γ
        = (Real.sqrt m_sq / Real.sqrt γ) * (Real.sqrt γ * Real.sqrt γ) := by
          rw [Real.mul_self_sqrt (le_of_lt hγ_pos)]
      _ = Real.sqrt m_sq * Real.sqrt γ := by field_simp [hsq_g]
  have hL_exp : ∀ i : ι, ∑ k : ι, Real.exp (μ * d i k) * |L i k| ≤ γ_μ := by
    intro i
    calc ∑ k : ι, Real.exp (μ * d i k) * |L i k|
        ≤ ∑ k : ι, Real.exp (μ * R) * |L i k| := by
          refine Finset.sum_le_sum (fun k _ => ?_)
          by_cases hk : R < d i k
          · simp [hband i k hk]
          · have hd_le : d i k ≤ R := not_lt.mp hk
            refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
            exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hd_le (le_of_lt hμ_pos))
      _ = Real.exp (μ * R) * ∑ k : ι, |L i k| := by rw [← Finset.mul_sum]
      _ ≤ Real.exp (μ * R) * γ := mul_le_mul_of_nonneg_left (hL_sum i) (le_of_lt (Real.exp_pos _))
      _ = γ_μ := hexp_eq
  have hct := discrete_combes_thomas_decay d_diag L hL_symm hm_pos hγμ_nn hγμ_lt (le_of_lt hμ_pos)
    hd_lb d hd_refl hd_symm hd_tri hL_exp
  exact ⟨hμ_pos, hγμ_lt, hct.2.2.2⟩

/-- Concrete `2 × 2` (`Fin 1 ⊕ Fin 1`) witness for `discrete_combes_thomas_and_schur_block_positivity`
with `m_sq = 4`, `L = [[0, -1], [-1, 0]]`, `d(i, j) = |i - j|`, `μ = log 2 > 0`, `γ_μ = 2 < 4`. `[C/B]` -/
theorem combes_thomas_schur_concrete_witness :
    let d_diag : Fin 1 ⊕ Fin 1 → ℝ := fun _ => 4
    let L : Matrix (Fin 1 ⊕ Fin 1) (Fin 1 ⊕ Fin 1) ℝ := fun i j =>
      match i, j with
      | Sum.inl _, Sum.inr _ => -1
      | Sum.inr _, Sum.inl _ => -1
      | _, _ => 0
    let d : (Fin 1 ⊕ Fin 1) → (Fin 1 ⊕ Fin 1) → ℝ := fun i j =>
      match i, j with
      | Sum.inl _, Sum.inr _ => 1
      | Sum.inr _, Sum.inl _ => 1
      | _, _ => 0
    let A := Matrix.diagonal d_diag + L
    let A_CC : Matrix (Fin 1) (Fin 1) ℝ := fun i j => A (Sum.inl i) (Sum.inl j)
    let A_CF : Matrix (Fin 1) (Fin 1) ℝ := fun i j => A (Sum.inl i) (Sum.inr j)
    let A_FC : Matrix (Fin 1) (Fin 1) ℝ := fun i j => A (Sum.inr i) (Sum.inl j)
    let A_FF : Matrix (Fin 1) (Fin 1) ℝ := fun i j => A (Sum.inr i) (Sum.inr j)
    let S : Matrix (Fin 1) (Fin 1) ℝ := A_CC - A_CF * A_FF⁻¹ * A_FC
    (∀ z : Fin 1 ⊕ Fin 1 → ℝ, (2 : ℝ) * dotProduct z z ≤ dotProduct z (A.mulVec z)) ∧
    (∀ x : Fin 1 → ℝ, (2 : ℝ) * dotProduct x x ≤ dotProduct x (S.mulVec x)) ∧
    (∀ i j : Fin 1 ⊕ Fin 1, |(A⁻¹) i j| ≤ (1 / 2 : ℝ) * Real.exp (-Real.log 2 * d i j)) := by
  intro d_diag L d A S
  have hL_symm : Lᵀ = L := by
    ext i j
    rw [Matrix.transpose_apply]
    cases i <;> cases j <;> simp [L]
  have hd_refl : ∀ i, d i i = 0 := by intro i; cases i <;> simp [d]
  have hd_symm : ∀ i j, d i j = d j i := by intro i j; cases i <;> cases j <;> simp [d]
  have hd_tri : ∀ i j k, d i k ≤ d i j + d j k := by
    intro i j k; cases i <;> cases j <;> cases k <;> norm_num [d]
  have hL_exp : ∀ i, ∑ k, Real.exp (Real.log 2 * d i k) * |L i k| ≤ (2 : ℝ) := by
    intro i
    cases i <;>
      · simp [Fintype.sum_sum_type, d, L, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
  have hmain := discrete_combes_thomas_and_schur_block_positivity
    d_diag L hL_symm (m_sq := 4) (γ_μ := 2) (μ := Real.log 2)
    (by norm_num) (by norm_num) (by norm_num) (Real.log_nonneg (by norm_num))
    (fun _ => le_refl 4) d hd_refl hd_symm hd_tri hL_exp
  have h42 : (4 : ℝ) - 2 = 2 := by norm_num
  have hinv42 : (1 : ℝ) / (4 - 2) = 1 / 2 := by norm_num
  refine ⟨?_, ?_, ?_⟩
  · have h1 := hmain.1; rw [h42] at h1; simpa [A] using h1
  · have h2 := hmain.2.2.2.2.1; rw [h42] at h2; simpa [A, S] using h2
  · have h3 := hmain.2.2.2.2.2.2.2.1; rw [hinv42] at h3; simpa [A] using h3

end Round04UVCombesCounterterm
