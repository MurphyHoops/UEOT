private lemma tendsto_inv_nhdsIoi_zero_atTop :
    Filter.Tendsto (fun a : ℝ => a⁻¹) (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop := by
  rw [Filter.tendsto_atTop]
  intro b
  let M : ℝ := max b 1
  have hM_pos : 0 < M := lt_of_lt_of_le (by norm_num) (le_max_right b 1)
  have hmem_lt : Set.Iio M⁻¹ ∈ nhds (0 : ℝ) := Iio_mem_nhds (inv_pos.mpr hM_pos)
  filter_upwards [mem_nhdsWithin_of_mem_nhds hmem_lt, self_mem_nhdsWithin] with a ha_lt (ha_pos : 0 < a)
  have ha_lt' : a < M⁻¹ := ha_lt
  have hlt : M < a⁻¹ := (lt_inv_comm₀ hM_pos ha_pos).mpr ha_lt'
  exact le_trans (le_max_left b 1) (le_of_lt hlt)

/-! ## Part (a): Sharpened Wilson-Action Defect-Density Blowup (`[B/P]`) -/

/-- Expected 4D unit-physical-volume inadmissible plaquette count under the unconditioned Wilson
action: `N_plaq(a) * (a * Lambda)^{2 * c_adm * b0}` with `N_plaq(a) = 6 * (L_phys / a)^4`. `[B/P]` -/
noncomputable def wilsonDefectCount4D (L_phys Lambda c_adm b0 a : ℝ) : ℝ :=
  6 * (L_phys / a) ^ 4 * (a * Lambda) ^ (2 * c_adm * b0)

/-- **Wilson Admissibility Defect-Density Blowup (`[B/P]`)**:
For any `c_adm > 0`, `b0 > 0` with `2 * c_adm * b0 < 4`, `L_phys > 0`, and `Lambda > 0`:
1. On `0 < a`, `wilsonDefectCount4D L_phys Lambda c_adm b0 a =
   6 * L_phys^4 * Lambda^{2 c_adm b0} * a^{2 c_adm b0 - 4}`,
2. Both forms diverge continuously to `+∞` as `a → 0⁺` (`nhdsWithin 0 (Set.Ioi 0)`),
3. For `0 < a < 1 / Lambda` and `c_adm = eps_adm^2 / (16 π^2)`, the 1-loop Boltzmann defect
   bound `6 * (L_phys / a)^4 * exp(-eps_adm^2 * invG0Sq(a))` equals `wilsonDefectCount4D`,
   ruling out unconditioned Wilson admissibility cutoff removal (`DEAD-20261124-01`). -/
theorem wilson_defect_density_blowup_as_a_tendsto_zero
    {L_phys Lambda c_adm b0 : ℝ}
    (hL : 0 < L_phys) (hLam : 0 < Lambda)
    (_hc : 0 < c_adm) (_hb0 : 0 < b0) (hgap : 2 * c_adm * b0 < 4) :
    (∀ a : ℝ, 0 < a →
      wilsonDefectCount4D L_phys Lambda c_adm b0 a =
        6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) * a ^ (2 * c_adm * b0 - 4)) ∧
    Filter.Tendsto
      (fun a : ℝ => 6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) * a ^ (2 * c_adm * b0 - 4))
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop ∧
    Filter.Tendsto
      (wilsonDefectCount4D L_phys Lambda c_adm b0)
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop ∧
    (∀ eps_adm a : ℝ, 0 < eps_adm → c_adm = eps_adm ^ 2 / (16 * Real.pi ^ 2) →
      0 < a → a * Lambda < 1 →
      let invG0Sq : ℝ := (2 * b0 / (16 * Real.pi ^ 2)) * Real.log (1 / (a * Lambda))
      6 * (L_phys / a) ^ 4 * Real.exp (-(eps_adm ^ 2 * invG0Sq)) =
        wilsonDefectCount4D L_phys Lambda c_adm b0 a) := by
  have heq_pos : ∀ a : ℝ, 0 < a →
      wilsonDefectCount4D L_phys Lambda c_adm b0 a =
        6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) * a ^ (2 * c_adm * b0 - 4) := by
    intro a ha
    unfold wilsonDefectCount4D
    have hpow4 : (L_phys / a) ^ 4 = L_phys ^ 4 * a ^ (-4 : ℝ) := by
      rw [div_pow, div_eq_mul_inv]
      congr 1
      rw [← Real.rpow_natCast a 4, Real.rpow_neg (le_of_lt ha)]
      norm_num
    have hrpow_mul : (a * Lambda) ^ (2 * c_adm * b0) =
        a ^ (2 * c_adm * b0) * Lambda ^ (2 * c_adm * b0) :=
      Real.mul_rpow (le_of_lt ha) (le_of_lt hLam)
    have hrpow_add : a ^ (-4 : ℝ) * a ^ (2 * c_adm * b0) = a ^ (2 * c_adm * b0 - 4) := by
      rw [← Real.rpow_add ha]
      congr 1
      ring
    calc
      6 * (L_phys / a) ^ 4 * (a * Lambda) ^ (2 * c_adm * b0)
          = 6 * (L_phys ^ 4 * a ^ (-4 : ℝ)) * (a ^ (2 * c_adm * b0) * Lambda ^ (2 * c_adm * b0)) := by
            rw [hpow4, hrpow_mul]
      _ = 6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) * (a ^ (-4 : ℝ) * a ^ (2 * c_adm * b0)) := by
            ring
      _ = 6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) * a ^ (2 * c_adm * b0 - 4) := by
            rw [hrpow_add]
  have hdiff_pos : 0 < 4 - 2 * c_adm * b0 := by linarith
  have hpref_pos : 0 < 6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) :=
    mul_pos (mul_pos (by norm_num) (pow_pos hL 4)) (Real.rpow_pos_of_pos hLam _)
  have htend_inv : Filter.Tendsto (fun a : ℝ => a⁻¹) (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop :=
    tendsto_inv_nhdsIoi_zero_atTop
  have htend_rpow : Filter.Tendsto (fun a : ℝ => (a⁻¹) ^ (4 - 2 * c_adm * b0))
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop :=
    (tendsto_rpow_atTop hdiff_pos).comp htend_inv
  have htend_scaled : Filter.Tendsto
      (fun a : ℝ => (6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0)) * (a⁻¹) ^ (4 - 2 * c_adm * b0))
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop :=
    Filter.Tendsto.const_mul_atTop hpref_pos htend_rpow
  have htend_form : Filter.Tendsto
      (fun a : ℝ => 6 * L_phys ^ 4 * Lambda ^ (2 * c_adm * b0) * a ^ (2 * c_adm * b0 - 4))
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop := by
    refine htend_scaled.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with a (ha : 0 < a)
    have hinv_eq : (a⁻¹) ^ (4 - 2 * c_adm * b0) = a ^ (2 * c_adm * b0 - 4) := by
      rw [Real.inv_rpow (le_of_lt ha), ← Real.rpow_neg (le_of_lt ha)]
      congr 1
      ring
    rw [hinv_eq]
  have htend_count : Filter.Tendsto (wilsonDefectCount4D L_phys Lambda c_adm b0)
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop := by
    refine htend_form.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with a (ha : 0 < a)
    exact (heq_pos a ha).symm
  have hboltz : ∀ eps_adm a : ℝ, 0 < eps_adm → c_adm = eps_adm ^ 2 / (16 * Real.pi ^ 2) →
      0 < a → a * Lambda < 1 →
      let invG0Sq : ℝ := (2 * b0 / (16 * Real.pi ^ 2)) * Real.log (1 / (a * Lambda))
      6 * (L_phys / a) ^ 4 * Real.exp (-(eps_adm ^ 2 * invG0Sq)) =
        wilsonDefectCount4D L_phys Lambda c_adm b0 a := by
    intro eps_adm a _ hc_eq ha _ invG0Sq
    have haL_pos : 0 < a * Lambda := mul_pos ha hLam
    have hexp_eq : Real.exp (-(eps_adm ^ 2 * invG0Sq)) = (a * Lambda) ^ (2 * c_adm * b0) := by
      rw [Real.rpow_def_of_pos haL_pos]
      congr 1
      have hlog_inv : Real.log (1 / (a * Lambda)) = -Real.log (a * Lambda) := by
        rw [one_div, Real.log_inv]
      dsimp [invG0Sq]
      rw [hlog_inv, hc_eq]
      ring
    unfold wilsonDefectCount4D
    rw [hexp_eq]
  exact ⟨heq_pos, htend_form, htend_count, hboltz⟩

/-! ## Part (b): Strategy C1 — Lüscher Singular Admissibility Action (`[C/B/P/X]`) -/

/-- Lüscher's singular admissibility plaquette gauge action `S_L(u) = β u / (1 - u / ε_adm)`
on `[0, ε_adm)`. `[B/P]` -/
noncomputable def luscherPlaqAction (beta eps_adm u : ℝ) : ℝ :=
  beta * u / (1 - u / eps_adm)

/-- Boltzmann weight associated with Lüscher's singular admissibility action, vanishing
identically outside `[0, ε_adm)` to enforce `P = 1` admissibility. `[B/P]` -/
noncomputable def luscherBoltzmannWeight (beta eps_adm u : ℝ) : ℝ :=
  if 0 ≤ u ∧ u < eps_adm then Real.exp (-luscherPlaqAction beta eps_adm u) else 0

/-- **Strategy C1: Lüscher Singular Admissibility Action Dominance, Blowup & Symanzik `O(u^2)` (`[B/P]`)**:
For any `beta > 0` and `eps_adm > 0`:
1. On `[0, eps_adm)`, `0 ≤ S_L(u)` and `beta * u ≤ S_L(u)` (with strict domination `beta * u < S_L(u)`
   on `(0, eps_adm)`), and `S_L` is strictly increasing on `[0, eps_adm)`,
2. As `u → eps_adm⁻` (`nhdsWithin eps_adm (Set.Iio eps_adm)`), `S_L(u) → +∞` and
   `luscherBoltzmannWeight beta eps_adm u → 0`, with deterministic `P = 1` admissibility
   (`eps_adm ≤ u → luscherBoltzmannWeight = 0`),
3. Exact remainder `S_L(u) - beta * u = beta * u^2 / (eps_adm - u)` for `u < eps_adm`, giving
   `0 ≤ S_L(u) - beta * u ≤ (2 * beta / eps_adm) * u^2` on `[0, eps_adm / 2]` and `O(a^2)` / `O(a^4)`
   Symanzik agreement with the Wilson action. -/
theorem luscher_action_dominance_blowup_and_symanzik
    {beta eps_adm : ℝ} (hbeta : 0 < beta) (heps : 0 < eps_adm) :
    (∀ u : ℝ, 0 ≤ u → u < eps_adm →
      0 ≤ luscherPlaqAction beta eps_adm u ∧
      beta * u ≤ luscherPlaqAction beta eps_adm u) ∧
    (∀ u : ℝ, 0 < u → u < eps_adm →
      beta * u < luscherPlaqAction beta eps_adm u) ∧
    (∀ u v : ℝ, 0 ≤ u → u < v → v < eps_adm →
      luscherPlaqAction beta eps_adm u < luscherPlaqAction beta eps_adm v) ∧
    Filter.Tendsto (luscherPlaqAction beta eps_adm)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) Filter.atTop ∧
    Filter.Tendsto (luscherBoltzmannWeight beta eps_adm)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) (nhds 0) ∧
    (∀ u : ℝ, eps_adm ≤ u → luscherBoltzmannWeight beta eps_adm u = 0) ∧
    (∀ u : ℝ, u < eps_adm →
      luscherPlaqAction beta eps_adm u - beta * u = beta * u ^ 2 / (eps_adm - u)) ∧
    (∀ u : ℝ, 0 ≤ u → u ≤ eps_adm / 2 →
      0 ≤ luscherPlaqAction beta eps_adm u - beta * u ∧
      luscherPlaqAction beta eps_adm u - beta * u ≤ (2 * beta / eps_adm) * u ^ 2) ∧
    (∀ (u_lat : ℝ → ℝ) (C_u aMax : ℝ), 0 ≤ C_u → 0 < aMax → C_u * aMax ≤ eps_adm / 2 →
      ∀ a : ℝ, 0 < a → a ≤ aMax → 0 ≤ u_lat a → u_lat a ≤ C_u * a →
      luscherPlaqAction beta eps_adm (u_lat a) - beta * u_lat a ≤
        (2 * beta * C_u ^ 2 / eps_adm) * a ^ 2) := by
  have hden_pos : ∀ u : ℝ, u < eps_adm → 0 < 1 - u / eps_adm := by
    intro u hu
    have hlt : u / eps_adm < 1 := (div_lt_one heps).mpr hu
    linarith
  have hdom : ∀ u : ℝ, 0 ≤ u → u < eps_adm →
      0 ≤ luscherPlaqAction beta eps_adm u ∧
      beta * u ≤ luscherPlaqAction beta eps_adm u := by
    intro u hu0 hu_lt
    have hd : 0 < 1 - u / eps_adm := hden_pos u hu_lt
    have hd_le : 1 - u / eps_adm ≤ 1 := by
      have : 0 ≤ u / eps_adm := div_nonneg hu0 (le_of_lt heps)
      linarith
    unfold luscherPlaqAction
    refine ⟨div_nonneg (mul_nonneg (le_of_lt hbeta) hu0) (le_of_lt hd), ?_⟩
    exact le_div_self (mul_nonneg (le_of_lt hbeta) hu0) hd hd_le
  have hstrict : ∀ u : ℝ, 0 < u → u < eps_adm →
      beta * u < luscherPlaqAction beta eps_adm u := by
    intro u hu0 hu_lt
    have hd : 0 < 1 - u / eps_adm := hden_pos u hu_lt
    have hd_lt : 1 - u / eps_adm < 1 := by
      have : 0 < u / eps_adm := div_pos hu0 heps
      linarith
    unfold luscherPlaqAction
    rw [lt_div_iff₀ hd]
    nlinarith [mul_pos hbeta hu0]
  have hmono : ∀ u v : ℝ, 0 ≤ u → u < v → v < eps_adm →
      luscherPlaqAction beta eps_adm u < luscherPlaqAction beta eps_adm v := by
    intro u v hu0 huv hv_lt
    have hdu : 0 < 1 - u / eps_adm := hden_pos u (lt_trans huv hv_lt)
    have hdv : 0 < 1 - v / eps_adm := hden_pos v hv_lt
    have hdv_lt_du : 1 - v / eps_adm < 1 - u / eps_adm := by
      have : u / eps_adm < v / eps_adm := div_lt_div_of_pos_right huv heps
      linarith
    unfold luscherPlaqAction
    rw [div_lt_div_iff₀ hdu hdv]
    have hnum_lt : beta * u < beta * v := mul_lt_mul_of_pos_left huv hbeta
    have h1 : beta * u * (1 - v / eps_adm) < beta * v * (1 - v / eps_adm) :=
      mul_lt_mul_of_pos_right hnum_lt hdv
    have hv_nn : 0 ≤ beta * v := mul_nonneg (le_of_lt hbeta) (le_trans hu0 (le_of_lt huv))
    have h2 : beta * v * (1 - v / eps_adm) ≤ beta * v * (1 - u / eps_adm) :=
      mul_le_mul_of_nonneg_left (le_of_lt hdv_lt_du) hv_nn
    exact lt_of_lt_of_le h1 h2
  have htend_sub_zero : Filter.Tendsto (fun u : ℝ => eps_adm - u)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) (nhdsWithin 0 (Set.Ioi 0)) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · have hcont : Continuous (fun u : ℝ => eps_adm - u) := continuous_const.sub continuous_id
      have h0 : Filter.Tendsto (fun u : ℝ => eps_adm - u) (nhds eps_adm) (nhds (eps_adm - eps_adm)) :=
        hcont.continuousAt.tendsto
      rw [sub_self] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with u (hu : u < eps_adm)
      exact sub_pos.mpr hu
  have htend_inv_sub : Filter.Tendsto (fun u : ℝ => (eps_adm - u)⁻¹)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) Filter.atTop :=
    tendsto_inv_nhdsIoi_zero_atTop.comp htend_sub_zero
  have htend_num : Filter.Tendsto (fun u : ℝ => beta * eps_adm * u)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) (nhds (beta * eps_adm * eps_adm)) := by
    have hcont : Continuous (fun u : ℝ => beta * eps_adm * u) := continuous_const.mul continuous_id
    exact hcont.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
  have htend_prod : Filter.Tendsto (fun u : ℝ => (beta * eps_adm * u) * (eps_adm - u)⁻¹)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) Filter.atTop :=
    Filter.Tendsto.pos_mul_atTop (mul_pos (mul_pos hbeta heps) heps) htend_num htend_inv_sub
  have htend_SL : Filter.Tendsto (luscherPlaqAction beta eps_adm)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) Filter.atTop := by
    refine htend_prod.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with u (hu : u < eps_adm)
    have hne_eps : eps_adm ≠ 0 := ne_of_gt heps
    have hne_sub : eps_adm - u ≠ 0 := sub_ne_zero.mpr (ne_of_gt hu)
    have hne_den : 1 - u / eps_adm ≠ 0 := ne_of_gt (hden_pos u hu)
    unfold luscherPlaqAction
    field_simp [hne_eps, hne_sub, hne_den]
  have htend_boltz : Filter.Tendsto (luscherBoltzmannWeight beta eps_adm)
      (nhdsWithin eps_adm (Set.Iio eps_adm)) (nhds 0) := by
    have hexp_tend : Filter.Tendsto (fun u : ℝ => Real.exp (-luscherPlaqAction beta eps_adm u))
        (nhdsWithin eps_adm (Set.Iio eps_adm)) (nhds 0) :=
      Real.tendsto_exp_atBot.comp (Filter.tendsto_neg_atTop_atBot.comp htend_SL)
    refine hexp_tend.congr' ?_
    filter_upwards [mem_nhdsWithin_of_mem_nhds (Ioi_mem_nhds heps), self_mem_nhdsWithin]
      with u hu0 (hult : u < eps_adm)
    unfold luscherBoltzmannWeight
    rw [if_pos ⟨le_of_lt hu0, hult⟩]
  have hzero_out : ∀ u : ℝ, eps_adm ≤ u → luscherBoltzmannWeight beta eps_adm u = 0 := by
    intro u hu
    unfold luscherBoltzmannWeight
    rw [if_neg (fun h => not_lt_of_ge hu h.2)]
  have hrem_eq : ∀ u : ℝ, u < eps_adm →
      luscherPlaqAction beta eps_adm u - beta * u = beta * u ^ 2 / (eps_adm - u) := by
    intro u hu
    have hne_eps : eps_adm ≠ 0 := ne_of_gt heps
    have hne_sub : eps_adm - u ≠ 0 := sub_ne_zero.mpr (ne_of_gt hu)
    have hne_den : 1 - u / eps_adm ≠ 0 := ne_of_gt (hden_pos u hu)
    unfold luscherPlaqAction
    field_simp [hne_eps, hne_sub, hne_den]
    ring
  have hsym_quad : ∀ u : ℝ, 0 ≤ u → u ≤ eps_adm / 2 →
      0 ≤ luscherPlaqAction beta eps_adm u - beta * u ∧
      luscherPlaqAction beta eps_adm u - beta * u ≤ (2 * beta / eps_adm) * u ^ 2 := by
    intro u hu0 hu_half
    have hu_lt : u < eps_adm := lt_of_le_of_lt hu_half (half_lt_self heps)
    have hsub_ge : eps_adm / 2 ≤ eps_adm - u := by linarith
    have hsub_pos : 0 < eps_adm - u := sub_pos.mpr hu_lt
    rw [hrem_eq u hu_lt]
    refine ⟨div_nonneg (mul_nonneg (le_of_lt hbeta) (sq_nonneg u)) (le_of_lt hsub_pos), ?_⟩
    have hdiv : beta * u ^ 2 / (eps_adm - u) ≤ beta * u ^ 2 / (eps_adm / 2) :=
      div_le_div_of_nonneg_left (mul_nonneg (le_of_lt hbeta) (sq_nonneg u))
        (half_pos heps) hsub_ge
    have hrew : beta * u ^ 2 / (eps_adm / 2) = (2 * beta / eps_adm) * u ^ 2 := by
      field_simp [ne_of_gt heps]
    exact hdiv.trans_eq hrew
  have hsym_a2 : ∀ (u_lat : ℝ → ℝ) (C_u aMax : ℝ), 0 ≤ C_u → 0 < aMax →
      C_u * aMax ≤ eps_adm / 2 →
      ∀ a : ℝ, 0 < a → a ≤ aMax → 0 ≤ u_lat a → u_lat a ≤ C_u * a →
      luscherPlaqAction beta eps_adm (u_lat a) - beta * u_lat a ≤
        (2 * beta * C_u ^ 2 / eps_adm) * a ^ 2 := by
    intro u_lat C_u aMax hCu _ hcap a ha ha_le hua0 hua_le
    have hua_half : u_lat a ≤ eps_adm / 2 := by
      have : C_u * a ≤ C_u * aMax := mul_le_mul_of_nonneg_left ha_le hCu
      linarith
    have hq := (hsym_quad (u_lat a) hua0 hua_half).2
    have hsq : (u_lat a) ^ 2 ≤ (C_u * a) ^ 2 := pow_le_pow_left₀ hua0 hua_le 2
    have hcoeff_nn : 0 ≤ 2 * beta / eps_adm := by positivity
    have h1 : (2 * beta / eps_adm) * (u_lat a) ^ 2 ≤ (2 * beta / eps_adm) * (C_u * a) ^ 2 :=
      mul_le_mul_of_nonneg_left hsq hcoeff_nn
    have hrew : (2 * beta / eps_adm) * (C_u * a) ^ 2 = (2 * beta * C_u ^ 2 / eps_adm) * a ^ 2 := by
      ring
    exact le_trans hq (h1.trans_eq hrew)
  exact ⟨hdom, hstrict, hmono, htend_SL, htend_boltz, hzero_out, hrem_eq, hsym_quad, hsym_a2⟩

/-- Finite-state character-expansion kernel `W_{ij} = ∑_k c_k χ_k(i) χ_k(j)` modeling
single-plaquette reflection positivity of `exp(-S_L)`. `[C/B/P]` -/
def finiteCharacterKernel {r n : ℕ} (chi : Fin r → Fin n → ℝ) (c : Fin r → ℝ) :
    Matrix (Fin n) (Fin n) ℝ :=
  fun i j => ∑ k : Fin r, c k * chi k i * chi k j

section DobrushinHelper

-- Match `UEOT.V3.FiniteDobrushin`'s canonical `DecidableEq` instance for `Matrix.rowStochastic`.
noncomputable local instance (priority := high) instClassicalDecEqProposal (S : Type*) :
    DecidableEq S :=
  Classical.decEq S

private lemma sector_diagonal_dobrushinAlpha_eq_one
    {S : Type} [Fintype S] [Nonempty S]
    (P : Matrix S S ℝ) (hP : P ∈ Matrix.rowStochastic ℝ S)
    (Q_top : S → ℤ) (s0 s1 : S) (hQneq : Q_top s0 ≠ Q_top s1)
    (hblock : ∀ i j : S, Q_top i ≠ Q_top j → P i j = 0) :
    dobrushinAlpha P hP = 1 := by
  let _ : MeasurableSpace S := ⊤
  have halpha_le : dobrushinAlpha P hP ≤ 1 := by
    unfold dobrushinAlpha
    refine Finset.sup'_le (Finset.univ_nonempty : (Finset.univ : Finset (S × S)).Nonempty) _ ?_
    intro _ _
    exact UEOT.V3.TotalVariation.tvDist_le_one _ _
  let A : Set S := {j | Q_top j = Q_top s0}
  have hrow_real : ∀ (u : S),
      (rowPMF P hP u).toMeasure.real A = ∑ y : S, (if y ∈ A then P u y else 0) := by
    intro u
    rw [MeasureTheory.measureReal_def, PMF.toMeasure_apply_fintype]
    rw [ENNReal.toReal_sum (fun y _ => by
      by_cases hy : y ∈ A
      · simp [Set.indicator, hy, PMF.apply_ne_top]
      · simp [Set.indicator, hy])]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    by_cases hy : y ∈ A
    · simp [Set.indicator, hy, rowPMF_toReal]
    · simp [Set.indicator, hy]
  have hs0_val : (rowPMF P hP s0).toMeasure.real A = 1 := by
    rw [hrow_real s0]
    have hsum_eq : (∑ y : S, if y ∈ A then P s0 y else 0) = ∑ y : S, P s0 y := by
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases hy : y ∈ A
      · simp [hy]
      · have hne : Q_top s0 ≠ Q_top y := by simpa [A, eq_comm] using hy
        simp [hy, hblock s0 y hne]
    rw [hsum_eq, Matrix.sum_row_of_mem_rowStochastic hP s0]
  have hs1_val : (rowPMF P hP s1).toMeasure.real A = 0 := by
    rw [hrow_real s1]
    refine Finset.sum_eq_zero (fun y _ => ?_)
    by_cases hy : y ∈ A
    · have hne : Q_top s1 ≠ Q_top y := by
        have hy0 : Q_top y = Q_top s0 := hy
        rw [hy0]; exact hQneq.symm
      simp [hy, hblock s1 y hne]
    · simp [hy]
  have hev := UEOT.V3.TotalVariation.tvEvent_le
    (rowPMF P hP s0).toMeasure (rowPMF P hP s1).toMeasure A MeasurableSet.of_discrete
  have hrow_eq : UEOT.V3.TotalVariation.tvDist
      (rowPMF P hP s0).toMeasure (rowPMF P hP s1).toMeasure = rowTV P hP s0 s1 := rfl
  rw [hs0_val, hs1_val, sub_zero, abs_one, hrow_eq] at hev
  exact le_antisymm halpha_le (le_trans hev (rowTV_le_dobrushinAlpha P hP s0 s1))

end DobrushinHelper

/-- **Finite-State Character Reflection Positivity vs. Topological Sector Freezing (`[C/B/P]`)**:
1. **Character-positive RP**: Whenever `∀ k, 0 ≤ c k`, `W = finiteCharacterKernel chi c` is
   symmetric and positive semidefinite (`∀ x, 0 ≤ x ⬝ (W *ᵥ x)`), and every Euclidean time power
   `W^m` (`m : ℕ`) remains reflection-positive! Conversely, any negative character coefficient
   `c k0 < 0` with an isolating mode `x` (`∀ k ≠ k0, x ⬝ chi k = 0` and `x ⬝ chi k0 ≠ 0`) violates RP
   (`x ⬝ (W *ᵥ x) < 0`).
2. **Topological sector freezing (continuous path barrier)**: If `Q_top : Config → ℤ` is constant on
   every path staying inside the admissible region `{z | u_max z < eps_adm}`, then any path `γ`
   connecting distinct sectors `Q_top (γ 0) ≠ Q_top (γ 1)` hits an inadmissible barrier
   `eps_adm ≤ u_max (γ t)` where `luscherBoltzmannWeight beta eps_adm (u_max (γ t)) = 0`.
3. **Topological sector freezing (Markov non-ergodicity)**: Any finite-state row-stochastic Markov
   kernel `P` on `S` preserving a partition `Q_top : S → ℤ` with at least two occupied sectors
   (`Q_top s0 ≠ Q_top s1`) has `dobrushinAlpha P hP = 1` and admits multiple invariant distributions
   (`δ_{s0}`-supported vs `δ_{s1}`-supported sector laws cannot mix). -/
theorem luscher_character_rp_vs_topological_freezing
    {r n : ℕ} (chi : Fin r → Fin n → ℝ) (c : Fin r → ℝ) :
    -- (1a) Nonnegative character weights => symmetric PSD & all T^m RP
    ((∀ k : Fin r, 0 ≤ c k) →
      let W := finiteCharacterKernel chi c
      Wᵀ = W ∧ ∀ m : ℕ, ∀ x : Fin n → ℝ, 0 ≤ dotProduct x ((W ^ m).mulVec x)) ∧
    -- (1b) Negative character coefficient => reflection positivity failure on isolating mode
    (∀ (k0 : Fin r) (x : Fin n → ℝ),
      c k0 < 0 → dotProduct x (chi k0) ≠ 0 →
      (∀ k : Fin r, k ≠ k0 → dotProduct x (chi k) = 0) →
      dotProduct x ((finiteCharacterKernel chi c).mulVec x) < 0) ∧
    -- (2) Continuous-path topological sector barrier => weight = 0 along barrier
    (∀ {Config : Type} (Q_top : Config → ℤ) (u_max : Config → ℝ)
      (beta eps_adm : ℝ) (γ : ℝ → Config),
      (∀ a b : ℝ, a ≤ b →
        (∀ t ∈ Set.Icc a b, u_max (γ t) < eps_adm) → Q_top (γ a) = Q_top (γ b)) →
      Q_top (γ 0) ≠ Q_top (γ 1) →
      ∃ t ∈ Set.Icc (0 : ℝ) 1,
        eps_adm ≤ u_max (γ t) ∧ luscherBoltzmannWeight beta eps_adm (u_max (γ t)) = 0) ∧
    -- (3) Sector-diagonal Markov chain has dobrushinAlpha = 1 & sector-confined laws
    (∀ {S : Type} [Fintype S] [Nonempty S] [DecidableEq S]
      (P : Matrix S S ℝ) (hP : P ∈ Matrix.rowStochastic ℝ S)
      (Q_top : S → ℤ) (s0 s1 : S),
      Q_top s0 ≠ Q_top s1 →
      (∀ i j : S, Q_top i ≠ Q_top j → P i j = 0) →
      dobrushinAlpha P hP = 1 ∧
        (∃ mu0 mu1 : stdSimplex ℝ S,
          mu0.1 s0 = 1 ∧ mu1.1 s1 = 1 ∧ mu0 ≠ mu1 ∧
          (∀ j, Q_top j ≠ Q_top s0 → (mu0.1 ᵥ* P) j = 0) ∧
          (∀ j, Q_top j ≠ Q_top s1 → (mu1.1 ᵥ* P) j = 0))) := by
  have hquad : ∀ x : Fin n → ℝ,
      dotProduct x ((finiteCharacterKernel chi c).mulVec x) =
        ∑ k : Fin r, c k * (dotProduct x (chi k)) ^ 2 := by
    intro x
    calc
      dotProduct x ((finiteCharacterKernel chi c).mulVec x)
          = ∑ i : Fin n, x i * ∑ j : Fin n, (∑ k : Fin r, c k * chi k i * chi k j) * x j := rfl
      _ = ∑ i : Fin n, ∑ j : Fin n, ∑ k : Fin r, c k * (x i * chi k i) * (x j * chi k j) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Finset.sum_mul, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun k _ => by ring)
      _ = ∑ i : Fin n, ∑ k : Fin r, ∑ j : Fin n, c k * (x i * chi k i) * (x j * chi k j) := by
            refine Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
      _ = ∑ k : Fin r, ∑ i : Fin n, ∑ j : Fin n, c k * (x i * chi k i) * (x j * chi k j) :=
            Finset.sum_comm
      _ = ∑ k : Fin r, c k * (dotProduct x (chi k)) ^ 2 := by
            refine Finset.sum_congr rfl (fun k _ => ?_)
            unfold dotProduct
            rw [sq, Finset.sum_mul, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Finset.mul_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => by ring)
  have hsymm : (finiteCharacterKernel chi c)ᵀ = finiteCharacterKernel chi c := by
    ext i j
    simp only [Matrix.transpose_apply, finiteCharacterKernel]
    refine Finset.sum_congr rfl (fun k _ => by ring)
  have hrp_pos : (∀ k : Fin r, 0 ≤ c k) →
      let W := finiteCharacterKernel chi c
      Wᵀ = W ∧ ∀ m : ℕ, ∀ x : Fin n → ℝ, 0 ≤ dotProduct x ((W ^ m).mulVec x) := by
    intro hc W
    have hW_psd : ∀ x : Fin n → ℝ, 0 ≤ dotProduct x (W.mulVec x) := by
      intro x
      dsimp [W]
      rw [hquad x]
      exact Finset.sum_nonneg (fun k _ => mul_nonneg (hc k) (sq_nonneg _))
    refine ⟨hsymm, ?_⟩
    intro m x
    -- Apply Wave 11's verified PSD-power theorem directly (zero duplication!)
    have hT := wilson_plaquette_transfer_positivity_and_strong_coupling_area_law
      (K := W) (T := W) hsymm hW_psd (uPlaq := 1 / 2) (C_W := 1) (R := 1) (fun _ => 0)
      (by norm_num) (by norm_num) (by norm_num) (le_refl 1)
      (fun t => by simp) (fun _ => 0) (fun _ => 0)
      (O_cont := 0) (c2 := 0) (C4 := 0) (aMax := 1) (a0 := 1)
      (by norm_num) (by norm_num) (by norm_num) (fun _ _ _ => by simp) (fun _ _ _ => by simp)
      (1 : Matrix (Fin 1) (Fin 1) ℂ) (by simp)
    exact hT.2.1 m x
  have hrp_neg : ∀ (k0 : Fin r) (x : Fin n → ℝ),
      c k0 < 0 → dotProduct x (chi k0) ≠ 0 →
      (∀ k : Fin r, k ≠ k0 → dotProduct x (chi k) = 0) →
      dotProduct x ((finiteCharacterKernel chi c).mulVec x) < 0 := by
    intro k0 x hck0 hxk0 hother
    rw [hquad x]
    have hsum_eq : ∑ k : Fin r, c k * (dotProduct x (chi k)) ^ 2 =
        c k0 * (dotProduct x (chi k0)) ^ 2 := by
      refine Finset.sum_eq_single k0 ?_ (fun h => absurd (Finset.mem_univ k0) h)
      intro k _ hk
      rw [hother k hk]
      ring
    rw [hsum_eq]
    exact mul_neg_of_neg_of_pos hck0 (sq_pos_of_ne_zero hxk0)
  have hpath_freeze : ∀ {Config : Type} (Q_top : Config → ℤ) (u_max : Config → ℝ)
      (beta eps_adm : ℝ) (γ : ℝ → Config),
      (∀ a b : ℝ, a ≤ b →
        (∀ t ∈ Set.Icc a b, u_max (γ t) < eps_adm) → Q_top (γ a) = Q_top (γ b)) →
      Q_top (γ 0) ≠ Q_top (γ 1) →
      ∃ t ∈ Set.Icc (0 : ℝ) 1,
        eps_adm ≤ u_max (γ t) ∧ luscherBoltzmannWeight beta eps_adm (u_max (γ t)) = 0 := by
    intro Config Q_top u_max beta eps_adm γ hconst hneq
    by_contra hnone
    push Not at hnone
    have hadm : ∀ t ∈ Set.Icc (0 : ℝ) 1, u_max (γ t) < eps_adm := by
      intro t ht
      by_contra hge
      push Not at hge
      exact (hnone t ht hge) (by unfold luscherBoltzmannWeight; rw [if_neg (fun h => not_lt_of_ge hge h.2)])
    exact hneq (hconst 0 1 (by norm_num) hadm)
  have hmarkov_freeze : ∀ {S : Type} [Fintype S] [Nonempty S] [DecidableEq S]
      (P : Matrix S S ℝ) (hP : P ∈ Matrix.rowStochastic ℝ S)
      (Q_top : S → ℤ) (s0 s1 : S),
      Q_top s0 ≠ Q_top s1 →
      (∀ i j : S, Q_top i ≠ Q_top j → P i j = 0) →
      dobrushinAlpha P hP = 1 ∧
        (∃ mu0 mu1 : stdSimplex ℝ S,
          mu0.1 s0 = 1 ∧ mu1.1 s1 = 1 ∧ mu0 ≠ mu1 ∧
          (∀ j, Q_top j ≠ Q_top s0 → (mu0.1 ᵥ* P) j = 0) ∧
          (∀ j, Q_top j ≠ Q_top s1 → (mu1.1 ᵥ* P) j = 0)) := by
    intro S _ _ instDec P hP Q_top s0 s1 hQneq hblock
    have halpha_eq : dobrushinAlpha P hP = 1 := by
      have hsub : instDec = Classical.decEq S := Subsingleton.elim _ _
      cases hsub
      exact sector_diagonal_dobrushinAlpha_eq_one P hP Q_top s0 s1 hQneq hblock
    let mu0 : stdSimplex ℝ S :=
      ⟨fun j => if j = s0 then 1 else 0,
       ⟨fun j => by dsimp only; split_ifs <;> norm_num, by simp⟩⟩
    let mu1 : stdSimplex ℝ S :=
      ⟨fun j => if j = s1 then 1 else 0,
       ⟨fun j => by dsimp only; split_ifs <;> norm_num, by simp⟩⟩
    have hmu_ne : mu0 ≠ mu1 := by
      intro h
      have hval : mu0.1 s0 = mu1.1 s0 := congrArg (fun m => m.1 s0) h
      have hs0_ne : s0 ≠ s1 := fun heq => hQneq (congrArg Q_top heq)
      simp [mu0, mu1, hs0_ne] at hval
    have hconf0 : ∀ j, Q_top j ≠ Q_top s0 → (mu0.1 ᵥ* P) j = 0 := by
      intro j hj
      unfold Matrix.vecMul dotProduct
      simp [mu0, hblock s0 j (Ne.symm hj)]
    have hconf1 : ∀ j, Q_top j ≠ Q_top s1 → (mu1.1 ᵥ* P) j = 0 := by
      intro j hj
      unfold Matrix.vecMul dotProduct
      simp [mu1, hblock s1 j (Ne.symm hj)]
    refine ⟨halpha_eq, ⟨mu0, mu1, by simp [mu0], by simp [mu1], hmu_ne, hconf0, hconf1⟩⟩
  exact ⟨hrp_pos, hrp_neg, hpath_freeze, hmarkov_freeze⟩

/-! ## Part (c): Strategy C2 — Two-Scale Smeared Fermion Links (`[B/P/X]`) -/

/-- Coarse fermion smearing scale `a_ferm(a_gauge) = a_gauge^α` (`0 < α < 1`). `[B/P]` -/
noncomputable def smearedFermionScale (alpha a_gauge : ℝ) : ℝ :=
  a_gauge ^ alpha

/-- Block-averaged 1-loop inverse squared coupling at the smeared fermion scale `a_ferm`. `[B/P]` -/
noncomputable def smearedEffInvG2 (b0 Lambda alpha a_gauge : ℝ) : ℝ :=
  (2 * b0 / (16 * Real.pi ^ 2)) * Real.log (1 / (smearedFermionScale alpha a_gauge * Lambda))

/-- Block-averaged effective squared coupling `g_eff^2(a_ferm)` at the smeared fermion scale. `[B/P]` -/
noncomputable def smearedEffG2 (b0 Lambda alpha a_gauge : ℝ) : ℝ :=
  (smearedEffInvG2 b0 Lambda alpha a_gauge)⁻¹

/-- **Strategy C2: Two-Scale Smeared Fermion Links & KP Threshold Suppression (`[B/P]`)**:
For any `0 < alpha < 1`, `b0 > 0`, `Lambda > 0`, `K_ent > 1`, `mu > 0`, `eps > 0`, `c_lf > 0`:
1. On `0 < a_gauge < 1`: `a_gauge < a_ferm(a_gauge) < 1`, while continuously as `a_gauge → 0⁺`:
   - `a_ferm(a_gauge) → 0` (continuum fermion cutoff removal),
   - `a_ferm(a_gauge) / a_gauge = a_gauge^{α - 1} → +∞` (unbounded smearing/blocking depth),
2. `smearedEffInvG2 b0 Lambda alpha a_gauge → +∞` and `smearedEffG2 b0 Lambda alpha a_gauge → 0`
   continuously as `a_gauge → 0⁺`,
3. For any target KP threshold `g_KP2 > 0`, there exists `a_crit > 0` such that for all
   `0 < a_gauge ≤ a_crit`, `0 < smearedEffG2 b0 Lambda alpha a_gauge ≤ g_KP2`, and specifically
   for `g_KP2 = min (eps^2 / (log K_ent + mu)) ((c_lf / (log K_ent + mu))^2)` both fixed-cutoff
   and Balaban KP polymer suppression inequalities hold at `a_ferm` without assuming `DEAD-20261124-01`. -/
theorem two_scale_smeared_links_kp_suppression_regime
    {alpha b0 Lambda K_ent mu eps c_lf : ℝ}
    (halpha0 : 0 < alpha) (halpha1 : alpha < 1)
    (hb0 : 0 < b0) (hLam : 0 < Lambda)
    (hKent : 1 < K_ent) (hmu : 0 < mu) (heps : 0 < eps) (hclf : 0 < c_lf) :
    (∀ a_g : ℝ, 0 < a_g → a_g < 1 →
      a_g < smearedFermionScale alpha a_g ∧ smearedFermionScale alpha a_g < 1 ∧
      smearedFermionScale alpha a_g / a_g = a_g ^ (alpha - 1)) ∧
    Filter.Tendsto (smearedFermionScale alpha) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) ∧
    Filter.Tendsto (fun a_g : ℝ => smearedFermionScale alpha a_g / a_g)
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop ∧
    Filter.Tendsto (smearedEffInvG2 b0 Lambda alpha) (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop ∧
    Filter.Tendsto (smearedEffG2 b0 Lambda alpha) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) ∧
    (∀ g_KP2 : ℝ, 0 < g_KP2 →
      ∃ a_crit : ℝ, 0 < a_crit ∧ a_crit < 1 ∧
        ∀ a_g : ℝ, 0 < a_g → a_g ≤ a_crit →
          smearedFermionScale alpha a_g * Lambda < 1 ∧
          0 < smearedEffG2 b0 Lambda alpha a_g ∧
          smearedEffG2 b0 Lambda alpha a_g ≤ g_KP2) ∧
    (∃ a_crit : ℝ, 0 < a_crit ∧ a_crit < 1 ∧
      ∀ a_g : ℝ, 0 < a_g → a_g ≤ a_crit →
        let g2 := smearedEffG2 b0 Lambda alpha a_g
        0 < g2 ∧
        K_ent * Real.exp mu * Real.exp (-(eps ^ 2 / g2)) ≤ 1 ∧
        K_ent * Real.exp mu * Real.exp (-(c_lf / Real.sqrt g2)) ≤ 1) := by
  have hscale_ord : ∀ a_g : ℝ, 0 < a_g → a_g < 1 →
      a_g < smearedFermionScale alpha a_g ∧ smearedFermionScale alpha a_g < 1 ∧
      smearedFermionScale alpha a_g / a_g = a_g ^ (alpha - 1) := by
    intro a_g hag0 hag1
    unfold smearedFermionScale
    have hlt_left : a_g ^ (1 : ℝ) < a_g ^ alpha :=
      Real.rpow_lt_rpow_of_exponent_gt hag0 hag1 halpha1
    rw [Real.rpow_one] at hlt_left
    have hlt_right : a_g ^ alpha < 1 :=
      Real.rpow_lt_one (le_of_lt hag0) hag1 halpha0
    have hdiv : a_g ^ alpha / a_g = a_g ^ (alpha - 1) := by
      have hr1 : a_g = a_g ^ (1 : ℝ) := (Real.rpow_one a_g).symm
      conv_lhs => rhs; rw [hr1]
      rw [← Real.rpow_sub hag0]
    exact ⟨hlt_left, hlt_right, hdiv⟩
  have htend_ferm_zero :
      Filter.Tendsto (smearedFermionScale alpha) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    unfold smearedFermionScale
    rw [Metric.tendsto_nhdsWithin_nhds]
    intro eps_t heps_t
    let delta : ℝ := eps_t ^ (1 / alpha)
    have hdelta_pos : 0 < delta := Real.rpow_pos_of_pos heps_t (1 / alpha)
    refine ⟨delta, hdelta_pos, fun x hx0 hxd => ?_⟩
    have hx_pos : 0 < x := hx0
    have hx_lt : x < delta := by
      rw [Real.dist_eq, sub_zero, abs_of_pos hx_pos] at hxd
      exact hxd
    have hx_rpow_lt : x ^ alpha < delta ^ alpha :=
      Real.rpow_lt_rpow (le_of_lt hx_pos) hx_lt halpha0
    have hdelta_pow : delta ^ alpha = eps_t := by
      dsimp [delta]
      rw [← Real.rpow_mul (le_of_lt heps_t), one_div_mul_cancel (ne_of_gt halpha0), Real.rpow_one]
    rw [hdelta_pow] at hx_rpow_lt
    rw [Real.dist_eq, sub_zero, abs_of_pos (Real.rpow_pos_of_pos hx_pos alpha)]
    exact hx_rpow_lt
  have htend_ratio_top : Filter.Tendsto (fun a_g : ℝ => smearedFermionScale alpha a_g / a_g)
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop := by
    have hpos_exp : 0 < 1 - alpha := sub_pos.mpr halpha1
    have htend_inv : Filter.Tendsto (fun a_g : ℝ => (a_g⁻¹) ^ (1 - alpha))
        (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop :=
      (tendsto_rpow_atTop hpos_exp).comp tendsto_inv_nhdsIoi_zero_atTop
    refine htend_inv.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with a_g (hag0 : 0 < a_g)
    unfold smearedFermionScale
    have hinv_eq : (a_g⁻¹) ^ (1 - alpha) = a_g ^ (alpha - 1) := by
      rw [Real.inv_rpow (le_of_lt hag0), ← Real.rpow_neg (le_of_lt hag0)]
      congr 1; ring
    have hdiv : a_g ^ alpha / a_g = a_g ^ (alpha - 1) := by
      have hr1 : a_g = a_g ^ (1 : ℝ) := (Real.rpow_one a_g).symm
      conv_lhs => rhs; rw [hr1]
      rw [← Real.rpow_sub hag0]
    rw [hinv_eq, hdiv]
  have htend_invG2_top :
      Filter.Tendsto (smearedEffInvG2 b0 Lambda alpha) (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop := by
    have hmul_zero : Filter.Tendsto (fun a_g : ℝ => smearedFermionScale alpha a_g * Lambda)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (0 * Lambda)) :=
      htend_ferm_zero.mul_const Lambda
    rw [zero_mul] at hmul_zero
    have hmul_Ioi : Filter.Tendsto (fun a_g : ℝ => smearedFermionScale alpha a_g * Lambda)
        (nhdsWithin 0 (Set.Ioi 0)) (nhdsWithin 0 (Set.Ioi 0)) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨hmul_zero, ?_⟩
      filter_upwards [self_mem_nhdsWithin] with a_g (hag0 : 0 < a_g)
      exact mul_pos (Real.rpow_pos_of_pos hag0 alpha) hLam
    have hdiv_top : Filter.Tendsto (fun a_g : ℝ => 1 / (smearedFermionScale alpha a_g * Lambda))
        (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop := by
      refine (tendsto_inv_nhdsIoi_zero_atTop.comp hmul_Ioi).congr ?_
      intro a_g
      exact (one_div _).symm
    have hlog_top : Filter.Tendsto
        (fun a_g : ℝ => Real.log (1 / (smearedFermionScale alpha a_g * Lambda)))
        (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop :=
      Real.tendsto_log_atTop.comp hdiv_top
    have hc_pos : 0 < 2 * b0 / (16 * Real.pi ^ 2) := by positivity
    exact Filter.Tendsto.const_mul_atTop hc_pos hlog_top
  have htend_G2_zero :
      Filter.Tendsto (smearedEffG2 b0 Lambda alpha) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) :=
    tendsto_inv_atTop_zero.comp htend_invG2_top
  have hkp_window : ∀ g_KP2 : ℝ, 0 < g_KP2 →
      ∃ a_crit : ℝ, 0 < a_crit ∧ a_crit < 1 ∧
        ∀ a_g : ℝ, 0 < a_g → a_g ≤ a_crit →
          smearedFermionScale alpha a_g * Lambda < 1 ∧
          0 < smearedEffG2 b0 Lambda alpha a_g ∧
          smearedEffG2 b0 Lambda alpha a_g ≤ g_KP2 := by
    intro g_KP2 hgKP
    let L_req : ℝ := (16 * Real.pi ^ 2) / (2 * b0 * g_KP2)
    have hLreq_pos : 0 < L_req := by dsimp [L_req]; positivity
    let target_ferm : ℝ := Lambda⁻¹ * Real.exp (-L_req)
    have htf_pos : 0 < target_ferm := mul_pos (inv_pos.mpr hLam) (Real.exp_pos _)
    let a_raw : ℝ := target_ferm ^ (1 / alpha)
    have haraw_pos : 0 < a_raw := Real.rpow_pos_of_pos htf_pos _
    let a_crit : ℝ := min (1 / 2) a_raw
    have hac_pos : 0 < a_crit := lt_min (by norm_num) haraw_pos
    have hac_lt1 : a_crit < 1 := lt_of_le_of_lt (min_le_left _ _) (by norm_num)
    refine ⟨a_crit, hac_pos, hac_lt1, fun a_g hag0 hag_le => ?_⟩
    have hag_le_raw : a_g ≤ a_raw := le_trans hag_le (min_le_right _ _)
    have hferm_le : smearedFermionScale alpha a_g ≤ target_ferm := by
      unfold smearedFermionScale
      have hpow_le : a_g ^ alpha ≤ a_raw ^ alpha :=
        Real.rpow_le_rpow (le_of_lt hag0) hag_le_raw (le_of_lt halpha0)
      have haraw_pow : a_raw ^ alpha = target_ferm := by
        dsimp [a_raw]
        rw [← Real.rpow_mul (le_of_lt htf_pos), one_div_mul_cancel (ne_of_gt halpha0), Real.rpow_one]
      exact hpow_le.trans_eq haraw_pow
    have hprod_le : smearedFermionScale alpha a_g * Lambda ≤ Real.exp (-L_req) := by
      have h1 : smearedFermionScale alpha a_g * Lambda ≤ target_ferm * Lambda :=
        mul_le_mul_of_nonneg_right hferm_le (le_of_lt hLam)
      have h2 : target_ferm * Lambda = Real.exp (-L_req) := by
        dsimp [target_ferm]
        field_simp [ne_of_gt hLam]
      exact h1.trans_eq h2
    have hprod_pos : 0 < smearedFermionScale alpha a_g * Lambda := by
      unfold smearedFermionScale; exact mul_pos (Real.rpow_pos_of_pos hag0 alpha) hLam
    have hexp_lt1 : Real.exp (-L_req) < 1 := Real.exp_lt_one_iff.mpr (neg_neg_of_pos hLreq_pos)
    have hprod_lt1 : smearedFermionScale alpha a_g * Lambda < 1 :=
      lt_of_le_of_lt hprod_le hexp_lt1
    have hinv_ge_exp : Real.exp L_req ≤ 1 / (smearedFermionScale alpha a_g * Lambda) := by
      have hexp_inv : Real.exp L_req = (Real.exp (-L_req))⁻¹ := by
        rw [Real.exp_neg, inv_inv]
      rw [one_div, hexp_inv]
      exact (inv_le_inv₀ (Real.exp_pos (-L_req)) hprod_pos).mpr hprod_le
    have hlog_ge : L_req ≤ Real.log (1 / (smearedFermionScale alpha a_g * Lambda)) := by
      have := Real.log_le_log (Real.exp_pos L_req) hinv_ge_exp
      rwa [Real.log_exp] at this
    have hc_pos : 0 < 2 * b0 / (16 * Real.pi ^ 2) := by positivity
    have hinvG2_ge : 1 / g_KP2 ≤ smearedEffInvG2 b0 Lambda alpha a_g := by
      unfold smearedEffInvG2
      have h1 : (2 * b0 / (16 * Real.pi ^ 2)) * L_req ≤
          (2 * b0 / (16 * Real.pi ^ 2)) * Real.log (1 / (smearedFermionScale alpha a_g * Lambda)) :=
        mul_le_mul_of_nonneg_left hlog_ge (le_of_lt hc_pos)
      have h2 : (2 * b0 / (16 * Real.pi ^ 2)) * L_req = 1 / g_KP2 := by
        dsimp [L_req]; field_simp [ne_of_gt hb0, ne_of_gt hgKP, Real.pi_ne_zero]
      linarith
    have hinvG2_pos : 0 < smearedEffInvG2 b0 Lambda alpha a_g :=
      lt_of_lt_of_le (one_div_pos.mpr hgKP) hinvG2_ge
    have hG2_pos : 0 < smearedEffG2 b0 Lambda alpha a_g := inv_pos.mpr hinvG2_pos
    have hG2_le : smearedEffG2 b0 Lambda alpha a_g ≤ g_KP2 := by
      unfold smearedEffG2
      have hinv := inv_anti₀ (one_div_pos.mpr hgKP) hinvG2_ge
      simpa [one_div] using hinv
    exact ⟨hprod_lt1, hG2_pos, hG2_le⟩
  have hkp_poly : ∃ a_crit : ℝ, 0 < a_crit ∧ a_crit < 1 ∧
      ∀ a_g : ℝ, 0 < a_g → a_g ≤ a_crit →
        let g2 := smearedEffG2 b0 Lambda alpha a_g
        0 < g2 ∧
        K_ent * Real.exp mu * Real.exp (-(eps ^ 2 / g2)) ≤ 1 ∧
        K_ent * Real.exp mu * Real.exp (-(c_lf / Real.sqrt g2)) ≤ 1 := by
    let barrier : ℝ := Real.log K_ent + mu
    have hbar_pos : 0 < barrier := by
      dsimp [barrier]; linarith [Real.log_pos hKent]
    let g_KP2 : ℝ := min (eps ^ 2 / barrier) ((c_lf / barrier) ^ 2)
    have hgKP_pos : 0 < g_KP2 := by dsimp [g_KP2]; positivity
    obtain ⟨a_crit, hac_pos, hac_lt1, hwin⟩ := hkp_window g_KP2 hgKP_pos
    have hmult := multiscale_polymer_kp_threshold_and_scale_sum
      (K_ent := K_ent) (mu := mu) (eps := eps) (c_lf := c_lf)
      (b0 := b0) (L_blk := 2) (gK2 := 1)
      hKent hmu heps hclf hb0 (by norm_num) (by norm_num)
    refine ⟨a_crit, hac_pos, hac_lt1, fun a_g hag0 hag_le => ?_⟩
    obtain ⟨_, hg2_pos, hg2_le⟩ := hwin a_g hag0 hag_le
    have hg2_le1 : smearedEffG2 b0 Lambda alpha a_g ≤ eps ^ 2 / barrier :=
      le_trans hg2_le (min_le_left _ _)
    have hg2_le2 : smearedEffG2 b0 Lambda alpha a_g ≤ (c_lf / barrier) ^ 2 :=
      le_trans hg2_le (min_le_right _ _)
    exact ⟨hg2_pos, hmult.1 _ hg2_pos hg2_le1, hmult.2.1 _ hg2_pos hg2_le2⟩
  exact ⟨hscale_ord, htend_ferm_zero, htend_ratio_top, htend_invG2_top, htend_G2_zero,
    hkp_window, hkp_poly⟩

