/-! ## 1. Finite Probability Weights, Expectation, Variance & Efron–Stein (`C/B/P`) -/

/-- A finite probability weight on `S`. `[C/B]` -/
def IsProbWeight {S : Type*} [Fintype S] (μ : S → ℝ) : Prop :=
  (∀ x : S, 0 ≤ μ x) ∧ (∑ x : S, μ x = 1)

/-- Expectation of `f` under finite weight `μ`. `[C/B]` -/
noncomputable def expVal {S : Type*} [Fintype S] (μ : S → ℝ) (f : S → ℝ) : ℝ :=
  ∑ x : S, μ x * f x

/-- Variance of `f` under finite weight `μ`. `[C/B]` -/
noncomputable def varProb {S : Type*} [Fintype S] (μ : S → ℝ) (f : S → ℝ) : ℝ :=
  expVal μ (fun x => (f x - expVal μ f) ^ 2)

/-- Covariance of `f` and `g` under finite weight `μ`. `[C/B]` -/
noncomputable def covProb {S : Type*} [Fintype S] (μ : S → ℝ) (f g : S → ℝ) : ℝ :=
  expVal μ (fun x => (f x - expVal μ f) * (g x - expVal μ g))

/-- Two-factor product weight `μA ⊗ μB`. `[C/B]` -/
def prodWeight {A B : Type*} (μA : A → ℝ) (μB : B → ℝ) : A × B → ℝ :=
  fun p => μA p.1 * μB p.2

/-- `M`-fold product weight `∏ i, μ i (x i)` on `Fin M → Q`. `[C/B]` -/
def piProdWeight {M : ℕ} {Q : Type*} (μ : Fin M → Q → ℝ) : (Fin M → Q) → ℝ :=
  fun x => ∏ i : Fin M, μ i (x i)

/-- Single-coordinate slice `q ↦ f (update x i q)`. `[C/B]` -/
def condSlice {M : ℕ} {Q : Type*} [DecidableEq (Fin M)]
    (f : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) : Q → ℝ :=
  fun q => f (Function.update x i q)

/-- Symmetric finite-state Dirichlet form associated with transition weights `w`. `[B/P]` -/
noncomputable def edgeDirichlet {S : Type*} [Fintype S]
    (μ : S → ℝ) (w : S → S → ℝ) (f : S → ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∑ x : S, ∑ y : S, μ x * w x y * (f y - f x) ^ 2

/-- Product-space single-site Glauber Dirichlet form `∑ i, E_{μ^{⊗ M}}[E_i(condSlice f i x)]`. `[B/P]` -/
noncomputable def glauberDirichlet {M : ℕ} {Q : Type*} [Fintype Q] [DecidableEq (Fin M)]
    (μ : Fin M → Q → ℝ) (w : Fin M → Q → Q → ℝ) (f : (Fin M → Q) → ℝ) : ℝ :=
  ∑ i : Fin M, expVal (piProdWeight μ) (fun x => edgeDirichlet (μ i) (w i) (condSlice f i x))

lemma expVal_const {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ) (c : ℝ) :
    expVal μ (fun _ => c) = c := by
  simp [expVal, ← Finset.sum_mul, hμ.2]

lemma expVal_nonneg {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    {f : S → ℝ} (hf : ∀ x, 0 ≤ f x) :
    0 ≤ expVal μ f :=
  Finset.sum_nonneg (fun x _ => mul_nonneg (hμ.1 x) (hf x))

lemma expVal_mono {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    {f g : S → ℝ} (hfg : ∀ x, f x ≤ g x) :
    expVal μ f ≤ expVal μ g :=
  Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (hfg x) (hμ.1 x))

lemma expVal_add {S : Type*} [Fintype S] (μ f g : S → ℝ) :
    expVal μ (fun x => f x + g x) = expVal μ f + expVal μ g := by
  simp only [expVal, mul_add, Finset.sum_add_distrib]

lemma expVal_sub {S : Type*} [Fintype S] (μ f g : S → ℝ) :
    expVal μ (fun x => f x - g x) = expVal μ f - expVal μ g := by
  simp only [expVal, mul_sub, Finset.sum_sub_distrib]

lemma expVal_smul {S : Type*} [Fintype S] (μ : S → ℝ) (c : ℝ) (f : S → ℝ) :
    expVal μ (fun x => c * f x) = c * expVal μ f := by
  simp only [expVal, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun x _ => by ring)

lemma varProb_nonneg {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ) (f : S → ℝ) :
    0 ≤ varProb μ f :=
  expVal_nonneg hμ (fun _ => sq_nonneg _)

lemma expVal_sq_sub_const_eq {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    (f : S → ℝ) (c : ℝ) :
    expVal μ (fun x => (f x - c) ^ 2) = varProb μ f + (expVal μ f - c) ^ 2 := by
  set m := expVal μ f
  have h1 : (fun x => (f x - c) ^ 2) =
      fun x => (f x - m) ^ 2 + 2 * (m - c) * (f x - m) + (m - c) ^ 2 := by
    funext x; ring
  rw [h1, expVal_add, expVal_add, expVal_smul, expVal_sub, expVal_const hμ, expVal_const hμ]
  dsimp [m, varProb]
  ring

lemma varProb_le_sq_sub_const {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    (f : S → ℝ) (c : ℝ) :
    varProb μ f ≤ expVal μ (fun x => (f x - c) ^ 2) := by
  rw [expVal_sq_sub_const_eq hμ f c]
  linarith [sq_nonneg (expVal μ f - c)]

lemma varProb_eq_expVal_sq_sub_sq {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    (f : S → ℝ) :
    varProb μ f = expVal μ (fun x => (f x) ^ 2) - (expVal μ f) ^ 2 := by
  have h := expVal_sq_sub_const_eq hμ f 0
  simp only [sub_zero] at h
  linarith

lemma jensen_sq_le {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ) (f : S → ℝ) :
    (expVal μ f) ^ 2 ≤ expVal μ (fun x => (f x) ^ 2) := by
  have h := varProb_nonneg hμ f
  rw [varProb_eq_expVal_sq_sub_sq hμ f] at h
  linarith

lemma covProb_sq_le {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    (f g : S → ℝ) :
    (covProb μ f g) ^ 2 ≤ varProb μ f * varProb μ g := by
  set a := varProb μ g
  set b := covProb μ f g
  set c := varProb μ f
  have ha_nn : 0 ≤ a := varProb_nonneg hμ g
  have hpoly : ∀ s : ℝ, 0 ≤ a * s ^ 2 + 2 * b * s + c := by
    intro s
    have hnn : 0 ≤ expVal μ (fun x => ((f x - expVal μ f) + s * (g x - expVal μ g)) ^ 2) :=
      expVal_nonneg hμ (fun _ => sq_nonneg _)
    have hexp : expVal μ (fun x => ((f x - expVal μ f) + s * (g x - expVal μ g)) ^ 2) =
        a * s ^ 2 + 2 * b * s + c := by
      have hterm : ∀ x, μ x * ((f x - expVal μ f) + s * (g x - expVal μ g)) ^ 2 =
          (s ^ 2) * (μ x * (g x - expVal μ g) ^ 2) +
          (2 * s) * (μ x * ((f x - expVal μ f) * (g x - expVal μ g))) +
          μ x * (f x - expVal μ f) ^ 2 := fun x => by ring
      change ∑ x : S, μ x * ((f x - expVal μ f) + s * (g x - expVal μ g)) ^ 2 = _
      simp_rw [hterm]
      rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
      dsimp [a, b, c, varProb, covProb, expVal]
      ring
    linarith
  rcases ha_nn.eq_or_lt with ha0 | ha_pos
  · have hb0 : b = 0 := by
      by_contra hne
      have hval := hpoly (-(c + 1) / (2 * b))
      have hb_ne : 2 * b ≠ 0 := mul_ne_zero (by norm_num) hne
      have hlin : a * (-(c + 1) / (2 * b)) ^ 2 + 2 * b * (-(c + 1) / (2 * b)) + c = -1 := by
        rw [← ha0, zero_mul, zero_add, mul_div_cancel₀ _ hb_ne]; ring
      linarith
    rw [hb0, ← ha0]; norm_num
  · have hmin := hpoly (-b / a)
    have ha_ne : a ≠ 0 := ne_of_gt ha_pos
    have hid : a * (-b / a) ^ 2 + 2 * b * (-b / a) + c = (a * c - b ^ 2) / a := by
      rw [eq_div_iff ha_ne]; field_simp [ha_ne]; ring
    rw [hid] at hmin
    have hnum : 0 ≤ a * c - b ^ 2 :=
      (div_nonneg_iff.mp hmin).elim (fun h => h.1) (fun h => absurd h.2 (by linarith))
    linarith

lemma edgeDirichlet_nonneg {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    {w : S → S → ℝ} (hw : ∀ x y, 0 ≤ w x y) (f : S → ℝ) :
    0 ≤ edgeDirichlet μ w f := by
  unfold edgeDirichlet
  refine mul_nonneg (by norm_num) (Finset.sum_nonneg (fun x _ => Finset.sum_nonneg (fun y _ => ?_)))
  exact mul_nonneg (mul_nonneg (hμ.1 x) (hw x y)) (sq_nonneg _)

lemma isProbWeight_prodWeight {A B : Type*} [Fintype A] [Fintype B]
    {μA : A → ℝ} {μB : B → ℝ} (hA : IsProbWeight μA) (hB : IsProbWeight μB) :
    IsProbWeight (prodWeight μA μB) := by
  refine ⟨fun p => mul_nonneg (hA.1 p.1) (hB.1 p.2), ?_⟩
  rw [Fintype.sum_prod_type]
  simp only [prodWeight, ← Finset.mul_sum, hB.2, mul_one, hA.2]

lemma expVal_prodWeight {A B : Type*} [Fintype A] [Fintype B]
    (μA : A → ℝ) (μB : B → ℝ) (f : A × B → ℝ) :
    expVal (prodWeight μA μB) f = expVal μA (fun a => expVal μB (fun b => f (a, b))) := by
  unfold expVal prodWeight
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun b _ => by ring)

lemma expVal_prodWeight_comm {A B : Type*} [Fintype A] [Fintype B]
    (μA : A → ℝ) (μB : B → ℝ) (f : A × B → ℝ) :
    expVal (prodWeight μA μB) f = expVal μB (fun b => expVal μA (fun a => f (a, b))) := by
  rw [expVal_prodWeight]
  unfold expVal
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl (fun a _ => by ring))

/-- **Two-Factor Efron–Stein Variance Decomposition (`C/B/P`)**:
`Var_{μA ⊗ μB}(f) ≤ E_A[Var_B(f(a, ·))] + E_B[Var_A(f(·, b))]`. -/
theorem efron_stein_two_factor_le {A B : Type*} [Fintype A] [Fintype B]
    {μA : A → ℝ} {μB : B → ℝ} (hA : IsProbWeight μA) (hB : IsProbWeight μB)
    (f : A × B → ℝ) :
    varProb (prodWeight μA μB) f ≤
      expVal μA (fun a => varProb μB (fun b => f (a, b))) +
      expVal μB (fun b => varProb μA (fun a => f (a, b))) := by
  let gA : B → ℝ := fun b => expVal μA (fun a => f (a, b))
  have hm : expVal (prodWeight μA μB) f = expVal μB gA := expVal_prodWeight_comm μA μB f
  have hlaw : varProb (prodWeight μA μB) f =
      expVal μB (fun b => varProb μA (fun a => f (a, b))) + varProb μB gA := by
    unfold varProb
    rw [expVal_prodWeight_comm μA μB]
    have hsplit : ∀ b : B,
        expVal μA (fun a => (f (a, b) - expVal (prodWeight μA μB) f) ^ 2) =
        varProb μA (fun a => f (a, b)) + (gA b - expVal μB gA) ^ 2 := by
      intro b
      rw [hm]
      exact expVal_sq_sub_const_eq hA (fun a => f (a, b)) (expVal μB gA)
    simp_rw [hsplit, expVal_add]
    rfl
  have hjensen : varProb μB gA ≤ expVal μA (fun a => varProb μB (fun b => f (a, b))) := by
    have hdiff : ∀ b : B, gA b - expVal μB gA =
        expVal μA (fun a => f (a, b) - expVal μB (fun b' => f (a, b'))) := by
      intro b
      have hcomm : expVal μB gA = expVal μA (fun a => expVal μB (fun b' => f (a, b'))) := by
        rw [← hm, expVal_prodWeight]
      rw [hcomm, ← expVal_sub]
    have hpt : ∀ b : B, (gA b - expVal μB gA) ^ 2 ≤
        expVal μA (fun a => (f (a, b) - expVal μB (fun b' => f (a, b'))) ^ 2) := by
      intro b
      rw [hdiff b]
      exact jensen_sq_le hA _
    have hswap : expVal μB (fun b => expVal μA (fun a => (f (a, b) - expVal μB (fun b' => f (a, b'))) ^ 2)) =
        expVal μA (fun a => varProb μB (fun b => f (a, b))) := by
      let h : A × B → ℝ := fun p => (f p - expVal μB (fun b' => f (p.1, b'))) ^ 2
      change expVal μB (fun b => expVal μA (fun a => h (a, b))) =
        expVal μA (fun a => expVal μB (fun b => h (a, b)))
      rw [← expVal_prodWeight_comm, ← expVal_prodWeight]
    calc varProb μB gA
        = expVal μB (fun b => (gA b - expVal μB gA) ^ 2) := rfl
      _ ≤ expVal μB (fun b => expVal μA (fun a => (f (a, b) - expVal μB (fun b' => f (a, b'))) ^ 2)) :=
          expVal_mono hB hpt
      _ = expVal μA (fun a => varProb μB (fun b => f (a, b))) := hswap
  linarith

private def consEquiv (M : ℕ) (Q : Type*) : (Q × (Fin M → Q)) ≃ (Fin (M + 1) → Q) where
  toFun := fun p => Fin.cons (α := fun _ => Q) p.1 p.2
  invFun := fun x => (x 0, Fin.tail x)
  left_inv := fun ⟨q, y⟩ => by
    ext j
    · simp
    · simp [Fin.tail_cons]
  right_inv := fun x => by
    ext i
    refine Fin.cases ?_ ?_ i
    · simp
    · intro j; simp [Fin.tail]

lemma isProbWeight_piProdWeight :
    ∀ {M : ℕ} {Q : Type*} [Fintype Q] (μ : Fin M → Q → ℝ),
      (∀ i : Fin M, IsProbWeight (μ i)) → IsProbWeight (piProdWeight μ)
  | 0, Q, _, μ, _ => by
      refine ⟨fun x => by simp [piProdWeight], ?_⟩
      simp [piProdWeight]
  | M + 1, Q, _, μ, hμ => by
      let e := consEquiv M Q
      let μtail : Fin M → Q → ℝ := fun j => μ j.succ
      have htail : IsProbWeight (piProdWeight μtail) :=
        isProbWeight_piProdWeight μtail (fun j => hμ j.succ)
      have hprod : IsProbWeight (prodWeight (μ 0) (piProdWeight μtail)) :=
        isProbWeight_prodWeight (hμ 0) htail
      have hpi_eq : ∀ p : Q × (Fin M → Q),
          piProdWeight μ (e p) = prodWeight (μ 0) (piProdWeight μtail) p := by
        intro p
        simp [piProdWeight, prodWeight, μtail, e, consEquiv, Fin.prod_univ_succ]
      refine ⟨fun x => Finset.prod_nonneg (fun i _ => (hμ i).1 (x i)), ?_⟩
      rw [← Fintype.sum_equiv e _ (fun x => piProdWeight μ x) (fun _ => rfl)]
      simp_rw [hpi_eq]
      exact hprod.2

lemma expVal_piProdWeight_succ {M : ℕ} {Q : Type*} [Fintype Q]
    (μ : Fin (M + 1) → Q → ℝ) (f : (Fin (M + 1) → Q) → ℝ) :
    expVal (piProdWeight μ) f =
      expVal (μ 0) (fun q0 => expVal (piProdWeight (fun j : Fin M => μ j.succ))
        (fun y => f (Fin.cons (α := fun _ => Q) q0 y))) := by
  let e := consEquiv M Q
  unfold expVal
  rw [← Fintype.sum_equiv e _ (fun x => piProdWeight μ x * f x) (fun _ => rfl),
    Fintype.sum_prod_type]
  refine Finset.sum_congr rfl (fun q0 _ => ?_)
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun y _ => ?_)
  have hpi : piProdWeight μ (e (q0, y)) = μ 0 q0 * piProdWeight (fun j : Fin M => μ j.succ) y := by
    simp [piProdWeight, e, consEquiv, Fin.prod_univ_succ]
  have he : e (q0, y) = Fin.cons (α := fun _ => Q) q0 y := rfl
  rw [hpi, he]; ring

private lemma cons_update_zero {M : ℕ} {Q : Type*} (q0 q : Q) (y : Fin M → Q) :
    Function.update (Fin.cons (α := fun _ => Q) q0 y) 0 q =
      Fin.cons (α := fun _ => Q) q y := by
  ext i
  refine Fin.cases ?_ ?_ i
  · simp
  · intro j; simp [Fin.succ_ne_zero j]

private lemma cons_update_succ {M : ℕ} {Q : Type*} (q0 q : Q) (y : Fin M → Q) (j : Fin M) :
    Function.update (Fin.cons (α := fun _ => Q) q0 y) j.succ q =
      Fin.cons (α := fun _ => Q) q0 (Function.update y j q) := by
  ext i
  refine Fin.cases ?_ ?_ i
  · simp [(Fin.succ_ne_zero j).symm]
  · intro k
    by_cases hkj : k = j
    · subst hkj; simp
    · have hne : k.succ ≠ j.succ := fun h => hkj (Fin.succ_injective _ h)
      simp [hne, hkj]

/-- **Efron–Stein `M`-Factor Variance Decomposition (`C/B/P`)**:
For any `M : ℕ` and product weight `μ^{⊗ M}` on `Fin M → Q`,
`Var_{μ^{⊗ M}}(f) ≤ ∑ i : Fin M, E_{μ^{⊗ M}}[Var_i(f)]`. -/
theorem efron_stein_pi_tensor_le :
    ∀ {M : ℕ} {Q : Type*} [Fintype Q] (μ : Fin M → Q → ℝ),
      (∀ i : Fin M, IsProbWeight (μ i)) →
      ∀ (f : (Fin M → Q) → ℝ),
        varProb (piProdWeight μ) f ≤
          ∑ i : Fin M, expVal (piProdWeight μ) (fun x => varProb (μ i) (condSlice f i x))
  | 0, Q, _, μ, _, f => by
      have h0 : varProb (piProdWeight μ) f = 0 := by
        unfold varProb expVal piProdWeight
        simp
      simp [h0]
  | M + 1, Q, _, μ, hμ, f => by
      let μtail : Fin M → Q → ℝ := fun j => μ j.succ
      have htail : IsProbWeight (piProdWeight μtail) :=
        isProbWeight_piProdWeight μtail (fun j => hμ j.succ)
      let e := consEquiv M Q
      let f_prod : Q × (Fin M → Q) → ℝ := fun p => f (e p)
      have hvar_eq : varProb (piProdWeight μ) f = varProb (prodWeight (μ 0) (piProdWeight μtail)) f_prod := by
        have hm : expVal (piProdWeight μ) f = expVal (prodWeight (μ 0) (piProdWeight μtail)) f_prod := by
          rw [expVal_piProdWeight_succ, expVal_prodWeight]; rfl
        unfold varProb
        rw [hm, expVal_piProdWeight_succ]
        symm
        exact expVal_prodWeight (μ 0) (piProdWeight μtail) _
      have hes := efron_stein_two_factor_le (hμ 0) htail f_prod
      have hterm0 : expVal (piProdWeight μtail) (fun y => varProb (μ 0) (fun q0 => f_prod (q0, y))) =
          expVal (piProdWeight μ) (fun x => varProb (μ 0) (condSlice f 0 x)) := by
        rw [expVal_piProdWeight_succ]
        have hconst : ∀ q0 : Q,
            expVal (piProdWeight μtail) (fun y => varProb (μ 0) (condSlice f 0 (Fin.cons (α := fun _ => Q) q0 y))) =
            expVal (piProdWeight μtail) (fun y => varProb (μ 0) (fun q => f_prod (q, y))) := by
          intro q0
          refine Finset.sum_congr rfl (fun y _ => ?_)
          have hslice : condSlice f 0 (Fin.cons (α := fun _ => Q) q0 y) = fun q => f_prod (q, y) := by
            funext q
            change f (Function.update (Fin.cons (α := fun _ => Q) q0 y) 0 q) = f (Fin.cons (α := fun _ => Q) q y)
            rw [cons_update_zero]
          change piProdWeight μtail y * varProb (μ 0) (condSlice f 0 (Fin.cons (α := fun _ => Q) q0 y)) = _
          rw [hslice]
        change expVal (piProdWeight μtail) (fun y => varProb (μ 0) (fun q0 => f_prod (q0, y))) =
          expVal (μ 0) (fun q0 => expVal (piProdWeight μtail)
            (fun y => varProb (μ 0) (condSlice f 0 (Fin.cons (α := fun _ => Q) q0 y))))
        simp_rw [hconst, expVal_const (hμ 0)]
      have htail_ih :
          expVal (μ 0) (fun q0 => varProb (piProdWeight μtail) (fun y => f_prod (q0, y))) ≤
          ∑ j : Fin M, expVal (piProdWeight μ) (fun x => varProb (μ j.succ) (condSlice f j.succ x)) := by
        have hpt : ∀ q0 : Q,
            varProb (piProdWeight μtail) (fun y => f_prod (q0, y)) ≤
            ∑ j : Fin M, expVal (piProdWeight μtail)
              (fun y => varProb (μ j.succ) (condSlice f j.succ (Fin.cons (α := fun _ => Q) q0 y))) := by
          intro q0
          have ih := efron_stein_pi_tensor_le μtail (fun j => hμ j.succ) (fun y => f_prod (q0, y))
          refine ih.trans_eq (Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun y _ => ?_)))
          have hslice : condSlice (fun y => f_prod (q0, y)) j y =
              condSlice f j.succ (Fin.cons (α := fun _ => Q) q0 y) := by
            funext q
            change f (Fin.cons (α := fun _ => Q) q0 (Function.update y j q)) =
              f (Function.update (Fin.cons (α := fun _ => Q) q0 y) j.succ q)
            rw [cons_update_succ]
          change piProdWeight μtail y * varProb (μtail j) (condSlice (fun y => f_prod (q0, y)) j y) = _
          rw [hslice]
        calc expVal (μ 0) (fun q0 => varProb (piProdWeight μtail) (fun y => f_prod (q0, y)))
            ≤ expVal (μ 0) (fun q0 => ∑ j : Fin M, expVal (piProdWeight μtail)
                (fun y => varProb (μ j.succ) (condSlice f j.succ (Fin.cons (α := fun _ => Q) q0 y)))) :=
              expVal_mono (hμ 0) hpt
          _ = ∑ j : Fin M, expVal (μ 0) (fun q0 => expVal (piProdWeight μtail)
                (fun y => varProb (μ j.succ) (condSlice f j.succ (Fin.cons (α := fun _ => Q) q0 y)))) := by
              unfold expVal
              simp_rw [Finset.mul_sum]
              exact Finset.sum_comm
          _ = ∑ j : Fin M, expVal (piProdWeight μ) (fun x => varProb (μ j.succ) (condSlice f j.succ x)) := by
              refine Finset.sum_congr rfl (fun j _ => ?_)
              exact (expVal_piProdWeight_succ μ (fun x => varProb (μ j.succ) (condSlice f j.succ x))).symm
      rw [hvar_eq, Fin.sum_univ_succ]
      linarith

lemma glauberDirichlet_eq_single_site_sum {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    [DecidableEq (Fin M)]
    (μ : Fin M → Q → ℝ) (hμ : ∀ i, IsProbWeight (μ i))
    (w : Fin M → Q → Q → ℝ) (f : (Fin M → Q) → ℝ) :
    glauberDirichlet μ w f =
      (1 / 2 : ℝ) * ∑ i : Fin M, ∑ x : Fin M → Q, piProdWeight μ x *
        ∑ q' : Q, w i (x i) q' * (f (Function.update x i q') - f x) ^ 2 := by
  classical
  unfold glauberDirichlet
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  let qstar : Q := Classical.arbitrary Q
  let e : (Q × {y : Fin M → Q // y i = qstar}) ≃ (Fin M → Q) :=
    { toFun := fun p => Function.update p.2.1 i p.1
      invFun := fun x => (x i, ⟨Function.update x i qstar, by simp⟩)
      left_inv := fun ⟨q, ⟨y, hy⟩⟩ => by
        ext j
        · simp
        · by_cases hj : j = i
          · subst hj; simp [hy]
          · simp [hj]
      right_inv := fun x => by
        ext j
        by_cases hj : j = i
        · subst hj; simp
        · simp [hj] }
  have hpi_e : ∀ q (y : {y : Fin M → Q // y i = qstar}),
      piProdWeight μ (Function.update y.1 i q) =
        μ i q * ∏ j ∈ Finset.univ.erase i, μ j (y.1 j) := by
    intro q y
    unfold piProdWeight
    rw [← Finset.mul_prod_erase Finset.univ (fun j => μ j (Function.update y.1 i q j)) (Finset.mem_univ i)]
    simp only [Function.update_self]
    congr 1
    refine Finset.prod_congr rfl (fun j hj => ?_)
    rw [Function.update_apply, if_neg (Finset.ne_of_mem_erase hj)]
  have hL : expVal (piProdWeight μ) (fun x => edgeDirichlet (μ i) (w i) (condSlice f i x)) =
      (1 / 2 : ℝ) * ∑ y : {y : Fin M → Q // y i = qstar},
        (∏ j ∈ Finset.univ.erase i, μ j (y.1 j)) *
        ∑ q : Q, ∑ q' : Q, μ i q * w i q q' *
          (f (Function.update y.1 i q') - f (Function.update y.1 i q)) ^ 2 := by
    unfold expVal
    rw [← Fintype.sum_equiv e _ (fun x => piProdWeight μ x * edgeDirichlet (μ i) (w i) (condSlice f i x)) (fun _ => rfl)]
    rw [Fintype.sum_prod_type]
    have hswap : (∑ q : Q, ∑ y : {y : Fin M → Q // y i = qstar},
        piProdWeight μ (e (q, y)) * edgeDirichlet (μ i) (w i) (condSlice f i (e (q, y)))) =
        ∑ y : {y : Fin M → Q // y i = qstar},
        (∑ q : Q, piProdWeight μ (Function.update y.1 i q)) *
          edgeDirichlet (μ i) (w i) (condSlice f i y.1) := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      have hslice : condSlice f i (e (q, y)) = condSlice f i y.1 := by
        funext r; simp [condSlice, e, Function.update_idem]
      rw [hslice]; rfl
    rw [hswap, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    have hsum_q : (∑ q : Q, piProdWeight μ (Function.update y.1 i q)) =
        ∏ j ∈ Finset.univ.erase i, μ j (y.1 j) := by
      simp_rw [hpi_e, ← Finset.sum_mul, (hμ i).2, one_mul]
    rw [hsum_q]
    unfold edgeDirichlet condSlice
    ring
  have hR : (1 / 2 : ℝ) * ∑ x : Fin M → Q, piProdWeight μ x *
        ∑ q' : Q, w i (x i) q' * (f (Function.update x i q') - f x) ^ 2 =
      (1 / 2 : ℝ) * ∑ y : {y : Fin M → Q // y i = qstar},
        (∏ j ∈ Finset.univ.erase i, μ j (y.1 j)) *
        ∑ q : Q, ∑ q' : Q, μ i q * w i q q' *
          (f (Function.update y.1 i q') - f (Function.update y.1 i q)) ^ 2 := by
    congr 1
    rw [← Fintype.sum_equiv e _ (fun x => piProdWeight μ x *
      ∑ q' : Q, w i (x i) q' * (f (Function.update x i q') - f x) ^ 2) (fun _ => rfl)]
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    dsimp [e]
    rw [hpi_e q y, Function.update_self]
    have hud : ∀ q' : Q, Function.update (Function.update y.1 i q) i q' = Function.update y.1 i q' := by
      intro q'
      simp [Function.update_idem]
    simp_rw [hud, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q' _ => by ring)
  rw [hL, hR]

/-- **Volume-Independent Poincaré Tensorization (`C/B/P`, Obligation 2A Core)**:
For any `M : ℕ`, nonempty finite state space `Q`, single-site probability weights `μ i`, and
nonnegative single-site Dirichlet kernels `w i` satisfying a single-site Poincaré inequality with
uniform constant `c_P ≥ 0`:
1. The `M`-fold product measure `μ^{⊗ M}` satisfies the Poincaré inequality with **exact same
   constant `c_P(M) = c_P`** (strictly independent of `M`),
2. `glauberDirichlet` equals the standard single-site Glauber jump Dirichlet energy,
3. Contrast with `DEAD-20261124-11` (`product_dobrushin_volume_collapse_and_scaling_mismatch`):
   for any `0 ≤ θ < 1`, the synchronous Dobrushin gap margin ceiling `θ^M → 0` (`1 - θ^M → 1`),
   whereas the Poincaré spectral gap `1 / c_P` remains strictly constant (`> 0`) for all `M`. -/
theorem poincare_variance_tensorization_volume_independent
    {Q : Type*} [Fintype Q] [Nonempty Q]
    (M : ℕ) (μ : Fin M → Q → ℝ) (hμ : ∀ i : Fin M, IsProbWeight (μ i))
    (w : Fin M → Q → Q → ℝ) (_hw : ∀ i q q', 0 ≤ w i q q')
    {c_P : ℝ} (_hcP_nn : 0 ≤ c_P)
    (hsingle : ∀ (i : Fin M) (g : Q → ℝ), varProb (μ i) g ≤ c_P * edgeDirichlet (μ i) (w i) g) :
    (∀ f : (Fin M → Q) → ℝ, varProb (piProdWeight μ) f ≤ c_P * glauberDirichlet μ w f) ∧
    (∀ f : (Fin M → Q) → ℝ, glauberDirichlet μ w f =
      (1 / 2 : ℝ) * ∑ i : Fin M, ∑ x : Fin M → Q, piProdWeight μ x *
        ∑ q' : Q, w i (x i) q' * (f (Function.update x i q') - f x) ^ 2) ∧
    (0 < c_P → ∀ _M' : ℕ, (0 : ℝ) < 1 / c_P ∧
      ∀ θ : ℝ, 0 ≤ θ → θ < 1 →
        Filter.Tendsto (fun k : ℕ => θ ^ k) Filter.atTop (nhds 0)) := by
  refine ⟨fun f => ?_, fun f => glauberDirichlet_eq_single_site_sum μ hμ w f, fun hcP _ => ?_⟩
  · calc varProb (piProdWeight μ) f
        ≤ ∑ i : Fin M, expVal (piProdWeight μ) (fun x => varProb (μ i) (condSlice f i x)) :=
          efron_stein_pi_tensor_le μ hμ f
      _ ≤ ∑ i : Fin M, expVal (piProdWeight μ) (fun x => c_P * edgeDirichlet (μ i) (w i) (condSlice f i x)) := by
          refine Finset.sum_le_sum (fun i _ => expVal_mono (isProbWeight_piProdWeight μ hμ) (fun x => ?_))
          exact hsingle i (condSlice f i x)
      _ = c_P * glauberDirichlet μ w f := by
          unfold glauberDirichlet
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => expVal_smul _ c_P _)
  · exact ⟨div_pos one_pos hcP, fun θ hθ_nn hθ_lt => tendsto_pow_atTop_nhds_zero_of_lt_one hθ_nn hθ_lt⟩

/-! ## 2. Holley–Stroock Bounded-Perturbation Poincaré Stability (`C/B/P`) -/

/-- Partition function `Z = ∑ x, μ x * exp (-V x)` of a Gibbs tilt. `[C/B]` -/
noncomputable def gibbsZ {S : Type*} [Fintype S] (μ V : S → ℝ) : ℝ :=
  ∑ x : S, μ x * Real.exp (-V x)

/-- Tilted Gibbs probability weight `ν(x) = Z⁻¹ μ(x) exp(-V(x))`. `[C/B]` -/
noncomputable def gibbsTilt {S : Type*} [Fintype S] (μ V : S → ℝ) : S → ℝ :=
  fun x => μ x * Real.exp (-V x) / gibbsZ μ V

lemma gibbsZ_pos {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ) (V : S → ℝ) :
    0 < gibbsZ μ V := by
  have hsum1 : ∑ x : S, μ x = 1 := hμ.2
  have hex : ∃ x0 : S, 0 < μ x0 := by
    by_contra hnone
    push Not at hnone
    have hzero : ∑ x : S, μ x = 0 :=
      Finset.sum_eq_zero (fun x _ => le_antisymm (hnone x) (hμ.1 x))
    linarith
  rcases hex with ⟨x0, hx0⟩
  have hterm : 0 < μ x0 * Real.exp (-V x0) := mul_pos hx0 (Real.exp_pos _)
  have hle : μ x0 * Real.exp (-V x0) ≤ gibbsZ μ V :=
    Finset.single_le_sum (f := fun x => μ x * Real.exp (-V x))
      (fun x _ => mul_nonneg (hμ.1 x) (le_of_lt (Real.exp_pos _))) (Finset.mem_univ x0)
  linarith

lemma isProbWeight_gibbsTilt {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    (V : S → ℝ) : IsProbWeight (gibbsTilt μ V) := by
  have hZ : 0 < gibbsZ μ V := gibbsZ_pos hμ V
  refine ⟨fun x => div_nonneg (mul_nonneg (hμ.1 x) (le_of_lt (Real.exp_pos _))) (le_of_lt hZ), ?_⟩
  unfold gibbsTilt
  rw [← Finset.sum_div]
  exact div_self (ne_of_gt hZ)

lemma osc_le_iff_sup_inf_le {S : Type*} [Fintype S] [Nonempty S] (V : S → ℝ) (B : ℝ) :
    (∀ x y : S, V x - V y ≤ B) ↔
      Finset.univ.sup' Finset.univ_nonempty V - Finset.univ.inf' Finset.univ_nonempty V ≤ B := by
  constructor
  · intro h
    obtain ⟨xmax, _, hxmax⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty V
    obtain ⟨xmin, _, hxmin⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty V
    rw [hxmax, hxmin]
    exact h xmax xmin
  · intro h x y
    have hx : V x ≤ Finset.univ.sup' Finset.univ_nonempty V :=
      Finset.le_sup' V (Finset.mem_univ x)
    have hy : Finset.univ.inf' Finset.univ_nonempty V ≤ V y :=
      Finset.inf'_le V (Finset.mem_univ y)
    linarith

lemma gibbsTilt_radon_nikodym_bounds {S : Type*} [Fintype S]
    {μ : S → ℝ} (hμ : IsProbWeight μ) (V : S → ℝ) {B : ℝ}
    (hosc : ∀ x y : S, V x - V y ≤ B) :
    (∀ x : S, gibbsTilt μ V x ≤ Real.exp B * μ x) ∧
    (∀ x : S, μ x ≤ Real.exp B * gibbsTilt μ V x) := by
  have hZ : 0 < gibbsZ μ V := gibbsZ_pos hμ V
  have hZ_lb : ∀ x : S, Real.exp (-V x - B) ≤ gibbsZ μ V := by
    intro x
    have hpt : ∀ y : S, μ y * Real.exp (-V x - B) ≤ μ y * Real.exp (-V y) := by
      intro y
      refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (hμ.1 y)
      linarith [hosc y x]
    calc Real.exp (-V x - B)
        = ∑ y : S, μ y * Real.exp (-V x - B) := by rw [← Finset.sum_mul, hμ.2, one_mul]
      _ ≤ ∑ y : S, μ y * Real.exp (-V y) := Finset.sum_le_sum (fun y _ => hpt y)
  have hZ_ub : ∀ x : S, gibbsZ μ V ≤ Real.exp (-V x + B) := by
    intro x
    have hpt : ∀ y : S, μ y * Real.exp (-V y) ≤ μ y * Real.exp (-V x + B) := by
      intro y
      refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (hμ.1 y)
      linarith [hosc x y]
    calc gibbsZ μ V
        = ∑ y : S, μ y * Real.exp (-V y) := rfl
      _ ≤ ∑ y : S, μ y * Real.exp (-V x + B) := Finset.sum_le_sum (fun y _ => hpt y)
      _ = Real.exp (-V x + B) := by rw [← Finset.sum_mul, hμ.2, one_mul]
  refine ⟨fun x => ?_, fun x => ?_⟩
  · unfold gibbsTilt
    rw [div_le_iff₀ hZ]
    have hmul : Real.exp (-V x) ≤ Real.exp B * Real.exp (-V x - B) := by
      rw [← Real.exp_add]; exact le_of_eq (congrArg Real.exp (by ring))
    have h1 : μ x * Real.exp (-V x) ≤ μ x * (Real.exp B * Real.exp (-V x - B)) :=
      mul_le_mul_of_nonneg_left hmul (hμ.1 x)
    have h2 : μ x * (Real.exp B * Real.exp (-V x - B)) ≤ Real.exp B * μ x * gibbsZ μ V := by
      have hpos : 0 ≤ Real.exp B * μ x := mul_nonneg (le_of_lt (Real.exp_pos _)) (hμ.1 x)
      calc μ x * (Real.exp B * Real.exp (-V x - B))
          = (Real.exp B * μ x) * Real.exp (-V x - B) := by ring
        _ ≤ (Real.exp B * μ x) * gibbsZ μ V := mul_le_mul_of_nonneg_left (hZ_lb x) hpos
    exact h1.trans h2
  · unfold gibbsTilt
    rw [mul_div_assoc', le_div_iff₀ hZ]
    have hmul : Real.exp (-V x + B) ≤ Real.exp B * Real.exp (-V x) := by
      rw [← Real.exp_add]; exact le_of_eq (congrArg Real.exp (by ring))
    calc μ x * gibbsZ μ V
        ≤ μ x * Real.exp (-V x + B) := mul_le_mul_of_nonneg_left (hZ_ub x) (hμ.1 x)
      _ ≤ μ x * (Real.exp B * Real.exp (-V x)) := mul_le_mul_of_nonneg_left hmul (hμ.1 x)
      _ = Real.exp B * (μ x * Real.exp (-V x)) := by ring

/-- **Holley–Stroock Bounded-Perturbation Poincaré Stability (`C/B/P`)**:
For any reference weight `μ` with Poincaré constant `c_P ≥ 0` and any bounded perturbation `V`
with `osc(V) ≤ B` (`∀ x y, V x - V y ≤ B`), the tilted Gibbs measure `ν = Z⁻¹ exp(-V) μ` satisfies:
1. **Tight Variance Transfer**: `Var_ν(f) ≤ exp(B) * Var_μ(f)` (via `Var_ν(f) ≤ E_ν[(f - E_μ f)^2]`),
2. **Reference-Dirichlet Stability**: `Var_ν(f) ≤ (c_P * exp(B)) * E_μ(f)`,
3. **Tilted-Dirichlet Holley–Stroock Stability**: `Var_ν(f) ≤ (c_P * exp(2 * B)) * E_ν(f)`,
4. **General Conductance / Metropolis Transfer**: if `μ x * w x y ≤ exp(B) * (ν x * w_tilt x y)`,
   then `Var_ν(f) ≤ (c_P * exp(2 * B)) * edgeDirichlet ν w_tilt f`. -/
theorem holley_stroock_bounded_perturbation_poincare_stability
    {S : Type*} [Fintype S]
    (μ V : S → ℝ) (hμ : IsProbWeight μ)
    (w : S → S → ℝ) (hw : ∀ x y, 0 ≤ w x y)
    {B c_P : ℝ} (hosc : ∀ x y : S, V x - V y ≤ B) (hcP_nn : 0 ≤ c_P)
    (hpoinc : ∀ f : S → ℝ, varProb μ f ≤ c_P * edgeDirichlet μ w f) :
    let ν := gibbsTilt μ V
    (∀ f : S → ℝ, varProb ν f ≤ Real.exp B * varProb μ f) ∧
    (∀ f : S → ℝ, varProb ν f ≤ (c_P * Real.exp B) * edgeDirichlet μ w f) ∧
    (∀ f : S → ℝ, varProb ν f ≤ (c_P * Real.exp (2 * B)) * edgeDirichlet ν w f) ∧
    (∀ (w_tilt : S → S → ℝ),
      (∀ x y, μ x * w x y ≤ Real.exp B * (ν x * w_tilt x y)) →
      ∀ f : S → ℝ, varProb ν f ≤ (c_P * Real.exp (2 * B)) * edgeDirichlet ν w_tilt f) := by
  intro ν
  have hν : IsProbWeight ν := isProbWeight_gibbsTilt hμ V
  obtain ⟨hν_le, hμ_le⟩ := gibbsTilt_radon_nikodym_bounds hμ V hosc
  have hvar : ∀ f : S → ℝ, varProb ν f ≤ Real.exp B * varProb μ f := by
    intro f
    have h1 : varProb ν f ≤ expVal ν (fun x => (f x - expVal μ f) ^ 2) :=
      varProb_le_sq_sub_const hν f (expVal μ f)
    have h2 : expVal ν (fun x => (f x - expVal μ f) ^ 2) ≤ Real.exp B * varProb μ f := by
      change (∑ x : S, ν x * (f x - expVal μ f) ^ 2) ≤
        Real.exp B * ∑ x : S, μ x * (f x - expVal μ f) ^ 2
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun x _ => ?_)
      calc ν x * (f x - expVal μ f) ^ 2
          ≤ (Real.exp B * μ x) * (f x - expVal μ f) ^ 2 :=
            mul_le_mul_of_nonneg_right (hν_le x) (sq_nonneg _)
        _ = Real.exp B * (μ x * (f x - expVal μ f) ^ 2) := by ring
    exact h1.trans h2
  have href : ∀ f : S → ℝ, varProb ν f ≤ (c_P * Real.exp B) * edgeDirichlet μ w f := by
    intro f
    calc varProb ν f
        ≤ Real.exp B * varProb μ f := hvar f
      _ ≤ Real.exp B * (c_P * edgeDirichlet μ w f) :=
          mul_le_mul_of_nonneg_left (hpoinc f) (le_of_lt (Real.exp_pos B))
      _ = (c_P * Real.exp B) * edgeDirichlet μ w f := by ring
  have hgen : ∀ (w_tilt : S → S → ℝ),
      (∀ x y, μ x * w x y ≤ Real.exp B * (ν x * w_tilt x y)) →
      ∀ f : S → ℝ, varProb ν f ≤ (c_P * Real.exp (2 * B)) * edgeDirichlet ν w_tilt f := by
    intro w_tilt hw_tilt f
    have hE : edgeDirichlet μ w f ≤ Real.exp B * edgeDirichlet ν w_tilt f := by
      unfold edgeDirichlet
      have hsum : ∑ x : S, ∑ y : S, μ x * w x y * (f y - f x) ^ 2 ≤
          Real.exp B * ∑ x : S, ∑ y : S, ν x * w_tilt x y * (f y - f x) ^ 2 := by
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun x _ => ?_)
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun y _ => ?_)
        calc μ x * w x y * (f y - f x) ^ 2
            ≤ (Real.exp B * (ν x * w_tilt x y)) * (f y - f x) ^ 2 :=
              mul_le_mul_of_nonneg_right (hw_tilt x y) (sq_nonneg _)
          _ = Real.exp B * (ν x * w_tilt x y * (f y - f x) ^ 2) := by ring
      nlinarith
    have hcoef_nn : 0 ≤ c_P * Real.exp B := mul_nonneg hcP_nn (le_of_lt (Real.exp_pos B))
    have hexp2 : Real.exp B * Real.exp B = Real.exp (2 * B) := by
      rw [← Real.exp_add]; congr 1; ring
    calc varProb ν f
        ≤ (c_P * Real.exp B) * edgeDirichlet μ w f := href f
      _ ≤ (c_P * Real.exp B) * (Real.exp B * edgeDirichlet ν w_tilt f) :=
          mul_le_mul_of_nonneg_left hE hcoef_nn
      _ = (c_P * Real.exp (2 * B)) * edgeDirichlet ν w_tilt f := by
          rw [← mul_assoc, mul_assoc c_P, hexp2]
  have hsame : ∀ f : S → ℝ, varProb ν f ≤ (c_P * Real.exp (2 * B)) * edgeDirichlet ν w f :=
    hgen w (fun x y => by
      calc μ x * w x y
          ≤ (Real.exp B * ν x) * w x y := mul_le_mul_of_nonneg_right (hμ_le x) (hw x y)
        _ = Real.exp B * (ν x * w x y) := by ring)
  exact ⟨hvar, href, hsame, hgen⟩

/-- **Red-Team Guard: Finite-Block Holley–Stroock Tensorization vs. Global Extensive Collapse (`C/B/P`)**:
1. **Block-Local Holley–Stroock + Tensorization (`[C/B/P]`)**: If an `M`-block product measure
   is tilted block-by-block (`V_blk i` with `O(1)` oscillation `osc(V_blk i) ≤ B_blk` independent
   of `M`), the resulting Poincaré constant `(c_P * exp(2 * B_blk))` is **strictly uniform in `M`**.
2. **Global Extensive Holley–Stroock Collapse (`[C/B/P]`)**: If Holley–Stroock is instead applied
   globally to an extensive 4D interacting potential `V_M` with `osc(V_M) ≥ c * M` (`c > 0`),
   the global Holley–Stroock spectral-gap lower bound `(c_P * exp(2 * B_M))⁻¹` collapses
   exponentially (`≤ c_P⁻¹ * exp(-2 * c * M) → 0`), matching `DEAD-20261124-11` and isolating
   inter-block Zegarlinski mixing as the exact `[X]` (`IR-X`) bridge. -/
theorem block_holley_stroock_vs_global_extensive_collapse
    {Q_blk : Type*} [Fintype Q_blk] [Nonempty Q_blk]
    (M : ℕ) (μ_blk : Fin M → Q_blk → ℝ) (hμ : ∀ i : Fin M, IsProbWeight (μ_blk i))
    (w_blk : Fin M → Q_blk → Q_blk → ℝ) (hw : ∀ i q q', 0 ≤ w_blk i q q')
    (V_blk : Fin M → Q_blk → ℝ)
    {B_blk c_P : ℝ} (hosc_blk : ∀ (i : Fin M) (q q' : Q_blk), V_blk i q - V_blk i q' ≤ B_blk)
    (hcP_pos : 0 < c_P)
    (hsingle : ∀ (i : Fin M) (g : Q_blk → ℝ),
      varProb (μ_blk i) g ≤ c_P * edgeDirichlet (μ_blk i) (w_blk i) g) :
    let ν_blk : Fin M → Q_blk → ℝ := fun i => gibbsTilt (μ_blk i) (V_blk i)
    (∀ f : (Fin M → Q_blk) → ℝ,
      varProb (piProdWeight ν_blk) f ≤
        (c_P * Real.exp (2 * B_blk)) * glauberDirichlet ν_blk w_blk f) ∧
    (∀ {c : ℝ}, 0 < c → ∀ (B_global : ℕ → ℝ), (∀ k : ℕ, c * (k : ℝ) ≤ B_global k) →
      (∀ k : ℕ, (c_P * Real.exp (2 * B_global k))⁻¹ ≤
        c_P⁻¹ * Real.exp (-2 * c * (k : ℝ))) ∧
      Filter.Tendsto (fun k : ℕ => (c_P * Real.exp (2 * B_global k))⁻¹) Filter.atTop (nhds 0)) := by
  intro ν_blk
  have hν_prob : ∀ i : Fin M, IsProbWeight (ν_blk i) := fun i => isProbWeight_gibbsTilt (hμ i) (V_blk i)
  have hν_poinc : ∀ (i : Fin M) (g : Q_blk → ℝ),
      varProb (ν_blk i) g ≤ (c_P * Real.exp (2 * B_blk)) * edgeDirichlet (ν_blk i) (w_blk i) g := by
    intro i g
    exact (holley_stroock_bounded_perturbation_poincare_stability
      (μ_blk i) (V_blk i) (hμ i) (w_blk i) (hw i) (hosc_blk i) (le_of_lt hcP_pos)
      (hsingle i)).2.2.1 g
  have htens := poincare_variance_tensorization_volume_independent
    M ν_blk hν_prob w_blk hw (mul_nonneg (le_of_lt hcP_pos) (le_of_lt (Real.exp_pos _))) hν_poinc
  refine ⟨htens.1, fun {c} hc_pos B_global hB => ?_⟩
  have hbound : ∀ k : ℕ, (c_P * Real.exp (2 * B_global k))⁻¹ ≤
      c_P⁻¹ * Real.exp (-2 * c * (k : ℝ)) := by
    intro k
    have hexp_inv : (c_P * Real.exp (2 * B_global k))⁻¹ = c_P⁻¹ * Real.exp (-(2 * B_global k)) := by
      rw [mul_inv, Real.exp_neg]
    rw [hexp_inv]
    refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (inv_nonneg.mpr (le_of_lt hcP_pos))
    linarith [hB k]
  have htend : Filter.Tendsto (fun k : ℕ => c_P⁻¹ * Real.exp (-2 * c * (k : ℝ)))
      Filter.atTop (nhds 0) := by
    have hneg : Filter.Tendsto (fun k : ℕ => -2 * c * (k : ℝ)) Filter.atTop Filter.atBot := by
      have hrew : (fun k : ℕ => -2 * c * (k : ℝ)) = fun k : ℕ => -((2 * c) * (k : ℝ)) := by
        funext k; ring
      rw [hrew]
      exact Filter.tendsto_neg_atTop_atBot.comp
        (Filter.Tendsto.const_mul_atTop (by linarith) tendsto_natCast_atTop_atTop)
    simpa using (tendsto_const_nhds (x := c_P⁻¹)).mul (Real.tendsto_exp_atBot.comp hneg)
  refine ⟨hbound, tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds htend
    (fun k => inv_nonneg.mpr (mul_nonneg (le_of_lt hcP_pos) (le_of_lt (Real.exp_pos _)))) hbound⟩

/-! ## 3. Log-Sobolev Tensorization, Pinsker Inequality & Clustering (`C/B/P`) -/

/-- `φ(t) = t log t` for `t > 0`, `0` for `t ≤ 0`. `[C/B]` -/
noncomputable def phiEnt (t : ℝ) : ℝ :=
  if t ≤ 0 then 0 else t * Real.log t

/-- Entropy functional `Ent_μ(g) = E_μ[φ(g)] - φ(E_μ[g])`. `[C/B]` -/
noncomputable def entProb {S : Type*} [Fintype S] (μ : S → ℝ) (g : S → ℝ) : ℝ :=
  expVal μ (fun x => phiEnt (g x)) - phiEnt (expVal μ g)

/-- Kullback–Leibler divergence `KL(ν ‖ μ) = ∑ x, μ x * φ(ν x / μ x)`. `[C/B]` -/
noncomputable def klDiv {S : Type*} [Fintype S] (ν μ : S → ℝ) : ℝ :=
  ∑ x : S, if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x)

lemma phiEnt_nonpos {t : ℝ} (ht : t ≤ 0) : phiEnt t = 0 := by simp [phiEnt, ht]

lemma phiEnt_pos {t : ℝ} (ht : 0 < t) : phiEnt t = t * Real.log t := by
  simp [phiEnt, not_le.mpr ht]

lemma phiEnt_zero : phiEnt 0 = 0 := phiEnt_nonpos le_rfl

lemma phiEnt_one : phiEnt 1 = 0 := by simp [phiEnt]

lemma phiEnt_continuous : Continuous phiEnt := by
  have hEq : phiEnt = fun t => if t ≤ 0 then 0 else t * Real.log t := rfl
  have hnonneg : ∀ t : ℝ, (if t ≤ 0 then 0 else t * Real.log t) = (max t 0) * Real.log (max t 0) := by
    intro t
    rcases le_or_gt t 0 with ht | ht
    · simp [ht]
    · simp [not_le.mpr ht, max_eq_left (le_of_lt ht)]
  rw [hEq]
  simp_rw [hnonneg]
  exact Real.continuous_mul_log.comp (continuous_id.max continuous_const)

lemma klTerm_nonneg {u v : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) (hzero : v = 0 → u = 0) :
    0 ≤ phiEnt u - (if v ≤ 0 then 0 else u * Real.log v) - (u - v) := by
  rcases hv.eq_or_lt with rfl | hv_pos
  · have hu0 : u = 0 := hzero rfl
    subst hu0
    simp [phiEnt_zero]
  · simp only [not_le.mpr hv_pos, ↓reduceIte]
    rcases hu.eq_or_lt with rfl | hu_pos
    · simp [phiEnt_zero]; exact le_of_lt hv_pos
    · rw [phiEnt_pos hu_pos]
      have hlog := Real.log_le_sub_one_of_pos (div_pos hv_pos hu_pos)
      rw [Real.log_div (ne_of_gt hv_pos) (ne_of_gt hu_pos)] at hlog
      have hmul := mul_le_mul_of_nonneg_left hlog (le_of_lt hu_pos)
      have hid1 : u * (Real.log v - Real.log u) = u * Real.log v - u * Real.log u := by ring
      have hid2 : u * (v / u - 1) = v - u := by field_simp [ne_of_gt hu_pos]
      rw [hid1, hid2] at hmul
      linarith

lemma entProb_nonneg {S : Type*} [Fintype S] {μ : S → ℝ} (hμ : IsProbWeight μ)
    {g : S → ℝ} (hg : ∀ x, 0 ≤ g x) :
    0 ≤ entProb μ g := by
  set m := expVal μ g
  have hm_nn : 0 ≤ m := expVal_nonneg hμ hg
  rcases hm_nn.eq_or_lt with hm0 | hm_pos
  · have hzero : ∀ x, μ x * phiEnt (g x) = 0 := by
      intro x
      rcases (hμ.1 x).eq_or_lt with hx0 | hx_pos
      · simp [← hx0]
      · have hle : μ x * g x ≤ m :=
          Finset.single_le_sum (fun y _ => mul_nonneg (hμ.1 y) (hg y)) (Finset.mem_univ x)
        have hgx0 : g x = 0 := by
          have h1 : μ x * g x = 0 := le_antisymm (hle.trans_eq hm0.symm) (mul_nonneg (hμ.1 x) (hg x))
          exact (mul_eq_zero.mp h1).resolve_left (ne_of_gt hx_pos)
        simp [hgx0, phiEnt_zero]
    unfold entProb expVal
    rw [Finset.sum_eq_zero (fun x _ => hzero x)]
    change 0 ≤ 0 - phiEnt m
    rw [← hm0, phiEnt_zero, sub_zero]
  · have hpt : ∀ x, μ x * (phiEnt m + (Real.log m + 1) * (g x - m)) ≤ μ x * phiEnt (g x) := by
      intro x
      have hkl := klTerm_nonneg (hg x) (le_of_lt hm_pos) (fun h => absurd h (ne_of_gt hm_pos))
      simp only [not_le.mpr hm_pos, ↓reduceIte] at hkl
      have hkl' : phiEnt m + (Real.log m + 1) * (g x - m) ≤ phiEnt (g x) := by
        rw [phiEnt_pos hm_pos]
        linarith
      exact mul_le_mul_of_nonneg_left hkl' (hμ.1 x)
    have hsum := Finset.sum_le_sum (fun x (_ : x ∈ Finset.univ) => hpt x)
    have hL : (∑ x : S, μ x * (phiEnt m + (Real.log m + 1) * (g x - m))) = phiEnt m := by
      simp_rw [mul_add, Finset.sum_add_distrib]
      have h1 : (∑ x : S, μ x * phiEnt m) = phiEnt m := by rw [← Finset.sum_mul, hμ.2, one_mul]
      have h2 : (∑ x : S, μ x * ((Real.log m + 1) * (g x - m))) = 0 := by
        have hrew : ∀ x, μ x * ((Real.log m + 1) * (g x - m)) =
            (Real.log m + 1) * (μ x * g x - μ x * m) := fun x => by ring
        simp_rw [hrew, ← Finset.mul_sum, Finset.sum_sub_distrib, ← Finset.sum_mul, hμ.2, one_mul]
        change (Real.log m + 1) * (m - m) = 0
        ring
      linarith
    unfold entProb expVal
    exact sub_nonneg.mpr (hL.symm.trans_le hsum)

lemma klDiv_nonneg {S : Type*} [Fintype S] {ν μ : S → ℝ}
    (hν : IsProbWeight ν) (hμ : IsProbWeight μ) (hac : ∀ x, μ x = 0 → ν x = 0) :
    0 ≤ klDiv ν μ := by
  have hpt : ∀ x : S, ν x - μ x ≤ (if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x)) := by
    intro x
    rcases (hμ.1 x).eq_or_lt with hx0 | hx_pos
    · have hν0 : ν x = 0 := hac x hx0.symm
      simp [← hx0, hν0]
    · simp only [not_le.mpr hx_pos, ↓reduceIte]
      have hkl := klTerm_nonneg (div_nonneg (hν.1 x) (le_of_lt hx_pos))
        (zero_le_one : (0 : ℝ) ≤ 1) (fun h => absurd h one_ne_zero)
      simp only [show ¬ ((1 : ℝ) ≤ 0) by norm_num, ↓reduceIte, Real.log_one, mul_zero, sub_zero] at hkl
      have hmul := mul_le_mul_of_nonneg_left hkl (le_of_lt hx_pos)
      have hrew : μ x * (ν x / μ x - 1) = ν x - μ x := by field_simp [ne_of_gt hx_pos]
      rw [mul_zero] at hmul
      linarith
  have hsum := Finset.sum_le_sum (fun x (_ : x ∈ Finset.univ) => hpt x)
  rw [Finset.sum_sub_distrib, hν.2, hμ.2, sub_self] at hsum
  exact hsum

lemma klDiv_density_eq_entProb {S : Type*} [Fintype S] {μ h : S → ℝ}
    (hμ : IsProbWeight μ) (_hh_nn : ∀ x, 0 ≤ h x) (hh_mean : expVal μ h = 1) :
    klDiv (fun x => μ x * h x) μ = entProb μ h := by
  unfold klDiv entProb
  change (∑ x : S, if μ x ≤ 0 then 0 else μ x * phiEnt (μ x * h x / μ x)) =
    expVal μ (fun x => phiEnt (h x)) - phiEnt (expVal μ h)
  rw [hh_mean, phiEnt_one, sub_zero]
  unfold expVal
  refine Finset.sum_congr rfl (fun x _ => ?_)
  rcases (hμ.1 x).eq_or_lt with hx0 | hx_pos
  · simp [← hx0]
  · simp only [not_le.mpr hx_pos, ↓reduceIte]
    rw [mul_div_cancel_left₀ (h x) (ne_of_gt hx_pos)]

/-- **Two-Factor Entropy Subadditivity (`C/B/P`)**:
`Ent_{μA ⊗ μB}(g) ≤ E_A[Ent_B(g(a, ·))] + E_B[Ent_A(g(·, b))]`. -/
theorem ent_two_factor_subadditivity {A B : Type*} [Fintype A] [Fintype B]
    {μA : A → ℝ} {μB : B → ℝ} (hA : IsProbWeight μA) (hB : IsProbWeight μB)
    {g : A × B → ℝ} (hg : ∀ p, 0 ≤ g p) :
    entProb (prodWeight μA μB) g ≤
      expVal μA (fun a => entProb μB (fun b => g (a, b))) +
      expVal μB (fun b => entProb μA (fun a => g (a, b))) := by
  let gbar : ℝ := expVal (prodWeight μA μB) g
  have hgbar_nn : 0 ≤ gbar := expVal_nonneg (isProbWeight_prodWeight hA hB) hg
  rcases hgbar_nn.eq_or_lt with hgbar0 | hgbar_pos
  · have hzero : entProb (prodWeight μA μB) g = 0 := by
      have h0 : ∀ p, prodWeight μA μB p * g p = 0 := fun p => by
        have hle : prodWeight μA μB p * g p ≤ gbar :=
          Finset.single_le_sum (fun q _ => mul_nonneg (mul_nonneg (hA.1 q.1) (hB.1 q.2)) (hg q))
            (Finset.mem_univ p)
        exact le_antisymm (hle.trans_eq hgbar0.symm)
          (mul_nonneg (mul_nonneg (hA.1 p.1) (hB.1 p.2)) (hg p))
      have hphi0 : expVal (prodWeight μA μB) (fun p => phiEnt (g p)) = 0 := by
        refine Finset.sum_eq_zero (fun p _ => ?_)
        rcases (mul_eq_zero.mp (h0 p)) with hp0 | hgp0
        · simp [hp0]
        · simp [hgp0, phiEnt_zero]
      unfold entProb
      change expVal (prodWeight μA μB) (fun p => phiEnt (g p)) - phiEnt gbar = 0
      rw [hphi0, ← hgbar0, phiEnt_zero, sub_zero]
    rw [hzero]
    exact add_nonneg
      (expVal_nonneg hA (fun a => entProb_nonneg hB (fun b => hg (a, b))))
      (expVal_nonneg hB (fun b => entProb_nonneg hA (fun a => hg (a, b))))
  · let GA : B → ℝ := fun b => expVal μA (fun a => g (a, b))
    let GB : A → ℝ := fun a => expVal μB (fun b => g (a, b))
    have hGA_nn : ∀ b, 0 ≤ GA b := fun b => expVal_nonneg hA (fun a => hg (a, b))
    have hGB_nn : ∀ a, 0 ≤ GB a := fun a => expVal_nonneg hB (fun b => hg (a, b))
    have hsumGA : expVal μB GA = gbar := (expVal_prodWeight_comm μA μB g).symm
    have hsumGB : expVal μA GB = gbar := (expVal_prodWeight μA μB g).symm
    have hchain : entProb (prodWeight μA μB) g =
        expVal μB (fun b => entProb μA (fun a => g (a, b))) + entProb μB GA := by
      unfold entProb
      rw [expVal_prodWeight_comm μA μB (fun p => phiEnt (g p)), expVal_sub]
      change expVal μB (fun b => expVal μA (fun a => phiEnt (g (a, b)))) - phiEnt gbar =
        (expVal μB (fun b => expVal μA (fun a => phiEnt (g (a, b)))) -
          expVal μB (fun b => phiEnt (GA b))) +
        (expVal μB (fun b => phiEnt (GA b)) - phiEnt (expVal μB GA))
      rw [hsumGA]
      ring
    have hdiff_nn : 0 ≤ expVal μA (fun a => entProb μB (fun b => g (a, b))) - entProb μB GA := by
      let q : A × B → ℝ := fun p => GB p.1 * GA p.2 / gbar
      have hq_nn : ∀ p, 0 ≤ q p := fun p =>
        div_nonneg (mul_nonneg (hGB_nn p.1) (hGA_nn p.2)) (le_of_lt hgbar_pos)
      have hterm_nn : ∀ p : A × B,
          0 ≤ prodWeight μA μB p *
            (phiEnt (g p) - (if q p ≤ 0 then 0 else g p * Real.log (q p)) - (g p - q p)) := by
        intro p
        rcases (hA.1 p.1).eq_or_lt with ha0 | ha_pos
        · simp [prodWeight, ← ha0]
        · rcases (hB.1 p.2).eq_or_lt with hb0 | hb_pos
          · simp [prodWeight, ← hb0]
          · refine mul_nonneg (mul_nonneg (hA.1 p.1) (hB.1 p.2)) (klTerm_nonneg (hg p) (hq_nn p) ?_)
            intro hq0
            have hmul0 : GB p.1 * GA p.2 = 0 := (div_eq_zero_iff.mp hq0).resolve_right (ne_of_gt hgbar_pos)
            rcases mul_eq_zero.mp hmul0 with hGB0 | hGA0
            · have hle : μB p.2 * g p ≤ GB p.1 :=
                Finset.single_le_sum (fun b _ => mul_nonneg (hB.1 b) (hg (p.1, b))) (Finset.mem_univ p.2)
              have h1 : μB p.2 * g p = 0 := le_antisymm (hle.trans_eq hGB0) (mul_nonneg (hB.1 p.2) (hg p))
              exact (mul_eq_zero.mp h1).resolve_left (ne_of_gt hb_pos)
            · have hle : μA p.1 * g p ≤ GA p.2 :=
                Finset.single_le_sum (fun a _ => mul_nonneg (hA.1 a) (hg (a, p.2))) (Finset.mem_univ p.1)
              have h1 : μA p.1 * g p = 0 := le_antisymm (hle.trans_eq hGA0) (mul_nonneg (hA.1 p.1) (hg p))
              exact (mul_eq_zero.mp h1).resolve_left (ne_of_gt ha_pos)
      have hsum_nn : 0 ≤ ∑ p : A × B, prodWeight μA μB p *
          (phiEnt (g p) - (if q p ≤ 0 then 0 else g p * Real.log (q p)) - (g p - q p)) :=
        Finset.sum_nonneg (fun p _ => hterm_nn p)
      have hlog_eq : ∀ p : A × B, prodWeight μA μB p > 0 →
          prodWeight μA μB p * (if q p ≤ 0 then 0 else g p * Real.log (q p)) =
            prodWeight μA μB p * g p * (Real.log (GB p.1) + Real.log (GA p.2) - Real.log gbar) := by
        intro p hp_pos
        rcases (hg p).eq_or_lt with hgp0 | hgp_pos
        · rw [← hgp0]; simp
        · have ha_pos : 0 < μA p.1 := pos_of_mul_pos_left hp_pos (hB.1 p.2)
          have hb_pos : 0 < μB p.2 := pos_of_mul_pos_right hp_pos (hA.1 p.1)
          have hGB_pos : 0 < GB p.1 := by
            have hle : μB p.2 * g p ≤ GB p.1 :=
              Finset.single_le_sum (fun b _ => mul_nonneg (hB.1 b) (hg (p.1, b))) (Finset.mem_univ p.2)
            exact lt_of_lt_of_le (mul_pos hb_pos hgp_pos) hle
          have hGA_pos : 0 < GA p.2 := by
            have hle : μA p.1 * g p ≤ GA p.2 :=
              Finset.single_le_sum (fun a _ => mul_nonneg (hA.1 a) (hg (a, p.2))) (Finset.mem_univ p.1)
            exact lt_of_lt_of_le (mul_pos ha_pos hgp_pos) hle
          have hq_pos : 0 < q p := div_pos (mul_pos hGB_pos hGA_pos) hgbar_pos
          rw [if_neg (not_le.mpr hq_pos)]
          dsimp [q]
          rw [Real.log_div (ne_of_gt (mul_pos hGB_pos hGA_pos)) (ne_of_gt hgbar_pos),
            Real.log_mul (ne_of_gt hGB_pos) (ne_of_gt hGA_pos)]
          ring
      have hsum_id : (∑ p : A × B, prodWeight μA μB p *
          (phiEnt (g p) - (if q p ≤ 0 then 0 else g p * Real.log (q p)) - (g p - q p))) =
          expVal μA (fun a => entProb μB (fun b => g (a, b))) - entProb μB GA := by
        have hsplit : ∀ p : A × B,
            prodWeight μA μB p * (phiEnt (g p) - (if q p ≤ 0 then 0 else g p * Real.log (q p)) - (g p - q p)) =
            prodWeight μA μB p * phiEnt (g p) -
            prodWeight μA μB p * g p * (Real.log (GB p.1) + Real.log (GA p.2) - Real.log gbar) -
            (prodWeight μA μB p * g p - prodWeight μA μB p * q p) := by
          intro p
          rcases (mul_nonneg (hA.1 p.1) (hB.1 p.2)).eq_or_lt with hp0 | hp_pos
          · have hp0' : prodWeight μA μB p = 0 := hp0.symm
            rw [hp0']; ring
          · have hl := hlog_eq p hp_pos
            calc prodWeight μA μB p * (phiEnt (g p) - (if q p ≤ 0 then 0 else g p * Real.log (q p)) - (g p - q p))
                = prodWeight μA μB p * phiEnt (g p) -
                  prodWeight μA μB p * (if q p ≤ 0 then 0 else g p * Real.log (q p)) -
                  (prodWeight μA μB p * g p - prodWeight μA μB p * q p) := by ring
              _ = _ := by rw [hl]
        simp_rw [hsplit, Finset.sum_sub_distrib]
        have h1 : (∑ p : A × B, prodWeight μA μB p * phiEnt (g p)) =
            expVal μA (fun a => expVal μB (fun b => phiEnt (g (a, b)))) :=
          expVal_prodWeight μA μB (fun p => phiEnt (g p))
        have h2 : (∑ p : A × B, prodWeight μA μB p * g p *
            (Real.log (GB p.1) + Real.log (GA p.2) - Real.log gbar)) =
            expVal μA (fun a => phiEnt (GB a)) + expVal μB (fun b => phiEnt (GA b)) - phiEnt gbar := by
          have hrew : ∀ p : A × B,
              prodWeight μA μB p * g p * (Real.log (GB p.1) + Real.log (GA p.2) - Real.log gbar) =
              prodWeight μA μB p * (g p * Real.log (GB p.1)) +
              prodWeight μA μB p * (g p * Real.log (GA p.2)) -
              prodWeight μA μB p * (g p * Real.log gbar) := fun p => by ring
          simp_rw [hrew, Finset.sum_sub_distrib, Finset.sum_add_distrib]
          have ha : (∑ p : A × B, prodWeight μA μB p * (g p * Real.log (GB p.1))) =
              expVal μA (fun a => phiEnt (GB a)) := by
            change expVal (prodWeight μA μB) (fun p => g p * Real.log (GB p.1)) = _
            rw [expVal_prodWeight]
            refine Finset.sum_congr rfl (fun a _ => ?_)
            have hmul : (∑ b : B, μB b * (g (a, b) * Real.log (GB a))) = GB a * Real.log (GB a) := by
              have hrew' : ∀ b, μB b * (g (a, b) * Real.log (GB a)) = (μB b * g (a, b)) * Real.log (GB a) :=
                fun b => by ring
              simp_rw [hrew', ← Finset.sum_mul]; rfl
            change μA a * (∑ b : B, μB b * (g (a, b) * Real.log (GB a))) = μA a * phiEnt (GB a)
            rw [hmul]
            rcases (hGB_nn a).eq_or_lt with hGB0 | hGB_pos
            · rw [← hGB0, phiEnt_zero, zero_mul]
            · rw [phiEnt_pos hGB_pos]
          have hb : (∑ p : A × B, prodWeight μA μB p * (g p * Real.log (GA p.2))) =
              expVal μB (fun b => phiEnt (GA b)) := by
            change expVal (prodWeight μA μB) (fun p => g p * Real.log (GA p.2)) = _
            rw [expVal_prodWeight_comm]
            refine Finset.sum_congr rfl (fun b _ => ?_)
            have hmul : (∑ a : A, μA a * (g (a, b) * Real.log (GA b))) = GA b * Real.log (GA b) := by
              have hrew' : ∀ a, μA a * (g (a, b) * Real.log (GA b)) = (μA a * g (a, b)) * Real.log (GA b) :=
                fun a => by ring
              simp_rw [hrew', ← Finset.sum_mul]; rfl
            change μB b * (∑ a : A, μA a * (g (a, b) * Real.log (GA b))) = μB b * phiEnt (GA b)
            rw [hmul]
            rcases (hGA_nn b).eq_or_lt with hGA0 | hGA_pos
            · rw [← hGA0, phiEnt_zero, zero_mul]
            · rw [phiEnt_pos hGA_pos]
          have hc : (∑ p : A × B, prodWeight μA μB p * (g p * Real.log gbar)) = phiEnt gbar := by
            have hrew' : ∀ p, prodWeight μA μB p * (g p * Real.log gbar) =
                (prodWeight μA μB p * g p) * Real.log gbar := fun p => by ring
            simp_rw [hrew', ← Finset.sum_mul]
            change gbar * Real.log gbar = phiEnt gbar
            rw [phiEnt_pos hgbar_pos]
          rw [ha, hb, hc]
        have h3 : (∑ p : A × B, (prodWeight μA μB p * g p - prodWeight μA μB p * q p)) = 0 := by
          have hsum_q : (∑ p : A × B, prodWeight μA μB p * q p) = gbar := by
            rw [Fintype.sum_prod_type]
            have hrew' : ∀ a b, prodWeight μA μB (a, b) * q (a, b) =
                (μA a * GB a) * (μB b * GA b) / gbar := fun a b => by dsimp [prodWeight, q]; ring
            simp_rw [hrew', ← Finset.sum_div, ← Finset.mul_sum, ← Finset.sum_mul]
            change (expVal μA GB * expVal μB GA) / gbar = gbar
            rw [hsumGB, hsumGA]
            field_simp [ne_of_gt hgbar_pos]
          rw [Finset.sum_sub_distrib]
          change gbar - (∑ p : A × B, prodWeight μA μB p * q p) = 0
          rw [hsum_q, sub_self]
        rw [h1, h2, ← Finset.sum_sub_distrib, h3, sub_zero]
        unfold entProb
        rw [expVal_sub, hsumGA]
        ring
      linarith
    linarith

/-- **`M`-Factor Entropy Tensorization (`C/B/P`)**:
`Ent_{μ^{⊗ M}}(g) ≤ ∑ i : Fin M, E_{μ^{⊗ M}}[Ent_i(condSlice g i x)]`. -/
theorem ent_pi_tensor_subadditivity :
    ∀ {M : ℕ} {Q : Type*} [Fintype Q] (μ : Fin M → Q → ℝ),
      (∀ i : Fin M, IsProbWeight (μ i)) →
      ∀ (g : (Fin M → Q) → ℝ), (∀ x, 0 ≤ g x) →
        entProb (piProdWeight μ) g ≤
          ∑ i : Fin M, expVal (piProdWeight μ) (fun x => entProb (μ i) (condSlice g i x))
  | 0, Q, _, μ, _, g, _ => by
      have h0 : entProb (piProdWeight μ) g = 0 := by
        unfold entProb expVal piProdWeight
        simp
      simp [h0]
  | M + 1, Q, _, μ, hμ, g, hg => by
      let μtail : Fin M → Q → ℝ := fun j => μ j.succ
      have htail : IsProbWeight (piProdWeight μtail) :=
        isProbWeight_piProdWeight μtail (fun j => hμ j.succ)
      let e := consEquiv M Q
      let g_prod : Q × (Fin M → Q) → ℝ := fun p => g (e p)
      have hent_eq : entProb (piProdWeight μ) g = entProb (prodWeight (μ 0) (piProdWeight μtail)) g_prod := by
        have hm : expVal (piProdWeight μ) g = expVal (prodWeight (μ 0) (piProdWeight μtail)) g_prod := by
          rw [expVal_piProdWeight_succ, expVal_prodWeight]; rfl
        unfold entProb
        rw [hm, expVal_piProdWeight_succ]
        congr 1
        exact (expVal_prodWeight (μ 0) (piProdWeight μtail) (fun x => phiEnt (g_prod x))).symm
      have hes := ent_two_factor_subadditivity (hμ 0) htail (g := g_prod) (fun p => hg (e p))
      have hterm0 : expVal (piProdWeight μtail) (fun y => entProb (μ 0) (fun q0 => g_prod (q0, y))) =
          expVal (piProdWeight μ) (fun x => entProb (μ 0) (condSlice g 0 x)) := by
        rw [expVal_piProdWeight_succ]
        have hconst : ∀ q0 : Q,
            expVal (piProdWeight μtail) (fun y => entProb (μ 0) (condSlice g 0 (Fin.cons (α := fun _ => Q) q0 y))) =
            expVal (piProdWeight μtail) (fun y => entProb (μ 0) (fun q => g_prod (q, y))) := by
          intro q0
          refine Finset.sum_congr rfl (fun y _ => ?_)
          have hslice : condSlice g 0 (Fin.cons (α := fun _ => Q) q0 y) = fun q => g_prod (q, y) := by
            funext q
            change g (Function.update (Fin.cons (α := fun _ => Q) q0 y) 0 q) = g (Fin.cons (α := fun _ => Q) q y)
            rw [cons_update_zero]
          change piProdWeight μtail y * entProb (μ 0) (condSlice g 0 (Fin.cons (α := fun _ => Q) q0 y)) = _
          rw [hslice]
        change expVal (piProdWeight μtail) (fun y => entProb (μ 0) (fun q0 => g_prod (q0, y))) =
          expVal (μ 0) (fun q0 => expVal (piProdWeight μtail)
            (fun y => entProb (μ 0) (condSlice g 0 (Fin.cons (α := fun _ => Q) q0 y))))
        simp_rw [hconst, expVal_const (hμ 0)]
      have htail_ih :
          expVal (μ 0) (fun q0 => entProb (piProdWeight μtail) (fun y => g_prod (q0, y))) ≤
          ∑ j : Fin M, expVal (piProdWeight μ) (fun x => entProb (μ j.succ) (condSlice g j.succ x)) := by
        have hpt : ∀ q0 : Q,
            entProb (piProdWeight μtail) (fun y => g_prod (q0, y)) ≤
            ∑ j : Fin M, expVal (piProdWeight μtail)
              (fun y => entProb (μ j.succ) (condSlice g j.succ (Fin.cons (α := fun _ => Q) q0 y))) := by
          intro q0
          have ih := ent_pi_tensor_subadditivity μtail (fun j => hμ j.succ)
            (fun y => g_prod (q0, y)) (fun y => hg (e (q0, y)))
          refine ih.trans_eq (Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun y _ => ?_)))
          have hslice : condSlice (fun y => g_prod (q0, y)) j y =
              condSlice g j.succ (Fin.cons (α := fun _ => Q) q0 y) := by
            funext q
            change g (Fin.cons (α := fun _ => Q) q0 (Function.update y j q)) =
              g (Function.update (Fin.cons (α := fun _ => Q) q0 y) j.succ q)
            rw [cons_update_succ]
          change piProdWeight μtail y * entProb (μtail j) (condSlice (fun y => g_prod (q0, y)) j y) = _
          rw [hslice]
        calc expVal (μ 0) (fun q0 => entProb (piProdWeight μtail) (fun y => g_prod (q0, y)))
            ≤ expVal (μ 0) (fun q0 => ∑ j : Fin M, expVal (piProdWeight μtail)
                (fun y => entProb (μ j.succ) (condSlice g j.succ (Fin.cons (α := fun _ => Q) q0 y)))) :=
              expVal_mono (hμ 0) hpt
          _ = ∑ j : Fin M, expVal (μ 0) (fun q0 => expVal (piProdWeight μtail)
                (fun y => entProb (μ j.succ) (condSlice g j.succ (Fin.cons (α := fun _ => Q) q0 y)))) := by
              unfold expVal
              simp_rw [Finset.mul_sum]
              exact Finset.sum_comm
          _ = ∑ j : Fin M, expVal (piProdWeight μ) (fun x => entProb (μ j.succ) (condSlice g j.succ x)) := by
              refine Finset.sum_congr rfl (fun j _ => ?_)
              exact (expVal_piProdWeight_succ μ (fun x => entProb (μ j.succ) (condSlice g j.succ x))).symm
      rw [hent_eq, Fin.sum_univ_succ]
      linarith

/-- Two-point elementary Pinsker inequality on `(p, 1-p)` vs `(q, 1-q)`. `[C/B]` -/
lemma pinsker_two_point_ineq {q p : ℝ} (hq0 : 0 < q) (hq1 : q < 1) (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    2 * (p - q) ^ 2 ≤ q * phiEnt (p / q) + (1 - q) * phiEnt ((1 - p) / (1 - q)) := by
  have h1q_pos : 0 < 1 - q := sub_pos.mpr hq1
  let d : ℝ → ℝ := fun x =>
    q * phiEnt (x / q) + (1 - q) * phiEnt ((1 - x) / (1 - q)) - 2 * (x - q) ^ 2
  let d' : ℝ → ℝ := fun x => Real.log (x / q) - Real.log ((1 - x) / (1 - q)) - 4 * (x - q)
  have hd'_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1,
      HasDerivAt d' (1 / (x * (1 - x)) - 4) x := by
    intro x hx
    have hx0 : 0 < x := hx.1
    have h1x : 0 < 1 - x := sub_pos.mpr hx.2
    have hL1 : HasDerivAt (fun t : ℝ => Real.log (t / q)) (1 / x) x := by
      have hlin : HasDerivAt (fun t : ℝ => t / q) (1 / q) x :=
        (hasDerivAt_id x).div_const q
      refine ((Real.hasDerivAt_log (ne_of_gt (div_pos hx0 hq0))).comp x hlin).congr_deriv ?_
      rw [inv_div]; field_simp [ne_of_gt hq0, ne_of_gt hx0]
    have hL2 : HasDerivAt (fun t : ℝ => Real.log ((1 - t) / (1 - q))) (-(1 / (1 - x))) x := by
      have h1t : HasDerivAt (fun t : ℝ => 1 - t) (-1) x := (hasDerivAt_id x).const_sub 1
      have hlin : HasDerivAt (fun t : ℝ => (1 - t) / (1 - q)) ((-1) / (1 - q)) x :=
        h1t.div_const (1 - q)
      refine ((Real.hasDerivAt_log (ne_of_gt (div_pos h1x h1q_pos))).comp x hlin).congr_deriv ?_
      rw [inv_div]; field_simp [ne_of_gt h1q_pos, ne_of_gt h1x]
    have hL3 : HasDerivAt (fun t : ℝ => 4 * (t - q)) 4 x := by
      have hlin : HasDerivAt (fun t : ℝ => t - q) 1 x := (hasDerivAt_id x).sub_const q
      simpa using hlin.const_mul 4
    refine ((hL1.sub hL2).sub hL3).congr_deriv ?_
    field_simp [ne_of_gt hx0, ne_of_gt h1x]; ring
  have hd'_nonneg_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1, 0 ≤ 1 / (x * (1 - x)) - 4 := by
    intro x hx
    have hx1x_pos : 0 < x * (1 - x) := mul_pos hx.1 (sub_pos.mpr hx.2)
    have hx1x_le : x * (1 - x) ≤ 1 / 4 := by nlinarith [sq_nonneg (x - 1 / 2)]
    rw [sub_nonneg, le_div_iff₀ hx1x_pos]
    linarith
  have hd'_mono : MonotoneOn d' (Set.Ioo (0 : ℝ) 1) :=
    monotoneOn_of_deriv_nonneg (convex_Ioo 0 1)
      (fun x hx => (hd'_deriv x hx).continuousAt.continuousWithinAt)
      (fun x hx => (hd'_deriv x (interior_subset hx)).differentiableAt.differentiableWithinAt)
      (fun x hx => by
        rw [(hd'_deriv x (interior_subset hx)).deriv]
        exact hd'_nonneg_deriv x (interior_subset hx))
  have hd_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt d (d' x) x := by
    intro x hx
    have hx0 : 0 < x := hx.1
    have h1x : 0 < 1 - x := sub_pos.mpr hx.2
    have h1 : HasDerivAt (fun t : ℝ => t * Real.log (t / q)) (Real.log (x / q) + 1) x := by
      have hlog : HasDerivAt (fun t : ℝ => Real.log (t / q)) (1 / x) x := by
        have hlin : HasDerivAt (fun t : ℝ => t / q) (1 / q) x := (hasDerivAt_id x).div_const q
        refine ((Real.hasDerivAt_log (ne_of_gt (div_pos hx0 hq0))).comp x hlin).congr_deriv ?_
        rw [inv_div]; field_simp [ne_of_gt hq0, ne_of_gt hx0]
      refine ((hasDerivAt_id x).mul hlog).congr_deriv ?_
      change 1 * Real.log (x / q) + x * (1 / x) = Real.log (x / q) + 1
      field_simp [ne_of_gt hx0]
    have h2 : HasDerivAt (fun t : ℝ => (1 - t) * Real.log ((1 - t) / (1 - q)))
        (-(Real.log ((1 - x) / (1 - q)) + 1)) x := by
      have h1t : HasDerivAt (fun t : ℝ => 1 - t) (-1) x := (hasDerivAt_id x).const_sub 1
      have hlog : HasDerivAt (fun t : ℝ => Real.log ((1 - t) / (1 - q))) (-(1 / (1 - x))) x := by
        have hlin : HasDerivAt (fun t : ℝ => (1 - t) / (1 - q)) ((-1) / (1 - q)) x :=
          h1t.div_const (1 - q)
        refine ((Real.hasDerivAt_log (ne_of_gt (div_pos h1x h1q_pos))).comp x hlin).congr_deriv ?_
        rw [inv_div]; field_simp [ne_of_gt h1q_pos, ne_of_gt h1x]
      refine (h1t.mul hlog).congr_deriv ?_
      change (-1) * Real.log ((1 - x) / (1 - q)) + (1 - x) * -(1 / (1 - x)) = _
      field_simp [ne_of_gt h1x]; ring
    have h3 : HasDerivAt (fun t : ℝ => 2 * (t - q) ^ 2) (4 * (x - q)) x := by
      have hsq : HasDerivAt (fun t : ℝ => (t - q) ^ 2) (2 * (x - q)) x :=
        (((hasDerivAt_id x).sub_const q).pow 2).congr_deriv (by simp)
      refine (hsq.const_mul 2).congr_deriv ?_; ring
    have hEq : Set.EqOn d
        (fun t => t * Real.log (t / q) + (1 - t) * Real.log ((1 - t) / (1 - q)) - 2 * (t - q) ^ 2)
        (Set.Ioo 0 1) := by
      intro t ht
      have htp : 0 < t / q := div_pos ht.1 hq0
      have ht1p : 0 < (1 - t) / (1 - q) := div_pos (sub_pos.mpr ht.2) h1q_pos
      change q * phiEnt (t / q) + (1 - q) * phiEnt ((1 - t) / (1 - q)) - 2 * (t - q) ^ 2 = _
      rw [phiEnt_pos htp, phiEnt_pos ht1p]
      field_simp [ne_of_gt hq0, ne_of_gt h1q_pos]
    have hd_open : HasDerivAt
        (fun t => t * Real.log (t / q) + (1 - t) * Real.log ((1 - t) / (1 - q)) - 2 * (t - q) ^ 2)
        (d' x) x := by
      refine ((h1.add h2).sub h3).congr_deriv ?_
      change Real.log (x / q) + 1 + -(Real.log ((1 - x) / (1 - q)) + 1) - 4 * (x - q) = _
      ring
    exact hd_open.congr_of_eventuallyEq (isOpen_Ioo.eventually_mem hx |>.mono hEq)
  have hd_cont : ContinuousOn d (Set.Icc 0 1) := by
    have hd_all : Continuous d :=
      ((continuous_const.mul (phiEnt_continuous.comp (continuous_id.div_const q))).add
        (continuous_const.mul (phiEnt_continuous.comp ((continuous_const.sub continuous_id).div_const (1 - q))))).sub
        (continuous_const.mul ((continuous_id.sub continuous_const).pow 2))
    exact hd_all.continuousOn
  have hdq : d q = 0 := by
    dsimp [d]
    rw [div_self (ne_of_gt hq0), div_self (ne_of_gt h1q_pos), phiEnt_one]
    ring
  have hd'q : d' q = 0 := by
    dsimp [d']
    rw [div_self (ne_of_gt hq0), div_self (ne_of_gt h1q_pos), Real.log_one, sub_self, sub_self, mul_zero, sub_zero]
  have hgoal : 0 ≤ d p := by
    rcases lt_trichotomy p q with hpq | rfl | hpq
    · have hmono : AntitoneOn d (Set.Icc 0 q) := by
        refine antitoneOn_of_deriv_nonpos (convex_Icc 0 q)
          (hd_cont.mono (Set.Icc_subset_Icc_right (le_of_lt hq1))) ?_ ?_
        · intro x hx
          rw [interior_Icc] at hx
          exact (hd_deriv x ⟨hx.1, hx.2.trans hq1⟩).differentiableAt.differentiableWithinAt
        · intro x hx
          rw [interior_Icc] at hx
          rw [(hd_deriv x ⟨hx.1, hx.2.trans hq1⟩).deriv, ← hd'q]
          exact hd'_mono ⟨hx.1, hx.2.trans hq1⟩ ⟨hq0, hq1⟩ (le_of_lt hx.2)
      rw [← hdq]
      exact hmono ⟨hp0, le_of_lt hpq⟩ ⟨le_of_lt hq0, le_rfl⟩ (le_of_lt hpq)
    · rw [hdq]
    · have hmono : MonotoneOn d (Set.Icc q 1) := by
        refine monotoneOn_of_deriv_nonneg (convex_Icc q 1)
          (hd_cont.mono (Set.Icc_subset_Icc_left (le_of_lt hq0))) ?_ ?_
        · intro x hx
          rw [interior_Icc] at hx
          exact (hd_deriv x ⟨hq0.trans hx.1, hx.2⟩).differentiableAt.differentiableWithinAt
        · intro x hx
          rw [interior_Icc] at hx
          rw [(hd_deriv x ⟨hq0.trans hx.1, hx.2⟩).deriv, ← hd'q]
          exact hd'_mono ⟨hq0, hq1⟩ ⟨hq0.trans hx.1, hx.2⟩ (le_of_lt hx.1)
      rw [← hdq]
      exact hmono ⟨le_rfl, le_of_lt hq1⟩ ⟨le_of_lt hpq, hp1⟩ (le_of_lt hpq)
  dsimp [d] at hgoal
  linarith

private lemma kl_subset_data_processing {S : Type*} [Fintype S]
    {ν μ : S → ℝ} (hν : IsProbWeight ν) (hμ : IsProbWeight μ)
    (hac : ∀ x, μ x = 0 → ν x = 0) (A : Finset S)
    (hμA : 0 < ∑ x ∈ A, μ x) :
    (∑ x ∈ A, μ x) * phiEnt ((∑ x ∈ A, ν x) / (∑ x ∈ A, μ x)) ≤
      ∑ x ∈ A, if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x) := by
  set pA := ∑ x ∈ A, ν x
  set qA := ∑ x ∈ A, μ x
  let rA := pA / qA
  have hrA_nn : 0 ≤ rA := div_nonneg (Finset.sum_nonneg (fun x _ => hν.1 x)) (le_of_lt hμA)
  rcases hrA_nn.eq_or_lt with hr0 | hr_pos
  · change qA * phiEnt rA ≤ _
    rw [← hr0, phiEnt_zero, mul_zero]
    refine Finset.sum_nonneg (fun x hx => ?_)
    split_ifs with hxle
    · exact le_rfl
    · have hdiv0 : ν x / μ x = 0 := by
        have hpA0 : pA = 0 := (div_eq_zero_iff.mp hr0.symm).resolve_right (ne_of_gt hμA)
        have hle : ν x ≤ pA := Finset.single_le_sum (fun y _ => hν.1 y) hx
        have hνx0 : ν x = 0 := le_antisymm (hle.trans_eq hpA0) (hν.1 x)
        simp [hνx0]
      simp [hdiv0, phiEnt_zero]
  · have hpt : ∀ x ∈ A, μ x * (phiEnt rA + (Real.log rA + 1) * (ν x / μ x - rA)) ≤
        (if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x)) := by
      intro x _
      rcases (hμ.1 x).eq_or_lt with hx0 | hx_pos
      · simp [← hx0]
      · simp only [not_le.mpr hx_pos, ↓reduceIte]
        have hkl := klTerm_nonneg (div_nonneg (hν.1 x) (le_of_lt hx_pos))
          (le_of_lt hr_pos) (fun h => absurd h (ne_of_gt hr_pos))
        simp only [not_le.mpr hr_pos, ↓reduceIte] at hkl
        have hkl' : phiEnt rA + (Real.log rA + 1) * (ν x / μ x - rA) ≤ phiEnt (ν x / μ x) := by
          rw [phiEnt_pos hr_pos]; linarith
        exact mul_le_mul_of_nonneg_left hkl' (le_of_lt hx_pos)
    have hsum := Finset.sum_le_sum hpt
    have hL : (∑ x ∈ A, μ x * (phiEnt rA + (Real.log rA + 1) * (ν x / μ x - rA))) = qA * phiEnt rA := by
      simp_rw [mul_add, Finset.sum_add_distrib]
      have h1 : (∑ x ∈ A, μ x * phiEnt rA) = qA * phiEnt rA := by rw [← Finset.sum_mul]
      have h2 : (∑ x ∈ A, μ x * ((Real.log rA + 1) * (ν x / μ x - rA))) = 0 := by
        have hrew : ∀ x ∈ A, μ x * ((Real.log rA + 1) * (ν x / μ x - rA)) =
            (Real.log rA + 1) * (if μ x = 0 then 0 else ν x - μ x * rA) := by
          intro x _
          rcases (hμ.1 x).eq_or_lt with hx0 | hx_pos
          · simp [← hx0]
          · simp [ne_of_gt hx_pos]; field_simp [ne_of_gt hx_pos]
        have hrew2 : ∀ x ∈ A, (if μ x = 0 then (0 : ℝ) else ν x - μ x * rA) = ν x - μ x * rA := by
          intro x _
          split_ifs with hx0
          · simp [hx0, hac x hx0]
          · rfl
        calc (∑ x ∈ A, μ x * ((Real.log rA + 1) * (ν x / μ x - rA)))
            = ∑ x ∈ A, (Real.log rA + 1) * (ν x - μ x * rA) := by
                refine Finset.sum_congr rfl (fun x hx => by rw [hrew x hx, hrew2 x hx])
          _ = (Real.log rA + 1) * (pA - qA * rA) := by
                rw [← Finset.mul_sum, Finset.sum_sub_distrib, ← Finset.sum_mul]
          _ = 0 := by dsimp [rA]; field_simp [ne_of_gt hμA]; ring
      linarith
    linarith

/-- **Finite-State Pinsker's Inequality (`C/B/P`)**:
For any probability weights `ν, μ` on `S` with `ν ≪ μ` (`∀ x, μ x = 0 → ν x = 0`),
`2 * (1/2 * ∑ x, |ν x - μ x|)^2 ≤ KL(ν ‖ μ)`. -/
theorem pinsker_finite_kl_to_tv {S : Type*} [Fintype S] [DecidableEq S]
    {ν μ : S → ℝ} (hν : IsProbWeight ν) (hμ : IsProbWeight μ)
    (hac : ∀ x, μ x = 0 → ν x = 0) :
    2 * ((1 / 2 : ℝ) * ∑ x : S, |ν x - μ x|) ^ 2 ≤ klDiv ν μ := by
  let A : Finset S := Finset.univ.filter (fun x => μ x ≤ ν x)
  let Ac : Finset S := Finset.univ.filter (fun x => ¬ (μ x ≤ ν x))
  have hpart_abs : (1 / 2 : ℝ) * ∑ x : S, |ν x - μ x| = (∑ x ∈ A, ν x) - (∑ x ∈ A, μ x) := by
    have hsplit : ∑ x : S, (ν x - μ x) = (∑ x ∈ A, (ν x - μ x)) + (∑ x ∈ Ac, (ν x - μ x)) := by
      simpa [A, Ac] using (Finset.sum_filter_add_sum_filter_not Finset.univ (fun x => μ x ≤ ν x)
        (fun x => ν x - μ x)).symm
    have hzero : ∑ x : S, (ν x - μ x) = 0 := by
      rw [Finset.sum_sub_distrib, hν.2, hμ.2, sub_self]
    have hsplit_abs : ∑ x : S, |ν x - μ x| =
        (∑ x ∈ A, |ν x - μ x|) + (∑ x ∈ Ac, |ν x - μ x|) := by
      simpa [A, Ac] using (Finset.sum_filter_add_sum_filter_not Finset.univ (fun x => μ x ≤ ν x)
        (fun x => |ν x - μ x|)).symm
    have hA : ∑ x ∈ A, |ν x - μ x| = ∑ x ∈ A, (ν x - μ x) := by
      refine Finset.sum_congr rfl (fun x hx => ?_)
      rw [Finset.mem_filter] at hx
      exact abs_of_nonneg (sub_nonneg.mpr hx.2)
    have hAc : ∑ x ∈ Ac, |ν x - μ x| = - ∑ x ∈ Ac, (ν x - μ x) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun x hx => ?_)
      rw [Finset.mem_filter] at hx
      have hlt : ν x < μ x := lt_of_not_ge hx.2
      rw [abs_of_neg (sub_neg.mpr hlt)]
    rw [hsplit_abs, hA, hAc]
    have hAc_eq : ∑ x ∈ Ac, (ν x - μ x) = - ∑ x ∈ A, (ν x - μ x) := by linarith
    rw [hAc_eq, Finset.sum_sub_distrib]; ring
  set p := ∑ x ∈ A, ν x
  set q := ∑ x ∈ A, μ x
  have hp0 : 0 ≤ p := Finset.sum_nonneg (fun x _ => hν.1 x)
  have hq0 : 0 ≤ q := Finset.sum_nonneg (fun x _ => hμ.1 x)
  have hp_compl : ∑ x ∈ Ac, ν x = 1 - p := by
    have hs := (Finset.sum_filter_add_sum_filter_not Finset.univ (fun x => μ x ≤ ν x) ν).symm
    rw [hν.2] at hs
    change 1 = p + ∑ x ∈ Ac, ν x at hs; linarith
  have hq_compl : ∑ x ∈ Ac, μ x = 1 - q := by
    have hs := (Finset.sum_filter_add_sum_filter_not Finset.univ (fun x => μ x ≤ ν x) μ).symm
    rw [hμ.2] at hs
    change 1 = q + ∑ x ∈ Ac, μ x at hs; linarith
  have hp1 : p ≤ 1 := by
    have : 0 ≤ ∑ x ∈ Ac, ν x := Finset.sum_nonneg (fun x _ => hν.1 x)
    linarith
  have hq1 : q ≤ 1 := by
    have : 0 ≤ ∑ x ∈ Ac, μ x := Finset.sum_nonneg (fun x _ => hμ.1 x)
    linarith
  have hkl_split : klDiv ν μ =
      (∑ x ∈ A, if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x)) +
      (∑ x ∈ Ac, if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x)) := by
    unfold klDiv
    simpa [A, Ac] using (Finset.sum_filter_add_sum_filter_not Finset.univ (fun x => μ x ≤ ν x)
      (fun x => if μ x ≤ 0 then 0 else μ x * phiEnt (ν x / μ x))).symm
  rw [hpart_abs]
  change 2 * (p - q) ^ 2 ≤ klDiv ν μ
  rcases hq0.eq_or_lt with hq_zero | hq_pos
  · have hp_zero : p = 0 := by
      refine Finset.sum_eq_zero (fun x hx => hac x ?_)
      have hle : μ x ≤ q := Finset.single_le_sum (fun y _ => hμ.1 y) hx
      exact le_antisymm (hle.trans_eq hq_zero.symm) (hμ.1 x)
    rw [hp_zero, ← hq_zero, sub_self, zero_pow (by norm_num), mul_zero]
    exact klDiv_nonneg hν hμ hac
  · rcases hq1.eq_or_lt with hq_one | hq_lt1
    · have h1p_zero : 1 - p = 0 := by
        rw [← hp_compl]
        refine Finset.sum_eq_zero (fun x hx => hac x ?_)
        have h1q_zero : ∑ y ∈ Ac, μ y = 0 := by linarith
        have hle : μ x ≤ ∑ y ∈ Ac, μ y := Finset.single_le_sum (fun y _ => hμ.1 y) hx
        exact le_antisymm (hle.trans_eq h1q_zero) (hμ.1 x)
      have hp_one : p = 1 := by linarith
      rw [hp_one, hq_one, sub_self, zero_pow (by norm_num), mul_zero]
      exact klDiv_nonneg hν hμ hac
    · have h1q_pos : 0 < ∑ x ∈ Ac, μ x := by rw [hq_compl]; linarith
      have hdpA := kl_subset_data_processing hν hμ hac A hq_pos
      have hdpAc := kl_subset_data_processing hν hμ hac Ac h1q_pos
      rw [hp_compl, hq_compl] at hdpAc
      have h2pt := pinsker_two_point_ineq hq_pos hq_lt1 hp0 hp1
      linarith

/-- Exponential Gronwall helper via `HasDerivAt`: if `f'(t) ≤ -r * f(t)`, then `f(t) ≤ exp(-r * t) * f(0)`. `[C/B]` -/
lemma gronwall_exp_decay_of_hasDerivAt {f f' : ℝ → ℝ} {r : ℝ}
    (hf : ∀ t : ℝ, 0 ≤ t → HasDerivAt f (f' t) t)
    (hbound : ∀ t : ℝ, 0 ≤ t → f' t ≤ -r * f t) :
    ∀ t : ℝ, 0 ≤ t → f t ≤ Real.exp (-r * t) * f 0 := by
  intro t ht
  let g : ℝ → ℝ := fun s => Real.exp (r * s) * f s
  have hg_deriv : ∀ s ∈ Set.Icc (0 : ℝ) t,
      HasDerivAt g (Real.exp (r * s) * (r * f s + f' s)) s := by
    intro s hs
    have hexp : HasDerivAt (fun u : ℝ => Real.exp (r * u)) (Real.exp (r * s) * r) s := by
      have hlin : HasDerivAt (fun u : ℝ => r * u) r s := by
        simpa using (hasDerivAt_id s).const_mul r
      exact hlin.exp
    refine (hexp.mul (hf s hs.1)).congr_deriv ?_
    ring
  have hmono : AntitoneOn g (Set.Icc (0 : ℝ) t) := by
    refine antitoneOn_of_deriv_nonpos (convex_Icc 0 t)
      (fun s hs => (hg_deriv s hs).continuousAt.continuousWithinAt)
      (fun s hs => (hg_deriv s (interior_subset hs)).differentiableAt.differentiableWithinAt)
      (fun s hs => ?_)
    have hs' : s ∈ Set.Icc (0 : ℝ) t := interior_subset hs
    rw [(hg_deriv s hs').deriv]
    have hle : r * f s + f' s ≤ 0 := by linarith [hbound s hs'.1]
    exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt (Real.exp_pos _)) hle
  have hgt0 : g t ≤ g 0 := hmono ⟨le_rfl, ht⟩ ⟨ht, le_rfl⟩ ht
  dsimp [g] at hgt0
  rw [mul_zero, Real.exp_zero, one_mul] at hgt0
  have hmul_pos : 0 < Real.exp (-r * t) := Real.exp_pos _
  have hid : f t = Real.exp (-r * t) * (Real.exp (r * t) * f t) := by
    rw [← mul_assoc, ← Real.exp_add]
    have : -r * t + r * t = 0 := by ring
    rw [this, Real.exp_zero, one_mul]
  rw [hid]
  exact mul_le_mul_of_nonneg_left hgt0 (le_of_lt hmul_pos)

/-- **Log-Sobolev Tensorization, Pinsker Inequality & Clustering Without `dobrushinAlpha < 1` (`C/B/P`)**:
1. **Volume-Independent LSI Tensorization**: `Ent_{μ^{⊗ M}}(f^2) ≤ c_LSI * glauberDirichlet μ w f`
   with `c_LSI(M) = c_LSI(1)` strictly independent of `M`,
2. **Pinsker KL-to-TV Bound**: for any probability density `h ≥ 0` (`E[h] = 1`),
   `1/2 * ∑ |μ_M x * h x - μ_M x| ≤ sqrt (Ent_{μ_M}(h) / 2)`,
3. **Poincaré Exponential Variance & `L^2` Connected-Correlation Decay**: for any semigroup `P_t`
   with `P_0 f = f` and dissipation `d/dt Var(P_t f) = -2 E(P_t f) ≤ -(2/c_P) Var(P_t f)`,
   `Var(P_t f) ≤ exp(-2 t / c_P) * Var(f)` and `|Cov(g, P_t f)| ≤ exp(-t / c_P) * sqrt(Var(g) * Var(f))`
   without requiring `dobrushinAlpha < 1`,
4. **LSI Exponential KL & TV Decay**: if `d/dt Ent(h_t) ≤ -(4 / c_LSI) Ent(h_t)`, then
   `Ent(h_t) ≤ exp(-4 t / c_LSI) Ent(h_0)` and `TV(μ·h_t, μ) ≤ exp(-2 t / c_LSI) sqrt(Ent(h_0) / 2)`. -/
theorem log_sobolev_tensorization_and_pinsker_clustering
    {Q : Type*} [Fintype Q]
    (M : ℕ) (μ : Fin M → Q → ℝ) (hμ : ∀ i : Fin M, IsProbWeight (μ i))
    (w : Fin M → Q → Q → ℝ)
    {c_LSI : ℝ} (_hcLSI_pos : 0 < c_LSI)
    (hsingle_lsi : ∀ (i : Fin M) (g : Q → ℝ),
      entProb (μ i) (fun q => (g q) ^ 2) ≤ c_LSI * edgeDirichlet (μ i) (w i) g) :
    (∀ f : (Fin M → Q) → ℝ,
      entProb (piProdWeight μ) (fun x => (f x) ^ 2) ≤ c_LSI * glauberDirichlet μ w f) ∧
    (∀ h : (Fin M → Q) → ℝ, (∀ x, 0 ≤ h x) → expVal (piProdWeight μ) h = 1 →
      (1 / 2 : ℝ) * ∑ x : Fin M → Q, |piProdWeight μ x * h x - piProdWeight μ x| ≤
        Real.sqrt (entProb (piProdWeight μ) h / 2)) ∧
    (∀ {S : Type*} [Fintype S] (ν : S → ℝ), IsProbWeight ν →
      ∀ (c_P : ℝ), 0 < c_P →
      ∀ (P : ℝ → (S → ℝ) → (S → ℝ)) (E_form : (S → ℝ) → ℝ),
        (∀ f : S → ℝ, P 0 f = f) →
        (∀ g : S → ℝ, varProb ν g ≤ c_P * E_form g) →
        (∀ (f : S → ℝ) (t : ℝ), 0 ≤ t →
          HasDerivAt (fun s => varProb ν (P s f)) (-2 * E_form (P t f)) t) →
        ∀ (f g : S → ℝ) (t : ℝ), 0 ≤ t →
          varProb ν (P t f) ≤ Real.exp (-2 * t / c_P) * varProb ν f ∧
          |covProb ν g (P t f)| ≤ Real.exp (-t / c_P) * Real.sqrt (varProb ν g * varProb ν f)) ∧
    (∀ {S : Type*} [Fintype S] [DecidableEq S] (ν : S → ℝ), IsProbWeight ν →
      ∀ (h : ℝ → S → ℝ) (dh : ℝ → ℝ),
        (∀ t x, 0 ≤ h t x) → (∀ t, expVal ν (h t) = 1) →
        (∀ t, 0 ≤ t → HasDerivAt (fun s => entProb ν (h s)) (dh t) t) →
        (∀ t, 0 ≤ t → dh t ≤ -(4 / c_LSI) * entProb ν (h t)) →
        ∀ t : ℝ, 0 ≤ t →
          entProb ν (h t) ≤ Real.exp (-4 * t / c_LSI) * entProb ν (h 0) ∧
          (1 / 2 : ℝ) * ∑ x : S, |ν x * h t x - ν x| ≤
            Real.exp (-2 * t / c_LSI) * Real.sqrt (entProb ν (h 0) / 2)) := by
  have hμM : IsProbWeight (piProdWeight μ) := isProbWeight_piProdWeight μ hμ
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro f
    calc entProb (piProdWeight μ) (fun x => (f x) ^ 2)
        ≤ ∑ i : Fin M, expVal (piProdWeight μ)
            (fun x => entProb (μ i) (condSlice (fun y => (f y) ^ 2) i x)) :=
          ent_pi_tensor_subadditivity μ hμ (fun x => (f x) ^ 2) (fun _ => sq_nonneg _)
      _ = ∑ i : Fin M, expVal (piProdWeight μ)
            (fun x => entProb (μ i) (fun q => (condSlice f i x q) ^ 2)) := rfl
      _ ≤ ∑ i : Fin M, expVal (piProdWeight μ)
            (fun x => c_LSI * edgeDirichlet (μ i) (w i) (condSlice f i x)) := by
          refine Finset.sum_le_sum (fun i _ => expVal_mono hμM (fun x => hsingle_lsi i (condSlice f i x)))
      _ = c_LSI * glauberDirichlet μ w f := by
          unfold glauberDirichlet
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => expVal_smul _ c_LSI _)
  · intro h hh_nn hh_mean
    let ν : (Fin M → Q) → ℝ := fun x => piProdWeight μ x * h x
    have hν : IsProbWeight ν := ⟨fun x => mul_nonneg (hμM.1 x) (hh_nn x), hh_mean⟩
    have hac : ∀ x, piProdWeight μ x = 0 → ν x = 0 := fun x hx => by simp [ν, hx]
    let _ : DecidableEq (Fin M → Q) := Classical.decEq _
    have hpink := pinsker_finite_kl_to_tv hν hμM hac
    rw [klDiv_density_eq_entProb hμM hh_nn hh_mean] at hpink
    have hsq : ((1 / 2 : ℝ) * ∑ x : Fin M → Q, |ν x - piProdWeight μ x|) ^ 2 ≤
        entProb (piProdWeight μ) h / 2 := by linarith
    exact Real.le_sqrt_of_sq_le hsq
  · intro S _ ν hν c_P hcP_pos P E_form hP0 hpoinc hderiv f g t ht
    have hvar_decay : varProb ν (P t f) ≤ Real.exp (-2 * t / c_P) * varProb ν f := by
      have hrate : ∀ s : ℝ, 0 ≤ s → -2 * E_form (P s f) ≤ -(2 / c_P) * varProb ν (P s f) := by
        intro s _
        have hp := hpoinc (P s f)
        have hdiv : varProb ν (P s f) / c_P ≤ E_form (P s f) := (div_le_iff₀ hcP_pos).mpr (by linarith)
        have hid : -(2 / c_P) * varProb ν (P s f) = -2 * (varProb ν (P s f) / c_P) := by ring
        rw [hid]
        linarith
      have hgr := gronwall_exp_decay_of_hasDerivAt (fun s hs => hderiv f s hs) hrate t ht
      rw [hP0 f] at hgr
      have harg : -(2 / c_P) * t = -2 * t / c_P := by ring
      rwa [harg] at hgr
    refine ⟨hvar_decay, ?_⟩
    have hcs := covProb_sq_le hν g (P t f)
    have hvg : 0 ≤ varProb ν g := varProb_nonneg hν g
    have hprod_le : varProb ν g * varProb ν (P t f) ≤
        (Real.exp (-t / c_P)) ^ 2 * (varProb ν g * varProb ν f) := by
      have hexp_sq : (Real.exp (-t / c_P)) ^ 2 = Real.exp (-2 * t / c_P) := by
        rw [sq, ← Real.exp_add]; congr 1; ring
      rw [hexp_sq]
      calc varProb ν g * varProb ν (P t f)
          ≤ varProb ν g * (Real.exp (-2 * t / c_P) * varProb ν f) :=
            mul_le_mul_of_nonneg_left hvar_decay hvg
        _ = Real.exp (-2 * t / c_P) * (varProb ν g * varProb ν f) := by ring
    have hsq_abs : |covProb ν g (P t f)| ^ 2 ≤
        (Real.exp (-t / c_P) * Real.sqrt (varProb ν g * varProb ν f)) ^ 2 := by
      rw [sq_abs, mul_pow, Real.sq_sqrt (mul_nonneg hvg (varProb_nonneg hν f))]
      exact hcs.trans hprod_le
    exact (sq_le_sq₀ (abs_nonneg _) (mul_nonneg (le_of_lt (Real.exp_pos _)) (Real.sqrt_nonneg _))).mp hsq_abs
  · intro S _ _ ν hν h dh hh_nn hh_mean hderiv hrate t ht
    have hent_decay : entProb ν (h t) ≤ Real.exp (-4 * t / c_LSI) * entProb ν (h 0) := by
      have hgr := gronwall_exp_decay_of_hasDerivAt hderiv hrate t ht
      have harg : -(4 / c_LSI) * t = -4 * t / c_LSI := by ring
      rwa [harg] at hgr
    refine ⟨hent_decay, ?_⟩
    let νt : S → ℝ := fun x => ν x * h t x
    have hνt : IsProbWeight νt := ⟨fun x => mul_nonneg (hν.1 x) (hh_nn t x), hh_mean t⟩
    have hac : ∀ x, ν x = 0 → νt x = 0 := fun x hx => by simp [νt, hx]
    have hpink := pinsker_finite_kl_to_tv hνt hν hac
    rw [klDiv_density_eq_entProb hν (hh_nn t) (hh_mean t)] at hpink
    have hsq1 : ((1 / 2 : ℝ) * ∑ x : S, |ν x * h t x - ν x|) ^ 2 ≤ entProb ν (h t) / 2 := by
      linarith
    have hsq2 : entProb ν (h t) / 2 ≤ (Real.exp (-2 * t / c_LSI)) ^ 2 * (entProb ν (h 0) / 2) := by
      have hexp_sq : (Real.exp (-2 * t / c_LSI)) ^ 2 = Real.exp (-4 * t / c_LSI) := by
        rw [sq, ← Real.exp_add]; congr 1; ring
      rw [hexp_sq]
      linarith
    have hent0_nn : 0 ≤ entProb ν (h 0) := entProb_nonneg hν (hh_nn 0)
    have hrhs : (Real.exp (-2 * t / c_LSI) * Real.sqrt (entProb ν (h 0) / 2)) ^ 2 =
        (Real.exp (-2 * t / c_LSI)) ^ 2 * (entProb ν (h 0) / 2) := by
      rw [mul_pow, Real.sq_sqrt (by linarith)]
    have hsq_le : ((1 / 2 : ℝ) * ∑ x : S, |ν x * h t x - ν x|) ^ 2 ≤
        (Real.exp (-2 * t / c_LSI) * Real.sqrt (entProb ν (h 0) / 2)) ^ 2 :=
      (hsq1.trans hsq2).trans_eq hrhs.symm
    have hlhs_nn : 0 ≤ (1 / 2 : ℝ) * ∑ x : S, |ν x * h t x - ν x| :=
      mul_nonneg (by norm_num) (Finset.sum_nonneg (fun _ _ => abs_nonneg _))
    exact (sq_le_sq₀ hlhs_nn (mul_nonneg (le_of_lt (Real.exp_pos _)) (Real.sqrt_nonneg _))).mp hsq_le

/-! ## 4. Non-Vacuous `Fin M → Bool` Witness & Zegarlinski Bridge (`C/B/P/X`) -/

private lemma bool_gross_lsi_aux {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) :
    (1 / 2 : ℝ) * ((1 + x) * Real.log (1 + x) + (1 - x) * Real.log (1 - x)) ≤
      1 - Real.sqrt (1 - x ^ 2) := by
  let g : ℝ → ℝ := fun u =>
    1 - Real.sqrt (1 - u ^ 2) - (1 / 2 : ℝ) * ((1 + u) * Real.log (1 + u) + (1 - u) * Real.log (1 - u))
  let g' : ℝ → ℝ := fun u => u / Real.sqrt (1 - u ^ 2) - (1 / 2 : ℝ) * (Real.log (1 + u) - Real.log (1 - u))
  have hg'_deriv : ∀ u ∈ Set.Ioo (-1 : ℝ) 1,
      HasDerivAt g' ((1 - Real.sqrt (1 - u ^ 2)) / (Real.sqrt (1 - u ^ 2) * (1 - u ^ 2))) u := by
    intro u hu
    have h1u2 : 0 < 1 - u ^ 2 := by nlinarith [hu.1, hu.2]
    have h1pu : 0 < 1 + u := by linarith [hu.1]
    have h1mu : 0 < 1 - u := by linarith [hu.2]
    have hsq : HasDerivAt (fun t : ℝ => Real.sqrt (1 - t ^ 2))
        ((-2 * u) / (2 * Real.sqrt (1 - u ^ 2))) u := by
      have hin : HasDerivAt (fun t : ℝ => 1 - t ^ 2) (-2 * u) u := by
        have hp : HasDerivAt (fun t : ℝ => t ^ 2) (2 * u) u :=
          ((hasDerivAt_id u).pow 2).congr_deriv (by simp)
        refine (hp.const_sub 1).congr_deriv ?_; ring
      refine (hin.sqrt (ne_of_gt h1u2)).congr_deriv ?_; ring
    have hq : HasDerivAt (fun t : ℝ => t / Real.sqrt (1 - t ^ 2))
        (1 / (Real.sqrt (1 - u ^ 2) * (1 - u ^ 2))) u := by
      refine ((hasDerivAt_id u).div hsq (ne_of_gt (Real.sqrt_pos.mpr h1u2))).congr_deriv ?_
      have hs : Real.sqrt (1 - u ^ 2) ^ 2 = 1 - u ^ 2 := Real.sq_sqrt (le_of_lt h1u2)
      simp only [id_eq]
      field_simp [ne_of_gt (Real.sqrt_pos.mpr h1u2), ne_of_gt h1u2]
      nlinarith [hs]
    have hl1 : HasDerivAt (fun t : ℝ => Real.log (1 + t)) (1 / (1 + u)) u := by
      have hin : HasDerivAt (fun t : ℝ => 1 + t) 1 u := (hasDerivAt_id u).const_add 1
      refine ((Real.hasDerivAt_log (ne_of_gt h1pu)).comp u hin).congr_deriv ?_; ring
    have hl2 : HasDerivAt (fun t : ℝ => Real.log (1 - t)) (-(1 / (1 - u))) u := by
      have hin : HasDerivAt (fun t : ℝ => 1 - t) (-1) u := (hasDerivAt_id u).const_sub 1
      refine ((Real.hasDerivAt_log (ne_of_gt h1mu)).comp u hin).congr_deriv ?_; ring
    refine (hq.sub ((hl1.sub hl2).const_mul (1 / 2 : ℝ))).congr_deriv ?_
    have hs : Real.sqrt (1 - u ^ 2) ^ 2 = 1 - u ^ 2 := Real.sq_sqrt (le_of_lt h1u2)
    field_simp [ne_of_gt (Real.sqrt_pos.mpr h1u2), ne_of_gt h1u2, ne_of_gt h1pu, ne_of_gt h1mu]
    nlinarith [hs]
  have hg'_nonneg_deriv : ∀ u ∈ Set.Ioo (-1 : ℝ) 1,
      0 ≤ (1 - Real.sqrt (1 - u ^ 2)) / (Real.sqrt (1 - u ^ 2) * (1 - u ^ 2)) := by
    intro u hu
    have h1u2 : 0 < 1 - u ^ 2 := by nlinarith [hu.1, hu.2]
    have hsq_le : Real.sqrt (1 - u ^ 2) ≤ 1 := by
      rw [Real.sqrt_le_one]; nlinarith [sq_nonneg u]
    exact div_nonneg (sub_nonneg.mpr hsq_le)
      (mul_nonneg (Real.sqrt_nonneg _) (le_of_lt h1u2))
  have hg'_mono : MonotoneOn g' (Set.Ioo (-1 : ℝ) 1) :=
    monotoneOn_of_deriv_nonneg (convex_Ioo (-1) 1)
      (fun u hu => (hg'_deriv u hu).continuousAt.continuousWithinAt)
      (fun u hu => (hg'_deriv u (interior_subset hu)).differentiableAt.differentiableWithinAt)
      (fun u hu => by
        rw [(hg'_deriv u (interior_subset hu)).deriv]
        exact hg'_nonneg_deriv u (interior_subset hu))
  have hg_deriv : ∀ u ∈ Set.Ioo (-1 : ℝ) 1, HasDerivAt g (g' u) u := by
    intro u hu
    have h1u2 : 0 < 1 - u ^ 2 := by nlinarith [hu.1, hu.2]
    have h1pu : 0 < 1 + u := by linarith [hu.1]
    have h1mu : 0 < 1 - u := by linarith [hu.2]
    have hsq : HasDerivAt (fun t : ℝ => 1 - Real.sqrt (1 - t ^ 2)) (u / Real.sqrt (1 - u ^ 2)) u := by
      have hin : HasDerivAt (fun t : ℝ => 1 - t ^ 2) (-2 * u) u := by
        have hp : HasDerivAt (fun t : ℝ => t ^ 2) (2 * u) u :=
          ((hasDerivAt_id u).pow 2).congr_deriv (by simp)
        refine (hp.const_sub 1).congr_deriv ?_; ring
      refine ((hin.sqrt (ne_of_gt h1u2)).const_sub 1).congr_deriv ?_
      field_simp [ne_of_gt (Real.sqrt_pos.mpr h1u2)]
    have hl1 : HasDerivAt (fun t : ℝ => (1 + t) * Real.log (1 + t)) (Real.log (1 + u) + 1) u := by
      have hin : HasDerivAt (fun t : ℝ => 1 + t) 1 u := (hasDerivAt_id u).const_add 1
      have hlog : HasDerivAt (fun t : ℝ => Real.log (1 + t)) (1 / (1 + u)) u := by
        refine ((Real.hasDerivAt_log (ne_of_gt h1pu)).comp u hin).congr_deriv ?_; ring
      refine (hin.mul hlog).congr_deriv ?_
      change 1 * Real.log (1 + u) + (1 + u) * (1 / (1 + u)) = Real.log (1 + u) + 1
      field_simp [ne_of_gt h1pu]
    have hl2 : HasDerivAt (fun t : ℝ => (1 - t) * Real.log (1 - t)) (-(Real.log (1 - u) + 1)) u := by
      have hin : HasDerivAt (fun t : ℝ => 1 - t) (-1) u := (hasDerivAt_id u).const_sub 1
      have hlog : HasDerivAt (fun t : ℝ => Real.log (1 - t)) (-(1 / (1 - u))) u := by
        refine ((Real.hasDerivAt_log (ne_of_gt h1mu)).comp u hin).congr_deriv ?_; ring
      refine (hin.mul hlog).congr_deriv ?_
      change (-1) * Real.log (1 - u) + (1 - u) * -(1 / (1 - u)) = -(Real.log (1 - u) + 1)
      field_simp [ne_of_gt h1mu]; ring
    refine (hsq.sub ((hl1.add hl2).const_mul (1 / 2 : ℝ))).congr_deriv ?_
    dsimp [g']; ring
  have hg_mono : MonotoneOn g (Set.Ico 0 1) := by
    refine monotoneOn_of_deriv_nonneg (convex_Ico 0 1) ?_ ?_ ?_
    · intro u hu
      have h1pu : 0 < 1 + u := by linarith [hu.1]
      have h1mu : 0 < 1 - u := by linarith [hu.2]
      have hcont : ContinuousAt g u := by
        have h1 : ContinuousAt (fun t : ℝ => 1 - Real.sqrt (1 - t ^ 2)) u :=
          continuousAt_const.sub ((continuousAt_const.sub (continuousAt_id.pow 2)).sqrt)
        have h2 : ContinuousAt (fun t : ℝ => (1 + t) * Real.log (1 + t)) u :=
          (continuousAt_const.add continuousAt_id).mul
            (Real.continuousAt_log (ne_of_gt h1pu) |>.comp (continuousAt_const.add continuousAt_id))
        have h3 : ContinuousAt (fun t : ℝ => (1 - t) * Real.log (1 - t)) u :=
          (continuousAt_const.sub continuousAt_id).mul
            (Real.continuousAt_log (ne_of_gt h1mu) |>.comp (continuousAt_const.sub continuousAt_id))
        exact h1.sub (continuousAt_const.mul (h2.add h3))
      exact hcont.continuousWithinAt
    · intro u hu
      rw [interior_Ico] at hu
      exact (hg_deriv u ⟨by linarith [hu.1], hu.2⟩).differentiableAt.differentiableWithinAt
    · intro u hu
      rw [interior_Ico] at hu
      have huIoo : u ∈ Set.Ioo (-1 : ℝ) 1 := ⟨by linarith [hu.1], hu.2⟩
      rw [(hg_deriv u huIoo).deriv]
      have hg'0 : g' 0 = 0 := by simp [g']
      rw [← hg'0]
      exact hg'_mono ⟨by norm_num, by norm_num⟩ huIoo (le_of_lt hu.1)
  have hg0 : g 0 = 0 := by simp [g]
  have hgx : g 0 ≤ g x := hg_mono ⟨le_rfl, by norm_num⟩ ⟨hx0, hx1⟩ hx0
  rw [hg0] at hgx
  dsimp [g] at hgx
  linarith

private lemma bool_single_site_gross_lsi (g : Bool → ℝ) :
    let μ_b : Bool → ℝ := fun _ => (1 / 2 : ℝ)
    let w_b : Bool → Bool → ℝ := fun _ _ => (1 / 2 : ℝ)
    entProb μ_b (fun q => (g q) ^ 2) ≤ 2 * edgeDirichlet μ_b w_b g := by
  intro μ_b w_b
  have hvar_eq : varProb μ_b g = edgeDirichlet μ_b w_b g := by
    unfold varProb expVal edgeDirichlet μ_b w_b
    simp; ring
  rw [← hvar_eq]
  have hvar_bool : varProb μ_b g = (1 / 4 : ℝ) * (g false - g true) ^ 2 := by
    unfold varProb expVal μ_b
    simp; ring
  rw [hvar_bool]
  set a := g false
  set b := g true
  set s := (a ^ 2 + b ^ 2) / 2
  have hs_nn : 0 ≤ s := by positivity
  rcases hs_nn.eq_or_lt with hs0 | hs_pos
  · dsimp [s] at hs0
    have hs0' : a ^ 2 + b ^ 2 = 0 := by linarith
    have ha0 : a = 0 := by nlinarith [sq_nonneg a, sq_nonneg b]
    have hb0 : b = 0 := by nlinarith [sq_nonneg a, sq_nonneg b]
    unfold entProb expVal μ_b
    simp [a, b, ha0, hb0, phiEnt_zero]
  · set x := (a ^ 2 - b ^ 2) / (a ^ 2 + b ^ 2)
    have hab_pos : 0 < a ^ 2 + b ^ 2 := by dsimp [s] at hs_pos; linarith
    have hx_abs : |x| ≤ 1 := by
      rw [abs_le]
      constructor
      · dsimp [x]; rw [le_div_iff₀ hab_pos]; nlinarith [sq_nonneg a, sq_nonneg b]
      · dsimp [x]; rw [div_le_one hab_pos]; nlinarith [sq_nonneg a, sq_nonneg b]
    have hx1_le : x ≤ 1 := (abs_le.mp hx_abs).2
    have hEnt_eq : entProb μ_b (fun q => (g q) ^ 2) =
        s * ((1 / 2 : ℝ) * (phiEnt (1 + x) + phiEnt (1 - x))) := by
      have h1px : a ^ 2 = s * (1 + x) := by
        dsimp [s, x]; field_simp [ne_of_gt hab_pos]; ring
      have h1mx : b ^ 2 = s * (1 - x) := by
        dsimp [s, x]; field_simp [ne_of_gt hab_pos]; ring
      have hmean : expVal μ_b (fun q => (g q) ^ 2) = s := by
        unfold expVal μ_b; simp [a, b, s]; ring
      unfold entProb
      rw [hmean]
      unfold expVal μ_b
      simp only [Fintype.sum_bool]
      change (1 / 2 * phiEnt (b ^ 2) + 1 / 2 * phiEnt (a ^ 2)) - phiEnt s =
        s * ((1 / 2 : ℝ) * (phiEnt (1 + x) + phiEnt (1 - x)))
      rw [h1px, h1mx]
      have hscale : ∀ u : ℝ, 0 ≤ u → phiEnt (s * u) = s * phiEnt u + u * (s * Real.log s) := by
        intro u hu
        rcases hu.eq_or_lt with rfl | hu_pos
        · simp [phiEnt_zero]
        · rw [phiEnt_pos (mul_pos hs_pos hu_pos), phiEnt_pos hu_pos,
            Real.log_mul (ne_of_gt hs_pos) (ne_of_gt hu_pos)]
          ring
      rw [hscale (1 + x) (by linarith [abs_le.mp hx_abs]),
        hscale (1 - x) (by linarith [abs_le.mp hx_abs]), phiEnt_pos hs_pos]
      ring
    have hrhs_ge : s * (1 - Real.sqrt (1 - x ^ 2)) ≤ 2 * ((1 / 4 : ℝ) * (a - b) ^ 2) := by
      have hid : 1 - x ^ 2 = (2 * a * b / (a ^ 2 + b ^ 2)) ^ 2 := by
        dsimp [x]; field_simp [ne_of_gt hab_pos]; ring
      rw [hid, Real.sqrt_sq_eq_abs]
      have hmul : s * (1 - |2 * a * b / (a ^ 2 + b ^ 2)|) =
          (a ^ 2 + b ^ 2 - |2 * a * b|) / 2 := by
        dsimp [s]
        rw [abs_div, abs_of_pos hab_pos]
        field_simp [ne_of_gt hab_pos]
      rw [hmul]
      have hle_abs : 2 * a * b ≤ |2 * a * b| := le_abs_self _
      linarith
    have hcore : (1 / 2 : ℝ) * (phiEnt (1 + x) + phiEnt (1 - x)) ≤ 1 - Real.sqrt (1 - x ^ 2) := by
      rcases le_or_gt 0 x with hx_nn | hx_neg
      · rcases eq_or_lt_of_le hx1_le with hx1 | hx_lt1
        · rw [hx1]
          norm_num [phiEnt_zero, phiEnt_pos (by norm_num : (0 : ℝ) < 2)]
          have hlog2 : Real.log 2 ≤ 1 := by
            have h := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
            linarith
          linarith
        · have h1px : 0 < 1 + x := by linarith
          have h1mx : 0 < 1 - x := by linarith
          rw [phiEnt_pos h1px, phiEnt_pos h1mx]
          exact bool_gross_lsi_aux hx_nn hx_lt1
      · let y := -x
        have hy_pos : 0 < y := by linarith
        have hy_le1 : y ≤ 1 := by dsimp [y]; linarith [abs_le.mp hx_abs]
        have hsym1 : phiEnt (1 + x) + phiEnt (1 - x) = phiEnt (1 + y) + phiEnt (1 - y) := by
          dsimp [y]; ring_nf
        have hsym2 : 1 - Real.sqrt (1 - x ^ 2) = 1 - Real.sqrt (1 - y ^ 2) := by
          dsimp [y]; ring_nf
        rw [hsym1, hsym2]
        rcases eq_or_lt_of_le hy_le1 with hy1 | hy_lt1
        · rw [hy1]
          norm_num [phiEnt_zero, phiEnt_pos (by norm_num : (0 : ℝ) < 2)]
          have hlog2 : Real.log 2 ≤ 1 := by
            have h := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
            linarith
          linarith
        · have h1py : 0 < 1 + y := by linarith
          have h1my : 0 < 1 - y := by linarith
          rw [phiEnt_pos h1py, phiEnt_pos h1my]
          exact bool_gross_lsi_aux (le_of_lt hy_pos) hy_lt1
    calc entProb μ_b (fun q => (g q) ^ 2)
        = s * ((1 / 2 : ℝ) * (phiEnt (1 + x) + phiEnt (1 - x))) := hEnt_eq
      _ ≤ s * (1 - Real.sqrt (1 - x ^ 2)) := mul_le_mul_of_nonneg_left hcore hs_nn
      _ ≤ 2 * ((1 / 4 : ℝ) * (a - b) ^ 2) := hrhs_ge

/-- **Concrete `Fin M → Bool` Witness (`C/B/P`, Contrasting `DEAD-20261124-11`)**:
On `Fin M → Bool` with uniform Bernoulli weights `μ_bool b = 1/2` and heat-bath kernel
`w_bool q q' = 1/2`:
1. Single-site Poincaré holds with **exact constant `c_P = 1`** (`varProb μ_bool g = edgeDirichlet μ_bool w_bool g`),
2. Single-site Gross LSI holds with **exact constant `c_LSI = 2`** (`entProb μ_bool (g^2) ≤ 2 * edgeDirichlet μ_bool w_bool g`),
3. By `poincare_variance_tensorization_volume_independent` and `log_sobolev_tensorization_and_pinsker_clustering`,
   both `c_P(M) = 1` and `c_LSI(M) = 2` hold **for every volume `M : ℕ`**, directly contrasting
   `single_site_glauber_bool_witness` (`α = 1`) and `product_dobrushin_bool_witness` (`1 - α(PM) ≤ (3/4)^{M/2} → 0`). -/
theorem bool_tensor_poincare_lsi_concrete_witness (M : ℕ) :
    let μ_b : Bool → ℝ := fun _ => (1 / 2 : ℝ)
    let w_b : Bool → Bool → ℝ := fun _ _ => (1 / 2 : ℝ)
    let μ_M : Fin M → Bool → ℝ := fun _ => μ_b
    let w_M : Fin M → Bool → Bool → ℝ := fun _ => w_b
    (∀ f : (Fin M → Bool) → ℝ, varProb (piProdWeight μ_M) f ≤ 1 * glauberDirichlet μ_M w_M f) ∧
    (∀ f : (Fin M → Bool) → ℝ, entProb (piProdWeight μ_M) (fun x => (f x) ^ 2) ≤
      2 * glauberDirichlet μ_M w_M f) ∧
    ((∀ g : Bool → ℝ, varProb μ_b g = edgeDirichlet μ_b w_b g) ∧
     Filter.Tendsto (fun k : ℕ => ((Real.sqrt 3 / 2 : ℝ) ^ k)) Filter.atTop (nhds 0)) := by
  intro μ_b w_b μ_M w_M
  have hμb : IsProbWeight μ_b := ⟨fun _ => by norm_num, by simp [μ_b]⟩
  have hw_nn : ∀ (_ : Fin M) (_ _ : Bool), (0 : ℝ) ≤ 1 / 2 := fun _ _ _ => by norm_num
  have hvar_eq : ∀ g : Bool → ℝ, varProb μ_b g = edgeDirichlet μ_b w_b g := by
    intro g
    unfold varProb expVal edgeDirichlet μ_b w_b
    simp; ring
  have hpoinc := poincare_variance_tensorization_volume_independent
    M μ_M (fun _ => hμb) w_M hw_nn (by norm_num : (0 : ℝ) ≤ 1)
    (fun _ g => (hvar_eq g).le.trans_eq (by ring))
  have hlsi : ∀ f : (Fin M → Bool) → ℝ,
      entProb (piProdWeight μ_M) (fun x => (f x) ^ 2) ≤ 2 * glauberDirichlet μ_M w_M f :=
    (log_sobolev_tensorization_and_pinsker_clustering.{0, 0, 0}
      M μ_M (fun _ => hμb) w_M (by norm_num : (0 : ℝ) < 2)
      (fun _ g => bool_single_site_gross_lsi g)).1
  have htheta_lt : Real.sqrt 3 / 2 < 1 := by
    have h1 : Real.sqrt 3 < Real.sqrt 4 := Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
    have h2 : Real.sqrt 4 = 2 := by norm_num
    linarith
  exact ⟨hpoinc.1, hlsi, hvar_eq, hpoinc.2.2 (by norm_num) M |>.2 (Real.sqrt 3 / 2) (by positivity) htheta_lt⟩

/-- **Interacting Conditional Zegarlinski Poincaré Transfer (`C/B/P/X`)**:
Bridges product tensorization to an **interacting** joint weight `μ` on `Fin M → Q` (such as a
4D physical-scale blocked Yang–Mills measure):
- `[B/P]` Local conditional Poincaré constant `c_loc ≥ 0` on conditional measures `μ_cond i x`,
- `[X]` Approximate Zegarlinski conditional tensorization constant `K_Z ≥ 0` (`Var_μ(f) ≤ K_Z ∑ i E_μ[Var_{μ_cond i x}(condSlice f i x)]`; note `K_Z = 1` for product measures, and `K_Z = (1 - γ)^{-1}` when inter-block `L^2` dependence is `< 1`).
Yields global volume-independent Poincaré constant `K_Z * c_loc` without `dobrushinAlpha < 1`. -/
theorem interacting_conditional_poincare_uniform_in_volume
    {M : ℕ} {Q : Type*} [Fintype Q]
    (μ : (Fin M → Q) → ℝ) (hμ : IsProbWeight μ)
    (μ_cond : Fin M → (Fin M → Q) → Q → ℝ)
    (w_cond : Fin M → (Fin M → Q) → Q → Q → ℝ)
    {c_loc K_Z : ℝ} (_hc_nn : 0 ≤ c_loc) (hK_nn : 0 ≤ K_Z)
    (hlocal : ∀ (i : Fin M) (x : Fin M → Q) (g : Q → ℝ),
      varProb (μ_cond i x) g ≤ c_loc * edgeDirichlet (μ_cond i x) (w_cond i x) g)
    (hzegarlinski : ∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ K_Z * ∑ i : Fin M, expVal μ (fun x => varProb (μ_cond i x) (condSlice f i x))) :
    ∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ (K_Z * c_loc) *
        ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (μ_cond i x) (w_cond i x) (condSlice f i x)) := by
  intro f
  have hsum : ∑ i : Fin M, expVal μ (fun x => varProb (μ_cond i x) (condSlice f i x)) ≤
      c_loc * ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (μ_cond i x) (w_cond i x) (condSlice f i x)) := by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum (fun i _ => ?_)
    rw [← expVal_smul]
    exact expVal_mono hμ (fun x => hlocal i x (condSlice f i x))
  calc varProb μ f
      ≤ K_Z * ∑ i : Fin M, expVal μ (fun x => varProb (μ_cond i x) (condSlice f i x)) := hzegarlinski f
    _ ≤ K_Z * (c_loc * ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (μ_cond i x) (w_cond i x) (condSlice f i x))) :=
        mul_le_mul_of_nonneg_left hsum hK_nn
    _ = (K_Z * c_loc) * ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (μ_cond i x) (w_cond i x) (condSlice f i x)) := by
        ring


end Round04PoincareLSI
end Round04PoincareLSISection

section Round04IRRGTransferSection
namespace Round04IRRGTransfer

open scoped BigOperators RealInnerProductSpace
open Function Matrix Filter
open UEOT.V3.Compression.QuotientDescent

/-- Spectral-ratio mass gap `log (λ₀ / λ₁)` for `0 < λ₁ < λ₀`, and `log 2 > 0`
in the exact rank-1 one-step orthogonal projection limit `λ₁ = 0`. -/
noncomputable def spectralRatioGap (lambda_0 lambda_1 : ℝ) : ℝ :=
  if 0 < lambda_1 then Real.log (lambda_0 / lambda_1) else Real.log 2

private lemma transpose_pow_eq' {n : ℕ} (T : Matrix (Fin n) (Fin n) ℝ)
    (hSymm : Tᵀ = T) : ∀ m : ℕ, (T ^ m)ᵀ = T ^ m
  | 0 => by simp
  | m + 1 => by
      rw [pow_succ, Matrix.transpose_mul, transpose_pow_eq' T hSymm m, hSymm,
        (Commute.pow_right (Commute.refl T) m).eq, ← pow_succ]

private lemma dotProduct_transpose_mul_self' {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (v : Fin n → ℝ) :
    dotProduct v ((Aᵀ * A).mulVec v) = dotProduct (A.mulVec v) (A.mulVec v) := by
  rw [← Matrix.mulVec_mulVec, dotProduct_mulVec, Matrix.vecMul_transpose]

private lemma dotProduct_self_nonneg' {n : ℕ} (w : Fin n → ℝ) :
    0 ≤ dotProduct w w := by
  unfold dotProduct
  exact Finset.sum_nonneg (fun i _ => mul_self_nonneg (w i))

private lemma psd_pow_of_symm_psd {n : ℕ} (T : Matrix (Fin n) (Fin n) ℝ)
    (hSymm : Tᵀ = T) (hPSD : ∀ v : Fin n → ℝ, 0 ≤ dotProduct v (T.mulVec v)) :
    ∀ m : ℕ, ∀ v : Fin n → ℝ, 0 ≤ dotProduct v ((T ^ m).mulVec v) := by
  intro m v
  rcases Nat.even_or_odd m with ⟨k, rfl⟩ | ⟨k, rfl⟩
  · rw [pow_add]
    have hsymk : (T ^ k)ᵀ = T ^ k := transpose_pow_eq' T hSymm k
    have hsq : T ^ k * T ^ k = (T ^ k)ᵀ * T ^ k := by rw [hsymk]
    rw [hsq, dotProduct_transpose_mul_self']
    exact dotProduct_self_nonneg' ((T ^ k).mulVec v)
  · have hpow : T ^ (2 * k + 1) = (T ^ k)ᵀ * (T * T ^ k) := by
      have hsymk : (T ^ k)ᵀ = T ^ k := transpose_pow_eq' T hSymm k
      have hcomm : T * T ^ k = T ^ k * T := (Commute.pow_right (Commute.refl T) k).eq
      rw [hsymk, two_mul, pow_add, pow_add, pow_one, hcomm, Matrix.mul_assoc]
    rw [hpow, ← Matrix.mulVec_mulVec, dotProduct_mulVec, Matrix.vecMul_transpose,
      ← Matrix.mulVec_mulVec]
    exact hPSD ((T ^ k).mulVec v)

private lemma toEuclideanLin_apply_toLp {N : ℕ} (T : Matrix (Fin N) (Fin N) ℝ) (x : Fin N → ℝ) :
    (Matrix.toEuclideanLin T) (WithLp.toLp 2 x) = WithLp.toLp 2 (T.mulVec x) := by
  ext i
  rfl

private lemma toEuclideanLin_pow {N : ℕ} (T : Matrix (Fin N) (Fin N) ℝ) :
    ∀ n : ℕ, Matrix.toEuclideanLin (T ^ n) = (Matrix.toEuclideanLin T) ^ n
  | 0 => by
      ext x i
      have hx : x = WithLp.toLp 2 x.ofLp := rfl
      rw [hx, pow_zero, pow_zero, toEuclideanLin_apply_toLp, Matrix.one_mulVec]
      rfl
  | n + 1 => by
      have ih := toEuclideanLin_pow T n
      rw [pow_succ, pow_succ]
      ext x i
      have hx : x = WithLp.toLp 2 x.ofLp := rfl
      rw [hx]
      change ((Matrix.toEuclideanLin (T ^ n * T)) (WithLp.toLp 2 x.ofLp)).ofLp i =
        (((Matrix.toEuclideanLin T) ^ n) ((Matrix.toEuclideanLin T) (WithLp.toLp 2 x.ofLp))).ofLp i
      rw [toEuclideanLin_apply_toLp, toEuclideanLin_apply_toLp, ← Matrix.mulVec_mulVec,
        ← toEuclideanLin_apply_toLp (T ^ n) (T.mulVec x.ofLp), ih]

private lemma inner_toLp_eq_dotProduct {N : ℕ} (x y : Fin N → ℝ) :
    inner ℝ (WithLp.toLp 2 x : EuclideanSpace ℝ (Fin N)) (WithLp.toLp 2 y) = dotProduct x y := by
  rw [PiLp.inner_apply]
  unfold dotProduct
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp [mul_comm]

/-- **Transfer-Matrix Spectral-Ratio Exponential Clustering (`C/B/P`)**:
For any finite-rank real symmetric PSD transfer matrix `T : Matrix (Fin N) (Fin N) ℝ` with
leading unit eigenvector `v_0` (`T v_0 = lambda_0 v_0`, `‖v_0‖ = 1`, `lambda_0 > 0`) and
orthogonal-complement spectral bound `⟨u, T u⟩ ≤ lambda_1 ⟨u, u⟩` (`0 ≤ lambda_1 < lambda_0`),
the normalized connected time-slice correlator on every `u ⊥ v_0` decays exponentially across
all Euclidean time steps `n : ℕ`:
1. `0 < spectralRatioGap lambda_0 lambda_1`, and `spectralRatioGap lambda_0 lambda_1 = Real.log (lambda_0 / lambda_1)` whenever `0 < lambda_1`;
2. `0 ≤ ⟨u, T^n u⟩ / lambda_0^n ≤ (lambda_1 / lambda_0)^n * ⟨u, u⟩ ≤ exp(-spectralRatioGap lambda_0 lambda_1 * n) * ⟨u, u⟩`;
3. For `0 < lambda_1`, `⟨u, T^n u⟩ / lambda_0^n ≤ exp(-Real.log (lambda_0 / lambda_1) * n) * ⟨u, u⟩`;
4. For `lambda_1 = 0` (exact rank-1 projector limit), `⟨u, T^n u⟩ / lambda_0^n = 0` for all `n ≥ 1` and `≤ exp(-m_any * n) * ⟨u, u⟩` for every `m_any > 0`. -/
theorem transfer_matrix_spectral_ratio_clustering
    {N : ℕ} (T : Matrix (Fin N) (Fin N) ℝ)
    (hSymm : Tᵀ = T)
    (hPSD : ∀ v : Fin N → ℝ, 0 ≤ dotProduct v (T.mulVec v))
    (v_0 : Fin N → ℝ) (_hv0_norm : dotProduct v_0 v_0 = 1)
    {lambda_0 lambda_1 : ℝ} (hlam0_pos : 0 < lambda_0)
    (hlam1_nn : 0 ≤ lambda_1) (hlam1_lt : lambda_1 < lambda_0)
    (hv0_eig : T.mulVec v_0 = lambda_0 • v_0)
    (hGap : ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 →
      dotProduct u (T.mulVec u) ≤ lambda_1 * dotProduct u u) :
    0 < spectralRatioGap lambda_0 lambda_1 ∧
    (0 < lambda_1 → spectralRatioGap lambda_0 lambda_1 = Real.log (lambda_0 / lambda_1)) ∧
    (∀ u : Fin N → ℝ, dotProduct v_0 u = 0 → ∀ n : ℕ,
      0 ≤ dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ∧
      dotProduct u ((T ^ n).mulVec u) ≤ lambda_1 ^ n * dotProduct u u ∧
      dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
        Real.exp (-spectralRatioGap lambda_0 lambda_1 * (n : ℝ)) * dotProduct u u) ∧
    (0 < lambda_1 → ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 → ∀ n : ℕ,
      dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
        Real.exp (-Real.log (lambda_0 / lambda_1) * (n : ℝ)) * dotProduct u u) ∧
    (lambda_1 = 0 → ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 →
      (∀ n : ℕ, 1 ≤ n → dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n = 0) ∧
      (∀ m_any : ℝ, 0 < m_any → ∀ n : ℕ,
        dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
          Real.exp (-m_any * (n : ℝ)) * dotProduct u u)) := by
  classical
  have hgap_pos : 0 < spectralRatioGap lambda_0 lambda_1 := by
    dsimp [spectralRatioGap]
    split_ifs with h1
    · exact Real.log_pos ((one_lt_div h1).mpr hlam1_lt)
    · exact Real.log_pos (by norm_num)
  have hgap_eq : 0 < lambda_1 → spectralRatioGap lambda_0 lambda_1 = Real.log (lambda_0 / lambda_1) := by
    intro h1
    simp [spectralRatioGap, h1]
  let A : EuclideanSpace ℝ (Fin N) →ₗ[ℝ] EuclideanSpace ℝ (Fin N) := Matrix.toEuclideanLin T
  have hA_symm : A.IsSymmetric := by
    intro x y
    change inner ℝ (A x) y = inner ℝ x (A y)
    have hx : x = WithLp.toLp 2 x.ofLp := rfl
    have hy : y = WithLp.toLp 2 y.ofLp := rfl
    rw [hx, hy]
    dsimp [A]
    rw [toEuclideanLin_apply_toLp, toEuclideanLin_apply_toLp,
      inner_toLp_eq_dotProduct, inner_toLp_eq_dotProduct]
    calc dotProduct (T.mulVec x.ofLp) y.ofLp
        = dotProduct y.ofLp (T.mulVec x.ofLp) := dotProduct_comm _ _
      _ = dotProduct (y.ofLp ᵥ* T) x.ofLp := dotProduct_mulVec _ _ _
      _ = dotProduct (y.ofLp ᵥ* Tᵀ) x.ofLp := by rw [hSymm]
      _ = dotProduct (T.mulVec y.ofLp) x.ofLp := by rw [Matrix.vecMul_transpose]
      _ = dotProduct x.ofLp (T.mulVec y.ofLp) := dotProduct_comm _ _
  have hn : Module.finrank ℝ (EuclideanSpace ℝ (Fin N)) = N := finrank_euclideanSpace_fin
  let b : OrthonormalBasis (Fin N) ℝ (EuclideanSpace ℝ (Fin N)) := hA_symm.eigenvectorBasis hn
  let μ : Fin N → ℝ := hA_symm.eigenvalues hn
  have hdiag : ∀ (i : Fin N) (x : EuclideanSpace ℝ (Fin N)),
      inner ℝ (b i) (A x) = μ i * inner ℝ (b i) x := by
    intro i x
    have h := hA_symm.eigenvectorBasis_apply_self_apply hn x i
    simpa [b, μ, OrthonormalBasis.repr_apply_apply] using h
  have hdiag_pow : ∀ (n : ℕ) (i : Fin N) (x : EuclideanSpace ℝ (Fin N)),
      inner ℝ (b i) ((A ^ n) x) = (μ i) ^ n * inner ℝ (b i) x := by
    intro n i x
    induction n with
    | zero => simp
    | succ n ih =>
        rw [pow_succ', Module.End.mul_apply, hdiag i ((A ^ n) x), ih, pow_succ']
        ring
  have hμ_nn : ∀ i : Fin N, 0 ≤ μ i := by
    intro i
    have hpsd_i := hPSD (b i).ofLp
    have hbi_eq : inner ℝ (b i) (A (b i)) = μ i := by
      rw [hdiag i (b i), real_inner_self_eq_norm_sq, b.orthonormal.1 i, one_pow, mul_one]
    have hinn_eq : inner ℝ (b i) (A (b i)) = dotProduct (b i).ofLp (T.mulVec (b i).ofLp) := by
      have hbi : b i = WithLp.toLp 2 (b i).ofLp := rfl
      conv_lhs => rw [hbi, show A (WithLp.toLp 2 (b i).ofLp) = WithLp.toLp 2 (T.mulVec (b i).ofLp)
        from toEuclideanLin_apply_toLp T (b i).ofLp]
      exact inner_toLp_eq_dotProduct (b i).ofLp (T.mulVec (b i).ofLp)
    linarith
  let v0E : EuclideanSpace ℝ (Fin N) := WithLp.toLp 2 v_0
  have hAv0 : A v0E = lambda_0 • v0E := by
    dsimp [A, v0E]
    exact (toEuclideanLin_apply_toLp T v_0).trans (congrArg (WithLp.toLp 2) hv0_eig)
  have hμ_orth_v0 : ∀ i : Fin N, μ i ≠ lambda_0 → inner ℝ (b i) v0E = 0 := by
    intro i hne
    have h1 : inner ℝ (b i) (A v0E) = μ i * inner ℝ (b i) v0E := hdiag i v0E
    have h2 : inner ℝ (b i) (A v0E) = lambda_0 * inner ℝ (b i) v0E := by
      rw [hAv0, real_inner_smul_right]
    have hmul : (μ i - lambda_0) * inner ℝ (b i) v0E = 0 := by linarith
    exact (mul_eq_zero.mp hmul).resolve_left (sub_ne_zero.mpr hne)
  have hμ_le_of_orth : ∀ i : Fin N, inner ℝ (b i) v0E = 0 → μ i ≤ lambda_1 := by
    intro i horth
    have hdot : dotProduct v_0 (b i).ofLp = 0 := by
      have hbi : b i = WithLp.toLp 2 (b i).ofLp := rfl
      have h1 := inner_toLp_eq_dotProduct v_0 (b i).ofLp
      rw [← hbi] at h1
      rw [← h1, real_inner_comm]
      exact horth
    have hgap_i := hGap (b i).ofLp hdot
    have hbi_inner : inner ℝ (b i) (A (b i)) = μ i := by
      rw [hdiag i (b i), real_inner_self_eq_norm_sq, b.orthonormal.1 i, one_pow, mul_one]
    have hbi_norm : dotProduct (b i).ofLp (b i).ofLp = 1 := by
      have hbi : b i = WithLp.toLp 2 (b i).ofLp := rfl
      have h1 := inner_toLp_eq_dotProduct (b i).ofLp (b i).ofLp
      rw [← hbi, real_inner_self_eq_norm_sq, b.orthonormal.1 i, one_pow] at h1
      exact h1.symm
    have hbi_A : dotProduct (b i).ofLp (T.mulVec (b i).ofLp) = μ i := by
      have hbi : b i = WithLp.toLp 2 (b i).ofLp := rfl
      have h1 := inner_toLp_eq_dotProduct (b i).ofLp (T.mulVec (b i).ofLp)
      rw [← toEuclideanLin_apply_toLp T (b i).ofLp, ← hbi] at h1
      exact h1.symm.trans hbi_inner
    rw [hbi_A, hbi_norm, mul_one] at hgap_i
    exact hgap_i
  have hμ_top : ∀ i : Fin N, lambda_1 < μ i → μ i = lambda_0 := by
    intro i hgt
    by_contra hne
    have horth := hμ_orth_v0 i hne
    linarith [hμ_le_of_orth i horth]
  have hmain_pow : ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 → ∀ n : ℕ,
      dotProduct u ((T ^ n).mulVec u) ≤ lambda_1 ^ n * dotProduct u u := by
    intro u hu_orth n
    let uE : EuclideanSpace ℝ (Fin N) := WithLp.toLp 2 u
    let S_top : Finset (Fin N) := Finset.univ.filter (fun i => lambda_1 < μ i)
    let u_top : EuclideanSpace ℝ (Fin N) := ∑ i ∈ S_top, (inner ℝ (b i) uE) • b i
    have hutop_coord : ∀ j : Fin N, inner ℝ (b j) u_top = if j ∈ S_top then inner ℝ (b j) uE else 0 := by
      intro j
      dsimp [u_top]
      rw [inner_sum]
      have hterm : ∀ i ∈ S_top, inner ℝ (b j) (inner ℝ (b i) uE • b i) =
          if i = j then inner ℝ (b j) uE else 0 := by
        intro i _
        rw [real_inner_smul_right]
        split_ifs with hij
        · subst hij
          rw [real_inner_self_eq_norm_sq, b.orthonormal.1 i, one_pow, mul_one]
        · rw [b.orthonormal.2 (Ne.symm hij), mul_zero]
      rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq']
    have hv0_utop : inner ℝ v0E u_top = 0 := by
      rw [← b.sum_inner_mul_inner v0E u_top]
      have h0 : inner ℝ v0E uE = 0 := by
        rw [inner_toLp_eq_dotProduct]; exact hu_orth
      rw [← b.sum_inner_mul_inner v0E uE] at h0
      have hsum_eq : (∑ i : Fin N, inner ℝ v0E (b i) * inner ℝ (b i) u_top) =
          ∑ i : Fin N, inner ℝ v0E (b i) * inner ℝ (b i) uE := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hutop_coord i]
        by_cases hi : i ∈ S_top
        · simp [hi]
        · have hle : μ i ≤ lambda_1 := by
            simpa [S_top] using hi
          have hne : μ i ≠ lambda_0 := ne_of_lt (lt_of_le_of_lt hle hlam1_lt)
          have horth : inner ℝ v0E (b i) = 0 := by
            rw [real_inner_comm]; exact hμ_orth_v0 i hne
          simp [hi, horth]
      linarith
    have hutop_dot : dotProduct v_0 u_top.ofLp = 0 := by
      have h1 := inner_toLp_eq_dotProduct v_0 u_top.ofLp
      have hut : u_top = WithLp.toLp 2 u_top.ofLp := rfl
      rw [← hut] at h1
      exact h1.symm.trans hv0_utop
    have hgap_top := hGap u_top.ofLp hutop_dot
    have hutop_A : inner ℝ u_top (A u_top) = lambda_0 * ‖u_top‖ ^ 2 := by
      rw [← b.sum_inner_mul_inner u_top (A u_top), ← b.sum_sq_inner_right u_top, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hcomm : inner ℝ u_top (b j) = inner ℝ (b j) u_top := real_inner_comm _ _
      rw [hdiag j u_top, hcomm, hutop_coord j]
      by_cases hj : j ∈ S_top
      · have hμj : μ j = lambda_0 := hμ_top j (Finset.mem_filter.mp hj).2
        simp only [hj, ↓reduceIte, hμj]
        ring
      · simp [hj]
    have hutop_A_dot : dotProduct u_top.ofLp (T.mulVec u_top.ofLp) = lambda_0 * ‖u_top‖ ^ 2 := by
      have h1 := inner_toLp_eq_dotProduct u_top.ofLp (T.mulVec u_top.ofLp)
      have hut : u_top = WithLp.toLp 2 u_top.ofLp := rfl
      rw [← toEuclideanLin_apply_toLp T u_top.ofLp, ← hut] at h1
      exact h1.symm.trans hutop_A
    have hutop_norm_dot : dotProduct u_top.ofLp u_top.ofLp = ‖u_top‖ ^ 2 := by
      have h1 := inner_toLp_eq_dotProduct u_top.ofLp u_top.ofLp
      have hut : u_top = WithLp.toLp 2 u_top.ofLp := rfl
      rw [← hut, real_inner_self_eq_norm_sq] at h1
      exact h1.symm
    have hnorm_zero : ‖u_top‖ ^ 2 = 0 := by
      rw [hutop_A_dot, hutop_norm_dot] at hgap_top
      have hnonpos : (lambda_0 - lambda_1) * ‖u_top‖ ^ 2 ≤ 0 := by linarith
      have hdiff_pos : 0 < lambda_0 - lambda_1 := sub_pos.mpr hlam1_lt
      have hsq_nonpos : ‖u_top‖ ^ 2 ≤ 0 := nonpos_of_mul_nonpos_right hnonpos hdiff_pos
      exact le_antisymm hsq_nonpos (sq_nonneg _)
    have hcoeff_zero : ∀ i : Fin N, lambda_1 < μ i → inner ℝ (b i) uE = 0 := by
      intro i hi
      have hsum_sq := b.sum_sq_inner_right u_top
      rw [hnorm_zero] at hsum_sq
      have hi_mem : i ∈ S_top := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
      have hsq0 : (inner ℝ (b i) u_top) ^ 2 = 0 := by
        have hle2 := Finset.single_le_sum (f := fun j => (inner ℝ (b j) u_top) ^ 2)
          (fun j _ => sq_nonneg _) (Finset.mem_univ i)
        linarith [sq_nonneg (inner ℝ (b i) u_top)]
      have h0 : inner ℝ (b i) u_top = 0 := sq_eq_zero_iff.mp hsq0
      simpa [hutop_coord i, hi_mem] using h0
    have hlhs : dotProduct u ((T ^ n).mulVec u) =
        ∑ i : Fin N, (μ i) ^ n * (inner ℝ (b i) uE) ^ 2 := by
      have h1 := inner_toLp_eq_dotProduct u ((T ^ n).mulVec u)
      rw [← toEuclideanLin_apply_toLp (T ^ n) u, toEuclideanLin_pow] at h1
      change dotProduct u ((T ^ n).mulVec u) = _
      rw [← h1, ← b.sum_inner_mul_inner uE ((A ^ n) uE)]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hdiag_pow n i uE, real_inner_comm uE (b i)]
      ring
    have hrhs : lambda_1 ^ n * dotProduct u u =
        ∑ i : Fin N, lambda_1 ^ n * (inner ℝ (b i) uE) ^ 2 := by
      have h1 := inner_toLp_eq_dotProduct u u
      change dotProduct u u = inner ℝ uE uE at h1
      rw [h1, real_inner_self_eq_norm_sq, ← b.sum_sq_inner_right uE, Finset.mul_sum]
    rw [hlhs, hrhs]
    refine Finset.sum_le_sum (fun i _ => ?_)
    by_cases hi : lambda_1 < μ i
    · have hc0 := hcoeff_zero i hi
      simp [hc0]
    · have hle : μ i ≤ lambda_1 := le_of_not_gt hi
      have hpow_le : (μ i) ^ n ≤ lambda_1 ^ n := pow_le_pow_left₀ (hμ_nn i) hle n
      exact mul_le_mul_of_nonneg_right hpow_le (sq_nonneg _)
  have hratio_exp : ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 → ∀ n : ℕ,
      0 ≤ dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ∧
      dotProduct u ((T ^ n).mulVec u) ≤ lambda_1 ^ n * dotProduct u u ∧
      dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
        Real.exp (-spectralRatioGap lambda_0 lambda_1 * (n : ℝ)) * dotProduct u u := by
    intro u hu n
    have hpsd_n := psd_pow_of_symm_psd T hSymm hPSD n u
    have hlam0_pow_pos : 0 < lambda_0 ^ n := pow_pos hlam0_pos n
    have hnn : 0 ≤ dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n :=
      div_nonneg hpsd_n (le_of_lt hlam0_pow_pos)
    have hle := hmain_pow u hu n
    have hdiv_le : dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
        (lambda_1 / lambda_0) ^ n * dotProduct u u := by
      have h1 := div_le_div_of_nonneg_right hle (le_of_lt hlam0_pow_pos)
      have h2 : (lambda_1 ^ n * dotProduct u u) / lambda_0 ^ n =
          (lambda_1 / lambda_0) ^ n * dotProduct u u := by
        rw [div_pow]; ring
      exact h1.trans_eq h2
    have hexp_ge : (lambda_1 / lambda_0) ^ n ≤
        Real.exp (-spectralRatioGap lambda_0 lambda_1 * (n : ℝ)) := by
      by_cases h1 : 0 < lambda_1
      · have hpos_ratio : 0 < lambda_1 / lambda_0 := div_pos h1 hlam0_pos
        have hgap_r : spectralRatioGap lambda_0 lambda_1 = Real.log (lambda_0 / lambda_1) := hgap_eq h1
        rw [hgap_r]
        have hneg_log : -Real.log (lambda_0 / lambda_1) = Real.log (lambda_1 / lambda_0) := by
          rw [← Real.log_inv (lambda_0 / lambda_1), inv_div]
        rw [hneg_log, mul_comm (Real.log (lambda_1 / lambda_0)) (n : ℝ),
          Real.exp_nat_mul, Real.exp_log hpos_ratio]
      · have hlam1_0 : lambda_1 = 0 := le_antisymm (le_of_not_gt h1) hlam1_nn
        rw [hlam1_0, zero_div]
        rcases n with _ | n
        · simp
        · rw [zero_pow (Nat.succ_ne_zero n)]
          exact le_of_lt (Real.exp_pos _)
    have huu_nn : 0 ≤ dotProduct u u := dotProduct_self_nonneg' u
    have hfin := le_trans hdiv_le (mul_le_mul_of_nonneg_right hexp_ge huu_nn)
    exact ⟨hnn, hle, hfin⟩
  have hpos_branch : 0 < lambda_1 → ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 → ∀ n : ℕ,
      dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
        Real.exp (-Real.log (lambda_0 / lambda_1) * (n : ℝ)) * dotProduct u u := by
    intro h1 u hu n
    have h3 := (hratio_exp u hu n).2.2
    rwa [hgap_eq h1] at h3
  have hzero_branch : lambda_1 = 0 → ∀ u : Fin N → ℝ, dotProduct v_0 u = 0 →
      (∀ n : ℕ, 1 ≤ n → dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n = 0) ∧
      (∀ m_any : ℝ, 0 < m_any → ∀ n : ℕ,
        dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤
          Real.exp (-m_any * (n : ℝ)) * dotProduct u u) := by
    intro h0 u hu
    refine ⟨?_, ?_⟩
    · intro n hn1
      have h := hratio_exp u hu n
      have hle0 : dotProduct u ((T ^ n).mulVec u) ≤ 0 := by
        have := h.2.1
        rw [h0, zero_pow (by omega), zero_mul] at this
        exact this
      have hdiv0 : dotProduct u ((T ^ n).mulVec u) / lambda_0 ^ n ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg hle0 (le_of_lt (pow_pos hlam0_pos n))
      exact le_antisymm hdiv0 h.1
    · intro m_any _ n
      rcases n with _ | n
      · have h := hratio_exp u hu 0
        have hle0 := h.2.1
        simp only [pow_zero, Matrix.one_mulVec, one_mul] at hle0
        simp
      · have h0val : dotProduct u ((T ^ (n + 1)).mulVec u) / lambda_0 ^ (n + 1) = 0 := by
          have h := hratio_exp u hu (n + 1)
          have hle0 : dotProduct u ((T ^ (n + 1)).mulVec u) ≤ 0 := by
            have := h.2.1
            rw [h0, zero_pow (Nat.succ_ne_zero n), zero_mul] at this
            exact this
          exact le_antisymm (div_nonpos_of_nonpos_of_nonneg hle0 (le_of_lt (pow_pos hlam0_pos _))) h.1
        rw [h0val]
        exact mul_nonneg (le_of_lt (Real.exp_pos _)) (dotProduct_self_nonneg' u)
  exact ⟨hgap_pos, hgap_eq, hratio_exp, hpos_branch, hzero_branch⟩

/-- Concrete non-vacuous witnesses for `transfer_matrix_spectral_ratio_clustering`
covering both `0 < λ₁ < λ₀` (`diag(2, 1)`, `m_gap = log 2`) and `λ₁ = 0` (`diag(2, 0)`). `[C/B/P]` -/
theorem transfer_matrix_spectral_ratio_concrete_witness :
    let T1 : Matrix (Fin 2) (Fin 2) ℝ := !![(2 : ℝ), 0; 0, (1 : ℝ)]
    let T0 : Matrix (Fin 2) (Fin 2) ℝ := !![(2 : ℝ), 0; 0, (0 : ℝ)]
    let v0 : Fin 2 → ℝ := ![1, 0]
    (∀ u : Fin 2 → ℝ, dotProduct v0 u = 0 → ∀ n : ℕ,
      dotProduct u ((T1 ^ n).mulVec u) / (2 : ℝ) ^ n ≤
        Real.exp (-Real.log 2 * (n : ℝ)) * dotProduct u u) ∧
    (∀ u : Fin 2 → ℝ, dotProduct v0 u = 0 → ∀ n : ℕ, 1 ≤ n →
      dotProduct u ((T0 ^ n).mulVec u) / (2 : ℝ) ^ n = 0) := by
  intro T1 T0 v0
  have hv0_norm : dotProduct v0 v0 = 1 := by
    simp [v0, dotProduct, Fin.sum_univ_two]
  have hT1_symm : T1ᵀ = T1 := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [T1]
  have hT1_psd : ∀ v : Fin 2 → ℝ, 0 ≤ dotProduct v (T1.mulVec v) := by
    intro v
    simp [T1, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
    nlinarith [mul_self_nonneg (v 0), mul_self_nonneg (v 1)]
  have hT1_eig : T1.mulVec v0 = (2 : ℝ) • v0 := by
    ext i; fin_cases i <;> simp [T1, v0, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  have hT1_gap : ∀ u : Fin 2 → ℝ, dotProduct v0 u = 0 →
      dotProduct u (T1.mulVec u) ≤ (1 : ℝ) * dotProduct u u := by
    intro u hu
    have hu0 : u 0 = 0 := by simpa [v0, dotProduct, Fin.sum_univ_two] using hu
    simp [T1, dotProduct, Matrix.mulVec, Fin.sum_univ_two, hu0]
  have h1 := (transfer_matrix_spectral_ratio_clustering T1 hT1_symm hT1_psd v0 hv0_norm
    (by norm_num) (by norm_num) (by norm_num) hT1_eig hT1_gap).2.2.2.1 (by norm_num)
  have h1' : ∀ u : Fin 2 → ℝ, dotProduct v0 u = 0 → ∀ n : ℕ,
      dotProduct u ((T1 ^ n).mulVec u) / (2 : ℝ) ^ n ≤
        Real.exp (-Real.log 2 * (n : ℝ)) * dotProduct u u := by
    intro u hu n
    have h := h1 u hu n
    simpa using h
  have hT0_symm : T0ᵀ = T0 := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [T0]
  have hT0_psd : ∀ v : Fin 2 → ℝ, 0 ≤ dotProduct v (T0.mulVec v) := by
    intro v
    simp [T0, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
    nlinarith [mul_self_nonneg (v 0)]
  have hT0_eig : T0.mulVec v0 = (2 : ℝ) • v0 := by
    ext i; fin_cases i <;> simp [T0, v0, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  have hT0_gap : ∀ u : Fin 2 → ℝ, dotProduct v0 u = 0 →
      dotProduct u (T0.mulVec u) ≤ (0 : ℝ) * dotProduct u u := by
    intro u hu
    have hu0 : u 0 = 0 := by simpa [v0, dotProduct, Fin.sum_univ_two] using hu
    simp [T0, dotProduct, Matrix.mulVec, Fin.sum_univ_two, hu0]
  have h0 := (transfer_matrix_spectral_ratio_clustering T0 hT0_symm hT0_psd v0 hv0_norm
    (by norm_num) (le_refl 0) (by norm_num) hT0_eig hT0_gap).2.2.2.2 rfl
  exact ⟨h1', fun u hu n hn1 => (h0 u hu).1 n hn1⟩

/-- **Physical-Scale RG Blocking, Hyperplane Reflection Positivity Transfer & Continuum OS Gap (`C/B/P/X`)**:
Formalizes the exact RG blocking scale choice `ell_phys = L_blk^K * a(β)` with `a(β) * Λ = exp(-c_AF * β)`:
- **Part (a) `[C/B]` (Hyperplane RP Transfer under Even-Block Spatial/Temporal Decimation)**:
  1. For any symmetric UV transfer matrix `T` (`Tᵀ = T`) and even temporal blocking `Even (L_blk ^ K)`
     (in particular `Even L_blk` with `1 ≤ K`), `T ^ (L_blk ^ K)` is automatically symmetric and PSD
     without even assuming single-step `T` PSD; under spatial hyperplane coarse-graining `P_sp`,
     `T_blk := P_spᵀ * T ^ (L_blk ^ K) * P_sp` is symmetric PSD and reflection-positive for all `m : ℕ`.
  2. For any Euclidean half-space functional reflection `(Theta_uv, pair_uv)` satisfying UV hyperplane
     reflection positivity `0 ≤ pair_uv (Theta_uv f) f`, any time-reflection-intertwining RG blocking map
     `ι_blk` (`Theta_uv (ι_blk F) = ι_blk (Theta_blk F)`) preserves `0 ≤ pair_blk (Theta_blk F) F`.
- **Part (b) `[C/B/X]` (Physical-Scale Mass-Gap Transfer to `conditional_continuum_os_mass_gap_persistence`)**:
  1. Constructs the explicit asymptotic-freedom RG trajectory `β_seq K = log (L_blk^K / (ell_phys * Λ)) / c_AF`
     satisfying `L_blk^K * a(β_seq K) = ell_phys` for all `K` and `β_seq K → +∞`.
  2. For any sequence `(β_m, K_m)` with `ell_phys = L_blk^(K_m) * a(β_m)` and `[X]` uniform blocked
     gap `m_blk m ≥ m_0 * ell_phys > 0`, proves `m_lat m = m_blk m / L_blk^(K_m) ≥ m_0 * a(β_m) > 0`
     (with exact knife-edge scaling `m_lat m = m_0 * a(β_m)` at saturation, avoiding `DEAD-20261124-11`)
     and `m_phys m = m_lat m / a(β_m) ≥ m_0 > 0`.
  3. Feeds the resulting uniform physical-time bound `|S_m m ψ t| ≤ C_ψ exp(-m_0 t)` directly into
     `conditional_continuum_os_mass_gap_persistence` (given the `[X]` continuum limit & GNS semigroup
     hypotheses), discharging continuum OS RP, unique `QuotientDescent` GNS norm, uniform semigroup
     decay `⟨u, U(t) u⟩ ≤ ⟨u, u⟩ exp(-m_0 t)`, and continuum Hamiltonian gap `m_0 ⟨u, u⟩ ≤ ⟨u, H_op u⟩`. -/
theorem physical_scale_rg_blocking_os_gap_transfer
    {N_uv N_blk : ℕ} {V_uv V_blk V_test H_perp : Type*}
    [AddCommGroup H_perp] [Module ℝ H_perp]
    -- [P/B] RG lattice & asymptotic-freedom parameters
    {Lambda c_AF ell_phys m_0 : ℝ} {L_blk : ℕ}
    (hLam : 0 < Lambda) (hcAF : 0 < c_AF) (hell : 0 < ell_phys) (hm0 : 0 < m_0)
    (hLblk : 2 ≤ L_blk)
    (a_lat : ℝ → ℝ) (ha_def : ∀ β : ℝ, a_lat β * Lambda = Real.exp (-c_AF * β))
    -- [C/B] Part (a1): Symmetric UV transfer matrix + spatial hyperplane coarse-graining
    (T : Matrix (Fin N_uv) (Fin N_uv) ℝ) (hT_symm : Tᵀ = T)
    (P_sp : Matrix (Fin N_uv) (Fin N_blk) ℝ)
    -- [C/B] Part (a2): Euclidean half-space reflection-positivity intertwining
    (Theta_uv : V_uv → V_uv) (pair_uv : V_uv → V_uv → ℝ)
    (hUV_RP : ∀ f : V_uv, 0 ≤ pair_uv (Theta_uv f) f)
    (Theta_blk : V_blk → V_blk) (pair_blk : V_blk → V_blk → ℝ)
    (ι_blk : V_blk → V_uv)
    (hTheta_intertwine : ∀ F : V_blk, Theta_uv (ι_blk F) = ι_blk (Theta_blk F))
    (hPair_pullback : ∀ F G : V_blk, pair_blk F G = pair_uv (ι_blk F) (ι_blk G))
    -- [X] Part (b): RG sequence, uniform blocked physical-scale gap & continuum OS/GNS limit inputs
    (β_seq : ℕ → ℝ) (K_seq : ℕ → ℕ)
    (hScale_seq : ∀ m : ℕ, ell_phys = (L_blk : ℝ) ^ (K_seq m) * a_lat (β_seq m))
    (m_blk : ℕ → ℝ) (hm_blk_lb : ∀ m : ℕ, m_0 * ell_phys ≤ m_blk m)
    (q_GNS : V_test → H_perp) (hq : Surjective q_GNS)
    (inner_perp : H_perp → H_perp → ℝ)
    (hSymm_in : ∀ u v : H_perp, inner_perp u v = inner_perp v u)
    (hAdd_in : ∀ u v w : H_perp, inner_perp u (v + w) = inner_perp u v + inner_perp u w)
    (hSmul_in : ∀ (a : ℝ) (u v : H_perp), inner_perp u (a • v) = a * inner_perp u v)
    (hInner_nn : ∀ u : H_perp, 0 ≤ inner_perp u u)
    (S_m : ℕ → V_test → ℝ → ℝ) (S_inf : V_test → ℝ → ℝ)
    (hTightWeak : ∀ (ψ : V_test) (t : ℝ), 0 ≤ t →
      Filter.Tendsto (fun m : ℕ => S_m m ψ t) Filter.atTop (nhds (S_inf ψ t)))
    (hOS_RP_m : ∀ (m : ℕ) (ψ : V_test), 0 ≤ S_m m ψ 0)
    (U : ℝ → H_perp → H_perp)
    (hGNS_id : ∀ (ψ : V_test) (t : ℝ), 0 ≤ t →
      S_inf ψ t = inner_perp (q_GNS ψ) (U t (q_GNS ψ)))
    (hU_zero : ∀ u : H_perp, U 0 u = u)
    (hU_add : ∀ s t : ℝ, 0 ≤ s → 0 ≤ t → ∀ u : H_perp, U (s + t) u = U s (U t u))
    (hU_symm : ∀ t : ℝ, 0 ≤ t → ∀ u v : H_perp,
      inner_perp u (U t v) = inner_perp (U t u) v)
    (hBlkCluster : ∀ ψ : V_test, ∃ C_ψ : ℝ, 0 ≤ C_ψ ∧
      ∀ (m : ℕ) (t : ℝ), 0 ≤ t →
        |S_m m ψ t| ≤ C_ψ * Real.exp (-(m_blk m / (L_blk : ℝ) ^ (K_seq m)) * (t / a_lat (β_seq m))))
    (H_op : H_perp → H_perp)
    (hGen : ∀ u : H_perp,
      Filter.Tendsto (fun t : ℝ => (inner_perp u u - inner_perp u (U t u)) / t)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (inner_perp u (H_op u)))) :
    -- (a1) Even-block transfer matrix RP preservation
    (∀ K : ℕ, Even (L_blk ^ K) →
      let T_blk : Matrix (Fin N_blk) (Fin N_blk) ℝ := P_spᵀ * T ^ (L_blk ^ K) * P_sp
      T_blkᵀ = T_blk ∧
      (∀ w : Fin N_blk → ℝ, 0 ≤ dotProduct w (T_blk.mulVec w)) ∧
      (∀ m : ℕ, ∀ w : Fin N_blk → ℝ, 0 ≤ dotProduct w ((T_blk ^ m).mulVec w))) ∧
    -- (a2) Euclidean hyperplane RP preservation
    (∀ F : V_blk, 0 ≤ pair_blk (Theta_blk F) F) ∧
    -- (b1) Explicit asymptotic-freedom RG trajectory β_of_K → +∞
    (let β_of_K : ℕ → ℝ := fun K => Real.log ((L_blk : ℝ) ^ K / (ell_phys * Lambda)) / c_AF;
      (∀ K : ℕ, (L_blk : ℝ) ^ K * a_lat (β_of_K K) = ell_phys) ∧
      Filter.Tendsto β_of_K Filter.atTop Filter.atTop) ∧
    -- (b2) Exact RG scale transfer: m_lat ≥ m_0 * a(β) and m_phys = m_lat / a(β) ≥ m_0 > 0
    (∀ m : ℕ,
      let m_lat := m_blk m / (L_blk : ℝ) ^ (K_seq m)
      let m_phys := m_lat / a_lat (β_seq m)
      0 < a_lat (β_seq m) ∧
      m_0 * a_lat (β_seq m) ≤ m_lat ∧
      m_0 ≤ m_phys ∧
      (m_blk m = m_0 * ell_phys → m_lat = m_0 * a_lat (β_seq m) ∧ m_phys = m_0)) ∧
    -- (b3) Downstream Continuum OS Mass-Gap Persistence at m_phys = m_0 > 0
    ((∀ ψ : V_test, 0 ≤ S_inf ψ 0) ∧
      (∃! norm_cont : H_perp → ℝ, norm_cont ∘ q_GNS = fun ψ => S_inf ψ 0) ∧
      (∀ (u : H_perp) (t : ℝ), 0 ≤ t →
        inner_perp u (U t u) ≤ inner_perp u u * Real.exp (-m_0 * t)) ∧
      (∀ u : H_perp, m_0 * inner_perp u u ≤ inner_perp u (H_op u))) := by
  have ha_pos : ∀ β : ℝ, 0 < a_lat β := by
    intro β
