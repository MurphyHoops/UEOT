/-! ## 1. Scale-Decaying Mori–Zwanzig Contraction (`O-OPEN-09` vs `DEAD-20261124-09`) -/

private lemma geom_sum_rev_le {kappa : ℝ} (hkap_nn : 0 ≤ kappa) (hkap_lt : kappa < 1)
    (t : ℕ) :
    ∑ j ∈ Finset.range t, kappa ^ (t - 1 - j) ≤ (1 - kappa ^ t) / (1 - kappa) := by
  induction t with
  | zero => simp
  | succ t ih =>
    rw [Finset.sum_range_succ]
    have hsplit :
        ∑ j ∈ Finset.range t, kappa ^ (t + 1 - 1 - j) =
          kappa * ∑ j ∈ Finset.range t, kappa ^ (t - 1 - j) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl ?_
      intro j hj
      have hj_lt : j < t := Finset.mem_range.mp hj
      have hexp : t + 1 - 1 - j = (t - 1 - j) + 1 := by omega
      rw [hexp, pow_succ']
    have hlast : kappa ^ (t + 1 - 1 - t) = 1 := by simp
    rw [hsplit, hlast]
    have h1mk : 0 < 1 - kappa := sub_pos.mpr hkap_lt
    have hmul : kappa * ∑ j ∈ Finset.range t, kappa ^ (t - 1 - j) ≤
        kappa * ((1 - kappa ^ t) / (1 - kappa)) :=
      mul_le_mul_of_nonneg_left ih hkap_nn
    have hid : kappa * ((1 - kappa ^ t) / (1 - kappa)) + 1 =
        (1 - kappa ^ (t + 1)) / (1 - kappa) := by
      rw [pow_succ']
      field_simp [ne_of_gt h1mk]
      ring
    linarith

private lemma mz_unrolled_bound {kappa : ℝ} (hkap_nn : 0 ≤ kappa)
    (r eps : ℕ → ℝ) (hrec : ∀ k : ℕ, r (k + 1) ≤ kappa * r k + eps k) :
    ∀ n : ℕ, r n ≤ kappa ^ n * r 0 + ∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    have h1 : r (n + 1) ≤ kappa * (kappa ^ n * r 0 +
        ∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j) + eps n :=
      (hrec n).trans (add_le_add (mul_le_mul_of_nonneg_left ih hkap_nn) le_rfl)
    have hsum :
        ∑ j ∈ Finset.range (n + 1), kappa ^ (n + 1 - 1 - j) * eps j =
          kappa * (∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j) + eps n := by
      rw [Finset.sum_range_succ, Finset.mul_sum]
      have hleft :
          ∑ j ∈ Finset.range n, kappa ^ (n + 1 - 1 - j) * eps j =
            ∑ j ∈ Finset.range n, kappa * (kappa ^ (n - 1 - j) * eps j) := by
        refine Finset.sum_congr rfl ?_
        intro j hj
        have hj_lt : j < n := Finset.mem_range.mp hj
        have hexp : n + 1 - 1 - j = (n - 1 - j) + 1 := by omega
        rw [hexp, pow_succ']
        ring
      rw [hleft]
      simp
    rw [hsum, pow_succ']
    linarith

private lemma mz_tail_bound {kappa : ℝ} (hkap_nn : 0 ≤ kappa) (hkap_lt : kappa < 1)
    (r eps : ℕ → ℝ) (hrec : ∀ k : ℕ, r (k + 1) ≤ kappa * r k + eps k)
    (m : ℕ) (delta : ℝ) (hdelta_nn : 0 ≤ delta) (hbound : ∀ j : ℕ, m ≤ j → eps j ≤ delta) :
    ∀ t : ℕ, r (m + t) ≤ kappa ^ t * r m + delta * (1 - kappa ^ t) / (1 - kappa) := by
  intro t
  have hshift := mz_unrolled_bound hkap_nn (fun k => r (m + k)) (fun k => eps (m + k))
    (fun k => by simpa [Nat.add_assoc] using hrec (m + k)) t
  simp only [add_zero] at hshift
  have hsum_le : ∑ j ∈ Finset.range t, kappa ^ (t - 1 - j) * eps (m + j) ≤
      delta * ∑ j ∈ Finset.range t, kappa ^ (t - 1 - j) := by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum ?_
    intro j _
    have hpow_nn : 0 ≤ kappa ^ (t - 1 - j) := pow_nonneg hkap_nn _
    have heps_le : eps (m + j) ≤ delta := hbound (m + j) (Nat.le_add_right m j)
    calc kappa ^ (t - 1 - j) * eps (m + j)
        ≤ kappa ^ (t - 1 - j) * delta := mul_le_mul_of_nonneg_left heps_le hpow_nn
      _ = delta * kappa ^ (t - 1 - j) := mul_comm _ _
  have hgeom := mul_le_mul_of_nonneg_left (geom_sum_rev_le hkap_nn hkap_lt t) hdelta_nn
  have hdiv : delta * ((1 - kappa ^ t) / (1 - kappa)) = delta * (1 - kappa ^ t) / (1 - kappa) := by
    ring
  linarith [hshift, hsum_le, hgeom, hdiv]

private lemma mz_partial_sum_bound {kappa : ℝ} (hkap_lt : kappa < 1)
    (r eps : ℕ → ℝ) (hr_nn : ∀ k : ℕ, 0 ≤ r k)
    (hrec : ∀ k : ℕ, r (k + 1) ≤ kappa * r k + eps k) :
    ∀ N : ℕ, ∑ k ∈ Finset.range N, r k ≤
      (r 0 + ∑ k ∈ Finset.range N, eps k) / (1 - kappa) := by
  intro N
  have h1mk : 0 < 1 - kappa := sub_pos.mpr hkap_lt
  have hshift_eq : ∑ k ∈ Finset.range N, r (k + 1) + r 0 =
      ∑ k ∈ Finset.range N, r k + r N := by
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Finset.sum_range_succ, Finset.sum_range_succ]
      linarith [ih]
  have hsum_rec : ∑ k ∈ Finset.range N, r (k + 1) ≤
      kappa * ∑ k ∈ Finset.range N, r k + ∑ k ∈ Finset.range N, eps k := by
    calc ∑ k ∈ Finset.range N, r (k + 1)
        ≤ ∑ k ∈ Finset.range N, (kappa * r k + eps k) :=
          Finset.sum_le_sum (fun k _ => hrec k)
      _ = kappa * ∑ k ∈ Finset.range N, r k + ∑ k ∈ Finset.range N, eps k := by
          rw [Finset.sum_add_distrib, ← Finset.mul_sum]
  have hrN_nn : 0 ≤ r N := hr_nn N
  have hlin : (1 - kappa) * ∑ k ∈ Finset.range N, r k ≤ r 0 + ∑ k ∈ Finset.range N, eps k := by
    linarith [hsum_rec, hshift_eq, hrN_nn]
  exact (le_div_iff₀ h1mk).mpr (by linarith)

private lemma sum_inv_sq_succ_le_local (K : ℕ) :
    ∑ j : Fin K, ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2) ≤ 2 := by
  cases K with
  | zero => simp
  | succ n =>
    have hrec : ∀ m : ℕ,
        (∑ j : Fin (m + 1), ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2)) ≤ 2 - 1 / ((m : ℝ) + 1) := by
      intro m
      induction m with
      | zero => simp; norm_num
      | succ m ih =>
        rw [Fin.sum_univ_castSucc]
        have hm_pos : (0 : ℝ) < (m : ℝ) + 1 := by positivity
        have hm1_pos : (0 : ℝ) < (m : ℝ) + 2 := by positivity
        have hcongr :
            (∑ i : Fin (m + 1), (1 : ℝ) / (((i.castSucc : Fin (m + 2)).1 : ℝ) + 1) ^ 2) =
              ∑ i : Fin (m + 1), (1 : ℝ) / ((i.1 : ℝ) + 1) ^ 2 := rfl
        have hlast : (1 : ℝ) / (((Fin.last (m + 1) : Fin (m + 2)).1 : ℝ) + 1) ^ 2 =
            1 / ((m : ℝ) + 2) ^ 2 := by
          simp; ring
        rw [hcongr, hlast]
        have hdiff : 1 / ((m : ℝ) + 2) ^ 2 ≤ 1 / ((m : ℝ) + 1) - 1 / ((m : ℝ) + 2) := by
          have hid : 1 / ((m : ℝ) + 1) - 1 / ((m : ℝ) + 2) =
              1 / (((m : ℝ) + 1) * ((m : ℝ) + 2)) := by
            field_simp [ne_of_gt hm_pos, ne_of_gt hm1_pos]; ring
          rw [hid]
          refine one_div_le_one_div_of_le (by positivity) ?_
          nlinarith
        have hcast : ((m + 1 : ℕ) : ℝ) + 1 = (m : ℝ) + 2 := by push_cast; ring
        rw [hcast]
        linarith
    have h0 : 0 ≤ (1 : ℝ) / ((n : ℝ) + 1) := by positivity
    linarith [hrec n]

/-- **Scale-Decaying Mori–Zwanzig Contraction to Zero (`C/B/P`, resolves `O-OPEN-09` for
vanishing non-Markovian defect without contradicting `DEAD-20261124-09`)**:
For `0 ≤ kappa < 1`, nonnegative `r`, and nonnegative defect `eps` obeying `r (k + 1) ≤ kappa * r k + eps k`:
1. Finite-step unrolling bound holds for every `n : ℕ`;
2. Tail bound holds for any `m, t : ℕ` whenever `eps j ≤ delta` for `j ≥ m`;
3. Whenever `eps k → 0`, `r k → 0`;
4. Geometric decay `eps k ≤ C * q ^ k` (`0 ≤ q < 1`) gives explicit rate
   `r n ≤ kappa ^ n * r 0 + C * n * (max kappa q) ^ (n - 1)` (`n ≥ 1`) and `r k → 0`;
5. Inverse-power decay `eps k ≤ C / (k + k0)^p` (`0 < k0`, `2 ≤ p`) gives explicit midpoint rate,
   uniform summability `∑_{k < N} r k ≤ (r 0 + C * (1 / k0 ^ p + 2)) / (1 - kappa)`, and `r k → 0`. -/
theorem scale_decaying_mz_contraction_to_zero
    {kappa : ℝ} (hkap_nn : 0 ≤ kappa) (hkap_lt : kappa < 1)
    (r eps : ℕ → ℝ) (hr_nn : ∀ k : ℕ, 0 ≤ r k) (heps_nn : ∀ k : ℕ, 0 ≤ eps k)
    (hrec : ∀ k : ℕ, r (k + 1) ≤ kappa * r k + eps k) :
    (∀ n : ℕ, r n ≤ kappa ^ n * r 0 + ∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j) ∧
    (∀ (m : ℕ) (delta : ℝ), 0 ≤ delta → (∀ j : ℕ, m ≤ j → eps j ≤ delta) →
      ∀ t : ℕ, r (m + t) ≤ kappa ^ t * r m + delta / (1 - kappa)) ∧
    (Filter.Tendsto eps Filter.atTop (nhds 0) →
      Filter.Tendsto r Filter.atTop (nhds 0)) ∧
    (∀ (C q : ℝ), 0 ≤ C → 0 ≤ q → q < 1 → (∀ k : ℕ, eps k ≤ C * q ^ k) →
      (∀ n : ℕ, 1 ≤ n → r n ≤ kappa ^ n * r 0 + C * (n : ℝ) * (max kappa q) ^ (n - 1)) ∧
      Filter.Tendsto r Filter.atTop (nhds 0)) ∧
    (∀ (C k0 p : ℝ), 0 ≤ C → 0 < k0 → 2 ≤ p →
      (∀ k : ℕ, eps k ≤ C / ((k : ℝ) + k0) ^ p) →
      (∀ n : ℕ, r n ≤ kappa ^ n * r 0 +
        (C / (1 - kappa)) * (kappa ^ (n - n / 2) / k0 ^ p +
          1 / (((n / 2 : ℕ) : ℝ) + k0) ^ p)) ∧
      (∀ N : ℕ, ∑ k ∈ Finset.range N, r k ≤
        (r 0 + C * (1 / k0 ^ p + 2)) / (1 - kappa)) ∧
      Filter.Tendsto r Filter.atTop (nhds 0)) := by
  have h1mk : 0 < 1 - kappa := sub_pos.mpr hkap_lt
  have hunroll : ∀ n : ℕ,
      r n ≤ kappa ^ n * r 0 + ∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j :=
    mz_unrolled_bound hkap_nn r eps hrec
  have htail : ∀ (m : ℕ) (delta : ℝ), 0 ≤ delta → (∀ j : ℕ, m ≤ j → eps j ≤ delta) →
      ∀ t : ℕ, r (m + t) ≤ kappa ^ t * r m + delta / (1 - kappa) := by
    intro m delta hdelta_nn hbound t
    have hraw := mz_tail_bound hkap_nn hkap_lt r eps hrec m delta hdelta_nn hbound t
    have hpow_nn : 0 ≤ kappa ^ t := pow_nonneg hkap_nn t
    have hnum_le : delta * (1 - kappa ^ t) ≤ delta := by
      nlinarith
    have hdiv_le : delta * (1 - kappa ^ t) / (1 - kappa) ≤ delta / (1 - kappa) :=
      div_le_div_of_nonneg_right hnum_le (le_of_lt h1mk)
    linarith
  have htend_gen : Filter.Tendsto eps Filter.atTop (nhds 0) →
      Filter.Tendsto r Filter.atTop (nhds 0) := by
    intro heps_tend
    rw [Metric.tendsto_atTop] at heps_tend ⊢
    intro η hη
    set delta : ℝ := η * (1 - kappa) / 3
    have hdelta_pos : 0 < delta := by positivity
    rcases heps_tend delta hdelta_pos with ⟨N0, hN0⟩
    have hbound : ∀ j : ℕ, N0 ≤ j → eps j ≤ delta := by
      intro j hj
      have hdist := hN0 j hj
      rw [Real.dist_eq, sub_zero, abs_of_nonneg (heps_nn j)] at hdist
      exact le_of_lt hdist
    have hpow_tend : Filter.Tendsto (fun t : ℕ => kappa ^ t * r N0) Filter.atTop (nhds 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hkap_nn hkap_lt).mul_const (r N0)
    rw [Metric.tendsto_atTop] at hpow_tend
    rcases hpow_tend (η / 3) (by positivity) with ⟨T0, hT0⟩
    refine ⟨N0 + T0, ?_⟩
    intro k hk
    have hk_ge : N0 ≤ k := le_trans (Nat.le_add_right N0 T0) hk
    set t : ℕ := k - N0
    have hk_eq : N0 + t = k := Nat.add_sub_of_le hk_ge
    have ht_ge : T0 ≤ t := by omega
    have htail_k := htail N0 delta (le_of_lt hdelta_pos) hbound t
    rw [hk_eq] at htail_k
    have hpow_bound := hT0 t ht_ge
    have hpow_nn : 0 ≤ kappa ^ t * r N0 := mul_nonneg (pow_nonneg hkap_nn t) (hr_nn N0)
    rw [Real.dist_eq, sub_zero, abs_of_nonneg hpow_nn] at hpow_bound
    have hdelta_div : delta / (1 - kappa) = η / 3 := by
      dsimp [delta]
      field_simp [ne_of_gt h1mk]
    have hrk_lt : r k < η := by
      linarith
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (hr_nn k)]
    exact hrk_lt
  have hgeom_case : ∀ (C q : ℝ), 0 ≤ C → 0 ≤ q → q < 1 → (∀ k : ℕ, eps k ≤ C * q ^ k) →
      (∀ n : ℕ, 1 ≤ n → r n ≤ kappa ^ n * r 0 + C * (n : ℝ) * (max kappa q) ^ (n - 1)) ∧
      Filter.Tendsto r Filter.atTop (nhds 0) := by
    intro C q hC_nn hq_nn hq_lt hbound
    constructor
    · intro n hn
      have h1 := hunroll n
      set rho : ℝ := max kappa q
      have hkap_le_rho : kappa ≤ rho := le_max_left kappa q
      have hq_le_rho : q ≤ rho := le_max_right kappa q
      have hsum_le : ∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j ≤
          C * (n : ℝ) * rho ^ (n - 1) := by
        have hterm : ∀ j ∈ Finset.range n,
            kappa ^ (n - 1 - j) * eps j ≤ C * rho ^ (n - 1) := by
          intro j hj
          have hj_lt : j < n := Finset.mem_range.mp hj
          have hpow1 : kappa ^ (n - 1 - j) ≤ rho ^ (n - 1 - j) :=
            pow_le_pow_left₀ hkap_nn hkap_le_rho _
          have hpow2 : q ^ j ≤ rho ^ j :=
            pow_le_pow_left₀ hq_nn hq_le_rho _
          have hmul_pow : kappa ^ (n - 1 - j) * q ^ j ≤ rho ^ (n - 1 - j) * rho ^ j :=
            mul_le_mul hpow1 hpow2 (pow_nonneg hq_nn j) (pow_nonneg (le_trans hkap_nn hkap_le_rho) _)
          have hexp_add : (n - 1 - j) + j = n - 1 := by omega
          have hrho_eq : rho ^ (n - 1 - j) * rho ^ j = rho ^ (n - 1) := by
            rw [← pow_add, hexp_add]
          have hstep1 : kappa ^ (n - 1 - j) * eps j ≤ kappa ^ (n - 1 - j) * (C * q ^ j) :=
            mul_le_mul_of_nonneg_left (hbound j) (pow_nonneg hkap_nn _)
          calc kappa ^ (n - 1 - j) * eps j
              ≤ C * (kappa ^ (n - 1 - j) * q ^ j) := by linarith
            _ ≤ C * rho ^ (n - 1) := mul_le_mul_of_nonneg_left (hmul_pow.trans_eq hrho_eq) hC_nn
        calc ∑ j ∈ Finset.range n, kappa ^ (n - 1 - j) * eps j
            ≤ ∑ _j ∈ Finset.range n, C * rho ^ (n - 1) := Finset.sum_le_sum hterm
          _ = (n : ℝ) * (C * rho ^ (n - 1)) := by simp
          _ = C * (n : ℝ) * rho ^ (n - 1) := by ring
      linarith
    · have hq_tend : Filter.Tendsto (fun k : ℕ => C * q ^ k) Filter.atTop (nhds 0) := by
        simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hq_nn hq_lt).const_mul C
      exact htend_gen (squeeze_zero heps_nn hbound hq_tend)
  have hinv_case : ∀ (C k0 p : ℝ), 0 ≤ C → 0 < k0 → 2 ≤ p →
      (∀ k : ℕ, eps k ≤ C / ((k : ℝ) + k0) ^ p) →
      (∀ n : ℕ, r n ≤ kappa ^ n * r 0 +
        (C / (1 - kappa)) * (kappa ^ (n - n / 2) / k0 ^ p +
          1 / (((n / 2 : ℕ) : ℝ) + k0) ^ p)) ∧
      (∀ N : ℕ, ∑ k ∈ Finset.range N, r k ≤
        (r 0 + C * (1 / k0 ^ p + 2)) / (1 - kappa)) ∧
      Filter.Tendsto r Filter.atTop (nhds 0) := by
    intro C k0 p hC_nn hk0_pos hp_ge hbound
    have hp_pos : 0 < p := by linarith
    have hphi_anti : ∀ {a b : ℕ}, a ≤ b →
        C / ((b : ℝ) + k0) ^ p ≤ C / ((a : ℝ) + k0) ^ p := by
      intro a b hab
      have ha_pos : 0 < (a : ℝ) + k0 := by positivity
      have hab_le : (a : ℝ) + k0 ≤ (b : ℝ) + k0 := by
        have : (a : ℝ) ≤ (b : ℝ) := Nat.cast_le.mpr hab
        linarith
      have hrpow_le : ((a : ℝ) + k0) ^ p ≤ ((b : ℝ) + k0) ^ p :=
        Real.rpow_le_rpow (le_of_lt ha_pos) hab_le (le_of_lt hp_pos)
      exact div_le_div_of_nonneg_left hC_nn (Real.rpow_pos_of_pos ha_pos p) hrpow_le
    have hmid : ∀ n : ℕ, r n ≤ kappa ^ n * r 0 +
        (C / (1 - kappa)) * (kappa ^ (n - n / 2) / k0 ^ p +
          1 / (((n / 2 : ℕ) : ℝ) + k0) ^ p) := by
      intro n
      set m : ℕ := n / 2
      set t : ℕ := n - m
      have hm_le : m ≤ n := Nat.div_le_self n 2
      have hmt_eq : m + t = n := Nat.add_sub_of_le hm_le
      have hrm : r m ≤ kappa ^ m * r 0 + (C / k0 ^ p) / (1 - kappa) := by
        have h0 := htail 0 (C / k0 ^ p) (div_nonneg hC_nn (le_of_lt (Real.rpow_pos_of_pos hk0_pos p)))
          (fun j _ => by
            have hstep := hbound j
            have hdec := hphi_anti (Nat.zero_le j)
            simp only [Nat.cast_zero, zero_add] at hdec
            exact le_trans hstep hdec) m
        simpa using h0
      have hrt : r (m + t) ≤ kappa ^ t * r m + (C / ((m : ℝ) + k0) ^ p) / (1 - kappa) :=
        htail m (C / ((m : ℝ) + k0) ^ p)
          (div_nonneg hC_nn (le_of_lt (Real.rpow_pos_of_pos (by positivity) p)))
          (fun j hj => le_trans (hbound j) (hphi_anti hj)) t
      rw [hmt_eq] at hrt
      have hpow_t_nn : 0 ≤ kappa ^ t := pow_nonneg hkap_nn t
      have hcomb : r n ≤ kappa ^ t * (kappa ^ m * r 0 + (C / k0 ^ p) / (1 - kappa)) +
          (C / ((m : ℝ) + k0) ^ p) / (1 - kappa) :=
        le_trans hrt (add_le_add (mul_le_mul_of_nonneg_left hrm hpow_t_nn) le_rfl)
      have hpow_tm : kappa ^ t * (kappa ^ m * r 0) = kappa ^ n * r 0 := by
        rw [← mul_assoc, ← pow_add, add_comm t m, hmt_eq]
      have hrew : kappa ^ t * ((C / k0 ^ p) / (1 - kappa)) +
          (C / ((m : ℝ) + k0) ^ p) / (1 - kappa) =
          (C / (1 - kappa)) * (kappa ^ (n - n / 2) / k0 ^ p +
            1 / (((n / 2 : ℕ) : ℝ) + k0) ^ p) := by
        dsimp [m, t]
        ring
      linarith [hcomb, hpow_tm, hrew]
    have hsum : ∀ N : ℕ, ∑ k ∈ Finset.range N, r k ≤
        (r 0 + C * (1 / k0 ^ p + 2)) / (1 - kappa) := by
      intro N
      have hps := mz_partial_sum_bound hkap_lt r eps hr_nn hrec N
      have heps_sum : ∑ k ∈ Finset.range N, eps k ≤ C * (1 / k0 ^ p + 2) := by
        cases N with
        | zero =>
          simp
          positivity
        | succ M =>
          have hsplit : ∑ k ∈ Finset.range (M + 1), eps k =
              eps 0 + ∑ j ∈ Finset.range M, eps (j + 1) := by
            rw [Finset.sum_range_succ']
            ring
          have h0 : eps 0 ≤ C * (1 / k0 ^ p) := by
            have hb := hbound 0
            simp only [Nat.cast_zero, zero_add] at hb
            linarith [show C / k0 ^ p = C * (1 / k0 ^ p) by ring]
          have htail_sum : ∑ j ∈ Finset.range M, eps (j + 1) ≤ C * 2 := by
            have hpt : ∀ j : Fin M, eps (j.1 + 1) ≤ C * ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2) := by
              intro j
              have hbase : (1 : ℝ) ≤ (j.1 : ℝ) + 1 := by
                have : (0 : ℝ) ≤ (j.1 : ℝ) := Nat.cast_nonneg j.1
                linarith
              have hge1 : (j.1 : ℝ) + 1 ≤ ((j.1 + 1 : ℕ) : ℝ) + k0 := by
                push_cast
                linarith
              have hrpow2 : ((j.1 : ℝ) + 1) ^ (2 : ℝ) ≤ (((j.1 + 1 : ℕ) : ℝ) + k0) ^ p := by
                have h1 : ((j.1 : ℝ) + 1) ^ (2 : ℝ) ≤ (((j.1 + 1 : ℕ) : ℝ) + k0) ^ (2 : ℝ) :=
                  Real.rpow_le_rpow (by linarith) hge1 (by norm_num)
                have h2 : (((j.1 + 1 : ℕ) : ℝ) + k0) ^ (2 : ℝ) ≤
                    (((j.1 + 1 : ℕ) : ℝ) + k0) ^ p :=
                  Real.rpow_le_rpow_of_exponent_le (by linarith) hp_ge
                exact le_trans h1 h2
              have hsq_eq : ((j.1 : ℝ) + 1) ^ (2 : ℝ) = ((j.1 : ℝ) + 1) ^ (2 : ℕ) := by
                norm_cast
              rw [hsq_eq] at hrpow2
              have hdiv : C / (((j.1 + 1 : ℕ) : ℝ) + k0) ^ p ≤
                  C / ((j.1 : ℝ) + 1) ^ 2 :=
                div_le_div_of_nonneg_left hC_nn (by positivity) hrpow2
              have hb := hbound (j.1 + 1)
              linarith [show C / ((j.1 : ℝ) + 1) ^ 2 = C * ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2) by ring]
            calc ∑ j ∈ Finset.range M, eps (j + 1)
                = ∑ j : Fin M, eps (j.1 + 1) := (Fin.sum_univ_eq_sum_range (fun j => eps (j + 1)) M).symm
              _ ≤ ∑ j : Fin M, C * ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2) :=
                  Finset.sum_le_sum (fun j _ => hpt j)
              _ = C * ∑ j : Fin M, ((1 : ℝ) / ((j.1 : ℝ) + 1) ^ 2) := by rw [← Finset.mul_sum]
              _ ≤ C * 2 := mul_le_mul_of_nonneg_left (sum_inv_sq_succ_le_local M) hC_nn
          linarith
      exact le_trans hps (div_le_div_of_nonneg_right (add_le_add le_rfl heps_sum) (le_of_lt h1mk))
    have htend_inv : Filter.Tendsto r Filter.atTop (nhds 0) := by
      have hshift : Filter.Tendsto (fun k : ℕ => (k : ℝ) + k0) Filter.atTop Filter.atTop :=
        tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds
      have hrpow_top : Filter.Tendsto (fun k : ℕ => ((k : ℝ) + k0) ^ p) Filter.atTop Filter.atTop :=
        (tendsto_rpow_atTop hp_pos).comp hshift
      have hdiv_zero : Filter.Tendsto (fun k : ℕ => C / ((k : ℝ) + k0) ^ p) Filter.atTop (nhds 0) := by
        simpa [div_eq_mul_inv] using (tendsto_inv_atTop_zero.comp hrpow_top).const_mul C
      exact htend_gen (squeeze_zero heps_nn hbound hdiv_zero)
    exact ⟨hmid, hsum, htend_inv⟩
  exact ⟨hunroll, htail, htend_gen, hgeom_case, hinv_case⟩

/-- **Asymptotic-Freedom `g_k^4` Mori–Zwanzig Contraction (`C/B/P`, `O-OPEN-09`)**:
Specializes `scale_decaying_mz_contraction_to_zero` to a non-Markovian RG memory defect
dominated by `C_g * (runningG2 gK2 b0 L_blk k)^2` (`O(g_k^4)`), yielding uniform summability
of `r k` and `r k → 0`. -/
theorem scale_decaying_mz_af_quartic_contraction
    {kappa b0 L_blk gK2 C_g : ℝ}
    (hkap_nn : 0 ≤ kappa) (hkap_lt : kappa < 1)
    (hb0 : 0 < b0) (hL : 1 < L_blk) (hgK : 0 < gK2) (hCg : 0 ≤ C_g)
    (r eps : ℕ → ℝ) (hr_nn : ∀ k : ℕ, 0 ≤ r k) (heps_nn : ∀ k : ℕ, 0 ≤ eps k)
    (hrec : ∀ k : ℕ, r (k + 1) ≤ kappa * r k + eps k)
    (heps_af : ∀ k : ℕ, eps k ≤ C_g * (runningG2 gK2 b0 L_blk k) ^ 2) :
    let m : ℝ := min (1 / gK2) (blockStepDelta b0 L_blk)
    0 < m ∧
    (∀ N : ℕ, ∑ k ∈ Finset.range N, r k ≤
      (r 0 + (C_g / m ^ 2) * 3) / (1 - kappa)) ∧
    Filter.Tendsto r Filter.atTop (nhds 0) := by
  intro m
  have hlog_pos : 0 < Real.log L_blk := Real.log_pos hL
  have hΔ_pos : 0 < blockStepDelta b0 L_blk := by
    dsimp [blockStepDelta]; positivity
  have hm_pos : 0 < m := lt_min (one_div_pos.mpr hgK) hΔ_pos
  have hinv_ge : ∀ k : ℕ, m * ((k : ℝ) + 1) ≤ runningInvG2 gK2 b0 L_blk k := by
    intro k
    dsimp [runningInvG2]
    have hm1 : m ≤ 1 / gK2 := min_le_left _ _
    have hm2 : m ≤ blockStepDelta b0 L_blk := min_le_right _ _
    have hk_nn : 0 ≤ (k : ℝ) := Nat.cast_nonneg k
    nlinarith
  have hbound : ∀ k : ℕ, eps k ≤ (C_g / m ^ 2) / ((k : ℝ) + 1) ^ (2 : ℝ) := by
    intro k
    have hm_k_pos : 0 < m * ((k : ℝ) + 1) := by positivity
    have hinv_pos : 0 < runningInvG2 gK2 b0 L_blk k := lt_of_lt_of_le hm_k_pos (hinv_ge k)
    have hg_le : runningG2 gK2 b0 L_blk k ≤ 1 / (m * ((k : ℝ) + 1)) := by
      dsimp [runningG2]
      rw [one_div]
      exact inv_anti₀ hm_k_pos (hinv_ge k)
    have hg_nn : 0 ≤ runningG2 gK2 b0 L_blk k := by
      dsimp [runningG2]; positivity
    have hg_sq : (runningG2 gK2 b0 L_blk k) ^ 2 ≤ (1 / (m * ((k : ℝ) + 1))) ^ 2 :=
      pow_le_pow_left₀ hg_nn hg_le 2
    have hrpow2 : ((k : ℝ) + 1) ^ (2 : ℝ) = ((k : ℝ) + 1) ^ (2 : ℕ) := by
      norm_cast
    rw [hrpow2]
    have hrew : C_g * (1 / (m * ((k : ℝ) + 1))) ^ 2 = (C_g / m ^ 2) / ((k : ℝ) + 1) ^ 2 := by
      field_simp [ne_of_gt hm_pos, show (k : ℝ) + 1 ≠ 0 by positivity]
    calc eps k ≤ C_g * (runningG2 gK2 b0 L_blk k) ^ 2 := heps_af k
      _ ≤ C_g * (1 / (m * ((k : ℝ) + 1))) ^ 2 := mul_le_mul_of_nonneg_left hg_sq hCg
      _ = (C_g / m ^ 2) / ((k : ℝ) + 1) ^ 2 := hrew
  have hmain := (scale_decaying_mz_contraction_to_zero hkap_nn hkap_lt r eps hr_nn heps_nn hrec).2.2.2.2
    (C_g / m ^ 2) 1 2 (by positivity) (by norm_num) (le_refl 2) hbound
  refine ⟨hm_pos, ?_, hmain.2.2⟩
  intro N
  have hs := hmain.1 |> fun _ => hmain.2.1 N
  have h1k : (1 : ℝ) / (1 : ℝ) ^ (2 : ℝ) + 2 = 3 := by norm_num
  rw [h1k] at hs
  exact hs

/-! ## 2. Stagewise-Rescaled (`M-33.4`) Irrelevant-Sector Contraction -/

/-- **Stagewise-Rescaled (`M-33.4`) Irrelevant-Sector Contraction (`C/B/P`)**:
Applies UEOT `M-33.4` (`DefectGaugeCovariance.rescaled_weighted_chain_bound`) to an effective
action split into:
- **Marginal coupling sector** `g2`: kept genuinely **non-contractive** under coarse-graining
  `u ↦ u / (1 - Δ u)` (`v - u < Φ(v) - Φ(u)`, honoring `DEAD-20261124-09`),
- **Irrelevant polymer sector** `(P n, ideal n, actual n, step n)` with canonical dim-6 scaling
  `0 ≤ L_irrel n ≤ 1 / L_blk ^ 2` (`1 < L_blk`) under positive stagewise scalar gauge `c : ℕ → ℝ`
  satisfying `(c (n + 1) / c n) * (1 / L_blk ^ 2) ≤ kappa < 1`.

Proves:
1. Marginal coarse-graining remains strictly expanding on `(0, 1 / Δ)`;
2. The `M-33.4` rescaled irrelevant defect `e'_n = c_n e_n` satisfies the exact covariant
   weighted chain bound and contracts uniformly with `L'_n ≤ kappa < 1`;
3. Explicit closed finite-step contraction ceiling for `e'_n`;
4. Whenever the rescaled local defect `c (n + 1) * ε_irrel n → 0`, the irrelevant sector
   residual `e'_n = effectiveSplitNorm n - g2 n` converges to `0` (and bare `e_n → 0`
   whenever `c` is bounded below by `c_min > 0`). -/
theorem stagewise_rescaled_irrelevant_sector_contraction
    {A : ℕ → Type*}
    (P : ∀ n, RelationDefectPresentation (A n))
    (c : ℕ → ℝ) (hc : ∀ n, 0 < c n)
    (ideal actual : (n : ℕ) → A n)
    (step : ∀ n, A n → A (n + 1))
    (L_irrel ε_irrel : ℕ → ℝ)
    (hcontract : ∀ n,
      (P (n + 1)).defect (ideal (n + 1)) (step n (actual n)) ≤
        L_irrel n * (P n).defect (ideal n) (actual n))
    (htriangle : ∀ n,
      (P (n + 1)).defect (ideal (n + 1)) (actual (n + 1)) ≤
        (P (n + 1)).defect (ideal (n + 1)) (step n (actual n)) +
        (P (n + 1)).defect (step n (actual n)) (actual (n + 1)))
    (hlocal : ∀ n,
      (P (n + 1)).defect (step n (actual n)) (actual (n + 1)) ≤ ε_irrel n)
    (hL0 : ∀ n, 0 ≤ L_irrel n)
    (hε0 : ∀ n, 0 ≤ ε_irrel n)
    {L_blk kappa Δ : ℝ}
    (hL_blk : 1 < L_blk) (hkap_nn : 0 ≤ kappa) (hkap_lt : kappa < 1) (hΔ : 0 < Δ)
    (hdim6 : ∀ n, L_irrel n ≤ 1 / L_blk ^ 2)
    (hgauge : ∀ n, (c (n + 1) / c n) * (1 / L_blk ^ 2) ≤ kappa)
    (g2 : ℕ → ℝ) :
    let e' : ℕ → ℝ := fun n => ((P n).rescale (c n) (hc n)).defect (ideal n) (actual n)
    let splitNorm : ℕ → ℝ := fun n => g2 n + e' n
    (∀ u v : ℝ, 0 < u → u < v → v < 1 / Δ →
      v - u < (v / (1 - Δ * v)) - (u / (1 - Δ * u))) ∧
    (∀ n : ℕ, 1 / L_blk ^ 2 < 1 ∧ (c (n + 1) / c n) * L_irrel n ≤ kappa) ∧
    (∀ n : ℕ, e' n ≤
      (∏ j ∈ Finset.range n, ((c (j + 1) / c j) * L_irrel j)) * e' 0 +
        ∑ k ∈ Finset.range n,
          (c (k + 1) * ε_irrel k) *
            ∏ j ∈ Finset.Ico (k + 1) n, ((c (j + 1) / c j) * L_irrel j)) ∧
    (∀ n : ℕ, e' (n + 1) ≤ kappa * e' n + c (n + 1) * ε_irrel n) ∧
    (∀ n : ℕ, e' n ≤ kappa ^ n * e' 0 +
      ∑ k ∈ Finset.range n, kappa ^ (n - 1 - k) * (c (k + 1) * ε_irrel k)) ∧
    (Filter.Tendsto (fun n => c (n + 1) * ε_irrel n) Filter.atTop (nhds 0) →
      Filter.Tendsto (fun n => splitNorm n - g2 n) Filter.atTop (nhds 0)) ∧
    (∀ c_min : ℝ, 0 < c_min → (∀ n, c_min ≤ c n) →
      Filter.Tendsto (fun n => c (n + 1) * ε_irrel n) Filter.atTop (nhds 0) →
      Filter.Tendsto (fun n => (P n).defect (ideal n) (actual n)) Filter.atTop (nhds 0)) := by
  intro e' splitNorm
  have hexp : ∀ u v : ℝ, 0 < u → u < v → v < 1 / Δ →
      v - u < (v / (1 - Δ * v)) - (u / (1 - Δ * u)) := by
    intro u v hu huv hv
    have hdv_pos : 0 < 1 - Δ * v := by
      have : Δ * v < 1 := by
        have := mul_lt_mul_of_pos_left hv hΔ
        rwa [mul_one_div, div_self (ne_of_gt hΔ)] at this
      linarith
    have hdu_pos : 0 < 1 - Δ * u := by nlinarith
    have hdv_lt : 1 - Δ * v < 1 := by nlinarith
    have hdu_lt : 1 - Δ * u < 1 := by nlinarith
    have hprod_pos : 0 < (1 - Δ * v) * (1 - Δ * u) := mul_pos hdv_pos hdu_pos
    have hprod_lt : (1 - Δ * v) * (1 - Δ * u) < 1 := by nlinarith
    have hid : (v / (1 - Δ * v)) - (u / (1 - Δ * u)) =
        (v - u) / ((1 - Δ * v) * (1 - Δ * u)) := by
      rw [div_sub_div _ _ (ne_of_gt hdv_pos) (ne_of_gt hdu_pos)]
      congr 1; ring
    rw [hid, lt_div_iff₀ hprod_pos]
    nlinarith
  have hL'_le : ∀ n : ℕ, 1 / L_blk ^ 2 < 1 ∧ (c (n + 1) / c n) * L_irrel n ≤ kappa := by
    intro n
    have h1L : 1 / L_blk ^ 2 < 1 := by
      have hsq : (1 : ℝ) < L_blk ^ 2 := by nlinarith
      exact (div_lt_one (by positivity)).mpr hsq
    have hratio_nn : 0 ≤ c (n + 1) / c n := div_nonneg (le_of_lt (hc (n + 1))) (le_of_lt (hc n))
    exact ⟨h1L, le_trans (mul_le_mul_of_nonneg_left (hdim6 n) hratio_nn) (hgauge n)⟩
  have hm334 : ∀ n : ℕ, e' n ≤
      (∏ j ∈ Finset.range n, ((c (j + 1) / c j) * L_irrel j)) * e' 0 +
        ∑ k ∈ Finset.range n,
          (c (k + 1) * ε_irrel k) *
            ∏ j ∈ Finset.Ico (k + 1) n, ((c (j + 1) / c j) * L_irrel j) :=
    fun n => rescaled_weighted_chain_bound P c hc ideal actual step L_irrel ε_irrel
      hcontract htriangle hlocal hL0 n
  have he'_nn : ∀ n : ℕ, 0 ≤ e' n := fun n =>
    ((P n).rescale (c n) (hc n)).nonneg (ideal n) (actual n)
  have he'_rec : ∀ n : ℕ, e' (n + 1) ≤ kappa * e' n + c (n + 1) * ε_irrel n := by
    intro n
    have hc1 := rescale_contraction_transformed (P n) (P (n + 1)) (c n) (c (n + 1))
      (L_irrel n) (hc n) (hc (n + 1)) (hcontract n)
    have htri := rescale_triangle_preserved (P (n + 1)) (c (n + 1)) (hc (n + 1)) (htriangle n)
    have hloc := rescale_local_budget_transformed (P (n + 1)) (c (n + 1)) (ε_irrel n)
      (hc (n + 1)) (hlocal n)
    have hmul_le : ((c (n + 1) / c n) * L_irrel n) * e' n ≤ kappa * e' n :=
      mul_le_mul_of_nonneg_right (hL'_le n).2 (he'_nn n)
    have hstep1 : e' (n + 1) ≤ ((c (n + 1) / c n) * L_irrel n) * e' n + c (n + 1) * ε_irrel n := by
      change ((P (n + 1)).rescale (c (n + 1)) (hc (n + 1))).defect (ideal (n + 1)) (actual (n + 1)) ≤
        ((c (n + 1) / c n) * L_irrel n) *
          ((P n).rescale (c n) (hc n)).defect (ideal n) (actual n) + c (n + 1) * ε_irrel n
      linarith [htri, hc1, hloc]
    linarith
  have heps'_nn : ∀ n : ℕ, 0 ≤ c (n + 1) * ε_irrel n :=
    fun n => mul_nonneg (le_of_lt (hc (n + 1))) (hε0 n)
  have hmz := scale_decaying_mz_contraction_to_zero hkap_nn hkap_lt e'
    (fun n => c (n + 1) * ε_irrel n) he'_nn heps'_nn he'_rec
  have hsplit_tend : Filter.Tendsto (fun n => c (n + 1) * ε_irrel n) Filter.atTop (nhds 0) →
      Filter.Tendsto (fun n => splitNorm n - g2 n) Filter.atTop (nhds 0) := by
    intro ht
    have hrew : (fun n => splitNorm n - g2 n) = e' := by
      funext n; dsimp [splitNorm]; ring
    rw [hrew]
    exact hmz.2.2.1 ht
  have hbare_tend : ∀ c_min : ℝ, 0 < c_min → (∀ n, c_min ≤ c n) →
      Filter.Tendsto (fun n => c (n + 1) * ε_irrel n) Filter.atTop (nhds 0) →
      Filter.Tendsto (fun n => (P n).defect (ideal n) (actual n)) Filter.atTop (nhds 0) := by
    intro c_min hcmin_pos hcmin_le ht
    have he'_zero : Filter.Tendsto e' Filter.atTop (nhds 0) := hmz.2.2.1 ht
    have hupper : Filter.Tendsto (fun n => e' n / c_min) Filter.atTop (nhds 0) := by
      simpa [div_eq_mul_inv] using he'_zero.mul_const c_min⁻¹
    refine squeeze_zero (fun n => (P n).nonneg (ideal n) (actual n)) ?_ hupper
    intro n
    have hmul : c_min * (P n).defect (ideal n) (actual n) ≤ e' n := by
      change c_min * (P n).defect (ideal n) (actual n) ≤ c n * (P n).defect (ideal n) (actual n)
      exact mul_le_mul_of_nonneg_right (hcmin_le n) ((P n).nonneg (ideal n) (actual n))
    exact (le_div_iff₀ hcmin_pos).mpr (by linarith)
  exact ⟨hexp, hL'_le, hm334, he'_rec, hmz.1, hsplit_tend, hbare_tend⟩

/-! ## 3. Discrete 1-Loop / 2-Loop Asymptotic-Freedom Trajectory Comparison Bounds -/

/-- Two-loop block-spin RG step increment `Δ_1 = (2 b_1 log L_blk) / (16 π²)²`. `[B/P]` -/
noncomputable def twoLoopStepDelta (b1 L_blk : ℝ) : ℝ :=
  (2 * b1 * Real.log L_blk) / (16 * Real.pi ^ 2) ^ 2

/-- Discrete two-loop RG map `u ↦ u / (1 + Δ_0 u + Δ_1 u²)` (equivalent to
`1/u' = 1/u + Δ_0 + Δ_1 u`). `[B/P]` -/
noncomputable def twoLoopStepMap (b0 b1 L_blk u : ℝ) : ℝ :=
  u / (1 + blockStepDelta b0 L_blk * u + twoLoopStepDelta b1 L_blk * u ^ 2)

/-- Discrete two-loop running squared coupling `g_k^2` iterated `k` UV steps from `g02`. `[B/P]` -/
noncomputable def twoLoopRunningG2 (g02 b0 b1 L_blk : ℝ) : ℕ → ℝ
  | 0 => g02
  | k + 1 => twoLoopStepMap b0 b1 L_blk (twoLoopRunningG2 g02 b0 b1 L_blk k)

/-- **General Discrete Inverse-Coupling Sandwich (`B/P`)**:
For any positive sequence `g2 : ℕ → ℝ` whose inverse obeys uniform two-sided step bounds
`Δ_min ≤ 1 / g2 (k + 1) - 1 / g2 k ≤ Δ_max` with `0 < Δ_min`, proves sharp `1/k` bounds
for `k ≥ 1` and `1/(k+1)` bounds for all `k : ℕ`. -/
theorem discrete_inv_coupling_two_sided_bounds
    (g2 : ℕ → ℝ) (hg_pos : ∀ k : ℕ, 0 < g2 k)
    {Δ_min Δ_max : ℝ} (hΔmin : 0 < Δ_min)
    (hstep : ∀ k : ℕ, Δ_min ≤ 1 / g2 (k + 1) - 1 / g2 k ∧ 1 / g2 (k + 1) - 1 / g2 k ≤ Δ_max) :
    let c_lower : ℝ := 1 / (1 / g2 0 + Δ_max)
    let c_upper : ℝ := 1 / Δ_min
    let c_lower' : ℝ := 1 / max (1 / g2 0) Δ_max
    let c_upper' : ℝ := 1 / min (1 / g2 0) Δ_min
    0 < c_lower ∧ 0 < c_upper ∧ 0 < c_lower' ∧ 0 < c_upper' ∧
    (∀ k : ℕ, 1 ≤ k → c_lower / (k : ℝ) ≤ g2 k ∧ g2 k ≤ c_upper / (k : ℝ)) ∧
    (∀ k : ℕ, c_lower' / ((k : ℝ) + 1) ≤ g2 k ∧ g2 k ≤ c_upper' / ((k : ℝ) + 1)) := by
  intro c_lower c_upper c_lower' c_upper'
  have hΔmax_pos : 0 < Δ_max := by
    have h0 := hstep 0
    linarith
  have hg0_pos : 0 < g2 0 := hg_pos 0
  have hinv0_pos : 0 < 1 / g2 0 := one_div_pos.mpr hg0_pos
  have hc_low_pos : 0 < c_lower := by dsimp [c_lower]; positivity
  have hc_up_pos : 0 < c_upper := by dsimp [c_upper]; positivity
  have hmax_pos : 0 < max (1 / g2 0) Δ_max := lt_max_of_lt_left hinv0_pos
  have hmin_pos : 0 < min (1 / g2 0) Δ_min := lt_min hinv0_pos hΔmin
  have hc_low'_pos : 0 < c_lower' := by dsimp [c_lower']; positivity
  have hc_up'_pos : 0 < c_upper' := by dsimp [c_upper']; positivity
  have hinv_bounds : ∀ k : ℕ,
      1 / g2 0 + (k : ℝ) * Δ_min ≤ 1 / g2 k ∧ 1 / g2 k ≤ 1 / g2 0 + (k : ℝ) * Δ_max := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have hk := hstep k
      push_cast
      constructor <;> linarith
  have hk_ge1 : ∀ k : ℕ, 1 ≤ k → c_lower / (k : ℝ) ≤ g2 k ∧ g2 k ≤ c_upper / (k : ℝ) := by
    intro k hk
    have hk_pos : (0 : ℝ) < (k : ℝ) := Nat.cast_pos.mpr hk
    have hk_ge_1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    have hinv_pos : 0 < 1 / g2 k := one_div_pos.mpr (hg_pos k)
    have hlo_inv : (k : ℝ) * Δ_min ≤ 1 / g2 k := by
      linarith [(hinv_bounds k).1, hinv0_pos]
    have hhi_inv : 1 / g2 k ≤ (k : ℝ) * (1 / g2 0 + Δ_max) := by
      have h1 : 1 / g2 0 ≤ (k : ℝ) * (1 / g2 0) := by nlinarith
      linarith [(hinv_bounds k).2]
    constructor
    · have hrec : g2 k = (1 / g2 k)⁻¹ := by simp
      rw [hrec]
      have hle := inv_anti₀ hinv_pos hhi_inv
      have hrew : ((k : ℝ) * (1 / g2 0 + Δ_max))⁻¹ = c_lower / (k : ℝ) := by
        dsimp [c_lower]
        field_simp [ne_of_gt hk_pos, show 1 / g2 0 + Δ_max ≠ 0 by positivity]
      linarith [hle, hrew]
    · have hrec : g2 k = (1 / g2 k)⁻¹ := by simp
      rw [hrec]
      have hle := inv_anti₀ (by positivity : 0 < (k : ℝ) * Δ_min) hlo_inv
      have hrew : ((k : ℝ) * Δ_min)⁻¹ = c_upper / (k : ℝ) := by
        dsimp [c_upper]
        field_simp [ne_of_gt hk_pos, ne_of_gt hΔmin]
      linarith [hle, hrew]
  have hall : ∀ k : ℕ, c_lower' / ((k : ℝ) + 1) ≤ g2 k ∧ g2 k ≤ c_upper' / ((k : ℝ) + 1) := by
    intro k
    have hk_nn : 0 ≤ (k : ℝ) := Nat.cast_nonneg k
    have hk1_pos : (0 : ℝ) < (k : ℝ) + 1 := by positivity
    have hinv_pos : 0 < 1 / g2 k := one_div_pos.mpr (hg_pos k)
    have hlo_inv : ((k : ℝ) + 1) * min (1 / g2 0) Δ_min ≤ 1 / g2 k := by
      have h1 : min (1 / g2 0) Δ_min ≤ 1 / g2 0 := min_le_left _ _
      have h2 : min (1 / g2 0) Δ_min ≤ Δ_min := min_le_right _ _
      nlinarith [(hinv_bounds k).1]
    have hhi_inv : 1 / g2 k ≤ ((k : ℝ) + 1) * max (1 / g2 0) Δ_max := by
      have h1 : 1 / g2 0 ≤ max (1 / g2 0) Δ_max := le_max_left _ _
      have h2 : Δ_max ≤ max (1 / g2 0) Δ_max := le_max_right _ _
      nlinarith [(hinv_bounds k).2]
    constructor
    · have hrec : g2 k = (1 / g2 k)⁻¹ := by simp
      rw [hrec]
      have hle := inv_anti₀ hinv_pos hhi_inv
      have hrew : (((k : ℝ) + 1) * max (1 / g2 0) Δ_max)⁻¹ = c_lower' / ((k : ℝ) + 1) := by
        dsimp [c_lower']
        field_simp [ne_of_gt hk1_pos, ne_of_gt hmax_pos]
      linarith [hle, hrew]
    · have hrec : g2 k = (1 / g2 k)⁻¹ := by simp
      rw [hrec]
      have hle := inv_anti₀ (by positivity : 0 < ((k : ℝ) + 1) * min (1 / g2 0) Δ_min) hlo_inv
      have hrew : (((k : ℝ) + 1) * min (1 / g2 0) Δ_min)⁻¹ = c_upper' / ((k : ℝ) + 1) := by
        dsimp [c_upper']
        field_simp [ne_of_gt hk1_pos, ne_of_gt hmin_pos]
      linarith [hle, hrew]
  exact ⟨hc_low_pos, hc_up_pos, hc_low'_pos, hc_up'_pos, hk_ge1, hall⟩

/-- **Two-Loop Asymptotic-Freedom Running Bounds (`B/P`)**:
For `b0 > 0`, `b1 > 0`, `L_blk > 1`, and UV matching coupling `g02 > 0` inside the 2-loop
weak-coupling window `g02 * |b1| < 16 * π² * b0`, proves for `g_k^2 := twoLoopRunningG2 g02 b0 b1 L_blk k`:
1. Positivity `0 < g_k^2 ≤ g02`, strict UV monotonicity `g_{k+1}^2 < g_k^2`, and UV window invariance;
2. Exact 2-loop inverse-coupling step `1 / g_{k+1}^2 - 1 / g_k^2 = Δ_0 + Δ_1 g_k^2`;
3. Rigorous 1-loop/2-loop comparison: `g_k^2 ≤ runningG2 g02 b0 L_blk k` (strictly `<` for `k ≥ 1`),
   and `1 / g_k^2 ≤ 1 / g02 + k Δ_0 + Δ_1 ∑_{j < k} runningG2 g02 b0 L_blk j`;
4. Two-sided `1 / k` sandwich (`c_lower / k ≤ g_k^2 ≤ c_upper / k` for `k ≥ 1`, and
   `c_lower' / (k + 1) ≤ g_k^2 ≤ c_upper' / (k + 1)` for all `k : ℕ`);
5. Convergence `Tendsto g2 atTop (nhds 0)` and uniform `g_k^4` summability `∑ (g_k^2)^2 ≤ 2 c_upper'^2`. -/
theorem two_loop_asymptotic_freedom_running_bounds
    {b0 b1 L_blk g02 : ℝ}
    (hb0 : 0 < b0) (hb1 : 0 < b1) (hL : 1 < L_blk) (hg0 : 0 < g02)
    (h2loop : g02 * |b1| < 16 * Real.pi ^ 2 * b0) :
    let Δ0 : ℝ := blockStepDelta b0 L_blk
    let Δ1 : ℝ := twoLoopStepDelta b1 L_blk
    let g2 : ℕ → ℝ := twoLoopRunningG2 g02 b0 b1 L_blk
    let c_lower : ℝ := 1 / (1 / g02 + Δ0 + Δ1 * g02)
    let c_upper : ℝ := 1 / Δ0
    let c_lower' : ℝ := 1 / max (1 / g02) (Δ0 + Δ1 * g02)
    let c_upper' : ℝ := 1 / min (1 / g02) Δ0
    (0 < Δ0 ∧ 0 < Δ1) ∧
    (∀ k : ℕ, 0 < g2 k ∧ g2 k ≤ g02) ∧
    (∀ k : ℕ, g2 (k + 1) < g2 k) ∧
    (∀ k : ℕ, g2 k * |b1| < 16 * Real.pi ^ 2 * b0) ∧
    (∀ k : ℕ, 1 / g2 (k + 1) - 1 / g2 k = Δ0 + Δ1 * g2 k) ∧
    (∀ k : ℕ, g2 k ≤ runningG2 g02 b0 L_blk k) ∧
    (∀ k : ℕ, 1 ≤ k → g2 k < runningG2 g02 b0 L_blk k) ∧
    (∀ k : ℕ, 1 / g2 k ≤ 1 / g02 + (k : ℝ) * Δ0 +
      Δ1 * ∑ j ∈ Finset.range k, runningG2 g02 b0 L_blk j) ∧
