    unfold dwfLeftWallProfile dwfRightWallProfile
    rw [← Real.exp_add]
    congr 1
    have hs_le : s.1 ≤ L5 := Nat.le_of_lt_succ s.2
    have hcast : ((L5 - s.1 : ℕ) : ℝ) = (L5 : ℝ) - (s.1 : ℝ) := Nat.cast_sub hs_le
