/-! ## Red-Team Obstruction & Self-Convolution Contrast (`[C/B/P]`) -/

/-- **Hard-Cutoff `U(1)` Ball Negative Fourier Mode vs. Self-Convolution PSD Kernel (`[C/B/P]`)**:
1. The `U(1)` hard-cutoff ball indicator `1_{[-π/2, π/2]}` has `n = 3` Fourier coefficient
   `sin(3 * π/2) / (3 * π) = -1 / (3 * π) < 0`. Consequently, a naive single-plaquette kernel
   carrying this negative `n = 3` Fourier mode violates transfer-matrix reflection positivity
   (`x ⬝ (W *ᵥ x) < 0` on the `n = 3` mode), demonstrating why `exp(-S_L)` across `t = 0`
   hyperplanes is NOT automatically reflection-positive and `StrategyC1OpenPremise.characterOrHyperplaneRP`
   must remain `[X]`.
2. By contrast, any self-convolution kernel `φ * φ*` has nonnegative spectral weights
   `c_k = (phi_hat k)^2 ≥ 0` and is unconditionally symmetric and reflection-positive for all `m : ℕ`. -/
theorem u1_hard_cutoff_negative_fourier_vs_self_convolution_rp
    {r n : ℕ} (chi : Fin r → Fin n → ℝ) (phi_hat : Fin r → ℝ) :
    let c3 : ℝ := Real.sin (3 * (Real.pi / 2)) / (3 * Real.pi)
    let chi_u1 : Fin 2 → Fin 2 → ℝ := fun k i => if k = i then 1 else 0
    let c_u1 : Fin 2 → ℝ := fun k => if k = 0 then (1 / 2 : ℝ) else c3
    let x3 : Fin 2 → ℝ := fun i => if i = 1 then 1 else 0
    let W_self := finiteCharacterKernel chi (fun k => (phi_hat k) ^ 2)
    (c3 = -(1 / (3 * Real.pi)) ∧ c3 < 0 ∧
      dotProduct x3 ((finiteCharacterKernel chi_u1 c_u1).mulVec x3) < 0) ∧
    (W_selfᵀ = W_self ∧
      ∀ m : ℕ, ∀ x : Fin n → ℝ, 0 ≤ dotProduct x ((W_self ^ m).mulVec x)) := by
  intro c3 chi_u1 c_u1 x3 W_self
  have hsin : Real.sin (3 * (Real.pi / 2)) = -1 := by
    have harg : (3 : ℝ) * (Real.pi / 2) = Real.pi / 2 + Real.pi := by ring
    rw [harg, Real.sin_add_pi, Real.sin_pi_div_two]
  have hc3_eq : c3 = -(1 / (3 * Real.pi)) := by
    dsimp [c3]; rw [hsin, neg_div]
  have hc3_neg : c3 < 0 := by
    rw [hc3_eq]
    have hpos : 0 < 1 / (3 * Real.pi) := div_pos (by norm_num) (mul_pos (by norm_num) Real.pi_pos)
    linarith
  have hx3_1 : dotProduct x3 (chi_u1 1) ≠ 0 := by
    have heq : dotProduct x3 (chi_u1 1) = 1 := by
      unfold dotProduct; simp [x3, chi_u1]
    rw [heq]; norm_num
  have hx3_0 : ∀ k : Fin 2, k ≠ 1 → dotProduct x3 (chi_u1 k) = 0 := by
    intro k hk
    fin_cases k
    · unfold dotProduct; simp [x3, chi_u1]
    · exact absurd rfl hk
  have hc_u1_1 : c_u1 1 < 0 := by simpa [c_u1] using hc3_neg
  have hrp_fail := (luscher_character_rp_vs_topological_freezing chi_u1 c_u1).2.1
    1 x3 hc_u1_1 hx3_1 hx3_0
  have hrp_self := (luscher_character_rp_vs_topological_freezing chi (fun k => (phi_hat k) ^ 2)).1
    (fun k => sq_nonneg (phi_hat k))
  exact ⟨⟨hc3_eq, hc3_neg, hrp_fail⟩, hrp_self⟩

