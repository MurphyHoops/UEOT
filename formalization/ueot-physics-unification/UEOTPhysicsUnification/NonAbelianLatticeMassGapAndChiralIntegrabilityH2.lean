open UEOT.V3.ViabilityKernel

/-! ## Part 1: 4D Hyperoctahedral `H(4)` Cubic Tensor Isotropy & `O(a^2)` Restoration (`[C/B/P/O]`) -/

/-- Kronecker delta `δ_{μν}` on `Fin 4`. `[C]` -/
def delta2 (μ ν : Fin 4) : ℝ :=
  if μ = ν then 1 else 0

/-- Hypercubic 4-index diagonal invariant `δ_{μνρσ}` on `Fin 4`. `[C/B]` -/
def delta4 (μ ν ρ σ : Fin 4) : ℝ :=
  if μ = ν ∧ ν = ρ ∧ ρ = σ then 1 else 0

/-- Coordinate sign-flip vector `s ∈ {±1}^4` flipping axis `α`. `[C]` -/
def axisFlipSign (α : Fin 4) (i : Fin 4) : ℝ :=
  if i = α then -1 else 1

lemma axisFlipSign_dichotomy (α i : Fin 4) :
    axisFlipSign α i = 1 ∨ axisFlipSign α i = -1 := by
  dsimp [axisFlipSign]
  split_ifs <;> simp

/-- A rank-2 tensor `T : Fin 4 → Fin 4 → ℝ` is `H(4)`-invariant iff it is invariant under
all coordinate sign flips `x_μ ↦ ± x_μ` and all axis permutations `S_4`. `[C/B]` -/
def H4Invariant2 (T : Fin 4 → Fin 4 → ℝ) : Prop :=
  (∀ s : Fin 4 → ℝ, (∀ i : Fin 4, s i = 1 ∨ s i = -1) →
    ∀ μ ν : Fin 4, s μ * s ν * T μ ν = T μ ν) ∧
  (∀ π : Equiv.Perm (Fin 4), ∀ μ ν : Fin 4, T (π μ) (π ν) = T μ ν)

/-- A rank-4 tensor `Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ` is `H(4)`-invariant iff it is
invariant under all coordinate sign flips and all axis permutations `S_4`. `[C/B]` -/
def H4Invariant4 (Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ) : Prop :=
  (∀ s : Fin 4 → ℝ, (∀ i : Fin 4, s i = 1 ∨ s i = -1) →
    ∀ μ ν ρ σ : Fin 4, s μ * s ν * s ρ * s σ * Q μ ν ρ σ = Q μ ν ρ σ) ∧
  (∀ π : Equiv.Perm (Fin 4), ∀ μ ν ρ σ : Fin 4,
    Q (π μ) (π ν) (π ρ) (π σ) = Q μ ν ρ σ)

/-- Action of a 4×4 matrix `R` on a rank-2 tensor. `[C]` -/
def rotTensor2 (R : Matrix (Fin 4) (Fin 4) ℝ) (T : Fin 4 → Fin 4 → ℝ) :
    Fin 4 → Fin 4 → ℝ :=
  fun μ ν => ∑ α : Fin 4, ∑ β : Fin 4, R μ α * R ν β * T α β

/-- Action of a 4×4 matrix `R` on a rank-4 tensor. `[C]` -/
def rotTensor4 (R : Matrix (Fin 4) (Fin 4) ℝ)
    (Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ) :
    Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ :=
  fun μ ν ρ σ =>
    ∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
      R μ α * R ν β * R ρ γ * R σ δ * Q α β γ δ

private lemma exists_perm_map_two {a b : Fin 4} (hab : a ≠ b) :
    ∃ π : Equiv.Perm (Fin 4), π 0 = a ∧ π 1 = b := by
  let τ : Equiv.Perm (Fin 4) := Equiv.swap 0 a
  let b' : Fin 4 := τ.symm b
  have hb'0 : b' ≠ 0 := by
    intro h0
    apply hab
    have : τ b' = τ 0 := congrArg τ h0
    simpa [b', τ] using this.symm
  let π : Equiv.Perm (Fin 4) := (Equiv.swap (1 : Fin 4) b').trans τ
  refine ⟨π, ?_, ?_⟩
  · have h01 : (0 : Fin 4) ≠ 1 := by decide
    simp [π, τ, Equiv.swap_apply_of_ne_of_ne h01 hb'0.symm]
  · simp [π, b']

lemma delta2_orth_invariant (R : Matrix (Fin 4) (Fin 4) ℝ) (hR : R * Rᵀ = 1) :
    rotTensor2 R delta2 = delta2 := by
  funext μ ν
  dsimp [rotTensor2, delta2]
  have hsum : (∑ α : Fin 4, ∑ β : Fin 4,
      R μ α * R ν β * (if α = β then (1 : ℝ) else 0)) =
      ∑ α : Fin 4, R μ α * R ν α := by
    refine Finset.sum_congr rfl (fun α _ => ?_)
    simp
  rw [hsum]
  have hent := congrFun (congrFun hR μ) ν
  simpa [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply, delta2] using hent

/-- Helper: if any index occurs exactly once among `(μ, ν, ρ, σ)`, `Q μ ν ρ σ = 0`. -/
private lemma rank4_zero_if_singleton
    {Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ}
    (hsign : ∀ s : Fin 4 → ℝ, (∀ i : Fin 4, s i = 1 ∨ s i = -1) →
      ∀ μ ν ρ σ : Fin 4, s μ * s ν * s ρ * s σ * Q μ ν ρ σ = Q μ ν ρ σ)
    {μ ν ρ σ : Fin 4}
    (huniq :
      (μ ≠ ν ∧ μ ≠ ρ ∧ μ ≠ σ) ∨
      (ν ≠ μ ∧ ν ≠ ρ ∧ ν ≠ σ) ∨
      (ρ ≠ μ ∧ ρ ≠ ν ∧ ρ ≠ σ) ∨
      (σ ≠ μ ∧ σ ≠ ν ∧ σ ≠ ρ)) :
    Q μ ν ρ σ = 0 := by
  rcases huniq with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩
  · have h := hsign (axisFlipSign μ) (axisFlipSign_dichotomy μ) μ ν ρ σ
    simp [axisFlipSign, h1.symm, h2.symm, h3.symm] at h
    linarith
  · have h := hsign (axisFlipSign ν) (axisFlipSign_dichotomy ν) μ ν ρ σ
    simp [axisFlipSign, h1.symm, h2.symm, h3.symm] at h
    linarith
  · have h := hsign (axisFlipSign ρ) (axisFlipSign_dichotomy ρ) μ ν ρ σ
    simp [axisFlipSign, h1.symm, h2.symm, h3.symm] at h
    linarith
  · have h := hsign (axisFlipSign σ) (axisFlipSign_dichotomy σ) μ ν ρ σ
    simp [axisFlipSign, h1.symm, h2.symm, h3.symm] at h
    linarith

private lemma sign_mul_self_eq_one {x : ℝ} (hx : x = 1 ∨ x = -1) : x * x = 1 := by
  rcases hx with rfl | rfl <;> norm_num

/-- Explicit Hadamard-type 4×4 matrix in `SO(4)` (`R * Rᵀ = 1`, `Rᵀ * R = 1`, `det R = 1`)
used to witness genuine `SO(4)`-breaking of the hypercubic `δ_{μνρσ}` invariant. `[C]` -/
noncomputable def hadamardSO4 : Matrix (Fin 4) (Fin 4) ℝ :=
  !![ 1 / 2,  1 / 2,  1 / 2,  1 / 2;
      1 / 2, -1 / 2,  1 / 2, -1 / 2;
      1 / 2,  1 / 2, -1 / 2, -1 / 2;
      1 / 2, -1 / 2, -1 / 2,  1 / 2 ]

lemma hadamardSO4_orth_and_det :
    hadamardSO4 * hadamardSO4ᵀ = 1 ∧
    hadamardSO4ᵀ * hadamardSO4 = 1 ∧
    hadamardSO4.det = 1 := by
  refine ⟨?_, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [hadamardSO4, Matrix.mul_apply, Fin.sum_univ_four] <;> norm_num
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [hadamardSO4, Matrix.mul_apply, Fin.sum_univ_four] <;> norm_num
  · simp [Matrix.det_succ_row_zero, Fin.sum_univ_four, Fin.sum_univ_three,
      Fin.succAbove, hadamardSO4]
    norm_num

/-- **4D `H(4)` Cubic Tensor Isotropy & `O(a^2)` Restoration Theorem (`[C/B/P/O]`)**:
1. **Rank-2 `O(a^0)` Isotropy**: A rank-2 tensor `T` is `H(4)`-invariant iff there is a (unique)
   scalar `c : ℝ` such that `T μ ν = c * δ_{μν}`; moreover every `c * δ_{μν}` is fully
   `O(4)`-isotropic (`rotTensor2 R T = T` for all `R * Rᵀ = 1`), leaving zero `O(a^0)`
   Lorentz-breaking anisotropy.
2. **Rank-4 Exact Basis Decomposition**: A rank-4 tensor `Q` is `H(4)`-invariant iff there exist
   unique `(c₁, c₂, c₃, c₄)` with
   `Q μ ν ρ σ = c₁ δ_{μν} δ_{ρσ} + c₂ δ_{μρ} δ_{νσ} + c₃ δ_{μσ} δ_{νρ} + c₄ δ_{μνρσ}`.
3. **Pair-Symmetric `(ρ ↔ σ)` Two-Pairing + Hypercubic Diagonal**: When `Q` is symmetric in
   `(ρ, σ)` (as in momentum-space propagator/self-energy insertions `p_ρ p_σ Q_{μνρσ}`), `c₂ = c₃`,
   so `Q` decomposes uniquely into the two `SO(4)`-isotropic pairings
   `a (δ_{μν} δ_{ρσ}) + b (δ_{μρ} δ_{νσ} + δ_{μσ} δ_{νρ})` plus the single hypercubic diagonal
   invariant `d δ_{μνρσ}`.
4. **`SO(4)` Invariance vs. Hypercubic Breaking**: Each of the three Kronecker pairings is
   `O(4)`-invariant (`rotTensor4 R = id` whenever `R * Rᵀ = 1`), whereas `δ_{μνρσ}` is
   `H(4)`-invariant yet fails `SO(4)` invariance at `hadamardSO4` (`1/4 ≠ 1`).
5. **Momentum-Space `O(a^2 p^4)` Restoration**: For any `H(4)`-invariant `Q` and momentum
   `p : Fin 4 → ℝ`:
   - `∑ μ ν ρ σ, Q μ ν ρ σ * p μ * p ν * p ρ * p σ = (c₁ + c₂ + c₃) (∑ μ, p μ ^ 2)^2 + c₄ ∑ μ, p μ ^ 4`,
   - `∑ ρ σ, Q μ ν ρ σ * p ρ * p σ = c₁ δ_{μν} (∑ ρ, p ρ ^ 2) + (c₂ + c₃) p μ p ν + c₄ δ_{μν} p μ ^ 2`,
   - `(1/4) (∑ μ, p μ ^ 2)^2 ≤ ∑ μ, p μ ^ 4 ≤ (∑ μ, p μ ^ 2)^2`, so `O(a^2)` rotational breaking
     enters momentum-space propagators strictly at `O(a^2 p^4)` and vanishes as `a → 0`. -/
theorem cubic_h4_isotropy_rank2_and_rank4_tensor_decomposition :
    (∀ T : Fin 4 → Fin 4 → ℝ,
      H4Invariant2 T ↔ ∃! c : ℝ, ∀ μ ν : Fin 4, T μ ν = c * delta2 μ ν) ∧
    (∀ (c : ℝ) (R : Matrix (Fin 4) (Fin 4) ℝ), R * Rᵀ = 1 →
      rotTensor2 R (fun μ ν => c * delta2 μ ν) = fun μ ν => c * delta2 μ ν) ∧
    (∀ Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ,
      H4Invariant4 Q ↔
        ∃! coeff : ℝ × ℝ × ℝ × ℝ,
          ∀ μ ν ρ σ : Fin 4,
            Q μ ν ρ σ =
              coeff.1 * delta2 μ ν * delta2 ρ σ +
              coeff.2.1 * delta2 μ ρ * delta2 ν σ +
              coeff.2.2.1 * delta2 μ σ * delta2 ν ρ +
              coeff.2.2.2 * delta4 μ ν ρ σ) ∧
    (∀ Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ,
      (H4Invariant4 Q ∧ ∀ μ ν ρ σ : Fin 4, Q μ ν ρ σ = Q μ ν σ ρ) ↔
        ∃! coeff : ℝ × ℝ × ℝ,
          ∀ μ ν ρ σ : Fin 4,
            Q μ ν ρ σ =
              coeff.1 * (delta2 μ ν * delta2 ρ σ) +
              coeff.2.1 * (delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ) +
              coeff.2.2 * delta4 μ ν ρ σ) ∧
    ((∀ R : Matrix (Fin 4) (Fin 4) ℝ, R * Rᵀ = 1 →
        rotTensor4 R (fun μ ν ρ σ => delta2 μ ν * delta2 ρ σ) =
          (fun μ ν ρ σ => delta2 μ ν * delta2 ρ σ) ∧
        rotTensor4 R (fun μ ν ρ σ => delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ) =
          (fun μ ν ρ σ => delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ)) ∧
      H4Invariant4 delta4 ∧
      hadamardSO4 * hadamardSO4ᵀ = 1 ∧
      hadamardSO4.det = 1 ∧
      rotTensor4 hadamardSO4 delta4 0 0 0 0 ≠ delta4 0 0 0 0) ∧
    (∀ (Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ), H4Invariant4 Q →
      let c1 := Q 0 0 1 1
      let c2 := Q 0 1 0 1
      let c3 := Q 0 1 1 0
      let c4 := Q 0 0 0 0 - (c1 + c2 + c3)
      ∀ (a : ℝ) (p : Fin 4 → ℝ),
        (∑ μ : Fin 4, ∑ ν : Fin 4, ∑ ρ : Fin 4, ∑ σ : Fin 4,
          Q μ ν ρ σ * p μ * p ν * p ρ * p σ =
          (c1 + c2 + c3) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 + c4 * ∑ μ : Fin 4, p μ ^ 4) ∧
        (∀ μ ν : Fin 4,
          ∑ ρ : Fin 4, ∑ σ : Fin 4, Q μ ν ρ σ * p ρ * p σ =
            c1 * delta2 μ ν * (∑ ρ : Fin 4, p ρ ^ 2) +
            (c2 + c3) * (p μ * p ν) +
            c4 * delta2 μ ν * p μ ^ 2) ∧
        ((1 / 4 : ℝ) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 ≤ ∑ μ : Fin 4, p μ ^ 4 ∧
          ∑ μ : Fin 4, p μ ^ 4 ≤ (∑ μ : Fin 4, p μ ^ 2) ^ 2) ∧
        |a ^ 2 * (c4 * ∑ μ : Fin 4, p μ ^ 4)| ≤ |c4| * a ^ 2 * (∑ μ : Fin 4, p μ ^ 2) ^ 2) := by
  have hRank2 : ∀ T : Fin 4 → Fin 4 → ℝ,
      H4Invariant2 T ↔ ∃! c : ℝ, ∀ μ ν : Fin 4, T μ ν = c * delta2 μ ν := by
    intro T
    constructor
    · rintro ⟨hsign, hperm⟩
      refine ⟨T 0 0, ?_, ?_⟩
      · intro μ ν
        by_cases hμν : μ = ν
        · subst hμν
          have h := hperm (Equiv.swap 0 μ) 0 0
          rw [Equiv.swap_apply_left] at h
          simpa [delta2] using h
        · have h := hsign (axisFlipSign μ) (axisFlipSign_dichotomy μ) μ ν
          simp [axisFlipSign, Ne.symm hμν] at h
          have hzero : T μ ν = 0 := by linarith
          simp [delta2, hμν, hzero]
      · intro c hc
        have h0 := hc 0 0
        simpa [delta2] using h0.symm
    · rintro ⟨c, hc, _⟩
      constructor
      · intro s hs μ ν
        rw [hc μ ν]
        by_cases hμν : μ = ν
        · subst hμν
          have hss : s μ * s μ = 1 := sign_mul_self_eq_one (hs μ)
          calc s μ * s μ * (c * delta2 μ μ)
              = (s μ * s μ) * (c * delta2 μ μ) := by ring
            _ = 1 * (c * delta2 μ μ) := by rw [hss]
            _ = c * delta2 μ μ := by ring
        · simp [delta2, hμν]
      · intro π μ ν
        rw [hc (π μ) (π ν), hc μ ν]
        by_cases hμν : μ = ν
        · subst hμν; simp [delta2]
        · have hne : π μ ≠ π ν := fun h => hμν (π.injective h)
          simp [delta2, hμν, hne]
  have hRot2 : ∀ (c : ℝ) (R : Matrix (Fin 4) (Fin 4) ℝ), R * Rᵀ = 1 →
      rotTensor2 R (fun μ ν => c * delta2 μ ν) = fun μ ν => c * delta2 μ ν := by
    intro c R hR
    funext μ ν
    dsimp [rotTensor2]
    have hmul : (∑ α : Fin 4, ∑ β : Fin 4, R μ α * R ν β * (c * delta2 α β)) =
        c * rotTensor2 R delta2 μ ν := by
      dsimp [rotTensor2]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun α _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun β _ => by ring)
    rw [hmul, delta2_orth_invariant R hR]
  have hRank4 : ∀ Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ,
      H4Invariant4 Q ↔
        ∃! coeff : ℝ × ℝ × ℝ × ℝ,
          ∀ μ ν ρ σ : Fin 4,
            Q μ ν ρ σ =
              coeff.1 * delta2 μ ν * delta2 ρ σ +
              coeff.2.1 * delta2 μ ρ * delta2 ν σ +
              coeff.2.2.1 * delta2 μ σ * delta2 ν ρ +
              coeff.2.2.2 * delta4 μ ν ρ σ := by
    intro Q
    constructor
    · rintro ⟨hsign, hperm⟩
      let c1 := Q 0 0 1 1
      let c2 := Q 0 1 0 1
      let c3 := Q 0 1 1 0
      let c4 := Q 0 0 0 0 - (c1 + c2 + c3)
      refine ⟨(c1, c2, c3, c4), ?_, ?_⟩
      · intro μ ν ρ σ
        by_cases hμν : μ = ν
        · subst hμν
          by_cases hρσ : ρ = σ
          · subst hρσ
            by_cases hμρ : μ = ρ
            · subst hμρ
              have h0 : Q μ μ μ μ = Q 0 0 0 0 := by
                have hp := hperm (Equiv.swap 0 μ) 0 0 0 0
                rw [Equiv.swap_apply_left] at hp
                exact hp
              simp [delta2, delta4, c4, h0]
            · obtain ⟨π, hπ0, hπ1⟩ := exists_perm_map_two hμρ
              have h0 : Q μ μ ρ ρ = c1 := by
                have hp := hperm π 0 0 1 1
                rw [hπ0, hπ1] at hp
                exact hp
              simp [delta2, delta4, hμρ, h0]
          · by_cases hμρ : μ = ρ
            · subst hμρ
              have hzero : Q μ μ μ σ = 0 :=
                rank4_zero_if_singleton hsign (Or.inr (Or.inr (Or.inr
                  ⟨Ne.symm hρσ, Ne.symm hρσ, Ne.symm hρσ⟩)))
              simp [delta2, delta4, hρσ, hzero]
            · have hzero : Q μ μ ρ σ = 0 :=
                rank4_zero_if_singleton hsign (Or.inr (Or.inr (Or.inl
                  ⟨Ne.symm hμρ, Ne.symm hμρ, hρσ⟩)))
              by_cases hμσ : μ = σ
              · subst hμσ
                simp [delta2, delta4, hρσ, hμρ, hzero]
              · simp [delta2, delta4, hρσ, hμρ, hμσ, hzero]
        · by_cases hρσ : ρ = σ
          · subst hρσ
            by_cases hμρ : μ = ρ
            · subst hμρ
              have hzero : Q μ ν μ μ = 0 :=
                rank4_zero_if_singleton hsign (Or.inr (Or.inl
                  ⟨Ne.symm hμν, Ne.symm hμν, Ne.symm hμν⟩))
              simp [delta2, delta4, hμν, Ne.symm hμν, hzero]
            · have hzero : Q μ ν ρ ρ = 0 :=
                rank4_zero_if_singleton hsign (Or.inl ⟨hμν, hμρ, hμρ⟩)
              by_cases hνρ : ν = ρ
              · subst hνρ
                simp [delta2, delta4, hμν, hzero]
              · simp [delta2, delta4, hμν, hμρ, hνρ, hzero]
          · by_cases hμρ : μ = ρ
            · subst hμρ
              by_cases hνσ : ν = σ
              · subst hνσ
                obtain ⟨π, hπ0, hπ1⟩ := exists_perm_map_two hμν
                have h0 : Q μ ν μ ν = c2 := by
                  have hp := hperm π 0 1 0 1
                  rw [hπ0, hπ1] at hp
                  exact hp
                simp [delta2, delta4, hμν, Ne.symm hμν, h0]
              · have hzero : Q μ ν μ σ = 0 := by
                  by_cases hμσ : μ = σ
                  · subst hμσ
                    exact rank4_zero_if_singleton hsign (Or.inr (Or.inl
                      ⟨Ne.symm hμν, Ne.symm hμν, hνσ⟩))
                  · exact rank4_zero_if_singleton hsign (Or.inr (Or.inr (Or.inr
                      ⟨Ne.symm hμσ, Ne.symm hνσ, Ne.symm hρσ⟩)))
                simp [delta2, delta4, hμν, hνσ, Ne.symm hμν, hzero]
            · by_cases hμσ : μ = σ
              · subst hμσ
                by_cases hνρ : ν = ρ
                · subst hνρ
                  obtain ⟨π, hπ0, hπ1⟩ := exists_perm_map_two hμν
                  have h0 : Q μ ν ν μ = c3 := by
                    have hp := hperm π 0 1 1 0
                    rw [hπ0, hπ1] at hp
                    exact hp
                  simp [delta2, delta4, hμν, Ne.symm hμν, h0]
                · have hzero : Q μ ν ρ μ = 0 :=
                    rank4_zero_if_singleton hsign (Or.inr (Or.inl
                      ⟨Ne.symm hμν, hνρ, Ne.symm hμν⟩))
                  simp [delta2, delta4, hμν, hμρ, hνρ, hzero]
              · have hzero : Q μ ν ρ σ = 0 :=
                  rank4_zero_if_singleton hsign (Or.inl ⟨hμν, hμρ, hμσ⟩)
                simp [delta2, delta4, hμν, hμρ, hμσ, hzero]
      · rintro ⟨d1, d2, d3, d4⟩ hd
        have h0011 := hd 0 0 1 1
        have h0101 := hd 0 1 0 1
        have h0110 := hd 0 1 1 0
        have h0000 := hd 0 0 0 0
        have h01 : (0 : Fin 4) ≠ 1 := by decide
        have h10 : (1 : Fin 4) ≠ 0 := by decide
        simp [delta2, delta4, h01, h10] at h0011 h0101 h0110 h0000
        refine Prod.ext h0011.symm (Prod.ext h0101.symm (Prod.ext h0110.symm ?_))
        dsimp [c4, c1, c2, c3]
        linarith
    · rintro ⟨⟨c1, c2, c3, c4⟩, hQ, _⟩
      have hpair_sign : ∀ (s : Fin 4 → ℝ), (∀ i, s i = 1 ∨ s i = -1) →
          ∀ a b c d : Fin 4, s a * s b * s c * s d * (delta2 a b * delta2 c d) =
            delta2 a b * delta2 c d := by
        intro s hs a b c d
        by_cases hab : a = b <;> by_cases hcd : c = d
        · subst hab hcd
          have h1 := sign_mul_self_eq_one (hs a)
          have h2 := sign_mul_self_eq_one (hs c)
          calc s a * s a * s c * s c * (delta2 a a * delta2 c c)
              = (s a * s a) * (s c * s c) * (delta2 a a * delta2 c c) := by ring
            _ = delta2 a a * delta2 c c := by rw [h1, h2]; ring
        · simp [delta2, hcd]
        · simp [delta2, hab]
        · simp [delta2, hab]
      have hdelta4_sign : ∀ (s : Fin 4 → ℝ), (∀ i, s i = 1 ∨ s i = -1) →
          ∀ a b c d : Fin 4, s a * s b * s c * s d * delta4 a b c d = delta4 a b c d := by
        intro s hs a b c d
        by_cases h : a = b ∧ b = c ∧ c = d
        · rcases h with ⟨rfl, rfl, rfl⟩
          have h1 := sign_mul_self_eq_one (hs a)
          calc s a * s a * s a * s a * delta4 a a a a
              = (s a * s a) * (s a * s a) * delta4 a a a a := by ring
            _ = delta4 a a a a := by rw [h1]; ring
        · simp [delta4, h]
      constructor
      · intro s hs μ ν ρ σ
        rw [hQ μ ν ρ σ]
        have hs1 := hpair_sign s hs μ ν ρ σ
        have hs2 := hpair_sign s hs μ ρ ν σ
        have hs3 := hpair_sign s hs μ σ ν ρ
        have hs4 := hdelta4_sign s hs μ ν ρ σ
        calc s μ * s ν * s ρ * s σ *
              (c1 * delta2 μ ν * delta2 ρ σ + c2 * delta2 μ ρ * delta2 ν σ +
                c3 * delta2 μ σ * delta2 ν ρ + c4 * delta4 μ ν ρ σ)
            = c1 * (s μ * s ν * s ρ * s σ * (delta2 μ ν * delta2 ρ σ)) +
              c2 * (s μ * s ρ * s ν * s σ * (delta2 μ ρ * delta2 ν σ)) +
              c3 * (s μ * s σ * s ν * s ρ * (delta2 μ σ * delta2 ν ρ)) +
              c4 * (s μ * s ν * s ρ * s σ * delta4 μ ν ρ σ) := by ring
          _ = c1 * (delta2 μ ν * delta2 ρ σ) + c2 * (delta2 μ ρ * delta2 ν σ) +
              c3 * (delta2 μ σ * delta2 ν ρ) + c4 * delta4 μ ν ρ σ := by
            rw [hs1, hs2, hs3, hs4]
          _ = c1 * delta2 μ ν * delta2 ρ σ + c2 * delta2 μ ρ * delta2 ν σ +
              c3 * delta2 μ σ * delta2 ν ρ + c4 * delta4 μ ν ρ σ := by ring
      · intro π μ ν ρ σ
        rw [hQ (π μ) (π ν) (π ρ) (π σ), hQ μ ν ρ σ]
        have heq : ∀ x y : Fin 4, delta2 (π x) (π y) = delta2 x y := by
          intro x y
          by_cases hxy : x = y
          · subst hxy; simp [delta2]
          · have hne : π x ≠ π y := fun h => hxy (π.injective h)
            simp [delta2, hxy, hne]
        have heq4 : delta4 (π μ) (π ν) (π ρ) (π σ) = delta4 μ ν ρ σ := by
          by_cases h : μ = ν ∧ ν = ρ ∧ ρ = σ
          · rcases h with ⟨rfl, rfl, rfl⟩; simp [delta4]
          · have hne : ¬ (π μ = π ν ∧ π ν = π ρ ∧ π ρ = π σ) := by
              rintro ⟨h1, h2, h3⟩
              exact h ⟨π.injective h1, π.injective h2, π.injective h3⟩
            simp [delta4, h]
        rw [heq μ ν, heq ρ σ, heq μ ρ, heq ν σ, heq μ σ, heq ν ρ, heq4]
  have hPairSymm : ∀ Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ,
      (H4Invariant4 Q ∧ ∀ μ ν ρ σ : Fin 4, Q μ ν ρ σ = Q μ ν σ ρ) ↔
        ∃! coeff : ℝ × ℝ × ℝ,
          ∀ μ ν ρ σ : Fin 4,
            Q μ ν ρ σ =
              coeff.1 * (delta2 μ ν * delta2 ρ σ) +
              coeff.2.1 * (delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ) +
              coeff.2.2 * delta4 μ ν ρ σ := by
    intro Q
    constructor
    · rintro ⟨hH4, hsym⟩
      obtain ⟨⟨c1, c2, c3, c4⟩, hdecomp, _⟩ := (hRank4 Q).mp hH4
      have hc23 : c2 = c3 := by
        have h0 := hsym 0 1 0 1
        have hL := hdecomp 0 1 0 1
        have hR := hdecomp 0 1 1 0
        have h01 : (0 : Fin 4) ≠ 1 := by decide
        have h10 : (1 : Fin 4) ≠ 0 := by decide
        simp [delta2, delta4, h01, h10] at hL hR
        linarith
      refine ⟨(c1, c2, c4), ?_, ?_⟩
      · intro μ ν ρ σ
        rw [hdecomp μ ν ρ σ, hc23]
        ring
      · rintro ⟨a, b, d⟩ habd
        have h0011 := habd 0 0 1 1
        have h0101 := habd 0 1 0 1
        have h0000 := habd 0 0 0 0
        have hc_0011 := hdecomp 0 0 1 1
        have hc_0101 := hdecomp 0 1 0 1
        have hc_0000 := hdecomp 0 0 0 0
        have h01 : (0 : Fin 4) ≠ 1 := by decide
        have h10 : (1 : Fin 4) ≠ 0 := by decide
        simp [delta2, delta4, h01, h10] at h0011 h0101 h0000 hc_0011 hc_0101 hc_0000
        refine Prod.ext (by linarith) (Prod.ext (by linarith) (by linarith))
    · rintro ⟨⟨a, b, d⟩, hQ, _⟩
      constructor
      · refine (hRank4 Q).mpr ⟨(a, b, b, d), ?_, ?_⟩
        · intro μ ν ρ σ; rw [hQ μ ν ρ σ]; ring
        · rintro ⟨d1, d2, d3, d4⟩ hd
          have h0011 := hd 0 0 1 1
          have h0101 := hd 0 1 0 1
          have h0110 := hd 0 1 1 0
          have h0000 := hd 0 0 0 0
          have hQ0011 := hQ 0 0 1 1
          have hQ0101 := hQ 0 1 0 1
          have hQ0110 := hQ 0 1 1 0
          have hQ0000 := hQ 0 0 0 0
          have h01 : (0 : Fin 4) ≠ 1 := by decide
          have h10 : (1 : Fin 4) ≠ 0 := by decide
          simp [delta2, delta4, h01, h10] at h0011 h0101 h0110 h0000 hQ0011 hQ0101 hQ0110 hQ0000
          refine Prod.ext (by linarith) (Prod.ext (by linarith) (Prod.ext (by linarith) (by linarith)))
      · intro μ ν ρ σ
        rw [hQ μ ν ρ σ, hQ μ ν σ ρ]
        have h1 : delta2 ρ σ = delta2 σ ρ := by
          by_cases h : ρ = σ <;> simp [delta2, h, eq_comm]
        have h4 : delta4 μ ν ρ σ = delta4 μ ν σ ρ := by
          by_cases h1 : μ = ν ∧ ν = ρ ∧ ρ = σ
          · rcases h1 with ⟨rfl, rfl, rfl⟩; simp [delta4]
          · have h2 : ¬ (μ = ν ∧ ν = σ ∧ σ = ρ) := by
              rintro ⟨rfl, rfl, rfl⟩; exact h1 ⟨rfl, rfl, rfl⟩
            simp [delta4, h1, h2]
        rw [h1, h4]; ring
  have hSO4Sep :
      (∀ R : Matrix (Fin 4) (Fin 4) ℝ, R * Rᵀ = 1 →
        rotTensor4 R (fun μ ν ρ σ => delta2 μ ν * delta2 ρ σ) =
          (fun μ ν ρ σ => delta2 μ ν * delta2 ρ σ) ∧
        rotTensor4 R (fun μ ν ρ σ => delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ) =
          (fun μ ν ρ σ => delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ)) ∧
      H4Invariant4 delta4 ∧
      hadamardSO4 * hadamardSO4ᵀ = 1 ∧
      hadamardSO4.det = 1 ∧
      rotTensor4 hadamardSO4 delta4 0 0 0 0 ≠ delta4 0 0 0 0 := by
    have horth_pair : ∀ R : Matrix (Fin 4) (Fin 4) ℝ, R * Rᵀ = 1 →
        rotTensor4 R (fun μ ν ρ σ => delta2 μ ν * delta2 ρ σ) =
          (fun μ ν ρ σ => delta2 μ ν * delta2 ρ σ) ∧
        rotTensor4 R (fun μ ν ρ σ => delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ) =
          (fun μ ν ρ σ => delta2 μ ρ * delta2 ν σ + delta2 μ σ * delta2 ν ρ) := by
      intro R hR
      have hdel := delta2_orth_invariant R hR
      have hid1 : ∀ x y : Fin 4,
          (∑ α : Fin 4, ∑ β : Fin 4, R x α * R y β * delta2 α β) = delta2 x y := fun x y =>
        congrFun (congrFun hdel x) y
      constructor
      · funext μ ν ρ σ
        dsimp [rotTensor4]
        calc ∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
              R μ α * R ν β * R ρ γ * R σ δ * (delta2 α β * delta2 γ δ)
            = (∑ α : Fin 4, ∑ β : Fin 4, R μ α * R ν β * delta2 α β) *
                (∑ γ : Fin 4, ∑ δ : Fin 4, R ρ γ * R σ δ * delta2 γ δ) := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl (fun α _ => ?_)
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl (fun β _ => ?_)
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun γ _ => ?_)
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun δ _ => by ring)
          _ = delta2 μ ν * delta2 ρ σ := by rw [hid1 μ ν, hid1 ρ σ]
      · funext μ ν ρ σ
        dsimp [rotTensor4]
        have hterm : (∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
              R μ α * R ν β * R ρ γ * R σ δ * (delta2 α γ * delta2 β δ + delta2 α δ * delta2 β γ)) =
            (∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
              R μ α * R ν β * R ρ γ * R σ δ * (delta2 α γ * delta2 β δ)) +
            (∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
              R μ α * R ν β * R ρ γ * R σ δ * (delta2 α δ * delta2 β γ)) := by
          simp_rw [mul_add, Finset.sum_add_distrib]
        rw [hterm]
        have hA : (∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
              R μ α * R ν β * R ρ γ * R σ δ * (delta2 α γ * delta2 β δ)) =
            delta2 μ ρ * delta2 ν σ := by
          calc ∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
                R μ α * R ν β * R ρ γ * R σ δ * (delta2 α γ * delta2 β δ)
              = (∑ α : Fin 4, ∑ γ : Fin 4, R μ α * R ρ γ * delta2 α γ) *
                  (∑ β : Fin 4, ∑ δ : Fin 4, R ν β * R σ δ * delta2 β δ) := by
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl (fun α _ => ?_)
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun β _ => ?_)
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl (fun γ _ => ?_)
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun δ _ => by ring)
            _ = delta2 μ ρ * delta2 ν σ := by rw [hid1 μ ρ, hid1 ν σ]
        have hB : (∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
              R μ α * R ν β * R ρ γ * R σ δ * (delta2 α δ * delta2 β γ)) =
            delta2 μ σ * delta2 ν ρ := by
          calc ∑ α : Fin 4, ∑ β : Fin 4, ∑ γ : Fin 4, ∑ δ : Fin 4,
                R μ α * R ν β * R ρ γ * R σ δ * (delta2 α δ * delta2 β γ)
              = (∑ α : Fin 4, ∑ δ : Fin 4, R μ α * R σ δ * delta2 α δ) *
                  (∑ β : Fin 4, ∑ γ : Fin 4, R ν β * R ρ γ * delta2 β γ) := by
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl (fun α _ => ?_)
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun β _ => ?_)
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun γ _ => ?_)
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl (fun δ _ => by ring)
            _ = delta2 μ σ * delta2 ν ρ := by rw [hid1 μ σ, hid1 ν ρ]
        rw [hA, hB]
    have hdelta4_H4 : H4Invariant4 delta4 := by
      refine (hRank4 delta4).mpr ⟨(0, 0, 0, 1), ?_, ?_⟩
      · intro μ ν ρ σ; ring
      · rintro ⟨d1, d2, d3, d4⟩ hd
        have h0011 := hd 0 0 1 1
        have h0101 := hd 0 1 0 1
        have h0110 := hd 0 1 1 0
        have h0000 := hd 0 0 0 0
        have h01 : (0 : Fin 4) ≠ 1 := by decide
        have h10 : (1 : Fin 4) ≠ 0 := by decide
        simp [delta2, delta4, h01, h10] at h0011 h0101 h0110 h0000
        refine Prod.ext h0011.symm (Prod.ext h0101.symm (Prod.ext h0110.symm (by linarith)))
    have hH := hadamardSO4_orth_and_det
    have hbreak : rotTensor4 hadamardSO4 delta4 0 0 0 0 ≠ delta4 0 0 0 0 := by
      have hval : rotTensor4 hadamardSO4 delta4 0 0 0 0 = 1 / 4 := by
        dsimp [rotTensor4, delta4, hadamardSO4]
        simp [Fin.sum_univ_four]
        norm_num
      rw [hval]
      simp [delta4]
    exact ⟨horth_pair, hdelta4_H4, hH.1, hH.2.2, hbreak⟩
  have hMom : ∀ (Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ), H4Invariant4 Q →
      let c1 := Q 0 0 1 1
      let c2 := Q 0 1 0 1
      let c3 := Q 0 1 1 0
      let c4 := Q 0 0 0 0 - (c1 + c2 + c3)
      ∀ (a : ℝ) (p : Fin 4 → ℝ),
        (∑ μ : Fin 4, ∑ ν : Fin 4, ∑ ρ : Fin 4, ∑ σ : Fin 4,
          Q μ ν ρ σ * p μ * p ν * p ρ * p σ =
          (c1 + c2 + c3) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 + c4 * ∑ μ : Fin 4, p μ ^ 4) ∧
        (∀ μ ν : Fin 4,
          ∑ ρ : Fin 4, ∑ σ : Fin 4, Q μ ν ρ σ * p ρ * p σ =
            c1 * delta2 μ ν * (∑ ρ : Fin 4, p ρ ^ 2) +
            (c2 + c3) * (p μ * p ν) +
            c4 * delta2 μ ν * p μ ^ 2) ∧
        ((1 / 4 : ℝ) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 ≤ ∑ μ : Fin 4, p μ ^ 4 ∧
          ∑ μ : Fin 4, p μ ^ 4 ≤ (∑ μ : Fin 4, p μ ^ 2) ^ 2) ∧
        |a ^ 2 * (c4 * ∑ μ : Fin 4, p μ ^ 4)| ≤ |c4| * a ^ 2 * (∑ μ : Fin 4, p μ ^ 2) ^ 2 := by
    intro Q hQ c1 c2 c3 c4 a p
    obtain ⟨⟨d1, d2, d3, d4⟩, hdecomp, _⟩ := (hRank4 Q).mp hQ
    have h0011 := hdecomp 0 0 1 1
    have h0101 := hdecomp 0 1 0 1
    have h0110 := hdecomp 0 1 1 0
    have h0000 := hdecomp 0 0 0 0
    have h01 : (0 : Fin 4) ≠ 1 := by decide
    have h10 : (1 : Fin 4) ≠ 0 := by decide
    simp [delta2, delta4, h01, h10] at h0011 h0101 h0110 h0000
    have hd1 : d1 = c1 := h0011.symm
    have hd2 : d2 = c2 := h0101.symm
    have hd3 : d3 = c3 := h0110.symm
    have hd4 : d4 = c4 := by dsimp [c4, c1, c2, c3]; linarith
    have hQeq : ∀ μ ν ρ σ : Fin 4,
        Q μ ν ρ σ =
          c1 * delta2 μ ν * delta2 ρ σ +
          c2 * delta2 μ ρ * delta2 ν σ +
          c3 * delta2 μ σ * delta2 ν ρ +
          c4 * delta4 μ ν ρ σ := by
      intro μ ν ρ σ
      rw [hdecomp μ ν ρ σ, hd1, hd2, hd3, hd4]
    have h2pt : ∀ μ ν : Fin 4,
        ∑ ρ : Fin 4, ∑ σ : Fin 4, Q μ ν ρ σ * p ρ * p σ =
          c1 * delta2 μ ν * (∑ ρ : Fin 4, p ρ ^ 2) +
          (c2 + c3) * (p μ * p ν) +
          c4 * delta2 μ ν * p μ ^ 2 := by
      intro μ ν
      simp_rw [hQeq μ ν]
      have hsplit : (∑ ρ : Fin 4, ∑ σ : Fin 4,
            (c1 * delta2 μ ν * delta2 ρ σ + c2 * delta2 μ ρ * delta2 ν σ +
              c3 * delta2 μ σ * delta2 ν ρ + c4 * delta4 μ ν ρ σ) * p ρ * p σ) =
          (∑ ρ : Fin 4, ∑ σ : Fin 4, c1 * delta2 μ ν * delta2 ρ σ * p ρ * p σ) +
          (∑ ρ : Fin 4, ∑ σ : Fin 4, c2 * delta2 μ ρ * delta2 ν σ * p ρ * p σ) +
          (∑ ρ : Fin 4, ∑ σ : Fin 4, c3 * delta2 μ σ * delta2 ν ρ * p ρ * p σ) +
          (∑ ρ : Fin 4, ∑ σ : Fin 4, c4 * delta4 μ ν ρ σ * p ρ * p σ) := by
        simp_rw [add_mul, Finset.sum_add_distrib]
      rw [hsplit]
      have s1 : (∑ ρ : Fin 4, ∑ σ : Fin 4, c1 * delta2 μ ν * delta2 ρ σ * p ρ * p σ) =
          c1 * delta2 μ ν * (∑ ρ : Fin 4, p ρ ^ 2) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun ρ _ => ?_)
        by_cases hμν : μ = ν
        · simp [delta2, hμν, sq]; ring
        · simp [delta2, hμν]
      have s2 : (∑ ρ : Fin 4, ∑ σ : Fin 4, c2 * delta2 μ ρ * delta2 ν σ * p ρ * p σ) =
          c2 * (p μ * p ν) := by
        simp [delta2, Finset.sum_ite_eq, Finset.mem_univ]
        ring
      have s3 : (∑ ρ : Fin 4, ∑ σ : Fin 4, c3 * delta2 μ σ * delta2 ν ρ * p ρ * p σ) =
          c3 * (p μ * p ν) := by
        simp [delta2, Finset.sum_ite_eq, Finset.mem_univ]
        ring
      have s4 : (∑ ρ : Fin 4, ∑ σ : Fin 4, c4 * delta4 μ ν ρ σ * p ρ * p σ) =
          c4 * delta2 μ ν * p μ ^ 2 := by
        by_cases hμν : μ = ν
        · subst hμν
          have heq : (∑ ρ : Fin 4, ∑ σ : Fin 4, c4 * delta4 μ μ ρ σ * p ρ * p σ) =
              c4 * p μ ^ 2 := by
            have hinner : ∀ ρ : Fin 4,
                (∑ σ : Fin 4, c4 * delta4 μ μ ρ σ * p ρ * p σ) =
                  if μ = ρ then c4 * p μ ^ 2 else 0 := by
              intro ρ
              by_cases hμρ : μ = ρ
              · subst hμρ; simp [delta4, sq]; ring
              · simp [delta4, hμρ]
            simp_rw [hinner]
            simp
          rw [heq]
          simp [delta2]
        · simp [delta2, delta4, hμν]
      rw [s1, s2, s3, s4]
      ring
    have h4pt : (∑ μ : Fin 4, ∑ ν : Fin 4, ∑ ρ : Fin 4, ∑ σ : Fin 4,
          Q μ ν ρ σ * p μ * p ν * p ρ * p σ) =
        (c1 + c2 + c3) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 + c4 * ∑ μ : Fin 4, p μ ^ 4 := by
      have hrew : (∑ μ : Fin 4, ∑ ν : Fin 4, ∑ ρ : Fin 4, ∑ σ : Fin 4,
            Q μ ν ρ σ * p μ * p ν * p ρ * p σ) =
          ∑ μ : Fin 4, ∑ ν : Fin 4,
            (∑ ρ : Fin 4, ∑ σ : Fin 4, Q μ ν ρ σ * p ρ * p σ) * p μ * p ν := by
        refine Finset.sum_congr rfl (fun μ _ => Finset.sum_congr rfl (fun ν _ => ?_))
        rw [Finset.sum_mul, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun ρ _ => ?_)
        rw [Finset.sum_mul, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun σ _ => by ring)
      rw [hrew]
      simp_rw [h2pt]
      simp [Fin.sum_univ_four, delta2]
      ring
    have hp4_bd : (1 / 4 : ℝ) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 ≤ ∑ μ : Fin 4, p μ ^ 4 ∧
        ∑ μ : Fin 4, p μ ^ 4 ≤ (∑ μ : Fin 4, p μ ^ 2) ^ 2 := by
      simp [Fin.sum_univ_four]
      constructor
      · nlinarith [sq_nonneg (p 0 ^ 2 - p 1 ^ 2), sq_nonneg (p 0 ^ 2 - p 2 ^ 2),
          sq_nonneg (p 0 ^ 2 - p 3 ^ 2), sq_nonneg (p 1 ^ 2 - p 2 ^ 2),
          sq_nonneg (p 1 ^ 2 - p 3 ^ 2), sq_nonneg (p 2 ^ 2 - p 3 ^ 2)]
      · nlinarith [sq_nonneg (p 0), sq_nonneg (p 1), sq_nonneg (p 2), sq_nonneg (p 3)]
    have ha_bd : |a ^ 2 * (c4 * ∑ μ : Fin 4, p μ ^ 4)| ≤
        |c4| * a ^ 2 * (∑ μ : Fin 4, p μ ^ 2) ^ 2 := by
      have hp4_nn : 0 ≤ ∑ μ : Fin 4, p μ ^ 4 :=
        Finset.sum_nonneg (fun μ _ => by positivity)
      have h1 : |a ^ 2 * (c4 * ∑ μ : Fin 4, p μ ^ 4)| =
          |c4| * a ^ 2 * ∑ μ : Fin 4, p μ ^ 4 := by
        rw [abs_mul, abs_mul, abs_of_nonneg (sq_nonneg a), abs_of_nonneg hp4_nn]
        ring
      rw [h1]
      exact mul_le_mul_of_nonneg_left hp4_bd.2 (mul_nonneg (abs_nonneg c4) (sq_nonneg a))
    exact ⟨h4pt, h2pt, hp4_bd, ha_bd⟩
  exact ⟨hRank2, hRot2, hRank4, hPairSymm, hSO4Sep, hMom⟩

/-! ## Part 2: UEOT `ViabilityKernel` Bulk-Crossover Persistence & `IR-X` Obstruction Sharpening (`[C/B/S/P/E/X]`) -/

/-- Coarse RG phase regimes bridging `H2a/H2b` (`β < 1`) to `H-UV-1` (`β > 245`), with explicit
`CSX-06`-style escape state `bulkTransitionWall` for Pirogov–Sinai / `SU(N)/Z_N` bulk transitions. `[C/B/E]` -/
inductive RGCrossoverRegime : Type
  | strongCouplingH2ab
  | crossoverStrip
  | uvBalabanBasin
  | bulkTransitionWall
  deriving DecidableEq, Repr

instance : Fintype RGCrossoverRegime where
  elems := {.strongCouplingH2ab, .crossoverStrip, .uvBalabanBasin, .bulkTransitionWall}
  complete r := by cases r <;> decide

local instance instMeasurableSpaceRGCrossoverRegime : MeasurableSpace RGCrossoverRegime := ⊤

local instance instMeasurableSingletonRGCrossoverRegime :
    MeasurableSingletonClass RGCrossoverRegime :=
  ⟨fun _ => trivial⟩

/-- Viability domain of gapped, reflection-positive crossover regimes (excluding `bulkTransitionWall`). `[C/B]` -/
def gappedCrossoverDomain : Set RGCrossoverRegime :=
  {r | r ≠ .bulkTransitionWall}

/-- Two-action RG transition law parameterized by:
- `a = true`: conjectured pure `SU(N)` Wilson RG trajectory (crossing `[β_SC, β_UV]` iff `noBulkTransition : Bool` is `true`, otherwise escaping to `bulkTransitionWall`),
- `a = false`: adjoint-triggered `SU(N)/Z_N` trajectory (hitting `bulkTransitionWall` at intermediate coupling). `[B/S/E/X]` -/
noncomputable def rgCrossoverKernel (noBulkTransition : Bool)
    (r : RGCrossoverRegime) (a : Bool) : PMF RGCrossoverRegime :=
  match r, a with
  | .strongCouplingH2ab, true => PMF.pure .crossoverStrip
  | .strongCouplingH2ab, false => PMF.pure .crossoverStrip
  | .crossoverStrip, true =>
      if noBulkTransition then PMF.pure .uvBalabanBasin else PMF.pure .bulkTransitionWall
  | .crossoverStrip, false => PMF.pure .bulkTransitionWall
  | .uvBalabanBasin, _ => PMF.pure .uvBalabanBasin
  | .bulkTransitionWall, _ => PMF.pure .bulkTransitionWall

lemma rgCrossoverKernel_pure_support {α : Type*} (x : α) :
    (PMF.pure x).support = {x} := by
  ext y
  simp

/-- **UEOT `ViabilityKernel` Crossover Persistence vs. `SU(N)/Z_N` Collapse & Tomboulis–Yaffe
`IR-X` Obstruction Sharpening (`[C/B/S/P/E/O/X]`)**:
1. **Viability Kernel Persistence (`[C/B/X]`)**: Under the `[X]` pure-`SU(N)` no-bulk-transition
   hypothesis (`noBulkTransition = true`), `gappedCrossoverDomain` is an exact fixed point of
   `UEOT.V3.ViabilityKernel.viabilityStep` (`ControlledInvariant`), and by
   `exists_stationary_policy_all_marginals_of_fixed`, a stationary RG policy keeps every marginal
   from `strongCouplingH2ab` (`β < 1`) inside `gappedCrossoverDomain` with probability `1`
