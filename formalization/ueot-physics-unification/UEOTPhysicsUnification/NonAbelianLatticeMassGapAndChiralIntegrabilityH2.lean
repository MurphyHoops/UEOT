      rw [← Fintype.sum_equiv e1 _ (fun x => (∏ i : Fin 1, μ_b (x i)) * h (x 0)) (fun _ => rfl)]
      simp [e1]
    have hent_eq : entProb (piProdWeight (fun _ : Fin 1 => μ_b)) (fun x => (g (x 0)) ^ 2) =
        entProb μ_b (fun q => (g q) ^ 2) := by
      unfold entProb
      rw [hexp_eq (fun q => phiEnt (g q ^ 2)), hexp_eq (fun q => g q ^ 2)]
    have hgl_eq : glauberDirichlet (fun _ : Fin 1 => μ_b) (fun _ _ _ => (1 / 2 : ℝ)) (fun x => g (x 0)) =
        (1 / 2 : ℝ) * edgeDirichlet μ_b w_b g := by
      have he1 : edgeDirichlet μ_b (fun _ _ => (1 / 2 : ℝ)) g = (1 / 4 : ℝ) * (g false - g true) ^ 2 := by
        unfold edgeDirichlet μ_b; simp; ring
      have he2 : edgeDirichlet μ_b w_b g = (1 / 2 : ℝ) * (g false - g true) ^ 2 := by
