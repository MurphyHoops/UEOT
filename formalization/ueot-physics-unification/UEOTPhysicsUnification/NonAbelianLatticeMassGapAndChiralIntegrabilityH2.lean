private lemma sum_fin2_eq {α : Type*} [AddCommMonoid α] (f : Fin 2 → α) :
    (∑ i : Fin 2, f i) = f 0 + f 1 := Fin.sum_univ_two f

private lemma sum_bool_eq {α : Type*} [AddCommMonoid α] (f : Bool → α) :
    (∑ b : Bool, f b) = f false + f true := by
  rw [Fintype.sum_bool, add_comm]

private lemma sum_fin2_bool_eq {α : Type*} [AddCommMonoid α] (f : (Fin 2 → Bool) → α) :
    (∑ x : Fin 2 → Bool, f x) =
      f (fun i => if i = 0 then false else false) +
      f (fun i => if i = 0 then false else true) +
      f (fun i => if i = 0 then true else false) +
      f (fun i => if i = 0 then true else true) := by
  let e : (Bool × Bool) ≃ (Fin 2 → Bool) :=
    { toFun := fun p i => if i = 0 then p.1 else p.2
      invFun := fun x => (x 0, x 1)
      left_inv := fun ⟨a, b⟩ => by ext <;> simp
      right_inv := fun x => by
        ext i; fin_cases i <;> simp }
  rw [← Fintype.sum_equiv e _ f (fun _ => rfl), Fintype.sum_prod_type]
  simp [e]
  abel

/-- **Concrete Non-Vacuous Witness (`[C/B/P]`)**:
