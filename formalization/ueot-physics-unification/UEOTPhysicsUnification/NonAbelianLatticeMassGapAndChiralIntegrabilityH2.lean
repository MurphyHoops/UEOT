  have ha2 : ∀ F : V_blk, 0 ≤ pair_blk (Theta_blk F) F := by
    intro F
    rw [hPair_pullback (Theta_blk F) F, ← hTheta_intertwine F]
    exact hUV_RP (ι_blk F)
  have hb1 : let β_of_K : ℕ → ℝ := fun K => Real.log ((L_blk : ℝ) ^ K / (ell_phys * Lambda)) / c_AF;
      (∀ K : ℕ, (L_blk : ℝ) ^ K * a_lat (β_of_K K) = ell_phys) ∧
      Filter.Tendsto β_of_K Filter.atTop Filter.atTop := by
    intro β_of_K
    have hScale : ∀ K : ℕ, (L_blk : ℝ) ^ K * a_lat (β_of_K K) = ell_phys := by
      intro K
      have harg_pos : 0 < (L_blk : ℝ) ^ K / (ell_phys * Lambda) :=
        div_pos (pow_pos hLblk_pos K) (mul_pos hell hLam)
      have ha_eq : a_lat (β_of_K K) = Real.exp (-c_AF * β_of_K K) / Lambda :=
        (eq_div_iff (ne_of_gt hLam)).mpr (ha_def (β_of_K K))
      have hexp_eq : Real.exp (-c_AF * β_of_K K) = (ell_phys * Lambda) / (L_blk : ℝ) ^ K := by
        dsimp [β_of_K]
        have hmul : -c_AF * (Real.log ((L_blk : ℝ) ^ K / (ell_phys * Lambda)) / c_AF) =
            -Real.log ((L_blk : ℝ) ^ K / (ell_phys * Lambda)) := by
          field_simp [ne_of_gt hcAF]
        rw [hmul, Real.exp_neg, Real.exp_log harg_pos, inv_div]
      rw [ha_eq, hexp_eq]
      field_simp [ne_of_gt (pow_pos hLblk_pos K), ne_of_gt hLam]
    have htend_pow : Filter.Tendsto (fun K : ℕ => (L_blk : ℝ) ^ K) Filter.atTop Filter.atTop :=
      tendsto_pow_atTop_atTop_of_one_lt hLblk_gt_one
    have htend_div : Filter.Tendsto (fun K : ℕ => (L_blk : ℝ) ^ K / (ell_phys * Lambda))
        Filter.atTop Filter.atTop :=
      htend_pow.atTop_div_const (mul_pos hell hLam)
    have htend_log : Filter.Tendsto (fun K : ℕ => Real.log ((L_blk : ℝ) ^ K / (ell_phys * Lambda)))
        Filter.atTop Filter.atTop :=
      Real.tendsto_log_atTop.comp htend_div
    have htend_beta : Filter.Tendsto β_of_K Filter.atTop Filter.atTop := by
      dsimp [β_of_K]
