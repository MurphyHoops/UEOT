    let S_cont : (Fin 4 → ℝ) → ℝ := fun p => ∑ μ : Fin 4, p μ ^ 2
    (∀ Area : ℕ,
      Matrix.trace (T_tw ^ Area) / Matrix.trace (T_0 ^ Area) ≤ Real.exp (-(1 : ℝ) * (Area : ℝ))) ∧
    (0 < spectralRatioGap 2 1 ∧ spectralRatioGap 2 1 = Real.log 2) ∧
