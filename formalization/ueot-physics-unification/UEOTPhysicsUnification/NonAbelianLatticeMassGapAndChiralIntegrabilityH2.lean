/-! ## 1. Nested `ClosureResolution` Scale Chain, `ViabilityKernel` & `CSX-06` Escape Accounting (`[C/B]`) -/

/-- Nested `ClosureResolution` scale chain over configuration/polymer space `V`:
coarser scale `k + 1` admits fewer resolved closed subsets than finer scale `k`,
and each scale carries a closed small-field viability domain `viabilityDomain k`. `[C]` -/
structure NestedScaleResolutionChain (V : Type*) where
  L : ℕ → ClosureSystem V
  nested : ∀ k : ℕ, (L (k + 1)).carrier ⊆ (L k).carrier
  viabilityDomain : ℕ → Set V
  domain_closed : ∀ k : ℕ, viabilityDomain k ∈ (L k).carrier

/-- Nested scale closure iterates satisfy exact coarsening idempotence
`cl_{k+m}(cl_k(S)) = cl_{k+m}(S)` via `ClosureResolution.closure_comp_of_nested`. `[C]` -/
theorem nested_closure_chain_idempotent
    {V : Type*} (chain : NestedScaleResolutionChain V) (k m : ℕ) (S : Set V) :
    UEOT.V3.ClosureResolution.closure (chain.L (k + m))
        (UEOT.V3.ClosureResolution.closure (chain.L k) S) =
      UEOT.V3.ClosureResolution.closure (chain.L (k + m)) S := by
  induction m with
  | zero =>
      simp only [Nat.add_zero]
      exact UEOT.V3.ClosureResolution.closure_eq_of_mem (chain.L k)
        (UEOT.V3.ClosureResolution.closure_mem (chain.L k) S)
  | succ m _ih =>
      have hsub : (chain.L (k + (m + 1))).carrier ⊆ (chain.L k).carrier := by
        have hstep : ∀ d : ℕ, (chain.L (k + d)).carrier ⊆ (chain.L k).carrier := by
          intro d
          induction d with
          | zero => exact Set.Subset.rfl
          | succ d ihd => exact (chain.nested (k + d)).trans ihd
        exact hstep (m + 1)
      exact UEOT.V3.ClosureResolution.closure_comp_of_nested
        (chain.L (k + (m + 1))) (chain.L k) hsub S

/-- Scale-`k` `ViabilityKernel` small-field core coupled with `CSX-06` explicit escape mass:
the conditioned small-field kernel `P_sf` stays inside `K_sf` with probability `1` (`ViabilityKernel`),
while the actual full-measure deployment `μ_full` retains explicit unrenormalized escape mass
`escapeMass = μ_full.toMeasure.real (Set.range embed)ᶜ` on the large-field complement (`CSX-06`). `[C]` -/
structure ViabilityCSX06ScaleStep where
  X_sf : Type
  A_sf : Type
  [fintypeX_sf : Fintype X_sf]
  [fintypeA_sf : Fintype A_sf]
  [nonemptyA_sf : Nonempty A_sf]
  P_sf : X_sf → A_sf → PMF X_sf
  K_sf : Set X_sf
  hfix : viabilityStep P_sf K_sf = K_sf
  X_full : Type
  [fintypeX_full : Fintype X_full]
  [measX_full : MeasurableSpace X_full]
  [singX_full : MeasurableSingletonClass X_full]
  [measOptX_sf : MeasurableSpace (Option X_sf)]
  [singOptX_sf : MeasurableSingletonClass (Option X_sf)]
  embed : X_sf → X_full
  embed_inj : Function.Injective embed
  μ_full : PMF X_full

attribute [instance]
  ViabilityCSX06ScaleStep.fintypeX_sf
  ViabilityCSX06ScaleStep.fintypeA_sf
  ViabilityCSX06ScaleStep.nonemptyA_sf
  ViabilityCSX06ScaleStep.fintypeX_full
  ViabilityCSX06ScaleStep.measX_full
  ViabilityCSX06ScaleStep.singX_full
  ViabilityCSX06ScaleStep.measOptX_sf
  ViabilityCSX06ScaleStep.singOptX_sf

/-- Explicit `CSX-06` large-field escape mass at a single RG scale: mass outside the live
small-field injection `Set.range step.embed` is mapped to `none` without deletion/renormalization. `[C]` -/
noncomputable def ViabilityCSX06ScaleStep.escapeMass (step : ViabilityCSX06ScaleStep) : ℝ :=
  (step.μ_full.toMeasure.map (atomEncode step.embed)).real {none}

/-- `ViabilityKernel` small-field stationary policy retention (`[C]`) paired with `CSX-06` exact
escape-mass identification `escapeMass = μ_full.toMeasure.real (Set.range embed)ᶜ ∈ [0, 1]`. `[C]` -/
theorem viability_csx06_step_retention_and_escape
    (step : ViabilityCSX06ScaleStep) :
    (∃ π : step.X_sf → step.A_sf, ∀ x ∈ step.K_sf, StaysIn (step.P_sf x (π x)) step.K_sf) ∧
      step.escapeMass = step.μ_full.toMeasure.real (Set.range step.embed)ᶜ ∧
      0 ≤ step.escapeMass ∧ step.escapeMass ≤ 1 := by
  have hpol : ∃ π : step.X_sf → step.A_sf,
      ∀ x ∈ step.K_sf, StaysIn (step.P_sf x (π x)) step.K_sf :=
    exists_stationary_policy_of_fixed step.P_sf step.hfix
  have hesc : step.escapeMass = step.μ_full.toMeasure.real (Set.range step.embed)ᶜ := by
    unfold ViabilityCSX06ScaleStep.escapeMass
    exact atomEncode_escape_probability step.embed step.μ_full.toMeasure
  have hnn : 0 ≤ step.escapeMass := by
    rw [hesc]; exact measureReal_nonneg
  have hle1 : step.escapeMass ≤ 1 := by
    rw [hesc]
    exact (measureReal_mono (Set.subset_univ _)).trans_eq (by simp [measureReal_def])
  exact ⟨hpol, hesc, hnn, hle1⟩

/-! ## 2. Summable Cauchy Helper & Decaying Mori–Zwanzig Contraction (`[C/B]`, avoids `DEAD-20261124-09`) -/

/-- Any non-negative sequence `u : ℕ → ℝ` with uniformly bounded partial sums `∑ k < K, u k ≤ B`
has convergent (hence `CauchySeq`) partial sums and finite `Ico` tails. `[B]` -/
theorem bounded_partial_sums_cauchy
    (u : ℕ → ℝ) (hu : ∀ k : ℕ, 0 ≤ u k) (B : ℝ)
    (hB : ∀ K : ℕ, ∑ k ∈ Finset.range K, u k ≤ B) :
    let P : ℕ → ℝ := fun K => ∑ k ∈ Finset.range K, u k
    Monotone P ∧ BddAbove (Set.range P) ∧ CauchySeq P ∧
      Filter.Tendsto P Filter.atTop (nhds (⨆ K : ℕ, P K)) := by
  intro P
  have hmono : Monotone P := by
    intro m n hmn
    dsimp [P]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hmn) (fun k _ _ => hu k)
  have hbdd : BddAbove (Set.range P) := by
    refine ⟨B, ?_⟩
    rintro _ ⟨K, rfl⟩
    exact hB K
  have htend : Filter.Tendsto P Filter.atTop (nhds (⨆ K : ℕ, P K)) :=
    tendsto_atTop_ciSup hmono hbdd
  exact ⟨hmono, hbdd, htend.cauchySeq, htend⟩

/-- Increment-dominated sequence `|S (k + 1) - S k| ≤ u k` with `0 ≤ u k` and bounded partial sums
`∑ k < K, u k ≤ B` is a `CauchySeq` in `ℝ`, converges to a unique limit `S_inf`, and admits an
explicit finite-tail bound `|S n - S m| ≤ ∑ k ∈ Finset.Ico m n, u k`. `[B]` -/
theorem cauchy_of_dominated_increments
    (S u : ℕ → ℝ) (hu : ∀ k : ℕ, 0 ≤ u k) (B : ℝ)
    (hB : ∀ K : ℕ, ∑ k ∈ Finset.range K, u k ≤ B)
    (hinc : ∀ k : ℕ, |S (k + 1) - S k| ≤ u k) :
    CauchySeq S ∧
      (∃ S_inf : ℝ, Filter.Tendsto S Filter.atTop (nhds S_inf)) ∧
      (∀ m n : ℕ, m ≤ n → |S n - S m| ≤ ∑ k ∈ Finset.Ico m n, u k) := by
  have htail : ∀ m n : ℕ, m ≤ n → |S n - S m| ≤ ∑ k ∈ Finset.Ico m n, u k := by
    intro m n hmn
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
    induction d with
    | zero => simp
    | succ d ih =>
        have htri : |S (m + (d + 1)) - S m| ≤
            |S (m + (d + 1)) - S (m + d)| + |S (m + d) - S m| := by
          have hsub : S (m + (d + 1)) - S m =
              (S (m + (d + 1)) - S (m + d)) + (S (m + d) - S m) := by ring
          rw [hsub]
          exact abs_add_le _ _
        have hstep : |S (m + (d + 1)) - S (m + d)| ≤ u (m + d) := by
          simpa [Nat.add_assoc] using hinc (m + d)
        have hsum_split : ∑ k ∈ Finset.Ico m (m + (d + 1)), u k =
            ∑ k ∈ Finset.Ico m (m + d), u k + u (m + d) := by
          rw [← Nat.add_assoc]
          exact Finset.sum_Ico_succ_top (Nat.le_add_right m d) u
        rw [hsum_split]
        linarith [ih (Nat.le_add_right m d)]
  have hP := bounded_partial_sums_cauchy u hu B hB
  have hPcauchy : CauchySeq (fun K : ℕ => ∑ k ∈ Finset.range K, u k) := hP.2.2.1
  have hScauchy : CauchySeq S := by
    rw [Metric.cauchySeq_iff] at hPcauchy ⊢
    intro ε hε
    obtain ⟨N, hN⟩ := hPcauchy ε hε
    refine ⟨N, ?_⟩
    intro m hm n hn
    rcases le_total m n with hmn | hnm
    · have h1 := htail m n hmn
      have hico : ∑ k ∈ Finset.Ico m n, u k =
          (∑ k ∈ Finset.range n, u k) - (∑ k ∈ Finset.range m, u k) := by
        have hsum := Finset.sum_range_add_sum_Ico u hmn
        linarith
      have hdist := hN n hn m hm
      rw [Real.dist_eq] at hdist ⊢
      have hsub_le : (∑ k ∈ Finset.range n, u k) - (∑ k ∈ Finset.range m, u k) ≤
          |(∑ k ∈ Finset.range n, u k) - (∑ k ∈ Finset.range m, u k)| := le_abs_self _
      have hSdist : |S m - S n| = |S n - S m| := abs_sub_comm _ _
      linarith
    · have h1 := htail n m hnm
      have hico : ∑ k ∈ Finset.Ico n m, u k =
          (∑ k ∈ Finset.range m, u k) - (∑ k ∈ Finset.range n, u k) := by
        have hsum := Finset.sum_range_add_sum_Ico u hnm
        linarith
      have hdist := hN m hm n hn
      rw [Real.dist_eq] at hdist ⊢
      have hsub_le : (∑ k ∈ Finset.range m, u k) - (∑ k ∈ Finset.range n, u k) ≤
          |(∑ k ∈ Finset.range m, u k) - (∑ k ∈ Finset.range n, u k)| := le_abs_self _
      linarith
  exact ⟨hScauchy, cauchySeq_tendsto_of_complete hScauchy, htail⟩

/-- **Decaying Mori–Zwanzig Irrelevant-Sector Contraction (`[C/B]`, resolves `O-OPEN-09` constructively)**:
In sharp contrast to `block_spin_rg_obstruction_and_mz_floor` (`DEAD-20261124-09`, constant `ε_MZ > 0`),
if the irrelevant/Mori–Zwanzig step remainder `r_k ≥ 0` satisfies `r (k + 1) ≤ κ_irr * r k + δ k`
with `0 ≤ κ_irr < 1` and summable source defect `∑ k < K, δ k ≤ B_δ`, then:
1. `∑ k < K, r k ≤ (r 0 + B_δ) / (1 - κ_irr)` uniformly in `K`,
2. `r k → 0` as `k → ∞` (zero residual floor!). `[C/B]` -/
theorem decaying_mz_summable_contraction
    {kappa_irr B_delta : ℝ}
    (_hkap_nn : 0 ≤ kappa_irr) (hkap_lt : kappa_irr < 1)
    (r delta : ℕ → ℝ)
    (hr_nn : ∀ k : ℕ, 0 ≤ r k)
    (_hdel_nn : ∀ k : ℕ, 0 ≤ delta k)
    (hB : ∀ K : ℕ, ∑ k ∈ Finset.range K, delta k ≤ B_delta)
    (hrec : ∀ k : ℕ, r (k + 1) ≤ kappa_irr * r k + delta k) :
    (∀ K : ℕ, ∑ k ∈ Finset.range K, r k ≤ (r 0 + B_delta) / (1 - kappa_irr)) ∧
      Filter.Tendsto r Filter.atTop (nhds 0) := by
  have h1mk : 0 < 1 - kappa_irr := sub_pos.mpr hkap_lt
  have hsum_bound : ∀ K : ℕ, ∑ k ∈ Finset.range K, r k ≤ (r 0 + B_delta) / (1 - kappa_irr) := by
    intro K
    have hsum_rec : ∑ k ∈ Finset.range K, r (k + 1) ≤
        kappa_irr * ∑ k ∈ Finset.range K, r k + ∑ k ∈ Finset.range K, delta k := by
      calc
        ∑ k ∈ Finset.range K, r (k + 1)
            ≤ ∑ k ∈ Finset.range K, (kappa_irr * r k + delta k) :=
              Finset.sum_le_sum (fun k _ => hrec k)
        _ = kappa_irr * ∑ k ∈ Finset.range K, r k + ∑ k ∈ Finset.range K, delta k := by
              rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    have hshift : r 0 + ∑ k ∈ Finset.range K, r (k + 1) =
        (∑ k ∈ Finset.range K, r k) + r K := by
      have h1 := Finset.sum_range_succ' r K
      have h2 := Finset.sum_range_succ r K
      linarith
    have hcombined : (1 - kappa_irr) * (∑ k ∈ Finset.range K, r k) ≤ r 0 + B_delta := by
      have hrK : 0 ≤ r K := hr_nn K
      have hBK := hB K
      linarith
    exact (le_div_iff₀ h1mk).mpr (by linarith)
  have hP := bounded_partial_sums_cauchy r hr_nn ((r 0 + B_delta) / (1 - kappa_irr)) hsum_bound
  have hPcauchy : CauchySeq (fun K : ℕ => ∑ k ∈ Finset.range K, r k) := hP.2.2.1
  have htend_zero : Filter.Tendsto r Filter.atTop (nhds 0) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    rw [Metric.cauchySeq_iff] at hPcauchy
    obtain ⟨N, hN⟩ := hPcauchy ε hε
    refine ⟨N, ?_⟩
    intro n hn
    have hdist := hN (n + 1) (by omega) n hn
    have hdiff : (∑ k ∈ Finset.range (n + 1), r k) - (∑ k ∈ Finset.range n, r k) = r n := by
      rw [Finset.sum_range_succ]; ring
    rw [Real.dist_eq] at hdist ⊢
    simpa [hdiff] using hdist
  exact ⟨hsum_bound, htend_zero⟩

private lemma sum_inv_sq_range_le (K : ℕ) :
    ∑ j ∈ Finset.range K, ((1 : ℝ) / ((j : ℝ) + 1) ^ 2) ≤ 2 := by
  cases K with
  | zero => simp
  | succ n =>
    have hrec : ∀ m : ℕ,
        (∑ j ∈ Finset.range (m + 1), ((1 : ℝ) / ((j : ℝ) + 1) ^ 2)) ≤ 2 - 1 / ((m : ℝ) + 1) := by
      intro m
      induction m with
      | zero => simp; norm_num
      | succ m ih =>
        rw [Finset.sum_range_succ]
        have hm_pos : (0 : ℝ) < (m : ℝ) + 1 := by positivity
        have hm1_pos : (0 : ℝ) < (m : ℝ) + 2 := by positivity
        have hdiff : 1 / ((m : ℝ) + 2) ^ 2 ≤ 1 / ((m : ℝ) + 1) - 1 / ((m : ℝ) + 2) := by
          have hid : 1 / ((m : ℝ) + 1) - 1 / ((m : ℝ) + 2) =
              1 / (((m : ℝ) + 1) * ((m : ℝ) + 2)) := by
            field_simp [ne_of_gt hm_pos, ne_of_gt hm1_pos]; ring
          rw [hid]
          refine one_div_le_one_div_of_le (by positivity) ?_
          nlinarith
        have hcast : ((m + 1 : ℕ) : ℝ) + 1 = (m : ℝ) + 2 := by push_cast; ring
        rw [hcast]
        linarith
    have h0 : 0 ≤ (1 : ℝ) / ((n : ℝ) + 1) := by positivity
    linarith [hrec n]

/-- Two-loop irrelevant-sector defect `O(g_j^4)` under the 1-loop asymptotic freedom flow
`runningG2 gK2 b0 L_blk j` is constructively summable with explicit uniform bound `2 / m^2`. `[C/B/P]` -/
theorem two_loop_irrelevant_defect_summable
    {b0 L_blk gK2 : ℝ} (hb0 : 0 < b0) (hL : 1 < L_blk) (hgK : 0 < gK2) :
    let Δ := blockStepDelta b0 L_blk
    let m := min (1 / gK2) Δ
    ∀ K : ℕ, ∑ j ∈ Finset.range K, (runningG2 gK2 b0 L_blk j) ^ 2 ≤ 2 / m ^ 2 := by
  intro Δ m K
  have hlog_pos : 0 < Real.log L_blk := Real.log_pos hL
  have hΔ_pos : 0 < Δ := by dsimp [Δ, blockStepDelta]; positivity
  have hm_pos : 0 < m := lt_min (one_div_pos.mpr hgK) hΔ_pos
  have hpt : ∀ j : ℕ, (runningG2 gK2 b0 L_blk j) ^ 2 ≤ (1 / m ^ 2) * (1 / ((j : ℝ) + 1) ^ 2) := by
    intro j
    have hu_ge : m * ((j : ℝ) + 1) ≤ runningInvG2 gK2 b0 L_blk j := by
      dsimp [runningInvG2]
      have hm1 : m ≤ 1 / gK2 := min_le_left _ _
      have hm2 : m ≤ Δ := min_le_right _ _
      have hj_nn : 0 ≤ (j : ℝ) := Nat.cast_nonneg j
      nlinarith
    have hmj_pos : 0 < m * ((j : ℝ) + 1) := by positivity
    have hinv_le : runningG2 gK2 b0 L_blk j ≤ 1 / (m * ((j : ℝ) + 1)) := by
      dsimp [runningG2]
      rw [← one_div]
      exact one_div_le_one_div_of_le hmj_pos hu_ge
    have hg_nn : 0 ≤ runningG2 gK2 b0 L_blk j :=
      le_of_lt (inv_pos.mpr (lt_of_lt_of_le hmj_pos hu_ge))
    have hsq : (runningG2 gK2 b0 L_blk j) ^ 2 ≤ (1 / (m * ((j : ℝ) + 1))) ^ 2 :=
      pow_le_pow_left₀ hg_nn hinv_le 2
    have hrew : (1 / (m * ((j : ℝ) + 1))) ^ 2 = (1 / m ^ 2) * (1 / ((j : ℝ) + 1) ^ 2) := by
      field_simp [ne_of_gt hm_pos]
    exact hsq.trans_eq hrew
  calc
    ∑ j ∈ Finset.range K, (runningG2 gK2 b0 L_blk j) ^ 2
        ≤ ∑ j ∈ Finset.range K, (1 / m ^ 2) * (1 / ((j : ℝ) + 1) ^ 2) :=
          Finset.sum_le_sum (fun j _ => hpt j)
    _ = (1 / m ^ 2) * ∑ j ∈ Finset.range K, (1 / ((j : ℝ) + 1) ^ 2) := by
          rw [← Finset.mul_sum]
    _ ≤ (1 / m ^ 2) * 2 :=
          mul_le_mul_of_nonneg_left (sum_inv_sq_range_le K) (by positivity)
    _ = 2 / m ^ 2 := by ring

/-! ## 3. Inductive Kotecký–Preiss Domination & `viability_csx06_multiscale_polymer_closure` (`[C/B/P/X]`) -/

/-- Scale-`k` large-field polymer system with shifted Kotecký–Preiss domination.
In addition to standard KP convergence `∑_{Y ~ X} |ρ(Y)| exp(a |Y|) ≤ a |X|`,
recording the Peierls coupling shift `a + c_lf / g_k` over polymer size `size Y ≥ 1`
extracts the explicit scale-`k` suppression factor `exp(-c_lf / g_k)`. `[P/X]` -/
structure ScalePolymerSystem where
  Pol : Type
  [fintypePol : Fintype Pol]
  compat : Pol → Pol → Prop
  [decCompat : DecidableRel compat]
  size : Pol → ℝ
  size_ge_one : ∀ Y : Pol, 1 ≤ size Y
  rho : Pol → ℝ
  a : ℝ
  a_pos : 0 < a
  c_lf : ℝ
  c_lf_nonneg : 0 ≤ c_lf
  g_k : ℝ
  g_k_pos : 0 < g_k
  kp_shifted_dom : ∀ X : Pol,
    (∑ Y : Pol, if compat X Y then |rho Y| * Real.exp ((a + c_lf / g_k) * size Y) else 0) ≤
      a * size X

attribute [instance] ScalePolymerSystem.fintypePol ScalePolymerSystem.decCompat

/-- From shifted Kotecký–Preiss domination (`ScalePolymerSystem.kp_shifted_dom`), extract:
1. Standard Kotecký–Preiss domination `∑_{Y ~ X} |ρ(Y)| exp(a |Y|) ≤ a |X|`,
2. Exponentially suppressed scale-`k` weighted sum `∑_{Y ~ X} |ρ(Y)| exp(a |Y|) ≤ (a |X|) exp(-c_lf / g_k)`,
3. Unweighted overlapping polymer activity sum `∑_{Y ~ X} |ρ(Y)| ≤ (a |X|) exp(-c_lf / g_k)`. `[B]` -/
theorem kp_peierls_scale_extraction (P : ScalePolymerSystem) (X : P.Pol) :
    (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0) ≤
      P.a * P.size X ∧
    (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0) ≤
      (P.a * P.size X) * Real.exp (-(P.c_lf / P.g_k)) ∧
    (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| else 0) ≤
      (P.a * P.size X) * Real.exp (-(P.c_lf / P.g_k)) := by
  have hc_nn : 0 ≤ P.c_lf / P.g_k := div_nonneg P.c_lf_nonneg (le_of_lt P.g_k_pos)
  have hexp_pos : 0 < Real.exp (P.c_lf / P.g_k) := Real.exp_pos _
  have hmul_le : Real.exp (P.c_lf / P.g_k) *
      (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0) ≤
      P.a * P.size X := by
    rw [Finset.mul_sum]
    have hpt : ∀ Y : P.Pol,
        Real.exp (P.c_lf / P.g_k) *
            (if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0) ≤
          if P.compat X Y then |P.rho Y| * Real.exp ((P.a + P.c_lf / P.g_k) * P.size Y) else 0 := by
      intro Y
      by_cases hxy : P.compat X Y
      · simp only [if_pos hxy]
        have hsize : 1 ≤ P.size Y := P.size_ge_one Y
        have harg : P.a * P.size Y + P.c_lf / P.g_k ≤ (P.a + P.c_lf / P.g_k) * P.size Y := by
          nlinarith
        have hexp_le : Real.exp (P.a * P.size Y) * Real.exp (P.c_lf / P.g_k) ≤
            Real.exp ((P.a + P.c_lf / P.g_k) * P.size Y) := by
          rw [← Real.exp_add]
          exact Real.exp_le_exp.mpr harg
        calc
          Real.exp (P.c_lf / P.g_k) * (|P.rho Y| * Real.exp (P.a * P.size Y))
              = |P.rho Y| * (Real.exp (P.a * P.size Y) * Real.exp (P.c_lf / P.g_k)) := by ring
          _ ≤ |P.rho Y| * Real.exp ((P.a + P.c_lf / P.g_k) * P.size Y) :=
              mul_le_mul_of_nonneg_left hexp_le (abs_nonneg _)
      · simp [hxy]
    exact (Finset.sum_le_sum (fun Y _ => hpt Y)).trans (P.kp_shifted_dom X)
  have hweighted :
      (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0) ≤
        (P.a * P.size X) * Real.exp (-(P.c_lf / P.g_k)) := by
    have hdiv := div_le_div_of_nonneg_right hmul_le (le_of_lt hexp_pos)
    rw [mul_div_cancel_left₀ _ (ne_of_gt hexp_pos), div_eq_mul_inv, ← Real.exp_neg] at hdiv
    exact hdiv
  have hexp_le_one : Real.exp (-(P.c_lf / P.g_k)) ≤ 1 :=
    Real.exp_le_one_iff.mpr (neg_nonpos.mpr hc_nn)
  have hX_pos : 0 ≤ P.a * P.size X := by
    have := P.size_ge_one X
    nlinarith [P.a_pos]
  have hstd :
      (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0) ≤
        P.a * P.size X := by
    calc
      (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| * Real.exp (P.a * P.size Y) else 0)
          ≤ (P.a * P.size X) * Real.exp (-(P.c_lf / P.g_k)) := hweighted
      _ ≤ (P.a * P.size X) * 1 := mul_le_mul_of_nonneg_left hexp_le_one hX_pos
      _ = P.a * P.size X := mul_one _
  have hunweighted :
      (∑ Y : P.Pol, if P.compat X Y then |P.rho Y| else 0) ≤
        (P.a * P.size X) * Real.exp (-(P.c_lf / P.g_k)) := by
    refine le_trans (Finset.sum_le_sum (fun Y _ => ?_)) hweighted
    by_cases hxy : P.compat X Y
    · simp only [if_pos hxy]
      have harg_nn : 0 ≤ P.a * P.size Y := mul_nonneg (le_of_lt P.a_pos) (le_trans zero_le_one (P.size_ge_one Y))
      have h1 : 1 ≤ Real.exp (P.a * P.size Y) := Real.one_le_exp harg_nn
      simpa using mul_le_mul_of_nonneg_left h1 (abs_nonneg (P.rho Y))
    · simp [hxy]
  exact ⟨hstd, hweighted, hunweighted⟩

/-- **Multiscale `ViabilityKernel` + `CSX-06` Escape-Mass Polymer Closure (`[C/B/P/X]`)**:
Couples:
- `[C]` Nested `ClosureResolution` scale chain `chain`,
- `[C]` Per-scale `ViabilityKernel` small-field core + `CSX-06` explicit escape mass `κ_k`,
- `[P/X]` Per-scale shifted Kotecký–Preiss polymer domination with uniform scale-sum bound `∑_{k < K} exp(-c_k / g_k) ≤ B_unif`,
- `[C/B]` Decaying Mori–Zwanzig irrelevant-sector remainder `r_{k+1} ≤ κ_irr r_k + δ_k` (`∑ δ_k ≤ B_δ`),
- `[B/X]` Escape-mass polymer bound `κ_k ≤ C_esc ∑_{Y ~ X0_k} |ρ_k(Y)|` and Schwinger step drift `|S_{k+1} - S_k| ≤ C_sw (r_k + κ_k)`.

Proves constructively (`[C/B]`):
1. Nested closure resolution idempotence across arbitrary scale separations,
2. Exact small-field `ViabilityKernel` policy retention + `CSX-06` large-field escape mass `κ_k = μ_k.real (Set.range embed_k)ᶜ`,
3. Standard KP domination and `exp(-c_k / g_k)` polymer suppression at every scale,
4. Cumulative escape mass `E_cum K := ∑_{k < K} κ_k` is uniformly bounded and forms a **`CauchySeq`**,
5. Cumulative `CSX-06` path error budget `P_cum K := ∑_{k < K} (r_k + (1 - r_k) κ_k)` is uniformly bounded and forms a **`CauchySeq`**,
6. The Schwinger truncation sequence `S : ℕ → ℝ` forms a **`CauchySeq`**, converges to a **unique** continuum limit `S_inf : ℝ`, and satisfies explicit tail bounds `|S n - S m| ≤ C_sw ∑_{k ∈ [m, n)} (r_k + κ_k)`. -/
theorem viability_csx06_multiscale_polymer_closure
    {V : Type*} (chain : NestedScaleResolutionChain V)
    (step : ℕ → ViabilityCSX06ScaleStep)
    (poly : ℕ → ScalePolymerSystem)
    (X0 : ∀ k : ℕ, (poly k).Pol)
    {a_max S_max B_unif C_esc kappa_irr B_delta C_sw : ℝ}
    (ha_max : ∀ k : ℕ, (poly k).a ≤ a_max)
    (hS_max : ∀ k : ℕ, (poly k).size (X0 k) ≤ S_max)
    (hB_unif : ∀ K : ℕ, ∑ k ∈ Finset.range K, Real.exp (-((poly k).c_lf / (poly k).g_k)) ≤ B_unif)
    (hC_esc : 0 ≤ C_esc)
    (hesc_poly : ∀ k : ℕ, (step k).escapeMass ≤
      C_esc * ∑ Y : (poly k).Pol, if (poly k).compat (X0 k) Y then |(poly k).rho Y| else 0)
    (hkap_nn : 0 ≤ kappa_irr) (hkap_lt : kappa_irr < 1)
    (r delta : ℕ → ℝ)
    (hr_nn : ∀ k : ℕ, 0 ≤ r k) (hr_le1 : ∀ k : ℕ, r k ≤ 1)
    (hdel_nn : ∀ k : ℕ, 0 ≤ delta k)
    (hB_delta : ∀ K : ℕ, ∑ k ∈ Finset.range K, delta k ≤ B_delta)
    (hmz_rec : ∀ k : ℕ, r (k + 1) ≤ kappa_irr * r k + delta k)
    (hC_sw : 0 ≤ C_sw)
    (S : ℕ → ℝ)
    (hS_drift : ∀ k : ℕ, |S (k + 1) - S k| ≤ C_sw * (r k + (step k).escapeMass)) :
    let E_cum : ℕ → ℝ := fun K => ∑ k ∈ Finset.range K, (step k).escapeMass
    let P_cum : ℕ → ℝ := fun K => ∑ k ∈ Finset.range K, (r k + (1 - r k) * (step k).escapeMass)
    (∀ k m : ℕ, ∀ T : Set V,
      UEOT.V3.ClosureResolution.closure (chain.L (k + m))
          (UEOT.V3.ClosureResolution.closure (chain.L k) T) =
        UEOT.V3.ClosureResolution.closure (chain.L (k + m)) T) ∧
    (∀ k : ℕ,
      (∃ π : (step k).X_sf → (step k).A_sf,
        ∀ x ∈ (step k).K_sf, StaysIn ((step k).P_sf x (π x)) (step k).K_sf) ∧
      (step k).escapeMass = (step k).μ_full.toMeasure.real (Set.range (step k).embed)ᶜ) ∧
    (∀ k : ℕ, ∀ X : (poly k).Pol,
      (∑ Y : (poly k).Pol,
        if (poly k).compat X Y then |(poly k).rho Y| * Real.exp ((poly k).a * (poly k).size Y) else 0) ≤
        (poly k).a * (poly k).size X) ∧
    (∀ K : ℕ, E_cum K ≤ C_esc * a_max * S_max * B_unif) ∧
    CauchySeq E_cum ∧
    CauchySeq P_cum ∧
    Filter.Tendsto r Filter.atTop (nhds 0) ∧
    CauchySeq S ∧
    (∃ S_inf : ℝ, Filter.Tendsto S Filter.atTop (nhds S_inf)) ∧
    (∀ m n : ℕ, m ≤ n →
      |S n - S m| ≤ C_sw * ∑ k ∈ Finset.Ico m n, (r k + (step k).escapeMass)) := by
  intro E_cum P_cum
  have ha_max_pos : 0 < a_max := lt_of_lt_of_le (poly 0).a_pos (ha_max 0)
  have hS_max_pos : 0 < S_max := lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one ((poly 0).size_ge_one (X0 0))) (hS_max 0)
  have hstep_info : ∀ k : ℕ,
      (∃ π : (step k).X_sf → (step k).A_sf,
        ∀ x ∈ (step k).K_sf, StaysIn ((step k).P_sf x (π x)) (step k).K_sf) ∧
      (step k).escapeMass = (step k).μ_full.toMeasure.real (Set.range (step k).embed)ᶜ := fun k =>
    ⟨(viability_csx06_step_retention_and_escape (step k)).1,
     (viability_csx06_step_retention_and_escape (step k)).2.1⟩
  have hesc_nn : ∀ k : ℕ, 0 ≤ (step k).escapeMass :=
    fun k => (viability_csx06_step_retention_and_escape (step k)).2.2.1
  have hesc_bound : ∀ k : ℕ,
      (step k).escapeMass ≤ (C_esc * a_max * S_max) * Real.exp (-((poly k).c_lf / (poly k).g_k)) := by
    intro k
    have hkp := (kp_peierls_scale_extraction (poly k) (X0 k)).2.2
    have h1 := (hesc_poly k).trans (mul_le_mul_of_nonneg_left hkp hC_esc)
    have hpoly_a_pos : 0 ≤ (poly k).a := le_of_lt (poly k).a_pos
    have hpoly_S_pos : 0 ≤ (poly k).size (X0 k) := le_trans zero_le_one ((poly k).size_ge_one (X0 k))
    have haS : (poly k).a * (poly k).size (X0 k) ≤ a_max * S_max :=
      mul_le_mul (ha_max k) (hS_max k) hpoly_S_pos (le_of_lt ha_max_pos)
    have hexp_nn : 0 ≤ Real.exp (-((poly k).c_lf / (poly k).g_k)) := le_of_lt (Real.exp_pos _)
    have h2 : C_esc * ((poly k).a * (poly k).size (X0 k) * Real.exp (-((poly k).c_lf / (poly k).g_k))) ≤
        (C_esc * a_max * S_max) * Real.exp (-((poly k).c_lf / (poly k).g_k)) := by
      have := mul_le_mul_of_nonneg_right haS hexp_nn
      calc
        C_esc * ((poly k).a * (poly k).size (X0 k) * Real.exp (-((poly k).c_lf / (poly k).g_k)))
            ≤ C_esc * (a_max * S_max * Real.exp (-((poly k).c_lf / (poly k).g_k))) :=
              mul_le_mul_of_nonneg_left this hC_esc
        _ = (C_esc * a_max * S_max) * Real.exp (-((poly k).c_lf / (poly k).g_k)) := by ring
    exact h1.trans h2
  have hE_bound : ∀ K : ℕ, E_cum K ≤ C_esc * a_max * S_max * B_unif := by
    intro K
    dsimp [E_cum]
    calc
      ∑ k ∈ Finset.range K, (step k).escapeMass
          ≤ ∑ k ∈ Finset.range K, (C_esc * a_max * S_max) * Real.exp (-((poly k).c_lf / (poly k).g_k)) :=
            Finset.sum_le_sum (fun k _ => hesc_bound k)
      _ = (C_esc * a_max * S_max) * ∑ k ∈ Finset.range K, Real.exp (-((poly k).c_lf / (poly k).g_k)) := by
            rw [← Finset.mul_sum]
      _ ≤ (C_esc * a_max * S_max) * B_unif := by
            apply mul_le_mul_of_nonneg_left (hB_unif K)
            exact mul_nonneg (mul_nonneg hC_esc (le_of_lt ha_max_pos)) (le_of_lt hS_max_pos)
      _ = C_esc * a_max * S_max * B_unif := by ring
  have hEcauchy : CauchySeq E_cum :=
    (bounded_partial_sums_cauchy (fun k => (step k).escapeMass) hesc_nn
      (C_esc * a_max * S_max * B_unif) hE_bound).2.2.1
  have hmz := decaying_mz_summable_contraction hkap_nn hkap_lt r delta hr_nn hdel_nn hB_delta hmz_rec
  have hP_nn : ∀ k : ℕ, 0 ≤ r k + (1 - r k) * (step k).escapeMass := by
    intro k
    have h1 : 0 ≤ 1 - r k := sub_nonneg.mpr (hr_le1 k)
    exact add_nonneg (hr_nn k) (mul_nonneg h1 (hesc_nn k))
  have hP_bound : ∀ K : ℕ,
      P_cum K ≤ (r 0 + B_delta) / (1 - kappa_irr) + C_esc * a_max * S_max * B_unif := by
    intro K
    dsimp [P_cum]
    have hterm : ∀ k : ℕ, r k + (1 - r k) * (step k).escapeMass ≤ r k + (step k).escapeMass := by
      intro k
      have h1 : 1 - r k ≤ 1 := sub_le_self 1 (hr_nn k)
      have hm := mul_le_mul_of_nonneg_right h1 (hesc_nn k)
      linarith
    calc
      ∑ k ∈ Finset.range K, (r k + (1 - r k) * (step k).escapeMass)
          ≤ ∑ k ∈ Finset.range K, (r k + (step k).escapeMass) :=
            Finset.sum_le_sum (fun k _ => hterm k)
      _ = (∑ k ∈ Finset.range K, r k) + E_cum K := Finset.sum_add_distrib
      _ ≤ (r 0 + B_delta) / (1 - kappa_irr) + C_esc * a_max * S_max * B_unif :=
            add_le_add (hmz.1 K) (hE_bound K)
  have hPcauchy : CauchySeq P_cum :=
    (bounded_partial_sums_cauchy (fun k => r k + (1 - r k) * (step k).escapeMass) hP_nn
      ((r 0 + B_delta) / (1 - kappa_irr) + C_esc * a_max * S_max * B_unif) hP_bound).2.2.1
  let u_sw : ℕ → ℝ := fun k => C_sw * (r k + (step k).escapeMass)
  have hu_nn : ∀ k : ℕ, 0 ≤ u_sw k := fun k =>
    mul_nonneg hC_sw (add_nonneg (hr_nn k) (hesc_nn k))
  have hBu_sw : ∀ K : ℕ, ∑ k ∈ Finset.range K, u_sw k ≤
      C_sw * ((r 0 + B_delta) / (1 - kappa_irr) + C_esc * a_max * S_max * B_unif) := by
    intro K
    dsimp [u_sw]
    rw [← Finset.mul_sum, Finset.sum_add_distrib]
    exact mul_le_mul_of_nonneg_left (add_le_add (hmz.1 K) (hE_bound K)) hC_sw
  have hScauchy := cauchy_of_dominated_increments S u_sw hu_nn
    (C_sw * ((r 0 + B_delta) / (1 - kappa_irr) + C_esc * a_max * S_max * B_unif)) hBu_sw hS_drift
  have hStail : ∀ m n : ℕ, m ≤ n →
      |S n - S m| ≤ C_sw * ∑ k ∈ Finset.Ico m n, (r k + (step k).escapeMass) := by
    intro m n hmn
    have h := hScauchy.2.2 m n hmn
    dsimp [u_sw] at h
    rwa [← Finset.mul_sum] at h
  exact ⟨fun k m T => nested_closure_chain_idempotent chain k m T,
    hstep_info,
    fun k X => (kp_peierls_scale_extraction (poly k) X).1,
    hE_bound,
    hEcauchy,
    hPcauchy,
    hmz.2,
    hScauchy.1,
    hScauchy.2.1,
    hStail⟩

/-- **Balaban `δ = 1/2` 1-Loop RG Instantiation (`[C/B/P/X]`)**:
Discharges the `B_unif` and `B_delta` scale-sum assumptions of `viability_csx06_multiscale_polymer_closure`
constructively from `multiscale_polymer_kp_threshold_and_scale_sum` (`(24 / (c_lf^4 * m^2)) * 2`)
and `two_loop_irrelevant_defect_summable` (`2 * C_delta / m^2`) under the 1-loop asymptotic freedom
flow `g_k = Real.sqrt (runningG2 gK2 b0 L_blk k)`.
Note: This does NOT commit `DEAD-20261124-10`, because the shifted KP domination `kp_shifted_dom`
and Schwinger step drift `hS_drift` of actual 4D block-spin Yang–Mills remain explicit `[X]` inputs. -/
theorem viability_csx06_one_loop_balaban_instantiation
    {V : Type*} (chain : NestedScaleResolutionChain V)
    (step : ℕ → ViabilityCSX06ScaleStep)
    (poly : ℕ → ScalePolymerSystem)
    (X0 : ∀ k : ℕ, (poly k).Pol)
    {b0 L_blk gK2 c_lf a_max S_max C_esc kappa_irr C_delta C_sw : ℝ}
    (hb0 : 0 < b0) (hL : 1 < L_blk) (hgK : 0 < gK2) (hclf : 0 < c_lf)
    (hpoly_c : ∀ k : ℕ, (poly k).c_lf = c_lf)
    (hpoly_g : ∀ k : ℕ, (poly k).g_k = Real.sqrt (runningG2 gK2 b0 L_blk k))
    (ha_max : ∀ k : ℕ, (poly k).a ≤ a_max)
    (hS_max : ∀ k : ℕ, (poly k).size (X0 k) ≤ S_max)
    (hC_esc : 0 ≤ C_esc)
    (hesc_poly : ∀ k : ℕ, (step k).escapeMass ≤
      C_esc * ∑ Y : (poly k).Pol, if (poly k).compat (X0 k) Y then |(poly k).rho Y| else 0)
    (hkap_nn : 0 ≤ kappa_irr) (hkap_lt : kappa_irr < 1)
    (r delta : ℕ → ℝ)
    (hr_nn : ∀ k : ℕ, 0 ≤ r k) (hr_le1 : ∀ k : ℕ, r k ≤ 1)
    (hdel_nn : ∀ k : ℕ, 0 ≤ delta k)
    (hC_del : 0 ≤ C_delta)
    (hdel_g4 : ∀ k : ℕ, delta k ≤ C_delta * (runningG2 gK2 b0 L_blk k) ^ 2)
    (hmz_rec : ∀ k : ℕ, r (k + 1) ≤ kappa_irr * r k + delta k)
    (hC_sw : 0 ≤ C_sw)
    (S : ℕ → ℝ)
    (hS_drift : ∀ k : ℕ, |S (k + 1) - S k| ≤ C_sw * (r k + (step k).escapeMass)) :
    let m := min (1 / gK2) (blockStepDelta b0 L_blk)
    let B_unif := (24 / (c_lf ^ 4 * m ^ 2)) * 2
    (∀ K : ℕ, (∑ k ∈ Finset.range K, (step k).escapeMass) ≤ C_esc * a_max * S_max * B_unif) ∧
    CauchySeq S ∧
    (∃ S_inf : ℝ, Filter.Tendsto S Filter.atTop (nhds S_inf)) ∧
    Filter.Tendsto r Filter.atTop (nhds 0) := by
  intro m B_unif
  have hlog_pos : 0 < Real.log L_blk := Real.log_pos hL
  have hΔ_pos : 0 < blockStepDelta b0 L_blk := by dsimp [blockStepDelta]; positivity
  have hm_pos : 0 < m := lt_min (one_div_pos.mpr hgK) hΔ_pos
  have hinv_pos : ∀ k : ℕ, 0 < runningInvG2 gK2 b0 L_blk k := by
    intro k; dsimp [runningInvG2]
    have h1 : 0 < 1 / gK2 := one_div_pos.mpr hgK
    have h2 : 0 ≤ (k : ℝ) * blockStepDelta b0 L_blk := mul_nonneg (Nat.cast_nonneg k) (le_of_lt hΔ_pos)
    linarith
  have hkp_sum := (multiscale_polymer_kp_threshold_and_scale_sum
    (K_ent := 2) (mu := 1) (eps := 1) (c_lf := c_lf) (b0 := b0) (L_blk := L_blk) (gK2 := gK2)
    (by norm_num) (by norm_num) (by norm_num) hclf hb0 hL hgK).2.2.2.1
  have hB_unif : ∀ K : ℕ,
      ∑ k ∈ Finset.range K, Real.exp (-((poly k).c_lf / (poly k).g_k)) ≤ B_unif := by
    intro K
    have hrew : ∀ k : ℕ,
        Real.exp (-((poly k).c_lf / (poly k).g_k)) =
          Real.exp (-(c_lf * Real.sqrt (runningInvG2 gK2 b0 L_blk k))) := by
      intro k
      rw [hpoly_c k, hpoly_g k]
      congr 1
      dsimp [runningG2]
      rw [Real.sqrt_inv, div_inv_eq_mul]
    calc
      ∑ k ∈ Finset.range K, Real.exp (-((poly k).c_lf / (poly k).g_k))
          = ∑ k ∈ Finset.range K, Real.exp (-(c_lf * Real.sqrt (runningInvG2 gK2 b0 L_blk k))) :=
            Finset.sum_congr rfl (fun k _ => hrew k)
      _ = ∑ k : Fin K, Real.exp (-(c_lf * Real.sqrt (runningInvG2 gK2 b0 L_blk k.1))) := by
            rw [← Fin.sum_univ_eq_sum_range]
      _ ≤ B_unif := hkp_sum K
  have hB_delta : ∀ K : ℕ, ∑ k ∈ Finset.range K, delta k ≤ C_delta * (2 / m ^ 2) := by
    intro K
    have h2l := two_loop_irrelevant_defect_summable hb0 hL hgK K
    calc
      ∑ k ∈ Finset.range K, delta k
          ≤ ∑ k ∈ Finset.range K, C_delta * (runningG2 gK2 b0 L_blk k) ^ 2 :=
            Finset.sum_le_sum (fun k _ => hdel_g4 k)
      _ = C_delta * ∑ k ∈ Finset.range K, (runningG2 gK2 b0 L_blk k) ^ 2 := by
            rw [← Finset.mul_sum]
      _ ≤ C_delta * (2 / m ^ 2) := mul_le_mul_of_nonneg_left h2l hC_del
  have hmain := viability_csx06_multiscale_polymer_closure chain step poly X0
    ha_max hS_max hB_unif hC_esc hesc_poly hkap_nn hkap_lt r delta hr_nn hr_le1
    hdel_nn hB_delta hmz_rec hC_sw S hS_drift
  exact ⟨hmain.2.2.2.1, hmain.2.2.2.2.2.2.2.1, hmain.2.2.2.2.2.2.2.2.1, hmain.2.2.2.2.2.2.1⟩

/-! ## 4. Canonical GNS Quotient Construction & Sharp Reduction of `H2dUVMultiscaleAndIRPremise` (`[C/B/P/X]`) -/

private lemma symm_dot_comm {N : ℕ} (M : Matrix (Fin N) (Fin N) ℝ)
    (hSymm : Mᵀ = M) (u v : Fin N → ℝ) :
    dotProduct u (M.mulVec v) = dotProduct v (M.mulVec u) := by
  calc
    dotProduct u (M.mulVec v)
      = ∑ i : Fin N, u i * ∑ j : Fin N, M i j * v j := by simp [dotProduct, Matrix.mulVec]
    _ = ∑ i : Fin N, ∑ j : Fin N, u i * (M i j * v j) :=
          Finset.sum_congr rfl (fun i _ => Finset.mul_sum _ _ _)
    _ = ∑ j : Fin N, ∑ i : Fin N, v j * (M j i * u i) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => ?_))
          have hM : M i j = M j i := by
            have := congrFun (congrFun hSymm j) i
            simpa [Matrix.transpose_apply] using this
          rw [hM]; ring
    _ = ∑ j : Fin N, v j * ∑ i : Fin N, M j i * u i :=
          Finset.sum_congr rfl (fun j _ => (Finset.mul_sum _ _ _).symm)
    _ = dotProduct v (M.mulVec u) := by simp [dotProduct, Matrix.mulVec]

private lemma symm_sub_expand {N : ℕ} (M : Matrix (Fin N) (Fin N) ℝ)
    (hSymm : Mᵀ = M) (u v : Fin N → ℝ) :
    dotProduct (u - v) (M.mulVec (u - v)) =
      dotProduct u (M.mulVec u) - 2 * dotProduct u (M.mulVec v) + dotProduct v (M.mulVec v) := by
  have hcomm : dotProduct v (M.mulVec u) = dotProduct u (M.mulVec v) :=
    (symm_dot_comm M hSymm u v).symm
  have h1 : M.mulVec (u - v) = M.mulVec u - M.mulVec v := by
    ext i; simp [Matrix.mulVec_sub]
  rw [h1]
  simp only [dotProduct_sub, sub_dotProduct]
  rw [hcomm]
  ring

/-- Canonical GNS null-space equivalence relation on test vectors `Fin N → ℝ` for any symmetric
positive-semidefinite limit kernel `M_inf`: `u ≈ v ↔ ⟨u - v, M_inf (u - v)⟩ = 0`.
Eliminates `gns_kernel_compat` as an `[X]` assumption! `[C/B]` -/
def gnsNullSetoid {N : ℕ} (M_inf : Matrix (Fin N) (Fin N) ℝ)
    (hSymm : M_infᵀ = M_inf)
    (hPSD : ∀ psi : Fin N → ℝ, 0 ≤ dotProduct psi (M_inf.mulVec psi)) :
    Setoid (Fin N → ℝ) where
  r u v := dotProduct (u - v) (M_inf.mulVec (u - v)) = 0
  iseqv := by
    have hos := os_reflection_positivity_closed_under_weak_limits_and_gns_quotient
      (fun _ _ _ => (0 : ℝ)) (fun _ _ => (0 : ℝ))
      (fun _ _ => le_rfl) (fun _ => tendsto_const_nhds)
      M_inf hSymm hPSD id surjective_id (fun u v h => by subst h; simp)
    have hnull := hos.2.2.1
    refine ⟨?_, ?_, ?_⟩
    · intro u
      simp
    · intro u v huv
      rw [symm_sub_expand M_inf hSymm v u]
      rw [symm_sub_expand M_inf hSymm u v] at huv
      have hcomm := symm_dot_comm M_inf hSymm u v
      linarith
    · intro u v w huv hvw
      have h1 : ∀ phi : Fin N → ℝ, dotProduct phi (M_inf.mulVec (u - v)) = 0 :=
        (hnull (u - v)).mp huv
      have h2 : ∀ phi : Fin N → ℝ, dotProduct phi (M_inf.mulVec (v - w)) = 0 :=
        (hnull (v - w)).mp hvw
      have hlin : M_inf.mulVec (u - w) = M_inf.mulVec (u - v) + M_inf.mulVec (v - w) := by
        have hsplit : u - w = (u - v) + (v - w) := by
          funext i
          simp only [Pi.sub_apply, Pi.add_apply]
          ring
        rw [hsplit, Matrix.mulVec_add]
      rw [hlin, dotProduct_add, h1 (u - w), h2 (u - w), add_zero]

/-- **Reduced UV Analytic Premise (`[P]` + `[X]`)**:
Strictly sharper than Round 03's `H2dUVMultiscaleAndIRPremise` (`10` `[X]` fields):
Replaces `S_inf`, `M_inf`, `q_GNS`, `os_positivity_lattice`, `cauchy_convergence_diagonal`,
`limit_kernel_symm`, `limit_kernel_psd`, and `gns_kernel_compat` with ONLY:
1. `[P]` Finite-lattice transfer reflection positivity `M_n n = (K_n n)ᵀ * (K_n n)` (matching
   `wilson_plaquette_transfer_positivity_and_strong_coupling_area_law`),
2. `[X]` **`UV-X`**: Covariant block-spin Gribov-free Hessian & shifted-KP polymer domination bound
   governing the scale-by-scale RG increment `|M_n (k + 1) i j - M_n k i j| ≤ C_mat (r_k + κ_k)`,
3. `[X]` Orthogonal **`IR-X`** (uniform clustering + Ursell `< 0`) and **`CHIRAL-X`** (`hcob = 0`). -/
structure H2dSharpenedUVAndIRPremise
    {N : ℕ} (V : Type*) {U_adm OrbitSpace : Type*}
    (M_n : ℕ → Matrix (Fin N) (Fin N) ℝ)
    (C_n : ℕ → ℝ → ℝ) (C_inf : ℝ → ℝ)
    (m2_n m4_n : ℕ → ℝ) (m2_inf m4_inf : ℝ)
    (π : U_adm → OrbitSpace) (Φ_anom : U_adm → ℝ) where
  /-- `[P]` Finite-lattice symmetric transfer factorization `M_n n = (K_n n)ᵀ * (K_n n)`
  (automatically supplies both lattice symmetry and OS reflection positivity). -/
  transfer_factor : ℕ → Matrix (Fin N) (Fin N) ℝ
  transfer_eq : ∀ n : ℕ, M_n n = (transfer_factor n)ᵀ * (transfer_factor n)
  /-- `[C/P]` Nested `ClosureResolution` + `ViabilityKernel`/`CSX-06` + polymer scale hierarchy. -/
  chain : NestedScaleResolutionChain V
  step : ℕ → ViabilityCSX06ScaleStep
  poly : ℕ → ScalePolymerSystem
  X0 : ∀ k : ℕ, (poly k).Pol
  a_max : ℝ
  S_max : ℝ
  B_unif : ℝ
  C_esc : ℝ
  ha_max : ∀ k : ℕ, (poly k).a ≤ a_max
  hS_max : ∀ k : ℕ, (poly k).size (X0 k) ≤ S_max
  hB_unif : ∀ K : ℕ, ∑ k ∈ Finset.range K, Real.exp (-((poly k).c_lf / (poly k).g_k)) ≤ B_unif
  hC_esc : 0 ≤ C_esc
  /-- `[X]` (`UV-X` Part 1): Large-field escape mass bounded by shifted-KP polymer weight. -/
  hesc_poly : ∀ k : ℕ, (step k).escapeMass ≤
    C_esc * ∑ Y : (poly k).Pol, if (poly k).compat (X0 k) Y then |(poly k).rho Y| else 0
  /-- `[X]` (`UV-X` Part 2): Small-field block-spin irrelevant/Mori–Zwanzig contraction. -/
  kappa_irr : ℝ
  B_delta : ℝ
  hkap_nn : 0 ≤ kappa_irr
  hkap_lt : kappa_irr < 1
  r : ℕ → ℝ
  delta : ℕ → ℝ
  hr_nn : ∀ k : ℕ, 0 ≤ r k
  hr_le1 : ∀ k : ℕ, r k ≤ 1
  hdel_nn : ∀ k : ℕ, 0 ≤ delta k
  hB_delta : ∀ K : ℕ, ∑ k ∈ Finset.range K, delta k ≤ B_delta
  hmz_rec : ∀ k : ℕ, r (k + 1) ≤ kappa_irr * r k + delta k
  /-- `[X]` (`UV-X` Part 3): Covariant block-spin RG increment dominated by `r_k + κ_k`. -/
  C_mat : ℝ
  hC_mat : 0 ≤ C_mat
  matrix_drift : ∀ k : ℕ, ∀ i j : Fin N,
    |M_n (k + 1) i j - M_n k i j| ≤ C_mat * (r k + (step k).escapeMass)
  /-- `[X]` (`IR-X`): Uniform physical clustering and non-Gaussian 4-point Ursell bound. -/
  Delta_phys : ℝ
  A_cluster : ℝ
  Delta_phys_pos : 0 < Delta_phys
  A_cluster_nonneg : 0 ≤ A_cluster
  uniform_clustering : ∀ n : ℕ, ∀ dist : ℝ, 0 ≤ dist →
    |C_n n dist| ≤ A_cluster * Real.exp (-Delta_phys * dist)
  cluster_tendsto : ∀ dist : ℝ,
    Filter.Tendsto (fun n : ℕ => C_n n dist) Filter.atTop (nhds (C_inf dist))
  c0_ursell : ℝ
  c0_pos : 0 < c0_ursell
  m2_tendsto : Filter.Tendsto m2_n Filter.atTop (nhds m2_inf)
  m4_tendsto : Filter.Tendsto m4_n Filter.atTop (nhds m4_inf)
  uniform_ursell : ∀ n : ℕ, ursell4 (m2_n n) (m4_n n) ≤ -c0_ursell
  /-- `[X]` (`CHIRAL-X`): Global anomaly/holonomy chiral coboundary vanishing. -/
  global_chiral_coboundary_zero : ∀ u u' : U_adm, π u = π u' → Φ_anom u' - Φ_anom u = 0

/-- Constructive entrywise continuum Schwinger matrix `M_inf` extracted from the Cauchy
convergence of `M_n n i j` guaranteed by `viability_csx06_multiscale_polymer_closure`. `[C/B]` -/
noncomputable def H2dSharpenedUVAndIRPremise.limitMatrix
    {N : ℕ} {V : Type*} {U_adm OrbitSpace : Type*}
    {M_n : ℕ → Matrix (Fin N) (Fin N) ℝ}
    {C_n : ℕ → ℝ → ℝ} {C_inf : ℝ → ℝ}
    {m2_n m4_n : ℕ → ℝ} {m2_inf m4_inf : ℝ}
    {π : U_adm → OrbitSpace} {Φ_anom : U_adm → ℝ}
    (hS : H2dSharpenedUVAndIRPremise V M_n C_n C_inf m2_n m4_n m2_inf m4_inf π Φ_anom) :
    Matrix (Fin N) (Fin N) ℝ :=
  Matrix.of (fun i j =>
    Classical.choose
      (viability_csx06_multiscale_polymer_closure
        hS.chain hS.step hS.poly hS.X0
        hS.ha_max hS.hS_max hS.hB_unif hS.hC_esc hS.hesc_poly
        hS.hkap_nn hS.hkap_lt hS.r hS.delta hS.hr_nn hS.hr_le1 hS.hdel_nn hS.hB_delta hS.hmz_rec
        hS.hC_mat (fun k => M_n k i j) (fun k => hS.matrix_drift k i j)).2.2.2.2.2.2.2.2.1)

/-- Entrywise limit and bilinear Schwinger Cauchy convergence derived from `H2dSharpenedUVAndIRPremise`. `[C/B]` -/
theorem H2dSharpenedUVAndIRPremise.limitMatrix_spec
    {N : ℕ} {V : Type*} {U_adm OrbitSpace : Type*}
    {M_n : ℕ → Matrix (Fin N) (Fin N) ℝ}
    {C_n : ℕ → ℝ → ℝ} {C_inf : ℝ → ℝ}
    {m2_n m4_n : ℕ → ℝ} {m2_inf m4_inf : ℝ}
    {π : U_adm → OrbitSpace} {Φ_anom : U_adm → ℝ}
    (hS : H2dSharpenedUVAndIRPremise V M_n C_n C_inf m2_n m4_n m2_inf m4_inf π Φ_anom) :
    (∀ i j : Fin N,
      Filter.Tendsto (fun n : ℕ => M_n n i j) Filter.atTop (nhds (hS.limitMatrix i j))) ∧
    (hS.limitMatrix)ᵀ = hS.limitMatrix ∧
    (∀ psi : Fin N → ℝ, 0 ≤ dotProduct psi (hS.limitMatrix.mulVec psi)) ∧
    (∀ phi psi : Fin N → ℝ,
      Filter.Tendsto (fun n : ℕ => dotProduct phi ((M_n n).mulVec psi))
        Filter.atTop (nhds (dotProduct phi (hS.limitMatrix.mulVec psi)))) ∧
    (∀ psi : Fin N → ℝ, CauchySeq (fun n : ℕ => dotProduct psi ((M_n n).mulVec psi))) := by
  have hentry : ∀ i j : Fin N,
      Filter.Tendsto (fun n : ℕ => M_n n i j) Filter.atTop (nhds (hS.limitMatrix i j)) := by
    intro i j
    dsimp [H2dSharpenedUVAndIRPremise.limitMatrix]
    exact Classical.choose_spec
      (viability_csx06_multiscale_polymer_closure
        hS.chain hS.step hS.poly hS.X0
        hS.ha_max hS.hS_max hS.hB_unif hS.hC_esc hS.hesc_poly
        hS.hkap_nn hS.hkap_lt hS.r hS.delta hS.hr_nn hS.hr_le1 hS.hdel_nn hS.hB_delta hS.hmz_rec
        hS.hC_mat (fun k => M_n k i j) (fun k => hS.matrix_drift k i j)).2.2.2.2.2.2.2.2.1
  have hlat_symm : ∀ n : ℕ, (M_n n)ᵀ = M_n n := by
    intro n
    rw [hS.transfer_eq n, Matrix.transpose_mul, Matrix.transpose_transpose]
  have hsymm : (hS.limitMatrix)ᵀ = hS.limitMatrix := by
    ext i j
    rw [Matrix.transpose_apply]
    have hji : Filter.Tendsto (fun n : ℕ => M_n n j i) Filter.atTop (nhds (hS.limitMatrix j i)) :=
      hentry j i
    have hij : Filter.Tendsto (fun n : ℕ => M_n n i j) Filter.atTop (nhds (hS.limitMatrix i j)) :=
      hentry i j
    have heq : (fun n : ℕ => M_n n j i) = (fun n : ℕ => M_n n i j) := by
      funext n
      have := congrFun (congrFun (hlat_symm n) i) j
      simpa [Matrix.transpose_apply] using this
    rw [heq] at hji
    exact tendsto_nhds_unique hji hij
