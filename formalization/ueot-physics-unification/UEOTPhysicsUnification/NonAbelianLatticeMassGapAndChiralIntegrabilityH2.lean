  Hessian/Gribov-horizon polymer estimate. -/
theorem uv_cauchy_diagonal_from_rescaled_mz_and_af
    {N : ℕ} (S_n : ℕ → (Fin N → ℝ) → (Fin N → ℝ) → ℝ)
    {kappa b0 b1 L_blk g02 C_MZ : ℝ}
    (hkap_nn : 0 ≤ kappa) (hkap_lt : kappa < 1)
    (hb0 : 0 < b0) (hb1 : 0 < b1) (hL : 1 < L_blk) (hg0 : 0 < g02)
    (h2loop : g02 * |b1| < 16 * Real.pi ^ 2 * b0)
    (hCMZ : 0 ≤ C_MZ)
    (r eps : ℕ → ℝ) (hr_nn : ∀ k, 0 ≤ r k) (heps_nn : ∀ k, 0 ≤ eps k)
    (hrec : ∀ k, r (k + 1) ≤ kappa * r k + eps k)
    (heps_af : ∀ k, eps k ≤ C_MZ * (twoLoopRunningG2 g02 b0 b1 L_blk k) ^ 2)
    (hS_step : ∀ psi : Fin N → ℝ, ∃ C_obs : ℝ, 0 ≤ C_obs ∧
      ∀ n : ℕ, |S_n (n + 1) psi psi - S_n n psi psi| ≤
        C_obs * (r n + (twoLoopRunningG2 g02 b0 b1 L_blk n) ^ 2)) :
    ∀ psi : Fin N → ℝ, CauchySeq (fun n : ℕ => S_n n psi psi) := by
  intro psi
  rcases hS_step psi with ⟨C_obs, hCobs_nn, hstep⟩
  have htl := two_loop_asymptotic_freedom_running_bounds hb0 hb1 hL hg0 h2loop
  rcases htl with ⟨_, hbd, _, _, _, _, _, _, ⟨_, _, _, hc_up'_pos⟩, _, hg_up_all, _, hsum_g4⟩
  set g2 := twoLoopRunningG2 g02 b0 b1 L_blk
  set c_upper' := 1 / min (1 / g02) (blockStepDelta b0 L_blk)
  have hg_up := fun k => (hg_up_all k).2
  have heps_inv : ∀ k : ℕ, eps k ≤ (C_MZ * c_upper' ^ 2) / ((k : ℝ) + 1) ^ (2 : ℝ) := by
    intro k
    have hk_up := hg_up k
    have hg_nn : 0 ≤ g2 k := le_of_lt (hbd k).1
    have hsq : (g2 k) ^ 2 ≤ (c_upper' / ((k : ℝ) + 1)) ^ 2 := pow_le_pow_left₀ hg_nn hk_up 2
    have hrpow2 : ((k : ℝ) + 1) ^ (2 : ℝ) = ((k : ℝ) + 1) ^ (2 : ℕ) := by
      norm_cast
    rw [hrpow2]
    have hrew : C_MZ * (c_upper' / ((k : ℝ) + 1)) ^ 2 =
        (C_MZ * c_upper' ^ 2) / ((k : ℝ) + 1) ^ 2 := by
      field_simp [show (k : ℝ) + 1 ≠ 0 by positivity]
    exact le_trans (heps_af k) ((mul_le_mul_of_nonneg_left hsq hCMZ).trans_eq hrew)
  have hmz := (scale_decaying_mz_contraction_to_zero hkap_nn hkap_lt r eps hr_nn heps_nn hrec).2.2.2.2
    (C_MZ * c_upper' ^ 2) 1 2 (by positivity) (by norm_num) (le_refl 2) heps_inv
  have hr_sum_bd : ∀ K : ℕ, ∑ k ∈ Finset.range K, r k ≤
      (r 0 + (C_MZ * c_upper' ^ 2) * 3) / (1 - kappa) := by
    intro K
    have hs := hmz.2.1 K
    have h1k : (1 : ℝ) / (1 : ℝ) ^ (2 : ℝ) + 2 = 3 := by norm_num
    rwa [h1k] at hs
  have hsum_diff : Summable (fun n : ℕ => |S_n (n + 1) psi psi - S_n n psi psi|) := by
    refine summable_of_sum_range_le (fun n => abs_nonneg _) (c := C_obs *
        ((r 0 + (C_MZ * c_upper' ^ 2) * 3) / (1 - kappa) + 2 * c_upper' ^ 2)) ?_
    intro K
    calc ∑ k ∈ Finset.range K, |S_n (k + 1) psi psi - S_n k psi psi|
        ≤ ∑ k ∈ Finset.range K, C_obs * (r k + (g2 k) ^ 2) :=
          Finset.sum_le_sum (fun k _ => hstep k)
      _ = C_obs * (∑ k ∈ Finset.range K, r k + ∑ k ∈ Finset.range K, (g2 k) ^ 2) := by
          rw [← Finset.mul_sum, Finset.sum_add_distrib]
      _ ≤ C_obs * ((r 0 + (C_MZ * c_upper' ^ 2) * 3) / (1 - kappa) + 2 * c_upper' ^ 2) :=
          mul_le_mul_of_nonneg_left (add_le_add (hr_sum_bd K) (hsum_g4 K)) hCobs_nn
  have hpart_cauchy : CauchySeq (fun n : ℕ => ∑ k ∈ Finset.range n, |S_n (k + 1) psi psi - S_n k psi psi|) :=
    hsum_diff.hasSum.tendsto_sum_nat.cauchySeq
  rw [Metric.cauchySeq_iff] at hpart_cauchy ⊢
  intro ε hε
  rcases hpart_cauchy ε hε with ⟨N0, hN0⟩
  refine ⟨N0, ?_⟩
  intro m hm n hn
  have htri_le : ∀ {a b : ℕ}, a ≤ b →
      |S_n b psi psi - S_n a psi psi| ≤
        ∑ k ∈ Finset.range b, |S_n (k + 1) psi psi - S_n k psi psi| -
          ∑ k ∈ Finset.range a, |S_n (k + 1) psi psi - S_n k psi psi| := by
    intro a b hab
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hab
    induction d with
    | zero => simp
    | succ d ih =>
      rw [← Nat.add_assoc, Finset.sum_range_succ]
      have htri := abs_add_le (S_n (a + d + 1) psi psi - S_n (a + d) psi psi)
        (S_n (a + d) psi psi - S_n a psi psi)
      have hrew : S_n (a + d + 1) psi psi - S_n (a + d) psi psi +
          (S_n (a + d) psi psi - S_n a psi psi) = S_n (a + d + 1) psi psi - S_n a psi psi := by ring
      rw [hrew] at htri
      linarith [ih (Nat.le_add_right a d)]
  have hdist_part : ∀ {a b : ℕ}, N0 ≤ a → a ≤ b →
      |S_n b psi psi - S_n a psi psi| < ε := by
    intro a b ha hab
    have h1 := htri_le hab
    have h2 := hN0 b (le_trans ha hab) a ha
    rw [Real.dist_eq] at h2
    have hnonneg : 0 ≤ ∑ k ∈ Finset.range b, |S_n (k + 1) psi psi - S_n k psi psi| -
        ∑ k ∈ Finset.range a, |S_n (k + 1) psi psi - S_n k psi psi| := by
      have hinc : ∑ k ∈ Finset.range a, |S_n (k + 1) psi psi - S_n k psi psi| ≤
          ∑ k ∈ Finset.range b, |S_n (k + 1) psi psi - S_n k psi psi| :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hab)
          (fun _ _ _ => abs_nonneg _)
      linarith
    rw [abs_of_nonneg hnonneg] at h2
    linarith
