/-- 5D Domain-Wall positive-transfer operator `T_5 = K_5ᴴ * K_5` over `ℂ`. `[B/P]` -/
def dwf5DTransferKernel {n : Type*} [Fintype n] [DecidableEq n] (K5 : Matrix n n ℂ) :
    Matrix n n ℂ :=
  K5ᴴ * K5

private lemma complex_dotProduct_star_self_nonneg {n : Type*} [Fintype n] (w : n → ℂ) :
    (dotProduct (star w) w).im = 0 ∧ 0 ≤ (dotProduct (star w) w).re := by
  have hsum : dotProduct (star w) w = (((∑ i : n, ‖w i‖ ^ 2 : ℝ)) : ℂ) := by
    unfold dotProduct
    have hterm : ∀ i : n, (star w) i * w i = (((‖w i‖ ^ 2 : ℝ)) : ℂ) := by
      intro i
      rw [Pi.star_apply, Complex.star_def, Complex.conj_mul', Complex.ofReal_pow]
    simp_rw [hterm]
    push_cast
    rfl
  rw [hsum]
  exact ⟨Complex.ofReal_im _, by rw [Complex.ofReal_re]; exact Finset.sum_nonneg (fun _ _ => sq_nonneg _)⟩

private lemma complex_dotProduct_conjTranspose_mul_self {n : Type*} [Fintype n] [DecidableEq n]
    (A : Matrix n n ℂ) (v : n → ℂ) :
    dotProduct (star v) ((Aᴴ * A).mulVec v) = dotProduct (star (A.mulVec v)) (A.mulVec v) := by
  have hstar : star (A.mulVec v) = star v ᵥ* Aᴴ := Matrix.star_mulVec A v
  calc
    dotProduct (star v) ((Aᴴ * A).mulVec v)
        = dotProduct (star v) (Aᴴ.mulVec (A.mulVec v)) := by rw [Matrix.mulVec_mulVec]
    _ = dotProduct (star v ᵥ* Aᴴ) (A.mulVec v) := Matrix.dotProduct_mulVec (star v) Aᴴ (A.mulVec v)
    _ = dotProduct (star (A.mulVec v)) (A.mulVec v) := by rw [← hstar]

private lemma conjTranspose_pow_eq {n : Type*} [Fintype n] [DecidableEq n]
    (T : Matrix n n ℂ) (hHerm : Tᴴ = T) : ∀ m : ℕ, (T ^ m)ᴴ = T ^ m
  | 0 => by simp
  | m + 1 => by
      rw [pow_succ, Matrix.conjTranspose_mul, conjTranspose_pow_eq T hHerm m, hHerm,
        (Commute.pow_right (Commute.refl T) m).eq, ← pow_succ]

/-- **5D DWF `Kᴴ K` Transfer Reflection Positivity, `Θ`-Antiunitary Complex RP & Kramers (`[B/P]`)**:
1. Any 5D positive-transfer kernel `T_5 = K_5ᴴ * K_5` is Hermitian (`T_5ᴴ = T_5`), and every
   5th-dimension / Euclidean-time power `T_5 ^ m` (`m : ℕ`) remains Hermitian and reflection-positive
   (`im = 0 ∧ 0 ≤ re` for `⟨v, T_5^m v⟩`).
2. Factorized 5D half-space weights `w_5D(u_+, u_-) = ∑ a, c_a A_a(u_+) conj(A_a(θ_H u_-))` (`c_a ≥ 0`)
   satisfy exact `Θ`-reality and OS reflection positivity (`Round04ChiralKramersThetaRP`).
3. Any `2m × 2m` Hermitian 5D fermion kernel `D_5` intertwining `blockEpsilon m` obeys
   `(D_5.det).im = 0 ∧ 0 ≤ (D_5.det).re`. -/
theorem dwf5D_transfer_khk_reflection_positivity
    {n mQuat : ℕ} (K5 : Matrix (Fin n) (Fin n) ℂ) :
    let T5 := dwf5DTransferKernel K5
    (T5ᴴ = T5 ∧
      ∀ (m : ℕ) (v : Fin n → ℂ),
        (T5 ^ m)ᴴ = T5 ^ m ∧
        (dotProduct (star v) ((T5 ^ m).mulVec v)).im = 0 ∧
        0 ≤ (dotProduct (star v) ((T5 ^ m).mulVec v)).re) ∧
    (∀ {HConfig ι : Type*} [Fintype HConfig] [Fintype ι]
      (thetaH : HConfig → HConfig), (∀ u, thetaH (thetaH u) = u) →
      ∀ (c : ι → ℝ), (∀ a, 0 ≤ c a) →
      ∀ (A5 : ι → HConfig → ℂ) (F : HConfig → ℂ),
      let w5 : HConfig × HConfig → ℂ :=
        fun p => ∑ a : ι, (c a : ℂ) * A5 a p.1 * starRingEnd ℂ (A5 a (thetaH p.2))
      (∀ uPlus uMinus : HConfig,
        starRingEnd ℂ (w5 (thetaH uMinus, thetaH uPlus)) = w5 (uPlus, uMinus)) ∧
      (osComplexForm thetaH w5 F).im = 0 ∧
      0 ≤ (osComplexForm thetaH w5 F).re) ∧
    (∀ (D5 : Matrix (Fin mQuat × Fin 2) (Fin mQuat × Fin 2) ℂ),
      D5.IsHermitian →
      blockEpsilon mQuat * D5 = D5.map (starRingEnd ℂ) * blockEpsilon mQuat →
      (D5.det).im = 0 ∧ 0 ≤ (D5.det).re) := by
  intro T5
  have hT5_herm : T5ᴴ = T5 := by
    dsimp [T5, dwf5DTransferKernel]
    rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]
  refine ⟨⟨hT5_herm, ?_⟩, ?_, ?_⟩
  · intro m v
    refine ⟨conjTranspose_pow_eq T5 hT5_herm m, ?_⟩
    rcases Nat.even_or_odd m with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · have hpow : T5 ^ (k + k) = (T5 ^ k)ᴴ * (T5 ^ k) := by
        rw [pow_add, conjTranspose_pow_eq T5 hT5_herm k]
      rw [hpow, complex_dotProduct_conjTranspose_mul_self]
      exact complex_dotProduct_star_self_nonneg _
    · have hpow : T5 ^ (2 * k + 1) = (K5 * T5 ^ k)ᴴ * (K5 * T5 ^ k) := by
        have hsymk : (T5 ^ k)ᴴ = T5 ^ k := conjTranspose_pow_eq T5 hT5_herm k
        have hcomm : T5 * T5 ^ k = T5 ^ k * T5 := (Commute.pow_right (Commute.refl T5) k).eq
        calc
          T5 ^ (2 * k + 1) = T5 ^ k * (T5 ^ k * T5) := by
            rw [two_mul, pow_add, pow_add, pow_one, Matrix.mul_assoc]
          _ = T5 ^ k * (T5 * T5 ^ k) := by rw [← hcomm]
          _ = (T5 ^ k)ᴴ * (K5ᴴ * K5) * T5 ^ k := by
            rw [hsymk, ← Matrix.mul_assoc]; rfl
          _ = (K5 * T5 ^ k)ᴴ * (K5 * T5 ^ k) := by
            rw [Matrix.conjTranspose_mul]
            simp only [Matrix.mul_assoc]
      rw [hpow, complex_dotProduct_conjTranspose_mul_self]
      exact complex_dotProduct_star_self_nonneg _
  · intro HConfig ι _ _ thetaH htheta c hc A5 F w5
    have htr := theta_antiunitary_complex_weight_reflection_positivity.{0, _, _, 0, 0}.2.1
      thetaH htheta c hc A5 F
    exact ⟨htr.1, htr.2.2.1, htr.2.2.2⟩
  · intro D5 hD5_herm hKramers
    have hblk := blockEpsilon_sq_transpose_real mQuat
    have hk := kramers_quaternionic_pairing_and_nonneg_determinant.2.2.1
      (blockEpsilon mQuat) D5 hblk.1 hblk.2.1 hblk.2.2 hKramers
    exact hk.2.2.2 hD5_herm

/-- Left-wall chiral profile `ψ_L(s) = exp(-m_DW * s)` across bulk slice `s : ℕ`. `[B/P]` -/
noncomputable def dwfLeftWallProfile (m_DW : ℝ) (s : ℕ) : ℝ :=
  Real.exp (-m_DW * (s : ℝ))

/-- Right-wall mirror profile `ψ_R(s) = exp(-m_DW * (L_5 - s))` across bulk slice `s ≤ L_5`. `[B/P]` -/
noncomputable def dwfRightWallProfile (m_DW : ℝ) (L5 s : ℕ) : ℝ :=
  Real.exp (-m_DW * ((L5 - s : ℕ) : ℝ))

/-- Leading 5D DWF transfer-matrix left-right overlap `C_DW * exp(-m_DW * L_5)`. `[B/P]` -/
noncomputable def dwfTransferOverlap (C_DW m_DW : ℝ) (L5 : ℕ) : ℝ :=
  C_DW * Real.exp (-m_DW * (L5 : ℝ))

/-- Total 5D slab overlap sum `∑_{s=0}^{L_5} ψ_L(s) ψ_R(s)` across all `L_5 + 1` fifth-dimension slices. `[B/P]` -/
noncomputable def dwfSlabOverlapSum (m_DW : ℝ) (L5 : ℕ) : ℝ :=
  ∑ s : Fin (L5 + 1), dwfLeftWallProfile m_DW s.1 * dwfRightWallProfile m_DW L5 s.1

/-- **5D DWF `L_5 → ∞` Exponential Mirror Suppression & 4D Overlap Gap Stability (`[B/P]`)**:
For any 5D bulk domain-wall mass `m_DW > 0`, prefactor `C_DW > 0`, residual perturbation scale `C_res ≥ 0`,
and 4D Wilson kernel `H_W` with spectral gap `δ_0 > 0`:
1. At every bulk slice `s : Fin (L_5 + 1)`, `ψ_L(s) ψ_R(s) = exp(-m_DW * L_5)`, so
   `dwfSlabOverlapSum m_DW L_5 = (L_5 + 1) * exp(-m_DW * L_5)`.
2. With Shamir transfer eigenvalue `κ := exp(-m_DW) ∈ (0, 1)`,
   `dwfTransferOverlap C_DW m_DW L_5 = C_DW * κ ^ L_5` is positive and strictly decreasing in `L_5`.
3. Both `dwfTransferOverlap C_DW m_DW L_5 → 0` and `dwfSlabOverlapSum m_DW L_5 → 0` as `L_5 → ∞`.
4. For any family of Hermitian finite-`L_5` residual errors `dH_res L_5` bounded by
   `‖dH_res L_5 v‖_2 ≤ dwfTransferOverlap C_res m_DW L_5 * ‖v‖_2`, there exists `L5_crit : ℕ`
   above which `H_W + dH_res L_5` preserves Hermiticity and a strictly positive 4D spectral gap
   `(δ_0 - dwfTransferOverlap C_res m_DW L_5) > 0` (via `luscher_berry_loop_holonomy_and_overlap_gap_stability`). -/
theorem dwf_l5_exponential_mirror_suppression
    {m_DW C_DW C_res δ0 : ℝ}
    (hm : 0 < m_DW) (hCDW : 0 < C_DW) (hCres : 0 ≤ C_res) (hδ0 : 0 < δ0) :
    let κ : ℝ := Real.exp (-m_DW)
    (0 < κ ∧ κ < 1) ∧
    (∀ (L5 : ℕ) (s : Fin (L5 + 1)),
      dwfLeftWallProfile m_DW s.1 * dwfRightWallProfile m_DW L5 s.1 =
        Real.exp (-m_DW * (L5 : ℝ))) ∧
    (∀ L5 : ℕ, dwfSlabOverlapSum m_DW L5 = ((L5 : ℝ) + 1) * Real.exp (-m_DW * (L5 : ℝ))) ∧
    (∀ L5 : ℕ,
      dwfTransferOverlap C_DW m_DW L5 = C_DW * κ ^ L5 ∧
      0 < dwfTransferOverlap C_DW m_DW L5 ∧
      dwfTransferOverlap C_DW m_DW (L5 + 1) < dwfTransferOverlap C_DW m_DW L5) ∧
    Filter.Tendsto (dwfTransferOverlap C_DW m_DW) Filter.atTop (nhds 0) ∧
    Filter.Tendsto (dwfSlabOverlapSum m_DW) Filter.atTop (nhds 0) ∧
    (∀ {n nOv : ℕ} (H_W : Matrix (Fin n) (Fin n) ℂ) (dH_res : ℕ → Matrix (Fin n) (Fin n) ℂ),
      H_Wᴴ = H_W →
      (∀ L5, (dH_res L5)ᴴ = dH_res L5) →
      (∀ v : Fin n → ℂ, δ0 ^ 2 * l2NormSq v ≤ l2NormSq (H_W.mulVec v)) →
      (∀ (L5 : ℕ) (v : Fin n → ℂ),
        l2NormSq ((dH_res L5).mulVec v) ≤
          (dwfTransferOverlap C_res m_DW L5) ^ 2 * l2NormSq v) →
      (a : ℝ) → a ≠ 0 → (γ5 V : Matrix (Fin nOv) (Fin nOv) ℂ) →
      γ5ᴴ = γ5 → γ5 * γ5 = 1 → Vᴴ = V → V * V = 1 →
      ∃ L5_crit : ℕ, ∀ L5 : ℕ, L5_crit ≤ L5 →
        dwfTransferOverlap C_res m_DW L5 < δ0 ∧
        (H_W + dH_res L5)ᴴ = H_W + dH_res L5 ∧
        0 < δ0 - dwfTransferOverlap C_res m_DW L5 ∧
        ∀ v : Fin n → ℂ,
          (δ0 - dwfTransferOverlap C_res m_DW L5) ^ 2 * l2NormSq v ≤
            l2NormSq ((H_W + dH_res L5).mulVec v)) := by
  intro κ
  have hκ_pos : 0 < κ := Real.exp_pos _
  have hκ_lt : κ < 1 := Real.exp_lt_one_iff.mpr (neg_lt_zero.mpr hm)
  have hslice : ∀ (L5 : ℕ) (s : Fin (L5 + 1)),
