    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hinv_tend ?_ ?_
    · exact Filter.Eventually.of_forall (fun L5 => mul_nonneg (by positivity) (le_of_lt (Real.exp_pos _)))
    · filter_upwards [Filter.eventually_ge_atTop 1] with L5 hL1
      exact le_trans (hbound L5) (hbound2 L5 hL1)
  have hstab : ∀ {n nOv : ℕ} (H_W : Matrix (Fin n) (Fin n) ℂ) (dH_res : ℕ → Matrix (Fin n) (Fin n) ℂ),
