        div_le_div_of_nonneg_left (by positivity) (sq_pos_of_pos hmL_pos) hsq_le
      have hrew : 8 * (L5 : ℝ) / (m_DW * (L5 : ℝ)) ^ 2 = (8 / m_DW ^ 2) * (1 / (L5 : ℝ)) := by
        field_simp [ne_of_gt hm, ne_of_gt hL_pos]
