    have hTsymm_pow : (T ^ (L_blk ^ K))ᵀ = T ^ (L_blk ^ K) := transpose_pow_eq' T hT_symm (L_blk ^ K)
    have hTblk_symm : T_blkᵀ = T_blk := by
