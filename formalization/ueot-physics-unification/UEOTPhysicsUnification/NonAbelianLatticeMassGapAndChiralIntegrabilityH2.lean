    have hboch := bochner_bakry_emery_cd_criterion D_su2 H g
    have hrho3 : D_su2.rhoTot = 3 := by norm_num [CompactSliceCurvatureData.rhoTot, D_su2]
    rwa [hrho3] at hboch
  have h3 : ∀ a alpha : ℝ,
