/-! ## Part 1. Formal Algebraic Neuberger `0/0` Signed-Pair & `χ(SU(2)) = 0` Cancellation (`[C/B/P]`) -/

section NeubergerAndEuler

/-- Alternating Betti Euler characteristic `∑ k, (-1)^k * b_k`. `[C/B]` -/
def eulerCharFin {n : ℕ} (b : Fin n → ℤ) : ℤ :=
  ∑ k : Fin n, (-1 : ℤ) ^ k.1 * b k

/-- **Odd-Dimensional Poincaré-Duality Euler Characteristic Cancellation (`[C/B]`)**:
On any compact orientable manifold of odd dimension `d = 2 * m + 1` satisfying Poincaré duality
`b_{d - k} = b_k`, the Euler characteristic vanishes identically (`χ = 0`). -/
theorem eulerChar_vanishes_of_poincare_duality
    (m : ℕ) (b : Fin (2 * m + 2) → ℤ)
    (hpd : ∀ k : Fin (2 * m + 2),
      b ⟨2 * m + 1 - k.1, by omega⟩ = b k) :
    eulerCharFin b = 0 := by
  let rev : Fin (2 * m + 2) ≃ Fin (2 * m + 2) :=
    { toFun := fun k => ⟨2 * m + 1 - k.1, by omega⟩
      invFun := fun k => ⟨2 * m + 1 - k.1, by omega⟩
      left_inv := fun k => by ext; dsimp; omega
      right_inv := fun k => by ext; dsimp; omega }
  have hrev_sum : eulerCharFin b =
      ∑ k : Fin (2 * m + 2), (-1 : ℤ) ^ (2 * m + 1 - k.1) * b (rev k) := by
    unfold eulerCharFin
    exact (Fintype.sum_equiv rev
      (fun k => (-1 : ℤ) ^ (2 * m + 1 - k.1) * b (rev k))
      (fun k => (-1 : ℤ) ^ k.1 * b k)
      (fun _ => rfl)).symm
  have hneg : ∀ k : Fin (2 * m + 2),
      (-1 : ℤ) ^ (2 * m + 1 - k.1) * b (rev k) = -((-1 : ℤ) ^ k.1 * b k) := by
    intro k
    dsimp [rev]
    rw [hpd k]
    have hk_le : k.1 ≤ 2 * m + 1 := by omega
    have hmul_pow : (-1 : ℤ) ^ k.1 * (-1 : ℤ) ^ (2 * m + 1 - k.1) = (-1 : ℤ) ^ (2 * m + 1) := by
      rw [← pow_add, Nat.add_sub_of_le hk_le]
    have hodd : (-1 : ℤ) ^ (2 * m + 1) = -1 := by
      rw [pow_add, pow_mul, pow_one]
      norm_num
    have hpow_cases : ∀ n : ℕ, (-1 : ℤ) ^ n = 1 ∨ (-1 : ℤ) ^ n = -1 := by
      intro n
      induction n with
      | zero => left; rfl
      | succ n ih =>
          rcases ih with h | h
          · right; rw [pow_succ, h]; norm_num
          · left; rw [pow_succ, h]; norm_num
    have hsign : (-1 : ℤ) ^ (2 * m + 1 - k.1) = -((-1 : ℤ) ^ k.1) := by
      rcases hpow_cases k.1 with hk1 | hk1 <;>
        rcases hpow_cases (2 * m + 1 - k.1) with hrk1 | hrk1 <;>
        rw [hk1, hrk1] at hmul_pow ⊢ <;> linarith
    rw [hsign]
    ring
  have hneg_sum : eulerCharFin b = -eulerCharFin b := by
    calc eulerCharFin b
        = ∑ k : Fin (2 * m + 2), (-1 : ℤ) ^ (2 * m + 1 - k.1) * b (rev k) := hrev_sum
      _ = ∑ k : Fin (2 * m + 2), -((-1 : ℤ) ^ k.1 * b k) :=
          Finset.sum_congr rfl (fun k _ => hneg k)
      _ = -eulerCharFin b := by rw [Finset.sum_neg_distrib]; rfl
  omega

/-- Exact Betti numbers of `SU(2) ≅ S^3` and `T^4`, with `χ(SU(2)) = 1 - 0 + 0 - 1 = 0`
and `χ(T^4) = 1 - 4 + 6 - 4 + 1 = 0`. `[C/B]` -/
theorem eulerChar_su2_and_t4_eq_zero :
    let b_su2 : Fin 4 → ℤ := ![1, 0, 0, 1]
    let b_t4 : Fin 5 → ℤ := ![1, 4, 6, 4, 1]
    eulerCharFin b_su2 = (1 : ℤ) - 0 + 0 - 1 ∧
    eulerCharFin b_su2 = 0 ∧
    eulerCharFin b_t4 = (1 : ℤ) - 4 + 6 - 4 + 1 ∧
    eulerCharFin b_t4 = 0 := by
  intro b_su2 b_t4
  have hsu2_expand : eulerCharFin b_su2 = (1 : ℤ) - 0 + 0 - 1 := by
    unfold eulerCharFin
    rw [Fin.sum_univ_four]
    simp [b_su2]
  have hsu2_zero : eulerCharFin b_su2 = 0 := by
    refine eulerChar_vanishes_of_poincare_duality 1 b_su2 (fun k => ?_)
    fin_cases k <;> rfl
  have ht4_expand : eulerCharFin b_t4 = (1 : ℤ) - 4 + 6 - 4 + 1 := by
    unfold eulerCharFin
    rw [Fin.sum_univ_five]
    simp [b_t4]
  have ht4_zero : eulerCharFin b_t4 = 0 := by omega
  exact ⟨hsu2_expand, hsu2_zero, ht4_expand, ht4_zero⟩

/-- Real signum function `sgn(x) ∈ {1, -1, 0}` for Faddeev–Popov Morse index signs. `[C/B]` -/
noncomputable def realSign (x : ℝ) : ℝ :=
  @ite ℝ (0 < x) (Classical.propDecidable _) 1
    (@ite ℝ (x < 0) (Classical.propDecidable _) (-1) 0)

lemma realSign_pos {x : ℝ} (hx : 0 < x) : realSign x = 1 := by
  unfold realSign
  rw [if_pos hx]

lemma realSign_of_neg {x : ℝ} (hx : x < 0) : realSign x = -1 := by
  unfold realSign
  rw [if_neg (not_lt_of_gt hx), if_pos hx]

lemma realSign_zero : realSign 0 = 0 := by
  unfold realSign
  rw [if_neg (lt_irrefl _), if_neg (lt_irrefl _)]

lemma realSign_neg (x : ℝ) : realSign (-x) = -realSign x := by
  rcases lt_trichotomy x 0 with hx | rfl | hx
  · rw [realSign_pos (neg_pos.mpr hx), realSign_of_neg hx]; ring
  · rw [neg_zero, realSign_zero, neg_zero]
  · rw [realSign_of_neg (neg_neg_of_pos hx), realSign_pos hx]

/-- Global BRST signed partition sum `∑_{copies} w_phys c * sgn(det M_FP c)`. `[B/P]` -/
noncomputable def brstSignedPartitionSum {C : Type*} [Fintype C] {N : ℕ}
    (w_phys : C → ℝ) (M_FP : C → Matrix (Fin N) (Fin N) ℝ) : ℝ :=
  ∑ c : C, w_phys c * realSign (M_FP c).det

/-- Global BRST signed observable numerator `∑_{copies} O_phys * (w_phys c * sgn(det M_FP c))`. `[B/P]` -/
noncomputable def brstSignedObservableNum {C : Type*} [Fintype C] {N : ℕ}
    (O_phys : ℝ) (w_phys : C → ℝ) (M_FP : C → Matrix (Fin N) (Fin N) ℝ) : ℝ :=
  ∑ c : C, O_phys * (w_phys c * realSign (M_FP c).det)

/-- Restricted Fundamental Modular Region (FMR) partition sum over `FMR : Finset C`. `[B/P]` -/
noncomputable def fmrPartitionSum {C : Type*} {N : ℕ}
    (FMR : Finset C) (w_phys : C → ℝ) (M_FP : C → Matrix (Fin N) (Fin N) ℝ) : ℝ :=
  ∑ c ∈ FMR, w_phys c * realSign (M_FP c).det

/-- Restricted FMR observable numerator over `FMR : Finset C`. `[B/P]` -/
noncomputable def fmrObservableNum {C : Type*} {N : ℕ}
    (FMR : Finset C) (O_phys : ℝ) (w_phys : C → ℝ) (M_FP : C → Matrix (Fin N) (Fin N) ℝ) : ℝ :=
  ∑ c ∈ FMR, O_phys * (w_phys c * realSign (M_FP c).det)

/-- **Formal Algebraic Neuberger `0/0` Signed-Pair & `χ(SU(2)) = 0` Cancellation Theorem (`[C/B/P]`)**:
Given any finite Gribov-copy space `C` equipped with an involution `ι` (`ι (ι c) = c`) and
an orientation-reversing reflection `R_flip c` (`det (R_flip c) = -1`, `M_FP (ι c) = R_flip c * M_FP c`):
1. `det(M_FP(ι c)) = -det(M_FP(c))` and `sgn(det M_FP(ι c)) = -sgn(det M_FP(c))`;
2. The signed Morse-index sum vanishes identically: `∑ c, sgn(det M_FP(c)) = 0`, and
   `∑ c, det(M_FP(c)) = 0`;
3. For any orbit-invariant physical weight `w_phys (ι c) = w_phys c` and gauge-invariant observable
   `O_phys`, **both** `Z_BRST = 0` and `N_BRST(O_phys) = 0` (exact Neuberger `0/0` indeterminacy),
   aligned with `χ(SU(2) ≅ S^3) = 1 - 0 + 0 - 1 = 0`;
4. Restricting to any nonempty Fundamental Modular Region `FMR` (`det M_FP > 0`, `w_phys > 0` on `FMR`)
   gives `Z_FMR = ∑_{c ∈ FMR} w_phys c > 0` (`Z_FMR ≠ 0`) and exact expectation
   `N_FMR(O_phys) / Z_FMR = O_phys`! -/
theorem neuberger_signed_pair_gribov_cancellation
    {C : Type*} [Fintype C] {N : ℕ}
    (ι : C → C) (hι_inv : ∀ c : C, ι (ι c) = c)
    (R_flip : C → Matrix (Fin N) (Fin N) ℝ)
    (hR_det : ∀ c : C, (R_flip c).det = -1)
    (M_FP : C → Matrix (Fin N) (Fin N) ℝ)
    (hM_flip : ∀ c : C, M_FP (ι c) = R_flip c * M_FP c)
    (w_phys : C → ℝ) (hw_inv : ∀ c : C, w_phys (ι c) = w_phys c)
    (O_phys : ℝ)
    (FMR : Finset C) (hFMR_ne : FMR.Nonempty)
    (hFMR_det : ∀ c ∈ FMR, 0 < (M_FP c).det)
    (hFMR_w : ∀ c ∈ FMR, 0 < w_phys c) :
    (∀ c : C, (M_FP (ι c)).det = -(M_FP c).det) ∧
    (∀ c : C, realSign (M_FP (ι c)).det = -realSign (M_FP c).det) ∧
    (∑ c : C, realSign (M_FP c).det) = 0 ∧
    (∑ c : C, (M_FP c).det) = 0 ∧
    brstSignedPartitionSum w_phys M_FP = 0 ∧
    brstSignedObservableNum O_phys w_phys M_FP = 0 ∧
    eulerCharFin (![1, 0, 0, 1] : Fin 4 → ℤ) = 0 ∧
    (0 < fmrPartitionSum FMR w_phys M_FP ∧
      fmrPartitionSum FMR w_phys M_FP = ∑ c ∈ FMR, w_phys c ∧
      fmrObservableNum FMR O_phys w_phys M_FP / fmrPartitionSum FMR w_phys M_FP = O_phys) := by
  let e : C ≃ C :=
    { toFun := ι
      invFun := ι
      left_inv := hι_inv
      right_inv := hι_inv }
  have sum_eq_zero_of_anti : ∀ f : C → ℝ, (∀ c : C, f (ι c) = -f c) → (∑ c : C, f c) = 0 := by
    intro f hf
    have h1 : (∑ c : C, f (ι c)) = ∑ c : C, f c :=
      Fintype.sum_equiv e (fun c => f (ι c)) f (fun _ => rfl)
    have h2 : (∑ c : C, f (ι c)) = -(∑ c : C, f c) := by
      calc (∑ c : C, f (ι c)) = ∑ c : C, -f c := Finset.sum_congr rfl (fun c _ => hf c)
        _ = -(∑ c : C, f c) := by rw [Finset.sum_neg_distrib]
    linarith
  have hdet_flip : ∀ c : C, (M_FP (ι c)).det = -(M_FP c).det := by
    intro c
    rw [hM_flip c, Matrix.det_mul, hR_det c]
    ring
  have hsgn_flip : ∀ c : C, realSign (M_FP (ι c)).det = -realSign (M_FP c).det := by
    intro c
    rw [hdet_flip c, realSign_neg]
  have hsgn_sum : (∑ c : C, realSign (M_FP c).det) = 0 :=
    sum_eq_zero_of_anti _ hsgn_flip
  have hdet_sum : (∑ c : C, (M_FP c).det) = 0 :=
    sum_eq_zero_of_anti _ hdet_flip
  have hZ_brst : brstSignedPartitionSum w_phys M_FP = 0 := by
    unfold brstSignedPartitionSum
    refine sum_eq_zero_of_anti _ (fun c => ?_)
    rw [hw_inv c, hsgn_flip c]
    ring
  have hN_brst : brstSignedObservableNum O_phys w_phys M_FP = 0 := by
    unfold brstSignedObservableNum
    rw [← Finset.mul_sum]
    change O_phys * brstSignedPartitionSum w_phys M_FP = 0
    rw [hZ_brst, mul_zero]
  have hfmr_eq : fmrPartitionSum FMR w_phys M_FP = ∑ c ∈ FMR, w_phys c := by
    unfold fmrPartitionSum
    refine Finset.sum_congr rfl (fun c hc => ?_)
    rw [realSign_pos (hFMR_det c hc), mul_one]
  have hfmr_pos : 0 < fmrPartitionSum FMR w_phys M_FP := by
    rw [hfmr_eq]
    exact Finset.sum_pos (fun c hc => hFMR_w c hc) hFMR_ne
  have hfmr_ratio : fmrObservableNum FMR O_phys w_phys M_FP / fmrPartitionSum FMR w_phys M_FP = O_phys := by
    unfold fmrObservableNum
    rw [← Finset.mul_sum]
    change (O_phys * fmrPartitionSum FMR w_phys M_FP) / fmrPartitionSum FMR w_phys M_FP = O_phys
    exact mul_div_cancel_right₀ O_phys (ne_of_gt hfmr_pos)
  exact ⟨hdet_flip, hsgn_flip, hsgn_sum, hdet_sum, hZ_brst, hN_brst,
    eulerChar_su2_and_t4_eq_zero.2.1, ⟨hfmr_pos, hfmr_eq, hfmr_ratio⟩⟩

/-- **Concrete Non-Vacuous Witness for Neuberger `0/0` Signed-Pair Cancellation (`[C/B/P]`)**:
On `C = Bool` with `ι = Bool.not`, `M_FP false = !![2, -1; -1, 2]` (`det = 3 > 0`),
`R_flip = !![0, 1; 1, 0]` (`det = -1`), and `FMR = {false}`:
1. `det M_FP(true) = -3 = -det M_FP(false)`, `sgn(det M_FP false) + sgn(det M_FP true) = 1 + (-1) = 0`;
2. `Z_BRST = 0`, `N_BRST = 0` (`0/0` cancellation), alongside `χ(S^3) = 0` and `χ(T^4) = 0`;
3. `Z_FMR = w0 > 0` and `N_FMR / Z_FMR = O_phys`;
4. Connects directly to `Round05UVHaarBRST.gribov_horizon_crossing_and_sign_flip`. -/
theorem neuberger_zero_over_zero_concrete_witness
    {w0 O_phys : ℝ} (hw0 : 0 < w0) :
    let M0 : Matrix (Fin 2) (Fin 2) ℝ := !![(2 : ℝ), -1; -1, (2 : ℝ)]
    let R_swap : Matrix (Fin 2) (Fin 2) ℝ := !![(0 : ℝ), 1; 1, (0 : ℝ)]
    let M_FP : Bool → Matrix (Fin 2) (Fin 2) ℝ := fun b => if b then R_swap * M0 else M0
    (M_FP false).det = 3 ∧
    (M_FP true).det = -3 ∧
    realSign (M_FP false).det = 1 ∧
    realSign (M_FP true).det = -1 ∧
    (∑ b : Bool, realSign (M_FP b).det) = 0 ∧
    brstSignedPartitionSum (fun _ => w0) M_FP = 0 ∧
    brstSignedObservableNum O_phys (fun _ => w0) M_FP = 0 ∧
    fmrPartitionSum {false} (fun _ => w0) M_FP = w0 ∧
    0 < fmrPartitionSum {false} (fun _ => w0) M_FP ∧
    fmrObservableNum {false} O_phys (fun _ => w0) M_FP /
      fmrPartitionSum {false} (fun _ => w0) M_FP = O_phys ∧
    eulerCharFin (![1, 0, 0, 1] : Fin 4 → ℤ) = 0 ∧
    (∃ s_star ∈ Set.Ioo (0 : ℝ) 1, (((1 - s_star) • M0 + s_star • (R_swap * M0)).det = 0)) := by
  intro M0 R_swap M_FP
  have hR_det : R_swap.det = -1 := by
    simp [R_swap, Matrix.det_fin_two]
  have hR_sq : R_swap * R_swap = 1 := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [R_swap, Matrix.mul_apply, Fin.sum_univ_two]
  have hM_flip : ∀ b : Bool, M_FP (Bool.not b) = R_swap * M_FP b := by
    intro b
    cases b with
    | false => rfl
    | true =>
        simp only [Bool.not_true, M_FP, Bool.false_eq_true, ↓reduceIte, ← Matrix.mul_assoc, hR_sq,
          Matrix.one_mul]
  have hM0_det : M0.det = 3 := by
    simp [M0, Matrix.det_fin_two]
    norm_num
  have hM1_det : (R_swap * M0).det = -3 := by
    rw [Matrix.det_mul, hR_det, hM0_det]
    ring
  have hneub := neuberger_signed_pair_gribov_cancellation
    Bool.not Bool.not_not (fun _ => R_swap) (fun _ => hR_det) M_FP hM_flip
    (fun _ => w0) (fun _ => rfl) O_phys {false} ⟨false, Finset.mem_singleton_self false⟩
    (fun b hb => by
      rw [Finset.mem_singleton] at hb
      subst hb
      change 0 < M0.det
      rw [hM0_det]; norm_num)
    (fun _ _ => hw0)
  have hfmr_eq : fmrPartitionSum {false} (fun _ => w0) M_FP = w0 := by
    rw [hneub.2.2.2.2.2.2.2.2.1, Finset.sum_singleton]
  have hM0_symm : M0ᵀ = M0 := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [M0]
  have hM0_coerc : ∀ x : Fin 2 → ℝ, (1 : ℝ) * dotProduct x x ≤ dotProduct x (M0.mulVec x) := by
    intro x
    simp [M0, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
    nlinarith [sq_nonneg (x 0 - x 1)]
  have hcross := gribov_horizon_crossing_and_sign_flip M0 (R_swap * M0) hM0_symm
    (by norm_num : (0 : ℝ) < 1) hM0_coerc (by rw [hM1_det]; norm_num)
  rcases hcross.2.1 with ⟨s_star, hs_ioo, hs_det0, _⟩
  exact ⟨hM0_det, hM1_det,
    realSign_pos (by rw [show M_FP false = M0 from rfl, hM0_det]; norm_num),
    realSign_of_neg (by rw [show M_FP true = R_swap * M0 from rfl, hM1_det]; norm_num),
    hneub.2.2.1, hneub.2.2.2.2.1, hneub.2.2.2.2.2.1, hfmr_eq,
    hneub.2.2.2.2.2.2.2.1, hneub.2.2.2.2.2.2.2.2.2,
    hneub.2.2.2.2.2.2.1, ⟨s_star, hs_ioo, hs_det0⟩⟩

end NeubergerAndEuler

