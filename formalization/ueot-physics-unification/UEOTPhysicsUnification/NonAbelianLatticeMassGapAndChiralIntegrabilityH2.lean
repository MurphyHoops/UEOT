      rhoHaar_nonneg := by norm_num
      mGfSq_nonneg := le_rfl
      ric_coerc := fun v => by
        rw [Matrix.smul_mulVec, Matrix.one_mulVec, dotProduct_smul]
        exact le_rfl
      hess_coerc := fun _ => by simp }
  have hμb : IsProbWeight μ_b := ⟨fun _ => by norm_num, by simp [μ_b]⟩
  have hw_nn : ∀ (_ : Fin M_vol) (_ _ : Bool), (0 : ℝ) ≤ 1 := fun _ _ _ => by norm_num
  have hrho2 : D_su2_pure.rhoTot = 2 := by norm_num [CompactSliceCurvatureData.rhoTot, D_su2_pure]
  have hsingle_P : ∀ (_ : Fin M_vol) (g : Bool → ℝ),
