    have hle0 : (1 : ℝ) ≤ 0 := le_of_tendsto_of_tendsto htend1 hexp_tend (Filter.Eventually.of_forall hbound)
    linarith

/-! ## Part 2: Fundamental–Adjoint `(β_F, β_A)` Phase Diagram vs. Pure Wilson Crossover (`[C/B/S/P/E/X]`) -/

/-- Coarse RG phase-diagram regimes for the `(β_F, β_A)` fundamental–adjoint plane:
- `strongCouplingAxis`: `β_F < β_SC`, `β_A = 0` (`H2a/H2b` convergent regime),
- `pureWilsonCrossover`: `β_F ∈ [β_SC, β_UV]`, `β_A = 0` (conjectured smooth crossover),
- `subcriticalDetour`: `0 < β_A < β_A^*`, routing around the critical endpoint `(β_F^*, β_A^*)`,
- `uvAsymptoticBasin`: `β_F > β_UV` (`H-UV-1` Balaban weak-coupling basin),
- `bulkTransitionWall`: `β_A ≥ β_A^*` first-order bulk phase transition (`Δe > 0`, `noBulkTransition` false). `[B/S/E]` -/
inductive FundAdjRegime : Type
  | strongCouplingAxis
  | pureWilsonCrossover
  | subcriticalDetour
  | uvAsymptoticBasin
  | bulkTransitionWall
  deriving DecidableEq, Repr

instance : Fintype FundAdjRegime where
  elems := {
    .strongCouplingAxis,
    .pureWilsonCrossover,
    .subcriticalDetour,
    .uvAsymptoticBasin,
    .bulkTransitionWall
  }
  complete r := by cases r <;> decide

local instance instMeasurableSpaceFundAdjRegime : MeasurableSpace FundAdjRegime := ⊤

local instance instMeasurableSingletonFundAdjRegime :
    MeasurableSingletonClass FundAdjRegime :=
  ⟨fun _ => trivial⟩

/-- Action choices in the `(β_F, β_A)` RG phase diagram:
- `pureWilson`: `β_A = 0` (crosses iff `noBulkTransition = true`),
- `subcriticalAdjoint`: `0 < β_A < β_A^*` (detour avoiding the first-order endpoint iff `noBulkTransition = true`),
- `largeAdjoint`: `β_A ≥ β_A^*` (unconditionally strikes the first-order bulk wall `bulkTransitionWall`). `[B/S/E]` -/
inductive FundAdjAction : Type
  | pureWilson
  | subcriticalAdjoint
  | largeAdjoint
  deriving DecidableEq, Repr

instance : Fintype FundAdjAction where
  elems := {.pureWilson, .subcriticalAdjoint, .largeAdjoint}
  complete a := by cases a <;> decide

instance : Nonempty FundAdjAction := ⟨.pureWilson⟩

/-- Viability domain of gapped, reflection-positive `(β_F, β_A)` regimes excluding `bulkTransitionWall`. `[C/B]` -/
def gappedFundAdjDomain : Set FundAdjRegime :=
  {r | r ≠ .bulkTransitionWall}

/-- Full `(β_F, β_A)` RG transition law parameterized by `[X]` `noBulkTransition : Bool`. `[B/S/E/X]` -/
noncomputable def fundAdjKernel (noBulkTransition : Bool)
    (r : FundAdjRegime) (a : FundAdjAction) : PMF FundAdjRegime :=
  match r, a with
  | .strongCouplingAxis, .pureWilson => PMF.pure .pureWilsonCrossover
  | .strongCouplingAxis, .subcriticalAdjoint => PMF.pure .subcriticalDetour
  | .strongCouplingAxis, .largeAdjoint => PMF.pure .bulkTransitionWall
  | .pureWilsonCrossover, .pureWilson =>
      if noBulkTransition then PMF.pure .uvAsymptoticBasin else PMF.pure .bulkTransitionWall
  | .pureWilsonCrossover, .subcriticalAdjoint =>
      if noBulkTransition then PMF.pure .uvAsymptoticBasin else PMF.pure .bulkTransitionWall
  | .pureWilsonCrossover, .largeAdjoint => PMF.pure .bulkTransitionWall
  | .subcriticalDetour, .pureWilson =>
      if noBulkTransition then PMF.pure .uvAsymptoticBasin else PMF.pure .bulkTransitionWall
  | .subcriticalDetour, .subcriticalAdjoint =>
      if noBulkTransition then PMF.pure .uvAsymptoticBasin else PMF.pure .bulkTransitionWall
  | .subcriticalDetour, .largeAdjoint => PMF.pure .bulkTransitionWall
  | .uvAsymptoticBasin, _ => PMF.pure .uvAsymptoticBasin
  | .bulkTransitionWall, _ => PMF.pure .bulkTransitionWall

/-- Restricted RG transition law along the `β_A ≥ β_A^*` large-adjoint sector. `[B/S]` -/
noncomputable def largeAdjointRestrictedKernel
    (r : FundAdjRegime) (_ : Unit) : PMF FundAdjRegime :=
  fundAdjKernel true r .largeAdjoint

/-- **Fundamental–Adjoint `(β_F, β_A)` Bulk Phase Diagram vs. Pure Wilson Crossover (`[C/B/S/P/E/X]`)**:
1. **Large-`β_A` Bulk Collapse (`[C/B/S/P]`)**: Along `β_A ≥ β_A^*` (`largeAdjointRestrictedKernel`),
   even when `noBulkTransition = true` holds on the `β_A = 0` axis, `viabilityStep` deletes
   `pureWilsonCrossover` and `subcriticalDetour` on round 1 and deletes `strongCouplingAxis` on round 2,
   collapsing the stabilized viability kernel to `{.uvAsymptoticBasin}` (`strongCouplingAxis ∉ viabilityIter ... 2`).
   Moreover, any positive latent heat `Δe(β_A) > 0` for `β_A ≥ β_A^*` forces `p_V''(β_c) → +∞` and
   closes any Tomboulis–Yaffe analyticity strip `δ > 0`.
2. **Pure Wilson (`β_A = 0`) & Subcritical (`β_A < β_A^*`) Viability Persistence (`[C/B/S/X]`)**:
   Under `[X]` `noBulkTransition = true`, `gappedFundAdjDomain` is an exact fixed point of
   `viabilityStep (fundAdjKernel true)` (`ControlledInvariant`), admits a stationary RG policy keeping
   all marginals from `strongCouplingAxis` inside `gappedFundAdjDomain` with probability `1`, and reaches
   `uvAsymptoticBasin` in 2 steps via `pureWilson` (`β_A = 0`) as well as via `subcriticalAdjoint`.
3. **Wilson-Axis Failure if `noBulkTransition = false` (`[C/B/S/X]`)**:
   When `noBulkTransition = false`, `fundAdjKernel false` collapses `gappedFundAdjDomain` in 2 steps to
   `{.uvAsymptoticBasin}`, demonstrating that `noBulkTransition` (`[X]`) is sharp and indispensable. -/
theorem fund_adj_phase_diagram_viability_and_crossover :
    (let P_adj := largeAdjointRestrictedKernel;
      viabilityIter P_adj gappedFundAdjDomain 1 = {.uvAsymptoticBasin} ∧
      viabilityIter P_adj gappedFundAdjDomain 2 = {.uvAsymptoticBasin} ∧
      viabilityStep P_adj (viabilityIter P_adj gappedFundAdjDomain 1) =
        viabilityIter P_adj gappedFundAdjDomain 1 ∧
      FundAdjRegime.strongCouplingAxis ∉ viabilityIter P_adj gappedFundAdjDomain 1 ∧
      ∀ {β_A_star β_A c_PS Δe : ℝ} (p_dd : ℕ → ℝ),
        0 < β_A_star → β_A_star ≤ β_A → 0 < c_PS → 0 < Δe →
        (∀ V : ℕ, 1 ≤ V → c_PS * (V : ℝ) * Δe ^ 2 ≤ p_dd V) →
        Filter.Tendsto p_dd Filter.atTop Filter.atTop ∧
        ¬ ∃ (M_TY δ : ℝ), 0 ≤ M_TY ∧ 0 < δ ∧ ∀ V : ℕ, |p_dd V| ≤ 2 * M_TY / δ ^ 2) ∧
    (let P := fundAdjKernel true;
      viabilityStep P gappedFundAdjDomain = gappedFundAdjDomain ∧
      ControlledInvariant P gappedFundAdjDomain ∧
      (∃ π : FundAdjRegime → FundAdjAction, ∀ n : ℕ,
        (stationaryStateLaw P π (PMF.pure .strongCouplingAxis) n).toMeasure
          gappedFundAdjDomain = 1) ∧
      stationaryStateLaw P (fun _ => .pureWilson) (PMF.pure .strongCouplingAxis) 2 =
        PMF.pure .uvAsymptoticBasin ∧
      stationaryStateLaw P (fun _ => .subcriticalAdjoint) (PMF.pure .strongCouplingAxis) 2 =
        PMF.pure .uvAsymptoticBasin) ∧
    (let P_fail := fundAdjKernel false;
      viabilityIter P_fail gappedFundAdjDomain 1 = {.strongCouplingAxis, .uvAsymptoticBasin} ∧
      viabilityIter P_fail gappedFundAdjDomain 2 = {.uvAsymptoticBasin} ∧
      FundAdjRegime.strongCouplingAxis ∉ viabilityIter P_fail gappedFundAdjDomain 2) := by
  refine ⟨?_, ?_, ?_⟩
  · dsimp
    let P_adj := largeAdjointRestrictedKernel
    have h1 : viabilityIter P_adj gappedFundAdjDomain 1 = {.uvAsymptoticBasin} := by
      ext r
      simp only [viabilityIter_succ, viabilityIter_zero, viabilityStep, gappedFundAdjDomain,
        Set.mem_ofPred_eq, Set.mem_singleton_iff]
      cases r with
      | strongCouplingAxis =>
          simp only [ne_eq, not_false_eq_true, reduceCtorEq, iff_false, not_and, not_exists]
          intro _ _
          simp [StaysIn, P_adj, largeAdjointRestrictedKernel, fundAdjKernel]
      | pureWilsonCrossover =>
          simp only [ne_eq, not_false_eq_true, reduceCtorEq, iff_false, not_and, not_exists]
          intro _ _
          simp [StaysIn, P_adj, largeAdjointRestrictedKernel, fundAdjKernel]
      | subcriticalDetour =>
          simp only [ne_eq, not_false_eq_true, reduceCtorEq, iff_false, not_and, not_exists]
          intro _ _
          simp [StaysIn, P_adj, largeAdjointRestrictedKernel, fundAdjKernel]
      | uvAsymptoticBasin =>
          simp only [ne_eq, not_false_eq_true, reduceCtorEq, iff_true, true_and]
          exact ⟨(), by simp [StaysIn, P_adj, largeAdjointRestrictedKernel, fundAdjKernel]⟩
      | bulkTransitionWall =>
          simp
