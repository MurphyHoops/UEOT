/-! ## 1. Kramers Quaternionic Pairing & Nonnegative Determinant (`[C/B/P]`) -/

section KramersQuaternionic

/-- Antiunitary Kramers conjugation map `K_J(v) = J * conj(v)` on `n → ℂ`. `[B/P]` -/
def kramersPartner {n : Type*} [Fintype n] (J : Matrix n n ℂ) (v : n → ℂ) : n → ℂ :=
  J.mulVec (star v)

/-- `2m × 2m` block-quaternionic symplectic charge-conjugation matrix `diag(su2Epsilon, ..., su2Epsilon)`
on `Fin m × Fin 2`. `[B/P]` -/
def blockEpsilon (m : ℕ) : Matrix (Fin m × Fin 2) (Fin m × Fin 2) ℂ :=
  Matrix.of (fun p q => if p.1 = q.1 then su2Epsilon p.2 q.2 else 0)

theorem blockEpsilon_sq_transpose_real (m : ℕ) :
    blockEpsilon m * blockEpsilon m = -1 ∧
      (blockEpsilon m)ᵀ = -blockEpsilon m ∧
      (blockEpsilon m).map (starRingEnd ℂ) = blockEpsilon m := by
  have heps_sq : su2Epsilon * su2Epsilon = -1 :=
    (su2Matrix_unitary_det_and_symplectic_reality 0 0).1
  have heps_tr : su2Epsilonᵀ = -su2Epsilon :=
    (su2Matrix_unitary_det_and_symplectic_reality 0 0).2.1
  refine ⟨?_, ?_, ?_⟩
  · ext ⟨i, a⟩ ⟨j, b⟩
    simp only [blockEpsilon, Matrix.mul_apply, Matrix.of_apply, Matrix.neg_apply, Matrix.one_apply]
    by_cases hij : i = j
    · subst hij
      have hsum : (∑ x : Fin m × Fin 2,
          (if i = x.1 then su2Epsilon a x.2 else 0) *
            (if x.1 = i then su2Epsilon x.2 b else 0)) =
          (su2Epsilon * su2Epsilon) a b := by
        rw [Fintype.sum_prod_type]
        simp [Matrix.mul_apply]
      rw [hsum, heps_sq]
      simp [Matrix.one_apply]
    · have hsum : (∑ x : Fin m × Fin 2,
          (if i = x.1 then su2Epsilon a x.2 else 0) *
            (if x.1 = j then su2Epsilon x.2 b else 0)) = 0 := by
        apply Finset.sum_eq_zero
        intro x _
        by_cases hx : i = x.1
        · subst hx; simp [hij]
        · simp [hx]
      rw [hsum]
      simp [hij]
  · ext ⟨i, a⟩ ⟨j, b⟩
    simp only [blockEpsilon, Matrix.transpose_apply, Matrix.of_apply, Matrix.neg_apply]
    by_cases hij : j = i
    · subst hij
      have h := congrFun (congrFun heps_tr a) b
      simpa using h
    · have hji : i ≠ j := Ne.symm hij
      simp [hij, hji]
  · ext ⟨i, a⟩ ⟨j, b⟩
    simp only [blockEpsilon, Matrix.map_apply, Matrix.of_apply]
    split_ifs with hij
    · fin_cases a <;> fin_cases b <;> simp [su2Epsilon]
    · simp

/-- Exact characterization of `2 × 2` complex matrices intertwining `su2Epsilon`:
`su2Epsilon * D = D.map conj * su2Epsilon ↔ D = su2Matrix (D 0 0) (D 0 1)`. `[B/P]` -/
theorem su2Epsilon_intertwines_iff_su2Matrix (D : Matrix (Fin 2) (Fin 2) ℂ) :
    su2Epsilon * D = D.map (starRingEnd ℂ) * su2Epsilon ↔ D = su2Matrix (D 0 0) (D 0 1) := by
  constructor
  · intro h
    ext i j
    have h00 := congrFun (congrFun h 0) 0
    have h01 := congrFun (congrFun h 0) 1
    simp only [su2Epsilon, Matrix.mul_apply, Matrix.map_apply, Fin.sum_univ_two,
      of_apply, cons_val_zero, cons_val_one] at h00 h01
    fin_cases i <;> fin_cases j
    · simp [su2Matrix]
    · simp [su2Matrix]
    · have hc : D 1 0 = -starRingEnd ℂ (D 0 1) := by linear_combination h00
      simpa [su2Matrix] using hc
    · have hd : D 1 1 = starRingEnd ℂ (D 0 0) := by linear_combination h01
      simpa [su2Matrix] using hd
  · intro hD
    rw [hD]
    exact (su2Matrix_unitary_det_and_symplectic_reality (D 0 0) (D 0 1)).2.2.2.2

/-- For any skew-symmetric `Jᵀ = -J`, every vector `v` is Hermitian-orthogonal to `J * conj(v)`. `[B/P]` -/
theorem kramers_inner_self_zero {n : Type*} [Fintype n]
    {J : Matrix n n ℂ} (hJ_tr : Jᵀ = -J) (v : n → ℂ) :
    dotProduct (star v) (kramersPartner J v) = 0 := by
  unfold kramersPartner
  have h1 : dotProduct (star v) (J.mulVec (star v)) =
      dotProduct (star v) (Jᵀ.mulVec (star v)) := by
    calc
      dotProduct (star v) (J.mulVec (star v))
          = dotProduct (Jᵀ.mulVec (star v)) (star v) := by
            rw [Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]
      _ = dotProduct (star v) (Jᵀ.mulVec (star v)) := dotProduct_comm _ _
  rw [hJ_tr, Matrix.neg_mulVec, dotProduct_neg] at h1
  have h2 : (2 : ℂ) * dotProduct (star v) (J.mulVec (star v)) = 0 := by
    linear_combination h1
  exact (mul_eq_zero.mp h2).resolve_left two_ne_zero

private lemma kramers_dotProduct_star_self_ne_zero {n : Type*} [Fintype n]
    {v : n → ℂ} (hv : v ≠ 0) :
    dotProduct (star v) v ≠ 0 := by
  intro hzero
  have hre := congrArg Complex.re hzero
  have hsum : (dotProduct (star v) v).re = ∑ i : n, ‖v i‖ ^ 2 := by
    simp only [dotProduct, Pi.star_apply, Complex.star_def, Complex.re_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Complex.conj_mul', ← Complex.ofReal_pow, Complex.ofReal_re]
  rw [hsum] at hre
  simp only [Complex.zero_re] at hre
  have hsq : ∀ i ∈ (Finset.univ : Finset n), ‖v i‖ ^ 2 = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => sq_nonneg _)).mp hre
  apply hv
  ext i
  have hi := sq_eq_zero_iff.mp (hsq i (Finset.mem_univ i))
  exact norm_eq_zero.mp hi

private lemma kramers_dotProduct_star_comm {n : Type*} [Fintype n] (x y : n → ℂ) :
    dotProduct (star x) y = star (dotProduct (star y) x) := by
  simp only [dotProduct, Pi.star_apply, star_sum, star_mul, star_star, mul_comm]

/-- `K_J^2 = -I`, `ℂ`-antilinearity, and anti-unitarity `⟨K_J x, K_J y⟩ = ⟨y, x⟩`. `[B/P]` -/
lemma kramersPartner_sq_and_antiunitary {n : Type*} [Fintype n] [DecidableEq n]
    {J : Matrix n n ℂ} (hJ_sq : J * J = -1) (hJ_tr : Jᵀ = -J)
    (hJ_real : J.map (starRingEnd ℂ) = J) :
    (∀ v : n → ℂ, kramersPartner J (kramersPartner J v) = -v) ∧
      (∀ (c : ℂ) (v : n → ℂ), kramersPartner J (c • v) = star c • kramersPartner J v) ∧
      (∀ u v : n → ℂ, kramersPartner J (u + v) = kramersPartner J u + kramersPartner J v) ∧
      (∀ x y : n → ℂ,
        dotProduct (star (kramersPartner J x)) (kramersPartner J y) = dotProduct (star y) x) := by
  have hJ_herm : Jᴴ = -J := by
    ext i j
    have h1 := congrFun (congrFun hJ_real j) i
    have h2 := congrFun (congrFun hJ_tr i) j
    simp only [Matrix.conjTranspose_apply, Matrix.map_apply, Matrix.transpose_apply,
      Matrix.neg_apply, Complex.star_def] at h1 h2 ⊢
    rw [h1]
    exact h2
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro v
    unfold kramersPartner
    have hstar : star (J.mulVec (star v)) = (J.map (starRingEnd ℂ)).mulVec v := by
      ext i
      simp only [Pi.star_apply, Matrix.mulVec, dotProduct, Matrix.map_apply,
        Complex.star_def, map_sum, map_mul, RingHomCompTriple.comp_apply, RingHom.id_apply,
        mul_comm]
    rw [hstar, hJ_real, Matrix.mulVec_mulVec, hJ_sq, Matrix.neg_mulVec, Matrix.one_mulVec]
  · intro c v
    unfold kramersPartner
    have hstar : star (c • v) = star c • star v := by ext i; simp
    rw [hstar, Matrix.mulVec_smul]
  · intro u v
    unfold kramersPartner
    have hstar : star (u + v) = star u + star v := by ext i; simp
    rw [hstar, Matrix.mulVec_add]
  · intro x y
    unfold kramersPartner
    have hstar : star (J.mulVec (star x)) = x ᵥ* Jᴴ := by
      simpa [star_star] using Matrix.star_mulVec J (star x)
    calc
      dotProduct (star (J.mulVec (star x))) (J.mulVec (star y))
          = dotProduct (x ᵥ* Jᴴ) (J.mulVec (star y)) := by rw [hstar]
      _ = dotProduct x (Jᴴ.mulVec (J.mulVec (star y))) := (Matrix.dotProduct_mulVec x Jᴴ _).symm
      _ = dotProduct x ((Jᴴ * J).mulVec (star y)) := by rw [Matrix.mulVec_mulVec]
      _ = dotProduct x (star y) := by rw [hJ_herm, neg_mul, hJ_sq, neg_neg, Matrix.one_mulVec]
      _ = dotProduct (star y) x := dotProduct_comm _ _

/-- Any `K_J`-invariant `ℂ`-submodule `V ≤ (n → ℂ)` has **even** complex dimension (`finrank`). `[B/P]` -/
theorem even_finrank_of_kramers_invariant {n : Type*} [Fintype n] [DecidableEq n]
    {J : Matrix n n ℂ} (hJ_sq : J * J = -1) (hJ_tr : Jᵀ = -J)
    (hJ_real : J.map (starRingEnd ℂ) = J) :
    ∀ (d : ℕ) (V : Submodule ℂ (n → ℂ)),
      Module.finrank ℂ V = d →
      (∀ v ∈ V, kramersPartner J v ∈ V) →
      Even d := by
  obtain ⟨hK_sq, _, _, hK_anti⟩ := kramersPartner_sq_and_antiunitary hJ_sq hJ_tr hJ_real
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
    intro V hd hinv
    by_cases h0 : d = 0
    · subst h0; exact ⟨0, rfl⟩
    · have hpos : 0 < Module.finrank ℂ V := by omega
      have hne_bot : V ≠ ⊥ := by
        intro hbot
        rw [hbot, finrank_bot] at hpos
        omega
      obtain ⟨v, hv_mem, hv_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne_bot
      let w : n → ℂ := kramersPartner J v
      have hw_mem : w ∈ V := hinv v hv_mem
      have hw_ne : w ≠ 0 := by
        intro hw0
        have hsq := hK_sq v
        change kramersPartner J w = -v at hsq
        rw [hw0] at hsq
        have hK0 : kramersPartner J (0 : n → ℂ) = 0 := by
          unfold kramersPartner; simp
        rw [hK0] at hsq
        exact hv_ne (neg_eq_zero.mp hsq.symm)
      have hvw_orth : dotProduct (star v) w = 0 := kramers_inner_self_zero hJ_tr v
      have hwv_orth : dotProduct (star w) v = 0 := by
        rw [kramers_dotProduct_star_comm, hvw_orth, star_zero]
      have hvv_ne : dotProduct (star v) v ≠ 0 := kramers_dotProduct_star_self_ne_zero hv_ne
      have hww_ne : dotProduct (star w) w ≠ 0 := kramers_dotProduct_star_self_ne_zero hw_ne
      let W : Submodule ℂ (n → ℂ) := Submodule.span ℂ ({v, w} : Set (n → ℂ))
      let V' : Submodule ℂ (n → ℂ) :=
        { carrier := {u | u ∈ V ∧ dotProduct (star v) u = 0 ∧ dotProduct (star w) u = 0}
          add_mem' := fun {x y} hx hy =>
            ⟨V.add_mem hx.1 hy.1, by simp [dotProduct_add, hx.2.1, hy.2.1],
              by simp [dotProduct_add, hx.2.2, hy.2.2]⟩
          zero_mem' := ⟨V.zero_mem, by simp, by simp⟩
          smul_mem' := fun c {x} hx =>
            ⟨V.smul_mem c hx.1, by simp [dotProduct_smul, hx.2.1],
              by simp [dotProduct_smul, hx.2.2]⟩ }
      have hV'_inv : ∀ u ∈ V', kramersPartner J u ∈ V' := by
        intro u hu
        refine ⟨hinv u hu.1, ?_, ?_⟩
        · have hv_eq : v = -(kramersPartner J w) := by
            have hsq := hK_sq v
            change kramersPartner J w = -v at hsq
            calc
              v = -(-v) := (neg_neg v).symm
              _ = -(kramersPartner J w) := by rw [← hsq]
          have hstep : dotProduct (star v) (kramersPartner J u) =
              -dotProduct (star (kramersPartner J w)) (kramersPartner J u) := by
            rw [hv_eq, star_neg, neg_dotProduct]
          rw [hstep, hK_anti w u, kramers_dotProduct_star_comm u w, hu.2.2, star_zero, neg_zero]
        · rw [show w = kramersPartner J v from rfl, hK_anti v u,
            kramers_dotProduct_star_comm u v, hu.2.1, star_zero]
      have hW_le : W ≤ V := by
        rw [Submodule.span_le]
        intro x hx
        rcases hx with rfl | rfl
        · exact hv_mem
        · exact hw_mem
      have hV'_le : V' ≤ V := fun _ hu => hu.1
      have hsup : W ⊔ V' = V := by
        apply le_antisymm (sup_le hW_le hV'_le)
        intro u hu
        let a : ℂ := dotProduct (star v) u / dotProduct (star v) v
        let b : ℂ := dotProduct (star w) u / dotProduct (star w) w
        let p : n → ℂ := a • v + b • w
        let r : n → ℂ := u - p
        have hpW : p ∈ W :=
          W.add_mem (W.smul_mem a (Submodule.subset_span (by simp)))
            (W.smul_mem b (Submodule.subset_span (by simp)))
        have hpV : p ∈ V := hW_le hpW
        have hrV : r ∈ V := V.sub_mem hu hpV
        have hrv : dotProduct (star v) r = 0 := by
          dsimp [r, p, a, b]
          simp only [dotProduct_sub, dotProduct_add, dotProduct_smul, smul_eq_mul,
            hvw_orth, mul_zero, add_zero]
          rw [div_mul_cancel₀ _ hvv_ne, sub_self]
        have hrw : dotProduct (star w) r = 0 := by
          dsimp [r, p, a, b]
          simp only [dotProduct_sub, dotProduct_add, dotProduct_smul, smul_eq_mul,
            hwv_orth, mul_zero, zero_add]
          rw [div_mul_cancel₀ _ hww_ne, sub_self]
        have hrV' : r ∈ V' := ⟨hrV, hrv, hrw⟩
        have hu_eq : u = p + r := by dsimp [r]; abel
        rw [hu_eq]
        exact Submodule.mem_sup.mpr ⟨p, hpW, r, hrV', rfl⟩
      have hinf : W ⊓ V' = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        rcases hx with ⟨hxW, hxV'⟩
        rcases Submodule.mem_span_pair.mp hxW with ⟨a, b, rfl⟩
        have hxv : dotProduct (star v) (a • v + b • w) = 0 := hxV'.2.1
        have hxw : dotProduct (star w) (a • v + b • w) = 0 := hxV'.2.2
        simp only [dotProduct_add, dotProduct_smul, smul_eq_mul, hvw_orth, hwv_orth,
          mul_zero, add_zero, zero_add] at hxv hxw
        have ha : a = 0 := (mul_eq_zero.mp hxv).resolve_right hvv_ne
        have hb : b = 0 := (mul_eq_zero.mp hxw).resolve_right hww_ne
        simp [ha, hb]
      have hW_finrank : Module.finrank ℂ W = 2 := by
        let f : Fin 2 → n → ℂ := ![v, w]
        have hli : LinearIndependent ℂ f := by
          rw [Fintype.linearIndependent_iff]
          intro c hc i
          have hcv : dotProduct (star v) (∑ j : Fin 2, c j • f j) = 0 := by
            rw [hc, dotProduct_zero]
          have hcw : dotProduct (star w) (∑ j : Fin 2, c j • f j) = 0 := by
            rw [hc, dotProduct_zero]
          simp only [Fin.sum_univ_two, f, Matrix.cons_val_zero, Matrix.cons_val_one,
            dotProduct_add, dotProduct_smul, smul_eq_mul, hvw_orth, hwv_orth,
            mul_zero, add_zero, zero_add] at hcv hcw
          fin_cases i
          · exact (mul_eq_zero.mp hcv).resolve_right hvv_ne
          · exact (mul_eq_zero.mp hcw).resolve_right hww_ne
        have hspan : W = Submodule.span ℂ (Set.range f) := by
          dsimp [W, f]
          congr 1
          ext x
          simp [or_comm]
        rw [hspan, finrank_span_eq_card hli, Fintype.card_fin]
      have hdim_sum := Submodule.finrank_sup_add_finrank_inf_eq W V'
      rw [hsup, hinf, finrank_bot, add_zero, hW_finrank, hd] at hdim_sum
      have hlt : Module.finrank ℂ V' < d := by omega
      have heven' : Even (Module.finrank ℂ V') := ih (Module.finrank ℂ V') hlt V' rfl hV'_inv
      rw [hdim_sum]
      exact Even.add ⟨1, rfl⟩ heven'

/-- **Kramers Quaternionic Pairing & Non-Negative Determinant Theorem (`[C/B/P]`)**:
1. (`2 × 2` Quaternionic Block): Any `D : Matrix (Fin 2) (Fin 2) ℂ` satisfying
   `su2Epsilon * D = D.map conj * su2Epsilon` has `D = su2Matrix (D 0 0) (D 0 1)` and
   `D.det = ↑(‖D 0 0‖^2 + ‖D 0 1‖^2)` (`im = 0`, `0 ≤ re`), with no Hermiticity needed.
2. (`2m × 2m` Block-Quaternionic Realization): `blockEpsilon m` realizes `J^2 = -1`, `Jᵀ = -J`,
   `J.map conj = J` on `Fin m × Fin 2`.
3. (Finite-Dim `J`-Symmetric Operators): For any `J, D : Matrix n n ℂ` with `J^2 = -1`, `Jᵀ = -J`,
   `J.map conj = J`, and `J * D = D.map conj * J`:
   - `det D` is real (`(D.det).im = 0`),
   - Every eigenvector `v ≠ 0` is Hermitian-orthogonal to `K_J v = J *ᵥ conj v`,
     with `D *ᵥ (K_J v) = conj(λ) • (K_J v)`,
   - Every real eigenvalue `μ : ℝ` has **even geometric multiplicity**
     `Even (Module.finrank ℂ (Module.End.eigenspace (Matrix.toLin' D) (μ : ℂ)))`
     (and every real generalized eigenspace `ker((D - μ I)^k)` also has even dimension),
   - If `D` is Hermitian (`D.IsHermitian`), then `(D.det).im = 0 ∧ 0 ≤ (D.det).re`.
4. (`N_d = 4` `SU(2)_L` Weyl Doublets in `(3,3,1)`): Since `su2DoubletCount smChiralGeneration15 = 4`
   (`3` quark colors `+ 1` lepton), any real `SU(2)_L` doublet Pfaffian `pf : ℝ` (where
   `pf^2 = det_doublet ≥ 0`) satisfies `0 ≤ pf ^ 4`, `(-pf) ^ 4 = pf ^ 4` (`π_4(SU(2))` invariance),
   and `0 ≤ pf ^ 12` (3 generations). -/
theorem kramers_quaternionic_pairing_and_nonneg_determinant :
    (∀ D2 : Matrix (Fin 2) (Fin 2) ℂ,
      su2Epsilon * D2 = D2.map (starRingEnd ℂ) * su2Epsilon →
      D2 = su2Matrix (D2 0 0) (D2 0 1) ∧
        D2.det = (((‖D2 0 0‖ ^ 2 + ‖D2 0 1‖ ^ 2 : ℝ)) : ℂ) ∧
        (D2.det).im = 0 ∧ 0 ≤ (D2.det).re) ∧
    (∀ (m : ℕ),
      blockEpsilon m * blockEpsilon m = -1 ∧
        (blockEpsilon m)ᵀ = -blockEpsilon m ∧
        (blockEpsilon m).map (starRingEnd ℂ) = blockEpsilon m) ∧
    (∀ {n : Type*} [Fintype n] [DecidableEq n]
      (J D : Matrix n n ℂ),
      J * J = -1 → Jᵀ = -J → J.map (starRingEnd ℂ) = J →
      J * D = D.map (starRingEnd ℂ) * J →
      ((D.det).im = 0) ∧
      (∀ (v : n → ℂ) (lam : ℂ),
        D.mulVec v = lam • v →
        dotProduct (star v) (kramersPartner J v) = 0 ∧
          (v ≠ 0 → kramersPartner J v ≠ 0) ∧
          D.mulVec (kramersPartner J v) = (starRingEnd ℂ lam) • kramersPartner J v) ∧
      (∀ (μ : ℝ),
        Even (Module.finrank ℂ (Module.End.eigenspace (Matrix.toLin' D) (μ : ℂ))) ∧
          ∀ (k : ℕ),
            Even (Module.finrank ℂ (LinearMap.ker ((Matrix.toLin' (D - (μ : ℂ) • 1)) ^ k)))) ∧
      (D.IsHermitian → (D.det).im = 0 ∧ 0 ≤ (D.det).re)) ∧
    (∀ (pf : ℝ),
      su2DoubletCount smChiralGeneration15 = 4 →
      0 ≤ pf ^ (su2DoubletCount smChiralGeneration15) ∧
        (-pf) ^ (su2DoubletCount smChiralGeneration15) = pf ^ (su2DoubletCount smChiralGeneration15) ∧
        0 ≤ pf ^ (3 * su2DoubletCount smChiralGeneration15)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro D2 h2
    have hmat : D2 = su2Matrix (D2 0 0) (D2 0 1) :=
      (su2Epsilon_intertwines_iff_su2Matrix D2).mp h2
    have hdet : D2.det = (((‖D2 0 0‖ ^ 2 + ‖D2 0 1‖ ^ 2 : ℝ)) : ℂ) := by
      conv_lhs => rw [hmat]
      exact (su2Matrix_unitary_det_and_symplectic_reality (D2 0 0) (D2 0 1)).2.2.1
    refine ⟨hmat, hdet, ?_, ?_⟩
    · rw [hdet, Complex.ofReal_im]
    · rw [hdet, Complex.ofReal_re]
      positivity
  · exact blockEpsilon_sq_transpose_real
  · intro n _ _ J D hJ_sq hJ_tr hJ_real hKramers
    obtain ⟨hK_sq, hK_smul, hK_add, _⟩ := kramersPartner_sq_and_antiunitary hJ_sq hJ_tr hJ_real
    have hdet_real : (D.det).im = 0 := by
      have hdet_mul := congrArg Matrix.det hKramers
      rw [Matrix.det_mul, Matrix.det_mul] at hdet_mul
      have hmap_det : (D.map (starRingEnd ℂ)).det = starRingEnd ℂ D.det :=
        (RingHom.map_det (starRingEnd ℂ) D).symm
      rw [hmap_det] at hdet_mul
      have hJ_det_ne : J.det ≠ 0 := by
        intro h0
        have hsq := congrArg Matrix.det hJ_sq
        rw [Matrix.det_mul, h0, mul_zero] at hsq
        have hneg : ((-1 : Matrix n n ℂ).det) = (-1 : ℂ) ^ Fintype.card n := by
          simpa using Matrix.det_neg (1 : Matrix n n ℂ)
        rw [hneg] at hsq
        exact pow_ne_zero _ (by norm_num) hsq.symm
      have hdet_conj : D.det = starRingEnd ℂ D.det :=
        mul_right_cancel₀ hJ_det_ne (by rw [mul_comm D.det J.det, hdet_mul])
      have him := congrArg Complex.im hdet_conj
      simp only [Complex.conj_im] at him
      linarith
    have hDJ : D * J = J * D.map (starRingEnd ℂ) := by
      calc
        D * J = (-(J * J)) * D * J := by rw [hJ_sq, neg_neg, one_mul]
        _ = -(J * (J * D) * J) := by noncomm_ring
        _ = -(J * (D.map (starRingEnd ℂ) * J) * J) := by rw [hKramers]
        _ = -(J * D.map (starRingEnd ℂ) * (J * J)) := by noncomm_ring
        _ = -(J * D.map (starRingEnd ℂ) * (-1)) := by rw [hJ_sq]
        _ = J * D.map (starRingEnd ℂ) := by noncomm_ring
    have hK_comm_D : ∀ u : n → ℂ,
        D.mulVec (kramersPartner J u) = kramersPartner J (D.mulVec u) := by
      intro u
      unfold kramersPartner
      have hstar : star (D.mulVec u) = (D.map (starRingEnd ℂ)).mulVec (star u) := by
        ext i
        simp only [Pi.star_apply, Matrix.mulVec, dotProduct, Matrix.map_apply,
          Complex.star_def, map_sum, map_mul]
      rw [hstar, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hDJ]
    have hpair : ∀ (v : n → ℂ) (lam : ℂ),
        D.mulVec v = lam • v →
        dotProduct (star v) (kramersPartner J v) = 0 ∧
          (v ≠ 0 → kramersPartner J v ≠ 0) ∧
          D.mulVec (kramersPartner J v) = (starRingEnd ℂ lam) • kramersPartner J v := by
      intro v lam heig
      refine ⟨kramers_inner_self_zero hJ_tr v, ?_, ?_⟩
      · intro hv_ne hKv0
        have h1 := hK_sq v
        rw [hKv0] at h1
        have hK0 : kramersPartner J (0 : n → ℂ) = 0 := by unfold kramersPartner; simp
        rw [hK0] at h1
        exact hv_ne (neg_eq_zero.mp h1.symm)
      · rw [hK_comm_D v, heig, hK_smul, Complex.star_def]
    have heven_eig : ∀ (μ : ℝ),
        Even (Module.finrank ℂ (Module.End.eigenspace (Matrix.toLin' D) (μ : ℂ))) ∧
          ∀ (k : ℕ),
            Even (Module.finrank ℂ (LinearMap.ker ((Matrix.toLin' (D - (μ : ℂ) • 1)) ^ k))) := by
      intro μ
      have hK_neg : ∀ x : n → ℂ, kramersPartner J (-x) = -kramersPartner J x := by
        intro x
        rw [← neg_one_smul ℂ x, hK_smul, star_neg, star_one, neg_one_smul]
      have hK_sub : ∀ x y : n → ℂ,
          kramersPartner J (x - y) = kramersPartner J x - kramersPartner J y := by
        intro x y
        rw [sub_eq_add_neg, hK_add, hK_neg, sub_eq_add_neg]
      have hK_shift : ∀ u : n → ℂ,
          (D - (μ : ℂ) • 1).mulVec (kramersPartner J u) =
            kramersPartner J ((D - (μ : ℂ) • 1).mulVec u) := by
        intro u
        rw [Matrix.sub_mulVec, Matrix.sub_mulVec, hK_comm_D u, hK_sub,
          Matrix.smul_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec,
          Matrix.one_mulVec, hK_smul, Complex.star_def, Complex.conj_ofReal]
      have hK_pow : ∀ (k : ℕ) (u : n → ℂ),
          ((Matrix.toLin' (D - (μ : ℂ) • 1)) ^ k) (kramersPartner J u) =
            kramersPartner J (((Matrix.toLin' (D - (μ : ℂ) • 1)) ^ k) u) := by
        intro k
        induction k with
        | zero => intro u; simp
        | succ k ih =>
          intro u
          rw [pow_succ', Module.End.mul_apply, Module.End.mul_apply, ih u]
          exact hK_shift _
      refine ⟨?_, ?_⟩
      · apply even_finrank_of_kramers_invariant hJ_sq hJ_tr hJ_real _ _ rfl
        intro v hv
        rw [Module.End.mem_eigenspace_iff, Matrix.toLin'_apply] at hv ⊢
        have h := (hpair v (μ : ℂ) hv).2.2
        simpa [Complex.conj_ofReal] using h
      · intro k
        apply even_finrank_of_kramers_invariant hJ_sq hJ_tr hJ_real _ _ rfl
        intro v hv
        rw [LinearMap.mem_ker] at hv ⊢
        rw [hK_pow k v, hv]
        unfold kramersPartner; simp
    have hherm_det : D.IsHermitian → (D.det).im = 0 ∧ 0 ≤ (D.det).re := by
      intro hD
      refine ⟨hdet_real, ?_⟩
      let U : Matrix n n ℂ := (hD.eigenvectorUnitary : Matrix n n ℂ)
      have hU_mul : U * star U = 1 := by
        simp [U]
      have hU_mul' : star U * U = 1 := by
        simp [U]
      have hspec : D = U * Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) * star U :=
        hD.spectral_theorem
      have hD_mulVec : ∀ x : n → ℂ,
          D.mulVec x = U.mulVec (Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) *ᵥ ((star U).mulVec x)) := by
        intro x
        calc
          D.mulVec x = (U * Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) * star U).mulVec x := by
            conv_lhs => rw [hspec]
          _ = U.mulVec (Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) *ᵥ ((star U).mulVec x)) := by
            rw [Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      have hstarU_U : ∀ y : n → ℂ, (star U).mulVec (U.mulVec y) = y := fun y => by
        rw [Matrix.mulVec_mulVec, hU_mul', Matrix.one_mulVec]
      have hdet_prod : D.det = ((∏ i : n, hD.eigenvalues i : ℝ) : ℂ) := by
        conv_lhs => rw [hspec]
        rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal]
        have hdet_U : U.det * (star U).det = 1 := by
          rw [← Matrix.det_mul, hU_mul, Matrix.det_one]
        calc
          U.det * (∏ i, (RCLike.ofReal (hD.eigenvalues i) : ℂ)) * (star U).det
              = (U.det * (star U).det) * ∏ i, (hD.eigenvalues i : ℂ) := by
                  simp only [RCLike.ofReal_eq_complex_ofReal]; ring
          _ = ∏ i, (hD.eigenvalues i : ℂ) := by rw [hdet_U, one_mul]
          _ = ((∏ i, hD.eigenvalues i : ℝ) : ℂ) := by push_cast; rfl
      rw [hdet_prod, Complex.ofReal_re]
      have hcard_even : ∀ μ : ℝ,
          Even (Finset.univ.filter (fun i : n => hD.eigenvalues i = μ)).card := by
        intro μ
        let S := {i : n // hD.eigenvalues i = μ}
        let E := Module.End.eigenspace (Matrix.toLin' D) (μ : ℂ)
        let e : (S → ℂ) ≃ₗ[ℂ] E :=
          { toFun := fun c =>
              ⟨U.mulVec (fun i => if hi : hD.eigenvalues i = μ then c ⟨i, hi⟩ else 0), by
                rw [Module.End.mem_eigenspace_iff, Matrix.toLin'_apply, hD_mulVec, hstarU_U,
                  ← Matrix.mulVec_smul]
                congr 1
                ext i
                rw [Matrix.mulVec_diagonal]
                split_ifs with hi
                · simp [hi]
                · simp [hi]⟩
            invFun := fun v i => ((star U).mulVec v.1) i.1
            left_inv := fun c => by
              ext ⟨i, hi⟩
              simp [hstarU_U, hi]
            right_inv := fun v => by
              ext i
              have hv : D.mulVec v.1 = (μ : ℂ) • v.1 :=
                (Module.End.mem_eigenspace_iff).mp v.2
              have hv' : Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) *ᵥ ((star U).mulVec v.1) =
                  (μ : ℂ) • ((star U).mulVec v.1) := by
                have hleft : U.mulVec (Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) *ᵥ
                    ((star U).mulVec v.1)) = U.mulVec ((μ : ℂ) • ((star U).mulVec v.1)) := by
                  calc
                    U.mulVec (Matrix.diagonal (RCLike.ofReal ∘ hD.eigenvalues) *ᵥ
                        ((star U).mulVec v.1))
                        = D.mulVec v.1 := (hD_mulVec v.1).symm
                    _ = (μ : ℂ) • v.1 := hv
                    _ = (μ : ℂ) • (U * star U).mulVec v.1 := by rw [hU_mul, Matrix.one_mulVec]
                    _ = U.mulVec ((μ : ℂ) • ((star U).mulVec v.1)) := by
                          rw [← Matrix.mulVec_mulVec, Matrix.mulVec_smul]
                have h2 := congrArg (fun x => (star U).mulVec x) hleft
                rwa [hstarU_U, hstarU_U] at h2
              have hcoord : ∀ j : n, hD.eigenvalues j ≠ μ → ((star U).mulVec v.1) j = 0 := by
                intro j hj
                have hj' := congrFun hv' j
                simp only [Matrix.mulVec_diagonal, Function.comp_apply,
                  RCLike.ofReal_eq_complex_ofReal, Pi.smul_apply, smul_eq_mul] at hj'
                have hdiff : ((hD.eigenvalues j : ℂ) - (μ : ℂ)) * ((star U).mulVec v.1) j = 0 := by
                  linear_combination hj'
                have hne : ((hD.eigenvalues j : ℂ) - (μ : ℂ)) ≠ 0 := by
                  intro h0
                  apply hj
                  exact Complex.ofReal_injective (sub_eq_zero.mp h0)
                exact (mul_eq_zero.mp hdiff).resolve_left hne
              have hfun_eq : (fun j : n =>
                  if hj : hD.eigenvalues j = μ then ((star U).mulVec v.1) j else 0) =
                  (star U).mulVec v.1 := by
                ext j
                split_ifs with hj
                · rfl
                · exact (hcoord j hj).symm
              change (U.mulVec (fun j =>
                if hj : hD.eigenvalues j = μ then ((star U).mulVec v.1) j else 0)) i = v.1 i
              rw [hfun_eq, Matrix.mulVec_mulVec, hU_mul, Matrix.one_mulVec]
            map_add' := fun c1 c2 => by
              refine Subtype.ext ?_
              rw [Submodule.coe_add, ← Matrix.mulVec_add]
              refine congrArg U.mulVec (funext fun j => ?_)
              split_ifs with hj
              · simp [hj]
              · simp [hj]
            map_smul' := fun r c => by
              refine Subtype.ext ?_
              change U.mulVec (fun i => if hi : hD.eigenvalues i = μ then (r • c) ⟨i, hi⟩ else 0) =
                  r • U.mulVec (fun i => if hi : hD.eigenvalues i = μ then c ⟨i, hi⟩ else 0)
              rw [← Matrix.mulVec_smul]
              refine congrArg U.mulVec (funext fun j => ?_)
              split_ifs with hj
              · simp [hj]
              · simp [hj] }
        have hdim_eq : Fintype.card S = Module.finrank ℂ E := by
          rw [← e.finrank_eq, Module.finrank_fintype_fun_eq_card]
        have hcard_eq : (Finset.univ.filter (fun i : n => hD.eigenvalues i = μ)).card =
            Fintype.card S := by
          rw [Fintype.card_subtype]
        rw [hcard_eq, hdim_eq]
        exact (heven_eig μ).1
      have hfib : (∏ i : n, hD.eigenvalues i) =
          ∏ μ ∈ (Finset.univ : Finset n).image hD.eigenvalues,
            ∏ i ∈ Finset.univ.filter (fun i : n => hD.eigenvalues i = μ), hD.eigenvalues i := by
        symm
        exact Finset.prod_fiberwise_of_maps_to
          (fun _ _ => Finset.mem_image_of_mem _ (Finset.mem_univ _)) _
      rw [hfib]
      apply Finset.prod_nonneg
      intro μ _
      have hconst : (∏ i ∈ Finset.univ.filter (fun i : n => hD.eigenvalues i = μ), hD.eigenvalues i) =
          μ ^ (Finset.univ.filter (fun i : n => hD.eigenvalues i = μ)).card := by
        rw [← Finset.prod_const]
        exact Finset.prod_congr rfl (fun i hi => (Finset.mem_filter.mp hi).2)
      rw [hconst]
      rcases hcard_even μ with ⟨k, hk⟩
      rw [hk, ← two_mul, pow_mul]
      positivity
    exact ⟨hdet_real, hpair, heven_eig, hherm_det⟩
  · intro pf hnd
    rw [hnd]
    refine ⟨?_, by ring, ?_⟩
    · have h4 : pf ^ 4 = (pf ^ 2) ^ 2 := by ring
      rw [h4]
      exact sq_nonneg _
    · have h12 : pf ^ (3 * 4) = (pf ^ 6) ^ 2 := by ring
      rw [h12]
      exact sq_nonneg _

/-- **Red-Team Sharpness Counterexample (`J.map conj = J` Indispensable for Kramers `det ≥ 0`)**:
Without `J.map conj = J` (or `J * J.map conj = -1`), `J = I • 1` and `D = diag(1, -1)` satisfy
`J^2 = -1` and `J * D = D.map conj * J`, yet `J * J.map conj = 1 ≠ -1` and `D.det = -1 < 0`. `[B/P]` -/
theorem kramers_false_without_real_J_counterexample :
    let J : Matrix (Fin 2) (Fin 2) ℂ := Complex.I • (1 : Matrix (Fin 2) (Fin 2) ℂ)
    let D : Matrix (Fin 2) (Fin 2) ℂ := !![1, 0; 0, -1]
    J * J = -1 ∧
      J * D = D.map (starRingEnd ℂ) * J ∧
      J * J.map (starRingEnd ℂ) = 1 ∧
      J * J.map (starRingEnd ℂ) ≠ -1 ∧
      D.det = -1 ∧
      (D.det).re < 0 := by
  intro J D
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [J, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [J, D, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [J, Matrix.mul_apply, Fin.sum_univ_two]
  · intro h
    have h00 := congrFun (congrFun h 0) 0
    simp [J, Matrix.mul_apply, Fin.sum_univ_two] at h00
    norm_num at h00
  · simp [D, Matrix.det_fin_two]
  · simp [D, Matrix.det_fin_two]

end KramersQuaternionic

/-! ## 2. Θ-Antiunitary Complex Weight Reflection Positivity (`[B/P]`) -/

section ThetaAntiunitaryRP

/-- Finite-dimensional Euclidean Osterwalder–Schrader reflection-positivity bilinear form
`∑_{u_+, u_-} conj(F(θ_H u_-)) F(u_+) w(u_+, u_-)` for complex weights `w`. `[B/P]` -/
def osComplexForm {HConfig : Type*} [Fintype HConfig]
    (thetaH : HConfig → HConfig)
    (w : HConfig × HConfig → ℂ)
    (F : HConfig → ℂ) : ℂ :=
  ∑ uPlus : HConfig, ∑ uMinus : HConfig,
    starRingEnd ℂ (F (thetaH uMinus)) * F uPlus * w (uPlus, uMinus)

private lemma theta_antiunitary_factorized_single
    {HConfig : Type*} [Fintype HConfig]
    (thetaH : HConfig → HConfig) (htheta : ∀ u, thetaH (thetaH u) = u)
    (A F : HConfig → ℂ) :
    let w : HConfig × HConfig → ℂ := fun p => A p.1 * starRingEnd ℂ (A (thetaH p.2))
    (∀ uPlus uMinus : HConfig,
      starRingEnd ℂ (w (thetaH uMinus, thetaH uPlus)) = w (uPlus, uMinus)) ∧
    osComplexForm thetaH w F = (((‖∑ u : HConfig, F u * A u‖ ^ 2 : ℝ)) : ℂ) ∧
    (osComplexForm thetaH w F).im = 0 ∧
    0 ≤ (osComplexForm thetaH w F).re := by
  intro w
  have htheta_bij : Bijective thetaH := Involutive.bijective htheta
  have hreal : ∀ uPlus uMinus : HConfig,
      starRingEnd ℂ (w (thetaH uMinus, thetaH uPlus)) = w (uPlus, uMinus) := by
    intro uPlus uMinus
    dsimp [w]
    rw [map_mul, Complex.conj_conj, htheta uPlus]
    ring
  have hsum_eq : osComplexForm thetaH w F =
      (∑ u : HConfig, F u * A u) * starRingEnd ℂ (∑ v : HConfig, F v * A v) := by
    unfold osComplexForm
    dsimp [w]
    have hterm : ∀ uPlus uMinus : HConfig,
        starRingEnd ℂ (F (thetaH uMinus)) * F uPlus *
            (A uPlus * starRingEnd ℂ (A (thetaH uMinus))) =
          (F uPlus * A uPlus) * starRingEnd ℂ (F (thetaH uMinus) * A (thetaH uMinus)) := by
      intro uPlus uMinus
      rw [map_mul]
      ring
    simp_rw [hterm, ← Finset.mul_sum]
    have hreidx : (∑ uMinus : HConfig, starRingEnd ℂ (F (thetaH uMinus) * A (thetaH uMinus))) =
        starRingEnd ℂ (∑ v : HConfig, F v * A v) := by
      rw [map_sum]
      exact Fintype.sum_bijective thetaH htheta_bij _ _ (fun _ => rfl)
    rw [hreidx, ← Finset.sum_mul]
  have hnorm : (∑ u : HConfig, F u * A u) * starRingEnd ℂ (∑ v : HConfig, F v * A v) =
      (((‖∑ u : HConfig, F u * A u‖ ^ 2 : ℝ)) : ℂ) := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [hsum_eq, hnorm]
  refine ⟨hreal, rfl, ?_, ?_⟩
  · rw [Complex.ofReal_im]
  · rw [Complex.ofReal_re]
    positivity

/-- **Θ-Antiunitary Complex Weight Reflection Positivity Theorem (`[B/P]`)**:
1. (Half-space factorization): If `w(u_+, u_-) = A(u_+) * conj(A(θ_H u_-))` with `θ_H^2 = id`,
   then `w` obeys Euclidean time-reversal reality `conj(w(θ U)) = w(U)` and exact OS reflection
   positivity `osComplexForm thetaH w F = ‖∑ u_+, F(u_+) A(u_+)‖^2 ≥ 0` (`im = 0`, `re ≥ 0`).
2. (Osterwalder–Seiler factorized kernel sum): For any finite sum
   `w(u_+, u_-) = ∑ a, c_a * K_a(u_+) * conj(K_a(θ_H u_-))` with `c_a ≥ 0`, `w` obeys `Θ`-reality
   and exact OS reflection positivity `osComplexForm thetaH w F = ∑ a, c_a * ‖∑ u, F(u) K_a(u)‖^2 ≥ 0`.
3. (General PSD reflection kernel): If `w` obeys `conj(w(θ U)) = w(U)` and the reflection matrix
   `K u v := w(u, θ_H v)` is Hermitian positive-semidefinite (`K.PosSemidef`), then for EVERY
   complex observable `F`, `(osComplexForm thetaH w F).im = 0 ∧ 0 ≤ (osComplexForm thetaH w F).re`.
4. (Asymmetric complex-phase witness vs. Round 03 `w(π) = -r`): On `HConfig = Bool` (`θ_H = id`),
   `A true = 1 + I`, `A false = 1` gives `w (true, false) = 1 + I` with `im = 1 ≠ 0` on an
   asymmetric configuration while preserving exact `Θ`-reality and OS RP `re ≥ 0` for all `F`,
   whereas on `θ`-symmetric configurations `θ U = U`, `conj(w(θ U)) = w(U)` forces `w` to be real. -/
theorem theta_antiunitary_complex_weight_reflection_positivity :
    (∀ {HConfig : Type*} [Fintype HConfig]
      (thetaH : HConfig → HConfig), (∀ u, thetaH (thetaH u) = u) →
      ∀ (A F : HConfig → ℂ),
      let w : HConfig × HConfig → ℂ := fun p => A p.1 * starRingEnd ℂ (A (thetaH p.2))
      (∀ uPlus uMinus : HConfig,
        starRingEnd ℂ (w (thetaH uMinus, thetaH uPlus)) = w (uPlus, uMinus)) ∧
      osComplexForm thetaH w F = (((‖∑ u : HConfig, F u * A u‖ ^ 2 : ℝ)) : ℂ) ∧
      (osComplexForm thetaH w F).im = 0 ∧
      0 ≤ (osComplexForm thetaH w F).re) ∧
    (∀ {HConfig ι : Type*} [Fintype HConfig] [Fintype ι]
      (thetaH : HConfig → HConfig), (∀ u, thetaH (thetaH u) = u) →
      ∀ (c : ι → ℝ), (∀ a, 0 ≤ c a) →
      ∀ (K : ι → HConfig → ℂ) (F : HConfig → ℂ),
      let w : HConfig × HConfig → ℂ :=
        fun p => ∑ a : ι, (c a : ℂ) * K a p.1 * starRingEnd ℂ (K a (thetaH p.2))
      (∀ uPlus uMinus : HConfig,
        starRingEnd ℂ (w (thetaH uMinus, thetaH uPlus)) = w (uPlus, uMinus)) ∧
      osComplexForm thetaH w F = (((∑ a : ι, c a * ‖∑ u : HConfig, F u * K a u‖ ^ 2 : ℝ)) : ℂ) ∧
      (osComplexForm thetaH w F).im = 0 ∧
      0 ≤ (osComplexForm thetaH w F).re) ∧
    (∀ {HConfig : Type*} [Fintype HConfig] [DecidableEq HConfig]
      (thetaH : HConfig → HConfig), (∀ u, thetaH (thetaH u) = u) →
      ∀ (w : HConfig × HConfig → ℂ),
      (∀ uPlus uMinus : HConfig,
        starRingEnd ℂ (w (thetaH uMinus, thetaH uPlus)) = w (uPlus, uMinus)) →
      (Matrix.of (fun u v : HConfig => w (u, thetaH v))).PosSemidef →
      ∀ (F : HConfig → ℂ),
      (osComplexForm thetaH w F).im = 0 ∧ 0 ≤ (osComplexForm thetaH w F).re) ∧
    ((let A_wit : Bool → ℂ := fun b => if b then 1 + Complex.I else 1
      let w_wit : Bool × Bool → ℂ := fun p => A_wit p.1 * starRingEnd ℂ (A_wit p.2)
      (w_wit (true, false)).im = 1 ∧ (w_wit (true, false)).im ≠ 0 ∧
      (∀ uPlus uMinus : Bool, starRingEnd ℂ (w_wit (uMinus, uPlus)) = w_wit (uPlus, uMinus)) ∧
      (∀ F : Bool → ℂ, (osComplexForm id w_wit F).im = 0 ∧ 0 ≤ (osComplexForm id w_wit F).re)) ∧
     (∀ {Config : Type*} (theta : Config → Config) (w : Config → ℂ),
       (∀ U, starRingEnd ℂ (w (theta U)) = w U) →
       ∀ U, theta U = U → (w U).im = 0)) := by
  refine ⟨fun thetaH htheta A F => theta_antiunitary_factorized_single thetaH htheta A F, ?_, ?_, ?_⟩
  · intro HConfig ι _ _ thetaH htheta c hc K F w
    have hreal : ∀ uPlus uMinus : HConfig,
        starRingEnd ℂ (w (thetaH uMinus, thetaH uPlus)) = w (uPlus, uMinus) := by
      intro uPlus uMinus
      dsimp [w]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [map_mul, map_mul, Complex.conj_ofReal, Complex.conj_conj, htheta uPlus]
      ring
    have hsum_eq : osComplexForm thetaH w F =
        (((∑ a : ι, c a * ‖∑ u : HConfig, F u * K a u‖ ^ 2 : ℝ)) : ℂ) := by
      unfold osComplexForm
      dsimp [w]
      have hswap : (∑ uPlus : HConfig, ∑ uMinus : HConfig,
          starRingEnd ℂ (F (thetaH uMinus)) * F uPlus *
            ∑ a : ι, (c a : ℂ) * K a uPlus * starRingEnd ℂ (K a (thetaH uMinus))) =
          ∑ a : ι, (c a : ℂ) *
            osComplexForm thetaH (fun p => K a p.1 * starRingEnd ℂ (K a (thetaH p.2))) F := by
        simp_rw [Finset.mul_sum]
        rw [Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        unfold osComplexForm
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun uPlus _ => ?_)
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun uMinus _ => ?_)
        ring
      rw [hswap]
      have hterm : ∀ a : ι,
          (c a : ℂ) *
            osComplexForm thetaH (fun p => K a p.1 * starRingEnd ℂ (K a (thetaH p.2))) F =
          (((c a * ‖∑ u : HConfig, F u * K a u‖ ^ 2 : ℝ)) : ℂ) := by
        intro a
        rw [(theta_antiunitary_factorized_single thetaH htheta (K a) F).2.1]
        push_cast
        rfl
      simp_rw [hterm]
      push_cast
      rfl
    rw [hsum_eq]
    refine ⟨hreal, rfl, ?_, ?_⟩
    · rw [Complex.ofReal_im]
    · rw [Complex.ofReal_re]
      exact Finset.sum_nonneg (fun a _ => mul_nonneg (hc a) (sq_nonneg _))
  · intro HConfig _ _ thetaH htheta w _ hPSD F
    let K : Matrix HConfig HConfig ℂ := Matrix.of (fun u v => w (u, thetaH v))
    have htheta_bij : Bijective thetaH := Involutive.bijective htheta
    have hform_eq : osComplexForm thetaH w F = dotProduct (star F) (Kᵀ.mulVec F) := by
      unfold osComplexForm
      have hinner : ∀ uPlus : HConfig,
          (∑ uMinus : HConfig, starRingEnd ℂ (F (thetaH uMinus)) * F uPlus * w (uPlus, uMinus)) =
            ∑ v : HConfig, starRingEnd ℂ (F v) * K uPlus v * F uPlus := by
        intro uPlus
        refine Fintype.sum_bijective thetaH htheta_bij _ _ (fun uMinus => ?_)
        dsimp [K]
        rw [htheta uMinus]
        ring
      simp_rw [hinner]
      rw [Finset.sum_comm]
      simp only [dotProduct, Matrix.mulVec, Matrix.transpose_apply, Pi.star_apply,
        Complex.star_def, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun v _ => Finset.sum_congr rfl (fun uPlus _ => ?_))
      ring
    have hKT_pos : ∀ g : HConfig → ℂ,
        0 ≤ (dotProduct (star g) (Kᵀ.mulVec g)).re ∧
        (dotProduct (star g) (Kᵀ.mulVec g)).im = 0 := by
      intro g
      have hKherm : Kᴴ = K := hPSD.isHermitian.eq
      have hKT_conj : Kᵀ = K.map (starRingEnd ℂ) := by
        ext u v
        have h := congrFun (congrFun hKherm v) u
        simp only [Matrix.conjTranspose_apply, Complex.star_def] at h
        simpa [Matrix.transpose_apply, Matrix.map_apply] using h.symm
      have hquad_conj : dotProduct (star g) (Kᵀ.mulVec g) =
          starRingEnd ℂ (dotProduct (star (star g)) (K.mulVec (star g))) := by
        rw [hKT_conj]
        simp only [dotProduct, Matrix.mulVec, Matrix.map_apply, Pi.star_apply, Complex.star_def,
          map_sum, map_mul, Complex.conj_conj, Finset.mul_sum, mul_comm]
      have hK_nn : (0 : ℂ) ≤ dotProduct (star (star g)) (K.mulVec (star g)) :=
        hPSD.dotProduct_mulVec_nonneg (star g)
      obtain ⟨hre_nn, him_zero⟩ := Complex.nonneg_iff.mp hK_nn
      rw [hquad_conj]
      simp only [Complex.conj_re, Complex.conj_im, neg_eq_zero]
      exact ⟨hre_nn, him_zero.symm⟩
    rw [hform_eq]
    exact ⟨(hKT_pos F).2, (hKT_pos F).1⟩
  · refine ⟨?_, ?_⟩
    · dsimp only
      let A_wit : Bool → ℂ := fun b => if b then 1 + Complex.I else 1
      let w_wit : Bool × Bool → ℂ := fun p => A_wit p.1 * starRingEnd ℂ (A_wit p.2)
      have him1 : (w_wit (true, false)).im = 1 := by
        simp [w_wit, A_wit]
      have hreal : ∀ uPlus uMinus : Bool,
          starRingEnd ℂ (w_wit (uMinus, uPlus)) = w_wit (uPlus, uMinus) := by
        intro uPlus uMinus
        dsimp [w_wit]
        rw [map_mul, Complex.conj_conj]
        ring
      have hrp : ∀ F : Bool → ℂ,
          (osComplexForm id w_wit F).im = 0 ∧ 0 ≤ (osComplexForm id w_wit F).re := by
        intro F
        have hfactor : ∀ uPlus uMinus : Bool,
            starRingEnd ℂ (F (id uMinus)) * F uPlus * w_wit (uPlus, uMinus) =
              (F uPlus * A_wit uPlus) * starRingEnd ℂ (F uMinus * A_wit uMinus) := by
          intro uPlus uMinus
          dsimp [w_wit]
          rw [map_mul]
          ring
        have hsum : osComplexForm id w_wit F =
            (∑ u : Bool, F u * A_wit u) * starRingEnd ℂ (∑ v : Bool, F v * A_wit v) := by
          unfold osComplexForm
          simp_rw [hfactor, ← Finset.mul_sum, ← map_sum, ← Finset.sum_mul]
        rw [hsum, Complex.mul_conj, Complex.normSq_eq_norm_sq]
        refine ⟨?_, ?_⟩
        · rw [Complex.ofReal_im]
        · rw [Complex.ofReal_re]
          positivity
      exact ⟨him1, by rw [him1]; norm_num, hreal, hrp⟩
    · intro Config theta w hw U hU
      have h := congrArg Complex.im (hw U)
      rw [hU] at h
      simp only [Complex.conj_im] at h
      linarith

/-- **Red-Team Sharpness Counterexample (`Θ`-Reality Alone Does Not Imply OS RP)**:
Constant real negative weight `w _ := (-1 : ℂ)` satisfies `conj(w(θ U)) = w(U)` everywhere,
yet fails OS reflection positivity (`Re(osComplexForm id w (fun _ => 1)) = -4 < 0`), proving
factorized OS kernels / PSD reflection matrix `K` are strictly required. `[B/P]` -/
theorem theta_reality_without_factorization_counterexample :
    let w : Bool × Bool → ℂ := fun _ => (-1 : ℂ)
    let F : Bool → ℂ := fun _ => (1 : ℂ)
    (∀ uPlus uMinus : Bool, starRingEnd ℂ (w (uMinus, uPlus)) = w (uPlus, uMinus)) ∧
      (osComplexForm id w F).re = -4 ∧
      (osComplexForm id w F).re < 0 := by
  intro w F
  refine ⟨fun _ _ => by simp [w], ?_, ?_⟩
  · simp [osComplexForm, w, F]; norm_num
  · simp [osComplexForm, w, F]

end ThetaAntiunitaryRP

/-! ## 3. 5D-to-4D Chern–Simons Anomaly Inflow Coboundary & `(3,3,1)` Cancellation (`[C/B/P]`) -/

section AnomalyInflow5D

/-- Weighted 5D Chern–Simons boundary variation polynomial on a 4D Weyl multiplet list `spec`,
with integrated topological descent densities `(c3, c2, c1, cg)` for
`SU(3)_c^2 U(1)_Y`, `SU(2)_L^2 U(1)_Y`, `U(1)_Y^3`, and `Grav^2 U(1)_Y`. `[B/P]` -/
def cs5DBoundaryVariation (spec : List ChiralWeylMultiplet) (c3 c2 c1 cg : ℝ) : ℝ :=
  c3 * (anomalySU3SqU1Y spec : ℝ) +
  c2 * (anomalySU2SqU1Y spec : ℝ) +
  c1 * (anomalyU1YCubed spec : ℝ) +
  cg * (anomalyGravSqU1Y spec : ℝ)

/-- Witten `π_4(SU(2)) = ℤ_2` global phase factor `(-1)^{N_d}` for `spec`. `[B/P]` -/
def wittenZ2PhaseFactor (spec : List ChiralWeylMultiplet) : ℤ :=
  (-1 : ℤ) ^ (su2DoubletCount spec)

/-- Mod-16 Dai–Freed `Ω_5^{Spin}(Bℤ_4) ≅ ℤ_{16}` 5D SPT boundary phase `exp(2πi N_Weyl / 16)`. `[B/P]` -/
noncomputable def daiFreedZ4Phase (nWeyl : ℕ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (((nWeyl : ℝ) / 16) : ℂ))

/-- **5D-to-4D Chern–Simons Anomaly Inflow Coboundary & `(3,3,1)` Cancellation Theorem (`[C/B/P]`)**:
1. (5D Slab Stokes / Coboundary Inflow): On any 5D bulk slice `cs5D : Fin (L5 + 1) → ℝ`, the bulk
   5D Chern–Simons inflow `∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)` telescopes identically to
   the 4D boundary jump `cs5D ⟨L5, ...⟩ - cs5D 0`, canceling any matching 4D boundary chiral phase
   variation `δΦ_4D = -(cs5D L5 - cs5D 0)` (`δΦ_4D + ∑ I_bulk = 0` and `exp(i (δΦ_4D + ∑ I_bulk)) = 1`).
2. (`(3,3,1)` 15-Weyl Generation Complete Inflow Vanishing): On `smChiralGeneration15` (and `3`
   generations), all 4 perturbative coefficients `(SU(3)^2 U(1), SU(2)^2 U(1), U(1)^3, Grav^2 U(1))`
   and Witten's `ℤ_2` phase vanish/trivialize identically (`cs5DBoundaryVariation = 0` for all
   `(c3, c2, c1, cg)` and `wittenZ2PhaseFactor = 1`), so a 4D chiral phase matching the 5D CS
   boundary variation vanishes identically (`δΦ_4D = 0`, `exp(i δΦ_4D) * wittenZ2 = 1`) without
   requiring any non-trivial 5D bulk topological term.
3. (Dai–Freed `Ω_5^{Spin}(Bℤ_4) ≅ ℤ_{16}` Boundary): For `N_Weyl = 15` (no `ν_R^c`),
   `15 % 16 = 15 ≠ 0`, `(3 * 15) % 16 = 13 ≠ 0`, `daiFreedZ4Phase 15 ≠ 1`, and
   `daiFreedZ4Phase (3 * 15) ≠ 1`; adding `1` sterile `ν_R^c` per generation (`N_Weyl = 16`)
   simultaneously yields `16 % 16 = 0`, `(3 * 16) % 16 = 0`, `daiFreedZ4Phase 16 = 1`,
   `daiFreedZ4Phase (3 * 16) = 1`, `Tr_16(Q_X) = 0`, and `Tr_16(Q_X^3) = 0`. -/
theorem anomaly_inflow_5d_chern_simons_331_cancellation :
    (∀ (L5 : ℕ) (cs5D : Fin (L5 + 1) → ℝ) (dPhi4D : ℝ),
      (∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)) =
        cs5D ⟨L5, Nat.lt_succ_self L5⟩ - cs5D 0 ∧
      (dPhi4D = -(cs5D ⟨L5, Nat.lt_succ_self L5⟩ - cs5D 0) →
        dPhi4D + (∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)) = 0 ∧
        Complex.exp (Complex.I * ((dPhi4D + ∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc) : ℝ) : ℂ)) = 1)) ∧
    (∀ (c3 c2 c1 cg : ℝ),
      cs5DBoundaryVariation smChiralGeneration15 c3 c2 c1 cg = 0 ∧
      cs5DBoundaryVariation (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15)
        c3 c2 c1 cg = 0 ∧
      wittenZ2PhaseFactor smChiralGeneration15 = 1 ∧
      wittenZ2PhaseFactor (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 1 ∧
      (∀ dPhi4D : ℝ, dPhi4D = cs5DBoundaryVariation smChiralGeneration15 c3 c2 c1 cg →
        dPhi4D = 0 ∧
        Complex.exp (Complex.I * (dPhi4D : ℂ)) * ((wittenZ2PhaseFactor smChiralGeneration15 : ℤ) : ℂ) = 1)) ∧
    ((15 : ℕ) % 16 = 15 ∧ (3 * 15 : ℕ) % 16 = 13 ∧
      daiFreedZ4Phase 15 ≠ 1 ∧ daiFreedZ4Phase (3 * 15) ≠ 1 ∧
      (15 + 1 : ℕ) % 16 = 0 ∧ (3 * (15 + 1) : ℕ) % 16 = 0 ∧
      daiFreedZ4Phase (15 + 1) = 1 ∧ daiFreedZ4Phase (3 * (15 + 1)) = 1 ∧
      6 * (1 : ℤ) + 3 * (1 : ℤ) + 3 * (-3 : ℤ) + 2 * (-3 : ℤ) + (1 : ℤ) + (5 : ℤ) = 0 ∧
      6 * (1 : ℤ) ^ 3 + 3 * (1 : ℤ) ^ 3 + 3 * (-3 : ℤ) ^ 3 +
        2 * (-3 : ℤ) ^ 3 + (1 : ℤ) ^ 3 + (5 : ℤ) ^ 3 = 0) := by
  have hstokes : ∀ (L5 : ℕ) (cs5D : Fin (L5 + 1) → ℝ) (dPhi4D : ℝ),
      (∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)) =
        cs5D ⟨L5, Nat.lt_succ_self L5⟩ - cs5D 0 ∧
      (dPhi4D = -(cs5D ⟨L5, Nat.lt_succ_self L5⟩ - cs5D 0) →
        dPhi4D + (∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)) = 0 ∧
        Complex.exp (Complex.I * ((dPhi4D + ∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc) : ℝ) : ℂ)) = 1) := by
    intro L5 cs5D dPhi4D
    have htel : (∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)) =
        cs5D ⟨L5, Nat.lt_succ_self L5⟩ - cs5D 0 := by
      induction L5 with
      | zero => simp [Fin.zero_eta]
      | succ L5 ih =>
        rw [Fin.sum_univ_castSucc]
        have ih' := ih (fun i => cs5D i.castSucc)
        simp only [Fin.succ_castSucc] at ih' ⊢
        have hlast : (Fin.last L5).succ = ⟨L5 + 1, Nat.lt_succ_self (L5 + 1)⟩ := by
          ext; simp [Fin.last]
        have hcast : (Fin.last L5).castSucc = ⟨L5, Nat.lt_succ_of_lt (Nat.lt_succ_self L5)⟩ := by
          ext; simp [Fin.last]
        have htop : (⟨L5, Nat.lt_succ_self L5⟩ : Fin (L5 + 1)).castSucc =
            ⟨L5, Nat.lt_succ_of_lt (Nat.lt_succ_self L5)⟩ := rfl
        have hzero : (0 : Fin (L5 + 1)).castSucc = (0 : Fin (L5 + 2)) := rfl
        have heq1 : (⟨1 + L5, by omega⟩ : Fin (L5 + 2)) = ⟨L5 + 1, Nat.lt_succ_self (L5 + 1)⟩ := by
          ext; simp [add_comm]
        rw [ih', hlast, hcast, htop, hzero]
        change cs5D ⟨L5, Nat.lt_succ_of_lt (Nat.lt_succ_self L5)⟩ - cs5D 0 +
            (cs5D ⟨L5 + 1, Nat.lt_succ_self (L5 + 1)⟩ -
              cs5D ⟨L5, Nat.lt_succ_of_lt (Nat.lt_succ_self L5)⟩) =
            cs5D ⟨L5 + 1, Nat.lt_succ_self (L5 + 1)⟩ - cs5D 0
        ring
    refine ⟨htel, fun hd => ?_⟩
    have hzero : dPhi4D + (∑ t : Fin L5, (cs5D t.succ - cs5D t.castSucc)) = 0 := by
      rw [htel, hd]; ring
    refine ⟨hzero, ?_⟩
    rw [hzero]
    simp
  have hanom1 := sm_15weyl_complete_anomaly_cancellation
  have h3gen :
      anomalySU3SqU1Y (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 0 ∧
      anomalySU2SqU1Y (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 0 ∧
      anomalyU1YCubed (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 0 ∧
      anomalyGravSqU1Y (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 0 ∧
      su2DoubletCount (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 12 := by
    refine ⟨?_, ?_, ?_, ?_, by decide⟩
    · norm_num [smChiralGeneration15, anomalySU3SqU1Y]
    · norm_num [smChiralGeneration15, anomalySU2SqU1Y]
    · norm_num [smChiralGeneration15, anomalyU1YCubed]
    · norm_num [smChiralGeneration15, anomalyGravSqU1Y]
  have hcs331 : ∀ (c3 c2 c1 cg : ℝ),
      cs5DBoundaryVariation smChiralGeneration15 c3 c2 c1 cg = 0 ∧
      cs5DBoundaryVariation (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15)
        c3 c2 c1 cg = 0 ∧
      wittenZ2PhaseFactor smChiralGeneration15 = 1 ∧
      wittenZ2PhaseFactor (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 1 ∧
      (∀ dPhi4D : ℝ, dPhi4D = cs5DBoundaryVariation smChiralGeneration15 c3 c2 c1 cg →
        dPhi4D = 0 ∧
        Complex.exp (Complex.I * (dPhi4D : ℂ)) * ((wittenZ2PhaseFactor smChiralGeneration15 : ℤ) : ℂ) = 1) := by
    intro c3 c2 c1 cg
    have h1 : cs5DBoundaryVariation smChiralGeneration15 c3 c2 c1 cg = 0 := by
      unfold cs5DBoundaryVariation
      rw [hanom1.2.1, hanom1.2.2.1, hanom1.2.2.2.1, hanom1.2.2.2.2.1]
      simp
    have h3 : cs5DBoundaryVariation
        (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) c3 c2 c1 cg = 0 := by
      unfold cs5DBoundaryVariation
      rw [h3gen.1, h3gen.2.1, h3gen.2.2.1, h3gen.2.2.2.1]
      simp
    have hw1 : wittenZ2PhaseFactor smChiralGeneration15 = 1 := by
      unfold wittenZ2PhaseFactor
      rw [hanom1.2.2.2.2.2.1]
      norm_num
    have hw3 : wittenZ2PhaseFactor
        (smChiralGeneration15 ++ smChiralGeneration15 ++ smChiralGeneration15) = 1 := by
      unfold wittenZ2PhaseFactor
      rw [h3gen.2.2.2.2]
      norm_num
    refine ⟨h1, h3, hw1, hw3, fun dPhi4D hd => ?_⟩
    have hd0 : dPhi4D = 0 := hd.trans h1
    refine ⟨hd0, ?_⟩
    rw [hd0, hw1]
    simp
  have h2piI_ne : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := by
    have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
    exact mul_ne_zero (mul_ne_zero two_ne_zero hpi) Complex.I_ne_zero
  have hphase15_ne : daiFreedZ4Phase 15 ≠ 1 := by
    intro h
    dsimp [daiFreedZ4Phase] at h
    rw [Complex.exp_eq_one_iff] at h
    rcases h with ⟨k, hk⟩
    have hc : (((15 : ℝ) / 16 : ℝ) : ℂ) = (k : ℂ) := by
      apply mul_left_cancel₀ h2piI_ne
      calc
        2 * (Real.pi : ℂ) * Complex.I * (((15 : ℝ) / 16 : ℝ) : ℂ)
            = (k : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by simpa using hk
        _ = 2 * (Real.pi : ℂ) * Complex.I * (k : ℂ) := by ring
    have hr : (15 : ℝ) / 16 = (k : ℝ) := Complex.ofReal_injective (by simpa using hc)
    have hzi : (15 : ℤ) = 16 * k := by
      have h1 : ((15 : ℤ) : ℝ) = ((16 * k : ℤ) : ℝ) := by push_cast; linarith
      exact Int.cast_injective h1
    omega
  have hphase45_ne : daiFreedZ4Phase (3 * 15) ≠ 1 := by
    intro h
    dsimp [daiFreedZ4Phase] at h
    rw [Complex.exp_eq_one_iff] at h
    rcases h with ⟨k, hk⟩
    have hc : (((45 : ℝ) / 16 : ℝ) : ℂ) = (k : ℂ) := by
      apply mul_left_cancel₀ h2piI_ne
      calc
        2 * (Real.pi : ℂ) * Complex.I * (((45 : ℝ) / 16 : ℝ) : ℂ)
            = (k : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
              push_cast at hk ⊢
              norm_num at hk ⊢
              exact hk
        _ = 2 * (Real.pi : ℂ) * Complex.I * (k : ℂ) := by ring
    have hr : (45 : ℝ) / 16 = (k : ℝ) := Complex.ofReal_injective (by simpa using hc)
    have hzi : (45 : ℤ) = 16 * k := by
      have h1 : ((45 : ℤ) : ℝ) = ((16 * k : ℤ) : ℝ) := by push_cast; linarith
      exact Int.cast_injective h1
    omega
  have hphase16_eq : daiFreedZ4Phase (15 + 1) = 1 := by
    dsimp [daiFreedZ4Phase]
    norm_num
  have hphase48_eq : daiFreedZ4Phase (3 * (15 + 1)) = 1 := by
    dsimp [daiFreedZ4Phase]
    norm_num
    rw [mul_comm (2 * (Real.pi : ℂ) * Complex.I) (3 : ℂ)]
    change Complex.exp (((3 : ℕ) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)) = 1
    rw [Complex.exp_nat_mul, Complex.exp_two_pi_mul_I, one_pow]
  have hdf := dai_freed_mod16_spin_z4_majorana_vs_dirac_dichotomy
  exact ⟨hstokes, hcs331,
    ⟨hdf.2.2.1.1, hdf.2.2.1.2.1, hphase15_ne, hphase45_ne,
      hdf.2.2.2.1, hdf.2.2.2.2.1, hphase16_eq, hphase48_eq,
