        dwfTransferOverlap C_DW m_DW L5 < Δ_SMG / 2 ∧
        Δ_SMG / 2 < Δ_SMG - dwfTransferOverlap C_DW m_DW L5) ∧
    (∀ {n_mir : ℕ} (H_mir : Matrix (Fin n_mir) (Fin n_mir) ℂ)
      (dH_mix : ℕ → Matrix (Fin n_mir) (Fin n_mir) ℂ) (Ω_mir : Fin n_mir → ℂ),
      H_mirᴴ = H_mir →
      (∀ L5, (dH_mix L5)ᴴ = dH_mix L5) →
      (∀ v : Fin n_mir → ℂ, dotProduct (star Ω_mir) v = 0 →
