      rw [Real.sqrt_le_left hsum_nn]
      have hcs_poly : ∀ t : ℝ,
          0 ≤ l2NormSq w * t ^ 2 + 2 * (∑ i : Fin n_mir, ‖u i‖ * ‖w i‖) * t + l2NormSq u := by
        intro t
        have h0 : 0 ≤ ∑ i : Fin n_mir, (‖u i‖ + t * ‖w i‖) ^ 2 :=
          Finset.sum_nonneg (fun _ _ => sq_nonneg _)
        have hid : (∑ i : Fin n_mir, (‖u i‖ + t * ‖w i‖) ^ 2) =
            l2NormSq w * t ^ 2 + 2 * (∑ i : Fin n_mir, ‖u i‖ * ‖w i‖) * t + l2NormSq u := by
          unfold l2NormSq
          have hterm : ∀ i : Fin n_mir,
              (‖u i‖ + t * ‖w i‖) ^ 2 = ‖w i‖ ^ 2 * t ^ 2 + 2 * (‖u i‖ * ‖w i‖) * t + ‖u i‖ ^ 2 := by
            intro i; ring
          simp_rw [hterm, Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum]
        linarith
      have hcs_sq : (∑ i : Fin n_mir, ‖u i‖ * ‖w i‖) ^ 2 ≤ l2NormSq u * l2NormSq w := by
        set a := l2NormSq w
        set b := ∑ i : Fin n_mir, ‖u i‖ * ‖w i‖
        set c := l2NormSq u
        rcases hwn.eq_or_lt with ha0 | ha_pos
        · have hb0 : b = 0 := by
            by_contra hne
            have hval := hcs_poly (-(c + 1) / (2 * b))
            have hb_ne : 2 * b ≠ 0 := mul_ne_zero (by norm_num) hne
            have hlin : a * (-(c + 1) / (2 * b)) ^ 2 + 2 * b * (-(c + 1) / (2 * b)) + c = -1 := by
              rw [← ha0]
              calc
                0 * (-(c + 1) / (2 * b)) ^ 2 + 2 * b * (-(c + 1) / (2 * b)) + c
                    = -(c + 1) + c := by rw [zero_mul, zero_add, mul_div_cancel₀ _ hb_ne]
                _ = -1 := by ring
            linarith
          rw [hb0, ← ha0]; norm_num
        · have hmin := hcs_poly (-b / a)
          have ha_ne : a ≠ 0 := ne_of_gt ha_pos
          have hid : a * (-b / a) ^ 2 + 2 * b * (-b / a) + c = (a * c - b ^ 2) / a := by
            rw [eq_div_iff ha_ne]
            calc
              (a * (-b / a) ^ 2 + 2 * b * (-b / a) + c) * a
                  = (a * (-b / a)) * (a * (-b / a)) + 2 * b * (a * (-b / a)) + c * a := by ring
              _ = (-b) * (-b) + 2 * b * (-b) + c * a := by rw [mul_div_cancel₀ _ ha_ne]
              _ = a * c - b ^ 2 := by ring
          rw [hid] at hmin
          have hnn := (div_nonneg_iff.mp hmin).elim (fun h => h.1) (fun h => absurd h.2 (by linarith))
          linarith
      have hcs : ∑ i : Fin n_mir, ‖u i‖ * ‖w i‖ ≤ Real.sqrt (l2NormSq u) * Real.sqrt (l2NormSq w) := by
        rw [← Real.sqrt_mul hun]
        exact Real.le_sqrt_of_sq_le hcs_sq
      have hpt : l2NormSq (u + w) ≤
          l2NormSq u + 2 * (∑ i : Fin n_mir, ‖u i‖ * ‖w i‖) + l2NormSq w := by
        unfold l2NormSq
        have hterm : ∀ i : Fin n_mir, ‖(u + w) i‖ ^ 2 ≤ ‖u i‖ ^ 2 + 2 * (‖u i‖ * ‖w i‖) + ‖w i‖ ^ 2 := by
          intro i
          have hn : ‖(u + w) i‖ ≤ ‖u i‖ + ‖w i‖ := norm_add_le (u i) (w i)
          have hn0 : 0 ≤ ‖(u + w) i‖ := norm_nonneg _
          nlinarith
        calc
          ∑ i : Fin n_mir, ‖(u + w) i‖ ^ 2
              ≤ ∑ i : Fin n_mir, (‖u i‖ ^ 2 + 2 * (‖u i‖ * ‖w i‖) + ‖w i‖ ^ 2) :=
                Finset.sum_le_sum (fun i _ => hterm i)
          _ = (∑ i : Fin n_mir, ‖u i‖ ^ 2) + 2 * (∑ i : Fin n_mir, ‖u i‖ * ‖w i‖) +
                (∑ i : Fin n_mir, ‖w i‖ ^ 2) := by
                simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
      have hsq : (Real.sqrt (l2NormSq u) + Real.sqrt (l2NormSq w)) ^ 2 =
          l2NormSq u + 2 * (Real.sqrt (l2NormSq u) * Real.sqrt (l2NormSq w)) + l2NormSq w := by
        ring_nf
        rw [Real.sq_sqrt hun, Real.sq_sqrt hwn]
      linarith
    have h1 : Δ_SMG * Real.sqrt (l2NormSq v) ≤ Real.sqrt (l2NormSq (H_mir.mulVec v)) := by
      have hsq : (Δ_SMG * Real.sqrt (l2NormSq v)) ^ 2 ≤ l2NormSq (H_mir.mulVec v) := by
        calc
          (Δ_SMG * Real.sqrt (l2NormSq v)) ^ 2 = Δ_SMG ^ 2 * Real.sqrt (l2NormSq v) ^ 2 := by ring
          _ = Δ_SMG ^ 2 * l2NormSq v := by rw [Real.sq_sqrt hvn]
          _ ≤ l2NormSq (H_mir.mulVec v) := hgap_mir v hv_orth
      exact Real.le_sqrt_of_sq_le hsq
    have h2 : Real.sqrt (l2NormSq w) ≤ η * Real.sqrt (l2NormSq v) := by
      have hw_eq : l2NormSq w = l2NormSq ((dH_mix L5).mulVec v) := by
        unfold l2NormSq w
        refine Finset.sum_congr rfl (fun i _ => by simp)
      rw [hw_eq]
      have hηv_nn : 0 ≤ η * Real.sqrt (l2NormSq v) := by positivity
      rw [Real.sqrt_le_left hηv_nn]
      calc
        l2NormSq ((dH_mix L5).mulVec v) ≤ η ^ 2 * l2NormSq v := hpert_mir L5 v
        _ = η ^ 2 * Real.sqrt (l2NormSq v) ^ 2 := by rw [Real.sq_sqrt hvn]
        _ = (η * Real.sqrt (l2NormSq v)) ^ 2 := by ring
    have h3 : (Δ_SMG - η) * Real.sqrt (l2NormSq v) ≤ Real.sqrt (l2NormSq u) := by linarith
    have hdiff_nn : 0 ≤ (Δ_SMG - η) * Real.sqrt (l2NormSq v) := by positivity
    have hsq_le : ((Δ_SMG - η) * Real.sqrt (l2NormSq v)) ^ 2 ≤ (Real.sqrt (l2NormSq u)) ^ 2 :=
      pow_le_pow_left₀ hdiff_nn h3 2
    rw [Real.sq_sqrt hun] at hsq_le
    calc
      (Δ_SMG - η) ^ 2 * l2NormSq v
          = (Δ_SMG - η) ^ 2 * Real.sqrt (l2NormSq v) ^ 2 := by rw [Real.sq_sqrt hvn]
      _ = ((Δ_SMG - η) * Real.sqrt (l2NormSq v)) ^ 2 := by ring
      _ ≤ l2NormSq u := hsq_le
  exact ⟨fun A => by ring,
    ⟨hanom15.2.1, hanom15.2.2.1, hanom15.2.2.2.1, hanom15.2.2.2.2.1,
      (hcs331 0 0 0 0).2.2.1,
      hdf15, hne15, hdf16, hph16, hph48, htr1, htr3⟩,
    ⟨htend_mir, hL5_half⟩, hmir_pert⟩

end DWFAndSMG

/-! ## Part 2. 4D `T^4` Discrete 2-Cochain Berry Curvature `H^2` Descent & Counterterm Exactness (`[C/B/X]`) -/

section DiscreteTorusH2Berry

/-- Antisymmetric (skew) condition for a discrete 2-cochain `F` on `DiscreteTorus d L`. `[B]` -/
def IsSkew2Cochain {d : ℕ} {L : Fin d → ℕ}
    (F : Fin d → Fin d → DiscreteTorus d L → ℝ) : Prop :=
  ∀ μ ν x, F ν μ x = -F μ ν x

/-- Discrete exterior derivative `d_2 : C^2(T^d_L) → C^3(T^d_L)` on cubical `3`-cells:
`(d_2 F)_{μνρ}(x) = (F_{νρ}(x+e_μ) - F_{νρ}(x)) - (F_{μρ}(x+e_ν) - F_{μρ}(x)) + (F_{μν}(x+e_ρ) - F_{μν}(x))`. `[B]` -/
def torusD2 {d : ℕ} {L : Fin d → ℕ}
    (F : Fin d → Fin d → DiscreteTorus d L → ℝ) :
    Fin d → Fin d → Fin d → DiscreteTorus d L → ℝ :=
  fun μ ν ρ x =>
    (F ν ρ (x + torusStep μ) - F ν ρ x) -
    (F μ ρ (x + torusStep ν) - F μ ρ x) +
    (F μ ν (x + torusStep ρ) - F μ ν x)

/-- Fundamental 2-cycle Chern flux `∑_{s,t} F_{μν}(x(μ↦s, ν↦t))` through basepoint `x`. `[B]` -/
def chernFlux2 {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (F : Fin d → Fin d → DiscreteTorus d L → ℝ)
    (μ ν : Fin d) (x : DiscreteTorus d L) : ℝ :=
  ∑ s : ZMod (L μ), ∑ t : ZMod (L ν), F μ ν (Function.update (Function.update x μ s) ν t)

/-- Modulo-`2πℤ` Berry counterterm exactness on `DiscreteTorus d L`: `F_Berry` differs from a
local 1-form gauge counterterm coboundary `torusD1 A_ct` by an integer-quantized closed skew
2-cochain `2π * n_flux` (so `exp(i F_Berry) = exp(i torusD1 A_ct)` on every plaquette). `[C/B]` -/
def ModTwoPiExact2Cochain {d : ℕ} {L : Fin d → ℕ}
    (F : Fin d → Fin d → DiscreteTorus d L → ℝ) : Prop :=
  ∃ (A_ct : Fin d → DiscreteTorus d L → ℝ)
    (n_flux : Fin d → Fin d → DiscreteTorus d L → ℤ),
    IsSkew2Cochain (fun μ ν x => (n_flux μ ν x : ℝ)) ∧
    (∀ μ ν ρ x, torusD2 (fun μ ν x => (n_flux μ ν x : ℝ)) μ ν ρ x = 0) ∧
    (∀ μ ν x, F μ ν x = torusD1 A_ct μ ν x + 2 * Real.pi * (n_flux μ ν x : ℝ))

private lemma isSkew_diag_zero {d : ℕ} {L : Fin d → ℕ}
    {F : Fin d → Fin d → DiscreteTorus d L → ℝ}
    (hskew : IsSkew2Cochain F) (μ : Fin d) (x : DiscreteTorus d L) :
    F μ μ x = 0 := by
  have h := hskew μ μ x
  linarith

private lemma torusD2_eq_zero_of_eq {d : ℕ} {L : Fin d → ℕ}
    {F : Fin d → Fin d → DiscreteTorus d L → ℝ}
    (hskew : IsSkew2Cochain F) {μ ν ρ : Fin d}
    (hco : μ = ν ∨ μ = ρ ∨ ν = ρ) (x : DiscreteTorus d L) :
    torusD2 F μ ν ρ x = 0 := by
  unfold torusD2
  rcases hco with rfl | rfl | rfl
  · rw [isSkew_diag_zero hskew μ (x + torusStep ρ), isSkew_diag_zero hskew μ x]
    ring
  · rw [isSkew_diag_zero hskew μ (x + torusStep ν), isSkew_diag_zero hskew μ x,
      hskew μ ν (x + torusStep μ), hskew μ ν x]
    ring
  · rw [isSkew_diag_zero hskew ν (x + torusStep μ), isSkew_diag_zero hskew ν x]
    ring

private lemma update_comm_ne {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν : Fin d} (hne : μ ≠ ν)
    (s : ZMod (L μ)) (t : ZMod (L ν)) :
    Function.update (Function.update x μ s) ν t =
      Function.update (Function.update x ν t) μ s :=
  Function.update_comm hne s t x

private lemma update_two_add_step_self_fst {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν : Fin d} (hne : μ ≠ ν)
    (s : ZMod (L μ)) (t : ZMod (L ν)) :
    Function.update (Function.update (x + torusStep μ) μ s) ν t =
      Function.update (Function.update x μ s) ν t := by
  ext α
  by_cases hαν : α = ν
  · subst hαν; simp
  · by_cases hαμ : α = μ
    · subst hαμ; simp [hαν]
    · simp [hαν, hαμ]

private lemma update_two_add_step_self_snd {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν : Fin d} (hne : μ ≠ ν)
    (s : ZMod (L μ)) (t : ZMod (L ν)) :
    Function.update (Function.update (x + torusStep ν) μ s) ν t =
      Function.update (Function.update x μ s) ν t := by
  ext α
  by_cases hαν : α = ν
  · subst hαν; simp
  · by_cases hαμ : α = μ
    · subst hαμ; simp [hαν]
    · simp [hαν, hαμ]

private lemma update_two_add_step_ne {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν ρ : Fin d} (hρμ : ρ ≠ μ) (hρν : ρ ≠ ν)
    (s : ZMod (L μ)) (t : ZMod (L ν)) :
    Function.update (Function.update (x + torusStep ρ) μ s) ν t =
      Function.update (Function.update x μ s) ν t + torusStep ρ := by
  ext α
  by_cases hαν : α = ν
  · subst hαν; simp [hρν.symm]
  · by_cases hαμ : α = μ
    · subst hαμ; simp [hαν, hρμ.symm]
    · simp [hαν, hαμ]

private lemma update_two_step_fst {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν : Fin d} (hne : μ ≠ ν)
    (s : ZMod (L μ)) (t : ZMod (L ν)) :
    Function.update (Function.update x μ s) ν t + torusStep μ =
      Function.update (Function.update x μ (s + 1)) ν t := by
  ext α
  by_cases hαν : α = ν
  · subst hαν; simp [hne.symm]
  · by_cases hαμ : α = μ
    · subst hαμ; simp [hαν]
    · simp [hαν, hαμ]

private lemma update_two_step_snd {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν : Fin d} (hne : μ ≠ ν)
    (s : ZMod (L μ)) (t : ZMod (L ν)) :
    Function.update (Function.update x μ s) ν t + torusStep ν =
      Function.update (Function.update x μ s) ν (t + 1) := by
  ext α
  by_cases hαν : α = ν
  · subst hαν; simp
  · by_cases hαμ : α = μ
    · subst hαμ; simp [hαν]
    · simp [hαν, hαμ]

/-- Any coboundary `F = torusD1 A` is skew-symmetric, closed (`torusD2 (torusD1 A) = 0`),
and has identically vanishing 2-cycle Chern fluxes (`chernFlux2 (torusD1 A) μ ν x = 0` for `μ ≠ ν`). `[B]` -/
theorem torusD1_skew_and_d2_zero {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (A : Fin d → DiscreteTorus d L → ℝ) :
    IsSkew2Cochain (torusD1 A) ∧
    (∀ μ ν ρ x, torusD2 (torusD1 A) μ ν ρ x = 0) ∧
    (∀ μ ν x, μ ≠ ν → chernFlux2 (torusD1 A) μ ν x = 0) := by
  refine ⟨?_, ?_, ?_⟩
  · intro μ ν x
    unfold torusD1
    ring
  · intro μ ν ρ x
    unfold torusD2 torusD1
    have hμν : x + torusStep (L := L) μ + torusStep ν = x + torusStep ν + torusStep μ := by
      rw [add_assoc, add_comm (torusStep μ) (torusStep ν), ← add_assoc]
    have hμρ : x + torusStep (L := L) μ + torusStep ρ = x + torusStep ρ + torusStep μ := by
      rw [add_assoc, add_comm (torusStep μ) (torusStep ρ), ← add_assoc]
    have hνρ : x + torusStep (L := L) ν + torusStep ρ = x + torusStep ρ + torusStep ν := by
      rw [add_assoc, add_comm (torusStep ν) (torusStep ρ), ← add_assoc]
    rw [hμν, hμρ, hνρ]
    ring
  · intro μ ν x hne
    unfold chernFlux2 torusD1
    have hsplit : ∀ s : ZMod (L μ),
        (∑ t : ZMod (L ν),
          (A μ (Function.update (Function.update x μ s) ν t) +
           A ν (Function.update (Function.update x μ s) ν t + torusStep μ) -
           A μ (Function.update (Function.update x μ s) ν t + torusStep ν) -
           A ν (Function.update (Function.update x μ s) ν t))) =
        (∑ t : ZMod (L ν),
          (A μ (Function.update (Function.update x μ s) ν t) -
           A μ (Function.update (Function.update x μ s) ν (t + 1)))) +
        (∑ t : ZMod (L ν),
          (A ν (Function.update (Function.update x μ (s + 1)) ν t) -
           A ν (Function.update (Function.update x μ s) ν t))) := by
      intro s
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      rw [update_two_step_fst x hne s t, update_two_step_snd x hne s t]
      ring
    simp_rw [hsplit, Finset.sum_add_distrib]
    have hsum1 : ∀ s : ZMod (L μ),
        (∑ t : ZMod (L ν),
          (A μ (Function.update (Function.update x μ s) ν t) -
           A μ (Function.update (Function.update x μ s) ν (t + 1)))) = 0 := by
      intro s
      rw [Finset.sum_sub_distrib]
      have hsh : (∑ t : ZMod (L ν), A μ (Function.update (Function.update x μ s) ν (t + 1))) =
          ∑ t : ZMod (L ν), A μ (Function.update (Function.update x μ s) ν t) :=
        Fintype.sum_equiv (Equiv.addRight (1 : ZMod (L ν)))
          (fun t => A μ (Function.update (Function.update x μ s) ν (t + 1)))
          (fun t => A μ (Function.update (Function.update x μ s) ν t)) (fun _ => rfl)
      linarith
    have hzero1 : (∑ s : ZMod (L μ), ∑ t : ZMod (L ν),
        (A μ (Function.update (Function.update x μ s) ν t) -
         A μ (Function.update (Function.update x μ s) ν (t + 1)))) = 0 :=
      Finset.sum_eq_zero (fun s _ => hsum1 s)
    rw [hzero1, zero_add]
    rw [Finset.sum_comm]
    have hsum2 : ∀ t : ZMod (L ν),
        (∑ s : ZMod (L μ),
          (A ν (Function.update (Function.update x μ (s + 1)) ν t) -
           A ν (Function.update (Function.update x μ s) ν t))) = 0 := by
      intro t
      rw [Finset.sum_sub_distrib]
      have hsh : (∑ s : ZMod (L μ), A ν (Function.update (Function.update x μ (s + 1)) ν t)) =
          ∑ s : ZMod (L μ), A ν (Function.update (Function.update x μ s) ν t) :=
        Fintype.sum_equiv (Equiv.addRight (1 : ZMod (L μ)))
          (fun s => A ν (Function.update (Function.update x μ (s + 1)) ν t))
          (fun s => A ν (Function.update (Function.update x μ s) ν t)) (fun _ => rfl)
      linarith
    exact Finset.sum_eq_zero (fun t _ => hsum2 t)

private lemma chernFlux2_add_step {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    {F : Fin d → Fin d → DiscreteTorus d L → ℝ}
    (hclosed : ∀ μ ν ρ x, torusD2 F μ ν ρ x = 0)
    {μ ν : Fin d} (hne : μ ≠ ν) (ρ : Fin d) (x : DiscreteTorus d L) :
    chernFlux2 F μ ν (x + torusStep ρ) = chernFlux2 F μ ν x := by
  by_cases hρμ : ρ = μ
  · subst hρμ
    unfold chernFlux2
    refine Finset.sum_congr rfl (fun s _ => Finset.sum_congr rfl (fun t _ => ?_))
    rw [update_two_add_step_self_fst x hne s t]
  · by_cases hρν : ρ = ν
    · subst hρν
      unfold chernFlux2
      refine Finset.sum_congr rfl (fun s _ => Finset.sum_congr rfl (fun t _ => ?_))
      rw [update_two_add_step_self_snd x hne s t]
    · have hdiff : chernFlux2 F μ ν (x + torusStep ρ) - chernFlux2 F μ ν x = 0 := by
        unfold chernFlux2
        rw [← Finset.sum_sub_distrib]
        have hterm : (∑ s : ZMod (L μ),
            ((∑ t : ZMod (L ν), F μ ν (Function.update (Function.update (x + torusStep ρ) μ s) ν t)) -
             (∑ t : ZMod (L ν), F μ ν (Function.update (Function.update x μ s) ν t)))) =
            (∑ s : ZMod (L μ), ∑ t : ZMod (L ν),
              (F μ ρ (Function.update (Function.update x μ s) ν t + torusStep ν) -
               F μ ρ (Function.update (Function.update x μ s) ν t))) -
            (∑ s : ZMod (L μ), ∑ t : ZMod (L ν),
              (F ν ρ (Function.update (Function.update x μ s) ν t + torusStep μ) -
               F ν ρ (Function.update (Function.update x μ s) ν t))) := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun s _ => ?_)
          rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun t _ => ?_)
          rw [update_two_add_step_ne x hρμ hρν s t]
          have hc := hclosed μ ν ρ (Function.update (Function.update x μ s) ν t)
          unfold torusD2 at hc
          linarith
        rw [hterm]
        have h1 : (∑ s : ZMod (L μ), ∑ t : ZMod (L ν),
            (F μ ρ (Function.update (Function.update x μ s) ν t + torusStep ν) -
             F μ ρ (Function.update (Function.update x μ s) ν t))) = 0 := by
          refine Finset.sum_eq_zero (fun s _ => ?_)
          simp_rw [update_two_step_snd x hne s]
          rw [Finset.sum_sub_distrib]
          have hsh : (∑ t : ZMod (L ν), F μ ρ (Function.update (Function.update x μ s) ν (t + 1))) =
              ∑ t : ZMod (L ν), F μ ρ (Function.update (Function.update x μ s) ν t) :=
            Fintype.sum_equiv (Equiv.addRight (1 : ZMod (L ν)))
              (fun t => F μ ρ (Function.update (Function.update x μ s) ν (t + 1)))
              (fun t => F μ ρ (Function.update (Function.update x μ s) ν t)) (fun _ => rfl)
          linarith
        have h2 : (∑ s : ZMod (L μ), ∑ t : ZMod (L ν),
            (F ν ρ (Function.update (Function.update x μ s) ν t + torusStep μ) -
             F ν ρ (Function.update (Function.update x μ s) ν t))) = 0 := by
          rw [Finset.sum_comm]
          refine Finset.sum_eq_zero (fun t _ => ?_)
          have hstep : ∀ s : ZMod (L μ),
              F ν ρ (Function.update (Function.update x μ s) ν t + torusStep μ) =
                F ν ρ (Function.update (Function.update x μ (s + 1)) ν t) :=
            fun s => by rw [update_two_step_fst x hne s t]
          simp_rw [hstep]
          rw [Finset.sum_sub_distrib]
          have hsh : (∑ s : ZMod (L μ), F ν ρ (Function.update (Function.update x μ (s + 1)) ν t)) =
              ∑ s : ZMod (L μ), F ν ρ (Function.update (Function.update x μ s) ν t) :=
            Fintype.sum_equiv (Equiv.addRight (1 : ZMod (L μ)))
              (fun s => F ν ρ (Function.update (Function.update x μ (s + 1)) ν t))
              (fun s => F ν ρ (Function.update (Function.update x μ s) ν t)) (fun _ => rfl)
          linarith
        linarith
      linarith

/-- Under `torusD2 F = 0`, every 2-cycle Chern flux `chernFlux2 F μ ν x` (`μ ≠ ν`) is
independent of the basepoint `x : DiscreteTorus d L`. `[B]` -/
lemma chernFlux2_eq_base {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    {F : Fin d → Fin d → DiscreteTorus d L → ℝ}
    (hclosed : ∀ μ ν ρ x, torusD2 F μ ν ρ x = 0)
    {μ ν : Fin d} (hne : μ ≠ ν) (x : DiscreteTorus d L) :
    chernFlux2 F μ ν x = chernFlux2 F μ ν 0 := by
  have htrunc : ∀ k : ℕ, k ≤ d → chernFlux2 F μ ν (torusTrunc x k) = chernFlux2 F μ ν 0 := by
    intro k
    induction k with
    | zero =>
        intro _
        rw [torusTrunc_zero]
    | succ k ih =>
        intro hk
        have hprev := ih (Nat.le_of_succ_le hk)
        let m : Fin d := ⟨k, hk⟩
        have hstep_n : ∀ n : ℕ,
            chernFlux2 F μ ν (Function.update (torusTrunc x k) m (n : ZMod (L m))) =
              chernFlux2 F μ ν (torusTrunc x k) := by
          intro n
          induction n with
          | zero =>
              have h0 : Function.update (torusTrunc x k) m ((0 : ℕ) : ZMod (L m)) =
                  torusTrunc x k := by
                ext α
                by_cases hα : α = m
                · subst hα
                  have hmk : ¬ (m.1 < k) := lt_irrefl k
                  simp [torusTrunc, hmk]
                · simp [hα]
              rw [h0]
          | succ n ihn =>
              have hsucc : Function.update (torusTrunc x k) m ((n + 1 : ℕ) : ZMod (L m)) =
                  Function.update (torusTrunc x k) m (n : ZMod (L m)) + torusStep m := by
                rw [Nat.cast_succ, ← update_add_torusStep_self]
              rw [hsucc, chernFlux2_add_step hclosed hne m, ihn]
        have hxm : ((x m).val : ZMod (L m)) = x m := ZMod.natCast_zmod_val (x m)
        have heq_trunc : torusTrunc x (k + 1) =
            Function.update (torusTrunc x k) m ((x m).val : ZMod (L m)) := by
          rw [hxm]
          exact torusTrunc_succ x m
        rw [heq_trunc, hstep_n (x m).val, hprev]
  simpa [torusTrunc_self] using htrunc d (le_refl d)

section TorusH2InductiveConstruction

private def tailTorus {d : ℕ} {L : Fin (d + 1) → ℕ} (p : DiscreteTorus (d + 1) L) :
    DiscreteTorus d (fun i => L i.succ) :=
  fun i => p i.succ

private def consTorus {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) :
    DiscreteTorus (d + 1) L :=
  Fin.cases t y

@[simp] private lemma consTorus_zero {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) :
    consTorus t y 0 = t := rfl

@[simp] private lemma consTorus_succ {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) (i : Fin d) :
    consTorus t y i.succ = y i := rfl

@[simp] private lemma tailTorus_cons {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) :
    tailTorus (consTorus t y) = y := by
  ext i; rfl

private lemma consTorus_eta {d : ℕ} {L : Fin (d + 1) → ℕ}
    (p : DiscreteTorus (d + 1) L) :
    consTorus (p 0) (tailTorus p) = p := by
  ext μ
  refine Fin.cases rfl (fun _ => rfl) μ

private lemma consTorus_add_step0 {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) :
    consTorus t y + torusStep 0 = consTorus (t + 1) y := by
  ext μ
  refine Fin.cases ?_ (fun i => ?_) μ <;> simp

private lemma consTorus_add_step_succ {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) (j : Fin d) :
    consTorus t y + torusStep j.succ = consTorus t (y + torusStep j) := by
  ext μ
  refine Fin.cases ?_ (fun i => ?_) μ
  · simp only [discreteTorus_add_apply, consTorus_zero, torusStep_apply]
    split_ifs with h
    · exact absurd h.symm (Fin.succ_ne_zero j)
    · simp
  · simp [Fin.succ_inj]

private lemma update_consTorus_zero {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t s : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) :
    Function.update (consTorus t y) 0 s = consTorus s y := by
  ext μ
  refine Fin.cases ?_ (fun i => ?_) μ <;> simp

private lemma update_consTorus_succ {d : ℕ} {L : Fin (d + 1) → ℕ}
    (t : ZMod (L 0)) (y : DiscreteTorus d (fun i => L i.succ)) (i : Fin d) (s : ZMod (L i.succ)) :
    Function.update (consTorus t y) i.succ s = consTorus t (Function.update y i s) := by
  ext μ
  refine Fin.cases ?_ (fun j => ?_) μ
  · rw [Function.update_of_ne (Fin.succ_ne_zero i).symm]
    rfl
  · by_cases hj : j = i
    · subst hj; simp
    · simp [hj, Fin.succ_inj]

private lemma torusD1_add {d : ℕ} {L : Fin d → ℕ}
    (A B : Fin d → DiscreteTorus d L → ℝ) (μ ν : Fin d) (x : DiscreteTorus d L) :
    torusD1 (fun α p => A α p + B α p) μ ν x = torusD1 A μ ν x + torusD1 B μ ν x := by
  unfold torusD1
  ring

private lemma torusD2_sub {d : ℕ} {L : Fin d → ℕ}
    (F G : Fin d → Fin d → DiscreteTorus d L → ℝ) (μ ν ρ : Fin d) (x : DiscreteTorus d L) :
    torusD2 (fun α β p => F α β p - G α β p) μ ν ρ x =
      torusD2 F μ ν ρ x - torusD2 G μ ν ρ x := by
  unfold torusD2
  ring

private lemma discrete_torus_closed_2cochain_exact_aux :
    ∀ (d : ℕ) (L : Fin d → ℕ) [∀ μ, NeZero (L μ)]
      (F : Fin d → Fin d → DiscreteTorus d L → ℝ),
      IsSkew2Cochain F →
      (∀ μ ν ρ x, torusD2 F μ ν ρ x = 0) →
      (∀ μ ν, μ ≠ ν → chernFlux2 F μ ν 0 = 0) →
      ∃ A_ct : Fin d → DiscreteTorus d L → ℝ, torusD1 A_ct = F
  | 0, L, _, F, hskew, _, _ => by
      refine ⟨fun μ _ => Fin.elim0 μ, ?_⟩
      funext μ
      exact Fin.elim0 μ
  | d + 1, L, hNeZ, F, hskew, hclosed, hflux => by
      let L' : Fin d → ℕ := fun i => L i.succ
      have _hNeZ' : ∀ i : Fin d, NeZero (L' i) := fun i => hNeZ i.succ
      let N : ℕ := L 0
      have hN_pos : 0 < N := NeZero.pos (L 0)
      -- Step 1: Axial gauge along coordinate `0`
      let A0 : Fin (d + 1) → DiscreteTorus (d + 1) L → ℝ := fun μ p =>
        Fin.cases (0 : ℝ) (fun i =>
          ∑ s ∈ Finset.range (p 0).val, F 0 i.succ (consTorus (s : ZMod N) (tailTorus p))) μ
      let F1 : Fin (d + 1) → Fin (d + 1) → DiscreteTorus (d + 1) L → ℝ :=
        fun μ ν p => F μ ν p - torusD1 A0 μ ν p
      have hA0_0 : ∀ p, A0 0 p = 0 := fun _ => rfl
      have hA0_succ : ∀ (i : Fin d) (p : DiscreteTorus (d + 1) L),
          A0 i.succ p = ∑ s ∈ Finset.range (p 0).val, F 0 i.succ (consTorus (s : ZMod N) (tailTorus p)) :=
        fun _ _ => rfl
      have hF1_skew : IsSkew2Cochain F1 := by
        intro μ ν p
        dsimp [F1]
        rw [hskew μ ν p, (torusD1_skew_and_d2_zero A0).1 μ ν p]
        ring
      have hF1_closed : ∀ μ ν ρ p, torusD2 F1 μ ν ρ p = 0 := by
        intro μ ν ρ p
        dsimp [F1]
        rw [torusD2_sub, hclosed μ ν ρ p, (torusD1_skew_and_d2_zero A0).2.1 μ ν ρ p, sub_zero]
      -- Holonomy 1-cochain on T^d along coordinate `0`
      let ω : Fin d → DiscreteTorus d L' → ℝ := fun i y =>
        ∑ s : ZMod N, F 0 i.succ (consTorus s y)
      have hF1_0_succ : ∀ (i : Fin d) (t : ZMod N) (y : DiscreteTorus d L'),
          F1 0 i.succ (consTorus t y) =
            if t.val = N - 1 then ω i y else 0 := by
        intro i t y
        dsimp [F1]
        unfold torusD1
        have hstep0 : consTorus t y + torusStep 0 = consTorus (t + 1) y := consTorus_add_step0 t y
        have hstepi : consTorus t y + torusStep i.succ = consTorus t (y + torusStep i) :=
          consTorus_add_step_succ t y i
        rw [hstep0, hstepi, hA0_0, hA0_0, hA0_succ, hA0_succ]
        simp only [consTorus_zero, tailTorus_cons]
        have hlt : t.val < N := ZMod.val_lt t
        by_cases hlast : t.val = N - 1
        · rw [if_pos hlast]
          have htp1 : t + 1 = 0 := by
            have hc : ((t.val + 1 : ℕ) : ZMod N) = t + 1 := by
              rw [Nat.cast_add, Nat.cast_one, ZMod.natCast_zmod_val]
            rw [← hc, hlast, Nat.sub_add_cancel hN_pos, ZMod.natCast_self]
          rw [htp1, ZMod.val_zero, Finset.range_zero, Finset.sum_empty]
          have hsum_split : ω i y =
              (∑ s ∈ Finset.range (N - 1), F 0 i.succ (consTorus (s : ZMod N) y)) +
                F 0 i.succ (consTorus t y) := by
            dsimp [ω]
            rw [sum_zmod_eq_sum_range]
            have hrange : Finset.range N = Finset.range ((N - 1) + 1) := by
              rw [Nat.sub_add_cancel hN_pos]
            rw [hrange, Finset.sum_range_succ, ← hlast, ZMod.natCast_zmod_val]
          rw [hlast]
          linarith
        · rw [if_neg hlast]
          have hwrap : t.val + 1 < N := by omega
          have h1N : Fact (1 < N) := ⟨by omega⟩
          have hval : (t + 1).val = t.val + 1 := by
            rw [ZMod.val_add, ZMod.val_one N]
            exact Nat.mod_eq_of_lt hwrap
          rw [hval, Finset.sum_range_succ, ZMod.natCast_zmod_val]
          ring
      -- F1_{i+1, j+1}(cons t y) is independent of `t`
      have hF1_indep_n : ∀ (i j : Fin d) (y : DiscreteTorus d L') (n : ℕ),
          n < N →
          F1 i.succ j.succ (consTorus (n : ZMod N) y) =
            F1 i.succ j.succ (consTorus 0 y) := by
        intro i j y n
        induction n with
        | zero => intro _; rw [Nat.cast_zero]
        | succ n ih =>
            intro hn
            have hn_lt : n < N := Nat.lt_of_succ_lt hn
            have hstep := hF1_closed 0 i.succ j.succ (consTorus (n : ZMod N) y)
            unfold torusD2 at hstep
            rw [consTorus_add_step0, consTorus_add_step_succ, consTorus_add_step_succ] at hstep
            have hval_n : ((n : ZMod N)).val = n := ZMod.val_cast_of_lt hn_lt
            have hne_last : ((n : ZMod N)).val ≠ N - 1 := by omega
            have h0i : F1 0 i.succ (consTorus (n : ZMod N) y) = 0 := by
              rw [hF1_0_succ, if_neg hne_last]
            have h0i' : F1 0 i.succ (consTorus (n : ZMod N) (y + torusStep j)) = 0 := by
              rw [hF1_0_succ, if_neg hne_last]
            have h0j : F1 0 j.succ (consTorus (n : ZMod N) y) = 0 := by
              rw [hF1_0_succ, if_neg hne_last]
            have h0j' : F1 0 j.succ (consTorus (n : ZMod N) (y + torusStep i)) = 0 := by
              rw [hF1_0_succ, if_neg hne_last]
            have hc1 : F1 i.succ j.succ (consTorus ((n : ZMod N) + 1) y) =
                F1 i.succ j.succ (consTorus (n : ZMod N) y) := by
              linarith
            rw [Nat.cast_succ, hc1]
            exact ih hn_lt
      have hF1_indep : ∀ (i j : Fin d) (t : ZMod N) (y : DiscreteTorus d L'),
          F1 i.succ j.succ (consTorus t y) = F i.succ j.succ (consTorus 0 y) := by
        intro i j t y
        have h1 : F1 i.succ j.succ (consTorus t y) = F1 i.succ j.succ (consTorus 0 y) := by
          rw [← ZMod.natCast_zmod_val t]
          exact hF1_indep_n i j y t.val (ZMod.val_lt t)
        rw [h1]
        dsimp [F1]
        unfold torusD1
        have hstepi : consTorus 0 y + torusStep i.succ = consTorus 0 (y + torusStep i) :=
          consTorus_add_step_succ 0 y i
        have hstepj : consTorus 0 y + torusStep j.succ = consTorus 0 (y + torusStep j) :=
          consTorus_add_step_succ 0 y j
        rw [hstepi, hstepj, hA0_succ, hA0_succ, hA0_succ, hA0_succ]
        simp only [consTorus_zero, ZMod.val_zero, Finset.range_zero, Finset.sum_empty]
        ring
      -- ω is a flat 1-cochain on T^d with zero Polyakov sums
      have hω_flat : ∀ i j y, torusD1 ω i j y = 0 := by
        intro i j y
        let t_last : ZMod N := ((N - 1 : ℕ) : ZMod N)
        have hval_last : t_last.val = N - 1 := ZMod.val_cast_of_lt (by omega)
        have hc := hF1_closed 0 i.succ j.succ (consTorus t_last y)
        unfold torusD2 at hc
        rw [consTorus_add_step0, consTorus_add_step_succ, consTorus_add_step_succ] at hc
        have htp1 : t_last + 1 = 0 := by
          have hc' : ((t_last.val + 1 : ℕ) : ZMod N) = t_last + 1 := by
            rw [Nat.cast_add, Nat.cast_one, ZMod.natCast_zmod_val]
          rw [← hc', hval_last, Nat.sub_add_cancel hN_pos, ZMod.natCast_self]
        rw [htp1, hF1_indep i j 0 y, hF1_indep i j t_last y,
          hF1_0_succ i t_last y, hF1_0_succ i t_last (y + torusStep j),
          hF1_0_succ j t_last y, hF1_0_succ j t_last (y + torusStep i)] at hc
        simp only [hval_last, ↓reduceIte] at hc
        unfold torusD1
        linarith
      have hω_poly : ∀ i, polyakovSum ω i 0 = 0 := by
        intro i
        unfold polyakovSum
        dsimp [ω]
        have h0_eq : (0 : DiscreteTorus (d + 1) L) = consTorus 0 (0 : DiscreteTorus d L') := by
          ext μ
          refine Fin.cases rfl (fun _ => rfl) μ
        have hne : (0 : Fin (d + 1)) ≠ i.succ := (Fin.succ_ne_zero i).symm
        have hf := hflux 0 i.succ hne
        unfold chernFlux2 at hf
        rw [h0_eq] at hf
        have hcongr : (∑ t : ZMod (L' i), ∑ s : ZMod N, F 0 i.succ (consTorus s (Function.update 0 i t))) =
            ∑ s : ZMod N, ∑ t : ZMod (L' i),
              F 0 i.succ (Function.update (Function.update (consTorus 0 (0 : DiscreteTorus d L')) 0 s) i.succ t) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun s _ => Finset.sum_congr rfl (fun t _ => ?_))
          rw [update_consTorus_zero, update_consTorus_succ]
        rw [hcongr]
        exact hf
      -- Obtain Φ on T^d with torusD0 Φ = ω
      have hΦ_ex := (discrete_torus_flat_cochain_coboundary_iff_zero_polyakov d L' ω).mp
        ⟨hω_flat, hω_poly⟩
      rcases hΦ_ex.1 with ⟨Φ, hΦ⟩
      have hd0Φ : ∀ i y, torusD0 Φ i y = ω i y := fun i y =>
        (congrFun (congrFun hΦ i) y).symm
      -- Step 2: Lift Φ to A1 on T^{d+1} supported on t = N - 1 (with minus sign)
      let A1 : Fin (d + 1) → DiscreteTorus (d + 1) L → ℝ := fun μ p =>
        Fin.cases (if (p 0).val = N - 1 then -Φ (tailTorus p) else 0) (fun _ => 0) μ
      have hA1_0 : ∀ p, A1 0 p = if (p 0).val = N - 1 then -Φ (tailTorus p) else 0 := fun _ => rfl
      have hA1_succ : ∀ (i : Fin d) p, A1 i.succ p = 0 := fun _ _ => rfl
      have hD1_A1_0_succ : ∀ (i : Fin d) (p : DiscreteTorus (d + 1) L),
          torusD1 A1 0 i.succ p = F1 0 i.succ p := by
        intro i p
        rw [← consTorus_eta p]
        unfold torusD1
        rw [consTorus_add_step0, consTorus_add_step_succ, hA1_0, hA1_0, hA1_succ, hA1_succ]
        simp only [consTorus_zero, tailTorus_cons]
        rw [hF1_0_succ]
        by_cases hlast : (p 0).val = N - 1
        · rw [if_pos hlast, if_pos hlast, if_pos hlast]
          have hd := hd0Φ i (tailTorus p)
          unfold torusD0 at hd
          linarith
        · rw [if_neg hlast, if_neg hlast, if_neg hlast]
          ring
      have hD1_A1_succ_succ : ∀ (i j : Fin d) (p : DiscreteTorus (d + 1) L),
          torusD1 A1 i.succ j.succ p = 0 := by
        intro i j p
        unfold torusD1
        rw [hA1_succ, hA1_succ, hA1_succ, hA1_succ]
        ring
      -- Step 3: Base 2-cochain on T^d from F(i.succ, j.succ, cons 0 y)
      let F_base : Fin d → Fin d → DiscreteTorus d L' → ℝ := fun i j y =>
        F i.succ j.succ (consTorus 0 y)
      have hFbase_skew : IsSkew2Cochain F_base := by
        intro i j y
        exact hskew i.succ j.succ (consTorus 0 y)
      have hFbase_closed : ∀ i j k y, torusD2 F_base i j k y = 0 := by
        intro i j k y
        have hc := hclosed i.succ j.succ k.succ (consTorus 0 y)
        unfold torusD2 at hc ⊢
        dsimp [F_base]
        rw [← consTorus_add_step_succ, ← consTorus_add_step_succ, ← consTorus_add_step_succ]
        exact hc
      have hFbase_flux : ∀ i j, i ≠ j → chernFlux2 F_base i j 0 = 0 := by
        intro i j hij
        have hij' : i.succ ≠ j.succ := fun h => hij (Fin.succ_inj.mp h)
        have hf := hflux i.succ j.succ hij'
        have h0_eq : (0 : DiscreteTorus (d + 1) L) = consTorus 0 (0 : DiscreteTorus d L') := by
          ext μ; refine Fin.cases rfl (fun _ => rfl) μ
        unfold chernFlux2 at hf ⊢
        rw [h0_eq] at hf
        dsimp [F_base]
        refine Eq.trans ?_ hf
        refine Finset.sum_congr rfl (fun s _ => Finset.sum_congr rfl (fun t _ => ?_))
        rw [update_consTorus_succ, update_consTorus_succ]
      obtain ⟨A_base, hA_base⟩ :=
        discrete_torus_closed_2cochain_exact_aux d L' F_base hFbase_skew hFbase_closed hFbase_flux
      let A2 : Fin (d + 1) → DiscreteTorus (d + 1) L → ℝ := fun μ p =>
        Fin.cases (0 : ℝ) (fun i => A_base i (tailTorus p)) μ
      have hA2_0 : ∀ p, A2 0 p = 0 := fun _ => rfl
      have hA2_succ : ∀ (i : Fin d) p, A2 i.succ p = A_base i (tailTorus p) := fun _ _ => rfl
      have hD1_A2_0_succ : ∀ (i : Fin d) (p : DiscreteTorus (d + 1) L),
          torusD1 A2 0 i.succ p = 0 := by
        intro i p
        rw [← consTorus_eta p]
        unfold torusD1
        rw [consTorus_add_step0, consTorus_add_step_succ, hA2_0, hA2_0, hA2_succ, hA2_succ]
        simp only [tailTorus_cons]
        ring
      have hD1_A2_succ_succ : ∀ (i j : Fin d) (p : DiscreteTorus (d + 1) L),
          torusD1 A2 i.succ j.succ p = F1 i.succ j.succ p := by
        intro i j p
        rw [← consTorus_eta p]
        have hD : torusD1 A2 i.succ j.succ (consTorus (p 0) (tailTorus p)) =
            torusD1 A_base i j (tailTorus p) := by
          unfold torusD1
          rw [consTorus_add_step_succ, consTorus_add_step_succ, hA2_succ, hA2_succ, hA2_succ, hA2_succ]
          simp only [tailTorus_cons]
        rw [hD, hA_base]
        exact (hF1_indep i j (p 0) (tailTorus p)).symm
      -- Step 4: Combine A_ct := A0 + A1 + A2
      let A_ct : Fin (d + 1) → DiscreteTorus (d + 1) L → ℝ :=
        fun μ p => A0 μ p + (A1 μ p + A2 μ p)
      refine ⟨A_ct, ?_⟩
      funext μ ν p
      have hlin : torusD1 A_ct μ ν p =
          torusD1 A0 μ ν p + (torusD1 A1 μ ν p + torusD1 A2 μ ν p) := by
        rw [torusD1_add A0 (fun α q => A1 α q + A2 α q), torusD1_add A1 A2]
      rw [hlin]
      refine Fin.cases ?_ (fun i => ?_) μ <;> refine Fin.cases ?_ (fun j => ?_) ν
      · rw [(torusD1_skew_and_d2_zero A0).1 0 0 p, (torusD1_skew_and_d2_zero A1).1 0 0 p,
          (torusD1_skew_and_d2_zero A2).1 0 0 p]
        have h00 : F 0 0 p = 0 := isSkew_diag_zero hskew 0 p
        linarith [show torusD1 A0 0 0 p = 0 by unfold torusD1; ring,
          show torusD1 A1 0 0 p = 0 by unfold torusD1; ring,
          show torusD1 A2 0 0 p = 0 by unfold torusD1; ring]
      · rw [hD1_A1_0_succ j p, hD1_A2_0_succ j p]
        dsimp [F1]
        ring
      · have h0i_A0 : torusD1 A0 i.succ 0 p = -torusD1 A0 0 i.succ p :=
          (torusD1_skew_and_d2_zero A0).1 0 i.succ p
        have h0i_A1 : torusD1 A1 i.succ 0 p = -torusD1 A1 0 i.succ p :=
          (torusD1_skew_and_d2_zero A1).1 0 i.succ p
        have h0i_A2 : torusD1 A2 i.succ 0 p = -torusD1 A2 0 i.succ p :=
          (torusD1_skew_and_d2_zero A2).1 0 i.succ p
        rw [h0i_A0, h0i_A1, h0i_A2, hD1_A1_0_succ i p, hD1_A2_0_succ i p, hskew 0 i.succ p]
        dsimp [F1]
        ring
      · rw [hD1_A1_succ_succ i j p, hD1_A2_succ_succ i j p]
        dsimp [F1]
        ring

end TorusH2InductiveConstruction

/-- **Discrete `T^d` `H^2` Exactness Theorem (`[C/B]`)**:
On any discrete `d`-dimensional periodic torus `DiscreteTorus d L` (`L_μ ≥ 1` for all `μ`):
1. A 2-cochain `F` is a global gauge-field coboundary `F = torusD1 A_ct` **if and only if** `F` is
   skew-symmetric (`IsSkew2Cochain F`), closed (`torusD2 F = 0`), and all fundamental 2-cycle Chern
   fluxes vanish (`∀ μ ≠ ν, chernFlux2 F μ ν 0 = 0`, equivalently at every basepoint `x`).
2. Any two gauge counterterms `A_1, A_2` for the same `F` differ by a flat 1-cochain
   `torusD1 (A_1 - A_2) = 0`, which is pure gauge `A_1 - A_2 = torusD0 Φ` iff all Polyakov loops
   of `A_1 - A_2` vanish (`Round04ChiralHodge.discrete_torus_flat_cochain_coboundary_iff_zero_polyakov`). -/
theorem discrete_torus_closed_2cochain_exact_iff_zero_chern_flux
    (d : ℕ) (L : Fin d → ℕ) [∀ μ, NeZero (L μ)]
    (F : Fin d → Fin d → DiscreteTorus d L → ℝ) :
    (IsSkew2Cochain F ∧ (∀ μ ν ρ x, torusD2 F μ ν ρ x = 0) ∧
      (∀ μ ν, μ ≠ ν → chernFlux2 F μ ν 0 = 0)) ↔
    (∃ A_ct : Fin d → DiscreteTorus d L → ℝ, torusD1 A_ct = F) ∧
    (∀ μ ν x, μ ≠ ν → chernFlux2 F μ ν x = 0) ∧
    (∀ A1 A2 : Fin d → DiscreteTorus d L → ℝ,
      torusD1 A1 = F → torusD1 A2 = F →
      ((∀ μ ν x, torusD1 (fun μ x => A1 μ x - A2 μ x) μ ν x = 0) ∧
        ((∀ μ, polyakovSum (fun μ x => A1 μ x - A2 μ x) μ 0 = 0) ↔
          ∃ Φ : DiscreteTorus d L → ℝ, (fun μ x => A1 μ x - A2 μ x) = torusD0 Φ))) := by
  constructor
  · rintro ⟨hskew, hclosed, hflux⟩
    obtain ⟨A_ct, hAct⟩ := discrete_torus_closed_2cochain_exact_aux d L F hskew hclosed hflux
    refine ⟨⟨A_ct, hAct⟩, ?_, ?_⟩
    · intro μ ν x hne
      rw [chernFlux2_eq_base hclosed hne x, hflux μ ν hne]
    · intro A1 A2 h1 h2
      have hflat : ∀ μ ν x, torusD1 (fun μ x => A1 μ x - A2 μ x) μ ν x = 0 := by
        intro μ ν x
        have hd1 := congrFun (congrFun (congrFun h1 μ) ν) x
        have hd2 := congrFun (congrFun (congrFun h2 μ) ν) x
        unfold torusD1 at hd1 hd2 ⊢
        linarith
      refine ⟨hflat, ?_⟩
      have hdg := discrete_torus_flat_cochain_coboundary_iff_zero_polyakov d L
        (fun μ x => A1 μ x - A2 μ x)
      constructor
      · intro hp
        exact (hdg.mp ⟨hflat, hp⟩).1
      · intro hcob
        exact (hdg.mpr ⟨hcob, ⟨hflat, fun μ x => by
          rcases hcob with ⟨Φ, hΦ⟩
          rw [hΦ]
          exact (torusD1_and_polyakov_zero_of_coboundary Φ).2 μ x⟩,
          fun Φ1 Φ2 ha hb x => discrete_torus_zero_d0_const (ha.trans hb.symm) x⟩).2
  · rintro ⟨⟨A_ct, rfl⟩, _, _⟩
    have ht := torusD1_skew_and_d2_zero A_ct
    exact ⟨ht.1, ht.2.1, fun μ ν hne => ht.2.2 μ ν 0 hne⟩

/-- **Modulo-`2πℤ` Berry Counterterm Exactness iff Quantized 2-Cycle Chern Fluxes (`[C/B]`)**:
On any discrete `d`-dimensional torus `DiscreteTorus d L`:
1. `F_Berry` admits a local 1-form gauge counterterm `A_ct` modulo `2πℤ` quantized closed Wu–Yang fluxes
   (`ModTwoPiExact2Cochain F_Berry`) **if and only if** `F_Berry` is skew-symmetric, closed
   (`torusD2 F_Berry = 0`), and all 2-cycle Chern fluxes lie in `2πℤ`
   (`∀ μ ≠ ν, ∃ k : ℤ, chernFlux2 F_Berry μ ν 0 = 2 * π * k`, equivalently
   `exp(i chernFlux2 F_Berry μ ν x) = 1`).
2. Whenever `ModTwoPiExact2Cochain F_Berry` holds with `(A_ct, n_flux)`, the plaquette `U(1)` Berry
   phase equals the counterterm holonomy phase:
   `∀ μ ν x, exp(i F_Berry μ ν x) = exp(i (torusD1 A_ct) μ ν x)`. -/
theorem discrete_torus_berry_counterterm_mod2pi_iff_quantized_chern_flux
    (d : ℕ) (L : Fin d → ℕ) [∀ μ, NeZero (L μ)]
    (F_Berry : Fin d → Fin d → DiscreteTorus d L → ℝ) :
    ((IsSkew2Cochain F_Berry ∧ (∀ μ ν ρ x, torusD2 F_Berry μ ν ρ x = 0) ∧
        (∀ μ ν, μ ≠ ν → ∃ k : ℤ, chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k : ℝ))) ↔
      ModTwoPiExact2Cochain F_Berry) ∧
    ((∀ μ ν ρ x, torusD2 F_Berry μ ν ρ x = 0) →
      ((∀ μ ν, μ ≠ ν → ∃ k : ℤ, chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k : ℝ)) ↔
        (∀ μ ν x, μ ≠ ν → Complex.exp (Complex.I * (chernFlux2 F_Berry μ ν x : ℂ)) = 1))) ∧
    (ModTwoPiExact2Cochain F_Berry →
      ∃ A_ct : Fin d → DiscreteTorus d L → ℝ,
        ∀ μ ν x,
          Complex.exp (Complex.I * (F_Berry μ ν x : ℂ)) =
            Complex.exp (Complex.I * (torusD1 A_ct μ ν x : ℂ))) := by
  have hiff :
      (IsSkew2Cochain F_Berry ∧ (∀ μ ν ρ x, torusD2 F_Berry μ ν ρ x = 0) ∧
        (∀ μ ν, μ ≠ ν → ∃ k : ℤ, chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k : ℝ))) ↔
      ModTwoPiExact2Cochain F_Berry := by
    classical
    constructor
    · rintro ⟨hskew, hclosed, hflux⟩
      let k_raw : Fin d → Fin d → ℤ := fun μ ν =>
        if h : μ ≠ ν then Classical.choose (hflux μ ν h) else 0
      have hk_raw : ∀ μ ν (h : μ ≠ ν),
          chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k_raw μ ν : ℝ) := by
        intro μ ν h
        dsimp [k_raw]
        rw [dif_pos h]
        exact Classical.choose_spec (hflux μ ν h)
      let k_skew : Fin d → Fin d → ℤ := fun μ ν =>
        if μ < ν then k_raw μ ν else if ν < μ then -k_raw ν μ else 0
      have hk_skew_symm : ∀ μ ν, k_skew ν μ = -k_skew μ ν := by
        intro μ ν
        rcases lt_trichotomy μ ν with hlt | heq | hgt
        · have hnot : ¬ ν < μ := not_lt_of_gt hlt
          dsimp [k_skew]
          rw [if_pos hlt, if_neg hnot, if_pos hlt]
        · subst heq
          dsimp [k_skew]
          simp
        · have hnot : ¬ μ < ν := not_lt_of_gt hgt
          dsimp [k_skew]
          rw [if_pos hgt, if_neg hnot, if_pos hgt]
          ring
      have hk_skew_flux : ∀ μ ν, μ ≠ ν →
          chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k_skew μ ν : ℝ) := by
        intro μ ν hne
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · dsimp [k_skew]
          rw [if_pos hlt]
          exact hk_raw μ ν hne
        · have hnot : ¬ μ < ν := not_lt_of_gt hgt
          dsimp [k_skew]
          rw [if_neg hnot, if_pos hgt]
          have hanti : chernFlux2 F_Berry μ ν 0 = -chernFlux2 F_Berry ν μ 0 := by
            unfold chernFlux2
            simp_rw [hskew ν μ]
            simp only [Finset.sum_neg_distrib]
            rw [Finset.sum_comm]
            congr 1
            refine Finset.sum_congr rfl (fun t _ => Finset.sum_congr rfl (fun s _ => ?_))
            rw [update_comm_ne 0 hne s t]
          rw [hanti, hk_raw ν μ hne.symm]
          push_cast
          ring
      let n_flux : Fin d → Fin d → DiscreteTorus d L → ℤ := fun μ ν x =>
        if x μ = 0 ∧ x ν = 0 then k_skew μ ν else 0
      have hn_skew : IsSkew2Cochain (fun μ ν x => (n_flux μ ν x : ℝ)) := by
        intro μ ν x
        dsimp [n_flux]
        by_cases hcond : x ν = 0 ∧ x μ = 0
        · have hcond' : x μ = 0 ∧ x ν = 0 := ⟨hcond.2, hcond.1⟩
          rw [if_pos hcond, if_pos hcond', hk_skew_symm]
          push_cast; ring
        · have hcond' : ¬ (x μ = 0 ∧ x ν = 0) := fun h => hcond ⟨h.2, h.1⟩
          rw [if_neg hcond, if_neg hcond']
          simp
      have hn_closed : ∀ μ ν ρ x, torusD2 (fun μ ν x => (n_flux μ ν x : ℝ)) μ ν ρ x = 0 := by
        intro μ ν ρ x
        by_cases hμν : μ = ν
        · exact torusD2_eq_zero_of_eq hn_skew (Or.inl hμν) x
        · by_cases hμρ : μ = ρ
          · exact torusD2_eq_zero_of_eq hn_skew (Or.inr (Or.inl hμρ)) x
          · by_cases hνρ : ν = ρ
            · exact torusD2_eq_zero_of_eq hn_skew (Or.inr (Or.inr hνρ)) x
            · unfold torusD2
              have h1 : n_flux ν ρ (x + torusStep (L := L) μ) = n_flux ν ρ x := by
                have hμ1 : (x + torusStep (L := L) μ) ν = x ν := by simp [Ne.symm hμν]
                have hμ2 : (x + torusStep (L := L) μ) ρ = x ρ := by simp [Ne.symm hμρ]
                dsimp only [n_flux]
                exact if_congr (by rw [hμ1, hμ2]) rfl rfl
              have h2 : n_flux μ ρ (x + torusStep (L := L) ν) = n_flux μ ρ x := by
                have hν1 : (x + torusStep (L := L) ν) μ = x μ := by simp [hμν]
                have hν2 : (x + torusStep (L := L) ν) ρ = x ρ := by simp [Ne.symm hνρ]
                dsimp only [n_flux]
                exact if_congr (by rw [hν1, hν2]) rfl rfl
              have h3 : n_flux μ ν (x + torusStep (L := L) ρ) = n_flux μ ν x := by
                have hρ1 : (x + torusStep (L := L) ρ) μ = x μ := by simp [hμρ]
                have hρ2 : (x + torusStep (L := L) ρ) ν = x ν := by simp [hνρ]
                dsimp only [n_flux]
                exact if_congr (by rw [hρ1, hρ2]) rfl rfl
              change ((n_flux ν ρ (x + torusStep (L := L) μ) : ℝ) - (n_flux ν ρ x : ℝ)) -
                ((n_flux μ ρ (x + torusStep (L := L) ν) : ℝ) - (n_flux μ ρ x : ℝ)) +
                ((n_flux μ ν (x + torusStep (L := L) ρ) : ℝ) - (n_flux μ ν x : ℝ)) = 0
              rw [h1, h2, h3]
              ring
      have hn_flux : ∀ μ ν, μ ≠ ν →
          chernFlux2 (fun μ ν x => (n_flux μ ν x : ℝ)) μ ν 0 = (k_skew μ ν : ℝ) := by
        intro μ ν hne
        unfold chernFlux2
        have hs0 : ∀ s : ZMod (L μ),
            (∑ t : ZMod (L ν), (n_flux μ ν (Function.update (Function.update 0 μ s) ν t) : ℝ)) =
              if s = 0 then (k_skew μ ν : ℝ) else 0 := by
          intro s
          by_cases hs : s = 0
          · subst hs
            rw [if_pos rfl]
            rw [Finset.sum_eq_single (0 : ZMod (L ν))]
            · dsimp [n_flux]
              have h01 : Function.update (Function.update (0 : DiscreteTorus d L) μ 0) ν 0 μ = 0 := by
                simp [hne]
              have h02 : Function.update (Function.update (0 : DiscreteTorus d L) μ 0) ν 0 ν = 0 := by
                simp
              rw [if_pos ⟨h01, h02⟩]
            · intro t _ ht
              dsimp [n_flux]
              have ht_ne : ¬ (Function.update (Function.update (0 : DiscreteTorus d L) μ 0) ν t μ = 0 ∧
                  Function.update (Function.update (0 : DiscreteTorus d L) μ 0) ν t ν = 0) := by
                intro h
                exact ht (by simpa using h.2)
              rw [if_neg ht_ne]
              exact Int.cast_zero
            · intro h; exact absurd (Finset.mem_univ 0) h
          · rw [if_neg hs]
            refine Finset.sum_eq_zero (fun t _ => ?_)
            dsimp [n_flux]
            have hs_ne : ¬ (Function.update (Function.update (0 : DiscreteTorus d L) μ s) ν t μ = 0 ∧
                Function.update (Function.update (0 : DiscreteTorus d L) μ s) ν t ν = 0) := by
              intro h
              have h1 := h.1
              simp [hne] at h1
              exact hs h1
            rw [if_neg hs_ne]
            exact Int.cast_zero
        simp_rw [hs0]
        simp
      let F_shift : Fin d → Fin d → DiscreteTorus d L → ℝ :=
        fun μ ν x => F_Berry μ ν x - 2 * Real.pi * (n_flux μ ν x : ℝ)
      have hshift_skew : IsSkew2Cochain F_shift := by
        intro μ ν x
        dsimp [F_shift]
        have hn := hn_skew μ ν x
        dsimp only at hn
        rw [hskew μ ν x, hn]
        ring
      have hshift_closed : ∀ μ ν ρ x, torusD2 F_shift μ ν ρ x = 0 := by
        intro μ ν ρ x
        dsimp [F_shift]
        have hlin : torusD2 (fun α β p => F_Berry α β p - 2 * Real.pi * (n_flux α β p : ℝ)) μ ν ρ x =
            torusD2 F_Berry μ ν ρ x -
              2 * Real.pi * torusD2 (fun α β p => (n_flux α β p : ℝ)) μ ν ρ x := by
          unfold torusD2
          ring
        rw [hlin, hclosed μ ν ρ x, hn_closed μ ν ρ x]
        ring
      have hshift_flux : ∀ μ ν, μ ≠ ν → chernFlux2 F_shift μ ν 0 = 0 := by
        intro μ ν hne
        dsimp [F_shift]
        have hlin : chernFlux2 (fun α β p => F_Berry α β p - 2 * Real.pi * (n_flux α β p : ℝ)) μ ν 0 =
            chernFlux2 F_Berry μ ν 0 -
              2 * Real.pi * chernFlux2 (fun α β p => (n_flux α β p : ℝ)) μ ν 0 := by
          unfold chernFlux2
          simp_rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
        rw [hlin, hk_skew_flux μ ν hne, hn_flux μ ν hne]
        ring
      obtain ⟨A_ct, hAct⟩ :=
        ((discrete_torus_closed_2cochain_exact_iff_zero_chern_flux d L F_shift).mp
          ⟨hshift_skew, hshift_closed, hshift_flux⟩).1
      refine ⟨A_ct, n_flux, hn_skew, hn_closed, fun μ ν x => ?_⟩
      have hd := congrFun (congrFun (congrFun hAct μ) ν) x
      dsimp [F_shift] at hd
      linarith
    · rintro ⟨A_ct, n_flux, hn_skew, hn_closed, hF_eq⟩
      have hd1 := torusD1_skew_and_d2_zero (L := L) A_ct
      refine ⟨?_, ?_, ?_⟩
      · intro μ ν x
        have hn := hn_skew μ ν x
        dsimp only at hn
        rw [hF_eq ν μ x, hF_eq μ ν x, hd1.1 μ ν x, hn]
        ring
      · intro μ ν ρ x
        have hF_fun : F_Berry = fun α β p => torusD1 A_ct α β p + 2 * Real.pi * (n_flux α β p : ℝ) := by
          funext α β p; exact hF_eq α β p
        rw [hF_fun]
        have hlin : torusD2 (fun α β p => torusD1 A_ct α β p + 2 * Real.pi * (n_flux α β p : ℝ)) μ ν ρ x =
            torusD2 (torusD1 A_ct) μ ν ρ x +
              2 * Real.pi * torusD2 (fun α β p => (n_flux α β p : ℝ)) μ ν ρ x := by
          unfold torusD2
          ring
        rw [hlin, hd1.2.1 μ ν ρ x, hn_closed μ ν ρ x]
        ring
      · intro μ ν hne
        have hF_fun : F_Berry = fun α β p => torusD1 A_ct α β p + 2 * Real.pi * (n_flux α β p : ℝ) := by
          funext α β p; exact hF_eq α β p
        rw [hF_fun]
        have hlin : chernFlux2 (fun α β p => torusD1 A_ct α β p + 2 * Real.pi * (n_flux α β p : ℝ)) μ ν 0 =
            chernFlux2 (torusD1 A_ct) μ ν 0 +
              2 * Real.pi * chernFlux2 (fun α β p => (n_flux α β p : ℝ)) μ ν 0 := by
          unfold chernFlux2
          simp_rw [Finset.sum_add_distrib, ← Finset.mul_sum]
        rw [hlin, hd1.2.2 μ ν 0 hne, zero_add]
        refine ⟨∑ s : ZMod (L μ), ∑ t : ZMod (L ν),
            n_flux μ ν (Function.update (Function.update 0 μ s) ν t), ?_⟩
        unfold chernFlux2
        push_cast
        rfl
  have hexp_iff : (∀ μ ν ρ x, torusD2 F_Berry μ ν ρ x = 0) →
      ((∀ μ ν, μ ≠ ν → ∃ k : ℤ, chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k : ℝ)) ↔
        (∀ μ ν x, μ ≠ ν → Complex.exp (Complex.I * (chernFlux2 F_Berry μ ν x : ℂ)) = 1)) := by
    intro hclosed
    constructor
    · intro hflux μ ν x hne
      rw [chernFlux2_eq_base hclosed hne x]
      rcases hflux μ ν hne with ⟨k, hk⟩
      rw [hk]
      have harg : Complex.I * ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ) =
          (k : ℂ) * (2 * Real.pi * Complex.I) := by push_cast; ring
      rw [harg, Complex.exp_eq_one_iff]
      exact ⟨k, rfl⟩
    · intro hexp μ ν hne
      have h0 := hexp μ ν 0 hne
      rw [Complex.exp_eq_one_iff] at h0
      rcases h0 with ⟨k, hk⟩
      have hc : (chernFlux2 F_Berry μ ν 0 : ℂ) = (2 * Real.pi * (k : ℝ) : ℂ) := by
        apply mul_left_cancel₀ Complex.I_ne_zero
        calc
          Complex.I * (chernFlux2 F_Berry μ ν 0 : ℂ)
              = (k : ℂ) * (2 * Real.pi * Complex.I) := hk
          _ = Complex.I * (2 * Real.pi * (k : ℝ) : ℂ) := by push_cast; ring
      push_cast at hc
      exact ⟨k, Complex.ofReal_injective (by exact_mod_cast hc)⟩
  have hphase : ModTwoPiExact2Cochain F_Berry →
      ∃ A_ct : Fin d → DiscreteTorus d L → ℝ,
        ∀ μ ν x,
          Complex.exp (Complex.I * (F_Berry μ ν x : ℂ)) =
            Complex.exp (Complex.I * (torusD1 A_ct μ ν x : ℂ)) := by
    rintro ⟨A_ct, n_flux, _, _, hF_eq⟩
    refine ⟨A_ct, fun μ ν x => ?_⟩
    rw [hF_eq μ ν x]
    have harg : Complex.I * ((torusD1 A_ct μ ν x + 2 * Real.pi * (n_flux μ ν x : ℝ) : ℝ) : ℂ) =
        Complex.I * (torusD1 A_ct μ ν x : ℂ) + (n_flux μ ν x : ℂ) * (2 * Real.pi * Complex.I) := by
      push_cast; ring
    rw [harg, Complex.exp_add]
    have h1 : Complex.exp ((n_flux μ ν x : ℂ) * (2 * Real.pi * Complex.I)) = 1 :=
      Complex.exp_eq_one_iff.mpr ⟨n_flux μ ν x, rfl⟩
    rw [h1, mul_one]
  exact ⟨hiff, hexp_iff, hphase⟩

/-- **4D `T^4` Berry Curvature `H^2` Descent & Counterterm Exactness (`[C/B]`)**:
Specializes exact and modulo-`2πℤ` 2-cochain Hodge descent to 4D Euclidean lattice `T^4` (`Fin 4`),
showing that exact counterterm `F_Berry = torusD1 A_ct` holds iff all 6 fundamental 2-planes
`μ < ν : Fin 4` have vanishing Chern flux, while modulo-`2πℤ` counterterm exactness
(`ModTwoPiExact2Cochain F_Berry`, giving `exp(i F_Berry) = exp(i torusD1 A_ct)`) holds iff all
6 fundamental 2-plane Chern fluxes lie in `2πℤ`. `[C/B]` -/
theorem discrete_t4_berry_curvature_h2_descent_and_counterterm
    (L : Fin 4 → ℕ) [∀ μ, NeZero (L μ)]
    (F_Berry : Fin 4 → Fin 4 → DiscreteTorus 4 L → ℝ) :
    ((IsSkew2Cochain F_Berry ∧ (∀ μ ν ρ x, torusD2 F_Berry μ ν ρ x = 0) ∧
        (∀ μ ν : Fin 4, μ < ν → chernFlux2 F_Berry μ ν 0 = 0)) ↔
      (∃ A_ct : Fin 4 → DiscreteTorus 4 L → ℝ, torusD1 A_ct = F_Berry)) ∧
    ((IsSkew2Cochain F_Berry ∧ (∀ μ ν ρ x, torusD2 F_Berry μ ν ρ x = 0) ∧
        (∀ μ ν : Fin 4, μ < ν → ∃ k : ℤ, chernFlux2 F_Berry μ ν 0 = 2 * Real.pi * (k : ℝ))) ↔
      ModTwoPiExact2Cochain F_Berry) := by
  have hflux_anti : IsSkew2Cochain F_Berry → ∀ μ ν : Fin 4,
      chernFlux2 F_Berry ν μ 0 = -chernFlux2 F_Berry μ ν 0 := by
    intro hskew μ ν
    by_cases hne : ν = μ
    · subst hne
      unfold chernFlux2
      simp [isSkew_diag_zero hskew ν]
    · unfold chernFlux2
      simp_rw [hskew μ ν]
      simp only [Finset.sum_neg_distrib]
      rw [Finset.sum_comm]
      congr 1
      refine Finset.sum_congr rfl (fun t _ => Finset.sum_congr rfl (fun s _ => ?_))
      rw [update_comm_ne 0 (Ne.symm hne) t s]
  refine ⟨?_, ?_⟩
  · have hex := discrete_torus_closed_2cochain_exact_iff_zero_chern_flux 4 L F_Berry
    constructor
    · rintro ⟨hskew, hclosed, hlt⟩
      refine (hex.mp ⟨hskew, hclosed, fun μ ν hne => ?_⟩).1
      rcases lt_or_gt_of_ne hne with h1 | h2
      · exact hlt μ ν h1
      · rw [hflux_anti hskew ν μ, hlt ν μ h2, neg_zero]
    · intro hexA
      have hl := hex.mpr ⟨hexA, fun μ ν x hne => by
        rcases hexA with ⟨A_ct, rfl⟩
        exact (torusD1_skew_and_d2_zero A_ct).2.2 μ ν x hne,
        fun A1 A2 h1 h2 => by
          have hd := (hex.mp ⟨by
            rcases hexA with ⟨A, rfl⟩; exact (torusD1_skew_and_d2_zero A).1,
            by rcases hexA with ⟨A, rfl⟩; exact (torusD1_skew_and_d2_zero A).2.1,
            fun μ ν hne => by rcases hexA with ⟨A, rfl⟩; exact (torusD1_skew_and_d2_zero A).2.2 μ ν 0 hne⟩).2.2 A1 A2 h1 h2
          exact hd⟩
      exact ⟨hl.1, hl.2.1, fun μ ν hlt => hl.2.2 μ ν (ne_of_lt hlt)⟩
  · have hmod := (discrete_torus_berry_counterterm_mod2pi_iff_quantized_chern_flux 4 L F_Berry).1
    constructor
    · rintro ⟨hskew, hclosed, hlt⟩
      refine hmod.mp ⟨hskew, hclosed, fun μ ν hne => ?_⟩
      rcases lt_or_gt_of_ne hne with h1 | h2
      · exact hlt μ ν h1
