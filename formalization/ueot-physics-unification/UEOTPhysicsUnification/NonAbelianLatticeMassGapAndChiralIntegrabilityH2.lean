/-- **Track 1A Adapter Theorem (`[C/B/P/X]`)**:
`BalabanSmallFieldGaugeRegularityPremise` directly inhabits `H2dUVIrreduciblePillar` while
simultaneously proving positive compact Haar Bakry–Émery curvature `CD(ρ_tot, ∞)` and small-field
Gribov-horizon avoidance (`0 < det M_FP(k)`) at every RG scale `k`. -/
theorem round05_uv_haar_to_h2d_uv_pillar
    {N d_lie N_fp : ℕ} {V : Type} {M_n : ℕ → Matrix (Fin N) (Fin N) ℝ}
    (hUV : BalabanSmallFieldGaugeRegularityPremise (N := N) (d_lie := d_lie) (N_fp := N_fp) V M_n) :
    Nonempty (H2dUVIrreduciblePillar (uvHaarToUVContext hUV)) ∧
    (∀ k : ℕ, 0 < (hUV.curvData k).rhoTot ∧
      1 / (hUV.curvData k).rhoTot ≤ 1 / (hUV.curvData k).rhoHaar ∧
      2 / (hUV.curvData k).rhoTot ≤ 2 / (hUV.curvData k).rhoHaar) ∧
    (∀ k : ℕ, 0 < (hUV.fpBase k + hUV.fpPert k).det) := by
  refine ⟨⟨uvHaarToUVPillar hUV⟩, fun k => ?_, fun k => ?_⟩
  · exact (compact_lie_slice_curvature_additive (hUV.curvData k)).2.1 (hUV.curv_haar_pos k)
  · exact (small_field_gribov_ball_avoids_horizon (hUV.fpBase k) (hUV.fpPert k)
      (hUV.fpBase_symm k) (hUV.fpPert_symm k) (hUV.lambda1_pos k) (hUV.gamma_nonneg k)
      (hUV.gamma_lt_lambda1 k) (hUV.fpBase_coerc k) (hUV.fpPert_row k)).2.1

