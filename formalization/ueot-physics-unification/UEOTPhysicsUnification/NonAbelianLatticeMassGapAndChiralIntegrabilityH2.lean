/-! ## Part 3: Non-Perturbative `SO(4)` Restoration & Conditional Continuum OS Gap (`[C/B/P/X]`) -/

/-- Orthogonal 4×4 matrix (`O(4)`). `[C]` -/
def O4Matrix (R : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  Rᵀ * R = 1 ∧ R * Rᵀ = 1

/-- Special orthogonal 4×4 matrix (`SO(4)`). `[C]` -/
def SO4Matrix (R : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  O4Matrix R ∧ R.det = 1

lemma o4_preserves_norm_sq {R : Matrix (Fin 4) (Fin 4) ℝ} (hR : O4Matrix R) (p : Fin 4 → ℝ) :
    ∑ μ : Fin 4, (R.mulVec p μ) ^ 2 = ∑ μ : Fin 4, p μ ^ 2 := by
  have hdot : dotProduct (R.mulVec p) (R.mulVec p) = dotProduct p p := by
    calc dotProduct (R.mulVec p) (R.mulVec p)
        = dotProduct (p ᵥ* Rᵀ) (R.mulVec p) := by rw [Matrix.vecMul_transpose]
      _ = dotProduct p (Rᵀ.mulVec (R.mulVec p)) := (dotProduct_mulVec p Rᵀ (R.mulVec p)).symm
      _ = dotProduct p ((Rᵀ * R).mulVec p) := by rw [Matrix.mulVec_mulVec]
      _ = dotProduct p p := by rw [hR.1, Matrix.one_mulVec]
  simpa [dotProduct, sq] using hdot

/-- Hypercubic lattice dispersion / effective 2-point quadratic-plus-quartic `H(4)` form at
lattice spacing `a`. `[B/P]` -/
def h4LatticeDispersion
    (T_0 : Fin 4 → Fin 4 → ℝ) (Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ)
    (a : ℝ) (p : Fin 4 → ℝ) : ℝ :=
  (∑ μ : Fin 4, ∑ ν : Fin 4, T_0 μ ν * p μ * p ν) +
    a ^ 2 * (∑ μ : Fin 4, ∑ ν : Fin 4, ∑ ρ : Fin 4, ∑ σ : Fin 4, Q μ ν ρ σ * p μ * p ν * p ρ * p σ)

/-- **Exact `H(4)` `O(a^2)` Momentum-Space Rotational Breaking Bound (`[C/B/P]`)**:
1. Using `cubic_h4_isotropy_rank2_and_rank4_tensor_decomposition`, for ANY `H4Invariant2 T_0`, ANY
   `H4Invariant4 Q`, and ANY `R ∈ O(4)` (in particular `SO(4)`), the `O(a^0)` term and the three
   `SO(4)`-isotropic rank-4 pairings cancel **identically** under `p ↦ R.mulVec p`, leaving only
   the `c_4 * a^2` hypercubic diagonal defect `|c_4| * a^2 * (∑ p_μ^2)^2`.
2. At `p_0 = ![1, 0, 0, 0]` and `R = hadamardSO4` (`SO4Matrix hadamardSO4`), the exact rotation
   defect is `-(3 / 4) * a^2 * c_4` (non-vanishing at finite `a ≠ 0` when `c_4 ≠ 0`, vanishing as `a → 0`). -/
theorem h4_momentum_rotation_anisotropy_bound
    (T_0 : Fin 4 → Fin 4 → ℝ) (hT0 : H4Invariant2 T_0)
    (Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ) (hQ : H4Invariant4 Q)
    (a : ℝ) (p : Fin 4 → ℝ) :
    let c4 := Q 0 0 0 0 - (Q 0 0 1 1 + Q 0 1 0 1 + Q 0 1 1 0)
    (∀ R : Matrix (Fin 4) (Fin 4) ℝ, O4Matrix R →
      |h4LatticeDispersion T_0 Q a (R.mulVec p) - h4LatticeDispersion T_0 Q a p| ≤
        |c4| * a ^ 2 * (∑ μ : Fin 4, p μ ^ 2) ^ 2) ∧
    (SO4Matrix hadamardSO4 ∧
      let p0 : Fin 4 → ℝ := ![1, 0, 0, 0]
      h4LatticeDispersion T_0 Q a (hadamardSO4.mulVec p0) - h4LatticeDispersion T_0 Q a p0 =
        -(3 / 4 : ℝ) * a ^ 2 * c4) := by
  intro c4
  have hiso := cubic_h4_isotropy_rank2_and_rank4_tensor_decomposition
  obtain ⟨c0, hc0, _⟩ := (hiso.1 T_0).mp hT0
  have hquad_eval : ∀ q : Fin 4 → ℝ,
      (∑ μ : Fin 4, ∑ ν : Fin 4, T_0 μ ν * q μ * q ν) = c0 * ∑ μ : Fin 4, q μ ^ 2 := by
    intro q
    have hterm : ∀ μ ν : Fin 4, T_0 μ ν * q μ * q ν = c0 * (if μ = ν then q μ * q ν else 0) := by
      intro μ ν
      rw [hc0 μ ν]
      by_cases h : μ = ν <;> simp [delta2, h]; ring
    simp_rw [hterm]
    simp [Finset.mul_sum, sq]
  have hdisp_eval : ∀ q : Fin 4 → ℝ,
      h4LatticeDispersion T_0 Q a q =
        c0 * (∑ μ : Fin 4, q μ ^ 2) +
          a ^ 2 * ((Q 0 0 1 1 + Q 0 1 0 1 + Q 0 1 1 0) * (∑ μ : Fin 4, q μ ^ 2) ^ 2 +
            c4 * ∑ μ : Fin 4, q μ ^ 4) := by
    intro q
    dsimp [h4LatticeDispersion]
    rw [hquad_eval q, (hiso.2.2.2.2.2 Q hQ a q).1]
  refine ⟨fun R hR => ?_, ?_⟩
  · rw [hdisp_eval (R.mulVec p), hdisp_eval p, o4_preserves_norm_sq hR p]
    have hdiff :
        (c0 * (∑ μ : Fin 4, p μ ^ 2) +
          a ^ 2 * ((Q 0 0 1 1 + Q 0 1 0 1 + Q 0 1 1 0) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 +
            c4 * ∑ μ : Fin 4, (R.mulVec p μ) ^ 4)) -
        (c0 * (∑ μ : Fin 4, p μ ^ 2) +
          a ^ 2 * ((Q 0 0 1 1 + Q 0 1 0 1 + Q 0 1 1 0) * (∑ μ : Fin 4, p μ ^ 2) ^ 2 +
            c4 * ∑ μ : Fin 4, p μ ^ 4)) =
        a ^ 2 * c4 * (∑ μ : Fin 4, (R.mulVec p μ) ^ 4 - ∑ μ : Fin 4, p μ ^ 4) := by ring
    rw [hdiff, abs_mul, abs_mul, abs_of_nonneg (sq_nonneg a)]
    have hp4_1 : 0 ≤ ∑ μ : Fin 4, p μ ^ 4 := Finset.sum_nonneg (fun μ _ => by positivity)
    have hp4_2 : 0 ≤ ∑ μ : Fin 4, (R.mulVec p μ) ^ 4 := Finset.sum_nonneg (fun μ _ => by positivity)
    have hle_1 : ∑ μ : Fin 4, p μ ^ 4 ≤ (∑ μ : Fin 4, p μ ^ 2) ^ 2 :=
      (hiso.2.2.2.2.2 Q hQ a p).2.2.1.2
    have hle_2 : ∑ μ : Fin 4, (R.mulVec p μ) ^ 4 ≤ (∑ μ : Fin 4, p μ ^ 2) ^ 2 := by
      have h := (hiso.2.2.2.2.2 Q hQ a (R.mulVec p)).2.2.1.2
      rwa [o4_preserves_norm_sq hR p] at h
    have habs_diff : |∑ μ : Fin 4, (R.mulVec p μ) ^ 4 - ∑ μ : Fin 4, p μ ^ 4| ≤
        (∑ μ : Fin 4, p μ ^ 2) ^ 2 := by
      rw [abs_le]
      constructor <;> linarith
    calc a ^ 2 * |c4| * |∑ μ : Fin 4, (R.mulVec p μ) ^ 4 - ∑ μ : Fin 4, p μ ^ 4|
        ≤ a ^ 2 * |c4| * (∑ μ : Fin 4, p μ ^ 2) ^ 2 :=
          mul_le_mul_of_nonneg_left habs_diff (mul_nonneg (sq_nonneg a) (abs_nonneg c4))
      _ = |c4| * a ^ 2 * (∑ μ : Fin 4, p μ ^ 2) ^ 2 := by ring
  · have hH := hadamardSO4_orth_and_det
    have hSO4 : SO4Matrix hadamardSO4 := ⟨⟨hH.2.1, hH.1⟩, hH.2.2⟩
    refine ⟨hSO4, ?_⟩
    intro p0
    rw [hdisp_eval (hadamardSO4.mulVec p0), hdisp_eval p0, o4_preserves_norm_sq hSO4.1 p0]
    have hp0_norm : ∑ μ : Fin 4, p0 μ ^ 2 = 1 := by
      simp [p0, Fin.sum_univ_four]
    have hp0_4 : ∑ μ : Fin 4, p0 μ ^ 4 = 1 := by
      simp [p0, Fin.sum_univ_four]
    have hRp0_4 : ∑ μ : Fin 4, (hadamardSO4.mulVec p0 μ) ^ 4 = 1 / 4 := by
      simp [p0, hadamardSO4, Matrix.mulVec, dotProduct, Fin.sum_univ_four]
      norm_num
    rw [hp0_norm, hp0_4, hRp0_4]
    ring

/-- **Conditional Non-Perturbative `SO(4)` Euclidean Restoration & Continuum OS Gap Bridge (`[C/B/P/X]`)**:
Combines:
- `Round04IRIsotropyCrossover` (`cubic_h4_isotropy_rank2_and_rank4_tensor_decomposition`, `ueot_rg_viability_crossover_obstruction_sharpening`),
- `Round04IRRGTransfer` (`physical_scale_rg_blocking_os_gap_transfer`), and
- Explicit `[X]` hypotheses (`noBulkTransition` / continuous positive `m_phys` on `[β_SC, β_UV]`,
  `ξ_lat(β) → ∞`, `m_all(β) ≥ m_global > 0`, bounded `H(4)` anisotropy coefficient `|c_4(β)| ≤ C_4`,
  and RG-blocked OS/GNS continuum limit)
to prove:
1. Uniform strictly positive physical mass gap `m_global > 0` across **all** `β ∈ (0, ∞)` and `T(β)^m` RP on `[β_SC, β_UV]`;
2. `a_lat(β) = 1 / (m_all(β) * ξ_lat(β)) → 0` as `β → ∞`;
3. **Non-perturbative `SO(4)` Euclidean invariance**: for every `R ∈ SO(4)` and every momentum `p`,
   the rotational difference `|S_lat β (R.mulVec p) - S_lat β p| → 0` as `β → ∞`, forcing
   `S_cont (R.mulVec p) = S_cont p` on the continuum limit;
4. Continuum OS reflection positivity, unique `QuotientDescent` GNS norm, uniform semigroup decay
   `⟨u, U(t) u⟩ ≤ ⟨u, u⟩ exp(-m_0 t)`, and continuum Hamiltonian mass gap `m_0 ⟨u, u⟩ ≤ ⟨u, H_op u⟩`;
5. Honest open status: `¬ wave11H2ConstructiveWitness.Satisfies .h2d_clay_4d_continuum_measure`,
   `¬ currentH2dRepoWitness.Satisfies .h2d_ir_uniform_clustering_os_gap`, and
   `physicalUnificationStatus (Fintype.card H2SubHypothesis) false = .OPEN`. -/
theorem nonperturbative_so4_restoration_and_continuum_os_gap_bridge
    {N_uv N_blk nT : ℕ} {V_uv V_blk V_test H_perp : Type*}
    [AddCommGroup H_perp] [Module ℝ H_perp]
    -- [P/B] Asymptotic-freedom RG parameters
    {Lambda c_AF ell_phys m_0 : ℝ} {L_blk : ℕ}
    (hLam : 0 < Lambda) (hcAF : 0 < c_AF) (hell : 0 < ell_phys) (hm0 : 0 < m_0)
    (hLblk : 2 ≤ L_blk)
    (a_rg : ℝ → ℝ) (ha_rg_def : ∀ β : ℝ, a_rg β * Lambda = Real.exp (-c_AF * β))
    -- [X] Crossover window & noBulkTransition gap continuity
    {β_SC β_UV m_SC m_UV : ℝ}
    (hβSC_pos : 0 < β_SC) (hβSC_lt : β_SC < 1) (hβUV_gt : 245 < β_UV)
    (hmSC : 0 < m_SC) (hmUV : 0 < m_UV)
    (T_win : ℝ → Matrix (Fin nT) (Fin nT) ℝ)
    (m_phys m_all : ℝ → ℝ)
    (hT_win_RP : ∀ β : ℝ, β ∈ Set.Icc β_SC β_UV →
      (T_win β)ᵀ = T_win β ∧ ∀ v : Fin nT → ℝ, 0 ≤ dotProduct v ((T_win β).mulVec v))
    (hm_cont : ContinuousOn m_phys (Set.Icc β_SC β_UV))
    (hm_pos_win : ∀ β : ℝ, β ∈ Set.Icc β_SC β_UV → 0 < m_phys β)
    (hm_left : ∀ β : ℝ, 0 < β → β ≤ β_SC → m_SC ≤ m_all β)
    (hm_mid : ∀ β : ℝ, β ∈ Set.Icc β_SC β_UV → m_phys β ≤ m_all β)
    (hm_right : ∀ β : ℝ, β_UV ≤ β → m_UV ≤ m_all β)
    -- [B/X] Correlation length ξ_lat(β) → ∞ + H(4)-invariant lattice observables → S_cont
    (ξ_lat : ℝ → ℝ)
    (hξ_pos : ∀ β : ℝ, 0 < β → 0 < ξ_lat β)
    (hξ_tend : Filter.Tendsto ξ_lat Filter.atTop Filter.atTop)
    (T_0 : ℝ → Fin 4 → Fin 4 → ℝ) (hT0_H4 : ∀ β : ℝ, H4Invariant2 (T_0 β))
    (Q : ℝ → Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ) (hQ_H4 : ∀ β : ℝ, H4Invariant4 (Q β))
    {C_4 C_rem : ℝ} (_hC4_nn : 0 ≤ C_4) (_hCrem_nn : 0 ≤ C_rem)
    (hc4_unif : ∀ β : ℝ, 0 < β →
      |Q β 0 0 0 0 - (Q β 0 0 1 1 + Q β 0 1 0 1 + Q β 0 1 1 0)| ≤ C_4)
    (S_lat : ℝ → (Fin 4 → ℝ) → ℝ) (S_cont : (Fin 4 → ℝ) → ℝ)
    (hS_lat_symanzik : ∀ (β : ℝ) (p : Fin 4 → ℝ), 0 < β →
      let a_phys := 1 / (m_all β * ξ_lat β)
      |S_lat β p - h4LatticeDispersion (T_0 β) (Q β) a_phys p| ≤
        C_rem * a_phys ^ 4 * (∑ μ : Fin 4, p μ ^ 2) ^ 3)
    (hS_lat_tend : ∀ p : Fin 4 → ℝ,
      Filter.Tendsto (fun β : ℝ => S_lat β p) Filter.atTop (nhds (S_cont p)))
    -- [C/B/X] Even-block hyperplane-RP RG transfer & continuum OS/GNS inputs
    (T_uv : Matrix (Fin N_uv) (Fin N_uv) ℝ) (hTuv_symm : T_uvᵀ = T_uv)
    (P_sp : Matrix (Fin N_uv) (Fin N_blk) ℝ)
    (Theta_uv : V_uv → V_uv) (pair_uv : V_uv → V_uv → ℝ)
    (hUV_RP : ∀ f : V_uv, 0 ≤ pair_uv (Theta_uv f) f)
    (Theta_blk : V_blk → V_blk) (pair_blk : V_blk → V_blk → ℝ)
    (ι_blk : V_blk → V_uv)
    (hTheta_intertwine : ∀ F : V_blk, Theta_uv (ι_blk F) = ι_blk (Theta_blk F))
    (hPair_pullback : ∀ F G : V_blk, pair_blk F G = pair_uv (ι_blk F) (ι_blk G))
    (β_seq : ℕ → ℝ) (K_seq : ℕ → ℕ)
    (hScale_seq : ∀ m : ℕ, ell_phys = (L_blk : ℝ) ^ (K_seq m) * a_rg (β_seq m))
    (m_blk : ℕ → ℝ) (hm_blk_lb : ∀ m : ℕ, m_0 * ell_phys ≤ m_blk m)
    (q_GNS : V_test → H_perp) (hq : Surjective q_GNS)
    (inner_perp : H_perp → H_perp → ℝ)
    (hSymm_in : ∀ u v : H_perp, inner_perp u v = inner_perp v u)
    (hAdd_in : ∀ u v w : H_perp, inner_perp u (v + w) = inner_perp u v + inner_perp u w)
    (hSmul_in : ∀ (a : ℝ) (u v : H_perp), inner_perp u (a • v) = a * inner_perp u v)
    (hInner_nn : ∀ u : H_perp, 0 ≤ inner_perp u u)
    (S_m : ℕ → V_test → ℝ → ℝ) (S_inf : V_test → ℝ → ℝ)
    (hTightWeak : ∀ (ψ : V_test) (t : ℝ), 0 ≤ t →
      Filter.Tendsto (fun m : ℕ => S_m m ψ t) Filter.atTop (nhds (S_inf ψ t)))
    (hOS_RP_m : ∀ (m : ℕ) (ψ : V_test), 0 ≤ S_m m ψ 0)
    (U : ℝ → H_perp → H_perp)
    (hGNS_id : ∀ (ψ : V_test) (t : ℝ), 0 ≤ t →
      S_inf ψ t = inner_perp (q_GNS ψ) (U t (q_GNS ψ)))
    (hU_zero : ∀ u : H_perp, U 0 u = u)
    (hU_add : ∀ s t : ℝ, 0 ≤ s → 0 ≤ t → ∀ u : H_perp, U (s + t) u = U s (U t u))
    (hU_symm : ∀ t : ℝ, 0 ≤ t → ∀ u v : H_perp,
      inner_perp u (U t v) = inner_perp (U t u) v)
    (hBlkCluster : ∀ ψ : V_test, ∃ C_ψ : ℝ, 0 ≤ C_ψ ∧
      ∀ (m : ℕ) (t : ℝ), 0 ≤ t →
        |S_m m ψ t| ≤ C_ψ * Real.exp (-(m_blk m / (L_blk : ℝ) ^ (K_seq m)) * (t / a_rg (β_seq m))))
    (H_op : H_perp → H_perp)
    (hGen : ∀ u : H_perp,
      Filter.Tendsto (fun t : ℝ => (inner_perp u u - inner_perp u (U t u)) / t)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (inner_perp u (H_op u)))) :
    (∃ m_global : ℝ, 0 < m_global ∧
      (∀ β : ℝ, 0 < β → m_global ≤ m_all β) ∧
      (∀ β : ℝ, β ∈ Set.Icc β_SC β_UV → ∀ m : ℕ, ∀ v : Fin nT → ℝ,
        0 ≤ dotProduct v (((T_win β) ^ m).mulVec v))) ∧
    Filter.Tendsto (fun β : ℝ => 1 / (m_all β * ξ_lat β)) Filter.atTop (nhds 0) ∧
    (∀ (R : Matrix (Fin 4) (Fin 4) ℝ), SO4Matrix R → ∀ p : Fin 4 → ℝ,
      Filter.Tendsto (fun β : ℝ => S_lat β (R.mulVec p) - S_lat β p) Filter.atTop (nhds 0) ∧
      S_cont (R.mulVec p) = S_cont p) ∧
    ((∀ ψ : V_test, 0 ≤ S_inf ψ 0) ∧
      (∃! norm_cont : H_perp → ℝ, norm_cont ∘ q_GNS = fun ψ => S_inf ψ 0) ∧
      (∀ (u : H_perp) (t : ℝ), 0 ≤ t →
        inner_perp u (U t u) ≤ inner_perp u u * Real.exp (-m_0 * t)) ∧
      (∀ u : H_perp, m_0 * inner_perp u u ≤ inner_perp u (H_op u))) ∧
    (¬ wave11H2ConstructiveWitness.Satisfies .h2d_clay_4d_continuum_measure ∧
      ¬ currentH2dRepoWitness.Satisfies .h2d_ir_uniform_clustering_os_gap ∧
      physicalUnificationStatus (Fintype.card H2SubHypothesis) false = .OPEN) := by
  have hcross := ueot_rg_viability_crossover_obstruction_sharpening.2.2.1
