      have hcond : ∀ x : Fin 1 → Bool,
          condSlice (fun y => g (y 0)) 0 x = g := fun x => by
        funext q; simp [condSlice]
      unfold glauberDirichlet
      simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton, hcond]
      rw [expVal_const (isProbWeight_piProdWeight (fun _ : Fin 1 => μ_b) (fun _ => hμb))]
      rw [he1, he2]; ring
    rw [hent_eq, hgl_eq] at h1
    linarith
  have htens := compact_slice_bakry_emery_tensor_product D_su2_pure (by norm_num)
    M_vol μ_M (fun _ => hμb) w_M hw_nn hsingle_P hsingle_LSI
  rw [hrho2] at htens
  have hdesc := brst_closed_zero_cochain_quotient_descent (fun _ : Bool => ())
