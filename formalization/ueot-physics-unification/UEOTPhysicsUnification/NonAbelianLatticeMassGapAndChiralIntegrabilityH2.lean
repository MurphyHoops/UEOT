theorem smg_mirror_decoupling_and_dai_freed_dichotomy
    {m_DW C_DW Δ_SMG : ℝ} (hm : 0 < m_DW) (hCDW : 0 ≤ C_DW) (hΔ : 0 < Δ_SMG) :
