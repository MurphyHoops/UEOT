  ha_def := B.crossover.ha_rg_def
  T_uv := B.crossover.T_uv
  hT_symm := B.crossover.hTuv_symm
  P_sp := B.crossover.P_sp
  Theta_uv := B.crossover.Theta_uv
  pair_uv := B.crossover.pair_uv
  hUV_RP := B.crossover.hUV_RP
  Theta_blk := B.crossover.Theta_blk
  pair_blk := B.crossover.pair_blk
  ι_blk := B.crossover.ι_blk
  hTheta_intertwine := B.crossover.hTheta_intertwine
  hPair_pullback := B.crossover.hPair_pullback
  q_GNS_ir := B.crossover.q_GNS
  hq_ir := B.crossover.hq
  inner_perp := B.crossover.inner_perp
  hSymm_in := B.crossover.hSymm_in
  hAdd_in := B.crossover.hAdd_in
  hSmul_in := B.crossover.hSmul_in
  hInner_nn := B.crossover.hInner_nn
  nT := B.crossover.nT
  β_SC := B.crossover.β_SC
  β_UV := B.crossover.β_UV
  m_SC := B.crossover.m_SC
  m_UV := B.crossover.m_UV
  hβSC_pos := B.crossover.hβSC_pos
  hβSC_lt := B.crossover.hβSC_lt
  hβUV_gt := B.crossover.hβUV_gt
  hmSC := B.crossover.hmSC
