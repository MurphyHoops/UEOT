theorem wilson_admissibility_no_go_and_luscher_action_positivity
    {L_phys Lambda c_adm b0 beta eps_adm alpha K_ent mu eps c_lf : ℝ}
    (hL : 0 < L_phys) (hLam : 0 < Lambda)
    (hc : 0 < c_adm) (hb0 : 0 < b0) (hgap : 2 * c_adm * b0 < 4)
    (hbeta : 0 < beta) (heps : 0 < eps_adm)
    (halpha0 : 0 < alpha) (halpha1 : alpha < 1)
    (hKent : 1 < K_ent) (hmu : 0 < mu) (hepsKP : 0 < eps) (hclf : 0 < c_lf) :
    -- (a) Continuous Wilson defect-density blowup (general & SU(3) eps=1/30, b0=7)
    (Filter.Tendsto (wilsonDefectCount4D L_phys Lambda c_adm b0)
      (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop ∧
