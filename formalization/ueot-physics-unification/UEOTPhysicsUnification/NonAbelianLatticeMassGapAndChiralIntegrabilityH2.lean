      physicalUnificationStatus (Fintype.card H2SubHypothesis) false = .OPEN) := by
  intro D_su2 D_flat M_fp
  have h1 : ∀ u v : Fin 3 → ℝ, ricciSU2 u v = 2 * dotProduct u v := ricci_su2_exact
  have h2 : D_su2.rhoTot = 3 ∧ D_flat.rhoTot = 0 ∧
      ∀ H g, 3 * gamma1Vec g ≤ gamma2Bochner H D_su2.ricBE g := by
    refine ⟨by norm_num [CompactSliceCurvatureData.rhoTot, D_su2],
