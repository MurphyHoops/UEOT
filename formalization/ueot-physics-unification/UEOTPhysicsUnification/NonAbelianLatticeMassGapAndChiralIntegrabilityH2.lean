/-- **Track 1B Adapter Theorem (`[C/B/P/X]`)**:
Pairs constructive finite-`T^4_L` closure (`BalabanFiniteVolInductiveStep`) with
`BalabanThermodynamicContinuationGap` to produce `H2dUVIrreduciblePillar` alongside
`0 < c_hess_unif`, finite-volume Mayer cluster suppression, and finite-volume `CauchySeq`. -/
theorem round05_uv_t4_gap_to_h2d_uv_pillar
    {L : ℕ} [NeZero L] {N : ℕ} {V : Type} {M_n_fin : ℕ → Matrix (Fin N) (Fin N) ℝ}
    (fin : BalabanFiniteVolInductiveStep L V M_n_fin)
    {M_n_inf : ℕ → Matrix (Fin N) (Fin N) ℝ}
    {C_n : ℕ → ℝ → ℝ} {C_inf : ℝ → ℝ}
    {m2_n m4_n : ℕ → ℝ} {m2_inf m4_inf : ℝ}
    {U_adm OrbitSpace : Type}
    {π : U_adm → OrbitSpace} {Φ_anom : U_adm → ℝ}
    (gap : BalabanThermodynamicContinuationGap V M_n_inf C_n C_inf m2_n m4_n m2_inf m4_inf π Φ_anom) :
    Nonempty (H2dUVIrreduciblePillar (uvT4GapToUVContext gap)) ∧
    0 < gap.c_hess_unif ∧
    (∀ K : ℕ, ∑ k ∈ Finset.range K, (fin.step k).escapeMass ≤
      fin.C_esc * fin.a_max * fin.S_max * fin.B_unif) ∧
    (∀ i j : Fin N, CauchySeq (fun k : ℕ => M_n_fin k i j)) := by
  have hfin := balaban_finite_vol_uv_closure fin
  exact ⟨⟨uvT4GapToUVPillar gap⟩, gap.hc_hess_pos, hfin.2.1, hfin.2.2.2⟩

/-! ### 2.3 Tracks 2A & 2B Adapter: `Round05IRZegarlinskiDS` + `Round05IRCrossoverVortex` → `IR-X` -/

/-- Packaged Track 2B (`Round05IRCrossoverVortex`) bundle matching all hypotheses of
`nonperturbative_so4_restoration_and_continuum_os_gap_bridge`:
- `[B/P]` RG lattice & even-block hyperplane RP data;
- `[X]` `noBulkTransition` window `[β_SC, β_UV]` (`m_phys` continuous & positive);
- `[X]` `ξ_lat(β) → ∞` + `H(4)` Symanzik asymptotic expansion → `SO(4)` Euclidean restoration;
- `[X]` RG-blocked continuum OS/GNS limit and uniform blocked gap `m_blk ≥ m_0 * ℓ_phys`. `[C/B/P/X]` -/
structure Round06IRCrossoverVortexPremise where
  N_uv : ℕ
  N_blk : ℕ
  nT : ℕ
  V_uv : Type
  V_blk : Type
  V_test : Type
  H_perp : Type
  [addCommH : AddCommGroup H_perp]
  [modH : Module ℝ H_perp]
  Lambda : ℝ
  c_AF : ℝ
  ell_phys : ℝ
  m_0 : ℝ
  L_blk : ℕ
  hLam : 0 < Lambda
  hcAF : 0 < c_AF
  hell : 0 < ell_phys
  hm0 : 0 < m_0
  hLblk : 2 ≤ L_blk
  a_rg : ℝ → ℝ
  ha_rg_def : ∀ β : ℝ, a_rg β * Lambda = Real.exp (-c_AF * β)
  -- [X] Crossover window & noBulkTransition
  β_SC : ℝ
  β_UV : ℝ
  m_SC : ℝ
  m_UV : ℝ
  hβSC_pos : 0 < β_SC
  hβSC_lt : β_SC < 1
  hβUV_gt : 245 < β_UV
  hmSC : 0 < m_SC
  hmUV : 0 < m_UV
  T_win : ℝ → Matrix (Fin nT) (Fin nT) ℝ
  m_phys : ℝ → ℝ
  m_all : ℝ → ℝ
  hT_win_RP : ∀ β : ℝ, β ∈ Set.Icc β_SC β_UV →
    (T_win β)ᵀ = T_win β ∧ ∀ v : Fin nT → ℝ, 0 ≤ dotProduct v ((T_win β).mulVec v)
  hm_cont : ContinuousOn m_phys (Set.Icc β_SC β_UV)
  hm_pos_win : ∀ β : ℝ, β ∈ Set.Icc β_SC β_UV → 0 < m_phys β
  hm_left : ∀ β : ℝ, 0 < β → β ≤ β_SC → m_SC ≤ m_all β
  hm_mid : ∀ β : ℝ, β ∈ Set.Icc β_SC β_UV → m_phys β ≤ m_all β
  hm_right : ∀ β : ℝ, β_UV ≤ β → m_UV ≤ m_all β
  -- [B/X] ξ_lat(β) → ∞ & H(4) Symanzik expansion
  ξ_lat : ℝ → ℝ
  hξ_pos : ∀ β : ℝ, 0 < β → 0 < ξ_lat β
  hξ_tend : Filter.Tendsto ξ_lat Filter.atTop Filter.atTop
  T_0 : ℝ → Fin 4 → Fin 4 → ℝ
  hT0_H4 : ∀ β : ℝ, H4Invariant2 (T_0 β)
  Q_h4 : ℝ → Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ
  hQ_H4 : ∀ β : ℝ, H4Invariant4 (Q_h4 β)
  C_4 : ℝ
  C_rem : ℝ
  hC4_nn : 0 ≤ C_4
  hCrem_nn : 0 ≤ C_rem
  hc4_unif : ∀ β : ℝ, 0 < β →
    |Q_h4 β 0 0 0 0 - (Q_h4 β 0 0 1 1 + Q_h4 β 0 1 0 1 + Q_h4 β 0 1 1 0)| ≤ C_4
  S_lat : ℝ → (Fin 4 → ℝ) → ℝ
  S_cont : (Fin 4 → ℝ) → ℝ
  hS_lat_symanzik : ∀ (β : ℝ) (p : Fin 4 → ℝ), 0 < β →
    let a_phys := 1 / (m_all β * ξ_lat β)
    |S_lat β p - h4LatticeDispersion (T_0 β) (Q_h4 β) a_phys p| ≤
      C_rem * a_phys ^ 4 * (∑ μ : Fin 4, p μ ^ 2) ^ 3
  hS_lat_tend : ∀ p : Fin 4 → ℝ,
    Filter.Tendsto (fun β : ℝ => S_lat β p) Filter.atTop (nhds (S_cont p))
  -- [C/B/X] Even-block hyperplane-RP RG transfer & continuum OS/GNS limit
  T_uv : Matrix (Fin N_uv) (Fin N_uv) ℝ
  hTuv_symm : T_uvᵀ = T_uv
  P_sp : Matrix (Fin N_uv) (Fin N_blk) ℝ
  Theta_uv : V_uv → V_uv
  pair_uv : V_uv → V_uv → ℝ
  hUV_RP : ∀ f : V_uv, 0 ≤ pair_uv (Theta_uv f) f
  Theta_blk : V_blk → V_blk
  pair_blk : V_blk → V_blk → ℝ
  ι_blk : V_blk → V_uv
  hTheta_intertwine : ∀ F : V_blk, Theta_uv (ι_blk F) = ι_blk (Theta_blk F)
  hPair_pullback : ∀ F G : V_blk, pair_blk F G = pair_uv (ι_blk F) (ι_blk G)
  β_seq : ℕ → ℝ
  K_seq : ℕ → ℕ
  hScale_seq : ∀ m : ℕ, ell_phys = (L_blk : ℝ) ^ (K_seq m) * a_rg (β_seq m)
  m_blk : ℕ → ℝ
  hm_blk_lb : ∀ m : ℕ, m_0 * ell_phys ≤ m_blk m
  q_GNS : V_test → H_perp
  hq : Surjective q_GNS
  inner_perp : H_perp → H_perp → ℝ
  hSymm_in : ∀ u v : H_perp, inner_perp u v = inner_perp v u
  hAdd_in : ∀ u v w : H_perp, inner_perp u (v + w) = inner_perp u v + inner_perp u w
  hSmul_in : ∀ (a : ℝ) (u v : H_perp), inner_perp u (a • v) = a * inner_perp u v
  hInner_nn : ∀ u : H_perp, 0 ≤ inner_perp u u
  S_m : ℕ → V_test → ℝ → ℝ
  S_inf : V_test → ℝ → ℝ
  hTightWeak : ∀ (ψ : V_test) (t : ℝ), 0 ≤ t →
    Filter.Tendsto (fun m : ℕ => S_m m ψ t) Filter.atTop (nhds (S_inf ψ t))
  hOS_RP_m : ∀ (m : ℕ) (ψ : V_test), 0 ≤ S_m m ψ 0
  U : ℝ → H_perp → H_perp
  hGNS_id : ∀ (ψ : V_test) (t : ℝ), 0 ≤ t →
    S_inf ψ t = inner_perp (q_GNS ψ) (U t (q_GNS ψ))
  hU_zero : ∀ u : H_perp, U 0 u = u
  hU_add : ∀ s t : ℝ, 0 ≤ s → 0 ≤ t → ∀ u : H_perp, U (s + t) u = U s (U t u)
  hU_symm : ∀ t : ℝ, 0 ≤ t → ∀ u v : H_perp,
    inner_perp u (U t v) = inner_perp (U t u) v
  hBlkCluster : ∀ ψ : V_test, ∃ C_ψ : ℝ, 0 ≤ C_ψ ∧
    ∀ (m : ℕ) (t : ℝ), 0 ≤ t →
      |S_m m ψ t| ≤ C_ψ * Real.exp (-(m_blk m / (L_blk : ℝ) ^ (K_seq m)) * (t / a_rg (β_seq m)))
  H_op : H_perp → H_perp
  hGen : ∀ u : H_perp,
    Filter.Tendsto (fun t : ℝ => (inner_perp u u - inner_perp u (U t u)) / t)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (inner_perp u (H_op u)))

