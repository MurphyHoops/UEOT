/-! ## 1. Canonical Conditional Expectations, Law of Total Variance & Ergodicity (`[C/B/P]`) -/

section ConditionalExpectations

/-- Marginal weight of all blocks except `i` at configuration `x`. `[C/B]` -/
noncomputable def condMarg {M : ℕ} {Q : Type*} [Fintype Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) : ℝ :=
  ∑ q : Q, μ (Function.update x i q)

/-- Canonical conditional probability weight of block `i` given `x_{≠ i}` (with uniform fallback
on zero-marginal exterior configurations). `[C/B]` -/
noncomputable def condWeight {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) : Q → ℝ :=
  fun q =>
    if 0 < condMarg μ i x then μ (Function.update x i q) / condMarg μ i x
    else (1 / (Fintype.card Q : ℝ))

/-- Conditional expectation operator `T_i f (x) = E_{μ_cond i x}[condSlice f i x]`. `[C/B]` -/
noncomputable def condExpOp {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (f : (Fin M → Q) → ℝ) : (Fin M → Q) → ℝ :=
  fun x => expVal (condWeight μ i x) (condSlice f i x)

/-- Block-`i` conditional gradient `∇_i f = f - T_i f`. `[C/B]` -/
noncomputable def blockGrad {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (f : (Fin M → Q) → ℝ) : (Fin M → Q) → ℝ :=
  fun x => f x - condExpOp μ i f x

/-- Unnormalized random-scan block-Glauber Laplacian `L f = ∑ i, (f - T_i f)`. `[C/B]` -/
noncomputable def blockLaplacian {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (f : (Fin M → Q) → ℝ) : (Fin M → Q) → ℝ :=
  fun x => ∑ i : Fin M, blockGrad μ i f x

lemma condMarg_pos {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i : Fin M) (x : Fin M → Q) :
    0 < condMarg μ i x := by
  unfold condMarg
  obtain ⟨q0⟩ := (inferInstance : Nonempty Q)
  have h1 : 0 < μ (Function.update x i q0) := hμ_pos _
  have hle : μ (Function.update x i q0) ≤ ∑ q : Q, μ (Function.update x i q) :=
    Finset.single_le_sum (fun q _ => le_of_lt (hμ_pos _)) (Finset.mem_univ q0)
  linarith

lemma condMarg_update {M : ℕ} {Q : Type*} [Fintype Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) (q : Q) :
    condMarg μ i (Function.update x i q) = condMarg μ i x := by
  unfold condMarg
  refine Finset.sum_congr rfl (fun r _ => ?_)
  simp [Function.update_idem]

lemma condWeight_update {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) (q : Q) :
    condWeight μ i (Function.update x i q) = condWeight μ i x := by
  funext r
  unfold condWeight
  rw [condMarg_update]
  simp [Function.update_idem]

lemma isProbWeight_condWeight {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (i : Fin M) (x : Fin M → Q) :
    IsProbWeight (condWeight μ i x) := by
  unfold condWeight
  by_cases hm : 0 < condMarg μ i x
  · simp only [hm, ↓reduceIte]
    refine ⟨fun q => div_nonneg (hμ.1 _) (le_of_lt hm), ?_⟩
    rw [← Finset.sum_div]
    exact div_self (ne_of_gt hm)
  · simp only [hm, ↓reduceIte]
    have hcard : (0 : ℝ) < (Fintype.card Q : ℝ) := Nat.cast_pos.mpr Fintype.card_pos
    refine ⟨fun _ => div_nonneg zero_le_one (le_of_lt hcard), ?_⟩
    simp [Finset.sum_const, Finset.card_univ, ne_of_gt hcard]

lemma condWeight_pos {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i : Fin M) (x : Fin M → Q) (q : Q) :
    0 < condWeight μ i x q := by
  unfold condWeight
  have hm := condMarg_pos hμ_pos i x
  simp only [hm, ↓reduceIte]
  exact div_pos (hμ_pos _) hm

lemma condExpOp_update {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (i : Fin M) (f : (Fin M → Q) → ℝ) (x : Fin M → Q) (q : Q) :
    condExpOp μ i f (Function.update x i q) = condExpOp μ i f x := by
  unfold condExpOp
  rw [condWeight_update]
  refine Finset.sum_congr rfl (fun r _ => ?_)
  simp [condSlice, Function.update_idem]

private noncomputable def singleCoordEquiv {M : ℕ} {Q : Type*} [Nonempty Q]
    (i : Fin M) : (Q × {y : Fin M → Q // y i = Classical.arbitrary Q}) ≃ (Fin M → Q) :=
  { toFun := fun p => Function.update p.2.1 i p.1
    invFun := fun x => (x i, ⟨Function.update x i (Classical.arbitrary Q), by simp⟩)
    left_inv := fun ⟨q, ⟨y, hy⟩⟩ => by
      ext j
      · simp
      · by_cases hj : j = i
        · subst hj; simp [hy]
        · simp [hj]
    right_inv := fun x => by
      ext j
      by_cases hj : j = i
      · subst hj; simp
      · simp [hj] }

lemma expVal_condExpOp {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i : Fin M) (f : (Fin M → Q) → ℝ) :
    expVal μ (condExpOp μ i f) = expVal μ f := by
  classical
  let e := singleCoordEquiv (M := M) (Q := Q) i
  unfold expVal
  rw [← Fintype.sum_equiv e _ (fun x => μ x * condExpOp μ i f x) (fun _ => rfl),
    ← Fintype.sum_equiv e _ (fun x => μ x * f x) (fun _ => rfl)]
  rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
  conv_lhs => rw [Finset.sum_comm]
  conv_rhs => rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun y _ => ?_)
  have hconst : ∀ q : Q, condExpOp μ i f (e (q, y)) = condExpOp μ i f y.1 :=
    fun q => condExpOp_update μ i f y.1 q
  simp_rw [hconst, ← Finset.sum_mul]
  have hmarg : (∑ q : Q, μ (e (q, y))) = condMarg μ i y.1 := rfl
  rw [hmarg]
  have hmp : 0 < condMarg μ i y.1 := condMarg_pos hμ_pos i y.1
  change condMarg μ i y.1 * expVal (condWeight μ i y.1) (condSlice f i y.1) =
    ∑ q : Q, μ (Function.update y.1 i q) * f (Function.update y.1 i q)
  unfold expVal condWeight condSlice
  simp only [hmp, ↓reduceIte]
  have hrew : (∑ q : Q, (μ (Function.update y.1 i q) / condMarg μ i y.1) *
      f (Function.update y.1 i q)) =
      (∑ q : Q, μ (Function.update y.1 i q) * f (Function.update y.1 i q)) /
        condMarg μ i y.1 := by
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun q _ => by ring)
  rw [hrew, mul_div_cancel₀ _ (ne_of_gt hmp)]

lemma expVal_mul_condExpOp_comm {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i : Fin M)
    (f g : (Fin M → Q) → ℝ) :
    expVal μ (fun x => f x * condExpOp μ i g x) =
      expVal μ (fun x => condExpOp μ i f x * condExpOp μ i g x) := by
  have h1 : expVal μ (condExpOp μ i (fun z => f z * condExpOp μ i g z)) =
      expVal μ (fun x => f x * condExpOp μ i g x) :=
    expVal_condExpOp hμ_pos i (fun z => f z * condExpOp μ i g z)
  have h2 : ∀ x, condExpOp μ i (fun z => f z * condExpOp μ i g z) x =
      condExpOp μ i f x * condExpOp μ i g x := by
    intro x
    have hlhs : condExpOp μ i (fun z => f z * condExpOp μ i g z) x =
        ∑ q : Q, condWeight μ i x q *
          (f (Function.update x i q) * condExpOp μ i g (Function.update x i q)) := rfl
    have hrhs : condExpOp μ i f x * condExpOp μ i g x =
        (∑ q : Q, condWeight μ i x q * f (Function.update x i q)) * condExpOp μ i g x := rfl
    rw [hlhs, hrhs, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [condExpOp_update]
    ring
  rw [← h1]
  unfold expVal
  refine Finset.sum_congr rfl (fun x _ => ?_)
  rw [h2 x]

lemma expVal_condExpOp_selfAdj {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i : Fin M)
    (f g : (Fin M → Q) → ℝ) :
    expVal μ (fun x => condExpOp μ i f x * g x) =
      expVal μ (fun x => f x * condExpOp μ i g x) := by
  have hL := expVal_mul_condExpOp_comm hμ_pos i g f
  have hR := expVal_mul_condExpOp_comm hμ_pos i f g
  have hcomm1 : (fun x => condExpOp μ i f x * g x) = (fun x => g x * condExpOp μ i f x) := by
    funext x; ring
  have hcomm2 : (fun x => condExpOp μ i g x * condExpOp μ i f x) =
      (fun x => condExpOp μ i f x * condExpOp μ i g x) := by
    funext x; ring
  rw [hcomm1, hL, hcomm2, ← hR]

lemma expVal_blockGrad_sq_eq_var {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i : Fin M) (f : (Fin M → Q) → ℝ) :
    expVal μ (fun x => (blockGrad μ i f x) ^ 2) =
      expVal μ (fun x => varProb (condWeight μ i x) (condSlice f i x)) := by
  let h : (Fin M → Q) → ℝ := fun x => (f x - condExpOp μ i f x) ^ 2
  have h1 : expVal μ (condExpOp μ i h) = expVal μ h := expVal_condExpOp hμ_pos i h
  have h2 : ∀ x : Fin M → Q, condExpOp μ i h x = varProb (condWeight μ i x) (condSlice f i x) := by
    intro x
    unfold condExpOp varProb
    refine Finset.sum_congr rfl (fun q _ => ?_)
    dsimp only [h, condSlice]
    rw [condExpOp_update]
    rfl
  change expVal μ h = _
  rw [← h1]
  unfold expVal
  refine Finset.sum_congr rfl (fun x _ => ?_)
  rw [h2 x]

/-- **Law of Total Variance (`[C/B]`)**:
`Var_μ(f) = Var_μ(T_i f) + E_μ[Var_{μ_cond i x}(condSlice f i x)]`. -/
theorem law_of_total_variance {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    (i : Fin M) (f : (Fin M → Q) → ℝ) :
    varProb μ f = varProb μ (condExpOp μ i f) +
      expVal μ (fun x => varProb (condWeight μ i x) (condSlice f i x)) := by
  rw [← expVal_blockGrad_sq_eq_var hμ_pos i f]
  rw [varProb_eq_expVal_sq_sub_sq hμ f, varProb_eq_expVal_sq_sub_sq hμ (condExpOp μ i f)]
  rw [expVal_condExpOp hμ_pos i f]
  have hsq : expVal μ (fun x => (blockGrad μ i f x) ^ 2) =
      expVal μ (fun x => (f x) ^ 2) - expVal μ (fun x => (condExpOp μ i f x) ^ 2) := by
    have hpt : ∀ x, (blockGrad μ i f x) ^ 2 =
        (f x) ^ 2 - 2 * (f x * condExpOp μ i f x) + (condExpOp μ i f x) ^ 2 := by
      intro x; dsimp [blockGrad]; ring
    simp_rw [hpt, expVal_add, expVal_sub, expVal_smul]
    have hcross : expVal μ (fun x => f x * condExpOp μ i f x) =
        expVal μ (fun x => (condExpOp μ i f x) ^ 2) := by
      rw [expVal_mul_condExpOp_comm hμ_pos i f f]
      refine Finset.sum_congr rfl (fun x _ => by ring)
    rw [hcross]
    ring
  rw [hsq]
  ring

lemma expVal_blockLaplacian_dirichlet {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
   
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (f : (Fin M → Q) → ℝ) :
    expVal μ (fun x => f x * blockLaplacian μ f x) =
      ∑ i : Fin M, expVal μ (fun x => varProb (condWeight μ i x) (condSlice f i x)) := by
  have hgrad : ∀ i : Fin M,
      expVal μ (fun x => f x * blockGrad μ i f x) =
        expVal μ (fun x => (blockGrad μ i f x) ^ 2) := by
    intro i
    have h1 : ∀ x, f x * blockGrad μ i f x =
        (blockGrad μ i f x) ^ 2 + (f x * condExpOp μ i f x - (condExpOp μ i f x) ^ 2) := by
      intro x; dsimp [blockGrad]; ring
    simp_rw [h1, expVal_add, expVal_sub]
    have hcross : expVal μ (fun x => f x * condExpOp μ i f x) =
        expVal μ (fun x => (condExpOp μ i f x) ^ 2) := by
      rw [expVal_mul_condExpOp_comm hμ_pos i f f]
      refine Finset.sum_congr rfl (fun x _ => by ring)
    rw [hcross, sub_self, add_zero]
  have hsum : expVal μ (fun x => f x * blockLaplacian μ f x) =
      ∑ i : Fin M, expVal μ (fun x => f x * blockGrad μ i f x) := by
    unfold expVal blockLaplacian
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
  rw [hsum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [hgrad i, expVal_blockGrad_sq_eq_var hμ_pos i f]

private lemma update_prefix_eq_of_const_slices {M : ℕ} {Q : Type*}
    (f : (Fin M → Q) → ℝ) (hconst : ∀ (i : Fin M) (x : Fin M → Q) (q : Q), f (Function.update x i q) = f x) :
    ∀ (x y : Fin M → Q) (k : ℕ), k ≤ M →
      f (fun i => if i.1 < k then y i else x i) = f x
  | x, _, 0, _ => by simp
  | x, y, k + 1, hk => by
    have hk_lt : k < M := by omega
    let ik : Fin M := ⟨k, hk_lt⟩
    let z : Fin M → Q := fun i => if i.1 < k then y i else x i
    have hz_upd : Function.update z ik (y ik) = fun i => if i.1 < k + 1 then y i else x i := by
      ext i
      by_cases hi : i = ik
      · subst hi; simp [ik]
      · have hne : i.1 ≠ k := fun h => hi (Fin.ext h)
        simp only [Function.update_apply, hi, ↓reduceIte, z]
        have hlt_iff : i.1 < k + 1 ↔ i.1 < k := by omega
        simp [hlt_iff]
    rw [← hz_upd, hconst ik z (y ik)]
    exact update_prefix_eq_of_const_slices f hconst x y k (Nat.le_of_lt hk_lt)

/-- **Ergodicity of Block-Glauber Generator under Positive Weight (`[C/B]`)**:
If `∀ x, 0 < μ x` and `L f = 0`, then `f` is constant and `varProb μ f = 0`. -/
theorem blockLaplacian_ker_const {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    {f : (Fin M → Q) → ℝ} (hL : ∀ x, blockLaplacian μ f x = 0) :
    varProb μ f = 0 := by
  have hsum0 : ∑ i : Fin M, expVal μ (fun x => varProb (condWeight μ i x) (condSlice f i x)) = 0 := by
    rw [← expVal_blockLaplacian_dirichlet hμ_pos f]
    unfold expVal
    simp [hL]
  have hvar0 : ∀ (i : Fin M) (x : Fin M → Q),
      varProb (condWeight μ i x) (condSlice f i x) = 0 := by
    intro i x
    have hi0 : expVal μ (fun z => varProb (condWeight μ i z) (condSlice f i z)) = 0 := by
      have hle : expVal μ (fun z => varProb (condWeight μ i z) (condSlice f i z)) ≤ 0 := by
        rw [← hsum0]
        exact Finset.single_le_sum
          (fun j _ => expVal_nonneg hμ (fun z => varProb_nonneg (isProbWeight_condWeight hμ j z) _))
          (Finset.mem_univ i)
      exact le_antisymm hle
        (expVal_nonneg hμ (fun z => varProb_nonneg (isProbWeight_condWeight hμ i z) _))
    have hterm_le : μ x * varProb (condWeight μ i x) (condSlice f i x) ≤ 0 := by
      rw [← hi0]
      exact Finset.single_le_sum
        (fun z _ => mul_nonneg (le_of_lt (hμ_pos z)) (varProb_nonneg (isProbWeight_condWeight hμ i z) _))
        (Finset.mem_univ x)
    have hterm0 : μ x * varProb (condWeight μ i x) (condSlice f i x) = 0 :=
      le_antisymm hterm_le
        (mul_nonneg (le_of_lt (hμ_pos x)) (varProb_nonneg (isProbWeight_condWeight hμ i x) _))
    exact (mul_eq_zero.mp hterm0).resolve_left (ne_of_gt (hμ_pos x))
  have hconst_slices : ∀ (i : Fin M) (x : Fin M → Q) (q : Q), f (Function.update x i q) = f x := by
    intro i x q
    have hv := hvar0 i x
    have hterm_q : condWeight μ i x q *
        (condSlice f i x q - expVal (condWeight μ i x) (condSlice f i x)) ^ 2 = 0 := by
      have hle : condWeight μ i x q *
          (condSlice f i x q - expVal (condWeight μ i x) (condSlice f i x)) ^ 2 ≤ 0 := by
        rw [← hv]
        exact Finset.single_le_sum
          (f := fun r => condWeight μ i x r *
            (condSlice f i x r - expVal (condWeight μ i x) (condSlice f i x)) ^ 2)
          (fun r _ => mul_nonneg (le_of_lt (condWeight_pos hμ_pos i x r)) (sq_nonneg _))
          (Finset.mem_univ q)
      exact le_antisymm hle
        (mul_nonneg (le_of_lt (condWeight_pos hμ_pos i x q)) (sq_nonneg _))
    have hsq_q : (condSlice f i x q - expVal (condWeight μ i x) (condSlice f i x)) ^ 2 = 0 :=
      (mul_eq_zero.mp hterm_q).resolve_left (ne_of_gt (condWeight_pos hμ_pos i x q))
    have hq_eq : condSlice f i x q = expVal (condWeight μ i x) (condSlice f i x) :=
      sub_eq_zero.mp (sq_eq_zero_iff.mp hsq_q)
    have hterm_xi : condWeight μ i x (x i) *
        (condSlice f i x (x i) - expVal (condWeight μ i x) (condSlice f i x)) ^ 2 = 0 := by
      have hle : condWeight μ i x (x i) *
          (condSlice f i x (x i) - expVal (condWeight μ i x) (condSlice f i x)) ^ 2 ≤ 0 := by
        rw [← hv]
        exact Finset.single_le_sum
          (f := fun r => condWeight μ i x r *
            (condSlice f i x r - expVal (condWeight μ i x) (condSlice f i x)) ^ 2)
          (fun r _ => mul_nonneg (le_of_lt (condWeight_pos hμ_pos i x r)) (sq_nonneg _))
          (Finset.mem_univ (x i))
      exact le_antisymm hle
        (mul_nonneg (le_of_lt (condWeight_pos hμ_pos i x (x i))) (sq_nonneg _))
    have hsq_xi : (condSlice f i x (x i) - expVal (condWeight μ i x) (condSlice f i x)) ^ 2 = 0 :=
      (mul_eq_zero.mp hterm_xi).resolve_left (ne_of_gt (condWeight_pos hμ_pos i x (x i)))
    have hxi_eq : condSlice f i x (x i) = expVal (condWeight μ i x) (condSlice f i x) :=
      sub_eq_zero.mp (sq_eq_zero_iff.mp hsq_xi)
    have hxi_self : condSlice f i x (x i) = f x := by simp [condSlice]
    rw [← hxi_self, hxi_eq, ← hq_eq]
    rfl
  obtain ⟨q0⟩ := (inferInstance : Nonempty Q)
  let x0 : Fin M → Q := fun _ => q0
  have hfx : ∀ y : Fin M → Q, f y = f x0 := by
    intro y
    have h := update_prefix_eq_of_const_slices f hconst_slices x0 y M le_rfl
    have heq : (fun i : Fin M => if i.1 < M then y i else x0 i) = y := by
      ext i; simp [i.isLt]
    rw [heq] at h
    exact h
  have hm : expVal μ f = f x0 := by
    have hfun : f = fun _ => f x0 := funext hfx
    rw [hfun, expVal_const hμ]
  unfold varProb expVal
  refine Finset.sum_eq_zero (fun y _ => ?_)
  dsimp only
  have hm' : ∑ x : Fin M → Q, μ x * f x = f x0 := hm
  rw [hfx y, hm', sub_self, zero_pow (by norm_num), mul_zero]

end ConditionalExpectations

/-! ## 2. 2-Block HGR Projection-Angle Lemma & Density-Oscillation Criterion (`[C/B/P]`) -/

section TwoBlockHGR

/-- Hirschfeld–Gebelein–Rényi (HGR) maximal correlation bound `ρ` for a bivariate probability
weight `ν` on `A × B`: for all mean-zero marginals `φ(a)` and `ψ(b)`,
`|E_ν[φ(a) ψ(b)]| ≤ ρ √(E_ν[φ^2] E_ν[ψ^2])`. `[C/B]` -/
def HGRBounded {A B : Type*} [Fintype A] [Fintype B] (ν : A × B → ℝ) (ρ : ℝ) : Prop :=
  ∀ (φ : A → ℝ) (ψ : B → ℝ),
    expVal ν (fun p => φ p.1) = 0 →
    expVal ν (fun p => ψ p.2) = 0 →
    |expVal ν (fun p => φ p.1 * ψ p.2)| ≤
      ρ * Real.sqrt (expVal ν (fun p => (φ p.1) ^ 2) * expVal ν (fun p => (ψ p.2) ^ 2))

/-- **Density-Oscillation Criterion for HGR Weak Mixing (`[C/B/P]`)**:
If `ν` has marginals `νA, νB` with `|ν (a, b) - νA a * νB b| ≤ η * (νA a * νB b)`,
then `HGRBounded ν η` holds. -/
theorem density_osc_implies_hgr {A B : Type*} [Fintype A] [Fintype B]
    {ν : A × B → ℝ} (hν : IsProbWeight ν) {η : ℝ} (hη : 0 ≤ η)
    (νA : A → ℝ) (νB : B → ℝ)
    (hmargA : ∀ a : A, νA a = ∑ b : B, ν (a, b))
    (hmargB : ∀ b : B, νB b = ∑ a : A, ν (a, b))
    (hosc : ∀ a : A, ∀ b : B, |ν (a, b) - νA a * νB b| ≤ η * (νA a * νB b)) :
    HGRBounded ν η := by
  intro φ ψ hφ hψ
  have hνA_nn : ∀ a : A, 0 ≤ νA a := fun a => by
    rw [hmargA a]; exact Finset.sum_nonneg (fun b _ => hν.1 (a, b))
  have hνB_nn : ∀ b : B, 0 ≤ νB b := fun b => by
    rw [hmargB b]; exact Finset.sum_nonneg (fun a _ => hν.1 (a, b))
  have hνA_prob : IsProbWeight νA := ⟨hνA_nn, by
    simp_rw [hmargA]
    rw [← Fintype.sum_prod_type]
    exact hν.2⟩
  have hνB_prob : IsProbWeight νB := ⟨hνB_nn, by
    simp_rw [hmargB]
    rw [Finset.sum_comm, ← Fintype.sum_prod_type]
    exact hν.2⟩
  have hprod_sum : (∑ a : A, ∑ b : B, (νA a * νB b) * (φ a * ψ b)) = 0 := by
    have h1 : ∑ a : A, ∑ b : B, (νA a * νB b) * (φ a * ψ b) =
        (∑ a : A, νA a * φ a) * (∑ b : B, νB b * ψ b) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => by ring)
    have hA0 : ∑ a : A, νA a * φ a = 0 := by
      rw [← hφ]
      unfold expVal
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [hmargA a, Finset.sum_mul]
    rw [h1, hA0, zero_mul]
  have heq : expVal ν (fun p => φ p.1 * ψ p.2) =
      ∑ a : A, ∑ b : B, (ν (a, b) - νA a * νB b) * (φ a * ψ b) := by
    unfold expVal
    rw [Fintype.sum_prod_type]
    simp_rw [sub_mul, Finset.sum_sub_distrib]
    rw [hprod_sum, sub_zero]
  have hcs_prod :
      (∑ a : A, ∑ b : B, (νA a * νB b) * |φ a * ψ b|) ≤
        Real.sqrt (expVal ν (fun p => (φ p.1) ^ 2) * expVal ν (fun p => (ψ p.2) ^ 2)) := by
    have hA_sq : ∑ a : A, νA a * (φ a) ^ 2 = expVal ν (fun p => (φ p.1) ^ 2) := by
      unfold expVal
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [hmargA a, Finset.sum_mul]
    have hB_sq : ∑ b : B, νB b * (ψ b) ^ 2 = expVal ν (fun p => (ψ p.2) ^ 2) := by
      unfold expVal
      rw [Fintype.sum_prod_type, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [hmargB b, Finset.sum_mul]
    have hfactor : (∑ a : A, ∑ b : B, (νA a * νB b) * |φ a * ψ b|) =
        (∑ a : A, νA a * |φ a|) * (∑ b : B, νB b * |ψ b|) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => by rw [abs_mul]; ring)
    have hjA : (∑ a : A, νA a * |φ a|) ^ 2 ≤ ∑ a : A, νA a * (φ a) ^ 2 := by
      have h := jensen_sq_le hνA_prob (fun a => |φ a|)
      simpa [expVal, sq_abs] using h
    have hjB : (∑ b : B, νB b * |ψ b|) ^ 2 ≤ ∑ b : B, νB b * (ψ b) ^ 2 := by
      have h := jensen_sq_le hνB_prob (fun b => |ψ b|)
      simpa [expVal, sq_abs] using h
    have hsqA : ∑ a : A, νA a * |φ a| ≤ Real.sqrt (expVal ν (fun p => (φ p.1) ^ 2)) :=
      Real.le_sqrt_of_sq_le (hjA.trans_eq hA_sq)
    have hsqB : ∑ b : B, νB b * |ψ b| ≤ Real.sqrt (expVal ν (fun p => (ψ p.2) ^ 2)) :=
      Real.le_sqrt_of_sq_le (hjB.trans_eq hB_sq)
    have hnnA : 0 ≤ ∑ a : A, νA a * |φ a| :=
      Finset.sum_nonneg (fun a _ => mul_nonneg (hνA_nn a) (abs_nonneg _))
    have hnnB : 0 ≤ ∑ b : B, νB b * |ψ b| :=
      Finset.sum_nonneg (fun b _ => mul_nonneg (hνB_nn b) (abs_nonneg _))
    rw [hfactor, Real.sqrt_mul (expVal_nonneg hν (fun _ => sq_nonneg _))]
    exact mul_le_mul hsqA hsqB hnnB (Real.sqrt_nonneg _)
  calc |expVal ν (fun p => φ p.1 * ψ p.2)|
      = |∑ a : A, ∑ b : B, (ν (a, b) - νA a * νB b) * (φ a * ψ b)| := by rw [heq]
    _ ≤ ∑ a : A, |∑ b : B, (ν (a, b) - νA a * νB b) * (φ a * ψ b)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ a : A, ∑ b : B, |(ν (a, b) - νA a * νB b) * (φ a * ψ b)| :=
        Finset.sum_le_sum (fun _ _ => Finset.abs_sum_le_sum_abs _ _)
    _ ≤ ∑ a : A, ∑ b : B, η * (νA a * νB b) * |φ a * ψ b| := by
        refine Finset.sum_le_sum (fun a _ => Finset.sum_le_sum (fun b _ => ?_))
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_right (hosc a b) (abs_nonneg _)
    _ = η * ∑ a : A, ∑ b : B, (νA a * νB b) * |φ a * ψ b| := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun b _ => by ring)
    _ ≤ η * Real.sqrt (expVal ν (fun p => (φ p.1) ^ 2) * expVal ν (fun p => (ψ p.2) ^ 2)) :=
        mul_le_mul_of_nonneg_left hcs_prod hη

/-- Helper: Cauchy–Schwarz on weighted `Finset` sums. `[C/B]` -/
lemma weighted_cauchy_schwarz {S : Type*} [Fintype S] {w : S → ℝ}
    (hw : ∀ x, 0 ≤ w x) (a b : S → ℝ) :
    (∑ x : S, w x * a x * b x) ^ 2 ≤ (∑ x : S, w x * (a x) ^ 2) * (∑ x : S, w x * (b x) ^ 2) := by
  have hpoly : ∀ s : ℝ, 0 ≤ (∑ x : S, w x * (b x) ^ 2) * s ^ 2 +
      2 * (∑ x : S, w x * a x * b x) * s + (∑ x : S, w x * (a x) ^ 2) := by
    intro s
    have hnn : 0 ≤ ∑ x : S, w x * (a x + s * b x) ^ 2 :=
      Finset.sum_nonneg (fun x _ => mul_nonneg (hw x) (sq_nonneg _))
    have hexp : ∑ x : S, w x * (a x + s * b x) ^ 2 =
        (∑ x : S, w x * (b x) ^ 2) * s ^ 2 + 2 * (∑ x : S, w x * a x * b x) * s +
        (∑ x : S, w x * (a x) ^ 2) := by
      have hterm : ∀ x, w x * (a x + s * b x) ^ 2 =
          s ^ 2 * (w x * (b x) ^ 2) + (2 * s) * (w x * a x * b x) + w x * (a x) ^ 2 :=
        fun x => by ring
      simp_rw [hterm, Finset.sum_add_distrib, ← Finset.mul_sum]
      ring
    linarith
  set A := ∑ x : S, w x * (b x) ^ 2
  set B := ∑ x : S, w x * a x * b x
  set C := ∑ x : S, w x * (a x) ^ 2
  have hA_nn : 0 ≤ A := Finset.sum_nonneg (fun x _ => mul_nonneg (hw x) (sq_nonneg _))
  rcases hA_nn.eq_or_lt with hA0 | hA_pos
  · have hB0 : B = 0 := by
      by_contra hne
      have hval := hpoly (-(C + 1) / (2 * B))
      have hB_ne : 2 * B ≠ 0 := mul_ne_zero (by norm_num) hne
      have hlin : A * (-(C + 1) / (2 * B)) ^ 2 + 2 * B * (-(C + 1) / (2 * B)) + C = -1 := by
        rw [← hA0, zero_mul, zero_add, mul_div_cancel₀ _ hB_ne]; ring
      linarith
    rw [hB0, ← hA0]; norm_num
  · have hmin := hpoly (-B / A)
    have hA_ne : A ≠ 0 := ne_of_gt hA_pos
    have hid : A * (-B / A) ^ 2 + 2 * B * (-B / A) + C = (A * C - B ^ 2) / A := by
      rw [eq_div_iff hA_ne]; field_simp [hA_ne]; ring
    rw [hid] at hmin
    have hnum : 0 ≤ A * C - B ^ 2 :=
      (div_nonneg_iff.mp hmin).elim (fun h => h.1) (fun h => absurd h.2 (by linarith))
    linarith

/-- **2-Projection Angle Inequality (`[C/B]`)**:
Given two symmetric orthogonal projections `P0, P1` on a finite-dimensional real inner product space `E`
whose range-to-range angle is bounded by `ρ < 1`, `(I - P0) x` and `(I - P1) x` satisfy
`⟨x - P0 x, x - P1 x⟩ ≥ -ρ ‖x - P0 x‖ ‖x - P1 x‖`. -/
private lemma two_proj_angle_ineq {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E]
    (P0 P1 : E →ₗ[ℝ] E)
    (hP0_symm : P0.IsSymmetric) (hP0_idem : ∀ x, P0 (P0 x) = P0 x)
    (hP1_symm : P1.IsSymmetric) (hP1_idem : ∀ x, P1 (P1 x) = P1 x)
    {ρ : ℝ} (hρ_nn : 0 ≤ ρ) (hρ_lt : ρ < 1)
    (hHGR : ∀ (u v : E), P1 u = u → P0 v = v → |inner ℝ u v| ≤ ρ * ‖u‖ * ‖v‖)
    (x : E) :
    inner ℝ (x - P0 x) (x - P1 x) ≥ -ρ * ‖x - P0 x‖ * ‖x - P1 x‖ := by
  classical
  let M : E →ₗ[ℝ] E := P0 ∘ₗ P1 ∘ₗ P0
  have hM_symm : M.IsSymmetric := by
    intro u v
    change inner ℝ (P0 (P1 (P0 u))) v = inner ℝ u (P0 (P1 (P0 v)))
    rw [hP0_symm (P1 (P0 u)) v, hP1_symm (P0 u) (P0 v), ← hP0_symm u (P1 (P0 v))]
  let N := Module.finrank ℝ E
  let b : OrthonormalBasis (Fin N) ℝ E := hM_symm.eigenvectorBasis rfl
  let μ : Fin N → ℝ := hM_symm.eigenvalues rfl
  have hMeig : ∀ k : Fin N, M (b k) = μ k • b k :=
    hM_symm.apply_eigenvectorBasis rfl
  have hμ_nn : ∀ k : Fin N, 0 ≤ μ k := by
    intro k
    have h1 : inner ℝ (b k) (M (b k)) = μ k := by
      rw [hMeig k, real_inner_smul_right, real_inner_self_eq_norm_sq, b.orthonormal.1 k, one_pow, mul_one]
    have h2 : inner ℝ (b k) (M (b k)) = ‖P1 (P0 (b k))‖ ^ 2 := by
      change inner ℝ (b k) (P0 (P1 (P0 (b k)))) = _
      conv_lhs =>
        rw [← hP0_symm (b k) (P1 (P0 (b k))), ← hP1_idem (P0 (b k)),
          ← hP1_symm (P0 (b k)) (P1 (P0 (b k))), real_inner_self_eq_norm_sq]
    linarith [sq_nonneg ‖P1 (P0 (b k))‖]
  have hμ_le : ∀ k : Fin N, μ k ≤ ρ ^ 2 := by
    intro k
    have h1 : μ k = ‖P1 (P0 (b k))‖ ^ 2 := by
      have h1a : inner ℝ (b k) (M (b k)) = μ k := by
        rw [hMeig k, real_inner_smul_right, real_inner_self_eq_norm_sq, b.orthonormal.1 k, one_pow, mul_one]
      have h2a : inner ℝ (b k) (M (b k)) = ‖P1 (P0 (b k))‖ ^ 2 := by
        change inner ℝ (b k) (P0 (P1 (P0 (b k)))) = _
        conv_lhs =>
          rw [← hP0_symm (b k) (P1 (P0 (b k))), ← hP1_idem (P0 (b k)),
            ← hP1_symm (P0 (b k)) (P1 (P0 (b k))), real_inner_self_eq_norm_sq]
      linarith
    have hbd := hHGR (P1 (P0 (b k))) (P0 (b k)) (hP1_idem _) (hP0_idem _)
    have hinn : inner ℝ (P1 (P0 (b k))) (P0 (b k)) = ‖P1 (P0 (b k))‖ ^ 2 := by
      conv_lhs => rw [← hP1_idem (P0 (b k)), hP1_symm (P1 (P0 (b k))) (P0 (b k))]
      rw [real_inner_self_eq_norm_sq]
    rw [hinn, abs_of_nonneg (sq_nonneg _)] at hbd
    have hP0_le : ‖P0 (b k)‖ ≤ ‖b k‖ := by
      have hpy : ‖P0 (b k)‖ ^ 2 + ‖b k - P0 (b k)‖ ^ 2 = ‖b k‖ ^ 2 := by
        have horth : inner ℝ (P0 (b k)) (b k - P0 (b k)) = 0 := by
          rw [inner_sub_right, ← hP0_symm, hP0_idem, sub_self]
        have hsq := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth
        simp only [add_sub_cancel, ← sq] at hsq
        exact hsq.symm
      have hsq : ‖P0 (b k)‖ ^ 2 ≤ ‖b k‖ ^ 2 := by linarith [sq_nonneg ‖b k - P0 (b k)‖]
      nlinarith [norm_nonneg (P0 (b k)), norm_nonneg (b k)]
    have hbk_norm : ‖b k‖ = 1 := b.orthonormal.1 k
    rw [hbk_norm] at hP0_le
    have hnorm_le : ‖P1 (P0 (b k))‖ ≤ ρ := by
      by_cases hz : ‖P1 (P0 (b k))‖ = 0
      · rw [hz]; exact hρ_nn
      · have hp : 0 < ‖P1 (P0 (b k))‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hz)
        have hbd2 : ‖P1 (P0 (b k))‖ * ‖P1 (P0 (b k))‖ ≤ ρ * ‖P1 (P0 (b k))‖ * 1 := by
          calc ‖P1 (P0 (b k))‖ * ‖P1 (P0 (b k))‖
              = ‖P1 (P0 (b k))‖ ^ 2 := by ring
            _ ≤ ρ * ‖P1 (P0 (b k))‖ * ‖P0 (b k)‖ := hbd
            _ ≤ ρ * ‖P1 (P0 (b k))‖ * 1 := by
                refine mul_le_mul_of_nonneg_left hP0_le (mul_nonneg hρ_nn (norm_nonneg _))
        nlinarith
    rw [h1]
    exact pow_le_pow_left₀ (norm_nonneg _) hnorm_le 2
  let S_pos : Finset (Fin N) := Finset.univ.filter (fun k => 0 < μ k)
  let s : Fin N → ℝ := fun k => Real.sqrt (μ k)
  let f : Fin N → E := fun k => (1 / s k) • P1 (b k)
  let g : Fin N → E := fun k => (1 / Real.sqrt (1 - μ k)) • (f k - s k • b k)
  have hs_pos : ∀ k ∈ S_pos, 0 < s k := fun k hk => Real.sqrt_pos.mpr (Finset.mem_filter.mp hk).2
  have hs_le : ∀ k : Fin N, s k ≤ ρ := fun k => by
    dsimp only [s]; rw [← Real.sqrt_sq hρ_nn]; exact Real.sqrt_le_sqrt (hμ_le k)
  have hs_sq : ∀ k : Fin N, (s k) ^ 2 = μ k := fun k => Real.sq_sqrt (hμ_nn k)
  have h1mμ_pos : ∀ k : Fin N, 0 < 1 - μ k := fun k => by
    have hρ2 : ρ ^ 2 < 1 := by nlinarith
    linarith [hμ_le k]
  have hP0_b : ∀ k ∈ S_pos, P0 (b k) = b k := by
    intro k hk
    have hμ_pos : 0 < μ k := (Finset.mem_filter.mp hk).2
    have h1 : P0 (M (b k)) = M (b k) := by
      change P0 (P0 (P1 (P0 (b k)))) = P0 (P1 (P0 (b k)))
      exact hP0_idem _
    rw [hMeig k, map_smul] at h1
    have h2 : μ k • (P0 (b k) - b k) = 0 := by rw [smul_sub, h1, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h2).resolve_left (ne_of_gt hμ_pos))
  have hP0_f : ∀ k ∈ S_pos, P0 (f k) = s k • b k := by
    intro k hk
    dsimp only [f]
    rw [map_smul, ← hP0_b k hk]
    have hM_eq : P0 (P1 (P0 (b k))) = M (b k) := rfl
    rw [hM_eq, hMeig k, smul_smul, ← hs_sq k]
    have hsne : s k ≠ 0 := ne_of_gt (hs_pos k hk)
    have hcoef : (1 / s k) * s k ^ 2 = s k := by field_simp [hsne]
    rw [hcoef, hP0_b k hk]
  have hP1_f : ∀ k : Fin N, P1 (f k) = f k := fun k => by
    dsimp only [f]; rw [map_smul, hP1_idem]
  have hP1_b_eq : ∀ k ∈ S_pos, P1 (b k) = s k • f k := by
    intro k hk
    dsimp only [f]
    rw [smul_smul]
    have hsne : s k ≠ 0 := ne_of_gt (hs_pos k hk)
    field_simp [hsne]
    simp
  have hinner_bb : ∀ k l : Fin N, inner ℝ (b k) (b l) = if k = l then 1 else 0 := by
    intro k l
    split_ifs with hkl
    · subst hkl; rw [real_inner_self_eq_norm_sq, b.orthonormal.1 k, one_pow]
    · exact b.orthonormal.2 hkl
  have hinner_bf : ∀ k l : Fin N, k ∈ S_pos → l ∈ S_pos →
      inner ℝ (b k) (f l) = if k = l then s l else 0 := by
    intro k l hk hl
    dsimp only [f]
    rw [real_inner_smul_right, ← hP0_b k hk, ← hP0_b l hl, hP0_symm (b k) (P1 (P0 (b l)))]
    have hM_eq : P0 (P1 (P0 (b l))) = M (b l) := rfl
    rw [hM_eq, hMeig l, real_inner_smul_right, hinner_bb k l]
    split_ifs with hkl
    · subst hkl
      have hsne : s k ≠ 0 := ne_of_gt (hs_pos k hl)
      rw [mul_one, ← hs_sq k]; field_simp [hsne]
    · simp
  have hinner_ff : ∀ k l : Fin N, k ∈ S_pos → l ∈ S_pos →
      inner ℝ (f k) (f l) = if k = l then 1 else 0 := by
    intro k l hk hl
    dsimp only [f]
    rw [real_inner_smul_left, real_inner_smul_right, hP1_symm (b k) (P1 (b l)), hP1_idem (b l),
      ← hP0_b k hk, ← hP0_b l hl, hP0_symm (b k) (P1 (P0 (b l)))]
    have hM_eq : P0 (P1 (P0 (b l))) = M (b l) := rfl
    rw [hM_eq, hMeig l, real_inner_smul_right, hinner_bb k l]
    split_ifs with hkl
    · subst hkl
      have hsne : s k ≠ 0 := ne_of_gt (hs_pos k hk)
      rw [mul_one, ← hs_sq k]; field_simp [hsne]
    · simp
  have hinner_bg : ∀ k l : Fin N, k ∈ S_pos → l ∈ S_pos → inner ℝ (b k) (g l) = 0 := by
    intro k l hk hl
    dsimp only [g]
    rw [real_inner_smul_right, inner_sub_right, hinner_bf k l hk hl, real_inner_smul_right,
      hinner_bb k l]
    split_ifs <;> simp
  have hinner_gg : ∀ k l : Fin N, k ∈ S_pos → l ∈ S_pos →
      inner ℝ (g k) (g l) = if k = l then 1 else 0 := by
    intro k l hk hl
    dsimp only [g]
    rw [real_inner_smul_left, real_inner_smul_right, inner_sub_left, inner_sub_right,
      inner_sub_right, hinner_ff k l hk hl, real_inner_smul_right, real_inner_comm (b l) (f k),
      hinner_bf l k hl hk, real_inner_smul_left, hinner_bf k l hk hl, real_inner_smul_left,
      real_inner_smul_right, hinner_bb k l]
    have hcomm_eq : (l = k) ↔ (k = l) := eq_comm
    simp only [hcomm_eq]
    split_ifs with hkl
    · subst hkl
      have h1m_pos : 0 < 1 - μ k := h1mμ_pos k
      have hsq : Real.sqrt (1 - μ k) ^ 2 = 1 - μ k := Real.sq_sqrt (le_of_lt h1m_pos)
      have hsq_ne : Real.sqrt (1 - μ k) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr h1m_pos)
      field_simp [hsq_ne]
      rw [hsq, hs_sq k]
      ring
    · simp
  have hP0_g : ∀ k ∈ S_pos, P0 (g k) = 0 := by
    intro k hk
    dsimp only [g]
    rw [map_smul, map_sub, hP0_f k hk, map_smul, hP0_b k hk, sub_self, smul_zero]
  have hP1_g : ∀ k ∈ S_pos, P1 (g k) = Real.sqrt (1 - μ k) • f k := by
    intro k hk
    dsimp only [g]
    have hsub : f k - (s k * s k) • f k = (1 - s k * s k) • f k := by
      rw [sub_smul, one_smul]
    rw [map_smul, map_sub, hP1_f k, map_smul, hP1_b_eq k hk, smul_smul, hsub, smul_smul]
    have h1m_pos : 0 < 1 - μ k := h1mμ_pos k
    have hsq : Real.sqrt (1 - μ k) ^ 2 = 1 - μ k := Real.sq_sqrt (le_of_lt h1m_pos)
    have hsq_ne : Real.sqrt (1 - μ k) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr h1m_pos)
    have hid : (1 : ℝ) / Real.sqrt (1 - μ k) * (1 - s k * s k) = Real.sqrt (1 - μ k) := by
      rw [← sq, hs_sq k]
      field_simp [hsq_ne]
      exact hsq.symm
    rw [hid]
  have hf_decomp : ∀ k ∈ S_pos, f k = Real.sqrt (1 - μ k) • g k + s k • b k := by
    intro k hk
    dsimp only [g]
    have h1m_pos : 0 < 1 - μ k := h1mμ_pos k
    have hsq_ne : Real.sqrt (1 - μ k) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr h1m_pos)
    rw [smul_smul, mul_one_div_cancel hsq_ne, one_smul, sub_add_cancel]
  let α : Fin N → ℝ := fun k => inner ℝ (b k) x
  let β : Fin N → ℝ := fun k => inner ℝ (g k) x
  let x_S : E := ∑ k ∈ S_pos, (α k • b k + β k • g k)
  let w : E := x - x_S
  have hx_split : x = x_S + w := (add_sub_cancel x_S x).symm
  have hw_b : ∀ k ∈ S_pos, inner ℝ (b k) w = 0 := by
    intro k hk
    dsimp only [w, x_S]
    rw [inner_sub_right, inner_sum]
    have hsum : (∑ l ∈ S_pos, inner ℝ (b k) (α l • b l + β l • g l)) = α k := by
      have hterm : ∀ l ∈ S_pos, inner ℝ (b k) (α l • b l + β l • g l) =
          if k = l then α l else 0 := by
        intro l hl
        rw [inner_add_right, real_inner_smul_right, real_inner_smul_right,
          hinner_bb k l, hinner_bg k l hk hl]
        split_ifs <;> ring
      rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq, if_pos hk]
    rw [hsum, sub_self]
  have hw_g : ∀ k ∈ S_pos, inner ℝ (g k) w = 0 := by
    intro k hk
    dsimp only [w, x_S]
    rw [inner_sub_right, inner_sum]
    have hsum : (∑ l ∈ S_pos, inner ℝ (g k) (α l • b l + β l • g l)) = β k := by
      have hterm : ∀ l ∈ S_pos, inner ℝ (g k) (α l • b l + β l • g l) =
          if k = l then β l else 0 := by
        intro l hl
        rw [inner_add_right, real_inner_smul_right, real_inner_smul_right,
          real_inner_comm, hinner_bg l k hl hk, hinner_gg k l hk hl]
        split_ifs <;> ring
      rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq, if_pos hk]
    rw [hsum, sub_self]
  have hw_f : ∀ k ∈ S_pos, inner ℝ (f k) w = 0 := by
    intro k hk
    rw [hf_decomp k hk]
    simp only [inner_add_left, real_inner_smul_left]
    rw [hw_g k hk, hw_b k hk, mul_zero, mul_zero, add_zero]
  have hP1P0_w : P1 (P0 w) = 0 := by
    have hw_exp : w = ∑ l : Fin N, (inner ℝ (b l) w) • b l := (b.sum_repr' w).symm
    have hP_exp : P1 (P0 w) = ∑ l : Fin N, (inner ℝ (b l) w) • P1 (P0 (b l)) := by
      conv_lhs => rw [hw_exp]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_smul, map_smul]
    rw [hP_exp]
    refine Finset.sum_eq_zero (fun l _ => ?_)
    by_cases hl : l ∈ S_pos
    · rw [hw_b l hl, zero_smul]
    · have hμ0 : μ l = 0 := by
        have hnot : ¬ (0 < μ l) := by simpa [S_pos] using hl
        exact le_antisymm (le_of_not_gt hnot) (hμ_nn l)
      have hnorm0 : ‖P1 (P0 (b l))‖ ^ 2 = 0 := by
        have h1a : inner ℝ (b l) (M (b l)) = μ l := by
          rw [hMeig l, real_inner_smul_right, real_inner_self_eq_norm_sq, b.orthonormal.1 l, one_pow, mul_one]
        have h2a : inner ℝ (b l) (M (b l)) = ‖P1 (P0 (b l))‖ ^ 2 := by
          change inner ℝ (b l) (P0 (P1 (P0 (b l)))) = _
          conv_lhs =>
            rw [← hP0_symm (b l) (P1 (P0 (b l))), ← hP1_idem (P0 (b l)),
              ← hP1_symm (P0 (b l)) (P1 (P0 (b l))), real_inner_self_eq_norm_sq]
        linarith
      have hvec0 : P1 (P0 (b l)) = 0 := norm_eq_zero.mp (sq_eq_zero_iff.mp hnorm0)
      rw [hvec0, smul_zero]
  have hP0P1_orth_w : inner ℝ (P0 w) (P1 w) = 0 := by
    rw [← hP1_symm (P0 w) w, hP1P0_w, inner_zero_left]
  have hw0_orth_b : ∀ k ∈ S_pos, inner ℝ (b k) (w - P0 w) = 0 := by
    intro k hk
    rw [inner_sub_right, hw_b k hk, ← hP0_symm, hP0_b k hk, hw_b k hk, sub_zero]
  have hw0_orth_g : ∀ k ∈ S_pos, inner ℝ (g k) (w - P0 w) = 0 := by
    intro k hk
    rw [inner_sub_right, hw_g k hk, ← hP0_symm, hP0_g k hk, inner_zero_left, sub_zero]
  have hw1_orth_b : ∀ k ∈ S_pos, inner ℝ (b k) (w - P1 w) = 0 := by
    intro k hk
    rw [inner_sub_right, hw_b k hk, ← hP1_symm, hP1_b_eq k hk, real_inner_smul_left,
      hw_f k hk, mul_zero, sub_zero]
  have hw1_orth_g : ∀ k ∈ S_pos, inner ℝ (g k) (w - P1 w) = 0 := by
    intro k hk
    rw [inner_sub_right, hw_g k hk, ← hP1_symm, hP1_g k hk, real_inner_smul_left,
      hw_f k hk, mul_zero, sub_zero]
  let A : Fin N → ℝ := fun k => β k
  let B : Fin N → ℝ := fun k => α k * Real.sqrt (1 - μ k) - β k * s k
  let u : Fin N → E := fun k => Real.sqrt (1 - μ k) • b k - s k • g k
  have hxS_0 : x_S - P0 x_S = ∑ k ∈ S_pos, A k • g k := by
    dsimp only [x_S]
    rw [map_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [map_add, map_smul, map_smul, hP0_b k hk, hP0_g k hk, smul_zero, add_zero]
    dsimp only [A]; abel
  have hxS_1 : x_S - P1 x_S = ∑ k ∈ S_pos, B k • u k := by
    dsimp only [x_S]
    rw [map_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [map_add, map_smul, map_smul, hP1_b_eq k hk, hP1_g k hk, hf_decomp k hk]
    dsimp only [B, u]
    have hssq : s k * s k = μ k := by rw [← sq, hs_sq k]
    have hrt : Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k) = 1 - μ k :=
      Real.mul_self_sqrt (le_of_lt (h1mμ_pos k))
    have hsm : α k • (b k - s k • (Real.sqrt (1 - μ k) • g k + s k • b k)) +
        β k • (g k - Real.sqrt (1 - μ k) • (Real.sqrt (1 - μ k) • g k + s k • b k)) =
        (α k * Real.sqrt (1 - μ k) - β k * s k) • (Real.sqrt (1 - μ k) • b k - s k • g k) := by
      simp only [smul_add, smul_sub, smul_smul, ← mul_assoc]
      have hsub1 : α k • b k - (α k * s k * s k) • b k =
          (α k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • b k := by
        rw [mul_assoc, hssq, ← sub_smul]
        have hcoef : α k - α k * μ k = α k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k) := by
          rw [mul_assoc, hrt]; ring
        rw [hcoef]
      have hsub2 : β k • g k - (β k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • g k =
          (β k * s k * s k) • g k := by
        rw [mul_assoc, hrt, ← sub_smul]
        have hcoef : β k - β k * (1 - μ k) = β k * s k * s k := by
          rw [mul_assoc, hssq]; ring
        rw [hcoef]
      have hgrp_b : (α k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • b k -
          (β k * Real.sqrt (1 - μ k) * s k) • b k =
          ((α k * Real.sqrt (1 - μ k) - β k * s k) * Real.sqrt (1 - μ k)) • b k := by
        rw [← sub_smul]; congr 1; ring
      have hgrp_g : (α k * s k * Real.sqrt (1 - μ k)) • g k - (β k * s k * s k) • g k =
          ((α k * Real.sqrt (1 - μ k) - β k * s k) * s k) • g k := by
        rw [← sub_smul]; congr 1; ring
      calc α k • b k - ((α k * s k * Real.sqrt (1 - μ k)) • g k + (α k * s k * s k) • b k) +
            (β k • g k - ((β k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • g k +
              (β k * Real.sqrt (1 - μ k) * s k) • b k))
          = (α k • b k - (α k * s k * s k) • b k) +
            (β k • g k - (β k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • g k) -
            (α k * s k * Real.sqrt (1 - μ k)) • g k - (β k * Real.sqrt (1 - μ k) * s k) • b k := by
              abel
        _ = (α k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • b k + (β k * s k * s k) • g k -
            (α k * s k * Real.sqrt (1 - μ k)) • g k - (β k * Real.sqrt (1 - μ k) * s k) • b k := by
              rw [hsub1, hsub2]
        _ = ((α k * Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k)) • b k -
              (β k * Real.sqrt (1 - μ k) * s k) • b k) -
            ((α k * s k * Real.sqrt (1 - μ k)) • g k - (β k * s k * s k) • g k) := by
              abel
        _ = ((α k * Real.sqrt (1 - μ k) - β k * s k) * Real.sqrt (1 - μ k)) • b k -
            ((α k * Real.sqrt (1 - μ k) - β k * s k) * s k) • g k := by
              rw [hgrp_b, hgrp_g]
    calc (α k • b k + β k • g k) - (α k • (s k • (Real.sqrt (1 - μ k) • g k + s k • b k)) +
          β k • (Real.sqrt (1 - μ k) • (Real.sqrt (1 - μ k) • g k + s k • b k)))
        = α k • (b k - s k • (Real.sqrt (1 - μ k) • g k + s k • b k)) +
          β k • (g k - Real.sqrt (1 - μ k) • (Real.sqrt (1 - μ k) • g k + s k • b k)) := by
            simp only [smul_add, smul_sub]; abel
      _ = _ := hsm
  have hinner_uu : ∀ k l : Fin N, k ∈ S_pos → l ∈ S_pos →
      inner ℝ (u k) (u l) = if k = l then 1 else 0 := by
    intro k l hk hl
    dsimp only [u]
    simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right,
      hinner_bb k l, hinner_bg k l hk hl, hinner_gg k l hk hl]
    rw [real_inner_comm, hinner_bg l k hl hk]
    split_ifs with hkl
    · subst hkl
      have hrt : Real.sqrt (1 - μ k) * Real.sqrt (1 - μ k) = 1 - μ k :=
        Real.mul_self_sqrt (le_of_lt (h1mμ_pos k))
      have hssq : s k * s k = μ k := by rw [← sq, hs_sq k]
      linarith
    · simp
  have hinner_gu : ∀ k l : Fin N, k ∈ S_pos → l ∈ S_pos →
      inner ℝ (g k) (u l) = if k = l then -s k else 0 := by
    intro k l hk hl
    dsimp only [u]
    simp only [inner_sub_right, real_inner_smul_right, hinner_gg k l hk hl]
    rw [real_inner_comm, hinner_bg l k hl hk]
    split_ifs with hkl
    · subst hkl; ring
    · ring
  have horth_S0_w0 : inner ℝ (x_S - P0 x_S) (w - P0 w) = 0 := by
    rw [hxS_0, sum_inner]
    exact Finset.sum_eq_zero (fun k hk => by rw [real_inner_smul_left, hw0_orth_g k hk, mul_zero])
  have horth_S0_w1 : inner ℝ (x_S - P0 x_S) (w - P1 w) = 0 := by
    rw [hxS_0, sum_inner]
    exact Finset.sum_eq_zero (fun k hk => by rw [real_inner_smul_left, hw1_orth_g k hk, mul_zero])
  have horth_S1_w0 : inner ℝ (x_S - P1 x_S) (w - P0 w) = 0 := by
    rw [hxS_1, sum_inner]
    refine Finset.sum_eq_zero (fun k hk => ?_)
    dsimp only [u]
    simp only [real_inner_smul_left, inner_sub_left, hw0_orth_b k hk, hw0_orth_g k hk]
    ring
  have horth_S1_w1 : inner ℝ (x_S - P1 x_S) (w - P1 w) = 0 := by
    rw [hxS_1, sum_inner]
    refine Finset.sum_eq_zero (fun k hk => ?_)
    dsimp only [u]
    simp only [real_inner_smul_left, inner_sub_left, hw1_orth_b k hk, hw1_orth_g k hk]
    ring
  have hx0_split : x - P0 x = (x_S - P0 x_S) + (w - P0 w) := by
    rw [hx_split, map_add]; abel
  have hx1_split : x - P1 x = (x_S - P1 x_S) + (w - P1 w) := by
    rw [hx_split, map_add]; abel
  have hnorm0_sq : ‖x - P0 x‖ ^ 2 = ‖x_S - P0 x_S‖ ^ 2 + ‖w - P0 w‖ ^ 2 := by
    rw [hx0_split]
    have hsq := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth_S0_w0
    simp only [← sq] at hsq; exact hsq
  have hnorm1_sq : ‖x - P1 x‖ ^ 2 = ‖x_S - P1 x_S‖ ^ 2 + ‖w - P1 w‖ ^ 2 := by
    rw [hx1_split]
    have hsq := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth_S1_w1
    simp only [← sq] at hsq; exact hsq
  have hinner_split : inner ℝ (x - P0 x) (x - P1 x) =
      inner ℝ (x_S - P0 x_S) (x_S - P1 x_S) + inner ℝ (w - P0 w) (w - P1 w) := by
    rw [hx0_split, hx1_split]
    simp only [inner_add_left, inner_add_right]
    rw [horth_S0_w1, real_inner_comm (x_S - P1 x_S) (w - P0 w), horth_S1_w0]
    ring
  have hw_nonneg : 0 ≤ inner ℝ (w - P0 w) (w - P1 w) := by
    have hP0w : inner ℝ w (P0 w) = ‖P0 w‖ ^ 2 := by
      conv_lhs => rw [← hP0_idem w, ← hP0_symm w (P0 w)]
      rw [real_inner_self_eq_norm_sq]
    have hP1w : inner ℝ (P1 w) w = ‖P1 w‖ ^ 2 := by
      conv_lhs => rw [← hP1_idem w, hP1_symm (P1 w) w]
      rw [real_inner_self_eq_norm_sq]
    have hP0w' : inner ℝ (P0 w) w = ‖P0 w‖ ^ 2 := by rw [real_inner_comm, hP0w]
    have hP1w' : inner ℝ w (P1 w) = ‖P1 w‖ ^ 2 := by rw [real_inner_comm, hP1w]
    have hid1 : inner ℝ (w - P0 w) (w - P1 w) = ‖w‖ ^ 2 - ‖P0 w‖ ^ 2 - ‖P1 w‖ ^ 2 := by
      simp only [inner_sub_left, inner_sub_right]
      rw [real_inner_self_eq_norm_sq, hP0w', hP1w', hP0P1_orth_w]
      ring
    have hid2 : ‖w - P0 w - P1 w‖ ^ 2 = ‖w‖ ^ 2 - ‖P0 w‖ ^ 2 - ‖P1 w‖ ^ 2 := by
      rw [sub_sub, norm_sub_sq_real, norm_add_sq_real]
      simp only [inner_add_right]
      rw [hP0P1_orth_w, hP0w, hP1w']
      ring
    linarith [sq_nonneg ‖w - P0 w - P1 w‖]
  have hS0_sq : ‖x_S - P0 x_S‖ ^ 2 = ∑ k ∈ S_pos, (A k) ^ 2 := by
    rw [hxS_0, ← real_inner_self_eq_norm_sq, sum_inner]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [inner_sum]
    have hterm : ∀ l ∈ S_pos, inner ℝ (A k • g k) (A l • g l) = if k = l then A k * A l else 0 := by
      intro l hl
      rw [real_inner_smul_left, real_inner_smul_right, hinner_gg k l hk hl]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq, if_pos hk]
    ring
  have hS1_sq : ‖x_S - P1 x_S‖ ^ 2 = ∑ k ∈ S_pos, (B k) ^ 2 := by
    rw [hxS_1, ← real_inner_self_eq_norm_sq, sum_inner]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [inner_sum]
    have hterm : ∀ l ∈ S_pos, inner ℝ (B k • u k) (B l • u l) = if k = l then B k * B l else 0 := by
      intro l hl
      rw [real_inner_smul_left, real_inner_smul_right, hinner_uu k l hk hl]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq, if_pos hk]
    ring
  have hS_cross : inner ℝ (x_S - P0 x_S) (x_S - P1 x_S) = ∑ k ∈ S_pos, -(s k * A k * B k) := by
    rw [hxS_0, hxS_1, sum_inner]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [inner_sum]
    have hterm : ∀ l ∈ S_pos, inner ℝ (A k • g k) (B l • u l) =
        if k = l then -(s k * A k * B l) else 0 := by
      intro l hl
      rw [real_inner_smul_left, real_inner_smul_right, hinner_gu k l hk hl]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq, if_pos hk]
  have hcs_S : (∑ k ∈ S_pos, s k * |A k| * |B k|) ≤ ρ * ‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖ := by
    have h1 : ∑ k ∈ S_pos, s k * |A k| * |B k| ≤ ∑ k ∈ S_pos, ρ * (|A k| * |B k|) := by
      refine Finset.sum_le_sum (fun k _ => ?_)
      have hmul : s k * |A k| * |B k| = s k * (|A k| * |B k|) := by ring
      rw [hmul]
      exact mul_le_mul_of_nonneg_right (hs_le k) (mul_nonneg (abs_nonneg _) (abs_nonneg _))
    rw [← Finset.mul_sum] at h1
    have hcs := weighted_cauchy_schwarz (w := fun _ : Fin N => (1 : ℝ)) (fun _ => zero_le_one)
      (fun k => if k ∈ S_pos then |A k| else 0) (fun k => if k ∈ S_pos then |B k| else 0)
    have hL_eq : (∑ k : Fin N, (1 : ℝ) * (if k ∈ S_pos then |A k| else 0) *
        (if k ∈ S_pos then |B k| else 0)) = ∑ k ∈ S_pos, |A k| * |B k| := by
      have hite : ∀ k : Fin N, (1 : ℝ) * (if k ∈ S_pos then |A k| else 0) *
          (if k ∈ S_pos then |B k| else 0) = if k ∈ S_pos then |A k| * |B k| else 0 := fun k => by
        by_cases hk : k ∈ S_pos <;> simp [hk]
      simp_rw [hite, Finset.sum_ite_mem, Finset.univ_inter]
    have hA_eq : (∑ k : Fin N, (1 : ℝ) * (if k ∈ S_pos then |A k| else 0) ^ 2) =
        ∑ k ∈ S_pos, (A k) ^ 2 := by
      have hite : ∀ k : Fin N, (1 : ℝ) * (if k ∈ S_pos then |A k| else 0) ^ 2 =
          if k ∈ S_pos then (A k) ^ 2 else 0 := fun k => by
        by_cases hk : k ∈ S_pos <;> simp [hk, sq_abs]
      simp_rw [hite, Finset.sum_ite_mem, Finset.univ_inter]
    have hB_eq : (∑ k : Fin N, (1 : ℝ) * (if k ∈ S_pos then |B k| else 0) ^ 2) =
        ∑ k ∈ S_pos, (B k) ^ 2 := by
      have hite : ∀ k : Fin N, (1 : ℝ) * (if k ∈ S_pos then |B k| else 0) ^ 2 =
          if k ∈ S_pos then (B k) ^ 2 else 0 := fun k => by
        by_cases hk : k ∈ S_pos <;> simp [hk, sq_abs]
      simp_rw [hite, Finset.sum_ite_mem, Finset.univ_inter]
    rw [hL_eq, hA_eq, hB_eq, ← hS0_sq, ← hS1_sq] at hcs
    have hsum_le : ∑ k ∈ S_pos, |A k| * |B k| ≤ ‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖ := by
      rw [← Real.sqrt_sq (Finset.sum_nonneg (fun k _ => mul_nonneg (abs_nonneg (A k)) (abs_nonneg (B k)))),
        ← Real.sqrt_sq (mul_nonneg (norm_nonneg (x_S - P0 x_S)) (norm_nonneg (x_S - P1 x_S)))]
      exact Real.sqrt_le_sqrt (by simpa [mul_pow] using hcs)
    calc ∑ k ∈ S_pos, s k * |A k| * |B k|
        ≤ ρ * ∑ k ∈ S_pos, |A k| * |B k| := h1
      _ ≤ ρ * (‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖) := mul_le_mul_of_nonneg_left hsum_le hρ_nn
      _ = ρ * ‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖ := by ring
  have hS_lb : -ρ * ‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖ ≤ inner ℝ (x_S - P0 x_S) (x_S - P1 x_S) := by
    rw [hS_cross]
    have hterm_lb : ∀ k ∈ S_pos, -(s k * |A k| * |B k|) ≤ -(s k * A k * B k) := by
      intro k hk
      have hs_nn : 0 ≤ s k := le_of_lt (hs_pos k hk)
      have habs : s k * A k * B k ≤ s k * |A k| * |B k| := by
        calc s k * A k * B k = s k * (A k * B k) := by ring
          _ ≤ s k * |A k * B k| := mul_le_mul_of_nonneg_left (le_abs_self _) hs_nn
          _ = s k * |A k| * |B k| := by rw [abs_mul]; ring
      linarith
    have hsum_lb := Finset.sum_le_sum hterm_lb
    rw [Finset.sum_neg_distrib] at hsum_lb
    linarith
  have hnorm0_le : ‖x_S - P0 x_S‖ ≤ ‖x - P0 x‖ := by
    nlinarith [norm_nonneg (x_S - P0 x_S), norm_nonneg (x - P0 x), sq_nonneg ‖w - P0 w‖]
  have hnorm1_le : ‖x_S - P1 x_S‖ ≤ ‖x - P1 x‖ := by
    nlinarith [norm_nonneg (x_S - P1 x_S), norm_nonneg (x - P1 x), sq_nonneg ‖w - P1 w‖]
  have hmon : ρ * ‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖ ≤ ρ * ‖x - P0 x‖ * ‖x - P1 x‖ := by
    calc ρ * ‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖
        = ρ * (‖x_S - P0 x_S‖ * ‖x_S - P1 x_S‖) := by ring
      _ ≤ ρ * (‖x - P0 x‖ * ‖x - P1 x‖) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul hnorm0_le hnorm1_le (norm_nonneg _) (norm_nonneg _)) hρ_nn
      _ = ρ * ‖x - P0 x‖ * ‖x - P1 x‖ := by ring
  linarith

/-- **2-Block HGR Conditional Gradient Angle Bound (`[C/B/P]`)**:
For any strictly positive probability weight `ν` on `A × B` satisfying `HGRBounded ν ρ` (`0 ≤ ρ ≤ 1`),
let `T_0 f (a, b) = E_{ν(· | b)}[f]` and `T_1 f (a, b) = E_{ν(a | ·)}[f]`, and `∇_i f = f - T_i f`.
Then for every `f : A × B → ℝ`:
`E_ν[∇_0 f * ∇_1 f] ≥ -ρ * √(E_ν[(∇_0 f)^2] * E_ν[(∇_1 f)^2])`. -/
theorem two_block_hgr_grad_angle_bound {A B : Type*} [Fintype A] [Fintype B]
    {ν : A × B → ℝ} (hν : IsProbWeight ν) (hν_pos : ∀ p, 0 < ν p)
    {ρ : ℝ} (hρ_nn : 0 ≤ ρ) (hρ_le : ρ ≤ 1)
    (hHGR : HGRBounded ν ρ) (f : A × B → ℝ) :
    let mA : B → ℝ := fun b => ∑ a : A, ν (a, b)
    let mB : A → ℝ := fun a => ∑ b : B, ν (a, b)
    let T0 : (A × B → ℝ) → (A × B → ℝ) := fun g p => (∑ a : A, ν (a, p.2) * g (a, p.2)) / mA p.2
    let T1 : (A × B → ℝ) → (A × B → ℝ) := fun g p => (∑ b : B, ν (p.1, b) * g (p.1, b)) / mB p.1
    let g0 : A × B → ℝ := fun p => f p - T0 f p
    let g1 : A × B → ℝ := fun p => f p - T1 f p
    expVal ν (fun p => g0 p * g1 p) ≥
      -ρ * Real.sqrt (expVal ν (fun p => (g0 p) ^ 2) * expVal ν (fun p => (g1 p) ^ 2)) := by
  intro mA mB T0 T1 g0 g1
  have hmA_pos : ∀ b : B, 0 < mA b := by
    intro b
    by_cases hne : Nonempty A
    · obtain ⟨a0⟩ := hne
      have h1 : 0 < ν (a0, b) := hν_pos (a0, b)
      have hle : ν (a0, b) ≤ mA b :=
        Finset.single_le_sum (fun a _ => le_of_lt (hν_pos (a, b))) (Finset.mem_univ a0)
      linarith
    · exfalso
      have hemp : IsEmpty (A × B) := ⟨fun p => hne ⟨p.1⟩⟩
      have h0 : ∑ p : A × B, ν p = 0 := Finset.sum_eq_zero (fun p _ => (hemp.false p).elim)
      linarith [hν.2]
  have hmB_pos : ∀ a : A, 0 < mB a := by
    intro a
    by_cases hne : Nonempty B
    · obtain ⟨b0⟩ := hne
      have h1 : 0 < ν (a, b0) := hν_pos (a, b0)
      have hle : ν (a, b0) ≤ mB a :=
        Finset.single_le_sum (fun b _ => le_of_lt (hν_pos (a, b))) (Finset.mem_univ b0)
      linarith
    · exfalso
      have hemp : IsEmpty (A × B) := ⟨fun p => hne ⟨p.2⟩⟩
      have h0 : ∑ p : A × B, ν p = 0 := Finset.sum_eq_zero (fun p _ => (hemp.false p).elim)
      linarith [hν.2]
  rcases hρ_le.eq_or_lt with rfl | hρ_lt
  · have hcs := weighted_cauchy_schwarz hν.1 g0 g1
    have hbd : |expVal ν (fun p => g0 p * g1 p)| ≤
        Real.sqrt (expVal ν (fun p => (g0 p) ^ 2) * expVal ν (fun p => (g1 p) ^ 2)) := by
      refine Real.le_sqrt_of_sq_le ?_
      rw [sq_abs]
      unfold expVal
      have hrew : (∑ p : A × B, ν p * (g0 p * g1 p)) = ∑ p : A × B, ν p * g0 p * g1 p :=
        Finset.sum_congr rfl (fun p _ => by ring)
      rw [hrew]
      exact hcs
    have hneg := neg_le_of_abs_le hbd
    linarith
  · classical
    let E := EuclideanSpace ℝ (A × B)
    let toE : (A × B → ℝ) → E := fun h => WithLp.toLp 2 (fun p => Real.sqrt (ν p) * h p)
    let fromE : E → (A × B → ℝ) := fun x p => x.ofLp p / Real.sqrt (ν p)
    have hsqrt_pos : ∀ p, 0 < Real.sqrt (ν p) := fun p => Real.sqrt_pos.mpr (hν_pos p)
    have hfrom_to : ∀ h, fromE (toE h) = h := by
      intro h; funext p; dsimp only [fromE, toE]
      exact mul_div_cancel_left₀ (h p) (ne_of_gt (hsqrt_pos p))
    have hto_from : ∀ x : E, toE (fromE x) = x := by
      intro x; ext p; dsimp only [toE, fromE]
      exact mul_div_cancel₀ (x.ofLp p) (ne_of_gt (hsqrt_pos p))
    have hinner_toE : ∀ h1 h2 : A × B → ℝ, inner ℝ (toE h1) (toE h2) = expVal ν (fun p => h1 p * h2 p) := by
      intro h1 h2
      rw [PiLp.inner_apply]
      unfold expVal
      refine Finset.sum_congr rfl (fun p _ => ?_)
      dsimp only [toE]
      have hsq : Real.sqrt (ν p) * Real.sqrt (ν p) = ν p := Real.mul_self_sqrt (le_of_lt (hν_pos p))
      calc (Real.sqrt (ν p) * h2 p) * (Real.sqrt (ν p) * h1 p)
          = (Real.sqrt (ν p) * Real.sqrt (ν p)) * (h1 p * h2 p) := by ring
        _ = ν p * (h1 p * h2 p) := by rw [hsq]
    let e : E := toE (fun _ => 1)
    have he_norm : ‖e‖ = 1 := by
      have hsq1 : ‖e‖ ^ 2 = 1 := by
        rw [← real_inner_self_eq_norm_sq, hinner_toE]
        simp [expVal_const hν]
      exact (sq_eq_one_iff.mp hsq1).resolve_right (by linarith [norm_nonneg e])
    have hT0_selfAdj : ∀ u v : A × B → ℝ, expVal ν (fun p => T0 u p * v p) = expVal ν (fun p => u p * T0 v p) := by
      intro u v
      unfold expVal
      conv_lhs => rw [Fintype.sum_prod_type, Finset.sum_comm]
      conv_rhs => rw [Fintype.sum_prod_type, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      have hL : (∑ a : A, ν (a, b) * (T0 u (a, b) * v (a, b))) =
          ((∑ a : A, ν (a, b) * u (a, b)) * (∑ a : A, ν (a, b) * v (a, b))) / mA b := by
        have hrew : ∀ a : A, ν (a, b) * (T0 u (a, b) * v (a, b)) =
            (∑ a' : A, ν (a', b) * u (a', b)) * (ν (a, b) * v (a, b)) / mA b := by
          intro a; dsimp only [T0]; ring
        simp_rw [hrew, ← Finset.sum_div, ← Finset.mul_sum]
      have hR : (∑ a : A, ν (a, b) * (u (a, b) * T0 v (a, b))) =
          ((∑ a : A, ν (a, b) * u (a, b)) * (∑ a : A, ν (a, b) * v (a, b))) / mA b := by
        have hrew : ∀ a : A, ν (a, b) * (u (a, b) * T0 v (a, b)) =
            (ν (a, b) * u (a, b)) * (∑ a' : A, ν (a', b) * v (a', b)) / mA b := by
          intro a; dsimp only [T0]; ring
        simp_rw [hrew, ← Finset.sum_div, ← Finset.sum_mul]
      rw [hL, hR]
    have hT1_selfAdj : ∀ u v : A × B → ℝ, expVal ν (fun p => T1 u p * v p) = expVal ν (fun p => u p * T1 v p) := by
      intro u v
      unfold expVal
      rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      have hL : (∑ b : B, ν (a, b) * (T1 u (a, b) * v (a, b))) =
          ((∑ b : B, ν (a, b) * u (a, b)) * (∑ b : B, ν (a, b) * v (a, b))) / mB a := by
        have hrew : ∀ b : B, ν (a, b) * (T1 u (a, b) * v (a, b)) =
            (∑ b' : B, ν (a, b') * u (a, b')) * (ν (a, b) * v (a, b)) / mB a := by
          intro b; dsimp only [T1]; ring
        simp_rw [hrew, ← Finset.sum_div, ← Finset.mul_sum]
      have hR : (∑ b : B, ν (a, b) * (u (a, b) * T1 v (a, b))) =
          ((∑ b : B, ν (a, b) * u (a, b)) * (∑ b : B, ν (a, b) * v (a, b))) / mB a := by
        have hrew : ∀ b : B, ν (a, b) * (u (a, b) * T1 v (a, b)) =
            (ν (a, b) * u (a, b)) * (∑ b' : B, ν (a, b') * v (a, b')) / mB a := by
          intro b; dsimp only [T1]; ring
        simp_rw [hrew, ← Finset.sum_div, ← Finset.sum_mul]
      rw [hL, hR]
    have hT0_idem : ∀ u, T0 (T0 u) = T0 u := by
      intro u; funext p; dsimp only [T0]
      simp_rw [← Finset.sum_mul, ← mul_div_assoc]
      have hsum : (∑ a : A, ν (a, p.2)) = mA p.2 := rfl
      rw [hsum, div_div, mul_comm (mA p.2) (mA p.2)]
      field_simp [ne_of_gt (hmA_pos p.2)]
    have hT1_idem : ∀ u, T1 (T1 u) = T1 u := by
      intro u; funext p; dsimp only [T1]
      simp_rw [← Finset.sum_mul, ← mul_div_assoc]
      have hsum : (∑ b : B, ν (p.1, b)) = mB p.1 := rfl
      rw [hsum, div_div, mul_comm (mB p.1) (mB p.1)]
      field_simp [ne_of_gt (hmB_pos p.1)]
    have hT0_const : ∀ c : ℝ, T0 (fun _ => c) = fun _ => c := by
      intro c; funext p; dsimp only [T0]
      simp_rw [← Finset.sum_mul]
      have hsum : (∑ a : A, ν (a, p.2)) = mA p.2 := rfl
      rw [hsum, mul_div_cancel_left₀ c (ne_of_gt (hmA_pos p.2))]
    have hT1_const : ∀ c : ℝ, T1 (fun _ => c) = fun _ => c := by
      intro c; funext p; dsimp only [T1]
      simp_rw [← Finset.sum_mul]
      have hsum : (∑ b : B, ν (p.1, b)) = mB p.1 := rfl
      rw [hsum, mul_div_cancel_left₀ c (ne_of_gt (hmB_pos p.1))]
    let P0 : E →ₗ[ℝ] E :=
      { toFun := fun x => toE (fun p => T0 (fromE x) p - inner ℝ e x)
        map_add' := fun x y => by
          ext p; dsimp only [toE, fromE, T0]
          rw [inner_add_right]
          have h1 : ∀ a : A, ν (a, p.2) * ((x.ofLp (a, p.2) + y.ofLp (a, p.2)) / √(ν (a, p.2))) =
              ν (a, p.2) * (x.ofLp (a, p.2) / √(ν (a, p.2))) +
              ν (a, p.2) * (y.ofLp (a, p.2) / √(ν (a, p.2))) := fun a => by ring
          change Real.sqrt (ν p) * (((∑ a : A, ν (a, p.2) *
            ((x.ofLp (a, p.2) + y.ofLp (a, p.2)) / √(ν (a, p.2)))) / mA p.2) -
            (inner ℝ e x + inner ℝ e y)) =
            Real.sqrt (ν p) * (((∑ a : A, ν (a, p.2) * (x.ofLp (a, p.2) / √(ν (a, p.2)))) / mA p.2) -
              inner ℝ e x) +
            Real.sqrt (ν p) * (((∑ a : A, ν (a, p.2) * (y.ofLp (a, p.2) / √(ν (a, p.2)))) / mA p.2) -
              inner ℝ e y)
          simp_rw [h1, Finset.sum_add_distrib, add_div]
          ring
        map_smul' := fun c x => by
          ext p; dsimp only [toE, fromE, T0]
          rw [real_inner_smul_right]
          have h1 : ∀ a : A, ν (a, p.2) * ((c * x.ofLp (a, p.2)) / √(ν (a, p.2))) =
              c * (ν (a, p.2) * (x.ofLp (a, p.2) / √(ν (a, p.2)))) := fun a => by ring
          change Real.sqrt (ν p) * (((∑ a : A, ν (a, p.2) *
            ((c * x.ofLp (a, p.2)) / √(ν (a, p.2)))) / mA p.2) - c * inner ℝ e x) =
            c * (Real.sqrt (ν p) * (((∑ a : A, ν (a, p.2) * (x.ofLp (a, p.2) / √(ν (a, p.2)))) / mA p.2) -
              inner ℝ e x))
          simp_rw [h1, ← Finset.mul_sum, mul_div_assoc]
          ring }
    let P1 : E →ₗ[ℝ] E :=
      { toFun := fun x => toE (fun p => T1 (fromE x) p - inner ℝ e x)
        map_add' := fun x y => by
          ext p; dsimp only [toE, fromE, T1]
          rw [inner_add_right]
          have h1 : ∀ b : B, ν (p.1, b) * ((x.ofLp (p.1, b) + y.ofLp (p.1, b)) / √(ν (p.1, b))) =
              ν (p.1, b) * (x.ofLp (p.1, b) / √(ν (p.1, b))) +
              ν (p.1, b) * (y.ofLp (p.1, b) / √(ν (p.1, b))) := fun b => by ring
          change Real.sqrt (ν p) * (((∑ b : B, ν (p.1, b) *
            ((x.ofLp (p.1, b) + y.ofLp (p.1, b)) / √(ν (p.1, b)))) / mB p.1) -
            (inner ℝ e x + inner ℝ e y)) =
            Real.sqrt (ν p) * (((∑ b : B, ν (p.1, b) * (x.ofLp (p.1, b) / √(ν (p.1, b)))) / mB p.1) -
              inner ℝ e x) +
            Real.sqrt (ν p) * (((∑ b : B, ν (p.1, b) * (y.ofLp (p.1, b) / √(ν (p.1, b)))) / mB p.1) -
              inner ℝ e y)
          simp_rw [h1, Finset.sum_add_distrib, add_div]
          ring
        map_smul' := fun c x => by
          ext p; dsimp only [toE, fromE, T1]
          rw [real_inner_smul_right]
          have h1 : ∀ b : B, ν (p.1, b) * ((c * x.ofLp (p.1, b)) / √(ν (p.1, b))) =
              c * (ν (p.1, b) * (x.ofLp (p.1, b) / √(ν (p.1, b)))) := fun b => by ring
          change Real.sqrt (ν p) * (((∑ b : B, ν (p.1, b) *
            ((c * x.ofLp (p.1, b)) / √(ν (p.1, b)))) / mB p.1) - c * inner ℝ e x) =
            c * (Real.sqrt (ν p) * (((∑ b : B, ν (p.1, b) * (x.ofLp (p.1, b) / √(ν (p.1, b)))) / mB p.1) -
              inner ℝ e x))
          simp_rw [h1, ← Finset.mul_sum, mul_div_assoc]
          ring }
    have he_inner : ∀ x : E, inner ℝ e x = expVal ν (fromE x) := by
      intro x
      conv_lhs => rw [← hto_from x, hinner_toE]
      simp only [one_mul]
    have hP0_symm : P0.IsSymmetric := by
      intro x y
      dsimp only [P0, LinearMap.coe_mk, AddHom.coe_mk]
      conv_lhs => rw [← hto_from y, hinner_toE]
      conv_rhs => rw [← hto_from x, hinner_toE]
      have h1 : expVal ν (fun p => (T0 (fromE x) p - inner ℝ e x) * fromE y p) =
          expVal ν (fun p => T0 (fromE x) p * fromE y p) - inner ℝ e x * inner ℝ e y := by
        simp_rw [sub_mul, expVal_sub, expVal_smul, ← he_inner y]
      have h2 : expVal ν (fun p => fromE x p * (T0 (fromE y) p - inner ℝ e y)) =
          expVal ν (fun p => fromE x p * T0 (fromE y) p) - inner ℝ e x * inner ℝ e y := by
        simp_rw [mul_sub, expVal_sub]
        have h3 : expVal ν (fun p => fromE x p * inner ℝ e y) = inner ℝ e x * inner ℝ e y := by
          have hrew : (fun p => fromE x p * inner ℝ e y) = fun p => inner ℝ e y * fromE x p :=
            funext (fun _ => mul_comm _ _)
          rw [hrew, expVal_smul, ← he_inner x]; ring
        rw [h3]
      rw [h1, h2, hT0_selfAdj]
    have hP1_symm : P1.IsSymmetric := by
      intro x y
      dsimp only [P1, LinearMap.coe_mk, AddHom.coe_mk]
      conv_lhs => rw [← hto_from y, hinner_toE]
      conv_rhs => rw [← hto_from x, hinner_toE]
      have h1 : expVal ν (fun p => (T1 (fromE x) p - inner ℝ e x) * fromE y p) =
          expVal ν (fun p => T1 (fromE x) p * fromE y p) - inner ℝ e x * inner ℝ e y := by
        simp_rw [sub_mul, expVal_sub, expVal_smul, ← he_inner y]
      have h2 : expVal ν (fun p => fromE x p * (T1 (fromE y) p - inner ℝ e y)) =
          expVal ν (fun p => fromE x p * T1 (fromE y) p) - inner ℝ e x * inner ℝ e y := by
        simp_rw [mul_sub, expVal_sub]
        have h3 : expVal ν (fun p => fromE x p * inner ℝ e y) = inner ℝ e x * inner ℝ e y := by
          have hrew : (fun p => fromE x p * inner ℝ e y) = fun p => inner ℝ e y * fromE x p :=
            funext (fun _ => mul_comm _ _)
          rw [hrew, expVal_smul, ← he_inner x]; ring
        rw [h3]
      rw [h1, h2, hT1_selfAdj]
    have hP0_idem : ∀ x, P0 (P0 x) = P0 x := by
      intro x
      dsimp only [P0, LinearMap.coe_mk, AddHom.coe_mk]
      rw [hfrom_to]
      have hmean0 : inner ℝ e (toE (fun p => T0 (fromE x) p - inner ℝ e x)) = 0 := by
        rw [he_inner, hfrom_to, expVal_sub, expVal_const hν]
        have hT0_exp : expVal ν (T0 (fromE x)) = expVal ν (fromE x) := by
          have h := hT0_selfAdj (fromE x) (fun _ => 1)
          have h1 : expVal ν (fun p => T0 (fromE x) p * 1) = expVal ν (T0 (fromE x)) := by simp [expVal]
          have h2 : expVal ν (fun p => fromE x p * T0 (fun _ => 1) p) = expVal ν (fromE x) := by
            rw [hT0_const 1]; simp [expVal]
          linarith
        rw [hT0_exp, ← he_inner x, sub_self]
      rw [hmean0]
      simp_rw [sub_zero]
      congr 1; funext p
      have hsub : T0 (fun q => T0 (fromE x) q - inner ℝ e x) p = T0 (T0 (fromE x)) p - inner ℝ e x := by
        dsimp only [T0]
        simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, sub_div]
        have hsum : (∑ a : A, ν (a, p.2)) = mA p.2 := rfl
        rw [hsum]
        field_simp [ne_of_gt (hmA_pos p.2)]
      rw [hsub, hT0_idem]
    have hP1_idem : ∀ x, P1 (P1 x) = P1 x := by
      intro x
      dsimp only [P1, LinearMap.coe_mk, AddHom.coe_mk]
      rw [hfrom_to]
      have hmean0 : inner ℝ e (toE (fun p => T1 (fromE x) p - inner ℝ e x)) = 0 := by
        rw [he_inner, hfrom_to, expVal_sub, expVal_const hν]
        have hT1_exp : expVal ν (T1 (fromE x)) = expVal ν (fromE x) := by
          have h := hT1_selfAdj (fromE x) (fun _ => 1)
          have h1 : expVal ν (fun p => T1 (fromE x) p * 1) = expVal ν (T1 (fromE x)) := by simp [expVal]
          have h2 : expVal ν (fun p => fromE x p * T1 (fun _ => 1) p) = expVal ν (fromE x) := by
            rw [hT1_const 1]; simp [expVal]
          linarith
        rw [hT1_exp, ← he_inner x, sub_self]
      rw [hmean0]
      simp_rw [sub_zero]
      congr 1; funext p
      have hsub : T1 (fun q => T1 (fromE x) q - inner ℝ e x) p = T1 (T1 (fromE x)) p - inner ℝ e x := by
        dsimp only [T1]
        simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, sub_div]
        have hsum : (∑ b : B, ν (p.1, b)) = mB p.1 := rfl
        rw [hsum]
        field_simp [ne_of_gt (hmB_pos p.1)]
      rw [hsub, hT1_idem]
    have hHGR_proj : ∀ (u v : E), P1 u = u → P0 v = v → |inner ℝ u v| ≤ ρ * ‖u‖ * ‖v‖ := by
      intro u v hu hv
      have hu_mean : expVal ν (fromE u) = 0 := by
        rw [← he_inner u, ← hu]
        dsimp only [P1, LinearMap.coe_mk, AddHom.coe_mk]
        rw [he_inner, hfrom_to, expVal_sub, expVal_const hν]
        have hT1_exp : expVal ν (T1 (fromE u)) = expVal ν (fromE u) := by
          have h := hT1_selfAdj (fromE u) (fun _ => 1)
          have h1 : expVal ν (fun p => T1 (fromE u) p * 1) = expVal ν (T1 (fromE u)) := by simp [expVal]
          have h2 : expVal ν (fun p => fromE u p * T1 (fun _ => 1) p) = expVal ν (fromE u) := by
            rw [hT1_const 1]; simp [expVal]
          linarith
        rw [hT1_exp, ← he_inner u, sub_self]
      have hv_mean : expVal ν (fromE v) = 0 := by
        rw [← he_inner v, ← hv]
        dsimp only [P0, LinearMap.coe_mk, AddHom.coe_mk]
        rw [he_inner, hfrom_to, expVal_sub, expVal_const hν]
        have hT0_exp : expVal ν (T0 (fromE v)) = expVal ν (fromE v) := by
          have h := hT0_selfAdj (fromE v) (fun _ => 1)
          have h1 : expVal ν (fun p => T0 (fromE v) p * 1) = expVal ν (T0 (fromE v)) := by simp [expVal]
          have h2 : expVal ν (fun p => fromE v p * T0 (fun _ => 1) p) = expVal ν (fromE v) := by
            rw [hT0_const 1]; simp [expVal]
          linarith
        rw [hT0_exp, ← he_inner v, sub_self]
      have hneA : Nonempty A := by
        by_contra h
        have hemp : IsEmpty (A × B) := ⟨fun p => h ⟨p.1⟩⟩
        have h0 : ∑ p : A × B, ν p = 0 := Finset.sum_eq_zero (fun p _ => (hemp.false p).elim)
        linarith [hν.2]
      have hneB : Nonempty B := by
        by_contra h
        have hemp : IsEmpty (A × B) := ⟨fun p => h ⟨p.2⟩⟩
        have h0 : ∑ p : A × B, ν p = 0 := Finset.sum_eq_zero (fun p _ => (hemp.false p).elim)
        linarith [hν.2]
      let a0 : A := Classical.arbitrary A
      let b0 : B := Classical.arbitrary B
      let φ' : A → ℝ := fun a => T1 (fromE u) (a, b0)
      let ψ' : B → ℝ := fun b => T0 (fromE v) (a0, b)
      have hφ_eq : ∀ p : A × B, fromE u p = φ' p.1 := by
        intro p
        have hp := congrFun (congrArg fromE hu) p
        rw [← hp]
        dsimp only [P1, LinearMap.coe_mk, AddHom.coe_mk]
        rw [hfrom_to]
        have heu : inner ℝ e u = 0 := by rw [he_inner u]; exact hu_mean
        rw [heu, sub_zero]
      have hψ_eq : ∀ p : A × B, fromE v p = ψ' p.2 := by
        intro p
        have hp := congrFun (congrArg fromE hv) p
        rw [← hp]
        dsimp only [P0, LinearMap.coe_mk, AddHom.coe_mk]
        rw [hfrom_to]
        have hev : inner ℝ e v = 0 := by rw [he_inner v]; exact hv_mean
        rw [hev, sub_zero]
      have hφ_mean : expVal ν (fun p => φ' p.1) = 0 := by
        simp_rw [← hφ_eq]; exact hu_mean
      have hψ_mean : expVal ν (fun p => ψ' p.2) = 0 := by
        simp_rw [← hψ_eq]; exact hv_mean
      have hbd := hHGR φ' ψ' hφ_mean hψ_mean
      have hinner_eq : inner ℝ u v = expVal ν (fun p => φ' p.1 * ψ' p.2) := by
        rw [← hto_from u, ← hto_from v, hinner_toE]
        simp_rw [hφ_eq, hψ_eq]
      have hu_norm_sq : ‖u‖ ^ 2 = expVal ν (fun p => (φ' p.1) ^ 2) := by
        rw [← real_inner_self_eq_norm_sq, ← hto_from u, hinner_toE]
        simp_rw [hφ_eq, sq]
      have hv_norm_sq : ‖v‖ ^ 2 = expVal ν (fun p => (ψ' p.2) ^ 2) := by
        rw [← real_inner_self_eq_norm_sq, ← hto_from v, hinner_toE]
        simp_rw [hψ_eq, sq]
      rw [← hinner_eq, ← hu_norm_sq, ← hv_norm_sq,
        Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (norm_nonneg u), Real.sqrt_sq (norm_nonneg v)] at hbd
      simpa [mul_assoc] using hbd
    let x0 : E := toE f - (inner ℝ e (toE f)) • e
    have hx0_mean : inner ℝ e x0 = 0 := by
      dsimp only [x0]
      rw [inner_sub_right, real_inner_smul_right, real_inner_self_eq_norm_sq, he_norm, one_pow,
        mul_one, sub_self]
    have hx0_g0 : x0 - P0 x0 = toE g0 := by
      dsimp only [x0, P0, LinearMap.coe_mk, AddHom.coe_mk]
      rw [hx0_mean]
      simp_rw [sub_zero]
      ext p; dsimp only [toE, fromE, e, g0]
      have hmean_f : inner ℝ e (toE f) = expVal ν f := by
        rw [he_inner, hfrom_to]
      have hfrom_x0 : ∀ q : A × B, fromE (toE f - inner ℝ e (toE f) • e) q = f q - expVal ν f := by
        intro q; dsimp only [fromE, toE, e]
        have hsub : (WithLp.toLp 2 (fun r => Real.sqrt (ν r) * f r) -
            inner ℝ (WithLp.toLp 2 (fun r => Real.sqrt (ν r) * 1))
              (WithLp.toLp 2 (fun r => Real.sqrt (ν r) * f r)) •
            WithLp.toLp 2 (fun r => Real.sqrt (ν r) * 1)).ofLp q =
            Real.sqrt (ν q) * f q - inner ℝ e (toE f) * (Real.sqrt (ν q) * 1) := rfl
        rw [hsub, hmean_f, mul_one, sub_div, mul_div_cancel_left₀ _ (ne_of_gt (hsqrt_pos q)),
          mul_div_cancel_right₀ _ (ne_of_gt (hsqrt_pos q))]
      have hT0_x0 : T0 (fromE (toE f - inner ℝ e (toE f) • e)) p = T0 f p - expVal ν f := by
        dsimp only [T0]
        simp_rw [hfrom_x0, mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, sub_div]
        have hsum : (∑ a : A, ν (a, p.2)) = mA p.2 := rfl
        rw [hsum, mul_div_cancel_left₀ _ (ne_of_gt (hmA_pos p.2))]
      change (toE f - inner ℝ e (toE f) • e).ofLp p - Real.sqrt (ν p) *
        (T0 (fromE (toE f - inner ℝ e (toE f) • e)) p) = Real.sqrt (ν p) * (f p - T0 f p)
      rw [hT0_x0]
      change (Real.sqrt (ν p) * f p - inner ℝ e (toE f) * (Real.sqrt (ν p) * 1)) -
        Real.sqrt (ν p) * (T0 f p - expVal ν f) = Real.sqrt (ν p) * (f p - T0 f p)
      rw [hmean_f]; ring
    have hx0_g1 : x0 - P1 x0 = toE g1 := by
      dsimp only [x0, P1, LinearMap.coe_mk, AddHom.coe_mk]
      rw [hx0_mean]
      simp_rw [sub_zero]
      ext p; dsimp only [toE, fromE, e, g1]
      have hmean_f : inner ℝ e (toE f) = expVal ν f := by
        rw [he_inner, hfrom_to]
      have hfrom_x0 : ∀ q : A × B, fromE (toE f - inner ℝ e (toE f) • e) q = f q - expVal ν f := by
        intro q; dsimp only [fromE, toE, e]
        have hsub : (WithLp.toLp 2 (fun r => Real.sqrt (ν r) * f r) -
            inner ℝ (WithLp.toLp 2 (fun r => Real.sqrt (ν r) * 1))
              (WithLp.toLp 2 (fun r => Real.sqrt (ν r) * f r)) •
            WithLp.toLp 2 (fun r => Real.sqrt (ν r) * 1)).ofLp q =
            Real.sqrt (ν q) * f q - inner ℝ e (toE f) * (Real.sqrt (ν q) * 1) := rfl
        rw [hsub, hmean_f, mul_one, sub_div, mul_div_cancel_left₀ _ (ne_of_gt (hsqrt_pos q)),
          mul_div_cancel_right₀ _ (ne_of_gt (hsqrt_pos q))]
      have hT1_x0 : T1 (fromE (toE f - inner ℝ e (toE f) • e)) p = T1 f p - expVal ν f := by
        dsimp only [T1]
        simp_rw [hfrom_x0, mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, sub_div]
        have hsum : (∑ b : B, ν (p.1, b)) = mB p.1 := rfl
        rw [hsum, mul_div_cancel_left₀ _ (ne_of_gt (hmB_pos p.1))]
      change (toE f - inner ℝ e (toE f) • e).ofLp p - Real.sqrt (ν p) *
        (T1 (fromE (toE f - inner ℝ e (toE f) • e)) p) = Real.sqrt (ν p) * (f p - T1 f p)
      rw [hT1_x0]
      change (Real.sqrt (ν p) * f p - inner ℝ e (toE f) * (Real.sqrt (ν p) * 1)) -
        Real.sqrt (ν p) * (T1 f p - expVal ν f) = Real.sqrt (ν p) * (f p - T1 f p)
      rw [hmean_f]; ring
    have hang := two_proj_angle_ineq P0 P1 hP0_symm hP0_idem hP1_symm hP1_idem hρ_nn hρ_lt hHGR_proj x0
    rw [hx0_g0, hx0_g1, hinner_toE] at hang
    have hn0 : ‖toE g0‖ = Real.sqrt (expVal ν (fun p => (g0 p) ^ 2)) := by
      rw [← Real.sqrt_sq (norm_nonneg _), ← real_inner_self_eq_norm_sq, hinner_toE]
      simp_rw [sq]
    have hn1 : ‖toE g1‖ = Real.sqrt (expVal ν (fun p => (g1 p) ^ 2)) := by
      rw [← Real.sqrt_sq (norm_nonneg _), ← real_inner_self_eq_norm_sq, hinner_toE]
      simp_rw [sq]
    rw [hn0, hn1, mul_assoc, ← Real.sqrt_mul (expVal_nonneg hν (fun _ => sq_nonneg _))] at hang
    exact hang

end TwoBlockHGR

/-! ## 3. Zegarlinski / Dobrushin–Shlosman Inter-Block Weak-Mixing Lifting (`[C/B/P]`) -/

section ZegarlinskiInterblockLifting

private noncomputable def twoCoordEquiv {M : ℕ} {Q : Type*} [Nonempty Q]
    {i j : Fin M} (hij : i ≠ j) :
    ((Q × Q) × {z : Fin M → Q // z i = Classical.arbitrary Q ∧ z j = Classical.arbitrary Q}) ≃
      (Fin M → Q) :=
  let qstar : Q := Classical.arbitrary Q
  { toFun := fun p => Function.update (Function.update p.2.1 i p.1.1) j p.1.2
    invFun := fun x =>
      ((x i, x j), ⟨Function.update (Function.update x i qstar) j qstar,
        by simp [Function.update_of_ne hij, qstar], by simp [qstar]⟩)
    left_inv := fun ⟨⟨q1, q2⟩, ⟨z, hzi, hzj⟩⟩ => by
      refine Prod.ext (Prod.ext ?_ ?_) (Subtype.ext ?_)
      · simp [Function.update_of_ne hij]
      · simp
      · ext k
        by_cases hkj : k = j
        · subst hkj; simp [qstar, hzj]
        · by_cases hki : k = i
          · subst hki; simp [qstar, Function.update_of_ne hij, hzi]
          · simp [hkj, hki]
    right_inv := fun x => by
      ext k
      by_cases hkj : k = j
      · subst hkj; simp
      · by_cases hki : k = i
        · subst hki; simp [Function.update_of_ne hij]
        · simp [hkj, hki] }

/-- 2-block conditional probability weight `ν_{ij}(· | z)` on `Q × Q` obtained by fixing
exterior coordinates `z_{≠ i, j}`. `[C/B]` -/
noncomputable def twoBlockCondWeight {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
   
    (μ : (Fin M → Q) → ℝ) (i j : Fin M) (z : Fin M → Q) : Q × Q → ℝ :=
  fun p =>
    let Z := ∑ r : Q × Q, μ (Function.update (Function.update z i r.1) j r.2)
    μ (Function.update (Function.update z i p.1) j p.2) / Z

lemma isProbWeight_twoBlockCondWeight {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
   
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) (i j : Fin M) (z : Fin M → Q) :
    IsProbWeight (twoBlockCondWeight μ i j z) ∧ ∀ p, 0 < twoBlockCondWeight μ i j z p := by
  let Z : ℝ := ∑ r : Q × Q, μ (Function.update (Function.update z i r.1) j r.2)
  have hZ_pos : 0 < Z := by
    obtain ⟨q0⟩ := (inferInstance : Nonempty Q)
    have h1 : 0 < μ (Function.update (Function.update z i q0) j q0) := hμ_pos _
    have hle : μ (Function.update (Function.update z i q0) j q0) ≤ Z :=
      Finset.single_le_sum (f := fun r : Q × Q => μ (Function.update (Function.update z i r.1) j r.2))
        (fun r _ => le_of_lt (hμ_pos _)) (Finset.mem_univ (q0, q0))
    linarith
  refine ⟨⟨fun p => div_nonneg (le_of_lt (hμ_pos _)) (le_of_lt hZ_pos), ?_⟩,
    fun p => div_pos (hμ_pos _) hZ_pos⟩
  unfold twoBlockCondWeight
  rw [← Finset.sum_div]
  exact div_self (ne_of_gt hZ_pos)

/-- **Symmetric Inter-Block HGR / Dobrushin–Shlosman Weak-Mixing Matrix (`[C/B/P]` or `[X]`)**:
Bundles a symmetric nonnegative `M × M` matrix `C` (`C i i = 0`, `0 ≤ C i j = C j i`)
bounding the 2-block conditional HGR correlation across every pair of distinct blocks `i ≠ j`
uniformly over all exterior configurations `z`, with DS row-sum contraction `∑ j, C i j ≤ γ_DS < 1`. -/
structure BlockHGRMatrix {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (γ_DS : ℝ) where
  C : Matrix (Fin M) (Fin M) ℝ
  diag_zero : ∀ i : Fin M, C i i = 0
  nonneg : ∀ i j : Fin M, 0 ≤ C i j
  symm : Cᵀ = C
  hgr_bound : ∀ (i j : Fin M), i ≠ j → ∀ (z : Fin M → Q),
    HGRBounded (twoBlockCondWeight μ i j z) (C i j)
  le_one : ∀ i j : Fin M, C i j ≤ 1
  gamma_nn : 0 ≤ γ_DS
  gamma_lt_one : γ_DS < 1
  row_sum_le : ∀ i : Fin M, ∑ j : Fin M, C i j ≤ γ_DS

lemma blockGrad_pair_angle_bound {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ_pos : ∀ x, 0 < μ x) {γ_DS : ℝ} (hC : BlockHGRMatrix μ γ_DS)
    {i j : Fin M} (hij : i ≠ j) (f : (Fin M → Q) → ℝ) :
    expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x) ≥
      -hC.C i j * Real.sqrt (expVal μ (fun x => (blockGrad μ i f x) ^ 2) *
        expVal μ (fun x => (blockGrad μ j f x) ^ 2)) := by
  classical
  let e := twoCoordEquiv (M := M) (Q := Q) hij
  let qstar : Q := Classical.arbitrary Q
  let S_ext := {z : Fin M → Q // z i = qstar ∧ z j = qstar}
  let marg2 : S_ext → ℝ := fun z =>
    ∑ r : Q × Q, μ (Function.update (Function.update z.1 i r.1) j r.2)
  have hmarg2_pos : ∀ z : S_ext, 0 < marg2 z := by
    intro z
    have h1 : 0 < μ (Function.update (Function.update z.1 i qstar) j qstar) := hμ_pos _
    have hle : μ (Function.update (Function.update z.1 i qstar) j qstar) ≤ marg2 z :=
      Finset.single_le_sum (f := fun r : Q × Q => μ (Function.update (Function.update z.1 i r.1) j r.2))
        (fun r _ => le_of_lt (hμ_pos _)) (Finset.mem_univ (qstar, qstar))
    linarith
  have hfiber : ∀ z : S_ext,
      let ν := twoBlockCondWeight μ i j z.1
      let g0_z : Q × Q → ℝ := fun p => blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2)
      let g1_z : Q × Q → ℝ := fun p => blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)
      expVal ν (fun p => g0_z p * g1_z p) ≥
        -hC.C i j * Real.sqrt (expVal ν (fun p => (g0_z p) ^ 2) * expVal ν (fun p => (g1_z p) ^ 2)) := by
    intro z
    obtain ⟨hν_prob, hν_pos⟩ := isProbWeight_twoBlockCondWeight hμ_pos i j z.1
    have h2 := two_block_hgr_grad_angle_bound hν_prob hν_pos (hC.nonneg i j) (hC.le_one i j)
      (hC.hgr_bound i j hij z.1) (fun p => f (Function.update (Function.update z.1 i p.1) j p.2))
    have hg0_eq : ∀ p : Q × Q,
        blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2) =
        f (Function.update (Function.update z.1 i p.1) j p.2) -
          (∑ a : Q, twoBlockCondWeight μ i j z.1 (a, p.2) *
            f (Function.update (Function.update z.1 i a) j p.2)) /
            (∑ a : Q, twoBlockCondWeight μ i j z.1 (a, p.2)) := by
      intro p
      dsimp only [blockGrad, condExpOp, expVal, condWeight, condSlice]
      have hupd_comm : ∀ a : Q,
          Function.update (Function.update (Function.update z.1 i p.1) j p.2) i a =
          Function.update (Function.update z.1 i a) j p.2 := by
        intro a; ext k
        by_cases hkj : k = j
        · subst hkj; simp [Function.update_of_ne hij.symm]
        · by_cases hki : k = i
          · subst hki; simp [Function.update_of_ne hij]
          · simp [hkj, hki]
      have hm_pos : 0 < condMarg μ i (Function.update (Function.update z.1 i p.1) j p.2) :=
        condMarg_pos hμ_pos _ _
      simp only [hm_pos, ↓reduceIte]
      have hmarg_eq : condMarg μ i (Function.update (Function.update z.1 i p.1) j p.2) =
          marg2 z * (∑ a : Q, twoBlockCondWeight μ i j z.1 (a, p.2)) := by
        unfold condMarg twoBlockCondWeight
        simp_rw [hupd_comm, ← Finset.sum_div]
        have hZ : (∑ r : Q × Q, μ (Function.update (Function.update z.1 i r.1) j r.2)) = marg2 z := rfl
        rw [hZ, mul_div_cancel₀ _ (ne_of_gt (hmarg2_pos z))]
      have hnum_eq : (∑ a : Q, (μ (Function.update (Function.update (Function.update z.1 i p.1) j p.2) i a) /
            condMarg μ i (Function.update (Function.update z.1 i p.1) j p.2)) *
            f (Function.update (Function.update (Function.update z.1 i p.1) j p.2) i a)) =
          (∑ a : Q, twoBlockCondWeight μ i j z.1 (a, p.2) *
            f (Function.update (Function.update z.1 i a) j p.2)) /
            (∑ a : Q, twoBlockCondWeight μ i j z.1 (a, p.2)) := by
        have hZ_ne : marg2 z ≠ 0 := ne_of_gt (hmarg2_pos z)
        have hsum_ne : (∑ a : Q, twoBlockCondWeight μ i j z.1 (a, p.2)) ≠ 0 := by
          obtain ⟨q0⟩ := (inferInstance : Nonempty Q)
          have h1 : 0 < twoBlockCondWeight μ i j z.1 (q0, p.2) := hν_pos (q0, p.2)
          have hle := Finset.single_le_sum (fun a _ => le_of_lt (hν_pos (a, p.2))) (Finset.mem_univ q0)
          linarith
        rw [hmarg_eq]
        simp_rw [hupd_comm, twoBlockCondWeight]
        have hZ : (∑ r : Q × Q, μ (Function.update (Function.update z.1 i r.1) j r.2)) = marg2 z := rfl
        simp_rw [hZ]
        have hL_div : (∑ a : Q, (μ (Function.update (Function.update z.1 i a) j p.2) /
            (marg2 z * (∑ a_1 : Q, μ (Function.update (Function.update z.1 i a_1) j p.2) / marg2 z))) *
            f (Function.update (Function.update z.1 i a) j p.2)) =
            (∑ a : Q, μ (Function.update (Function.update z.1 i a) j p.2) *
              f (Function.update (Function.update z.1 i a) j p.2)) /
            (marg2 z * (∑ a_1 : Q, μ (Function.update (Function.update z.1 i a_1) j p.2) / marg2 z)) := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl (fun a _ => by ring)
        have hR_div : (∑ a : Q, (μ (Function.update (Function.update z.1 i a) j p.2) / marg2 z) *
            f (Function.update (Function.update z.1 i a) j p.2)) =
            (∑ a : Q, μ (Function.update (Function.update z.1 i a) j p.2) *
              f (Function.update (Function.update z.1 i a) j p.2)) / marg2 z := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl (fun a _ => by ring)
        have hS_div : (∑ a : Q, μ (Function.update (Function.update z.1 i a) j p.2) / marg2 z) =
            (∑ a : Q, μ (Function.update (Function.update z.1 i a) j p.2)) / marg2 z :=
          (Finset.sum_div _ _ _).symm
        rw [hL_div, hR_div, hS_div, mul_div_cancel₀ _ hZ_ne, div_div_div_cancel_right₀ hZ_ne]
      rw [hnum_eq]
    have hg1_eq : ∀ p : Q × Q,
        blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2) =
        f (Function.update (Function.update z.1 i p.1) j p.2) -
          (∑ b : Q, twoBlockCondWeight μ i j z.1 (p.1, b) *
            f (Function.update (Function.update z.1 i p.1) j b)) /
            (∑ b : Q, twoBlockCondWeight μ i j z.1 (p.1, b)) := by
      intro p
      dsimp only [blockGrad, condExpOp, expVal, condWeight, condSlice]
      have hupd_comm : ∀ b : Q,
          Function.update (Function.update (Function.update z.1 i p.1) j p.2) j b =
          Function.update (Function.update z.1 i p.1) j b := fun b => by simp [Function.update_idem]
      have hm_pos : 0 < condMarg μ j (Function.update (Function.update z.1 i p.1) j p.2) :=
        condMarg_pos hμ_pos _ _
      simp only [hm_pos, ↓reduceIte]
      have hmarg_eq : condMarg μ j (Function.update (Function.update z.1 i p.1) j p.2) =
          marg2 z * (∑ b : Q, twoBlockCondWeight μ i j z.1 (p.1, b)) := by
        unfold condMarg twoBlockCondWeight
        simp_rw [hupd_comm, ← Finset.sum_div]
        have hZ : (∑ r : Q × Q, μ (Function.update (Function.update z.1 i r.1) j r.2)) = marg2 z := rfl
        rw [hZ, mul_div_cancel₀ _ (ne_of_gt (hmarg2_pos z))]
      have hnum_eq : (∑ b : Q, (μ (Function.update (Function.update (Function.update z.1 i p.1) j p.2) j b) /
            condMarg μ j (Function.update (Function.update z.1 i p.1) j p.2)) *
            f (Function.update (Function.update (Function.update z.1 i p.1) j p.2) j b)) =
          (∑ b : Q, twoBlockCondWeight μ i j z.1 (p.1, b) *
            f (Function.update (Function.update z.1 i p.1) j b)) /
            (∑ b : Q, twoBlockCondWeight μ i j z.1 (p.1, b)) := by
        have hZ_ne : marg2 z ≠ 0 := ne_of_gt (hmarg2_pos z)
        rw [hmarg_eq]
        simp_rw [hupd_comm, twoBlockCondWeight]
        have hZ : (∑ r : Q × Q, μ (Function.update (Function.update z.1 i r.1) j r.2)) = marg2 z := rfl
        simp_rw [hZ]
        have hL_div : (∑ b : Q, (μ (Function.update (Function.update z.1 i p.1) j b) /
            (marg2 z * (∑ b_1 : Q, μ (Function.update (Function.update z.1 i p.1) j b_1) / marg2 z))) *
            f (Function.update (Function.update z.1 i p.1) j b)) =
            (∑ b : Q, μ (Function.update (Function.update z.1 i p.1) j b) *
              f (Function.update (Function.update z.1 i p.1) j b)) /
            (marg2 z * (∑ b_1 : Q, μ (Function.update (Function.update z.1 i p.1) j b_1) / marg2 z)) := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl (fun b _ => by ring)
        have hR_div : (∑ b : Q, (μ (Function.update (Function.update z.1 i p.1) j b) / marg2 z) *
            f (Function.update (Function.update z.1 i p.1) j b)) =
            (∑ b : Q, μ (Function.update (Function.update z.1 i p.1) j b) *
              f (Function.update (Function.update z.1 i p.1) j b)) / marg2 z := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl (fun b _ => by ring)
        have hS_div : (∑ b : Q, μ (Function.update (Function.update z.1 i p.1) j b) / marg2 z) =
            (∑ b : Q, μ (Function.update (Function.update z.1 i p.1) j b)) / marg2 z :=
          (Finset.sum_div _ _ _).symm
        rw [hL_div, hR_div, hS_div, mul_div_cancel₀ _ hZ_ne, div_div_div_cancel_right₀ hZ_ne]
      rw [hnum_eq]
    dsimp only
    simp_rw [hg0_eq, hg1_eq]
    exact h2
  have hsum_split : ∀ h : (Fin M → Q) → ℝ,
      expVal μ h = ∑ z : S_ext, marg2 z * expVal (twoBlockCondWeight μ i j z.1)
        (fun p => h (Function.update (Function.update z.1 i p.1) j p.2)) := by
    intro h
    unfold expVal
    rw [← Fintype.sum_equiv e _ (fun x => μ x * h x) (fun _ => rfl), Fintype.sum_prod_type,
      Finset.sum_comm]
    refine Finset.sum_congr rfl (fun z _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    dsimp only [twoBlockCondWeight]
    have hZ : (∑ r : Q × Q, μ (Function.update (Function.update z.1 i r.1) j r.2)) = marg2 z := rfl
    rw [hZ]
    have hZ_ne : marg2 z ≠ 0 := ne_of_gt (hmarg2_pos z)
    have he_eq : e (p, z) = Function.update (Function.update z.1 i p.1) j p.2 := rfl
    rw [he_eq]
    field_simp [hZ_ne]
  rw [hsum_split (fun x => blockGrad μ i f x * blockGrad μ j f x),
    hsum_split (fun x => (blockGrad μ i f x) ^ 2),
    hsum_split (fun x => (blockGrad μ j f x) ^ 2)]
  let a : S_ext → ℝ := fun z => Real.sqrt (expVal (twoBlockCondWeight μ i j z.1)
    (fun p => (blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2))
  let b : S_ext → ℝ := fun z => Real.sqrt (expVal (twoBlockCondWeight μ i j z.1)
    (fun p => (blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2))
  have ha_sq : ∀ z : S_ext, (a z) ^ 2 = expVal (twoBlockCondWeight μ i j z.1)
      (fun p => (blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2) := by
    intro z
    exact Real.sq_sqrt (expVal_nonneg (isProbWeight_twoBlockCondWeight hμ_pos i j z.1).1 (fun _ => sq_nonneg _))
  have hb_sq : ∀ z : S_ext, (b z) ^ 2 = expVal (twoBlockCondWeight μ i j z.1)
      (fun p => (blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2) := by
    intro z
    exact Real.sq_sqrt (expVal_nonneg (isProbWeight_twoBlockCondWeight hμ_pos i j z.1).1 (fun _ => sq_nonneg _))
  have hsum_lb : ∑ z : S_ext, marg2 z * expVal (twoBlockCondWeight μ i j z.1)
      (fun p => blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2) *
        blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)) ≥
      -hC.C i j * ∑ z : S_ext, marg2 z * a z * b z := by
    have hpt : ∀ z : S_ext, -hC.C i j * (marg2 z * a z * b z) ≤
        marg2 z * expVal (twoBlockCondWeight μ i j z.1)
          (fun p => blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2) *
            blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)) := by
      intro z
      have hfz := hfiber z
      have hm := mul_le_mul_of_nonneg_left hfz (le_of_lt (hmarg2_pos z))
      have hsq_split : Real.sqrt (
          (expVal (twoBlockCondWeight μ i j z.1) fun p =>
            blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2) ^ 2) *
          (expVal (twoBlockCondWeight μ i j z.1) fun p =>
            blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2) ^ 2)) =
          a z * b z := by
        rw [Real.sqrt_mul (expVal_nonneg (isProbWeight_twoBlockCondWeight hμ_pos i j z.1).1 (fun _ => sq_nonneg _))]
      dsimp only at hfz hm
      rw [hsq_split] at hm
      linarith
    have hs := Finset.sum_le_sum (fun z (_ : z ∈ Finset.univ) => hpt z)
    rw [← Finset.mul_sum] at hs
    exact hs
  have hcs := weighted_cauchy_schwarz (w := marg2) (fun z => le_of_lt (hmarg2_pos z)) a b
  simp_rw [ha_sq, hb_sq] at hcs
  have hprod_sqrt : ∑ z : S_ext, marg2 z * a z * b z ≤
      Real.sqrt ((∑ z : S_ext, marg2 z * expVal (twoBlockCondWeight μ i j z.1)
        (fun p => (blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2)) *
        (∑ z : S_ext, marg2 z * expVal (twoBlockCondWeight μ i j z.1)
          (fun p => (blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2))) := by
    refine Real.le_sqrt_of_sq_le hcs
  have hfin : -hC.C i j * Real.sqrt ((∑ z : S_ext, marg2 z * expVal (twoBlockCondWeight μ i j z.1)
        (fun p => (blockGrad μ i f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2)) *
        (∑ z : S_ext, marg2 z * expVal (twoBlockCondWeight μ i j z.1)
          (fun p => (blockGrad μ j f (Function.update (Function.update z.1 i p.1) j p.2)) ^ 2))) ≤
      -hC.C i j * ∑ z : S_ext, marg2 z * a z * b z := by
    have hmul := mul_le_mul_of_nonneg_left hprod_sqrt (hC.nonneg i j)
    linarith
  exact le_trans hfin hsum_lb

/-- **Zegarlinski Conditional Tensorization Theorem (`[C/B/P]`)**:
Constructively discharges `hzegarlinski` in `Round04PoincareLSI.interacting_conditional_poincare_uniform_in_volume`
with `K_Z = (1 - γ_DS)⁻¹` for any strictly positive joint probability weight `μ` on `Fin M → Q`
whose inter-block conditional HGR correlations are controlled by `BlockHGRMatrix μ γ_DS` (`γ_DS < 1`). -/
theorem zegarlinski_conditional_tensorization {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
   
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    {γ_DS : ℝ} (hC : BlockHGRMatrix μ γ_DS) :
    ∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ (1 - γ_DS)⁻¹ *
        ∑ i : Fin M, expVal μ (fun x => varProb (condWeight μ i x) (condSlice f i x)) := by
  classical
  have h1m_pos : 0 < 1 - γ_DS := sub_pos.mpr hC.gamma_lt_one
  have hcoercive : ∀ f : (Fin M → Q) → ℝ,
      (1 - γ_DS) * expVal μ (fun x => f x * blockLaplacian μ f x) ≤
        expVal μ (fun x => (blockLaplacian μ f x) ^ 2) := by
    intro f
    let v : Fin M → ℝ := fun i => Real.sqrt (expVal μ (fun x => (blockGrad μ i f x) ^ 2))
    have hv_sq : ∀ i : Fin M, (v i) ^ 2 = expVal μ (fun x => (blockGrad μ i f x) ^ 2) := fun i =>
      Real.sq_sqrt (expVal_nonneg hμ (fun _ => sq_nonneg _))
    have hL_sq : expVal μ (fun x => (blockLaplacian μ f x) ^ 2) =
        ∑ i : Fin M, ∑ j : Fin M, expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x) := by
      unfold blockLaplacian expVal
      have hterm : ∀ x : Fin M → Q,
          μ x * (∑ i : Fin M, blockGrad μ i f x) ^ 2 =
          ∑ i : Fin M, ∑ j : Fin M, μ x * (blockGrad μ i f x * blockGrad μ j f x) := by
        intro x
        rw [sq, Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.mul_sum, Finset.mul_sum]
      simp_rw [hterm]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
    have hdiag_split :
        (∑ i : Fin M, ∑ j : Fin M, expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) =
        (∑ i : Fin M, (v i) ^ 2) +
        ∑ i : Fin M, ∑ j : Fin M,
          (if i = j then (0 : ℝ) else expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) := by
      have hrow : ∀ i : Fin M,
          (∑ j : Fin M, expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) =
          (v i) ^ 2 + ∑ j : Fin M,
            (if i = j then (0 : ℝ) else expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) := by
        intro i
        rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ i)]
        have hself : expVal μ (fun x => blockGrad μ i f x * blockGrad μ i f x) = (v i) ^ 2 := by
          rw [hv_sq i]; unfold expVal; refine Finset.sum_congr rfl (fun x _ => by ring)
        have hoff : (∑ j ∈ Finset.univ.erase i,
            expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) =
            ∑ j : Fin M, (if i = j then (0 : ℝ) else
              expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) := by
          rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ i), if_pos rfl, zero_add]
          refine Finset.sum_congr rfl (fun j hj => ?_)
          rw [if_neg (Finset.ne_of_mem_erase hj).symm]
        rw [hself, hoff]
      simp_rw [hrow, Finset.sum_add_distrib]
    have hoff_lb :
        -(∑ i : Fin M, ∑ j : Fin M, hC.C i j * v i * v j) ≤
        ∑ i : Fin M, ∑ j : Fin M,
          (if i = j then (0 : ℝ) else expVal μ (fun x => blockGrad μ i f x * blockGrad μ j f x)) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_le_sum (fun i _ => ?_)
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_le_sum (fun j _ => ?_)
      by_cases hij : i = j
      · subst hij; simp [hC.diag_zero i]
      · simp only [hij, ↓reduceIte]
        have hang := blockGrad_pair_angle_bound hμ_pos hC hij f
        have hsqrt_eq : Real.sqrt (expVal μ (fun x => (blockGrad μ i f x) ^ 2) *
            expVal μ (fun x => (blockGrad μ j f x) ^ 2)) = v i * v j := by
          rw [← hv_sq i, ← hv_sq j, Real.sqrt_mul (sq_nonneg _),
            Real.sqrt_sq (Real.sqrt_nonneg _), Real.sqrt_sq (Real.sqrt_nonneg _)]
        rw [hsqrt_eq] at hang
        linarith
    have hschur : ∑ i : Fin M, ∑ j : Fin M, hC.C i j * v i * v j ≤ γ_DS * ∑ i : Fin M, (v i) ^ 2 := by
      have h2ab : ∀ i j : Fin M, hC.C i j * v i * v j ≤
          (1 / 2 : ℝ) * (hC.C i j * (v i) ^ 2 + hC.C i j * (v j) ^ 2) := by
        intro i j
        have hc := hC.nonneg i j
        nlinarith [sq_nonneg (v i - v j)]
      have hsum1 : ∑ i : Fin M, ∑ j : Fin M, hC.C i j * v i * v j ≤
          (1 / 2 : ℝ) * (∑ i : Fin M, ∑ j : Fin M, hC.C i j * (v i) ^ 2 +
            ∑ i : Fin M, ∑ j : Fin M, hC.C i j * (v j) ^ 2) := by
        calc ∑ i : Fin M, ∑ j : Fin M, hC.C i j * v i * v j
            ≤ ∑ i : Fin M, ∑ j : Fin M,
                (1 / 2 : ℝ) * (hC.C i j * (v i) ^ 2 + hC.C i j * (v j) ^ 2) :=
              Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ => h2ab i j))
          _ = (1 / 2 : ℝ) * (∑ i : Fin M, ∑ j : Fin M, hC.C i j * (v i) ^ 2 +
                ∑ i : Fin M, ∑ j : Fin M, hC.C i j * (v j) ^ 2) := by
              simp_rw [← Finset.mul_sum, Finset.sum_add_distrib]
      have hrow1 : ∑ i : Fin M, ∑ j : Fin M, hC.C i j * (v i) ^ 2 ≤ γ_DS * ∑ i : Fin M, (v i) ^ 2 := by
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun i _ => ?_)
        rw [← Finset.sum_mul]
        exact mul_le_mul_of_nonneg_right (hC.row_sum_le i) (sq_nonneg _)
      have hrow2 : ∑ i : Fin M, ∑ j : Fin M, hC.C i j * (v j) ^ 2 ≤ γ_DS * ∑ i : Fin M, (v i) ^ 2 := by
        rw [Finset.sum_comm]
        have hsym : ∀ i j : Fin M, hC.C j i = hC.C i j := fun i j => by
          have := congrFun (congrFun hC.symm i) j
          simpa [Matrix.transpose_apply] using this
        have hrew : (∑ j : Fin M, ∑ i : Fin M, hC.C i j * (v j) ^ 2) =
            ∑ j : Fin M, ∑ i : Fin M, hC.C j i * (v j) ^ 2 := by
          refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by rw [hsym i j]))
        rw [hrew, Finset.mul_sum]
        refine Finset.sum_le_sum (fun j _ => ?_)
        rw [← Finset.sum_mul]
        exact mul_le_mul_of_nonneg_right (hC.row_sum_le j) (sq_nonneg _)
      linarith
    have hdir : expVal μ (fun x => f x * blockLaplacian μ f x) = ∑ i : Fin M, (v i) ^ 2 := by
      rw [expVal_blockLaplacian_dirichlet hμ_pos f]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hv_sq i, expVal_blockGrad_sq_eq_var hμ_pos i f]
    rw [hL_sq, hdiag_split, hdir]
    linarith
  let E := EuclideanSpace ℝ (Fin M → Q)
  let toE : ((Fin M → Q) → ℝ) → E := fun h => WithLp.toLp 2 (fun x => Real.sqrt (μ x) * h x)
  let fromE : E → ((Fin M → Q) → ℝ) := fun u x => u.ofLp x / Real.sqrt (μ x)
  have hsqrt_pos : ∀ x, 0 < Real.sqrt (μ x) := fun x => Real.sqrt_pos.mpr (hμ_pos x)
  have hfrom_to : ∀ h, fromE (toE h) = h := by
    intro h; funext x; dsimp only [fromE, toE]
    exact mul_div_cancel_left₀ (h x) (ne_of_gt (hsqrt_pos x))
  have hto_from : ∀ u : E, toE (fromE u) = u := by
    intro u; ext x; dsimp only [toE, fromE]
    exact mul_div_cancel₀ (u.ofLp x) (ne_of_gt (hsqrt_pos x))
  have hinner_toE : ∀ h1 h2 : (Fin M → Q) → ℝ,
      inner ℝ (toE h1) (toE h2) = expVal μ (fun x => h1 x * h2 x) := by
    intro h1 h2
    rw [PiLp.inner_apply]
    unfold expVal
    refine Finset.sum_congr rfl (fun x _ => ?_)
    dsimp only [toE]
    have hsq : Real.sqrt (μ x) * Real.sqrt (μ x) = μ x := Real.mul_self_sqrt (le_of_lt (hμ_pos x))
    calc (Real.sqrt (μ x) * h2 x) * (Real.sqrt (μ x) * h1 x)
        = (Real.sqrt (μ x) * Real.sqrt (μ x)) * (h1 x * h2 x) := by ring
      _ = μ x * (h1 x * h2 x) := by rw [hsq]
  let L_op : E →ₗ[ℝ] E :=
    { toFun := fun u => toE (blockLaplacian μ (fromE u))
      map_add' := fun u v => by
        ext x; dsimp only [toE, fromE, blockLaplacian, blockGrad, condExpOp, expVal, condSlice]
        have hadd_f : ∀ z, (u.ofLp z + v.ofLp z) / √(μ z) = u.ofLp z / √(μ z) + v.ofLp z / √(μ z) :=
          fun z => add_div _ _ _
        change √(μ x) * ∑ i : Fin M, ((u.ofLp x + v.ofLp x) / √(μ x) -
            ∑ q : Q, condWeight μ i x q * ((u.ofLp (Function.update x i q) +
              v.ofLp (Function.update x i q)) / √(μ (Function.update x i q)))) =
          √(μ x) * ∑ i : Fin M, (u.ofLp x / √(μ x) -
            ∑ q : Q, condWeight μ i x q * (u.ofLp (Function.update x i q) / √(μ (Function.update x i q)))) +
          √(μ x) * ∑ i : Fin M, (v.ofLp x / √(μ x) -
            ∑ q : Q, condWeight μ i x q * (v.ofLp (Function.update x i q) / √(μ (Function.update x i q))))
        simp_rw [hadd_f, mul_add, Finset.sum_add_distrib]
        rw [← mul_add, ← Finset.sum_add_distrib]
        congr 1; refine Finset.sum_congr rfl (fun i _ => by ring)
      map_smul' := fun c u => by
        ext x; dsimp only [toE, fromE, blockLaplacian, blockGrad, condExpOp, expVal, condSlice]
        have hsm_f : ∀ z, (c * u.ofLp z) / √(μ z) = c * (u.ofLp z / √(μ z)) := fun z => by ring
        change √(μ x) * ∑ i : Fin M, ((c * u.ofLp x) / √(μ x) -
            ∑ q : Q, condWeight μ i x q * ((c * u.ofLp (Function.update x i q)) / √(μ (Function.update x i q)))) =
          c * (√(μ x) * ∑ i : Fin M, (u.ofLp x / √(μ x) -
            ∑ q : Q, condWeight μ i x q * (u.ofLp (Function.update x i q) / √(μ (Function.update x i q)))))
        simp_rw [hsm_f]
        have hpull : ∀ i : Fin M,
            (∑ q : Q, condWeight μ i x q * (c * (u.ofLp (Function.update x i q) / √(μ (Function.update x i q))))) =
            c * (∑ q : Q, condWeight μ i x q * (u.ofLp (Function.update x i q) / √(μ (Function.update x i q)))) := by
          intro i; rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun q _ => by ring)
        simp_rw [hpull, ← mul_sub, ← Finset.mul_sum]
        ring }
  have hL_symm : L_op.IsSymmetric := by
    intro u v
    dsimp only [L_op, LinearMap.coe_mk, AddHom.coe_mk]
    conv_lhs => rw [← hto_from v, hinner_toE]
    conv_rhs => rw [← hto_from u, hinner_toE]
    unfold blockLaplacian
    have hsum1 : expVal μ (fun x => (∑ i : Fin M, blockGrad μ i (fromE u) x) * fromE v x) =
        ∑ i : Fin M, expVal μ (fun x => blockGrad μ i (fromE u) x * fromE v x) := by
      unfold expVal; simp_rw [Finset.sum_mul, Finset.mul_sum]; exact Finset.sum_comm
    have hsum2 : expVal μ (fun x => fromE u x * ∑ i : Fin M, blockGrad μ i (fromE v) x) =
        ∑ i : Fin M, expVal μ (fun x => fromE u x * blockGrad μ i (fromE v) x) := by
      unfold expVal; simp_rw [Finset.mul_sum]; exact Finset.sum_comm
    rw [hsum1, hsum2]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    dsimp only [blockGrad]
    simp_rw [sub_mul, mul_sub, expVal_sub, expVal_condExpOp_selfAdj hμ_pos i (fromE u) (fromE v)]
  let D := Module.finrank ℝ E
  let b : OrthonormalBasis (Fin D) ℝ E := hL_symm.eigenvectorBasis rfl
  let lam : Fin D → ℝ := hL_symm.eigenvalues rfl
  have hLeig : ∀ k : Fin D, L_op (b k) = lam k • b k := hL_symm.apply_eigenvectorBasis rfl
  have hlam_nn : ∀ k : Fin D, 0 ≤ lam k := by
    intro k
    have h1 : inner ℝ (b k) (L_op (b k)) = lam k := by
      rw [hLeig k, real_inner_smul_right, real_inner_self_eq_norm_sq, b.orthonormal.1 k, one_pow, mul_one]
    have h2 : inner ℝ (b k) (L_op (b k)) =
        ∑ i : Fin M, expVal μ (fun x => varProb (condWeight μ i x) (condSlice (fromE (b k)) i x)) := by
      dsimp only [L_op, LinearMap.coe_mk, AddHom.coe_mk]
      conv_lhs => rw [← hto_from (b k)]
      rw [hinner_toE]
      have hrew : fromE (toE (fromE (b k))) = fromE (b k) := by rw [hto_from]
      rw [hrew]
      exact expVal_blockLaplacian_dirichlet hμ_pos (fromE (b k))
    have hnn : 0 ≤ ∑ i : Fin M,
        expVal μ (fun x => varProb (condWeight μ i x) (condSlice (fromE (b k)) i x)) :=
      Finset.sum_nonneg (fun i _ =>
        expVal_nonneg hμ (fun x => varProb_nonneg (isProbWeight_condWeight hμ i x) _))
    linarith
  have hlam_gap : ∀ k : Fin D, lam k = 0 ∨ 1 - γ_DS ≤ lam k := by
    intro k
    rcases (hlam_nn k).eq_or_lt with h0 | hpos
    · exact Or.inl h0.symm
    · right
      have hcoerc := hcoercive (fromE (b k))
      have h1 : expVal μ (fun x => fromE (b k) x * blockLaplacian μ (fromE (b k)) x) = lam k := by
        have h1a : inner ℝ (b k) (L_op (b k)) = lam k := by
          rw [hLeig k, real_inner_smul_right, real_inner_self_eq_norm_sq, b.orthonormal.1 k, one_pow, mul_one]
        dsimp only [L_op, LinearMap.coe_mk, AddHom.coe_mk] at h1a
        conv_lhs at h1a => rw [← hto_from (b k)]
        rw [hinner_toE] at h1a
        have hrew : fromE (toE (fromE (b k))) = fromE (b k) := by rw [hto_from]
        rw [hrew] at h1a
        exact h1a
      have h2 : expVal μ (fun x => (blockLaplacian μ (fromE (b k)) x) ^ 2) = (lam k) ^ 2 := by
        have h2a : inner ℝ (L_op (b k)) (L_op (b k)) = (lam k) ^ 2 := by
          rw [hLeig k, real_inner_smul_left, real_inner_smul_right,
            real_inner_self_eq_norm_sq, b.orthonormal.1 k, one_pow, mul_one]
          ring
        dsimp only [L_op, LinearMap.coe_mk, AddHom.coe_mk] at h2a
        rw [hinner_toE] at h2a
        simpa [sq] using h2a
      rw [h1, h2] at hcoerc
      nlinarith
  let e : E := toE (fun _ => 1)
  have he_ker : ∀ k : Fin D, lam k = 0 → varProb μ (fromE (b k)) = 0 := by
    intro k hlam0
    have hLk : L_op (b k) = 0 := by rw [hLeig k, hlam0, zero_smul]
    have hL0 : ∀ x, blockLaplacian μ (fromE (b k)) x = 0 := by
      intro x
      have hx := congrArg (fun v : E => v.ofLp x) hLk
      dsimp only [L_op, LinearMap.coe_mk, AddHom.coe_mk, toE] at hx
      change Real.sqrt (μ x) * blockLaplacian μ (fromE (b k)) x = 0 at hx
      exact (mul_eq_zero.mp hx).resolve_left (ne_of_gt (hsqrt_pos x))
    exact blockLaplacian_ker_const hμ hμ_pos hL0
  have he_orth_ker : ∀ k : Fin D, lam k = 0 → ∀ u : E, inner ℝ e u = 0 → inner ℝ (b k) u = 0 := by
    intro k hlam0 u hu_mean
    have hv0 := he_ker k hlam0
    have hconst : ∀ x : Fin M → Q, fromE (b k) x = expVal μ (fromE (b k)) := by
      intro x
      have hle : μ x * (fromE (b k) x - expVal μ (fromE (b k))) ^ 2 ≤ 0 := by
        rw [← hv0]
        exact Finset.single_le_sum
          (f := fun y => μ y * (fromE (b k) y - expVal μ (fromE (b k))) ^ 2)
          (fun y _ => mul_nonneg (le_of_lt (hμ_pos y)) (sq_nonneg _))
          (Finset.mem_univ x)
      have h0 : μ x * (fromE (b k) x - expVal μ (fromE (b k))) ^ 2 = 0 :=
        le_antisymm hle (mul_nonneg (le_of_lt (hμ_pos x)) (sq_nonneg _))
      exact sub_eq_zero.mp (sq_eq_zero_iff.mp ((mul_eq_zero.mp h0).resolve_left (ne_of_gt (hμ_pos x))))
    have hbk_smul : b k = (expVal μ (fromE (b k))) • e := by
      conv_lhs => rw [← hto_from (b k)]
      ext x
      have h1 : (toE (fromE (b k))).ofLp x = Real.sqrt (μ x) * expVal μ (fromE (b k)) := by
        dsimp only [toE]; rw [hconst x]
      have h2 : ((expVal μ (fromE (b k))) • e).ofLp x = expVal μ (fromE (b k)) * (Real.sqrt (μ x) * 1) :=
        rfl
      rw [h1, h2]; ring
    rw [hbk_smul, real_inner_smul_left, hu_mean, mul_zero]
  intro f
  let f0 : (Fin M → Q) → ℝ := fun x => f x - expVal μ f
  let u : E := toE f0
  have hu_mean : inner ℝ e u = 0 := by
    dsimp only [u, e, f0]
    rw [hinner_toE]
    simp_rw [one_mul, expVal_sub, expVal_const hμ, sub_self]
  have hvar_eq : varProb μ f = inner ℝ u u := by
    dsimp only [u, f0]
    rw [hinner_toE]
    unfold varProb
    refine Finset.sum_congr rfl (fun x _ => by simp [sq])
  have hdir_eq : (∑ i : Fin M, expVal μ (fun x => varProb (condWeight μ i x) (condSlice f i x))) =
      inner ℝ u (L_op u) := by
    have hgrad_shift : ∀ i : Fin M, ∀ x : Fin M → Q,
        varProb (condWeight μ i x) (condSlice f i x) =
        varProb (condWeight μ i x) (condSlice f0 i x) := by
      intro i x
      unfold varProb condSlice f0
      have hmean : expVal (condWeight μ i x) (fun q => f (Function.update x i q) - expVal μ f) =
          expVal (condWeight μ i x) (fun q => f (Function.update x i q)) - expVal μ f := by
        rw [expVal_sub, expVal_const (isProbWeight_condWeight hμ i x)]
      rw [hmean]
      refine Finset.sum_congr rfl (fun q _ => by ring)
    simp_rw [hgrad_shift, ← expVal_blockLaplacian_dirichlet hμ_pos f0]
    dsimp only [L_op, LinearMap.coe_mk, AddHom.coe_mk, u]
    rw [hfrom_to, hinner_toE]
  have hu_sq : inner ℝ u u = ∑ k : Fin D, (inner ℝ (b k) u) ^ 2 := by
    rw [← b.sum_inner_mul_inner u u]
    refine Finset.sum_congr rfl (fun k _ => by rw [real_inner_comm u (b k), sq])
  have huL : inner ℝ u (L_op u) = ∑ k : Fin D, lam k * (inner ℝ (b k) u) ^ 2 := by
    rw [← b.sum_inner_mul_inner u (L_op u)]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [← hL_symm (b k) u, hLeig k, real_inner_smul_left, real_inner_comm u (b k)]
    ring
  have hmain : (1 - γ_DS) * inner ℝ u u ≤ inner ℝ u (L_op u) := by
    rw [hu_sq, huL, Finset.mul_sum]
    refine Finset.sum_le_sum (fun k _ => ?_)
    rcases hlam_gap k with h0 | hgap
    · have horth := he_orth_ker k h0 u hu_mean
      rw [horth]; simp
    · exact mul_le_mul_of_nonneg_right hgap (sq_nonneg _)
  rw [hvar_eq, hdir_eq]
  exact (le_inv_mul_iff₀ h1m_pos).mpr hmain

private lemma zegarlinski_semigroup_decay_of_poincare
    {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (hμ : IsProbWeight μ)
    (w_blk : Fin M → (Fin M → Q) → Q → Q → ℝ)
    {c_glob : ℝ} (hc_pos : 0 < c_glob)
    (hpoinc : ∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ c_glob *
        ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice f i x)))
    (P : ℝ → ((Fin M → Q) → ℝ) → ((Fin M → Q) → ℝ))
    (hP0 : ∀ f, P 0 f = f)
    (hderiv : ∀ f t, 0 ≤ t → HasDerivAt (fun s => varProb μ (P s f))
      (-2 * ∑ i : Fin M, expVal μ (fun x =>
        edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice (P t f) i x))) t)
    (f g : (Fin M → Q) → ℝ) (t : ℝ) (ht : 0 ≤ t) :
    varProb μ (P t f) ≤ Real.exp (-2 * t / c_glob) * varProb μ f ∧
    |covProb μ g (P t f)| ≤ Real.exp (-t / c_glob) * Real.sqrt (varProb μ g * varProb μ f) := by
  let E_form : ((Fin M → Q) → ℝ) → ℝ := fun h =>
    ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice h i x))
  have hrate : ∀ s : ℝ, 0 ≤ s → -2 * E_form (P s f) ≤ -(2 / c_glob) * varProb μ (P s f) := by
    intro s _
    have hp : varProb μ (P s f) ≤ c_glob * E_form (P s f) := hpoinc (P s f)
    have hdiv : varProb μ (P s f) / c_glob ≤ E_form (P s f) :=
      (div_le_iff₀ hc_pos).mpr (by rw [mul_comm]; exact hp)
    have hmul2 := mul_le_mul_of_nonneg_left hdiv (by norm_num : (0 : ℝ) ≤ 2)
    have hrew1 : 2 * (varProb μ (P s f) / c_glob) = (2 / c_glob) * varProb μ (P s f) := by ring
    rw [hrew1] at hmul2
    linarith
  have hvar_decay : varProb μ (P t f) ≤ Real.exp (-2 * t / c_glob) * varProb μ f := by
    have hgron := gronwall_exp_decay_of_hasDerivAt (f := fun s => varProb μ (P s f))
      (f' := fun s => -2 * E_form (P s f)) (r := 2 / c_glob)
      (fun s hs => hderiv f s hs) hrate t ht
    rw [hP0 f] at hgron
    have hexp : -(2 / c_glob) * t = -2 * t / c_glob := by ring
    rw [hexp] at hgron
    exact hgron
  have hcov_decay : |covProb μ g (P t f)| ≤
      Real.exp (-t / c_glob) * Real.sqrt (varProb μ g * varProb μ f) := by
    have hcs := covProb_sq_le hμ g (P t f)
    have hmul : varProb μ g * varProb μ (P t f) ≤
        varProb μ g * (Real.exp (-2 * t / c_glob) * varProb μ f) :=
      mul_le_mul_of_nonneg_left hvar_decay (varProb_nonneg hμ g)
    have hsq_eq : Real.exp (-2 * t / c_glob) = (Real.exp (-t / c_glob)) ^ 2 := by
      rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
    have hprod_le : (covProb μ g (P t f)) ^ 2 ≤
        (Real.exp (-t / c_glob) * Real.sqrt (varProb μ g * varProb μ f)) ^ 2 := by
      have hvv_nn : 0 ≤ varProb μ g * varProb μ f :=
        mul_nonneg (varProb_nonneg hμ g) (varProb_nonneg hμ f)
      rw [mul_pow, Real.sq_sqrt hvv_nn, ← hsq_eq]
      have hrhs_eq : Real.exp (-2 * t / c_glob) * (varProb μ g * varProb μ f) =
          varProb μ g * (Real.exp (-2 * t / c_glob) * varProb μ f) := by ring
      rw [hrhs_eq]
      exact hcs.trans hmul
    exact abs_le.mpr (abs_le_of_sq_le_sq' hprod_le
      (mul_nonneg (le_of_lt (Real.exp_pos _)) (Real.sqrt_nonneg _)))
  exact ⟨hvar_decay, hcov_decay⟩

/-- **Zegarlinski / Dobrushin–Shlosman Inter-Block Weak-Mixing Lifting (`[C/B/P]`)**:
Combines:
1. Uniform block-local Holley–Stroock Poincaré constant `c_P(ℓ_phys) = c_P_ref * exp(2 * B_blk)`
   (from `Round04PoincareLSI.holley_stroock_bounded_perturbation_poincare_stability`),
2. Constructive Zegarlinski conditional tensorization (`K_Z = (1 - γ_DS)⁻¹` from `BlockHGRMatrix μ γ_DS`
   with `γ_DS < 1`), and
3. `Round04PoincareLSI.interacting_conditional_poincare_uniform_in_volume`,
to yield a **volume-independent** interacting Poincaré constant
`c_P(M) = (c_P_ref * exp(2 * B_blk)) / (1 - γ_DS)` across all `M ≥ 1`, together with exponential
semigroup variance & `L^2` connected-correlation decay. -/
theorem zegarlinski_interblock_weak_mixing_lifting
    {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    {γ_DS : ℝ} (hC : BlockHGRMatrix μ γ_DS)
    (μ_ref : Fin M → (Fin M → Q) → Q → ℝ)
    (hμ_ref_prob : ∀ i x, IsProbWeight (μ_ref i x))
    (V_blk : Fin M → (Fin M → Q) → Q → ℝ)
    (w_blk : Fin M → (Fin M → Q) → Q → Q → ℝ)
    (hw_nn : ∀ i x q q', 0 ≤ w_blk i x q q')
    (hcond_tilt : ∀ i x, condWeight μ i x = gibbsTilt (μ_ref i x) (V_blk i x))
    {B_blk c_P_ref : ℝ}
    (hosc_blk : ∀ i x (q q' : Q), V_blk i x q - V_blk i x q' ≤ B_blk)
    (hcP_pos : 0 < c_P_ref)
    (hsingle_ref : ∀ i x (g : Q → ℝ),
      varProb (μ_ref i x) g ≤ c_P_ref * edgeDirichlet (μ_ref i x) (w_blk i x) g) :
    let c_P_blk : ℝ := c_P_ref * Real.exp (2 * B_blk)
    let c_P_global : ℝ := c_P_blk / (1 - γ_DS)
    0 < c_P_global ∧
    (∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ c_P_global *
        ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice f i x))) ∧
    (∀ (P : ℝ → ((Fin M → Q) → ℝ) → ((Fin M → Q) → ℝ)),
      (∀ f, P 0 f = f) →
      (∀ f t, 0 ≤ t → HasDerivAt (fun s => varProb μ (P s f))
        (-2 * ∑ i : Fin M, expVal μ (fun x =>
          edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice (P t f) i x))) t) →
      ∀ (f g : (Fin M → Q) → ℝ) (t : ℝ), 0 ≤ t →
        varProb μ (P t f) ≤ Real.exp (-2 * t / c_P_global) * varProb μ f ∧
        |covProb μ g (P t f)| ≤ Real.exp (-t / c_P_global) *
          Real.sqrt (varProb μ g * varProb μ f)) := by
  have h1m_pos : 0 < 1 - γ_DS := sub_pos.mpr hC.gamma_lt_one
  have hc_blk_pos : 0 < c_P_ref * Real.exp (2 * B_blk) := mul_pos hcP_pos (Real.exp_pos _)
  have hc_glob_pos : 0 < (c_P_ref * Real.exp (2 * B_blk)) / (1 - γ_DS) :=
    div_pos hc_blk_pos h1m_pos
  have hlocal : ∀ (i : Fin M) (x : Fin M → Q) (g : Q → ℝ),
      varProb (condWeight μ i x) g ≤
        (c_P_ref * Real.exp (2 * B_blk)) * edgeDirichlet (condWeight μ i x) (w_blk i x) g := by
    intro i x g
    rw [hcond_tilt i x]
    exact (holley_stroock_bounded_perturbation_poincare_stability
      (μ_ref i x) (V_blk i x) (hμ_ref_prob i x) (w_blk i x) (hw_nn i x)
      (hosc_blk i x) (le_of_lt hcP_pos) (hsingle_ref i x)).2.2.1 g
  have hzeg := zegarlinski_conditional_tensorization hμ hμ_pos hC
  have hinter := interacting_conditional_poincare_uniform_in_volume
    μ hμ (condWeight μ) w_blk (le_of_lt hc_blk_pos) (inv_nonneg.mpr (le_of_lt h1m_pos))
    hlocal hzeg
  have hpoinc : ∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ ((c_P_ref * Real.exp (2 * B_blk)) / (1 - γ_DS)) *
        ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice f i x)) := by
    intro f
    have h1 := hinter f
    have hcoef : (1 - γ_DS)⁻¹ * (c_P_ref * Real.exp (2 * B_blk)) =
        (c_P_ref * Real.exp (2 * B_blk)) / (1 - γ_DS) := by
      ring
    rw [hcoef] at h1
    exact h1
  refine ⟨hc_glob_pos, hpoinc, fun P hP0 hderiv f g t ht =>
    zegarlinski_semigroup_decay_of_poincare μ hμ w_blk hc_glob_pos hpoinc P hP0 hderiv f g t ht⟩

end ZegarlinskiInterblockLifting

/-! ## 4. Spatial Exponential Clustering from Finite-Range Locality + Uniform Gap (`[B/P]`) -/

section FiniteRangeSpatialClustering

/-- Coordinate oscillation `osc_i(f) = sup_{x, q} |f(update x i q) - f(x)|`. `[C/B]` -/
noncomputable def blockOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) (i : Fin M) : ℝ :=
  Finset.univ.sup' Finset.univ_nonempty
    (fun p : (Fin M → Q) × Q => |f (Function.update p.1 i p.2) - f p.1|)

/-- Total coordinate oscillation `∑ i, osc_i(f)`. `[C/B]` -/
noncomputable def totalOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) : ℝ :=
  ∑ i : Fin M, blockOsc f i

/-- Global oscillation `sup_{x, y} |f(x) - f(y)|`. `[C/B]` -/
noncomputable def globalOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) : ℝ :=
  Finset.univ.sup' Finset.univ_nonempty (fun p : (Fin M → Q) × (Fin M → Q) => |f p.1 - f p.2|)

lemma blockOsc_nonneg {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) (i : Fin M) : 0 ≤ blockOsc f i := by
  obtain ⟨q0⟩ := (inferInstance : Nonempty Q)
  let x0 : Fin M → Q := fun _ => q0
  have hle : |f (Function.update x0 i q0) - f x0| ≤ blockOsc f i :=
    Finset.le_sup' (fun p : (Fin M → Q) × Q => |f (Function.update p.1 i p.2) - f p.1|)
      (Finset.mem_univ (x0, q0))
  exact le_trans (abs_nonneg _) hle

lemma globalOsc_nonneg {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) : 0 ≤ globalOsc f := by
  obtain ⟨q0⟩ := (inferInstance : Nonempty Q)
  let x0 : Fin M → Q := fun _ => q0
  have hle : |f x0 - f x0| ≤ globalOsc f :=
    Finset.le_sup' (fun p : (Fin M → Q) × (Fin M → Q) => |f p.1 - f p.2|)
      (Finset.mem_univ (x0, x0))
  exact le_trans (abs_nonneg _) hle

lemma abs_sub_update_le_blockOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) (q : Q) :
    |f (Function.update x i q) - f x| ≤ blockOsc f i :=
  Finset.le_sup' (fun p : (Fin M → Q) × Q => |f (Function.update p.1 i p.2) - f p.1|)
    (Finset.mem_univ (x, q))

lemma abs_update_sub_update_le_blockOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
   
    (f : (Fin M → Q) → ℝ) (i : Fin M) (x : Fin M → Q) (q1 q2 : Q) :
    |f (Function.update x i q1) - f (Function.update x i q2)| ≤ blockOsc f i := by
  have h := abs_sub_update_le_blockOsc f i (Function.update x i q2) q1
  rwa [Function.update_idem] at h

lemma blockOsc_eq_zero_of_indep {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {f : (Fin M → Q) → ℝ} {i : Fin M}
    (hindep : ∀ x q, f (Function.update x i q) = f x) :
    blockOsc f i = 0 := by
  refine le_antisymm ?_ (blockOsc_nonneg f i)
  unfold blockOsc
  refine Finset.sup'_le Finset.univ_nonempty _ (fun p _ => ?_)
  rw [hindep p.1 p.2, sub_self, abs_zero]

lemma indep_of_blockOsc_eq_zero {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {f : (Fin M → Q) → ℝ} {i : Fin M} (h0 : blockOsc f i = 0) :
    ∀ x q, f (Function.update x i q) = f x := by
  intro x q
  have hle := abs_sub_update_le_blockOsc f i x q
  rw [h0] at hle
  exact sub_eq_zero.mp (abs_nonpos_iff.mp hle)

private lemma abs_sub_prefix_le {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) (x y : Fin M → Q) :
    ∀ (k : ℕ), k ≤ M →
      |f (fun i => if i.1 < k then y i else x i) - f x| ≤
        ∑ i : Fin M, if i.1 < k then blockOsc f i else 0
  | 0, _ => by simp
  | k + 1, hk => by
    have hk_lt : k < M := by omega
    let ik : Fin M := ⟨k, hk_lt⟩
    let z : Fin M → Q := fun i => if i.1 < k then y i else x i
    let z' : Fin M → Q := fun i => if i.1 < k + 1 then y i else x i
    have hz'_eq : Function.update z ik (y ik) = z' := by
      ext i
      by_cases hi : i = ik
      · subst hi; simp [z', ik]
      · have hne : i.1 ≠ k := fun h => hi (Fin.ext h)
        simp only [Function.update_apply, hi, ↓reduceIte, z, z']
        have hlt_iff : i.1 < k + 1 ↔ i.1 < k := by omega
        simp [hlt_iff]
    have ih := abs_sub_prefix_le f x y k (Nat.le_of_lt hk_lt)
    have hstep : |f z' - f z| ≤ blockOsc f ik := by
      rw [← hz'_eq]
      exact abs_sub_update_le_blockOsc f ik z (y ik)
    have htri : |f z' - f x| ≤ |f z' - f z| + |f z - f x| := by
      simpa using abs_add_le (f z' - f z) (f z - f x)
    have hsum_eq : (∑ i : Fin M, if i.1 < k + 1 then blockOsc f i else 0) =
        blockOsc f ik + ∑ i : Fin M, if i.1 < k then blockOsc f i else 0 := by
      rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ ik), if_pos (by simp [ik])]
      congr 1
      rw [← Finset.add_sum_erase Finset.univ (fun i => if i.1 < k then blockOsc f i else 0)
        (Finset.mem_univ ik), if_neg (by simp [ik]), zero_add]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hne : i.1 ≠ k := fun h => (Finset.ne_of_mem_erase hi) (Fin.ext h)
      have hlt_iff : i.1 < k + 1 ↔ i.1 < k := by omega
      simp [hlt_iff]
    rw [hsum_eq]
    exact htri.trans (add_le_add hstep ih)

lemma abs_sub_le_totalOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (f : (Fin M → Q) → ℝ) (x y : Fin M → Q) :
    |f x - f y| ≤ totalOsc f := by
  have h := abs_sub_prefix_le f y x M le_rfl
  have heq1 : (fun i : Fin M => if i.1 < M then x i else y i) = x := by
    ext i; simp [i.isLt]
  have heq2 : (∑ i : Fin M, if i.1 < M then blockOsc f i else 0) = totalOsc f := by
    unfold totalOsc
    refine Finset.sum_congr rfl (fun i _ => by simp [i.isLt])
  rwa [heq1, heq2] at h

lemma abs_sub_le_globalOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (G : (Fin M → Q) → ℝ) (x y : Fin M → Q) :
    |G x - G y| ≤ globalOsc G := by
  unfold globalOsc
  exact Finset.le_sup' (fun p : (Fin M → Q) × (Fin M → Q) => |G p.1 - G p.2|)
    (Finset.mem_univ (x, y))

lemma covProb_le_totalOsc_mul_globalOsc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
   
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (F G : (Fin M → Q) → ℝ) :
    |covProb μ F G| ≤ totalOsc F * globalOsc G := by
  have hF_bd : ∀ x : Fin M → Q, |F x - expVal μ F| ≤ totalOsc F := by
    intro x
    have hdiff : F x - expVal μ F = ∑ y : Fin M → Q, μ y * (F x - F y) := by
      unfold expVal
      simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hμ.2, one_mul]
    rw [hdiff]
    calc |∑ y : Fin M → Q, μ y * (F x - F y)|
        ≤ ∑ y : Fin M → Q, |μ y * (F x - F y)| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ y : Fin M → Q, μ y * |F x - F y| := by
          refine Finset.sum_congr rfl (fun y _ => ?_)
          rw [abs_mul, abs_of_nonneg (hμ.1 y)]
      _ ≤ ∑ y : Fin M → Q, μ y * totalOsc F :=
          Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left (abs_sub_le_totalOsc F x y) (hμ.1 y))
      _ = totalOsc F := by rw [← Finset.sum_mul, hμ.2, one_mul]
  have hG_bd : ∀ x : Fin M → Q, |G x - expVal μ G| ≤ globalOsc G := by
    intro x
    have hdiff : G x - expVal μ G = ∑ y : Fin M → Q, μ y * (G x - G y) := by
      unfold expVal
      simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hμ.2, one_mul]
    rw [hdiff]
    calc |∑ y : Fin M → Q, μ y * (G x - G y)|
        ≤ ∑ y : Fin M → Q, |μ y * (G x - G y)| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ y : Fin M → Q, μ y * |G x - G y| := by
          refine Finset.sum_congr rfl (fun y _ => ?_)
          rw [abs_mul, abs_of_nonneg (hμ.1 y)]
      _ ≤ ∑ y : Fin M → Q, μ y * globalOsc G :=
          Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left (abs_sub_le_globalOsc G x y) (hμ.1 y))
      _ = globalOsc G := by rw [← Finset.sum_mul, hμ.2, one_mul]
  have hprod_bd : ∀ x : Fin M → Q,
      |F x - expVal μ F| * |G x - expVal μ G| ≤ totalOsc F * globalOsc G :=
    fun x => mul_le_mul (hF_bd x) (hG_bd x) (abs_nonneg _)
      (Finset.sum_nonneg (fun i _ => blockOsc_nonneg F i))
  have hcov_tri : |covProb μ F G| ≤ ∑ x : Fin M → Q, μ x * (|F x - expVal μ F| * |G x - expVal μ G|) := by
    unfold covProb
    calc |∑ x : Fin M → Q, μ x * ((F x - expVal μ F) * (G x - expVal μ G))|
        ≤ ∑ x : Fin M → Q, |μ x * ((F x - expVal μ F) * (G x - expVal μ G))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ x : Fin M → Q, μ x * (|F x - expVal μ F| * |G x - expVal μ G|) := by
          refine Finset.sum_congr rfl (fun x _ => ?_)
          rw [abs_mul, abs_mul, abs_of_nonneg (hμ.1 x)]
  calc |covProb μ F G|
      ≤ ∑ x : Fin M → Q, μ x * (|F x - expVal μ F| * |G x - expVal μ G|) := hcov_tri
    _ ≤ ∑ x : Fin M → Q, μ x * (totalOsc F * globalOsc G) :=
        Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (hprod_bd x) (hμ.1 x))
    _ = totalOsc F * globalOsc G := by rw [← Finset.sum_mul, hμ.2, one_mul]

/-- **Finite-Range Dobrushin–Shlosman Interdependence Matrix (`[B/P]`)**:
Encodes a finite-range (`R ≥ 1`) block-Gibbs conditional TV interdependence matrix `D`:
- `D k k = 0`, `0 ≤ D k j`,
- `R < dist k j → D k j = 0` (finite-range locality),
- `(1/2) ∑ r, |condWeight μ k (update x j q) r - condWeight μ k x r| ≤ D k j` for `j ≠ k`,
- `∑ j, D k j ≤ γ_DS < 1` (Dobrushin–Shlosman weak-mixing contraction). -/
structure FiniteRangeDobrushinSpec {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (dist : Fin M → Fin M → ℕ)
    (R : ℕ) (γ_DS : ℝ) where
  R_pos : 1 ≤ R
  dist_self : ∀ a : Fin M, dist a a = 0
  dist_tri : ∀ a b c : Fin M, dist a c ≤ dist a b + dist b c
  D : Matrix (Fin M) (Fin M) ℝ
  diag_zero : ∀ k : Fin M, D k k = 0
  nonneg : ∀ k j : Fin M, 0 ≤ D k j
  finite_range : ∀ k j : Fin M, R < dist k j → D k j = 0
  tv_bound : ∀ (k j : Fin M), k ≠ j → ∀ (x : Fin M → Q) (q : Q),
    (1 / 2 : ℝ) * ∑ r : Q, |condWeight μ k (Function.update x j q) r - condWeight μ k x r| ≤ D k j
  gamma_nn : 0 ≤ γ_DS
  gamma_lt_one : γ_DS < 1
  row_sum_le : ∀ k : Fin M, ∑ j : Fin M, D k j ≤ γ_DS

lemma covProb_condExpOp_left_eq {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    (H G : (Fin M → Q) → ℝ) {k : Fin M} (hG_indep : blockOsc G k = 0) :
    covProb μ (condExpOp μ k H) G = covProb μ H G := by
  have hGk : ∀ x q, G (Function.update x k q) = G x := indep_of_blockOsc_eq_zero hG_indep
  have h1 : expVal μ (condExpOp μ k H) = expVal μ H := expVal_condExpOp hμ_pos k H
  have h2 : expVal μ (fun x => condExpOp μ k H x * G x) = expVal μ (fun x => H x * G x) := by
    have hpt : ∀ x, condExpOp μ k H x * G x = condExpOp μ k (fun z => H z * G z) x := by
      intro x
      unfold condExpOp expVal condSlice
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      have hq : G (Function.update x k q) = G x := hGk x q
      dsimp only
      rw [hq]; ring
    have hsum : expVal μ (fun x => condExpOp μ k H x * G x) =
        expVal μ (condExpOp μ k (fun z => H z * G z)) := by
      unfold expVal
      refine Finset.sum_congr rfl (fun x _ => by dsimp only; rw [hpt x])
    rw [hsum, expVal_condExpOp hμ_pos k (fun z => H z * G z)]
  have hcov_eq : ∀ f : (Fin M → Q) → ℝ,
      covProb μ f G = expVal μ (fun x => f x * G x) - expVal μ f * expVal μ G := by
    intro f
    unfold covProb expVal
    have hterm : ∀ x, μ x * ((f x - ∑ y, μ y * f y) * (G x - ∑ y, μ y * G y)) =
        μ x * (f x * G x) - (∑ y, μ y * G y) * (μ x * f x) -
        (∑ y, μ y * f y) * (μ x * G x) + (∑ y, μ y * f y) * (∑ y, μ y * G y) * μ x := by
      intro x; ring
    simp_rw [hterm, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, hμ.2, mul_one]
    ring
  rw [hcov_eq (condExpOp μ k H), hcov_eq H, h1, h2]

lemma blockOsc_condExpOp_self {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (k : Fin M) (H : (Fin M → Q) → ℝ) :
    blockOsc (condExpOp μ k H) k = 0 :=
  blockOsc_eq_zero_of_indep (fun x q => condExpOp_update μ k H x q)

lemma blockOsc_condExpOp_le {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) {dist : Fin M → Fin M → ℕ} {R : ℕ} {γ_DS : ℝ}
    (S : FiniteRangeDobrushinSpec μ dist R γ_DS) (k j : Fin M) (H : (Fin M → Q) → ℝ) :
    blockOsc (condExpOp μ k H) j ≤
      if j = k then 0 else blockOsc H j + S.D k j * blockOsc H k := by
  by_cases hjk : j = k
  · subst hjk; simp [blockOsc_condExpOp_self]
  · simp only [hjk, ↓reduceIte]
    unfold blockOsc
    refine Finset.sup'_le Finset.univ_nonempty _ (fun p _ => ?_)
    let x := p.1
    let q := p.2
    let x' := Function.update x j q
    have hw_prob : IsProbWeight (condWeight μ k x) := isProbWeight_condWeight hμ k x
    have hw'_prob : IsProbWeight (condWeight μ k x') := isProbWeight_condWeight hμ k x'
    let b : Q → ℝ := fun r => H (Function.update x k r)
    let b' : Q → ℝ := fun r => H (Function.update x' k r)
    let supb : ℝ := Finset.univ.sup' Finset.univ_nonempty b
    let infb : ℝ := Finset.univ.inf' Finset.univ_nonempty b
    let mid : ℝ := (supb + infb) / 2
    have hdiff_eq : condExpOp μ k H x' - condExpOp μ k H x =
        (∑ r : Q, condWeight μ k x' r * (b' r - b r)) +
        (∑ r : Q, (condWeight μ k x' r - condWeight μ k x r) * (b r - mid)) := by
      unfold condExpOp expVal condSlice
      have h0 : ∑ r : Q, (condWeight μ k x' r - condWeight μ k x r) * mid = 0 := by
        rw [← Finset.sum_mul]
        simp_rw [Finset.sum_sub_distrib, hw'_prob.2, hw_prob.2, sub_self, zero_mul]
      have hsum_sub : (∑ r : Q, condWeight μ k x' r * b' r) - (∑ r : Q, condWeight μ k x r * b r) =
          ∑ r : Q, (condWeight μ k x' r * b' r - condWeight μ k x r * b r) :=
        (Finset.sum_sub_distrib (s := (Finset.univ : Finset Q))
          (f := fun r => condWeight μ k x' r * b' r)
          (g := fun r => condWeight μ k x r * b r)).symm
      calc (∑ r : Q, condWeight μ k x' r * b' r) - (∑ r : Q, condWeight μ k x r * b r)
          = ∑ r : Q, (condWeight μ k x' r * b' r - condWeight μ k x r * b r) := hsum_sub
        _ = ∑ r : Q, (condWeight μ k x' r * (b' r - b r) +
              (condWeight μ k x' r - condWeight μ k x r) * b r) :=
              Finset.sum_congr rfl (fun r _ => by ring)
        _ = (∑ r : Q, condWeight μ k x' r * (b' r - b r)) +
            (∑ r : Q, (condWeight μ k x' r - condWeight μ k x r) * b r) :=
              Finset.sum_add_distrib
        _ = (∑ r : Q, condWeight μ k x' r * (b' r - b r)) +
            (∑ r : Q, (condWeight μ k x' r - condWeight μ k x r) * (b r - mid)) := by
              congr 1
              simp_rw [mul_sub, Finset.sum_sub_distrib, h0, sub_zero]
    have hterm1 : |∑ r : Q, condWeight μ k x' r * (b' r - b r)| ≤ blockOsc H j := by
      have hpt : ∀ r : Q, |b' r - b r| ≤ blockOsc H j := by
        intro r
        have hupd : Function.update x' k r = Function.update (Function.update x k r) j q := by
          ext m
          by_cases hmk : m = k
          · subst hmk; simp [x', Function.update_of_ne (Ne.symm hjk)]
          · by_cases hmj : m = j
            · subst hmj; simp [x', hjk]
            · simp [x', hmk, hmj]
        dsimp only [b', b]
        rw [hupd]
        exact abs_sub_update_le_blockOsc H j (Function.update x k r) q
      calc |∑ r : Q, condWeight μ k x' r * (b' r - b r)|
          ≤ ∑ r : Q, |condWeight μ k x' r * (b' r - b r)| := Finset.abs_sum_le_sum_abs _ _
        _ = ∑ r : Q, condWeight μ k x' r * |b' r - b r| := by
            refine Finset.sum_congr rfl (fun r _ => ?_)
            rw [abs_mul, abs_of_nonneg (hw'_prob.1 r)]
        _ ≤ ∑ r : Q, condWeight μ k x' r * blockOsc H j :=
            Finset.sum_le_sum (fun r _ => mul_le_mul_of_nonneg_left (hpt r) (hw'_prob.1 r))
        _ = blockOsc H j := by rw [← Finset.sum_mul, hw'_prob.2, one_mul]
    have hterm2 : |∑ r : Q, (condWeight μ k x' r - condWeight μ k x r) * (b r - mid)| ≤
        S.D k j * blockOsc H k := by
      have hsup_inf : supb - infb ≤ blockOsc H k := by
        obtain ⟨rmax, _, hrmax⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty b
        obtain ⟨rmin, _, hrmin⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty b
        dsimp only [supb, infb]
        rw [hrmax, hrmin]
        exact le_trans (le_abs_self _) (abs_update_sub_update_le_blockOsc H k x rmax rmin)
      have hb_mid : ∀ r : Q, |b r - mid| ≤ blockOsc H k / 2 := by
        intro r
        have hle_sup : b r ≤ supb := Finset.le_sup' b (Finset.mem_univ r)
        have hinf_le : infb ≤ b r := Finset.inf'_le b (Finset.mem_univ r)
        dsimp only [mid]
        rw [abs_le]
        constructor <;> linarith
      have htv := S.tv_bound k j (Ne.symm hjk) x q
      calc |∑ r : Q, (condWeight μ k x' r - condWeight μ k x r) * (b r - mid)|
          ≤ ∑ r : Q, |(condWeight μ k x' r - condWeight μ k x r) * (b r - mid)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ = ∑ r : Q, |condWeight μ k x' r - condWeight μ k x r| * |b r - mid| := by
            refine Finset.sum_congr rfl (fun r _ => abs_mul _ _)
        _ ≤ ∑ r : Q, |condWeight μ k x' r - condWeight μ k x r| * (blockOsc H k / 2) :=
            Finset.sum_le_sum (fun r _ => mul_le_mul_of_nonneg_left (hb_mid r) (abs_nonneg _))
        _ = ((1 / 2 : ℝ) * ∑ r : Q, |condWeight μ k x' r - condWeight μ k x r|) * blockOsc H k := by
            rw [← Finset.sum_mul]; ring
        _ ≤ S.D k j * blockOsc H k :=
            mul_le_mul_of_nonneg_right htv (blockOsc_nonneg H k)
    rw [hdiff_eq]
    exact (abs_add_le _ _).trans (add_le_add hterm1 hterm2)

private def stepVec {M : ℕ} (D : Matrix (Fin M) (Fin M) ℝ) (k : Fin M) (v : Fin M → ℝ) :
    Fin M → ℝ :=
  fun i => if i = k then 0 else v i + D k i * v k

private lemma stepVec_nonneg {M : ℕ} {D : Matrix (Fin M) (Fin M) ℝ}
    (hD_nn : ∀ k i, 0 ≤ D k i) {k : Fin M} {v : Fin M → ℝ} (hv : ∀ i, 0 ≤ v i) :
    ∀ i, 0 ≤ stepVec D k v i := by
  intro i; dsimp only [stepVec]
  split_ifs
  · exact le_rfl
  · exact add_nonneg (hv i) (mul_nonneg (hD_nn k i) (hv k))

private lemma foldl_stepVec_nonneg {M : ℕ} {D : Matrix (Fin M) (Fin M) ℝ}
    (hD_nn : ∀ k i, 0 ≤ D k i) :
    ∀ (l : List (Fin M)) (v : Fin M → ℝ), (∀ i, 0 ≤ v i) →
      ∀ i, 0 ≤ (l.foldl (fun acc k => stepVec D k acc) v) i
  | [], _, hv, i => hv i
  | k :: ks, v, hv, i =>
      foldl_stepVec_nonneg hD_nn ks (stepVec D k v) (stepVec_nonneg hD_nn hv) i

private lemma foldl_stepVec_ge_of_not_mem {M : ℕ} {D : Matrix (Fin M) (Fin M) ℝ}
    (hD_nn : ∀ k i, 0 ≤ D k i) :
    ∀ (l : List (Fin M)) (v : Fin M → ℝ) (_ : ∀ i, 0 ≤ v i) {j : Fin M},
      j ∉ l → v j ≤ (l.foldl (fun acc k => stepVec D k acc) v) j
  | [], _, _, _, _ => le_rfl
  | k :: ks, v, hv, j, hj => by
    have hjk : j ≠ k := fun h => hj (by simp [h])
    have hjks : j ∉ ks := fun h => hj (by simp [h])
    have h1 : v j ≤ stepVec D k v j := by
      dsimp only [stepVec]; rw [if_neg hjk]
      linarith [mul_nonneg (hD_nn k j) (hv k)]
    exact le_trans h1 (foldl_stepVec_ge_of_not_mem hD_nn ks (stepVec D k v)
      (stepVec_nonneg hD_nn hv) hjks)

private lemma stepVec_sum_le {M : ℕ} {D : Matrix (Fin M) (Fin M) ℝ}
    (_hD_nn : ∀ k i, 0 ≤ D k i) (hD_diag : ∀ k, D k k = 0)
    {γ : ℝ} (hD_row : ∀ k, ∑ i : Fin M, D k i ≤ γ)
    (k : Fin M) {v : Fin M → ℝ} (hv : ∀ i, 0 ≤ v i) :
    ∑ i : Fin M, stepVec D k v i ≤ (∑ i : Fin M, v i) - (1 - γ) * v k := by
  have hsplit : ∑ i : Fin M, stepVec D k v i =
      (∑ i ∈ Finset.univ.erase k, v i) + (∑ i ∈ Finset.univ.erase k, D k i * v k) := by
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ k)]
    have hk0 : stepVec D k v k = 0 := by simp [stepVec]
    rw [hk0, zero_add, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    dsimp only [stepVec]
    rw [if_neg (Finset.ne_of_mem_erase hi)]
  have hv_sum : ∑ i ∈ Finset.univ.erase k, v i = (∑ i : Fin M, v i) - v k := by
    have h := Finset.add_sum_erase Finset.univ v (Finset.mem_univ k)
    linarith
  have hD_sum : ∑ i ∈ Finset.univ.erase k, D k i * v k ≤ γ * v k := by
    have h1 : ∑ i ∈ Finset.univ.erase k, D k i * v k = (∑ i : Fin M, D k i) * v k := by
      rw [← Finset.sum_mul]
      congr 1
      rw [← Finset.add_sum_erase Finset.univ (D k) (Finset.mem_univ k), hD_diag k, zero_add]
    rw [h1]
    exact mul_le_mul_of_nonneg_right (hD_row k) (hv k)
  linarith

private lemma foldl_stepVec_map_ge {M : ℕ} (D : Matrix (Fin M) (Fin M) ℝ)
    (hD_nn : ∀ k i, 0 ≤ D k i) (k : Fin M) (v : Fin M → ℝ) (hv : ∀ i, 0 ≤ v i) :
    ∀ (ks : List (Fin M)), k ∉ ks →
      (ks.map v).sum ≤ (ks.map (stepVec D k v)).sum
  | [], _ => by simp
  | m :: ms, hkms => by
    have hm_ne : m ≠ k := fun h => hkms (by simp [h])
    have hms_not : k ∉ ms := fun h => hkms (by simp [h])
    simp only [List.map_cons, List.sum_cons]
    have hm_le : v m ≤ stepVec D k v m := by
      dsimp only [stepVec]; rw [if_neg hm_ne]
      linarith [mul_nonneg (hD_nn k m) (hv k)]
    exact add_le_add hm_le (foldl_stepVec_map_ge D hD_nn k v hv ms hms_not)

private lemma foldl_stepVec_sum_le {M : ℕ} {D : Matrix (Fin M) (Fin M) ℝ}
    (hD_nn : ∀ k i, 0 ≤ D k i) (hD_diag : ∀ k, D k k = 0)
    {γ : ℝ} (hγ_le : γ ≤ 1) (hD_row : ∀ k, ∑ i : Fin M, D k i ≤ γ) :
    ∀ (l : List (Fin M)), l.Nodup → ∀ (v : Fin M → ℝ) (_ : ∀ i, 0 ≤ v i),
      ∑ i : Fin M, (l.foldl (fun acc k => stepVec D k acc) v) i ≤
        (∑ i : Fin M, v i) - (1 - γ) * (l.map v).sum
  | [], _, v, _ => by simp
  | k :: ks, hl, v, hv => by
    have hk_not : k ∉ ks := (List.nodup_cons.mp hl).1
    have hks_nodup : ks.Nodup := (List.nodup_cons.mp hl).2
    have ih := foldl_stepVec_sum_le hD_nn hD_diag hγ_le hD_row ks hks_nodup
      (stepVec D k v) (stepVec_nonneg hD_nn hv)
    have hstep := stepVec_sum_le hD_nn hD_diag hD_row k hv
    have hge : (ks.map v).sum ≤ (ks.map (stepVec D k v)).sum :=
      foldl_stepVec_map_ge D hD_nn k v hv ks hk_not
    have h1m_nn : 0 ≤ 1 - γ := sub_nonneg.mpr hγ_le
    have hmul : (1 - γ) * (ks.map v).sum ≤ (1 - γ) * (ks.map (stepVec D k v)).sum :=
      mul_le_mul_of_nonneg_left hge h1m_nn
    simp only [List.foldl_cons, List.map_cons, List.sum_cons]
    linarith

private lemma foldl_stepVec_support {M : ℕ} {D : Matrix (Fin M) (Fin M) ℝ}
    {dist : Fin M → Fin M → ℕ} {R : ℕ}
    (hfin : ∀ k i : Fin M, R < dist k i → D k i = 0)
    (S : Finset (Fin M)) :
    ∀ (l : List (Fin M)), (∀ k ∈ l, k ∈ S) →
      ∀ (v : Fin M → ℝ), (∀ i ∉ S, v i = 0) →
        ∀ i : Fin M, (l.foldl (fun acc k => stepVec D k acc) v) i ≠ 0 →
          i ∈ S ∨ ∃ k ∈ S, dist k i ≤ R
  | [], _, v, hv_supp, i, hi_ne => Or.inl (by by_contra hiS; exact hi_ne (hv_supp i hiS))
  | k :: ks, hlS, v, hv_supp, i, hi_ne => by
    have hkS : k ∈ S := hlS k (by simp)
    have hksS : ∀ m ∈ ks, m ∈ S := fun m hm => hlS m (by simp [hm])
    -- Wait: stepVec D k v can be nonzero outside S ONLY at neighbors of k within R!
    -- Better: track the invariant directly on S_next := {i | i ∈ S ∨ ∃ k ∈ S, dist k i ≤ R}.
    let S' : Finset (Fin M) := Finset.univ.filter (fun i => i ∈ S ∨ ∃ m ∈ S, dist m i ≤ R)
    have hstep_supp : ∀ (w : Fin M → ℝ), (∀ j ∉ S', w j = 0) →
        (w k ≠ 0 → k ∈ S) → ∀ j ∉ S', stepVec D k w j = 0 := by
      intro w hw_supp _ j hjS'
      dsimp only [stepVec]
      split_ifs with hjk
      · rfl
      · have hj_not : ¬ (j ∈ S ∨ ∃ m ∈ S, dist m j ≤ R) := by
          simpa [S'] using hjS'
        have hR : R < dist k j := by
          by_contra hle
          exact hj_not (Or.inr ⟨k, hkS, Nat.le_of_not_lt hle⟩)
        rw [hw_supp j hjS', hfin k j hR, zero_mul, add_zero]
    have hrec_supp : ∀ (ls : List (Fin M)), (∀ m ∈ ls, m ∈ S) →
        ∀ (w : Fin M → ℝ), (∀ j ∉ S', w j = 0) →
        ∀ j ∉ S', (ls.foldl (fun acc m => stepVec D m acc) w) j = 0 := by
      intro ls hls
      induction ls with
      | nil => intro w hw; exact hw
      | cons m ms ih_ms =>
        intro w hw
        apply ih_ms (fun a ha => hls a (by simp [ha]))
        intro j hjS'
        dsimp only [stepVec]
        split_ifs with hjm
        · rfl
        · have hj_not : ¬ (j ∈ S ∨ ∃ s ∈ S, dist s j ≤ R) := by simpa [S'] using hjS'
          have hmS : m ∈ S := hls m (by simp)
          have hR : R < dist m j := by
            by_contra hle; exact hj_not (Or.inr ⟨m, hmS, Nat.le_of_not_lt hle⟩)
          rw [hw j hjS', hfin m j hR, zero_mul, add_zero]
    have hv'_supp : ∀ j ∉ S', stepVec D k v j = 0 := by
      refine hstep_supp v (fun j hjS' => ?_) (fun _ => hkS)
      have hj_not : ¬ (j ∈ S ∨ ∃ m ∈ S, dist m j ≤ R) := by simpa [S'] using hjS'
      exact hv_supp j (fun hjS => hj_not (Or.inl hjS))
    have hfin0 := hrec_supp ks hksS (stepVec D k v) hv'_supp i
    by_contra hnot
    exact hi_ne (hfin0 (by simpa [S'] using hnot))

private lemma foldl_condExpOp_osc {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ)
    {dist : Fin M → Fin M → ℕ} {R : ℕ} {γ_DS : ℝ}
    (S : FiniteRangeDobrushinSpec μ dist R γ_DS) :
    ∀ (l : List (Fin M)) (H : (Fin M → Q) → ℝ) (v : Fin M → ℝ),
      (∀ i, blockOsc H i ≤ v i) →
      ∀ i, blockOsc (l.foldl (fun acc k => condExpOp μ k acc) H) i ≤
        (l.foldl (fun acc k => stepVec S.D k acc) v) i
  | [], _, _, hHv, i => hHv i
  | k :: ks, H, v, hHv, i => by
    refine foldl_condExpOp_osc hμ S ks (condExpOp μ k H) (stepVec S.D k v) ?_ i
    intro j
    have hosc := blockOsc_condExpOp_le hμ S k j H
    dsimp only [stepVec]
    split_ifs with hjk
    · simpa [hjk] using hosc
    · simp only [hjk, ↓reduceIte] at hosc
      exact hosc.trans (add_le_add (hHv j) (mul_le_mul_of_nonneg_left (hHv k) (S.nonneg k j)))

private lemma foldl_condExpOp_covProb {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    (G : (Fin M → Q) → ℝ) :
    ∀ (l : List (Fin M)) (H : (Fin M → Q) → ℝ),
      (∀ k ∈ l, blockOsc G k = 0) →
      covProb μ (l.foldl (fun acc k => condExpOp μ k acc) H) G = covProb μ H G
  | [], _, _ => rfl
  | k :: ks, H, hkG => by
    have hk0 : blockOsc G k = 0 := hkG k (by simp)
    have hks0 : ∀ m ∈ ks, blockOsc G m = 0 := fun m hm => hkG m (by simp [hm])
    rw [List.foldl_cons, foldl_condExpOp_covProb hμ hμ_pos G ks (condExpOp μ k H) hks0]
    exact covProb_condExpOp_left_eq hμ hμ_pos H G hk0

/-- **Finite-Range Dobrushin–Shlosman Spatial Exponential Clustering (`[B/P]`)**:
For any positive probability weight `μ` on `Fin M → Q` satisfying `FiniteRangeDobrushinSpec μ dist R γ_DS`
(`1 ≤ R`, `0 ≤ γ_DS < 1`) and any local observables `F` (supported on `A`) and `G` (supported on `B`)
separated by `1 ≤ d ≤ dist(a, b)` for all `a ∈ A, b ∈ B`:
1. `|Cov_μ(F, G)| ≤ totalOsc F * globalOsc G * γ_DS ^ ((d - 1) / R + 1)`,
2. For `0 < γ_DS < 1`, setting `m_cluster := (-Real.log γ_DS) / (R : ℝ) > 0`:
   `|Cov_μ(F, G)| ≤ totalOsc F * globalOsc G * Real.exp (-m_cluster * d)`,
3. For `γ_DS = 0` (exact decoupling), `Cov_μ(F, G) = 0`. -/
theorem finite_range_ds_spatial_exponential_clustering
    {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    {μ : (Fin M → Q) → ℝ} (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    {dist : Fin M → Fin M → ℕ} {R : ℕ} {γ_DS : ℝ}
    (S : FiniteRangeDobrushinSpec μ dist R γ_DS)
    (F G : (Fin M → Q) → ℝ) (A B : Finset (Fin M))
    (hsuppF : ∀ i ∉ A, blockOsc F i = 0)
    (hsuppG : ∀ j ∉ B, blockOsc G j = 0)
    {d : ℕ} (hd_pos : 1 ≤ d) (hsep : ∀ a ∈ A, ∀ b ∈ B, d ≤ dist a b) :
    |covProb μ F G| ≤ totalOsc F * globalOsc G * γ_DS ^ ((d - 1) / R + 1) ∧
    (0 < γ_DS →
      let m_cluster : ℝ := (-Real.log γ_DS) / (R : ℝ)
      0 < m_cluster ∧
      |covProb μ F G| ≤ totalOsc F * globalOsc G * Real.exp (-m_cluster * (d : ℝ))) ∧
    (γ_DS = 0 → covProb μ F G = 0) := by
  have hstep : ∀ (H : (Fin M → Q) → ℝ) (v : Fin M → ℝ) (t_bound : ℕ),
      t_bound < d →
      (∀ i, 0 ≤ v i) →
      (∀ i, blockOsc H i ≤ v i) →
      (∀ i, v i ≠ 0 → ∃ a ∈ A, dist a i ≤ t_bound) →
      covProb μ H G = covProb μ F G →
      ∃ (H' : (Fin M → Q) → ℝ) (v' : Fin M → ℝ),
        (∀ i, 0 ≤ v' i) ∧
        (∀ i, blockOsc H' i ≤ v' i) ∧
        (∀ i, v' i ≠ 0 → ∃ a ∈ A, dist a i ≤ t_bound + R) ∧
        covProb μ H' G = covProb μ F G ∧
        ∑ i : Fin M, v' i ≤ γ_DS * ∑ i : Fin M, v i := by
    intro H v t_bound ht_lt hv_nn hHv hv_supp hcov
    let S_cur : Finset (Fin M) := Finset.univ.filter (fun i => v i ≠ 0)
    let l : List (Fin M) := S_cur.toList
    have hl_nodup : l.Nodup := Finset.nodup_toList S_cur
    have hl_mem : ∀ k ∈ l, k ∈ S_cur := fun k hk => Finset.mem_toList.mp hk
    have hG_zero : ∀ k ∈ l, blockOsc G k = 0 := by
      intro k hk
      have hkS : k ∈ S_cur := hl_mem k hk
      have hvk : v k ≠ 0 := (Finset.mem_filter.mp hkS).2
      obtain ⟨a, haA, hdist⟩ := hv_supp k hvk
      refine hsuppG k (fun hkB => ?_)
      have hsep_ak := hsep a haA k hkB
      omega
    let H' : (Fin M → Q) → ℝ := l.foldl (fun acc k => condExpOp μ k acc) H
    let v' : Fin M → ℝ := l.foldl (fun acc k => stepVec S.D k acc) v
    refine ⟨H', v', ?_, ?_, ?_, ?_, ?_⟩
    · exact foldl_stepVec_nonneg S.nonneg l v hv_nn
    · exact foldl_condExpOp_osc hμ S l H v hHv
    · intro i hi_ne
      have hi_supp := foldl_stepVec_support S.finite_range S_cur l hl_mem v
        (fun j hj => by
          by_contra hvj
          exact hj (Finset.mem_filter.mpr ⟨Finset.mem_univ j, hvj⟩))
        i hi_ne
      rcases hi_supp with hiS | ⟨k, hkS, hki⟩
      · obtain ⟨a, haA, hda⟩ := hv_supp i (Finset.mem_filter.mp hiS).2
        exact ⟨a, haA, Nat.le_trans hda (Nat.le_add_right _ _)⟩
      · obtain ⟨a, haA, hda⟩ := hv_supp k (Finset.mem_filter.mp hkS).2
        exact ⟨a, haA, le_trans (S.dist_tri a k i) (add_le_add hda hki)⟩
    · dsimp only [H']
      rw [foldl_condExpOp_covProb hμ hμ_pos G l H hG_zero, hcov]
    · have hsum_le := foldl_stepVec_sum_le S.nonneg S.diag_zero
        (le_of_lt S.gamma_lt_one) S.row_sum_le l hl_nodup v hv_nn
      have hlist_sum : (l.map v).sum = ∑ k : Fin M, v k := by
        dsimp only [l]
        simp only [Finset.sum_map_toList]
        dsimp only [S_cur]
        refine Finset.sum_subset (f := v)
          (Finset.filter_subset (fun i : Fin M => v i ≠ 0) Finset.univ)
          (fun k _ hk_not => ?_)
        by_contra hne
        exact hk_not (Finset.mem_filter.mpr ⟨Finset.mem_univ k, hne⟩)
      rw [hlist_sum] at hsum_le
      have halg : (∑ i : Fin M, v i) - (1 - γ_DS) * (∑ i : Fin M, v i) =
          γ_DS * ∑ i : Fin M, v i := by ring
      linarith
  have hlayer : ∀ (t : ℕ), t * R < d →
      ∃ (H : (Fin M → Q) → ℝ) (v : Fin M → ℝ),
        (∀ i, 0 ≤ v i) ∧
        (∀ i, blockOsc H i ≤ v i) ∧
        (∀ i, v i ≠ 0 → ∃ a ∈ A, dist a i ≤ t * R) ∧
        covProb μ H G = covProb μ F G ∧
        ∑ i : Fin M, v i ≤ γ_DS ^ t * totalOsc F := by
    intro t
    induction t with
    | zero =>
      intro _
      refine ⟨F, blockOsc F, fun i => blockOsc_nonneg F i, fun _ => le_rfl, ?_, rfl,
        by simp [totalOsc]⟩
      intro i hi
      have hiA : i ∈ A := by
        by_contra hnot
        exact hi (hsuppF i hnot)
      exact ⟨i, hiA, by simp [S.dist_self i]⟩
    | succ t ih =>
      intro htR
      have hle : t * R < d := lt_of_le_of_lt (Nat.mul_le_mul_right R (Nat.le_succ t)) htR
      obtain ⟨H, v, hv_nn, hHv, hv_supp, hcov, hv_sum⟩ := ih hle
      have ht_lt : t * R < d := hle
      obtain ⟨H', v', hv'_nn, hH'v', hv'_supp, hcov', hv'_sum⟩ :=
        hstep H v (t * R) ht_lt hv_nn hHv hv_supp hcov
      refine ⟨H', v', hv'_nn, hH'v', ?_, hcov', ?_⟩
      · intro i hi
        obtain ⟨a, haA, hdist⟩ := hv'_supp i hi
        refine ⟨a, haA, ?_⟩
        rw [Nat.succ_mul]; exact hdist
      · have hmul : γ_DS * ∑ i : Fin M, v i ≤ γ_DS * (γ_DS ^ t * totalOsc F) :=
          mul_le_mul_of_nonneg_left hv_sum S.gamma_nn
        have hpow : γ_DS * (γ_DS ^ t * totalOsc F) = γ_DS ^ (t + 1) * totalOsc F := by
          rw [pow_succ']; ring
        exact hv'_sum.trans (hmul.trans_eq hpow)
  let q : ℕ := (d - 1) / R
  have hqR_lt : q * R < d := by
    have hdiv : q * R ≤ d - 1 := Nat.div_mul_le_self (d - 1) R
    omega
  obtain ⟨H0, v0, hv0_nn, hH0v0, hv0_supp, hcov0, hv0_sum⟩ := hlayer q hqR_lt
  obtain ⟨H1, v1, hv1_nn, hH1v1, _, hcov1, hv1_sum⟩ :=
    hstep H0 v0 (q * R) hqR_lt hv0_nn hH0v0 hv0_supp hcov0
  have hosc_H1 : totalOsc H1 ≤ γ_DS ^ (q + 1) * totalOsc F := by
    have htot_le : totalOsc H1 ≤ ∑ i : Fin M, v1 i :=
      Finset.sum_le_sum (fun i _ => hH1v1 i)
    have hmul : γ_DS * ∑ i : Fin M, v0 i ≤ γ_DS * (γ_DS ^ q * totalOsc F) :=
      mul_le_mul_of_nonneg_left hv0_sum S.gamma_nn
    have hpow : γ_DS * (γ_DS ^ q * totalOsc F) = γ_DS ^ (q + 1) * totalOsc F := by
      rw [pow_succ']; ring
    exact htot_le.trans (hv1_sum.trans (hmul.trans_eq hpow))
  have hcov_bd : |covProb μ F G| ≤ totalOsc F * globalOsc G * γ_DS ^ (q + 1) := by
    rw [← hcov1]
    have hcb := covProb_le_totalOsc_mul_globalOsc hμ H1 G
    have hmul := mul_le_mul_of_nonneg_right hosc_H1 (globalOsc_nonneg G)
    have hrhs : γ_DS ^ (q + 1) * totalOsc F * globalOsc G =
        totalOsc F * globalOsc G * γ_DS ^ (q + 1) := by ring
    exact hcb.trans (hmul.trans_eq hrhs)
  refine ⟨hcov_bd, ?_, ?_⟩
  · intro hγ_pos
    have hR_pos : (0 : ℝ) < (R : ℝ) := Nat.cast_pos.mpr S.R_pos
    have hlog_neg : Real.log γ_DS < 0 := Real.log_neg hγ_pos S.gamma_lt_one
    have hm_pos : 0 < (-Real.log γ_DS) / (R : ℝ) := div_pos (neg_pos.mpr hlog_neg) hR_pos
    refine ⟨hm_pos, ?_⟩
    have hd_le_nat : d ≤ (q + 1) * R := by
      have hdm := Nat.div_add_mod (d - 1) R
      have hmod : (d - 1) % R < R := Nat.mod_lt (d - 1) S.R_pos
      have hq_eq : (d - 1) / R = q := rfl
      rw [hq_eq] at hdm
      rw [Nat.add_mul, one_mul, mul_comm q R]
      omega
    have hd_le : (d : ℝ) ≤ ((q + 1 : ℕ) : ℝ) * (R : ℝ) := by exact_mod_cast hd_le_nat
    have hd_div : (d : ℝ) / (R : ℝ) ≤ ((q + 1 : ℕ) : ℝ) := (div_le_iff₀ hR_pos).mpr hd_le
    have hneg_log_nn : 0 ≤ -Real.log γ_DS := le_of_lt (neg_pos.mpr hlog_neg)
    have hexp_le : -((-Real.log γ_DS) / (R : ℝ)) * (d : ℝ) ≥
        ((q + 1 : ℕ) : ℝ) * Real.log γ_DS := by
      have hmul := mul_le_mul_of_nonneg_left hd_div hneg_log_nn
      have hL : -Real.log γ_DS * ((d : ℝ) / (R : ℝ)) =
          ((-Real.log γ_DS) / (R : ℝ)) * (d : ℝ) := by ring
      linarith
    have hpow_le : γ_DS ^ (q + 1) ≤ Real.exp (-((-Real.log γ_DS) / (R : ℝ)) * (d : ℝ)) := by
      have heq : γ_DS ^ (q + 1) = Real.exp (((q + 1 : ℕ) : ℝ) * Real.log γ_DS) := by
        rw [Real.exp_nat_mul, Real.exp_log hγ_pos]
      rw [heq]
      exact Real.exp_le_exp.mpr hexp_le
    have hfg_nn : 0 ≤ totalOsc F * globalOsc G :=
      mul_nonneg (Finset.sum_nonneg (fun i _ => blockOsc_nonneg F i)) (globalOsc_nonneg G)
    exact hcov_bd.trans (mul_le_mul_of_nonneg_left hpow_le hfg_nn)
  · intro hγ0
    have hq_ne : q + 1 ≠ 0 := Nat.succ_ne_zero q
    have hpow0 : γ_DS ^ (q + 1) = 0 := by rw [hγ0, zero_pow hq_ne]
    rw [hpow0, mul_zero] at hcov_bd
    exact abs_nonpos_iff.mp hcov_bd

/-- **Synthesis (`[C/B/P]`)**: Combines Zegarlinski inter-block weak-mixing lifting
(`zegarlinski_interblock_weak_mixing_lifting`), finite-range Dobrushin–Shlosman spatial
clustering (`finite_range_ds_spatial_exponential_clustering`), and transfer-matrix spectral-ratio
clustering (`Round04IRRGTransfer.transfer_matrix_spectral_ratio_clustering`) into a unified
volume-independent gap + spatial/temporal clustering theorem. -/
theorem uniform_gap_and_finite_range_clustering_synthesis
    {M : ℕ} {Q : Type*} [Fintype Q] [Nonempty Q]
    (μ : (Fin M → Q) → ℝ) (hμ : IsProbWeight μ) (hμ_pos : ∀ x, 0 < μ x)
    {γ_DS : ℝ} (hC : BlockHGRMatrix μ γ_DS)
    {dist : Fin M → Fin M → ℕ} {R : ℕ}
    (S : FiniteRangeDobrushinSpec μ dist R γ_DS)
    (μ_ref : Fin M → (Fin M → Q) → Q → ℝ)
    (hμ_ref_prob : ∀ i x, IsProbWeight (μ_ref i x))
    (V_blk : Fin M → (Fin M → Q) → Q → ℝ)
    (w_blk : Fin M → (Fin M → Q) → Q → Q → ℝ)
    (hw_nn : ∀ i x q q', 0 ≤ w_blk i x q q')
    (hcond_tilt : ∀ i x, condWeight μ i x = gibbsTilt (μ_ref i x) (V_blk i x))
    {B_blk c_P_ref : ℝ}
    (hosc_blk : ∀ i x (q q' : Q), V_blk i x q - V_blk i x q' ≤ B_blk)
    (hcP_pos : 0 < c_P_ref)
    (hsingle_ref : ∀ i x (g : Q → ℝ),
      varProb (μ_ref i x) g ≤ c_P_ref * edgeDirichlet (μ_ref i x) (w_blk i x) g) :
    let c_P_global : ℝ := (c_P_ref * Real.exp (2 * B_blk)) / (1 - γ_DS)
    0 < c_P_global ∧
    (∀ f : (Fin M → Q) → ℝ,
      varProb μ f ≤ c_P_global *
        ∑ i : Fin M, expVal μ (fun x => edgeDirichlet (condWeight μ i x) (w_blk i x) (condSlice f i x))) ∧
    (∀ (F G : (Fin M → Q) → ℝ) (A B : Finset (Fin M)) (d : ℕ),
      (∀ i ∉ A, blockOsc F i = 0) →
      (∀ j ∉ B, blockOsc G j = 0) →
      1 ≤ d →
      (∀ a ∈ A, ∀ b ∈ B, d ≤ dist a b) →
      |covProb μ F G| ≤ totalOsc F * globalOsc G * γ_DS ^ ((d - 1) / R + 1)) := by
  have hZ := zegarlinski_interblock_weak_mixing_lifting μ hμ hμ_pos hC
    μ_ref hμ_ref_prob V_blk w_blk hw_nn hcond_tilt hosc_blk hcP_pos hsingle_ref
  refine ⟨hZ.1, hZ.2.1, ?_⟩
  intro F G A B d hsuppF hsuppG hd_pos hsep
  exact (finite_range_ds_spatial_exponential_clustering hμ hμ_pos S F G A B hsuppF hsuppG
    hd_pos hsep).1

end FiniteRangeSpatialClustering

/-! ## 5. `β → ∞` Bare Single-Site Obstruction (`DEAD-20261124-11, 14`) & `[X]` (`IR-X`) Isolation -/

section BetaInfinityObstructionAndIRX

/-- Bare single-site Ising conditional TV interdependence `(exp(c β) - 1) / (exp(c β) + 1)`. `[C/B]` -/
noncomputable def isingSingleSiteTV (c β : ℝ) : ℝ :=
  (Real.exp (c * β) - 1) / (Real.exp (c * β) + 1)

/-- Exact bare single-site `Q_8` conditional TV interdependence
`(exp(β/2) - exp(-β/2)) / (exp(β/2) + exp(-β/2) + 6)` from
`asymptotic_freedom_knife_edge_scaling_and_local_dobrushin_breakdown`. `[C/B]` -/
noncomputable def q8SingleSiteTV (β : ℝ) : ℝ :=
  (Real.exp (β / 2) - Real.exp (-β / 2)) / (Real.exp (β / 2) + Real.exp (-β / 2) + 6)

/-- **`β → ∞` Bare Single-Site DS Breakdown (`[C/B/P]`, `DEAD-20261124-11, 14`)**:
1. For any `c > 0`, `isingSingleSiteTV c β → 1` as `β → +∞`;
2. For lattice `Q_8`, `q8SingleSiteTV β → 1` as `β → +∞`, and already at `β = 1`
   (`β / 2 = 1 / 2`) the 4D 18-neighbor sum violates Dobrushin's criterion (`1 < 18 * q8SingleSiteTV 1`);
3. Any bare DS constant `γ β < 1` converging to `1` as `β → +∞` causes the Zegarlinski lifting
   factor `(1 - γ β)⁻¹ → +∞` and the global Poincaré spectral gap `(c_P_loc / (1 - γ β))⁻¹ → 0`,
   blocking `β → ∞` continuum extraction unless replaced by a renormalized physical-scale
   block mixing condition (`[X]`). -/
theorem bare_single_site_ds_collapse_as_beta_tendsto_top :
    (∀ c : ℝ, 0 < c → Filter.Tendsto (isingSingleSiteTV c) atTop (nhds 1)) ∧
    Filter.Tendsto q8SingleSiteTV atTop (nhds 1) ∧
    (1 : ℝ) < 18 * q8SingleSiteTV 1 ∧
    (∀ (γ : ℝ → ℝ) (c_P_loc : ℝ), 0 < c_P_loc →
      (∀ᶠ β in atTop, γ β < 1) →
      Filter.Tendsto γ atTop (nhds 1) →
      Filter.Tendsto (fun β => (1 - γ β)⁻¹) atTop atTop ∧
      Filter.Tendsto (fun β => (c_P_loc / (1 - γ β))⁻¹) atTop (nhds 0)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro c hc
    have hmul : Filter.Tendsto (fun β : ℝ => c * β) atTop atTop :=
      Filter.Tendsto.const_mul_atTop hc tendsto_id
    have hexp : Filter.Tendsto (fun β : ℝ => Real.exp (c * β)) atTop atTop :=
      Real.tendsto_exp_atTop.comp hmul
    have hden : Filter.Tendsto (fun β : ℝ => Real.exp (c * β) + 1) atTop atTop :=
      hexp.atTop_add tendsto_const_nhds
    have hfrac0 : Filter.Tendsto (fun β : ℝ => (2 : ℝ) / (Real.exp (c * β) + 1)) atTop (nhds 0) :=
      tendsto_const_nhds.div_atTop hden
    have hsub1 : Filter.Tendsto (fun β : ℝ => 1 - (2 : ℝ) / (Real.exp (c * β) + 1)) atTop (nhds (1 - 0)) :=
      tendsto_const_nhds.sub hfrac0
    rw [sub_zero] at hsub1
    refine hsub1.congr' ?_
    filter_upwards with β
    have hpos : Real.exp (c * β) + 1 ≠ 0 := by linarith [Real.exp_pos (c * β)]
    dsimp only [isingSingleSiteTV]
    field_simp [hpos]
    ring
  · have hhalf : Filter.Tendsto (fun β : ℝ => β / 2) atTop atTop := by
      have h : (fun β : ℝ => (1 / 2 : ℝ) * β) = (fun β : ℝ => β / 2) := funext (fun β => by ring)
      rw [← h]
      exact Filter.Tendsto.const_mul_atTop (by norm_num) tendsto_id
    have hexp : Filter.Tendsto (fun β : ℝ => Real.exp (β / 2)) atTop atTop :=
      Real.tendsto_exp_atTop.comp hhalf
    have hden_lb : ∀ᶠ β : ℝ in atTop, Real.exp (β / 2) ≤ Real.exp (β / 2) + Real.exp (-β / 2) + 6 := by
      filter_upwards with β
      linarith [Real.exp_pos (-β / 2)]
    have hden : Filter.Tendsto (fun β : ℝ => Real.exp (β / 2) + Real.exp (-β / 2) + 6) atTop atTop :=
      Filter.tendsto_atTop_mono' atTop hden_lb hexp
    have hinv0 : Filter.Tendsto (fun β : ℝ => (8 : ℝ) / (Real.exp (β / 2) + Real.exp (-β / 2) + 6))
        atTop (nhds 0) := tendsto_const_nhds.div_atTop hden
    have herr0 : Filter.Tendsto (fun β : ℝ => 1 - q8SingleSiteTV β) atTop (nhds 0) := by
      refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hinv0 ?_ ?_
      · filter_upwards with β
        have hpos : 0 < Real.exp (β / 2) + Real.exp (-β / 2) + 6 := by
          linarith [Real.exp_pos (β / 2), Real.exp_pos (-β / 2)]
        have heq : 1 - q8SingleSiteTV β =
            (2 * Real.exp (-β / 2) + 6) / (Real.exp (β / 2) + Real.exp (-β / 2) + 6) := by
          dsimp only [q8SingleSiteTV]
          field_simp [ne_of_gt hpos]
          ring
        rw [heq]
        exact div_nonneg (by linarith [Real.exp_pos (-β / 2)]) (le_of_lt hpos)
      · filter_upwards [Filter.eventually_ge_atTop (0 : ℝ)] with β hβ
        have hpos : 0 < Real.exp (β / 2) + Real.exp (-β / 2) + 6 := by
          linarith [Real.exp_pos (β / 2), Real.exp_pos (-β / 2)]
        have heq : 1 - q8SingleSiteTV β =
            (2 * Real.exp (-β / 2) + 6) / (Real.exp (β / 2) + Real.exp (-β / 2) + 6) := by
          dsimp only [q8SingleSiteTV]
          field_simp [ne_of_gt hpos]
          ring
        rw [heq]
        have hexp_le : Real.exp (-β / 2) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
        exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hpos)
    have hsub := (tendsto_const_nhds (x := (1 : ℝ))).sub herr0
    simp only [sub_sub_cancel, sub_zero] at hsub
    exact hsub
  · have hq8 := (asymptotic_freedom_knife_edge_scaling_and_local_dobrushin_breakdown
      (c_AF := 1) (r := 1) (C_gap := 1) (Lambda := 1)
      (by norm_num) (by norm_num) (by norm_num)
      (fun β => 1⁻¹ * Real.exp (-1 * β)) (fun _ => rfl)).2.2.2.2
    have hhalf1 : ((1 : ℝ) / 2) = 1 / 2 := rfl
    have hhalf2 : (-(1 : ℝ) / 2) = -(1 / 2 : ℝ) := by ring
    simpa [q8SingleSiteTV, hhalf1, hhalf2] using hq8
  · intro γ c_P_loc hc_pos hlt hlim
    have h0_right : Filter.Tendsto (fun β => 1 - γ β) atTop (nhdsWithin 0 (Set.Ioi 0)) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, ?_⟩
      · have h := (tendsto_const_nhds (x := (1 : ℝ))).sub hlim
        simpa using h
      · filter_upwards [hlt] with β hβ
        exact sub_pos.mpr hβ
    have hinv : Filter.Tendsto (fun β => (1 - γ β)⁻¹) atTop atTop :=
      tendsto_inv_nhdsGT_zero.comp h0_right
    have hgap0 : Filter.Tendsto (fun β => (c_P_loc / (1 - γ β))⁻¹) atTop (nhds 0) := by
      have hconst : Filter.Tendsto (fun _ : ℝ => c_P_loc) atTop (nhds c_P_loc) := tendsto_const_nhds
      have hmul : Filter.Tendsto (fun β => c_P_loc * (1 - γ β)⁻¹) atTop atTop :=
        Filter.Tendsto.const_mul_atTop hc_pos hinv
      have h0 : Filter.Tendsto (fun β => (c_P_loc * (1 - γ β)⁻¹)⁻¹) atTop (nhds 0) :=
        tendsto_inv_atTop_zero.comp hmul
      refine h0.congr' ?_
      filter_upwards with β
      simp [div_eq_mul_inv]
    exact ⟨hinv, hgap0⟩

/-- **Physical-Scale Renormalized Inter-Block Weak-Mixing Hypothesis (`[X]`, `IR-X`)**:
Captures the exact open mathematical obligation at `IR-X` (`h2d_ir_uniform_clustering_os_gap`)
after `Round04PoincareLSI` and `Round05IRZegarlinskiDS` strip out all `[C/B/P]` algebraic
machinery: along a UV continuum sequence `β_seq m → +∞` with physical block scale
`L_blk^{K_seq m} * a_lat m = ℓ_phys`, the effective block Gibbs measures `μ_seq m` on blocks of
physical size `ℓ_phys` satisfy:
1. Block-local `O(1)` Holley–Stroock oscillation bound `B_blk` relative to reference measures
   with Poincaré constant `c_P_ref` (`[B/P]` once `B_blk` is established on the block),
2. **(`IR-X`)** Uniform physical-scale inter-block HGR contraction `γ_DS_unif < 1` (`BlockHGRMatrix`),
3. **(`IR-X`)** Uniform physical-scale finite-range Dobrushin–Shlosman contraction
   `FiniteRangeDobrushinSpec` of range `R_blk`.

Nothing here asserts `H2d` unconditionally; `H2d` stays `.OPEN` until `γ_DS_unif < 1` at physical
scale `ℓ_phys` is proved constructively in 4D non-Abelian lattice gauge theory (`YM-4D`). -/
structure Round05IRZegarlinskiPremise (Q : Type*) [Fintype Q] [Nonempty Q] where
  M_seq : ℕ → ℕ
  β_seq : ℕ → ℝ
  L_blk : ℝ
  a_lat : ℕ → ℝ
  K_seq : ℕ → ℕ
  ℓ_phys : ℝ
  L_gt_one : 1 < L_blk
  ℓ_phys_pos : 0 < ℓ_phys
  a_pos : ∀ m, 0 < a_lat m
  β_tendsto : Filter.Tendsto β_seq atTop atTop
  physical_scale_lock : ∀ m, L_blk ^ (K_seq m) * a_lat m = ℓ_phys
  dist_seq : ∀ m, Fin (M_seq m) → Fin (M_seq m) → ℕ
  μ_seq : ∀ m, (Fin (M_seq m) → Q) → ℝ
  μ_prob : ∀ m, IsProbWeight (μ_seq m)
  μ_pos : ∀ m x, 0 < μ_seq m x
  c_P_ref : ℝ
  B_blk : ℝ
  hcP_pos : 0 < c_P_ref
  μ_ref : ∀ m, Fin (M_seq m) → (Fin (M_seq m) → Q) → Q → ℝ
  hμ_ref_prob : ∀ m i x, IsProbWeight (μ_ref m i x)
  V_blk : ∀ m, Fin (M_seq m) → (Fin (M_seq m) → Q) → Q → ℝ
  w_blk : ∀ m, Fin (M_seq m) → (Fin (M_seq m) → Q) → Q → Q → ℝ
  hw_nn : ∀ m i x q q', 0 ≤ w_blk m i x q q'
  hcond_tilt : ∀ m i x, condWeight (μ_seq m) i x = gibbsTilt (μ_ref m i x) (V_blk m i x)
  hosc_blk : ∀ m i x (q q' : Q), V_blk m i x q - V_blk m i x q' ≤ B_blk
  hsingle_ref : ∀ m i x (g : Q → ℝ),
    varProb (μ_ref m i x) g ≤ c_P_ref * edgeDirichlet (μ_ref m i x) (w_blk m i x) g
  /-- `[X]` (`IR-X`): physical-scale inter-block HGR weak-mixing constant strictly `< 1` uniformly in `m` (`β_seq m → +∞`). -/
  γ_DS_unif : ℝ
  hγ_nn : 0 ≤ γ_DS_unif
  hγ_lt : γ_DS_unif < 1
  hC_seq : ∀ m, BlockHGRMatrix (μ_seq m) γ_DS_unif
  /-- `[X]` (`IR-X`): physical-scale finite-range Dobrushin–Shlosman specification uniformly in `m`. -/
  R_blk : ℕ
  hDS_seq : ∀ m, FiniteRangeDobrushinSpec (μ_seq m) (dist_seq m) R_blk γ_DS_unif

/-- **Conditional `IR-X` Reduction & Honest `.OPEN` Bridge (`[C/B/P/X]`)**:
Given `P : Round05IRZegarlinskiPremise Q` (`IR-X`):
1. Discharges `hzegarlinski` across every scale/volume `m : ℕ` with the uniform constant
   `K_Z = (1 - P.γ_DS_unif)⁻¹` (independent of `M_seq m` and `β_seq m`);
2. Produces a **volume- and `β`-independent** Poincaré constant
   `c_P_unif = (P.c_P_ref * exp(2 * P.B_blk)) / (1 - P.γ_DS_unif) > 0`;
3. Produces uniform finite-range spatial exponential clustering across all `m : ℕ`, with
   physical mass `m_phys = (-Real.log P.γ_DS_unif) / P.R_blk > 0` whenever `0 < P.γ_DS_unif`;
4. Directly feeds `H2dSharpenedUVAndIRPremise.uniform_clustering` whenever physical correlators
   inherit the finite-range DS covariance bound;
5. Keeps `H2d` and `physicalUnificationStatus` honestly `.OPEN`. -/
theorem round05_ir_zegarlinski_conditional_bridge
    {Q : Type*} [Fintype Q] [Nonempty Q]
    (P : Round05IRZegarlinskiPremise Q) :
    let K_Z : ℝ := (1 - P.γ_DS_unif)⁻¹
    let c_P_unif : ℝ := (P.c_P_ref * Real.exp (2 * P.B_blk)) / (1 - P.γ_DS_unif)
    0 < K_Z ∧ 0 < c_P_unif ∧
    (∀ m : ℕ, ∀ f : (Fin (P.M_seq m) → Q) → ℝ,
      varProb (P.μ_seq m) f ≤ K_Z *
        ∑ i : Fin (P.M_seq m),
          expVal (P.μ_seq m) (fun x => varProb (condWeight (P.μ_seq m) i x) (condSlice f i x))) ∧
    (∀ m : ℕ, ∀ f : (Fin (P.M_seq m) → Q) → ℝ,
      varProb (P.μ_seq m) f ≤ c_P_unif *
        ∑ i : Fin (P.M_seq m),
          expVal (P.μ_seq m) (fun x =>
            edgeDirichlet (condWeight (P.μ_seq m) i x) (P.w_blk m i x) (condSlice f i x))) ∧
    (∀ m : ℕ, ∀ (F G : (Fin (P.M_seq m) → Q) → ℝ) (A B : Finset (Fin (P.M_seq m))) (d : ℕ),
      (∀ i ∉ A, blockOsc F i = 0) →
      (∀ j ∉ B, blockOsc G j = 0) →
      1 ≤ d →
      (∀ a ∈ A, ∀ b ∈ B, d ≤ P.dist_seq m a b) →
      |covProb (P.μ_seq m) F G| ≤
        totalOsc F * globalOsc G * P.γ_DS_unif ^ ((d - 1) / P.R_blk + 1)) ∧
    (0 < P.γ_DS_unif →
      let m_phys : ℝ := (-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)
      0 < m_phys ∧
      ∀ m : ℕ, ∀ (F G : (Fin (P.M_seq m) → Q) → ℝ) (A B : Finset (Fin (P.M_seq m))) (d : ℕ),
        (∀ i ∉ A, blockOsc F i = 0) →
        (∀ j ∉ B, blockOsc G j = 0) →
        1 ≤ d →
        (∀ a ∈ A, ∀ b ∈ B, d ≤ P.dist_seq m a b) →
        |covProb (P.μ_seq m) F G| ≤
