/-! ## Section 1. Discrete `d`-Dimensional Torus Cohomology & Hodge Exactness (`[C/B]`) -/

/-- Discrete `d`-dimensional periodic torus `∏ μ : Fin d, ZMod (L μ)`. `[B]` -/
abbrev DiscreteTorus (d : ℕ) (L : Fin d → ℕ) : Type :=
  (μ : Fin d) → ZMod (L μ)

/-- Elementary lattice step `e_μ` in direction `μ : Fin d` on `DiscreteTorus d L`. `[B]` -/
def torusStep {d : ℕ} {L : Fin d → ℕ} (μ : Fin d) : DiscreteTorus d L :=
  fun ν => if ν = μ then 1 else 0

@[simp] lemma torusStep_apply {d : ℕ} {L : Fin d → ℕ} (μ ν : Fin d) :
    torusStep (L := L) μ ν = if ν = μ then 1 else 0 := rfl

@[simp] lemma discreteTorus_add_apply {d : ℕ} {L : Fin d → ℕ}
    (x y : DiscreteTorus d L) (μ : Fin d) :
    (x + y) μ = x μ + y μ := rfl

/-- Discrete exterior derivative `d₀ : C⁰(T^d_L) → C¹(T^d_L)`, `(d₀ Φ)_μ(x) = Φ(x + e_μ) - Φ(x)`. `[B]` -/
def torusD0 {d : ℕ} {L : Fin d → ℕ} (Φ : DiscreteTorus d L → ℝ) :
    Fin d → DiscreteTorus d L → ℝ :=
  fun μ x => Φ (x + torusStep μ) - Φ x

/-- Discrete plaquette curvature `d₁ : C¹(T^d_L) → C²(T^d_L)`,
`(d₁ ω)_{μν}(x) = ω_μ(x) + ω_ν(x + e_μ) - ω_μ(x + e_ν) - ω_ν(x)`. `[B]` -/
def torusD1 {d : ℕ} {L : Fin d → ℕ} (ω : Fin d → DiscreteTorus d L → ℝ) :
    Fin d → Fin d → DiscreteTorus d L → ℝ :=
  fun μ ν x => ω μ x + ω ν (x + torusStep μ) - ω μ (x + torusStep ν) - ω ν x

/-- Fundamental Polyakov cycle sum of a 1-cochain `ω` along direction `μ` through basepoint `x`. `[B]` -/
def polyakovSum {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (ω : Fin d → DiscreteTorus d L → ℝ) (μ : Fin d) (x : DiscreteTorus d L) : ℝ :=
  ∑ t : ZMod (L μ), ω μ (Function.update x μ t)

/-- Prefix truncation of `x : DiscreteTorus d L` keeping coordinates `< k` and zeroing `≥ k`. -/
def torusTrunc {d : ℕ} {L : Fin d → ℕ} (x : DiscreteTorus d L) (k : ℕ) : DiscreteTorus d L :=
  fun ν => if ν.1 < k then x ν else 0

/-- Canonical discrete Manhattan path-integral potential `Φ_ω(x)` from `0` to `x`. -/
def manhattanPotential {d : ℕ} {L : Fin d → ℕ} (ω : Fin d → DiscreteTorus d L → ℝ)
    (x : DiscreteTorus d L) : ℝ :=
  ∑ m : Fin d, ∑ t ∈ Finset.range (x m).val,
    ω m (Function.update (torusTrunc x m.1) m (t : ZMod (L m)))

lemma torusTrunc_zero {d : ℕ} {L : Fin d → ℕ} (x : DiscreteTorus d L) :
    torusTrunc x 0 = 0 := by
  ext ν
  simp [torusTrunc]

lemma torusTrunc_self {d : ℕ} {L : Fin d → ℕ} (x : DiscreteTorus d L) :
    torusTrunc x d = x := by
  ext ν
  simp [torusTrunc, ν.isLt]

lemma torusTrunc_succ {d : ℕ} {L : Fin d → ℕ} (x : DiscreteTorus d L) (m : Fin d) :
    torusTrunc x (m.1 + 1) = Function.update (torusTrunc x m.1) m (x m) := by
  ext ν
  by_cases hν : ν = m
  · subst hν
    simp [torusTrunc]
  · have hne : ν.1 ≠ m.1 := fun h => hν (Fin.ext h)
    by_cases hlt : ν.1 < m.1
    · have hlt1 : ν.1 < m.1 + 1 := Nat.lt_succ_of_lt hlt
      simp [torusTrunc, hν, hlt, hlt1]
    · have hlt1 : ¬ ν.1 < m.1 + 1 := by omega
      simp [torusTrunc, hν, hlt, hlt1]

lemma torusTrunc_add_step_lt {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) (ν m : Fin d) (hm : m.1 < ν.1) :
    torusTrunc (x + torusStep ν) m.1 = torusTrunc x m.1 := by
  ext α
  by_cases hα : α.1 < m.1
  · have hαν : α ≠ ν := fun h => by subst h; omega
    simp [torusTrunc, hα, hαν]
  · simp [torusTrunc, hα]

lemma torusTrunc_add_step_eq {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) (ν : Fin d) :
    torusTrunc (x + torusStep ν) ν.1 = torusTrunc x ν.1 := by
  ext α
  by_cases hα : α.1 < ν.1
  · have hαν : α ≠ ν := fun h => by subst h; omega
    simp [torusTrunc, hα, hαν]
  · simp [torusTrunc, hα]

lemma torusTrunc_add_step_gt {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) (ν m : Fin d) (hm : ν.1 < m.1) :
    torusTrunc (x + torusStep ν) m.1 = torusTrunc x m.1 + torusStep ν := by
  ext α
  by_cases hα : α.1 < m.1
  · by_cases hαν : α = ν
    · subst hαν
      simp [torusTrunc, hα]
    · simp [torusTrunc, hα, hαν]
  · have hαν : α ≠ ν := fun h => by subst h; omega
    simp [torusTrunc, hα, hαν]

lemma update_add_torusStep_self {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) (μ : Fin d) (t : ZMod (L μ)) :
    Function.update x μ t + torusStep μ = Function.update x μ (t + 1) := by
  ext α
  by_cases hα : α = μ
  · subst hα; simp
  · simp [hα]

lemma update_add_torusStep_ne {d : ℕ} {L : Fin d → ℕ}
    (x : DiscreteTorus d L) {μ ν : Fin d} (hne : ν ≠ μ) (t : ZMod (L μ)) :
    Function.update (x + torusStep ν) μ t = Function.update x μ t + torusStep ν := by
  ext α
  by_cases hα : α = μ
  · subst hα; simp [hne.symm]
  · simp [hα]

/-- Under `torusD1 ω = 0`, the Polyakov loop sum along `μ` is invariant under shifting the basepoint
in any direction `ν`. -/
lemma polyakovSum_add_step {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (ω : Fin d → DiscreteTorus d L → ℝ)
    (hflat : ∀ μ ν x, torusD1 ω μ ν x = 0)
    (μ ν : Fin d) (x : DiscreteTorus d L) :
    polyakovSum ω μ (x + torusStep ν) = polyakovSum ω μ x := by
  by_cases hν : ν = μ
  · subst hν
    unfold polyakovSum
    refine Finset.sum_congr rfl (fun t _ => ?_)
    have heq : Function.update (x + torusStep (L := L) ν) ν t = Function.update x ν t := by
      ext α
      by_cases hα : α = ν
      · subst hα; simp
      · simp [hα]
    rw [heq]
  · have hdiff : polyakovSum ω μ (x + torusStep ν) - polyakovSum ω μ x = 0 := by
      unfold polyakovSum
      rw [← Finset.sum_sub_distrib]
      have hterm : (∑ t : ZMod (L μ),
          (ω μ (Function.update (x + torusStep ν) μ t) - ω μ (Function.update x μ t))) =
          ∑ t : ZMod (L μ),
            (ω ν (Function.update x μ t + torusStep μ) - ω ν (Function.update x μ t)) := by
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [update_add_torusStep_ne x hν t]
        have hf := hflat μ ν (Function.update x μ t)
        unfold torusD1 at hf
        linarith
      rw [hterm, Finset.sum_sub_distrib]
      have hshift : (∑ t : ZMod (L μ), ω ν (Function.update x μ t + torusStep μ)) =
          ∑ t : ZMod (L μ), ω ν (Function.update x μ t) := by
        have hstep : ∀ t : ZMod (L μ),
            ω ν (Function.update x μ t + torusStep μ) = ω ν (Function.update x μ (t + 1)) :=
          fun t => by rw [update_add_torusStep_self]
        simp_rw [hstep]
        exact Fintype.sum_equiv (Equiv.addRight (1 : ZMod (L μ)))
          (fun t => ω ν (Function.update x μ (t + 1)))
          (fun t => ω ν (Function.update x μ t)) (fun _ => rfl)
      linarith
    linarith

/-- Under `torusD1 ω = 0`, every Polyakov cycle sum `polyakovSum ω μ x` equals the fundamental
basepoint Polyakov sum `polyakovSum ω μ 0`. -/
lemma polyakovSum_eq_base {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (ω : Fin d → DiscreteTorus d L → ℝ)
    (hflat : ∀ μ ν x, torusD1 ω μ ν x = 0)
    (μ : Fin d) (x : DiscreteTorus d L) :
    polyakovSum ω μ x = polyakovSum ω μ 0 := by
  have htrunc : ∀ k : ℕ, k ≤ d → polyakovSum ω μ (torusTrunc x k) = polyakovSum ω μ 0 := by
    intro k
    induction k with
    | zero =>
        intro _
        rw [torusTrunc_zero]
    | succ k ih =>
        intro hk
        have hprev := ih (Nat.le_of_succ_le hk)
        let m : Fin d := ⟨k, hk⟩
        have hstep_n : ∀ n : ℕ,
            polyakovSum ω μ (Function.update (torusTrunc x k) m (n : ZMod (L m))) =
              polyakovSum ω μ (torusTrunc x k) := by
          intro n
          induction n with
          | zero =>
              have h0 : Function.update (torusTrunc x k) m ((0 : ℕ) : ZMod (L m)) =
                  torusTrunc x k := by
                ext α
                by_cases hα : α = m
                · subst hα
                  have hmk : ¬ (m.1 < k) := lt_irrefl k
                  simp [torusTrunc, hmk]
                · simp [hα]
              rw [h0]
          | succ n ihn =>
              have hsucc : Function.update (torusTrunc x k) m ((n + 1 : ℕ) : ZMod (L m)) =
                  Function.update (torusTrunc x k) m (n : ZMod (L m)) + torusStep m := by
                rw [Nat.cast_succ, ← update_add_torusStep_self]
              rw [hsucc, polyakovSum_add_step ω hflat μ m, ihn]
        have hxm : ((x m).val : ZMod (L m)) = x m := ZMod.natCast_zmod_val (x m)
        have heq_trunc : torusTrunc x (k + 1) =
            Function.update (torusTrunc x k) m ((x m).val : ZMod (L m)) := by
          rw [hxm]
          exact torusTrunc_succ x m
        rw [heq_trunc, hstep_n (x m).val, hprev]
  simpa [torusTrunc_self] using htrunc d (le_refl d)

/-- Any exact 1-cochain `ω = torusD0 Φ` has identically zero plaquette curvature and vanishing
Polyakov cycle sums at every basepoint. -/
lemma torusD1_and_polyakov_zero_of_coboundary {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (Φ : DiscreteTorus d L → ℝ) :
    (∀ μ ν x, torusD1 (torusD0 Φ) μ ν x = 0) ∧
      (∀ μ x, polyakovSum (torusD0 Φ) μ x = 0) := by
  refine ⟨?_, ?_⟩
  · intro μ ν x
    unfold torusD1 torusD0
    have hcomm : x + torusStep μ + torusStep ν = x + torusStep ν + torusStep μ := by
      rw [add_assoc, add_comm (torusStep μ) (torusStep ν), ← add_assoc]
    rw [hcomm]
    ring
  · intro μ x
    unfold polyakovSum torusD0
    simp_rw [update_add_torusStep_self]
    rw [Finset.sum_sub_distrib]
    have hshift : (∑ t : ZMod (L μ), Φ (Function.update x μ (t + 1))) =
        ∑ t : ZMod (L μ), Φ (Function.update x μ t) :=
      Fintype.sum_equiv (Equiv.addRight (1 : ZMod (L μ)))
        (fun t => Φ (Function.update x μ (t + 1)))
        (fun t => Φ (Function.update x μ t)) (fun _ => rfl)
    linarith

lemma sum_zmod_eq_sum_range {N : ℕ} [NeZero N] (f : ZMod N → ℝ) :
    (∑ t : ZMod N, f t) = ∑ t ∈ Finset.range N, f (t : ZMod N) := by
  let e : Fin N ≃ ZMod N :=
    { toFun := fun i => (i.1 : ZMod N)
      invFun := fun z => ⟨z.val, ZMod.val_lt z⟩
      left_inv := fun i => Fin.ext (ZMod.val_cast_of_lt i.2)
      right_inv := fun z => ZMod.natCast_zmod_val z }
  have h1 : (∑ t : ZMod N, f t) = ∑ i : Fin N, f (i.1 : ZMod N) :=
    (Fintype.sum_equiv e (fun i => f (i.1 : ZMod N)) f (fun _ => rfl)).symm
  rw [h1, Fin.sum_univ_eq_sum_range (fun t => f (t : ZMod N))]

/-- Telescoping lemma along a 1D slice under `torusD1 ω = 0` for distinct directions `m ≠ ν`. -/
lemma flat_slice_sum_diff {d : ℕ} {L : Fin d → ℕ}
    (ω : Fin d → DiscreteTorus d L → ℝ)
    (hflat : ∀ μ ν x, torusD1 ω μ ν x = 0)
    (y : DiscreteTorus d L) {m ν : Fin d} (hmν : m ≠ ν) (n : ℕ) :
    (∑ t ∈ Finset.range n,
        (ω m (Function.update (y + torusStep ν) m (t : ZMod (L m))) -
         ω m (Function.update y m (t : ZMod (L m))))) =
      ω ν (Function.update y m (n : ZMod (L m))) - ω ν (Function.update y m 0) := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      have hupd : Function.update (y + torusStep ν) m (n : ZMod (L m)) =
          Function.update y m (n : ZMod (L m)) + torusStep ν :=
        update_add_torusStep_ne y hmν.symm (n : ZMod (L m))
      have hstep : Function.update y m ((n + 1 : ℕ) : ZMod (L m)) =
          Function.update y m (n : ZMod (L m)) + torusStep m := by
        rw [Nat.cast_succ, ← update_add_torusStep_self]
      rw [hupd, hstep]
      have hf := hflat m ν (Function.update y m (n : ZMod (L m)))
      unfold torusD1 at hf
      linarith

/-- Difference of 1D range sums on `ZMod N` when incrementing `z ↦ z + 1`, assuming total cycle
sum vanishes. -/
lemma zmod_range_sum_step {N : ℕ} [NeZero N] (f : ZMod N → ℝ)
    (htot : (∑ t : ZMod N, f t) = 0) (z : ZMod N) :
    (∑ t ∈ Finset.range (z + 1).val, f (t : ZMod N)) -
      (∑ t ∈ Finset.range z.val, f (t : ZMod N)) = f z := by
  have hz_lt : z.val < N := ZMod.val_lt z
  by_cases hwrap : z.val + 1 < N
  · have h1N : Fact (1 < N) := ⟨by omega⟩
    have hval : (z + 1).val = z.val + 1 := by
      rw [ZMod.val_add, ZMod.val_one N]
      exact Nat.mod_eq_of_lt hwrap
    rw [hval, Finset.sum_range_succ, add_sub_cancel_left, ZMod.natCast_zmod_val]
  · have hwrap_eq : z.val + 1 = N := by omega
    have hzp1 : z + 1 = 0 := by
      have hzcast : ((z.val + 1 : ℕ) : ZMod N) = z + 1 := by
        rw [Nat.cast_add, Nat.cast_one, ZMod.natCast_zmod_val]
      rw [← hzcast, hwrap_eq, ZMod.natCast_self]
    rw [hzp1, ZMod.val_zero, Finset.range_zero, Finset.sum_empty, zero_sub]
    have hrange_N : (∑ t ∈ Finset.range N, f (t : ZMod N)) = 0 := by
      rw [← sum_zmod_eq_sum_range]
      exact htot
    have hN_split : (∑ t ∈ Finset.range N, f (t : ZMod N)) =
        (∑ t ∈ Finset.range z.val, f (t : ZMod N)) + f (z.val : ZMod N) := by
      have hset : Finset.range N = Finset.range (z.val + 1) := by rw [hwrap_eq]
      rw [hset]
      exact Finset.sum_range_succ (fun t => f (t : ZMod N)) z.val
    rw [ZMod.natCast_zmod_val] at hN_split
    linarith

/-- `manhattanPotential ω` is an exact primitive for `ω` (`torusD0 (manhattanPotential ω) = ω`)
whenever `torusD1 ω = 0` and all fundamental basepoint Polyakov cycle sums vanish. -/
lemma torusD0_manhattanPotential {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    (ω : Fin d → DiscreteTorus d L → ℝ)
    (hflat : ∀ μ ν x, torusD1 ω μ ν x = 0)
    (hpoly : ∀ μ, polyakovSum ω μ 0 = 0) :
    ∀ ν x, torusD0 (manhattanPotential ω) ν x = ω ν x := by
  intro ν x
  unfold torusD0 manhattanPotential
  rw [← Finset.sum_sub_distrib]
  have hterm : ∀ m : Fin d,
      ((∑ t ∈ Finset.range ((x + torusStep (L := L) ν) m).val,
          ω m (Function.update (torusTrunc (x + torusStep (L := L) ν) m.1) m (t : ZMod (L m)))) -
       (∑ t ∈ Finset.range (x m).val,
          ω m (Function.update (torusTrunc x m.1) m (t : ZMod (L m))))) =
      if m.1 < ν.1 then 0
      else if m = ν then ω ν (torusTrunc x (ν.1 + 1))
      else ω ν (torusTrunc x (m.1 + 1)) - ω ν (torusTrunc x m.1) := by
    intro m
    rcases lt_trichotomy m.1 ν.1 with hlt | heq | hgt
    · have hne : m ≠ ν := fun h => by subst h; omega
      have hcoord : (x + torusStep (L := L) ν) m = x m := by simp [hne]
      rw [hcoord, torusTrunc_add_step_lt x ν m hlt, sub_self, if_pos hlt]
    · have hmν : m = ν := Fin.ext heq
      subst hmν
      rw [if_neg (lt_irrefl _), if_pos rfl]
      rw [torusTrunc_add_step_eq x m]
      have hcoord : (x + torusStep (L := L) m) m = x m + 1 := by simp
      rw [hcoord]
      have hpoly_here : polyakovSum ω m (torusTrunc x m.1) = 0 :=
        (polyakovSum_eq_base ω hflat m (torusTrunc x m.1)).trans (hpoly m)
      have hz := zmod_range_sum_step
        (fun t => ω m (Function.update (torusTrunc x m.1) m t)) hpoly_here (x m)
      rw [torusTrunc_succ x m]
      exact hz
    · have hne : m ≠ ν := fun h => by subst h; omega
      have hnotlt : ¬ m.1 < ν.1 := by omega
      rw [if_neg hnotlt, if_neg hne]
      have hcoord : (x + torusStep (L := L) ν) m = x m := by simp [hne]
      rw [hcoord, torusTrunc_add_step_gt x ν m hgt, ← Finset.sum_sub_distrib]
      have hslice := flat_slice_sum_diff ω hflat (torusTrunc x m.1) hne (x m).val
      rw [ZMod.natCast_zmod_val, ← torusTrunc_succ x m] at hslice
      have h0 : Function.update (torusTrunc x m.1) m 0 = torusTrunc x m.1 := by
        ext α; by_cases hα : α = m
        · subst hα
          simp [torusTrunc]
        · simp [hα]
      rw [h0] at hslice
      exact hslice
  simp_rw [hterm]
  have hsum_split :
      (∑ m : Fin d, if m.1 < ν.1 then (0 : ℝ)
        else if m = ν then ω ν (torusTrunc x (ν.1 + 1))
        else ω ν (torusTrunc x (m.1 + 1)) - ω ν (torusTrunc x m.1)) =
      ∑ k ∈ Finset.range d,
        if k < ν.1 then (0 : ℝ)
        else if k = ν.1 then ω ν (torusTrunc x (ν.1 + 1))
        else ω ν (torusTrunc x (k + 1)) - ω ν (torusTrunc x k) := by
    rw [← Fin.sum_univ_eq_sum_range (fun k =>
      if k < ν.1 then (0 : ℝ)
      else if k = ν.1 then ω ν (torusTrunc x (ν.1 + 1))
      else ω ν (torusTrunc x (k + 1)) - ω ν (torusTrunc x k))]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    by_cases h1 : m.1 < ν.1
    · simp [h1]
    · by_cases h2 : m = ν
      · subst h2; simp
      · have h2' : m.1 ≠ ν.1 := fun h => h2 (Fin.ext h)
        simp [h1, h2, h2']
  rw [hsum_split]
  have htel : ∀ n : ℕ, ν.1 < n → n ≤ d →
      (∑ k ∈ Finset.range n,
        if k < ν.1 then (0 : ℝ)
        else if k = ν.1 then ω ν (torusTrunc x (ν.1 + 1))
        else ω ν (torusTrunc x (k + 1)) - ω ν (torusTrunc x k)) =
      ω ν (torusTrunc x n) := by
    intro n
    induction n with
    | zero =>
        intro hlt _
        omega
    | succ n ih =>
        intro hlt hn
        rw [Finset.sum_range_succ]
        rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.mp hlt) with hlt' | heq'
        · have hprev := ih hlt' (Nat.le_of_succ_le hn)
          rw [hprev]
          have h1 : ¬ n < ν.1 := by omega
          have h2 : n ≠ ν.1 := by omega
          simp [h1, h2]
        · have hzero : (∑ k ∈ Finset.range n,
              if k < ν.1 then (0 : ℝ)
              else if k = ν.1 then ω ν (torusTrunc x (ν.1 + 1))
              else ω ν (torusTrunc x (k + 1)) - ω ν (torusTrunc x k)) = 0 := by
            refine Finset.sum_eq_zero (fun k hk => ?_)
            rw [Finset.mem_range] at hk
            have hk' : k < ν.1 := by omega
            simp [hk']
          rw [hzero, zero_add]
          rw [← heq']
          simp
  rw [htel d ν.isLt (le_refl d), torusTrunc_self]

/-- Discrete connected-torus Poincaré lemma: if `torusD0 Φ₁ = torusD0 Φ₂`, then `Φ₁ - Φ₂` is
globally constant on `DiscreteTorus d L`. -/
lemma discrete_torus_zero_d0_const {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)]
    {Φ₁ Φ₂ : DiscreteTorus d L → ℝ}
    (hd : torusD0 Φ₁ = torusD0 Φ₂) :
    ∀ x : DiscreteTorus d L, Φ₁ x - Φ₂ x = Φ₁ 0 - Φ₂ 0 := by
  let Δ : DiscreteTorus d L → ℝ := fun x => Φ₁ x - Φ₂ x
  have hstep : ∀ (x : DiscreteTorus d L) (μ : Fin d), Δ (x + torusStep μ) = Δ x := by
    intro x μ
    have hμ := congrFun (congrFun hd μ) x
    dsimp [torusD0] at hμ
    dsimp [Δ]
    linarith
  intro x
  have htrunc : ∀ k : ℕ, k ≤ d → Δ (torusTrunc x k) = Δ 0 := by
    intro k
    induction k with
    | zero => intro _; rw [torusTrunc_zero]
    | succ k ih =>
        intro hk
        have hprev := ih (Nat.le_of_succ_le hk)
        let m : Fin d := ⟨k, hk⟩
        have hstep_n : ∀ n : ℕ,
            Δ (Function.update (torusTrunc x k) m (n : ZMod (L m))) = Δ (torusTrunc x k) := by
          intro n
          induction n with
          | zero =>
              have h0 : Function.update (torusTrunc x k) m ((0 : ℕ) : ZMod (L m)) =
                  torusTrunc x k := by
                ext α; by_cases hα : α = m
                · subst hα
                  have hmk : ¬ m.1 < k := lt_irrefl k
                  simp [torusTrunc, hmk]
                · simp [hα]
              rw [h0]
          | succ n ihn =>
              have hsucc : Function.update (torusTrunc x k) m ((n + 1 : ℕ) : ZMod (L m)) =
                  Function.update (torusTrunc x k) m (n : ZMod (L m)) + torusStep m := by
                rw [Nat.cast_succ, ← update_add_torusStep_self]
              rw [hsucc, hstep, ihn]
        have hxm : ((x m).val : ZMod (L m)) = x m := ZMod.natCast_zmod_val (x m)
        have heq_trunc : torusTrunc x (k + 1) =
            Function.update (torusTrunc x k) m ((x m).val : ZMod (L m)) := by
          rw [hxm]
          exact torusTrunc_succ x m
        rw [heq_trunc, hstep_n (x m).val, hprev]
  simpa [Δ, torusTrunc_self] using htrunc d (le_refl d)

/-- **Discrete `T^d` Hodge / Cohomology Exactness iff Zero Polyakov Cycles (`[C/B]`)**:
On any discrete `d`-dimensional periodic torus `DiscreteTorus d L` (`L_μ ≥ 1` for all `μ`),
1. A 1-cochain `ω` is a global coboundary `ω = torusD0 Φ` **if and only if** its discrete
   plaquette curvature vanishes everywhere (`torusD1 ω = 0`) AND all fundamental Polyakov cycle
   sums vanish (`∀ μ, polyakovSum ω μ 0 = 0`, equivalently `∀ μ x, polyakovSum ω μ x = 0`).
2. `Φ` is unique up to a global additive constant (`Φ₁ x - Φ₂ x = Φ₁ 0 - Φ₂ 0`). -/
theorem discrete_torus_flat_cochain_coboundary_iff_zero_polyakov
    (d : ℕ) (L : Fin d → ℕ) [∀ μ, NeZero (L μ)]
    (ω : Fin d → DiscreteTorus d L → ℝ) :
    ((∀ μ ν x, torusD1 ω μ ν x = 0) ∧ (∀ μ, polyakovSum ω μ 0 = 0)) ↔
      (∃ Φ : DiscreteTorus d L → ℝ, ω = torusD0 Φ) ∧
      ((∀ μ ν x, torusD1 ω μ ν x = 0) ∧ (∀ μ x, polyakovSum ω μ x = 0)) ∧
      (∀ Φ₁ Φ₂ : DiscreteTorus d L → ℝ,
        torusD0 Φ₁ = ω → torusD0 Φ₂ = ω → ∀ x, Φ₁ x - Φ₂ x = Φ₁ 0 - Φ₂ 0) := by
  constructor
  · rintro ⟨hflat, hpoly⟩
    have hΦ : ω = torusD0 (manhattanPotential ω) := by
      funext ν x
      exact (torusD0_manhattanPotential ω hflat hpoly ν x).symm
    refine ⟨⟨manhattanPotential ω, hΦ⟩,
      ⟨hflat, fun μ x => (polyakovSum_eq_base ω hflat μ x).trans (hpoly μ)⟩,
      fun Φ₁ Φ₂ h1 h2 x => discrete_torus_zero_d0_const (h1.trans h2.symm) x⟩
  · rintro ⟨⟨Φ, rfl⟩, ⟨hflat, hpoly_all⟩, _⟩
    exact ⟨hflat, fun μ => hpoly_all μ 0⟩

/-- **Exact 2D Torus Specialization (`ZMod L1 × ZMod L2`) & Sharpening of Round 03's
`torus_flat_cochain_nonzero_holonomy_not_coboundary` (`[C/B]`)**:
For any `L1 L2 : ℕ` with `[NeZero L1] [NeZero L2]` (in particular `2 ≤ L1, 2 ≤ L2`) and any
1-cochain `(ω₁, ω₂)` on `ZMod L1 × ZMod L2`, `(ω₁, ω₂)` is a global coboundary `(d₀ Φ)`
**if and only if** plaquette curvature vanishes everywhere AND both fundamental Polyakov cycle
sums `(∑ x, ω₁ x 0)` and `(∑ y, ω₂ 0 y)` vanish. -/
theorem discrete_2d_torus_flat_cochain_coboundary_iff_zero_polyakov
    (L1 L2 : ℕ) [NeZero L1] [NeZero L2]
    (ω₁ ω₂ : ZMod L1 → ZMod L2 → ℝ) :
    ((∀ x y, ω₁ x y + ω₂ (x + 1) y - ω₁ x (y + 1) - ω₂ x y = 0) ∧
      (∑ x : ZMod L1, ω₁ x 0 = 0) ∧ (∑ y : ZMod L2, ω₂ 0 y = 0)) ↔
      (∃ Φ : ZMod L1 → ZMod L2 → ℝ,
        (∀ x y, ω₁ x y = Φ (x + 1) y - Φ x y) ∧
        (∀ x y, ω₂ x y = Φ x (y + 1) - Φ x y)) := by
  let L : Fin 2 → ℕ := fun μ => match μ with | 0 => L1 | 1 => L2
  have _hNeZ : ∀ μ : Fin 2, NeZero (L μ) := fun μ => by
    fin_cases μ <;> assumption
  let of2 : ZMod L1 × ZMod L2 → DiscreteTorus 2 L := fun xy μ =>
    match μ with | 0 => xy.1 | 1 => xy.2
  have h_of_to : ∀ p : DiscreteTorus 2 L, of2 (p 0, p 1) = p := fun p => by
    ext μ; fin_cases μ <;> rfl
  have hstep0 : ∀ x y, of2 (x + 1, y) = of2 (x, y) + torusStep 0 := fun x y => by
    ext μ; fin_cases μ <;> simp [of2]
  have hstep1 : ∀ x y, of2 (x, y + 1) = of2 (x, y) + torusStep 1 := fun x y => by
    ext μ; fin_cases μ <;> simp [of2]
  let ω : Fin 2 → DiscreteTorus 2 L → ℝ := fun μ p =>
    match μ with | 0 => ω₁ (p 0) (p 1) | 1 => ω₂ (p 0) (p 1)
  have hflat_iff :
      (∀ μ ν p, torusD1 ω μ ν p = 0) ↔
        (∀ x y, ω₁ x y + ω₂ (x + 1) y - ω₁ x (y + 1) - ω₂ x y = 0) := by
    constructor
    · intro hf x y
      have h01 := hf 0 1 (of2 (x, y))
      unfold torusD1 at h01
      rw [← hstep0, ← hstep1] at h01
      simpa [ω, of2] using h01
    · intro hf μ ν p
      have h01 : ω₁ (p 0) (p 1) + ω₂ (p 0 + 1) (p 1) - ω₁ (p 0) (p 1 + 1) - ω₂ (p 0) (p 1) = 0 :=
        hf (p 0) (p 1)
      have hp0 : p + torusStep (L := L) 0 = of2 (p 0 + 1, p 1) := by
        rw [hstep0, h_of_to]
      have hp1 : p + torusStep (L := L) 1 = of2 (p 0, p 1 + 1) := by
        rw [hstep1, h_of_to]
      fin_cases μ <;> fin_cases ν
      · unfold torusD1; ring
      · change ω 0 p + ω 1 (p + torusStep (L := L) 0) -
            ω 0 (p + torusStep (L := L) 1) - ω 1 p = 0
        rw [hp0, hp1]
        simpa [ω, of2] using h01
      · change ω 1 p + ω 0 (p + torusStep (L := L) 1) -
            ω 1 (p + torusStep (L := L) 0) - ω 0 p = 0
        rw [hp0, hp1]
        have heq : ω 1 p + ω 0 (of2 (p 0, p 1 + 1)) - ω 1 (of2 (p 0 + 1, p 1)) - ω 0 p =
            -(ω₁ (p 0) (p 1) + ω₂ (p 0 + 1) (p 1) - ω₁ (p 0) (p 1 + 1) - ω₂ (p 0) (p 1)) := by
          simp [ω, of2]; ring
        rw [heq, h01, neg_zero]
      · unfold torusD1; ring
  have hpoly_iff :
      (∀ μ, polyakovSum ω μ 0 = 0) ↔
        (∑ x : ZMod L1, ω₁ x 0 = 0) ∧ (∑ y : ZMod L2, ω₂ 0 y = 0) := by
    have h0 : polyakovSum ω 0 0 = ∑ x : ZMod L1, ω₁ x 0 := by
      unfold polyakovSum
      refine Finset.sum_congr rfl (fun x _ => by simp [ω])
    have h1 : polyakovSum ω 1 0 = ∑ y : ZMod L2, ω₂ 0 y := by
      unfold polyakovSum
      refine Finset.sum_congr rfl (fun y _ => by simp [ω])
    constructor
    · intro hp
      exact ⟨h0.symm.trans (hp 0), h1.symm.trans (hp 1)⟩
    · rintro ⟨hp0, hp1⟩ μ
      fin_cases μ
      · exact h0.trans hp0
      · exact h1.trans hp1
  have hcob_iff :
      (∃ Φ : DiscreteTorus 2 L → ℝ, ω = torusD0 Φ) ↔
        (∃ Φ : ZMod L1 → ZMod L2 → ℝ,
          (∀ x y, ω₁ x y = Φ (x + 1) y - Φ x y) ∧
          (∀ x y, ω₂ x y = Φ x (y + 1) - Φ x y)) := by
    constructor
    · rintro ⟨Φ, hΦ⟩
      refine ⟨fun x y => Φ (of2 (x, y)), ?_, ?_⟩
      · intro x y
        have h0 := congrFun (congrFun hΦ 0) (of2 (x, y))
        change ω 0 (of2 (x, y)) = Φ (of2 (x, y) + torusStep (L := L) 0) - Φ (of2 (x, y)) at h0
        rw [← hstep0] at h0
        simpa [ω, of2] using h0
      · intro x y
        have h1 := congrFun (congrFun hΦ 1) (of2 (x, y))
        change ω 1 (of2 (x, y)) = Φ (of2 (x, y) + torusStep (L := L) 1) - Φ (of2 (x, y)) at h1
        rw [← hstep1] at h1
        simpa [ω, of2] using h1
    · rintro ⟨Φ, h1, h2⟩
      refine ⟨fun p => Φ (p 0) (p 1), ?_⟩
      funext μ p
      fin_cases μ
      · change ω 0 p = Φ ((p + torusStep (L := L) 0) 0) ((p + torusStep (L := L) 0) 1) - Φ (p 0) (p 1)
        have hp0 : (p + torusStep (L := L) 0) 0 = p 0 + 1 := by simp
        have hp1 : (p + torusStep (L := L) 0) 1 = p 1 := by simp
        rw [hp0, hp1]
        exact h1 (p 0) (p 1)
      · change ω 1 p = Φ ((p + torusStep (L := L) 1) 0) ((p + torusStep (L := L) 1) 1) - Φ (p 0) (p 1)
        have hp0 : (p + torusStep (L := L) 1) 0 = p 0 := by simp
        have hp1 : (p + torusStep (L := L) 1) 1 = p 1 + 1 := by simp
        rw [hp0, hp1]
        exact h2 (p 0) (p 1)
  have hmain := discrete_torus_flat_cochain_coboundary_iff_zero_polyakov 2 L ω
  constructor
  · rintro ⟨hf, hp1, hp2⟩
    have hleft : (∀ μ ν x, torusD1 ω μ ν x = 0) ∧ (∀ μ, polyakovSum ω μ 0 = 0) :=
      ⟨hflat_iff.mpr hf, hpoly_iff.mpr ⟨hp1, hp2⟩⟩
    exact hcob_iff.mp (hmain.mp hleft).1
  · intro hcob
    have hright : (∃ Φ, ω = torusD0 Φ) ∧
        ((∀ μ ν x, torusD1 ω μ ν x = 0) ∧ (∀ μ x, polyakovSum ω μ x = 0)) ∧
        (∀ Φ₁ Φ₂, torusD0 Φ₁ = ω → torusD0 Φ₂ = ω → ∀ x, Φ₁ x - Φ₂ x = Φ₁ 0 - Φ₂ 0) := by
      rcases hcob_iff.mpr hcob with ⟨Φ, hΦ⟩
      have hzp := torusD1_and_polyakov_zero_of_coboundary Φ
      refine ⟨⟨Φ, hΦ⟩, ?_, fun Φ₁ Φ₂ h1 h2 x => discrete_torus_zero_d0_const (h1.trans h2.symm) x⟩
      rw [hΦ]
      exact hzp
    have hleft := hmain.mpr hright
    exact ⟨hflat_iff.mp hleft.1, (hpoly_iff.mp hleft.2).1, (hpoly_iff.mp hleft.2).2⟩

/-! ## Section 2. Universal Cover `ℤ^d → T^d_L` & Multiplicative `U(1)` Phase Descent (`[C/B/S]`) -/

/-- Elementary lattice step on the universal cover `Fin d → ℤ`. `[B]` -/
def zdStep {d : ℕ} (μ : Fin d) : Fin d → ℤ :=
  fun ν => if ν = μ then 1 else 0

@[simp] lemma zdStep_apply {d : ℕ} (μ ν : Fin d) :
    zdStep μ ν = if ν = μ then 1 else 0 := rfl

@[simp] lemma zd_add_apply {d : ℕ} (x y : Fin d → ℤ) (μ : Fin d) :
    (x + y) μ = x μ + y μ := rfl

/-- Discrete exterior derivative on `Fin d → ℤ`. `[B]` -/
def zdD0 {d : ℕ} (Φ : (Fin d → ℤ) → ℝ) : Fin d → (Fin d → ℤ) → ℝ :=
  fun μ n => Φ (n + zdStep μ) - Φ n

/-- Covering projection `π_cov : (Fin d → ℤ) → DiscreteTorus d L`. `[B]` -/
def torusCoverProj {d : ℕ} {L : Fin d → ℕ} : (Fin d → ℤ) → DiscreteTorus d L :=
  fun n μ => (n μ : ZMod (L μ))

lemma torusCoverProj_surjective {d : ℕ} {L : Fin d → ℕ} [∀ μ, NeZero (L μ)] :
    Surjective (torusCoverProj (d := d) (L := L)) := by
  intro x
  refine ⟨fun μ => ((x μ).val : ℤ), ?_⟩
  ext μ
  simp [torusCoverProj]

lemma torusCoverProj_add_step {d : ℕ} {L : Fin d → ℕ} (n : Fin d → ℤ) (μ : Fin d) :
    torusCoverProj (L := L) (n + zdStep μ) = torusCoverProj (L := L) n + torusStep μ := by
  ext ν
  by_cases hν : ν = μ
  · subst hν; simp [torusCoverProj]
  · simp [torusCoverProj, hν]

/-- **Universal-Cover `ℤ^d` Exactness & Multiplicative `U(1)` Phase Descent Modulo `2πℤ` (`[C/B/S]`)**:
1. For any flat 1-cochain `ω` (`torusD1 ω = 0`) on `T^d_L`, its pullback `ω̃_μ(n) := ω_μ(π_cov n)` on
   the simply-connected lattice `ℤ^d` admits an explicit global primitive `Φ_cov : (Fin d → ℤ) → ℝ`
   satisfying `zdD0 Φ_cov = ω̃`.
2. Along the surjective covering quotient `π_cov : ℤ^d → T^d_L`:
   - `W_eff(n) = W_inv(π_cov n) + i Φ_cov(n)` descends uniquely (`QuotientDescent` /
     `luscher_weyl_action_descends_iff_zero_gauge_coboundary`) **iff** `∀ μ, polyakovSum ω μ 0 = 0`;
   - The `U(1)` phase `exp(i Φ_cov(n))` (and Euclidean weight `exp(-W_eff(n))`) descends uniquely to
     `T^d_L` **iff** `∀ μ, ∃ k : ℤ, polyakovSum ω μ 0 = 2 * Real.pi * (k : ℝ)`. -/
theorem universal_cover_zd_primitive_and_u1_phase_descent_iff
    (d : ℕ) (L : Fin d → ℕ) [∀ μ, NeZero (L μ)]
    (ω : Fin d → DiscreteTorus d L → ℝ)
    (hflat : ∀ μ ν x, torusD1 ω μ ν x = 0)
    (W_inv : DiscreteTorus d L → ℂ) :
    ∃ Φ_cov : (Fin d → ℤ) → ℝ,
      (∀ μ n, zdD0 Φ_cov μ n = ω μ (torusCoverProj n)) ∧
      ((∃! W_bar : DiscreteTorus d L → ℂ,
          W_bar ∘ torusCoverProj = fun n => W_inv (torusCoverProj n) + Complex.I * (Φ_cov n : ℂ)) ↔
        (∀ μ, polyakovSum ω μ 0 = 0)) ∧
      ((∃! Z_bar : DiscreteTorus d L → ℂ,
          Z_bar ∘ torusCoverProj = fun n => Complex.exp (Complex.I * (Φ_cov n : ℂ))) ↔
        (∀ μ, ∃ k : ℤ, polyakovSum ω μ 0 = 2 * Real.pi * (k : ℝ))) ∧
      ((∃! E_bar : DiscreteTorus d L → ℂ,
          E_bar ∘ torusCoverProj = fun n =>
            Complex.exp (-(W_inv (torusCoverProj n) + Complex.I * (Φ_cov n : ℂ)))) ↔
        (∀ μ, ∃ k : ℤ, polyakovSum ω μ 0 = 2 * Real.pi * (k : ℝ))) := by
  let P : Fin d → ℝ := fun μ => polyakovSum ω μ 0
  let δ : Fin d → DiscreteTorus d L → ℝ := fun μ x =>
    if (x μ).val = L μ - 1 then P μ else 0
  let ω0 : Fin d → DiscreteTorus d L → ℝ := fun μ x => ω μ x - δ μ x
  have hflat0 : ∀ μ ν x, torusD1 ω0 μ ν x = 0 := by
    intro μ ν x
    by_cases hμν : μ = ν
    · subst hμν; unfold torusD1; ring
    · have hδμ : δ μ (x + torusStep (L := L) ν) = δ μ x := by
        have hx : (x + torusStep (L := L) ν) μ = x μ := by simp [hμν]
        simp only [δ, hx]
      have hδν : δ ν (x + torusStep (L := L) μ) = δ ν x := by
        have hx : (x + torusStep (L := L) μ) ν = x ν := by simp [Ne.symm hμν]
        simp only [δ, hx]
      have hf := hflat μ ν x
      unfold torusD1 at hf ⊢
      dsimp [ω0]
      linarith
  have hpoly0 : ∀ μ, polyakovSum ω0 μ 0 = 0 := by
    intro μ
    unfold polyakovSum
    simp_rw [show ∀ t : ZMod (L μ), ω0 μ (Function.update 0 μ t) =
        ω μ (Function.update 0 μ t) - (if t.val = L μ - 1 then P μ else 0) from
      fun t => by simp [ω0, δ]]
    rw [Finset.sum_sub_distrib]
    have hsum_δ : (∑ t : ZMod (L μ), if t.val = L μ - 1 then P μ else 0) = P μ := by
      have hpos : 0 < L μ := NeZero.pos (L μ)
      let t_last : ZMod (L μ) := ((L μ - 1 : ℕ) : ZMod (L μ))
      have hval_last : t_last.val = L μ - 1 := ZMod.val_cast_of_lt (by omega)
      rw [Finset.sum_eq_single t_last]
      · simp [hval_last]
      · intro t _ hne
        have ht_ne : t.val ≠ L μ - 1 := by
          intro heq
          apply hne
          rw [← ZMod.natCast_zmod_val t, heq]
        simp [ht_ne]
      · intro hmem; exact absurd (Finset.mem_univ t_last) hmem
    change polyakovSum ω μ 0 - _ = 0
    rw [hsum_δ]
    dsimp [P]
    ring
  let Φ0 : DiscreteTorus d L → ℝ := manhattanPotential ω0
  have hΦ0 : ∀ μ x, torusD0 Φ0 μ x = ω0 μ x := torusD0_manhattanPotential ω0 hflat0 hpoly0
  let Φ_cov : (Fin d → ℤ) → ℝ := fun n =>
    Φ0 (torusCoverProj n) + ∑ μ : Fin d, ((n μ / (L μ : ℤ) : ℤ) : ℝ) * P μ
  have hzd : ∀ μ n, zdD0 Φ_cov μ n = ω μ (torusCoverProj n) := by
    intro μ n
    unfold zdD0
    dsimp [Φ_cov]
    rw [torusCoverProj_add_step]
    have h_ediv : ∀ ν : Fin d,
        (((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) - ((n ν / (L ν : ℤ) : ℤ) : ℝ) =
          if ν = μ then (if ((torusCoverProj (L := L) n) μ).val = L μ - 1 then 1 else 0) else 0 := by
      intro ν
      by_cases hν : ν = μ
      · subst hν
        rw [if_pos rfl]
        have hstep_val : (n + zdStep ν) ν = n ν + 1 := by simp
        rw [hstep_val]
        have hL_pos : (0 : ℤ) < (L ν : ℤ) := Int.natCast_pos.mpr (NeZero.pos (L ν))
        have hL_ne : (L ν : ℤ) ≠ 0 := ne_of_gt hL_pos
        have h_emod_lt : 0 ≤ n ν % (L ν : ℤ) ∧ n ν % (L ν : ℤ) < (L ν : ℤ) :=
          ⟨Int.emod_nonneg _ hL_ne, Int.emod_lt_of_pos _ hL_pos⟩
        have hval_emod : ((torusCoverProj (L := L) n) ν).val = (n ν % (L ν : ℤ)).toNat := by
          dsimp [torusCoverProj]
          have h1 : ((n ν : ZMod (L ν)).val : ℤ) = n ν % (L ν : ℤ) := ZMod.val_intCast (n ν)
          omega
        have hdecomp : n ν = (L ν : ℤ) * (n ν / (L ν : ℤ)) + n ν % (L ν : ℤ) := by
          have hdiv := Int.mul_ediv_add_emod (n ν) (L ν : ℤ)
          linarith
        by_cases hlast : ((torusCoverProj (L := L) n) ν).val = L ν - 1
        · rw [if_pos hlast]
          have hrem : n ν % (L ν : ℤ) = (L ν : ℤ) - 1 := by omega
          have hnp1 : n ν + 1 = (L ν : ℤ) * ((n ν / (L ν : ℤ)) + 1) := by linarith
          rw [hnp1, Int.mul_ediv_cancel_left _ hL_ne]
          push_cast; ring
        · rw [if_neg hlast]
          have hrem_lt : n ν % (L ν : ℤ) + 1 < (L ν : ℤ) := by omega
          have hrem_nn : 0 ≤ n ν % (L ν : ℤ) + 1 := by omega
          have hnp1 : n ν + 1 = (L ν : ℤ) * (n ν / (L ν : ℤ)) + (n ν % (L ν : ℤ) + 1) := by
            linarith
          have hdiv_eq : (n ν + 1) / (L ν : ℤ) = n ν / (L ν : ℤ) := by
            rw [hnp1, Int.mul_add_ediv_left _ _ hL_ne, Int.ediv_eq_zero_of_lt hrem_nn hrem_lt,
              add_zero]
          rw [hdiv_eq, sub_self]
      · rw [if_neg hν]
        have hstep_val : (n + zdStep μ) ν = n ν := by simp [hν]
        rw [hstep_val, sub_self]
    have hsum_diff :
        (∑ ν : Fin d, (((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) * P ν) -
        (∑ ν : Fin d, ((n ν / (L ν : ℤ) : ℤ) : ℝ) * P ν) =
          δ μ (torusCoverProj n) := by
      rw [← Finset.sum_sub_distrib]
      have hterm_eq : ∀ ν : Fin d,
          (((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) * P ν -
            ((n ν / (L ν : ℤ) : ℤ) : ℝ) * P ν =
          if ν = μ then δ μ (torusCoverProj (L := L) n) else 0 := by
        intro ν
        have he := h_ediv ν
        by_cases hν : ν = μ
        · subst hν
          rw [if_pos rfl] at he
          rw [if_pos rfl]
          have h1 : (((n + zdStep ν) ν / (L ν : ℤ) : ℤ) : ℝ) * P ν -
              ((n ν / (L ν : ℤ) : ℤ) : ℝ) * P ν =
              ((((n + zdStep ν) ν / (L ν : ℤ) : ℤ) : ℝ) -
                ((n ν / (L ν : ℤ) : ℤ) : ℝ)) * P ν := by ring
          rw [h1, he]
          by_cases hlast : ((torusCoverProj (L := L) n) ν).val = L ν - 1
          · simp [δ, hlast]
          · simp [δ, hlast]
        · rw [if_neg hν] at he ⊢
          have h1 : (((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) * P ν -
              ((n ν / (L ν : ℤ) : ℤ) : ℝ) * P ν =
              ((((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) -
                ((n ν / (L ν : ℤ) : ℤ) : ℝ)) * P ν := by ring
          rw [h1, he, zero_mul]
      simp_rw [hterm_eq]
      simp
    have hΦ0_here : Φ0 (torusCoverProj (L := L) n + torusStep μ) - Φ0 (torusCoverProj (L := L) n) =
        ω μ (torusCoverProj (L := L) n) - δ μ (torusCoverProj (L := L) n) :=
      hΦ0 μ (torusCoverProj (L := L) n)
    calc
      Φ0 (torusCoverProj n + torusStep μ) + ∑ ν : Fin d, (((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) * P ν -
          (Φ0 (torusCoverProj n) + ∑ ν : Fin d, ((n ν / (L ν : ℤ) : ℤ) : ℝ) * P ν)
          = (Φ0 (torusCoverProj n + torusStep μ) - Φ0 (torusCoverProj n)) +
              ((∑ ν : Fin d, (((n + zdStep μ) ν / (L ν : ℤ) : ℤ) : ℝ) * P ν) -
               (∑ ν : Fin d, ((n ν / (L ν : ℤ) : ℤ) : ℝ) * P ν)) := by ring
      _ = (ω μ (torusCoverProj n) - δ μ (torusCoverProj n)) + δ μ (torusCoverProj n) := by
            rw [hΦ0_here, hsum_diff]
      _ = ω μ (torusCoverProj n) := by ring
  have hfiber_diff : ∀ n m : Fin d → ℤ, torusCoverProj (L := L) n = torusCoverProj (L := L) m →
      ∃ q : Fin d → ℤ, Φ_cov m - Φ_cov n = ∑ μ : Fin d, (q μ : ℝ) * P μ := by
    intro n m hnm
    refine ⟨fun μ => (m μ / (L μ : ℤ)) - (n μ / (L μ : ℤ)), ?_⟩
    dsimp [Φ_cov]
    rw [hnm]
    calc
      (Φ0 (torusCoverProj m) + ∑ μ : Fin d, ((m μ / (L μ : ℤ) : ℤ) : ℝ) * P μ) -
          (Φ0 (torusCoverProj m) + ∑ μ : Fin d, ((n μ / (L μ : ℤ) : ℤ) : ℝ) * P μ)
          = (∑ μ : Fin d, ((m μ / (L μ : ℤ) : ℤ) : ℝ) * P μ) -
              (∑ μ : Fin d, ((n μ / (L μ : ℤ) : ℤ) : ℝ) * P μ) := by ring
      _ = ∑ μ : Fin d, (((m μ / (L μ : ℤ) : ℤ) : ℝ) * P μ -
            ((n μ / (L μ : ℤ) : ℤ) : ℝ) * P μ) := (Finset.sum_sub_distrib _ _).symm
      _ = ∑ μ : Fin d, (((m μ / (L μ : ℤ) - n μ / (L μ : ℤ) : ℤ) : ℝ) * P μ) := by
            refine Finset.sum_congr rfl (fun μ _ => ?_)
            push_cast; ring
  have hshift_eμ : ∀ μ : Fin d,
      let n0 : Fin d → ℤ := fun _ => 0
      let nL : Fin d → ℤ := fun ν => if ν = μ then (L μ : ℤ) else 0
      torusCoverProj (L := L) n0 = torusCoverProj (L := L) nL ∧
        Φ_cov nL - Φ_cov n0 = P μ := by
    intro μ n0 nL
    refine ⟨?_, ?_⟩
    · ext ν
      by_cases hν : ν = μ
      · subst hν; simp [torusCoverProj, n0, nL]
      · simp [torusCoverProj, n0, nL, hν]
    · have hcov_eq : torusCoverProj (L := L) nL = torusCoverProj (L := L) n0 := by
        ext ν; by_cases hν : ν = μ
        · subst hν; simp [torusCoverProj, n0, nL]
        · simp [torusCoverProj, n0, nL, hν]
      dsimp [Φ_cov]
      rw [hcov_eq]
      have hL_pos : (0 : ℤ) < (L μ : ℤ) := Int.natCast_pos.mpr (NeZero.pos (L μ))
      have hsum0 : (∑ ν : Fin d, ((n0 ν / (L ν : ℤ) : ℤ) : ℝ) * P ν) = 0 := by
        simp [n0]
      have hsumL : (∑ ν : Fin d, ((nL ν / (L ν : ℤ) : ℤ) : ℝ) * P ν) = P μ := by
        have hterm : ∀ ν : Fin d,
            ((nL ν / (L ν : ℤ) : ℤ) : ℝ) * P ν = if ν = μ then P μ else 0 := by
          intro ν
          by_cases hν : ν = μ
          · subst hν
            simp [nL, Int.ediv_self (ne_of_gt hL_pos)]
          · simp [nL, hν]
        simp_rw [hterm]
        simp
      rw [hsum0, hsumL]
      ring
  refine ⟨Φ_cov, hzd, ?_, ?_, ?_⟩
  · have heqv := luscher_weyl_action_descends_iff_zero_gauge_coboundary torusCoverProj
      torusCoverProj_surjective W_inv Φ_cov
    dsimp only at heqv
    rw [heqv]
    constructor
    · intro hcob μ
      obtain ⟨hcov, hdiff⟩ := hshift_eμ μ
      have h0 := hcob (fun _ => 0) (fun ν => if ν = μ then (L μ : ℤ) else 0) hcov
      linarith
    · intro hP0 n m hnm
      rcases hfiber_diff n m hnm with ⟨q, hq⟩
      rw [hq]
      refine Finset.sum_eq_zero (fun μ _ => ?_)
      dsimp [P]
      rw [hP0 μ, mul_zero]
  · rw [← fiberCompatible_iff_existsUnique_descend torusCoverProj
      (fun n => Complex.exp (Complex.I * (Φ_cov n : ℂ))) torusCoverProj_surjective]
    constructor
    · intro hcompat μ
      obtain ⟨hcov, hdiff⟩ := hshift_eμ μ
      have hexp : Complex.exp (Complex.I * (Φ_cov (fun _ => 0) : ℂ)) =
          Complex.exp (Complex.I * (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ)) :=
        hcompat hcov
      rw [Complex.exp_eq_exp_iff_exists_int] at hexp
      rcases hexp with ⟨k, hk⟩
      have hdiff_c : Complex.I * (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ) -
          Complex.I * (Φ_cov (fun _ => 0) : ℂ) =
          -(2 * Real.pi * Complex.I * (k : ℂ)) := by
        rw [hk]; ring
      have hlhs : Complex.I * ((P μ : ℝ) : ℂ) =
          Complex.I * ((-2 * Real.pi * (k : ℝ) : ℝ) : ℂ) := by
        have h1 : (P μ : ℂ) =
            (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ) -
              (Φ_cov (fun _ => 0) : ℂ) := by
          exact_mod_cast hdiff.symm
        rw [h1, mul_sub, hdiff_c]
        push_cast; ring
      have hr : P μ = 2 * Real.pi * ((-k : ℤ) : ℝ) := by
        have hc := mul_left_cancel₀ Complex.I_ne_zero hlhs
        have hrr := Complex.ofReal_injective hc
        push_cast; linarith
      exact ⟨-k, hr⟩
    · intro h2pi n m hnm
      rcases hfiber_diff n m hnm with ⟨q, hq⟩
      have hsum_k : ∃ K : ℤ, Φ_cov m - Φ_cov n = 2 * Real.pi * (K : ℝ) := by
        choose k hk using h2pi
        refine ⟨∑ μ : Fin d, q μ * k μ, ?_⟩
        rw [hq]
        push_cast
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun μ _ => ?_)
        dsimp [P] at hk ⊢
        rw [hk μ]
        ring
      rcases hsum_k with ⟨K, hK⟩
      have hm_eq : Complex.I * (Φ_cov m : ℂ) =
          Complex.I * (Φ_cov n : ℂ) + (K : ℂ) * (2 * Real.pi * Complex.I) := by
        have hc : (Φ_cov m : ℂ) = (Φ_cov n : ℂ) + 2 * Real.pi * (K : ℂ) := by
          exact_mod_cast (show Φ_cov m = Φ_cov n + 2 * Real.pi * (K : ℝ) by linarith)
        rw [hc]
        ring
      symm
      rw [Complex.exp_eq_exp_iff_exists_int]
      exact ⟨K, hm_eq⟩
  · rw [← fiberCompatible_iff_existsUnique_descend torusCoverProj
      (fun n => Complex.exp (-(W_inv (torusCoverProj n) + Complex.I * (Φ_cov n : ℂ))))
      torusCoverProj_surjective]
    constructor
    · intro hcompat μ
      obtain ⟨hcov, hdiff⟩ := hshift_eμ μ
      have hexp := hcompat hcov
      dsimp only at hexp
      rw [← hcov] at hexp
      have hsplit : ∀ a : ℂ, ∀ b : ℝ,
          Complex.exp (-(a + Complex.I * (b : ℂ))) =
            Complex.exp (-a) * Complex.exp (-(Complex.I * (b : ℂ))) := fun a b => by
        rw [← Complex.exp_add]; congr 1; ring
      rw [hsplit, hsplit] at hexp
      have hinv_ne : Complex.exp (-W_inv (torusCoverProj (fun _ => 0))) ≠ 0 :=
        Complex.exp_ne_zero _
      have hphase := mul_left_cancel₀ hinv_ne hexp
      rw [Complex.exp_eq_exp_iff_exists_int] at hphase
      rcases hphase with ⟨k, hk⟩
      have hlhs : Complex.I * ((P μ : ℝ) : ℂ) =
          Complex.I * ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ) := by
        have h1 : (P μ : ℂ) =
            (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ) -
              (Φ_cov (fun _ => 0) : ℂ) := by
          exact_mod_cast hdiff.symm
        have h2 : -(Complex.I * (Φ_cov (fun _ => 0) : ℂ)) -
            (-(Complex.I * (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ))) =
            2 * Real.pi * Complex.I * (k : ℂ) := by
          rw [hk]; ring
        rw [h1, mul_sub]
        calc
          Complex.I * (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ) -
              Complex.I * (Φ_cov (fun _ => 0) : ℂ)
              = -(Complex.I * (Φ_cov (fun _ => 0) : ℂ)) -
                  (-(Complex.I * (Φ_cov (fun ν => if ν = μ then (L μ : ℤ) else 0) : ℂ))) := by ring
          _ = 2 * Real.pi * Complex.I * (k : ℂ) := h2
          _ = Complex.I * ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ) := by push_cast; ring
      have hr : P μ = 2 * Real.pi * (k : ℝ) :=
        Complex.ofReal_injective (mul_left_cancel₀ Complex.I_ne_zero hlhs)
      exact ⟨k, hr⟩
    · intro h2pi n m hnm
      rcases hfiber_diff n m hnm with ⟨q, hq⟩
      choose k hk using h2pi
      let K : ℤ := ∑ μ : Fin d, q μ * k μ
      have hK : Φ_cov m - Φ_cov n = 2 * Real.pi * (K : ℝ) := by
        rw [hq]
        dsimp [K]
        push_cast
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun μ _ => ?_)
        dsimp [P] at hk ⊢
        rw [hk μ]
        ring
      dsimp only
      rw [hnm]
      symm
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨-K, ?_⟩
      have hc : (Φ_cov m : ℂ) = (Φ_cov n : ℂ) + 2 * Real.pi * (K : ℂ) := by
        exact_mod_cast (show Φ_cov m = Φ_cov n + 2 * Real.pi * (K : ℝ) by linarith)
      rw [hc]
      push_cast
      ring

/-! ## Section 3. `P-ALI-01` → `QuotientDescent` Chiral Sector Theorem & Crisp `[X]` Boundary -/

section SmoothChiralSector

open scoped ContDiff

/-- Explicit `[X]`-tagged remaining continuum/finite-`a` open obligations in Obligation 3A
(`h2d_chiral_global_coboundary_admissibility_removal`), keeping finite-`a` nonzero Berry curvature,
infinite-volume sector gluing, and admissibility cutoff removal strictly separated from `[C/B/S]`
exactness theorems. `[X]` -/
structure H2dChiralGlobalExactnessPremise
    {E M U_adm : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [TopologicalSpace M] [ChartedSpace E M]
    [IsManifold 𝓘(ℝ, E) ∞ M]
    (π : U_adm → M) (Φ_anom : U_adm → ℝ)
    (berryForm : C1OneForm (E := E) (M := M)) where
  /-- `[X]`: Continuum / counterterm-cancelled vanishing of Lüscher lattice Berry curvature
  (`O(a)` lattice Berry curvature artifacts are NOT identically zero at finite `a` without solving
  local counterterms). -/
  finite_a_berry_curvature_cancelled : ClosedPeriods berryForm
  /-- `[X]`: Infinite-volume sector-gluing compatibility lifting the global `P-ALI-01` potential `V`
  across all admissible gauge fibres modulo `2πℤ`. -/
  infinite_volume_sector_phase_glued :
    ∀ V : M → ℝ, (∀ x, mvfderiv 𝓘(ℝ, E) V x = berryForm x) →
      ∀ u : U_adm, ∃ k : ℤ, Φ_anom u - V (π u) = 2 * Real.pi * (k : ℝ)

/-- **General `U(1)` Phase & Euclidean Boltzmann Weight `QuotientDescent` Equivalence (`[C/B/P]`)**:
On any surjective gauge-orbit projection `π : U_adm → OrbitSpace` and Weyl action
`W_eff(u) = W_inv(π u) + i Φ_anom(u)`, both the `U(1)` phase `exp(i Φ_anom)` and the Euclidean
weight `exp(-W_eff)` descend uniquely through `π` **if and only if** the gauge-fibre phase anomaly
`Φ_anom(u') - Φ_anom(u)` lies in `2πℤ` on every gauge fibre `π u = π u'`.
When `Φ_anom(u') - Φ_anom(u) = 0` (`hcob = 0`), `W_eff` itself descends uniquely via
`luscher_weyl_action_descends_iff_zero_gauge_coboundary`. `[C/B/P]` -/
theorem chiral_u1_phase_and_boltzmann_quotient_descent_iff
    {U_adm OrbitSpace : Type*}
    (π : U_adm → OrbitSpace) (hπ : Surjective π)
    (W_inv : OrbitSpace → ℂ) (Φ_anom : U_adm → ℝ) :
    ((∃! Z_bar : OrbitSpace → ℂ,
        Z_bar ∘ π = fun u => Complex.exp (Complex.I * (Φ_anom u : ℂ))) ↔
      (∀ u u' : U_adm, π u = π u' → ∃ k : ℤ, Φ_anom u' - Φ_anom u = 2 * Real.pi * (k : ℝ))) ∧
    ((∃! E_bar : OrbitSpace → ℂ,
        E_bar ∘ π = fun u => Complex.exp (-(W_inv (π u) + Complex.I * (Φ_anom u : ℂ)))) ↔
      (∀ u u' : U_adm, π u = π u' → ∃ k : ℤ, Φ_anom u' - Φ_anom u = 2 * Real.pi * (k : ℝ))) ∧
    ((∃! W_bar : OrbitSpace → ℂ,
        W_bar ∘ π = fun u => W_inv (π u) + Complex.I * (Φ_anom u : ℂ)) ↔
      (∀ u u' : U_adm, π u = π u' → Φ_anom u' - Φ_anom u = 0)) := by
  have hZ : (∃! Z_bar : OrbitSpace → ℂ,
      Z_bar ∘ π = fun u => Complex.exp (Complex.I * (Φ_anom u : ℂ))) ↔
      (∀ u u' : U_adm, π u = π u' → ∃ k : ℤ, Φ_anom u' - Φ_anom u = 2 * Real.pi * (k : ℝ)) := by
    rw [← fiberCompatible_iff_existsUnique_descend π
      (fun u => Complex.exp (Complex.I * (Φ_anom u : ℂ))) hπ]
    constructor
    · intro hcompat u u' hπ_eq
      have hexp : Complex.exp (Complex.I * (Φ_anom u : ℂ)) =
          Complex.exp (Complex.I * (Φ_anom u' : ℂ)) := hcompat hπ_eq
      rw [Complex.exp_eq_exp_iff_exists_int] at hexp
      rcases hexp with ⟨k, hk⟩
      have hlhs : Complex.I * ((Φ_anom u' - Φ_anom u : ℝ) : ℂ) =
          Complex.I * ((-2 * Real.pi * (k : ℝ) : ℝ) : ℂ) := by
        have h1 : Complex.I * (Φ_anom u : ℂ) - Complex.I * (Φ_anom u' : ℂ) =
            (k : ℂ) * (2 * Real.pi * Complex.I) := by
          rw [hk]; ring
        push_cast
        calc
          Complex.I * ((Φ_anom u' : ℂ) - (Φ_anom u : ℂ))
              = -(Complex.I * (Φ_anom u : ℂ) - Complex.I * (Φ_anom u' : ℂ)) := by ring
          _ = -((k : ℂ) * (2 * Real.pi * Complex.I)) := by rw [h1]
          _ = Complex.I * (-2 * Real.pi * (k : ℂ)) := by ring
      have hr : Φ_anom u' - Φ_anom u = 2 * Real.pi * ((-k : ℤ) : ℝ) := by
        have hrr := Complex.ofReal_injective (mul_left_cancel₀ Complex.I_ne_zero hlhs)
        push_cast; linarith
      exact ⟨-k, hr⟩
    · intro h2pi u u' hπ_eq
      rcases h2pi u u' hπ_eq with ⟨k, hk⟩
      symm
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨k, ?_⟩
      have hc : (Φ_anom u' : ℂ) = (Φ_anom u : ℂ) + 2 * Real.pi * (k : ℂ) := by
        exact_mod_cast (show Φ_anom u' = Φ_anom u + 2 * Real.pi * (k : ℝ) by linarith)
      rw [hc]
      ring
  have hE : (∃! E_bar : OrbitSpace → ℂ,
      E_bar ∘ π = fun u => Complex.exp (-(W_inv (π u) + Complex.I * (Φ_anom u : ℂ)))) ↔
      (∀ u u' : U_adm, π u = π u' → ∃ k : ℤ, Φ_anom u' - Φ_anom u = 2 * Real.pi * (k : ℝ)) := by
    rw [← fiberCompatible_iff_existsUnique_descend π
      (fun u => Complex.exp (-(W_inv (π u) + Complex.I * (Φ_anom u : ℂ)))) hπ]
    constructor
    · intro hcompat u u' hπ_eq
      have hexp := hcompat hπ_eq
      dsimp only at hexp
      rw [hπ_eq] at hexp
      have hsplit : ∀ a : ℂ, ∀ b : ℝ,
          Complex.exp (-(a + Complex.I * (b : ℂ))) =
            Complex.exp (-a) * Complex.exp (-(Complex.I * (b : ℂ))) := fun a b => by
        rw [← Complex.exp_add]; congr 1; ring
      rw [hsplit, hsplit] at hexp
      have hphase := mul_left_cancel₀ (Complex.exp_ne_zero _) hexp
      rw [Complex.exp_eq_exp_iff_exists_int] at hphase
      rcases hphase with ⟨k, hk⟩
      have hlhs : Complex.I * ((Φ_anom u' - Φ_anom u : ℝ) : ℂ) =
          Complex.I * ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ) := by
        have h1 : -(Complex.I * (Φ_anom u : ℂ)) - (-(Complex.I * (Φ_anom u' : ℂ))) =
            (k : ℂ) * (2 * Real.pi * Complex.I) := by
          rw [hk]; ring
        push_cast
        calc
          Complex.I * ((Φ_anom u' : ℂ) - (Φ_anom u : ℂ))
              = -(Complex.I * (Φ_anom u : ℂ)) - (-(Complex.I * (Φ_anom u' : ℂ))) := by ring
          _ = (k : ℂ) * (2 * Real.pi * Complex.I) := h1
          _ = Complex.I * (2 * Real.pi * (k : ℂ)) := by ring
      exact ⟨k, Complex.ofReal_injective (mul_left_cancel₀ Complex.I_ne_zero hlhs)⟩
    · intro h2pi u u' hπ_eq
      rcases h2pi u u' hπ_eq with ⟨k, hk⟩
      dsimp only
      rw [hπ_eq]
      symm
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨-k, ?_⟩
      have hc : (Φ_anom u' : ℂ) = (Φ_anom u : ℂ) + 2 * Real.pi * (k : ℂ) := by
        exact_mod_cast (show Φ_anom u' = Φ_anom u + 2 * Real.pi * (k : ℝ) by linarith)
      rw [hc]
      push_cast
      ring
  exact ⟨hZ, hE, luscher_weyl_action_descends_iff_zero_gauge_coboundary π hπ W_inv Φ_anom⟩

/-- **`P-ALI-01` → `QuotientDescent` Chiral Sector Theorem (`[C/B/S/P]` + explicit `[X]`)**:
Connects Core's `UEOT.V3.AlignmentGlobalExactness.p_ali_01` (`[C]`),
`UEOT.V3.Compression.QuotientDescent` (`[C]`), and `luscher_weyl_action_descends_iff_zero_gauge_coboundary`
(`[B/P]`):
1. (`[C]`): On any connected smooth gauge-orbit sector `M`, a `C¹` Berry-connection 1-form
   `berryForm` is globally exact (`IsExactForm berryForm`) **iff** `ClosedPeriods berryForm` holds.
2. (`[C/B/S]`): If `ClosedPeriods berryForm` holds on `M` and along a surjective gauge-orbit
   projection `π : U_adm → M`, `Φ_anom` tracks the resulting `P-ALI-01` potential `V : M → ℝ`
   modulo `2πℤ` (`∀ u, ∃ k : ℤ, Φ_anom u - V (π u) = 2 * Real.pi * (k : ℝ)`), then BOTH the
   `U(1)` phase `exp(i Φ_anom)` and the Euclidean Weyl weight `exp(-W_eff)` descend uniquely to `M`;
   if in addition the `2πℤ` winding vanishes (`∀ u, Φ_anom u = V (π u)`), then `W_eff` itself
   descends uniquely (`hcob = 0`).
3. (`[C/B/S/X]`): Under the explicit `[X]` premise `H2dChiralGlobalExactnessPremise π Φ_anom berryForm`
   (absorbing finite-`a` Berry curvature counterterms and infinite-volume sector gluing), `P-ALI-01`
   automatically supplies the global `V : M → ℝ` and drives unique `QuotientDescent` of `exp(i Φ_anom)`
   and `exp(-W_eff)` on `M`. -/
theorem p_ali_01_quotient_descent_chiral_sector_theorem
    {E M U_adm : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [TopologicalSpace M] [ChartedSpace E M]
    [IsManifold 𝓘(ℝ, E) ∞ M] [ConnectedSpace M]
    (π : U_adm → M) (hπ : Surjective π)
    (W_inv : M → ℂ) (Φ_anom : U_adm → ℝ)
    (berryForm : C1OneForm (E := E) (M := M)) :
    (IsExactForm berryForm ↔ ClosedPeriods berryForm) ∧
    (ClosedPeriods berryForm →
      (∀ V : M → ℝ, (∀ x, mvfderiv 𝓘(ℝ, E) V x = berryForm x) →
        ∀ u : U_adm, ∃ k : ℤ, Φ_anom u - V (π u) = 2 * Real.pi * (k : ℝ)) →
      (∃! Z_bar : M → ℂ, Z_bar ∘ π = fun u => Complex.exp (Complex.I * (Φ_anom u : ℂ))) ∧
      (∃! E_bar : M → ℂ,
        E_bar ∘ π = fun u => Complex.exp (-(W_inv (π u) + Complex.I * (Φ_anom u : ℂ))))) ∧
    (ClosedPeriods berryForm →
      (∀ V : M → ℝ, (∀ x, mvfderiv 𝓘(ℝ, E) V x = berryForm x) →
        ∀ u : U_adm, Φ_anom u = V (π u)) →
      (∃! W_bar : M → ℂ,
        W_bar ∘ π = fun u => W_inv (π u) + Complex.I * (Φ_anom u : ℂ))) ∧
    (Nonempty (H2dChiralGlobalExactnessPremise π Φ_anom berryForm) →
      (∃! Z_bar : M → ℂ, Z_bar ∘ π = fun u => Complex.exp (Complex.I * (Φ_anom u : ℂ))) ∧
      (∃! E_bar : M → ℂ,
        E_bar ∘ π = fun u => Complex.exp (-(W_inv (π u) + Complex.I * (Φ_anom u : ℂ))))) := by
  have hpali : IsExactForm berryForm ↔ ClosedPeriods berryForm := p_ali_01 berryForm
  have hmod2pi :
      ClosedPeriods berryForm →
      (∀ V : M → ℝ, (∀ x, mvfderiv 𝓘(ℝ, E) V x = berryForm x) →
        ∀ u : U_adm, ∃ k : ℤ, Φ_anom u - V (π u) = 2 * Real.pi * (k : ℝ)) →
      (∃! Z_bar : M → ℂ, Z_bar ∘ π = fun u => Complex.exp (Complex.I * (Φ_anom u : ℂ))) ∧
      (∃! E_bar : M → ℂ,
        E_bar ∘ π = fun u => Complex.exp (-(W_inv (π u) + Complex.I * (Φ_anom u : ℂ)))) := by
    intro hper htrack
    rcases hpali.mpr hper with ⟨V, _hVdiff, hdV⟩
    have hfiber : ∀ u u' : U_adm, π u = π u' →
        ∃ k : ℤ, Φ_anom u' - Φ_anom u = 2 * Real.pi * (k : ℝ) := by
      intro u u' hπ_eq
      rcases htrack V hdV u with ⟨k, hk⟩
      rcases htrack V hdV u' with ⟨k', hk'⟩
      refine ⟨k' - k, ?_⟩
      have hVeq : V (π u') = V (π u) := by rw [hπ_eq]
      push_cast
      linarith
    have hq := chiral_u1_phase_and_boltzmann_quotient_descent_iff π hπ W_inv Φ_anom
    exact ⟨hq.1.mpr hfiber, hq.2.1.mpr hfiber⟩
  have hadd :
      ClosedPeriods berryForm →
      (∀ V : M → ℝ, (∀ x, mvfderiv 𝓘(ℝ, E) V x = berryForm x) →
        ∀ u : U_adm, Φ_anom u = V (π u)) →
      (∃! W_bar : M → ℂ,
        W_bar ∘ π = fun u => W_inv (π u) + Complex.I * (Φ_anom u : ℂ)) := by
    intro hper htrack
    rcases hpali.mpr hper with ⟨V, _hVdiff, hdV⟩
    have hcob : ∀ u u' : U_adm, π u = π u' → Φ_anom u' - Φ_anom u = 0 := by
      intro u u' hπ_eq
      rw [htrack V hdV u', htrack V hdV u, hπ_eq, sub_self]
    exact (luscher_weyl_action_descends_iff_zero_gauge_coboundary π hπ W_inv Φ_anom).mpr hcob
  refine ⟨hpali, hmod2pi, hadd, ?_⟩
  rintro ⟨hX⟩
  exact hmod2pi hX.finite_a_berry_curvature_cancelled hX.infinite_volume_sector_phase_glued

end SmoothChiralSector

/-- **Round 03 `DEAD-20261124-12` Sharpening & Three-Regime Witness on `ZMod L × ZMod L` (`[C/B/P]`)**:
1. On `ZMod L1 × ZMod L2` (`[NeZero L1] [NeZero L2]`), Round 03's constant flat cochain
   `ω_const(c) = (c, 0)` is a global coboundary `d₀ Φ` **if and only if** `(L1 : ℝ) * c = 0`
   (i.e. `c = 0`), sharpening `torus_flat_cochain_nonzero_holonomy_not_coboundary`.
2. On the 1D/2D `L = 2` torus cover `ℤ → ZMod 2`, the three flat holonomy regimes are cleanly
   separated:
   - `c = 0` (`P = 0`): both `W_eff` and `exp(i Φ_cov)` descend uniquely;
   - `c = Real.pi` (`P = 2π ∈ 2πℤ \ {0}`): `exp(i Φ_cov)` and `exp(-W_eff)` descend uniquely while
     additive `W_eff` does NOT descend;
   - `c = Real.pi / 2` (`P = π ∉ 2πℤ`, Round 03's `luscher_flat_fibre_nonzero_holonomy_blocks_quotient_descent`):
     neither `W_eff` nor `exp(i Φ_cov)` descends. -/
theorem round03_torus_holonomy_sharpening_and_three_regime_witness
    (L1 L2 : ℕ) [NeZero L1] [NeZero L2] (c : ℝ) (W_inv : DiscreteTorus 1 (fun _ => 2) → ℂ) :
    ((∃ Φ : ZMod L1 → ZMod L2 → ℝ,
        (∀ x y, c = Φ (x + 1) y - Φ x y) ∧
        (∀ x y, (0 : ℝ) = Φ x (y + 1) - Φ x y)) ↔ c = 0) ∧
    (∃ Φ_2pi : (Fin 1 → ℤ) → ℝ,
      (∀ n, zdD0 Φ_2pi 0 n = Real.pi) ∧
      ¬ (∃! W_bar : DiscreteTorus 1 (fun _ => 2) → ℂ,
          W_bar ∘ torusCoverProj = fun n => W_inv (torusCoverProj n) + Complex.I * (Φ_2pi n : ℂ)) ∧
      (∃! Z_bar : DiscreteTorus 1 (fun _ => 2) → ℂ,
          Z_bar ∘ torusCoverProj = fun n => Complex.exp (Complex.I * (Φ_2pi n : ℂ))) ∧
      (∃! E_bar : DiscreteTorus 1 (fun _ => 2) → ℂ,
          E_bar ∘ torusCoverProj = fun n =>
            Complex.exp (-(W_inv (torusCoverProj n) + Complex.I * (Φ_2pi n : ℂ))))) ∧
    (∃ Φ_pi : (Fin 1 → ℤ) → ℝ,
      (∀ n, zdD0 Φ_pi 0 n = Real.pi / 2) ∧
      ¬ (∃! W_bar : DiscreteTorus 1 (fun _ => 2) → ℂ,
          W_bar ∘ torusCoverProj = fun n => W_inv (torusCoverProj n) + Complex.I * (Φ_pi n : ℂ)) ∧
      ¬ (∃! Z_bar : DiscreteTorus 1 (fun _ => 2) → ℂ,
          Z_bar ∘ torusCoverProj = fun n => Complex.exp (Complex.I * (Φ_pi n : ℂ)))) := by
  have hsharp :
      (∃ Φ : ZMod L1 → ZMod L2 → ℝ,
        (∀ x y, c = Φ (x + 1) y - Φ x y) ∧
        (∀ x y, (0 : ℝ) = Φ x (y + 1) - Φ x y)) ↔ c = 0 := by
    rw [← discrete_2d_torus_flat_cochain_coboundary_iff_zero_polyakov L1 L2
      (fun _ _ => c) (fun _ _ => 0)]
    have hL1_ne : (L1 : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne L1)
    constructor
    · rintro ⟨_, hx, _⟩
      have hsum : (∑ _x : ZMod L1, c) = (L1 : ℝ) * c := by simp
      rw [hsum] at hx
      exact (mul_eq_zero.mp hx).resolve_left hL1_ne
    · intro hc
      subst hc
      refine ⟨fun _ _ => by ring, by simp, by simp⟩
  let L2_1d : Fin 1 → ℕ := fun _ => 2
  have _hNeZ1 : ∀ μ : Fin 1, NeZero (L2_1d μ) := fun _ => ⟨by decide⟩
  let ω_2pi : Fin 1 → DiscreteTorus 1 L2_1d → ℝ := fun _ _ => Real.pi
  have hflat_2pi : ∀ μ ν x, torusD1 ω_2pi μ ν x = 0 := by
    intro μ ν x; unfold torusD1 ω_2pi; ring
  have hP_2pi : polyakovSum ω_2pi 0 0 = 2 * Real.pi := by
    unfold polyakovSum ω_2pi
    simp [L2_1d]
  obtain ⟨Φ_2pi, hzd_2pi, hW_2pi, hZ_2pi, hE_2pi⟩ :=
    universal_cover_zd_primitive_and_u1_phase_descent_iff 1 L2_1d ω_2pi hflat_2pi W_inv
  have hnoW_2pi : ¬ (∃! W_bar : DiscreteTorus 1 L2_1d → ℂ,
      W_bar ∘ torusCoverProj = fun n => W_inv (torusCoverProj n) + Complex.I * (Φ_2pi n : ℂ)) := by
    rw [hW_2pi]
    intro h0
    have hp := h0 0
    rw [hP_2pi] at hp
    linarith [Real.pi_pos]
  have hyesZ_2pi : ∃! Z_bar : DiscreteTorus 1 L2_1d → ℂ,
      Z_bar ∘ torusCoverProj = fun n => Complex.exp (Complex.I * (Φ_2pi n : ℂ)) := by
    rw [hZ_2pi]
    intro μ
    rw [Fin.eq_zero μ]
    exact ⟨1, by rw [hP_2pi]; push_cast; ring⟩
  have hyesE_2pi : ∃! E_bar : DiscreteTorus 1 L2_1d → ℂ,
