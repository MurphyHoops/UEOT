/-! ## Part 1: Tomboulis–Yaffe `Z_N` Center-Vortex Free-Energy Inequality & Dual Area Law (`[C/B/P]`) -/

/-- Center-vortex / twist free-energy density `f_vortex = -(1 / Area) log(Z_twist / Z)`. `[B/P]` -/
noncomputable def vortexFreeEnergyDensity (Z_twist Z area : ℝ) : ℝ :=
  -(Real.log (Z_twist / Z)) / area

/-- `Z_N` electric-flux dual partition weight (`k ∈ ZMod N`) obtained by discrete Fourier transform
over magnetic center twists `Z_mag : ZMod N → ℝ`. `[B/P]` -/
noncomputable def znElectricFluxWeight (N : ℕ) [NeZero N] (Z_mag : ZMod N → ℝ) (k : ZMod N) : ℂ :=
  (1 / (N : ℂ)) * ∑ m : ZMod N,
    Complex.exp (-2 * Real.pi * Complex.I * ((k.val * m.val : ℕ) : ℂ) / (N : ℂ)) * (Z_mag m : ℂ)

/-- Real `Z_2` electric-flux twist ratio `(Z_0 - Z_1) / (Z_0 + Z_1)` measuring magnetic vortex disorder. `[B/P]` -/
noncomputable def z2ElectricFluxRatio (Z0 Z1 : ℝ) : ℝ :=
  (Z0 - Z1) / (Z0 + Z1)

private lemma toEuclideanLin_apply_toLp' {N : ℕ} (T : Matrix (Fin N) (Fin N) ℝ) (x : Fin N → ℝ) :
    (Matrix.toEuclideanLin T) (WithLp.toLp 2 x) = WithLp.toLp 2 (T.mulVec x) := by
  ext i
  rfl

private lemma toEuclideanLin_pow' {N : ℕ} (T : Matrix (Fin N) (Fin N) ℝ) :
    ∀ n : ℕ, Matrix.toEuclideanLin (T ^ n) = (Matrix.toEuclideanLin T) ^ n
  | 0 => by
      ext x i
      have hx : x = WithLp.toLp 2 x.ofLp := rfl
      rw [hx, pow_zero, pow_zero, toEuclideanLin_apply_toLp', Matrix.one_mulVec]
      rfl
  | n + 1 => by
      have ih := toEuclideanLin_pow' T n
      rw [pow_succ, pow_succ]
      ext x i
      have hx : x = WithLp.toLp 2 x.ofLp := rfl
      rw [hx]
      change ((Matrix.toEuclideanLin (T ^ n * T)) (WithLp.toLp 2 x.ofLp)).ofLp i =
        (((Matrix.toEuclideanLin T) ^ n) ((Matrix.toEuclideanLin T) (WithLp.toLp 2 x.ofLp))).ofLp i
      rw [toEuclideanLin_apply_toLp', toEuclideanLin_apply_toLp', ← Matrix.mulVec_mulVec,
        ← toEuclideanLin_apply_toLp' (T ^ n) (T.mulVec x.ofLp), ih]

private lemma inner_toLp_eq_dotProduct' {N : ℕ} (x y : Fin N → ℝ) :
    inner ℝ (WithLp.toLp 2 x : EuclideanSpace ℝ (Fin N)) (WithLp.toLp 2 y) = dotProduct x y := by
  rw [PiLp.inner_apply]
  unfold dotProduct
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp [mul_comm]

private lemma isSymmetric_toEuclideanLin {N : ℕ} (T : Matrix (Fin N) (Fin N) ℝ)
    (hSymm : Tᵀ = T) : (Matrix.toEuclideanLin T).IsSymmetric := by
  intro x y
  change inner ℝ (Matrix.toEuclideanLin T x) y = inner ℝ x (Matrix.toEuclideanLin T y)
  have hx : x = WithLp.toLp 2 x.ofLp := rfl
  have hy : y = WithLp.toLp 2 y.ofLp := rfl
  rw [hx, hy, toEuclideanLin_apply_toLp', toEuclideanLin_apply_toLp',
    inner_toLp_eq_dotProduct', inner_toLp_eq_dotProduct']
  calc dotProduct (T.mulVec x.ofLp) y.ofLp
      = dotProduct y.ofLp (T.mulVec x.ofLp) := dotProduct_comm _ _
    _ = dotProduct (y.ofLp ᵥ* T) x.ofLp := dotProduct_mulVec _ _ _
    _ = dotProduct (y.ofLp ᵥ* Tᵀ) x.ofLp := by rw [hSymm]
    _ = dotProduct (T.mulVec y.ofLp) x.ofLp := by rw [Matrix.vecMul_transpose]
    _ = dotProduct x.ofLp (T.mulVec y.ofLp) := dotProduct_comm _ _

private lemma matrix_trace_eq_sum_orthonormal_inner {N : ℕ}
    (M : Matrix (Fin N) (Fin N) ℝ) (hSymm : Mᵀ = M)
    (b : OrthonormalBasis (Fin N) ℝ (EuclideanSpace ℝ (Fin N))) :
    Matrix.trace M = ∑ i : Fin N, inner ℝ (b i) ((Matrix.toEuclideanLin M) (b i)) := by
  let A := Matrix.toEuclideanLin M
  have hA : A.IsSymmetric := isSymmetric_toEuclideanLin M hSymm
  let e : Fin N → EuclideanSpace ℝ (Fin N) :=
    fun k => WithLp.toLp 2 (fun j => if j = k then (1 : ℝ) else 0)
  have he_inner : ∀ k : Fin N, ∀ v : EuclideanSpace ℝ (Fin N),
      inner ℝ (e k) v = v.ofLp k := by
    intro k v
    have hv : v = WithLp.toLp 2 v.ofLp := rfl
    rw [hv]
    dsimp [e]
    rw [inner_toLp_eq_dotProduct']
    simp [dotProduct]
  have hdiag : ∀ k : Fin N, M k k = inner ℝ (e k) (A (e k)) := by
    intro k
    have hAe : A (e k) = WithLp.toLp 2 (M.mulVec (fun j => if j = k then (1 : ℝ) else 0)) :=
      toEuclideanLin_apply_toLp' M _
    rw [he_inner k (A (e k)), hAe]
    simp [Matrix.mulVec, dotProduct]
  calc Matrix.trace M
      = ∑ k : Fin N, M k k := rfl
    _ = ∑ k : Fin N, inner ℝ (e k) (A (e k)) :=
        Finset.sum_congr rfl (fun k _ => hdiag k)
    _ = ∑ k : Fin N, ∑ i : Fin N, inner ℝ (e k) (b i) * inner ℝ (b i) (A (e k)) := by
        refine Finset.sum_congr rfl (fun k _ => ?_)
        exact (b.sum_inner_mul_inner (e k) (A (e k))).symm
    _ = ∑ i : Fin N, ∑ k : Fin N, inner ℝ (e k) (b i) * inner ℝ (e k) (A (b i)) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun k _ => ?_))
        have hsym : inner ℝ (b i) (A (e k)) = inner ℝ (e k) (A (b i)) := by
          rw [← hA (b i) (e k), real_inner_comm]
        rw [hsym]
    _ = ∑ i : Fin N, inner ℝ (b i) (A (b i)) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        have hterm : ∀ k : Fin N,
            inner ℝ (e k) (b i) * inner ℝ (e k) (A (b i)) =
              (b i).ofLp k * (A (b i)).ofLp k := by
          intro k; rw [he_inner k (b i), he_inner k (A (b i))]
        simp_rw [hterm]
        have hbi : b i = WithLp.toLp 2 (b i).ofLp := rfl
        have hAbi : A (b i) = WithLp.toLp 2 (A (b i)).ofLp := rfl
        conv_rhs => rw [hbi, hAbi, inner_toLp_eq_dotProduct']
        rfl

private lemma trace_pow_le_of_loewner_le {N : ℕ}
    (T_a T_b : Matrix (Fin N) (Fin N) ℝ)
    (ha_symm : T_aᵀ = T_a) (hb_symm : T_bᵀ = T_b)
    (ha_psd : ∀ v : Fin N → ℝ, 0 ≤ dotProduct v (T_a.mulVec v))
    (hle : ∀ v : Fin N → ℝ, dotProduct v (T_a.mulVec v) ≤ dotProduct v (T_b.mulVec v))
    (m : ℕ) :
    Matrix.trace (T_a ^ m) ≤ Matrix.trace (T_b ^ m) := by
  cases m with
  | zero => simp
  | succ m =>
    have hn : Module.finrank ℝ (EuclideanSpace ℝ (Fin N)) = N := finrank_euclideanSpace_fin
    let A := Matrix.toEuclideanLin T_a
    let B := Matrix.toEuclideanLin T_b
    have hA_symm : A.IsSymmetric := isSymmetric_toEuclideanLin T_a ha_symm
    have hB_symm : B.IsSymmetric := isSymmetric_toEuclideanLin T_b hb_symm
    let ea : OrthonormalBasis (Fin N) ℝ (EuclideanSpace ℝ (Fin N)) := hA_symm.eigenvectorBasis hn
    let eb : OrthonormalBasis (Fin N) ℝ (EuclideanSpace ℝ (Fin N)) := hB_symm.eigenvectorBasis hn
    let α : Fin N → ℝ := hA_symm.eigenvalues hn
    let β : Fin N → ℝ := hB_symm.eigenvalues hn
    have hdiagA : ∀ (i : Fin N) (x : EuclideanSpace ℝ (Fin N)),
        inner ℝ (ea i) (A x) = α i * inner ℝ (ea i) x := fun i x => by
      simpa [ea, α, OrthonormalBasis.repr_apply_apply] using
        hA_symm.eigenvectorBasis_apply_self_apply hn x i
    have hdiagB : ∀ (j : Fin N) (x : EuclideanSpace ℝ (Fin N)),
        inner ℝ (eb j) (B x) = β j * inner ℝ (eb j) x := fun j x => by
      simpa [eb, β, OrthonormalBasis.repr_apply_apply] using
        hB_symm.eigenvectorBasis_apply_self_apply hn x j
    have hdiagA_pow : ∀ (k : ℕ) (i : Fin N) (x : EuclideanSpace ℝ (Fin N)),
        inner ℝ (ea i) ((A ^ k) x) = (α i) ^ k * inner ℝ (ea i) x := by
      intro k i x
      induction k with
      | zero => simp
      | succ k ih =>
          rw [pow_succ', Module.End.mul_apply, hdiagA i ((A ^ k) x), ih, pow_succ']
          ring
    have hdiagB_pow : ∀ (k : ℕ) (j : Fin N) (x : EuclideanSpace ℝ (Fin N)),
        inner ℝ (eb j) ((B ^ k) x) = (β j) ^ k * inner ℝ (eb j) x := by
      intro k j x
      induction k with
      | zero => simp
      | succ k ih =>
          rw [pow_succ', Module.End.mul_apply, hdiagB j ((B ^ k) x), ih, pow_succ']
          ring
    have hα_nn : ∀ i : Fin N, 0 ≤ α i := by
      intro i
      have h1 : inner ℝ (ea i) (A (ea i)) = α i := by
        rw [hdiagA i (ea i), real_inner_self_eq_norm_sq, ea.orthonormal.1 i, one_pow, mul_one]
      have h2 : inner ℝ (ea i) (A (ea i)) = dotProduct (ea i).ofLp (T_a.mulVec (ea i).ofLp) := by
        have hbi : ea i = WithLp.toLp 2 (ea i).ofLp := rfl
        conv_lhs => rw [hbi]; dsimp [A]; rw [toEuclideanLin_apply_toLp', inner_toLp_eq_dotProduct']
      linarith [ha_psd (ea i).ofLp]
    have hβ_nn : ∀ j : Fin N, 0 ≤ β j := by
      intro j
      have h1 : inner ℝ (eb j) (B (eb j)) = β j := by
        rw [hdiagB j (eb j), real_inner_self_eq_norm_sq, eb.orthonormal.1 j, one_pow, mul_one]
      have h2 : inner ℝ (eb j) (B (eb j)) = dotProduct (eb j).ofLp (T_b.mulVec (eb j).ofLp) := by
        have hbj : eb j = WithLp.toLp 2 (eb j).ofLp := rfl
        conv_lhs => rw [hbj]; dsimp [B]; rw [toEuclideanLin_apply_toLp', inner_toLp_eq_dotProduct']
      have hpsdB : 0 ≤ dotProduct (eb j).ofLp (T_b.mulVec (eb j).ofLp) :=
        le_trans (ha_psd (eb j).ofLp) (hle (eb j).ofLp)
      linarith
    have ha_pow_symm : (T_a ^ (m + 1))ᵀ = T_a ^ (m + 1) := by
      induction (m + 1) with
      | zero => simp
      | succ k ih =>
          rw [pow_succ, Matrix.transpose_mul, ih, ha_symm,
            (Commute.pow_right (Commute.refl T_a) k).eq, ← pow_succ]
    have hb_pow_symm : (T_b ^ (m + 1))ᵀ = T_b ^ (m + 1) := by
      induction (m + 1) with
      | zero => simp
      | succ k ih =>
          rw [pow_succ, Matrix.transpose_mul, ih, hb_symm,
            (Commute.pow_right (Commute.refl T_b) k).eq, ← pow_succ]
    have htrA : Matrix.trace (T_a ^ (m + 1)) = ∑ i : Fin N, (α i) ^ (m + 1) := by
      rw [matrix_trace_eq_sum_orthonormal_inner (T_a ^ (m + 1)) ha_pow_symm ea]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [toEuclideanLin_pow' T_a (m + 1)]
      change inner ℝ (ea i) ((A ^ (m + 1)) (ea i)) = (α i) ^ (m + 1)
      rw [hdiagA_pow (m + 1) i (ea i), real_inner_self_eq_norm_sq, ea.orthonormal.1 i, one_pow, mul_one]
    have htrB : Matrix.trace (T_b ^ (m + 1)) = ∑ j : Fin N, (β j) ^ (m + 1) := by
      rw [matrix_trace_eq_sum_orthonormal_inner (T_b ^ (m + 1)) hb_pow_symm eb]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [toEuclideanLin_pow' T_b (m + 1)]
      change inner ℝ (eb j) ((B ^ (m + 1)) (eb j)) = (β j) ^ (m + 1)
      rw [hdiagB_pow (m + 1) j (eb j), real_inner_self_eq_norm_sq, eb.orthonormal.1 j, one_pow, mul_one]
    rw [htrA, htrB]
    have hstep1 : ∑ i : Fin N, (α i) ^ (m + 1) ≤
        ∑ i : Fin N, (inner ℝ (ea i) (B (ea i))) ^ (m + 1) := by
      refine Finset.sum_le_sum (fun i _ => ?_)
      have hα_le : α i ≤ inner ℝ (ea i) (B (ea i)) := by
        have h1 : inner ℝ (ea i) (A (ea i)) = α i := by
          rw [hdiagA i (ea i), real_inner_self_eq_norm_sq, ea.orthonormal.1 i, one_pow, mul_one]
        have h2 : inner ℝ (ea i) (A (ea i)) = dotProduct (ea i).ofLp (T_a.mulVec (ea i).ofLp) := by
          have hbi : ea i = WithLp.toLp 2 (ea i).ofLp := rfl
          conv_lhs => rw [hbi]; dsimp [A]; rw [toEuclideanLin_apply_toLp', inner_toLp_eq_dotProduct']
        have h3 : inner ℝ (ea i) (B (ea i)) = dotProduct (ea i).ofLp (T_b.mulVec (ea i).ofLp) := by
          have hbi : ea i = WithLp.toLp 2 (ea i).ofLp := rfl
          conv_lhs => rw [hbi]; dsimp [B]; rw [toEuclideanLin_apply_toLp', inner_toLp_eq_dotProduct']
        linarith [hle (ea i).ofLp]
      exact pow_le_pow_left₀ (hα_nn i) hα_le (m + 1)
    have hstep2 : ∑ i : Fin N, (inner ℝ (ea i) (B (ea i))) ^ (m + 1) ≤
        ∑ i : Fin N, ∑ j : Fin N, (inner ℝ (ea i) (eb j)) ^ 2 * (β j) ^ (m + 1) := by
      refine Finset.sum_le_sum (fun i _ => ?_)
      have hparseval : inner ℝ (ea i) (B (ea i)) =
          ∑ j : Fin N, (inner ℝ (ea i) (eb j)) ^ 2 * β j := by
        rw [← eb.sum_inner_mul_inner (ea i) (B (ea i))]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hdiagB j (ea i), real_inner_comm (eb j) (ea i)]
        ring
      have hsum_w : ∑ j : Fin N, (inner ℝ (ea i) (eb j)) ^ 2 = 1 := by
        have h1 := eb.sum_sq_inner_right (ea i)
        have hnorm : ‖ea i‖ ^ 2 = 1 := by rw [ea.orthonormal.1 i, one_pow]
        rw [hnorm] at h1
        exact (Finset.sum_congr rfl (fun j _ => by rw [real_inner_comm])).trans h1
      have hconv := (convexOn_pow (m + 1)).map_sum_le
        (t := Finset.univ)
        (w := fun j => (inner ℝ (ea i) (eb j)) ^ 2)
        (p := β)
        (fun j _ => sq_nonneg _)
        hsum_w
        (fun j _ => hβ_nn j)
      simpa [hparseval, smul_eq_mul] using hconv
    have hstep3 : (∑ i : Fin N, ∑ j : Fin N, (inner ℝ (ea i) (eb j)) ^ 2 * (β j) ^ (m + 1)) =
        ∑ j : Fin N, (β j) ^ (m + 1) := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← Finset.sum_mul]
      have hsum_e : ∑ i : Fin N, (inner ℝ (ea i) (eb j)) ^ 2 = 1 := by
        have h1 := ea.sum_sq_inner_right (eb j)
        have hnorm : ‖eb j‖ ^ 2 = 1 := by rw [eb.orthonormal.1 j, one_pow]
        rw [hnorm] at h1
        exact (Finset.sum_congr rfl (fun i _ => by rw [real_inner_comm])).trans h1
      rw [hsum_e, one_mul]
    exact le_trans hstep1 (le_trans hstep2 hstep3.le)

/-- **Tomboulis–Yaffe Reflection-Positive Chessboard & Center-Vortex Free-Energy Inequality (`[C/B/P]`)**:
1. **RP Chessboard Sub-Unitarity (`[C/B]`)**: For any reflection-positive pair functional `F : ℕ → ℕ → ℝ`
   satisfying Cauchy–Schwarz `F a b ^ 2 ≤ F a a * F b b` and `Z_2` center-reflection identity
   `F 1 1 = F 0 0` (`Z_0 = F 0 0 > 0`, `Z_tw = F 0 1 ≥ 0`), `Z_tw ≤ Z_0`, `Z_tw / Z_0 ≤ 1`, and for
   `Z_tw > 0`, `0 ≤ vortexFreeEnergyDensity Z_tw Z_0 area` (`area > 0`).
2. **Non-Commutative Loewner Transfer Trace Inequality (`[C/B/P]`)**: For any finite-rank symmetric PSD
   untwisted transfer matrix `T_0` and twisted transfer matrix `T_tw` satisfying
   `0 ≤ ⟨v, T_tw v⟩ ≤ exp(-σ_vortex) ⟨v, T_0 v⟩` (`σ_vortex ≥ 0`) with `0 < Tr(T_0 ^ Area)`,
   we have **without assuming `[T_0, T_tw] = 0`**:
   `Tr(T_tw ^ Area) ≤ exp(-σ_vortex * Area) * Tr(T_0 ^ Area)`,
   hence `Z_twist / Z ≤ exp(-σ_vortex * Area)` and (when `0 < Tr(T_tw ^ Area)`, `Area ≥ 1`)
   `σ_vortex ≤ vortexFreeEnergyDensity (Tr(T_tw ^ Area)) (Tr(T_0 ^ Area)) Area`.
3. **Free-Energy Monotonicity under Block Doubling (`[C/B]`)**: If `Z_tw(m)^2 ≤ Z_0(m) * Z_tw(2*m)`
   or normalized twisted ratios are submultiplicative `R(A + B) ≤ R(A) * R(B)` (`R(1) ≤ exp(-σ_vortex)`),
   then `R(Area) ≤ exp(-σ_vortex * Area)` and `σ_vortex ≤ -(log (R Area)) / Area` for all `Area ≥ 1`. -/
theorem tomboulis_yaffe_rp_chessboard_vortex_inequality :
    (∀ (F : ℕ → ℕ → ℝ),
      (∀ a : ℕ, 0 ≤ F a a) →
      (∀ a b : ℕ, F a b ^ 2 ≤ F a a * F b b) →
      F 1 1 = F 0 0 →
      0 < F 0 0 →
      0 ≤ F 0 1 →
      F 0 1 ≤ F 0 0 ∧
      F 0 1 / F 0 0 ≤ 1 ∧
      (0 < F 0 1 → ∀ area : ℝ, 0 < area → 0 ≤ vortexFreeEnergyDensity (F 0 1) (F 0 0) area)) ∧
    (∀ {n : ℕ} (T_0 T_tw : Matrix (Fin n) (Fin n) ℝ) (σ_vortex : ℝ) (Area : ℕ),
      T_0ᵀ = T_0 →
      T_twᵀ = T_tw →
      0 ≤ σ_vortex →
      (∀ v : Fin n → ℝ, 0 ≤ dotProduct v (T_tw.mulVec v)) →
      (∀ v : Fin n → ℝ, dotProduct v (T_tw.mulVec v) ≤
        Real.exp (-σ_vortex) * dotProduct v (T_0.mulVec v)) →
      0 < Matrix.trace (T_0 ^ Area) →
      Matrix.trace (T_tw ^ Area) ≤ Real.exp (-σ_vortex * (Area : ℝ)) * Matrix.trace (T_0 ^ Area) ∧
      Matrix.trace (T_tw ^ Area) / Matrix.trace (T_0 ^ Area) ≤ Real.exp (-σ_vortex * (Area : ℝ)) ∧
      (0 < Matrix.trace (T_tw ^ Area) → 1 ≤ Area →
        σ_vortex ≤ vortexFreeEnergyDensity (Matrix.trace (T_tw ^ Area)) (Matrix.trace (T_0 ^ Area)) Area)) ∧
    (∀ (R : ℕ → ℝ) (σ_vortex : ℝ),
      (∀ m : ℕ, 0 < R m) →
      (∀ a b : ℕ, R (a + b) ≤ R a * R b) →
      R 1 ≤ Real.exp (-σ_vortex) →
      ∀ Area : ℕ, 1 ≤ Area →
        R Area ≤ Real.exp (-σ_vortex * (Area : ℝ)) ∧
        σ_vortex ≤ -(Real.log (R Area)) / (Area : ℝ)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro F _hF_nn hCS hZ2 hF00 hF01
    have hsq : F 0 1 ^ 2 ≤ F 0 0 ^ 2 := by
      have h := hCS 0 1
      rwa [hZ2, ← sq] at h
    have hle : F 0 1 ≤ F 0 0 := (abs_le_of_sq_le_sq' hsq (le_of_lt hF00)).2
    have hdiv : F 0 1 / F 0 0 ≤ 1 := (div_le_one hF00).mpr hle
    refine ⟨hle, hdiv, fun hpos area harea => ?_⟩
    have hratio_pos : 0 < F 0 1 / F 0 0 := div_pos hpos hF00
    have hlog_le : Real.log (F 0 1 / F 0 0) ≤ 0 := Real.log_nonpos (le_of_lt hratio_pos) hdiv
    dsimp [vortexFreeEnergyDensity]
    exact div_nonneg (neg_nonneg.mpr hlog_le) (le_of_lt harea)
  · intro n T_0 T_tw σ_vortex Area hT0_symm hTtw_symm _hσ hTtw_psd hLoew hZ0_pos
    let ρ : ℝ := Real.exp (-σ_vortex)
    have hρ_pos : 0 < ρ := Real.exp_pos _
    let T_b : Matrix (Fin n) (Fin n) ℝ := ρ • T_0
    have hTb_symm : T_bᵀ = T_b := by
      simp [T_b, hT0_symm]
    have hle_b : ∀ v : Fin n → ℝ, dotProduct v (T_tw.mulVec v) ≤ dotProduct v (T_b.mulVec v) := by
      intro v
      have hmul : T_b.mulVec v = ρ • T_0.mulVec v := by
        dsimp [T_b]
        ext i; simp [Matrix.mulVec, dotProduct, Finset.mul_sum, mul_assoc]
      rw [hmul, dotProduct_smul, smul_eq_mul]
      exact hLoew v
    have htr := trace_pow_le_of_loewner_le T_tw T_b hTtw_symm hTb_symm hTtw_psd hle_b Area
    have hpow_b : T_b ^ Area = (ρ ^ Area) • (T_0 ^ Area) := by
      dsimp [T_b]
      rw [smul_pow]
    have htr_b : Matrix.trace (T_b ^ Area) = Real.exp (-σ_vortex * (Area : ℝ)) * Matrix.trace (T_0 ^ Area) := by
      rw [hpow_b, Matrix.trace_smul, smul_eq_mul]
      congr 1
      dsimp [ρ]
      rw [← Real.exp_nat_mul]
      congr 1; ring
    rw [htr_b] at htr
    have hratio : Matrix.trace (T_tw ^ Area) / Matrix.trace (T_0 ^ Area) ≤
        Real.exp (-σ_vortex * (Area : ℝ)) := by
      exact (div_le_iff₀ hZ0_pos).mpr htr
    refine ⟨htr, hratio, fun hZtw_pos hArea1 => ?_⟩
    have hratio_pos : 0 < Matrix.trace (T_tw ^ Area) / Matrix.trace (T_0 ^ Area) :=
      div_pos hZtw_pos hZ0_pos
    have hlog : Real.log (Matrix.trace (T_tw ^ Area) / Matrix.trace (T_0 ^ Area)) ≤
        -σ_vortex * (Area : ℝ) := by
      have h1 := Real.log_le_log hratio_pos hratio
      rwa [Real.log_exp] at h1
    have hArea_pos : (0 : ℝ) < (Area : ℝ) := by exact_mod_cast (by omega : 0 < Area)
    dsimp [vortexFreeEnergyDensity]
    rw [le_div_iff₀ hArea_pos]
    linarith
  · intro R σ_vortex hR_pos hsub hR1 Area hArea1
    have hpow_le : ∀ m : ℕ, 1 ≤ m → R m ≤ Real.exp (-σ_vortex * (m : ℝ)) := by
      intro m hm
      induction m with
      | zero => omega
      | succ k ih =>
          cases k with
          | zero =>
              simpa using hR1
          | succ k =>
              have hk1 : 1 ≤ k + 1 := by omega
              have ihk := ih hk1
              have h1 := hsub (k + 1) 1
              have hprod : R (k + 1) * R 1 ≤ Real.exp (-σ_vortex * ((k + 1 : ℕ) : ℝ)) * Real.exp (-σ_vortex) :=
                mul_le_mul ihk hR1 (le_of_lt (hR_pos 1)) (le_of_lt (Real.exp_pos _))
              have hexp : Real.exp (-σ_vortex * ((k + 1 : ℕ) : ℝ)) * Real.exp (-σ_vortex) =
                  Real.exp (-σ_vortex * ((k + 1 + 1 : ℕ) : ℝ)) := by
                rw [← Real.exp_add]
                congr 1
                push_cast
                ring
              exact le_trans h1 (hprod.trans_eq hexp)
    have hbd := hpow_le Area hArea1
    refine ⟨hbd, ?_⟩
    have hlog : Real.log (R Area) ≤ -σ_vortex * (Area : ℝ) := by
      have h1 := Real.log_le_log (hR_pos Area) hbd
      rwa [Real.log_exp] at h1
    have hArea_pos : (0 : ℝ) < (Area : ℝ) := by exact_mod_cast (by omega : 0 < Area)
    rw [le_div_iff₀ hArea_pos]
    linarith

/-- **Electric–Magnetic `Z_N` Confinement Dual Dichotomy (`[C/B/P]`)**:
1. **`Z_N` Magnetic Disorder ⇒ Dual Electric-Flux Suppression (`[C/B/P]`)**:
   For `N ≥ 2`, if magnetic center-twist partition functions satisfy `Z_mag m ≤ Z_mag 0` and
   `Z_mag 0 - Z_mag m ≤ δ_v * Z_mag 0` (`0 ≤ δ_v < 1`, magnetic disorder), then the `Z_N` electric-flux
   dual weights `znElectricFluxWeight N Z_mag k` (`k ≠ 0`) satisfy `‖znElectricFluxWeight N Z_mag k‖ ≤ δ_v * Z_mag 0`
   (and for `N = 2`, `z2ElectricFluxRatio (Z_mag 0) (Z_mag 1) ≤ δ_v`).
2. **Center-Vortex Disorder (`σ_vortex > 0`) ⇒ Wilson Area Law & Glueball Mass Gap (`[C/B/P]`)**:
   Whenever `Z_twist A / Z A ≤ exp(-σ_vortex * A)` (`σ_vortex > 0`) and Wilson loops obey the
   Tomboulis–Yaffe vortex-disorder bound `|W_loop R T| ≤ C_W * (Z_twist (R * T) / Z (R * T))`,
   the Wilson loop satisfies the area law `|W_loop R T| ≤ C_W * exp(-σ_vortex * (R * T))` with
   strictly positive string tension `σ_vortex > 0`; moreover any symmetric PSD transfer matrix `T_glue`
   with leading eigenvector `v_0` (`T_glue v_0 = λ_0 v_0`) and orthogonal-complement spectral bound
   `λ_1 / λ_0 ≤ exp(-σ_vortex)` has a strictly positive glueball mass gap `0 < spectralRatioGap λ_0 λ_1`
   bounded below by `σ_vortex` (when `λ_1 > 0`, and arbitrary `m_any > 0` when `λ_1 = 0`).
3. **Dual Deconfinement / Magnetic-Order Counter-Regime (`[C/B/P]`)**:
   Conversely, in `Z_2` magnetic order (`Z_mag_ord 1 n / Z_mag_ord 0 n ≤ exp(-σ_mag * n)` with
   `σ_mag > 0`), `z2ElectricFluxRatio (Z_mag_ord 0 n) (Z_mag_ord 1 n) → 1` as `n → ∞`, ruling out
   exponential electric-flux decay `≤ exp(-σ_el * n)` for any `σ_el > 0`. -/
theorem zn_electric_magnetic_confinement_dual_dichotomy :
    (∀ (N : ℕ) [NeZero N] (_hN : 2 ≤ N) (Z_mag : ZMod N → ℝ) (δ_v : ℝ),
      0 < Z_mag 0 → 0 ≤ δ_v → δ_v < 1 →
      (∀ m : ZMod N, 0 ≤ Z_mag m ∧ Z_mag m ≤ Z_mag 0 ∧ Z_mag 0 - Z_mag m ≤ δ_v * Z_mag 0) →
      (∀ k : ZMod N, k ≠ 0 → ‖znElectricFluxWeight N Z_mag k‖ ≤ δ_v * Z_mag 0) ∧
      (1 - δ_v) * Z_mag 0 ≤ (znElectricFluxWeight N Z_mag 0).re) ∧
    (∀ (Z_twist Z : ℕ → ℝ) (W_loop : ℕ → ℕ → ℝ) {C_W σ_vortex : ℝ},
      0 ≤ C_W → 0 < σ_vortex →
      (∀ A : ℕ, 0 < Z A) →
      (∀ A : ℕ, Z_twist A / Z A ≤ Real.exp (-σ_vortex * (A : ℝ))) →
      (∀ R T : ℕ, |W_loop R T| ≤ C_W * (Z_twist (R * T) / Z (R * T))) →
      (∀ R T : ℕ, |W_loop R T| ≤ C_W * Real.exp (-σ_vortex * ((R * T : ℕ) : ℝ))) ∧
      (∀ {M : ℕ} (T_glue : Matrix (Fin M) (Fin M) ℝ) (v_0 : Fin M → ℝ) {lam_0 lam_1 : ℝ},
        T_glueᵀ = T_glue →
        (∀ v : Fin M → ℝ, 0 ≤ dotProduct v (T_glue.mulVec v)) →
        dotProduct v_0 v_0 = 1 →
        0 < lam_0 → 0 ≤ lam_1 → lam_1 < lam_0 →
        lam_1 / lam_0 ≤ Real.exp (-σ_vortex) →
        T_glue.mulVec v_0 = lam_0 • v_0 →
