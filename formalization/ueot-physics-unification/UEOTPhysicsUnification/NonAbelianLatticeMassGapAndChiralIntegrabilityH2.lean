/-- **Constructive DS-to-Clustering Bridge Lemma (`[C/B/P]`)**:
Whenever physical correlators `C_n n dist` are dominated at `dist ≥ 0` by separated block
covariances `|covProb (P.μ_seq n) F G|` with block separation `d ≥ max 1 ⌈dist⌉` and
`totalOsc F * globalOsc G ≤ A_cluster`, `Round05IRZegarlinskiPremise P` (`0 < P.γ_DS_unif < 1`)
automatically yields `uniform_clustering` with `Delta_phys = (-Real.log P.γ_DS_unif) / P.R_blk > 0`. -/
theorem ir_zegarlinski_finite_range_feeds_uniform_clustering
    {Q : Type} [Fintype Q] [Nonempty Q]
    (P : Round05IRZegarlinskiPremise Q) (hγ_pos : 0 < P.γ_DS_unif)
    (C_n : ℕ → ℝ → ℝ) (A_cluster : ℝ)
    (hdom : ∀ (n : ℕ) (dist : ℝ), 0 ≤ dist →
      ∃ (F G : (Fin (P.M_seq n) → Q) → ℝ) (A B : Finset (Fin (P.M_seq n))) (d : ℕ),
        (∀ i ∉ A, blockOsc F i = 0) ∧
        (∀ j ∉ B, blockOsc G j = 0) ∧
        1 ≤ d ∧ dist ≤ (d : ℝ) ∧
        (∀ a ∈ A, ∀ b ∈ B, d ≤ P.dist_seq n a b) ∧
        totalOsc F * globalOsc G ≤ A_cluster ∧
        |C_n n dist| ≤ |covProb (P.μ_seq n) F G|) :
    let m_phys : ℝ := (-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)
    0 < m_phys ∧
    ∀ (n : ℕ) (dist : ℝ), 0 ≤ dist →
      |C_n n dist| ≤ A_cluster * Real.exp (-m_phys * dist) := by
  have hbr := (round05_ir_zegarlinski_conditional_bridge P).2.2.2.2.2.1 hγ_pos
  refine ⟨hbr.1, fun n dist hdist => ?_⟩
  rcases hdom n dist hdist with ⟨F, G, A, B, d, hF, hG, hd1, hd_ge, hsep, hosc, hcov⟩
  have hds := hbr.2 n F G A B d hF hG hd1 hsep
  have hexp_mono : Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * (d : ℝ)) ≤
      Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * dist) := by
    apply Real.exp_le_exp.mpr
    have hm_nn : 0 ≤ (-Real.log P.γ_DS_unif) / (P.R_blk : ℝ) := le_of_lt hbr.1
    nlinarith
  have hprod : totalOsc F * globalOsc G *
      Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * (d : ℝ)) ≤
      A_cluster * Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * dist) := by
    have h1 : totalOsc F * globalOsc G *
        Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * (d : ℝ)) ≤
        A_cluster * Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * (d : ℝ)) :=
      mul_le_mul_of_nonneg_right hosc (le_of_lt (Real.exp_pos _))
    have hA_nn : 0 ≤ A_cluster :=
      le_trans (mul_nonneg (Finset.sum_nonneg (fun i _ => blockOsc_nonneg F i)) (globalOsc_nonneg G)) hosc
    have h2 : A_cluster * Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * (d : ℝ)) ≤
        A_cluster * Real.exp (-((-Real.log P.γ_DS_unif) / (P.R_blk : ℝ)) * dist) :=
      mul_le_mul_of_nonneg_left hexp_mono hA_nn
    exact h1.trans h2
  exact hcov.trans (hds.trans hprod)

/-- Direct `[C/B/P]` projection from `Round06IRTrackBundle` into `H2dIRContext`,
deriving `c_loc = c_P_ref * exp(2 * B_blk)` and `hlocal` constructively via Holley–Stroock. -/
noncomputable def irTrackToIRContext (B : Round06IRTrackBundle) : H2dIRContext where
  M_ir := B.irDS.M_seq B.m_ref_idx
  Q_ir := B.Q_ir
  fintypeQ_ir := B.fintypeQ_ir
  μ_ir := B.irDS.μ_seq B.m_ref_idx
  hμ_ir := B.irDS.μ_prob B.m_ref_idx
  μ_cond := condWeight (B.irDS.μ_seq B.m_ref_idx)
  w_cond := B.irDS.w_blk B.m_ref_idx
  c_loc := B.irDS.c_P_ref * Real.exp (2 * B.irDS.B_blk)
  hc_loc_nn := mul_nonneg (le_of_lt B.irDS.hcP_pos) (le_of_lt (Real.exp_pos _))
  hlocal := fun i x g => by
    rw [B.irDS.hcond_tilt B.m_ref_idx i x]
    exact (holley_stroock_bounded_perturbation_poincare_stability
      (B.irDS.μ_ref B.m_ref_idx i x) (B.irDS.V_blk B.m_ref_idx i x)
      (B.irDS.hμ_ref_prob B.m_ref_idx i x) (B.irDS.w_blk B.m_ref_idx i x)
      (B.irDS.hw_nn B.m_ref_idx i x) (B.irDS.hosc_blk B.m_ref_idx i x)
      (le_of_lt B.irDS.hcP_pos) (B.irDS.hsingle_ref B.m_ref_idx i x)).2.2.1 g
  N_uv := B.crossover.N_uv
  N_blk := B.crossover.N_blk
  V_uv := B.crossover.V_uv
  V_blk := B.crossover.V_blk
  V_test := B.crossover.V_test
  H_perp := B.crossover.H_perp
  addCommH := B.crossover.addCommH
  modH := B.crossover.modH
  Lambda := B.crossover.Lambda
  c_AF := B.crossover.c_AF
  ell_phys := B.crossover.ell_phys
  m_0 := B.crossover.m_0
  L_blk := B.crossover.L_blk
  hLam := B.crossover.hLam
  hcAF := B.crossover.hcAF
  hell := B.crossover.hell
