/-! ## Section 2. Minimal Irreducible `[X]` Core (`UV-X`, `IR-X`, `CHIRAL-X`) -/

/-- Faithful defect evaluator mapping the truth status of the three irreducible `[X]` pillars
(`UV-X`, `IR-X`, `CHIRAL-X`) to an `H2dObstructionCandidate`.
- When all three pillars are unproved (`False, False, False`), this equals `currentH2dRepoWitness := ⟨1, 1, 1⟩`.
- When all three pillars are inhabited, all three defects vanish (`⟨0, 0, 0⟩`).
- Dropping any single pillar leaves defect `1 ≠ 0` on that obligation and keeps `H2d` open. `[C/B]` -/
noncomputable def h2dPillarDefect (P : Prop) : ℝ :=
  @ite ℝ P (Classical.propDecidable P) 0 1

noncomputable def h2dEvaluatedCandidate (hUV hIR hChiral : Prop) : H2dObstructionCandidate where
  uvMultiscaleRGDefect := h2dPillarDefect hUV
  irUniformClusteringOSGapDefect := h2dPillarDefect hIR
  chiralGlobalCoboundaryAdmissibilityDefect := h2dPillarDefect hChiral

lemma h2dPillarDefect_eq_zero_iff (P : Prop) : h2dPillarDefect P = 0 ↔ P := by
  unfold h2dPillarDefect
  split_ifs with h
  · exact ⟨fun _ => h, fun _ => rfl⟩
  · exact ⟨fun h0 => by norm_num at h0, fun hp => absurd hp h⟩

lemma h2dPillarDefect_false : h2dPillarDefect False = 1 := by
  unfold h2dPillarDefect
  split_ifs with h
  · exact False.elim h
  · rfl

lemma h2dPillarDefect_true (P : Prop) (h : P) : h2dPillarDefect P = 0 :=
  (h2dPillarDefect_eq_zero_iff P).mpr h

