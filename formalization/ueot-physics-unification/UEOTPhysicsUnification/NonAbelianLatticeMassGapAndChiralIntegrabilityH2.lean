        linarith [Real.add_one_le_exp ((m_DW * (L5 : ℝ)) / 2)]
      have hlin_pos : 0 < 1 + (m_DW * (L5 : ℝ)) / 2 := by linarith
      have hsq : (1 + (m_DW * (L5 : ℝ)) / 2) ^ 2 ≤ Real.exp (m_DW * (L5 : ℝ)) := by
        have hexp2 : (Real.exp ((m_DW * (L5 : ℝ)) / 2)) ^ 2 = Real.exp (m_DW * (L5 : ℝ)) := by
