import UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.BrownianControlledInfiniteRewardSource
import UEOT.V3.DiffusionHJBVerification

/-!
Original commitment: original P-CTL ItoRun must be generated by the actual controlled source, not assumed as a field.
Existing result: fixed ownQ_A actual occupation/terminal law, discounted C2 identity, and positive-discount actual infinite reward limit are derived.
Premise reduced: construct ORIGINAL Model.ItoRun directly from these outputs; its generator must literally be the source differential operator.
Model/witness: scalar x0+σB, bounded original predictable actual action and SAME Q_A across all horizons, measurable reward bounded on allowed |a|≤K.
Consumer/boundary: original P-CTL verification now receives an actual source run; arbitrary unbounded/localized/vector/other-filter models remain separate obligations.
-/
namespace UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.BrownianControlledItoRunSource
open MeasureTheory ProbabilityTheory Set Filter
open BrownianTimeIntegrand BrownianPredictableInputs BrownianBoundedControlSource BrownianBoundedExponentialLimitSource
open BrownianBoundedC2DynkinSource BrownianControlledTestInput BrownianControlledDiscountSource BrownianControlledOccupationSource
open BrownianControlledInfiniteRewardSource BrownianControlledC2Source BrownianControlledDynkinSource
open scoped ENNReal NNReal Topology ProbabilityTheory MeasureTheory
noncomputable section

variable (A : ℝ≥0) (b : fullPredictableL2 A) (K : ℝ) (hK : 0≤K)
    (hB : ∀ᵐ p ∂inputLaw A, |(b : Lp ℝ 2 (inputLaw A)) p|≤K)
    (σ : ℝ) (M : UEOT.V3.DiffusionHJBVerification.Model ℝ ℝ)
    (hG : ∀ x a, M.generatorV x a=controlledGenerator σ M.V x a)
    (C₁ C₂ : ℝ) (hC₁ : 0≤C₁) (hC₂ : 0≤C₂)
    (hb₁ : ∀ x, ‖deriv M.V x‖≤C₁) (hb₂ : ∀ x, ‖iteratedDeriv 2 M.V x‖≤C₂)
    (hR : Measurable (fun z : ℝ × ℝ => M.reward z.1 z.2))
    (C : ℝ) (hReward : ∀ x a, ‖a‖≤K → ‖M.reward x a‖≤C)

include hK hReward in
private theorem reward_read_bound (x₀ : ℝ) (p : ℝ × (ℝ≥0 → ℝ)) :
    ‖M.reward (jointReadout A b K x₀ σ p).1 (jointReadout A b K x₀ σ p).2‖≤C :=
  hReward _ _ (control_bound A b K hK _ _)

/-- ORIGINAL ItoRun with every desired source field proved. The generator equality
is a structural operator restriction, while the stochastic/Dynkin/limit identities
are theorems of the actual source and are not supplied as assumptions. -/
def actualItoRun (x₀ : ℝ) : M.ItoRun x₀ where
  occupation := occupation A b K x₀ σ M.rho
  terminalLaw := terminalLaw A b x₀ σ
  terminal_prob := terminalLaw_probability A b K hK hB x₀ σ
  reward_integrable := fun U => occupation_integrable A b K hK hB x₀ σ M.rho M.rho_pos.le U
    (fun z => M.reward z.1 z.2) hR C (reward_read_bound A b K hK σ M C hReward x₀)
  drift_integrable := by
    intro U
    have hm : Measurable (fun z : ℝ × ℝ => controlledGenerator σ M.V z.1 z.2-M.rho*M.V z.1) :=
      (((measurable_const.mul measurable_snd).mul
        ((M.V_C2.continuous_deriv (by norm_num : (1 : WithTop ℕ∞)≤2)).measurable.comp measurable_fst)).add
        (measurable_const.mul ((M.V_C2.continuous_iteratedDeriv' 2).measurable.comp measurable_fst))).sub
        (measurable_const.mul (M.V_C2.continuous.measurable.comp measurable_fst))
    simp_rw [hG]
    apply occupation_integrable A b K hK hB x₀ σ M.rho M.rho_pos.le U _ hm
      (generatorBound K σ C₁ C₂+|M.rho| * M.VBound)
    intro p
    apply (norm_sub_le _ _).trans
    apply add_le_add (generator_point_bound A b K hK x₀ σ M.V C₁ C₂ hb₁ hb₂ _ _)
    rw [norm_mul,Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left (by simpa only [Real.norm_eq_abs] using M.V_bounded _) (abs_nonneg _)
  ito_expectation := by
    intro U
    simp_rw [hG]
    exact actual_discounted_occupation A b K hK hB x₀ σ M.rho M.rho_pos.le U M.V M.V_C2 C₁ C₂ hC₁ hC₂ hb₁ hb₂
      M.VBound (fun x => by simpa only [Real.norm_eq_abs] using M.V_bounded x)
  infiniteReward := infiniteReward A b K x₀ σ M.rho (fun z => M.reward z.1 z.2)
  reward_tendsto := actual_reward_tendsto A b K hK hB x₀ σ M.rho M.rho_pos _ hR C
    (reward_read_bound A b K hK σ M C hReward x₀)

/-- Native original verification consumes the returned actual run; no second
run is chosen and no normalization/reward limit is assumed. -/
theorem actual_reward_le_value (x₀ : ℝ) :
    (actualItoRun A b K hK hB σ M hG C₁ C₂ hC₁ hC₂ hb₁ hb₂ hR C hReward x₀).infiniteReward≤M.V x₀ :=
  UEOT.V3.DiffusionHJBVerification.Model.ItoRun.infiniteReward_le_value _

end
end UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.BrownianControlledItoRunSource
