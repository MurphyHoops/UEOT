import UEOT.V3.Compression.Objecthood.JointHomeostasis.RepairKernelBridge
import UEOT.V3.Compression.Objecthood.StationaryRepairBasin

/-!
# Theory Completion P5.1 — joint legitimate set and repair carrier

The joint homeostasis carrier must be strong enough to include physical states
that are still repairable and mutable organization states whose repair-program
representation still identifies the same intended internal program.  Stored
controller state is deliberately unrestricted: the RLSR safe kernel rewrites it
before selecting the physical action.

Physical support closure is inherited from the established stationary repair
basin; program closure follows from exact canonical re-encoding after every safe
step.  No new reachability or repair theorem is assumed.
-/

namespace UEOT.V3.Compression.Objecthood.JointHomeostasis

open Set MeasureTheory
open UEOT.V3.ViabilityKernel
open UEOT.V3.Compression.Objecthood
open UEOT.V3.Compression.Objecthood.RepairLawSelfReconstruction

universe uX uA uP uR

noncomputable section

/-- Exact same-program legitimate organization: physical state is in `K`, and
controller + program representation are the canonical organization generated by
one intended program `r`. -/
def jointLegitimate
    {X : Type uX} {A : Type uA}
    {Program : Type uP} {Representation : Type uR}
    (T : TrustedRepairSubstrate Program X A)
    (codec : TrustedRepairCodec Program Representation)
    (K : Set X) (r : Program) :
    Set (RepairOrganizationState X A Representation) :=
  SafeRecoveredTarget T codec K r

/-- Joint repair carrier for one intended program.  The physical coordinate has
finite expected return time under the reconstructed program, while the mutable
repair representation still decodes to that same program.  The stored
controller may be arbitrary. -/
def jointRepairCarrier
    {X : Type uX} {A : Type uA}
    {Program : Type uP} {Representation : Type uR}
    [Fintype X] [Fintype A]
    [MeasurableSpace X] [MeasurableSingletonClass X]
    (T : TrustedRepairSubstrate Program X A)
    (codec : TrustedRepairCodec Program Representation)
    (P : X → A → PMF X) (K : Set X) (r : Program) :
    Set (RepairOrganizationState X A Representation) :=
  {s | s.physical ∈ StationaryRepairBasin P K (T.execute r) ∧
    codec.decode s.repairProgram = r}

/-- Every exactly recovered joint-legitimate state lies in the broader repair
carrier whenever `r` is valid on the physical target. -/
theorem jointLegitimate_subset_jointRepairCarrier
    {X : Type uX} {A : Type uA}
    {Program : Type uP} {Representation : Type uR}
    [Fintype X] [Fintype A]
    [MeasurableSpace X] [MeasurableSingletonClass X]
    (T : TrustedRepairSubstrate Program X A)
    (codec : TrustedRepairCodec Program Representation)
    (P : X → A → PMF X) (K : Set X) (r : Program)
    (_hvalid : RepairProgramValid T P K r) :
    jointLegitimate T codec K r ⊆
      jointRepairCarrier T codec P K r := by
  intro s hs
  rcases hs with ⟨x, hxK, rfl⟩
  constructor
  · exact target_subset_stationaryRepairBasin P K (T.execute r) hxK
  · exact codec.decode_encode r

/-- The RLSR safe kernel preserves the full joint repair carrier.  Outside `K`
this is exactly stationary-repair-basin support closure; inside `K`, program
validity keeps the physical successor in `K`, which is itself contained in the
stationary repair basin.  Every successor is re-encoded canonically around `r`.
-/
theorem safeRepairKernel_stays_jointRepairCarrier
    {X : Type uX} {A : Type uA}
    {Program : Type uP} {Representation : Type uR}
    [Fintype X] [Fintype A]
    [MeasurableSpace X] [MeasurableSingletonClass X]
    (T : TrustedRepairSubstrate Program X A)
    (codec : TrustedRepairCodec Program Representation)
    (P : X → A → PMF X) (K : Set X) (r : Program)
    (hvalid : RepairProgramValid T P K r)
    {s : RepairOrganizationState X A Representation}
    (hs : s ∈ jointRepairCarrier T codec P K r) :
    StaysIn (safeRepairKernel T codec P s)
      (jointRepairCarrier T codec P K r) := by
  rcases hs with ⟨hxB, hdecode⟩
  rw [safeRepairKernel_eq_of_decode_eq T codec P r s hdecode]
  intro w hw
  rw [PMF.mem_support_map_iff] at hw
  rcases hw with ⟨y, hy, rfl⟩
  constructor
  · by_cases hxK : s.physical ∈ K
    · exact target_subset_stationaryRepairBasin P K (T.execute r)
        (hvalid s.physical hxK hy)
    · exact stationaryRepairBasin_support_closed
        P K (T.execute r) hxB hxK hy
  · exact codec.decode_encode r

end
end UEOT.V3.Compression.Objecthood.JointHomeostasis
