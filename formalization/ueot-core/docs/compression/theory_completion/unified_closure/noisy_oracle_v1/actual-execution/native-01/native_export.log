edClosure.NoisyFiniteRiskOracle.CalibrationGood P hN sample\n                    ↑u →\n                  ∀ (T : ℕ) (bad : UEOT.V3.PathError.CausalHistory Y (A × Y) T → Bool),\n                    ∀\n                      E ⊆\n                        UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.riskHistoryMap q (fun ax => (ax.1, q ax.2))\n                            T ⁻¹'\n                          {h | bad h = true},\n                      UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.NoisyFiniteRiskOracle.accepts program initial\n                            q fallbackX sample u tau beta T bad =\n                          true →\n                        ∀ (K : Set X),\n                          (∀ x ∈ p₀.support, x ∈ K) →\n                            (∀ (x : X) (a : A), x ∈ K → C x a → ∀ (z : X), R x a z → z ∈ K) →\n                              (UEOT.V3.PathError.causalLaw p₀\n                                          (UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.riskMicroControlKernel q\n                                            (fun x => P) program.toController.policy)\n                                          T).toMeasure.real\n                                    E ≤\n                                  ↑beta ∧\n                                (UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.FiniteMemoryPhysicalSafety.stateTrajMeasure\n                                      program.toController p₀ q fun x => P)\n                                    {ω | ∀ (n : ℕ), ω n ∈ K} =\n                                  1"},{"axioms":["propext","Classical.choice","Quot.sound"],"direct_constants":["Bool","Unit","Eq.refl","PMF","UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.NoisyFiniteRiskOracleWitness.State","UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.NoisyFiniteRiskOracleWitness.source","Option.some","Bool.false"],"direct_theorem_constants":[],"is_private":false,"level_parameters":[],"name":"UEOT.V3.Compression.TheoryCompletion.Unified