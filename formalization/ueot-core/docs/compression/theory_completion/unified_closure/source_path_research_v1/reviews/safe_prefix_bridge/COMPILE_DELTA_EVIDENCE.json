  "declarations": [
    {
      "name": "stateHistoryEquiv_survival_iff",
      "kind": "theorem",
      "private": false,
      "header": "theorem stateHistoryEquiv_survival_iff\n    {X : Type u} [MeasurableSpace X] (K : Set X) :\n    ∀ (n : ℕ) (h : CausalHistory X X n),\n      stateHistoryEquiv n h ∈ historySurvivalSet Kᶜ n ↔\n        stateSurvives K n h",
      "header_sha256": "69ddb1ab968d45c0081496540e298d495dd7b72fdb90e145f703e37a5afe14bd",
      "complete_header_byte_equal_to_original": true,
      "top_level_delimiter_used": true,
      "proof_body_changed": true,
      "change_scope": "time-zero branch only"
    },
    {
      "name": "actual_safe_prefix_pullback",
      "kind": "theorem",
      "private": false,
      "header": "theorem actual_safe_prefix_pullback\n    {X A : Type u} [MeasurableSpace X] (K : Set X) (n : ℕ) :\n    (stateHistoryEquiv n ∘ eraseActionHistory (X := X) (A := A) n) ⁻¹'\n        historySurvivalSet Kᶜ n =\n      {h : CausalHistory X (A × X) n |\n        ¬ riskEverFailure (fun x => x ∉ K) n h}",
      "header_sha256": "9513942fd930c7f14a35a13d840bde576737be01455aaf922629e21166ed9a0c",
      "complete_header_byte_equal_to_original": true,
      "top_level_delimiter_used": true,
      "proof_body_changed": false,
      "change_scope": "byte identical"
    },
    {
      "name": "homogeneous_survival_real_eq_killed_pow_sum",
      "kind": "theorem",
      "private": false,
      "header": "theorem homogeneous_survival_real_eq_killed_pow_sum\n    {X Y A : Type u} [Fintype X] [Fintype A] [Nonempty A]\n    [MeasurableSpace X] [MeasurableSingletonClass X]\n    [MeasurableSpace A] [MeasurableSingletonClass A]\n    (M : Model X (fun _ => A)) (q : X → Y) (sigma : Y → PMF A)\n    (p0 : PMF X) (K : Set X) (n : ℕ) :\n    (homTrajMeasure p0.toMeasure\n      (pmfRowKernel\n        (policyTransitionPMF M (liftedStationaryPolicy q sigma)))).real\n          (survivalSet Kᶜ n) =\n      ∑ v : K, rowApply (safeInitialRow p0 K)\n        ((killedMatrix M (liftedStationaryPolicy q sigma) K) ^ n) v",
      "header_sha256": "561fd9d4316753f51642d0c7f8a702751b21da2b6648dbfaf540e24f600fd2bf",
      "complete_header_byte_equal_to_original": true,
      "top_level_delimiter_used": true,
      "proof_body_changed": false,
      "change_scope": "byte identical"
    },
    {
      "name": "homogeneous_survival_mass_eq_ofReal_killed_pow_sum",
      "kind": "theorem",
      "private": false,
      "header": "theorem homogeneous_survival_mass_eq_ofReal_killed_pow_sum\n    {X Y A : Type u} [Fintype X] [Fintype A] [Nonempty A]\n    [MeasurableSpace X] [MeasurableSingletonClass X]\n    [MeasurableSpace A] [MeasurableSingletonClass A]\n    (M : Model X (fun _ => A)) (q : X → Y) (sigma : Y → PMF A)\n    (p0 : PMF X) (K : Set X) (n : ℕ) :\n    homTrajMeasure p0.toMeasure\n      (pmfRowKernel\n        (policyTransitionPMF M (liftedStationaryPolicy q sigma)))\n          (survivalSet Kᶜ n) =\n      ENNReal.ofReal (∑ v : K, rowApply (safeInitialRow p0 K)\n        ((killedMatrix M (liftedStationaryPolicy q sigma) K) ^ n) v)",
      "header_sha256": "20e31a6a9144a951e9c848e180d3dc7a353f53a10e81f5c363e09510f992ae84",
      "complete_header_byte_equal_to_original": true,
      "top_level_delimiter_used": true,
      "proof_body_changed": false,
      "change_scope": "byte identical"
    }
  ],
