import UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.RegisterMechanismDecisionNative
import UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.RegisterDecisionObserverSource

/-!
# Joint mechanism/body information from permitted histories

A visible-history likelihood is computed from the new native-derived primitive.
The posterior carries the mechanism and physical state jointly. The same proof
covers arbitrary real causal action probabilities: their visible-history factor
cancels on every positive-mass conditioning event. Zero-mass histories are not
assigned empirical meaning. The reachable 11/00 history shows precisely why the
old S-only deterministic body observer cannot be used unchanged for G.
-/
namespace UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.RegisterMechanismDecisionInformation

open scoped BigOperators
open RegisterMechanismDecisionSource
open RegisterJointDecisionSource (Act Obs Noise primitiveWeight packedLookup initialStore initial_aligned)
open RegisterJointDecisionConsumer (Wallet)
open FiniteJointDecisionBelief FiniteJointDecisionSolver FiniteJointDecisionFilteredModel
open FiniteJointDecisionSupportedPolicy (RawCausalPolicy)

abbrev History := List (Act × Obs)

def historyIntegral (goal : Bool) (r : ℚ) (terminal : World → ℚ) : World → History → ℚ
  | w, [] => terminal w
  | w, (a,o) :: h =>
      ∑ z : Noise, primitiveWeight (fun _ => r) w z *
        if observe goal w a z = o then historyIntegral goal r terminal (step goal w a z) h else 0

def jointFilter (P : Parameters) : Belief World → History → Belief World
  | b, [] => b
  | b, (a,o) :: h => jointFilter P (posterior (source P) b a o) h

def evidenceMass (P : Parameters) : Belief World → History → ℚ
  | _, [] => 1
  | b, (a,o) :: h => mass (source P) b a o * evidenceMass P (posterior (source P) b a o) h

theorem historyInfo_joint (P : Parameters) : ∀ (h : History) (i : Info),
    (RegisterMechanismDecisionSource.historyInfo P i h).1 = jointFilter P i.1 h := by
  intro h
  induction h with
  | nil => intro i; rfl
  | cons e h ih =>
      intro i
      exact ih ((model P).next i e.1 e.2)

/-- Full joint disintegration, including impossible histories without division. -/
theorem history_disintegration (P : Parameters) : ∀ (h : History) (b : Belief World)
    (f : World → ℚ),
    evidenceMass P b h * expect (jointFilter P b h) f =
      expect b (fun w => historyIntegral P.goal P.normal f w h) := by
  intro h
  induction h with
  | nil => intro b f; simp [evidenceMass, jointFilter, historyIntegral]
  | cons e h ih =>
      rcases e with ⟨a,o⟩
      intro b f
      simp only [evidenceMass, jointFilter]
      rw [mul_assoc, ih, posterior_identity]
      simp only [expect, historyIntegral, source, joint, Fintype.sum_prod_type,
        Finset.mul_sum, mul_assoc, mul_ite, ite_mul, mul_zero, zero_mul]
      apply Finset.sum_congr rfl
      intro x hx
      apply Finset.sum_congr rfl
      intro z hz
      apply Finset.sum_congr rfl
      intro label hlabel
      split_ifs <;> ring

noncomputable def actionHistoryWeight {N : Model Info Act Obs} (pi : RawCausalPolicy N) :
    pi.Memory → History → ℝ
  | _, [] => 1
  | q, (a,o) :: h => pi.actionProb q a * actionHistoryWeight pi (pi.advance q a o) h

/-- Full visible history generated by a real randomized, arbitrary-memory
controller. No probability here is allowed to inspect the hidden world. -/
noncomputable def rawHistoryIntegral (P : Parameters) {N : Model Info Act Obs}
    (pi : RawCausalPolicy N) (f : World → ℚ) : pi.Memory → World → History → ℝ
  | _, w, [] => (f w : ℝ)
  | q, w, (a,o) :: h => pi.actionProb q a *
      ∑ z : Noise, ((source P).chance w z : ℝ) *
        if observe P.goal w a z = o then
          rawHistoryIntegral P pi f (pi.advance q a o) (step P.goal w a z) h else 0

/-- Policy factors depend on the delivered history, and therefore do not change
relative weights of its compatible hidden mechanism/body paths. -/
theorem rawHistory_factor (P : Parameters) {N : Model Info Act Obs}
    (pi : RawCausalPolicy N) (f : World → ℚ) : ∀ (h : History) (q : pi.Memory) (w : World),
    rawHistoryIntegral P pi f q w h = actionHistoryWeight pi q h *
      (historyIntegral P.goal P.normal f w h : ℝ) := by
  intro h
  induction h with
  | nil => intros; simp [rawHistoryIntegral, actionHistoryWeight, historyIntegral]
  | cons e h ih =>
      rcases e with ⟨a,o⟩
      intro q w
      simp only [rawHistoryIntegral, actionHistoryWeight, historyIntegral, Rat.cast_sum,
        Rat.cast_mul, source]
      rw [mul_assoc]
      apply congrArg (fun t : ℝ => pi.actionProb q a * t)
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro z hz
      split_ifs with ho
      · rw [ih]
        push_cast
        ring
      · simp

theorem raw_joint_history_identity (P : Parameters) {N : Model Info Act Obs}
    (pi : RawCausalPolicy N) (f : World → ℚ) (h : History) (q : pi.Memory) (b : Belief World) :
    expectReal b (fun w => rawHistoryIntegral P pi f q w h) =
      actionHistoryWeight pi q h *
        (evidenceMass P b h * expect (jointFilter P b h) f : ℚ) := by
  simp_rw [rawHistory_factor]
  rw [expectReal_mul, expectReal_of_rat, ← history_disintegration]

/-- The normalized joint posterior is correct under any allowed real causal
kernel, provided the ACTUAL conditioning event has positive probability. -/
theorem real_policy_joint_posterior (P : Parameters) {N : Model Info Act Obs}
    (pi : RawCausalPolicy N) (f : World → ℚ) (h : History) (q : pi.Memory) (b : Belief World)
    (hpos : 0 < expectReal b (fun w => rawHistoryIntegral P pi (fun _ => 1) q w h)) :
    expectReal b (fun w => rawHistoryIntegral P pi f q w h) /
        expectReal b (fun w => rawHistoryIntegral P pi (fun _ => 1) q w h) =
      (expect (jointFilter P b h) f : ℝ) := by
  rw [raw_joint_history_identity, raw_joint_history_identity, expect_const] at *
  simp only [mul_one, Rat.cast_mul] at *
  have hn : actionHistoryWeight pi q h * (evidenceMass P b h : ℝ) ≠ 0 := ne_of_gt hpos
  apply (div_eq_iff hn).2
  ring

def rootWrite (goal : Bool) : Act := some (false, some goal)
def rootIdle : Act := some (false, none)
def childIdle : Act := some (true, none)

def ambiguousPrefix (goal : Bool) : Table Act Obs 2 :=
  .node (rootWrite goal) (fun _ => .node rootIdle (fun _ => .halt))

def ambiguousHistory (goal : Bool) : History :=
  [(rootWrite goal,(true,true)), (rootIdle,(false,false))]

def ambiguousWorld (goal : Bool) (m : FaultMechanism) : World :=
  ⟨m, [some (!goal), some (if m = .S then goal else !goal), none], false⟩

/-- Same reachable visible prefix, different actual child state. Labels remain
arbitrary and hidden; no favorable label or resampled failed tape is selected. -/
theorem ambiguous_actual (goal : Bool) (m : FaultMechanism) (l₀ l₁ : Bool) :
    (packedExecute goal (ambiguousPrefix goal) (initialWorld goal m)
      ![(true,l₀),(false,l₁)]).history = ambiguousHistory goal ∧
    (packedExecute goal (ambiguousPrefix goal) (initialWorld goal m)
      ![(true,l₀),(false,l₁)]).finalWorld = ambiguousWorld goal m := by
  cases goal <;> cases m <;> exact ⟨rfl, rfl⟩

/-- Full terminal test identity: the event retains a correlation between the
mechanism and child state, not just two independent marginals. -/
theorem ambiguous_integral (goal : Bool) (r : ℚ) (m : FaultMechanism) (f : World → ℚ) :
    historyIntegral goal r f (initialWorld goal m) (ambiguousHistory goal) =
      r * (1-r) * f (ambiguousWorld goal m) := by
  cases goal <;> cases m <;>
    simp [historyIntegral, ambiguousHistory, rootWrite, rootIdle, initialWorld,
      ambiguousWorld, observe, step, damagePacked, RegisterJointDecisionSource.observe,
      RegisterJointDecisionSource.step, RegisterJointDecisionSource.effective,
      RegisterJointDecisionSource.address, RegisterJointDecisionSource.packedObserve,
      RegisterJointDecisionSource.packedNext, RegisterJointDecisionSource.packedLookup,
      RegisterJointDecisionSource.postBit, RegisterJointDecisionSource.childBit,
      primitiveWeight, Fintype.sum_prod_type, Fintype.sum_bool] <;> ring

theorem ambiguous_likelihood (goal : Bool) (r : ℚ) (m : FaultMechanism) :
    historyIntegral goal r (fun _ => 1) (initialWorld goal m) (ambiguousHistory goal) = r*(1-r) := by
  rw [ambiguous_integral, mul_one]

theorem ambiguous_positive (goal : Bool) (r : ℚ) (m : FaultMechanism)
    (h0 : 0 < r) (h1 : r < 1) :
    0 < historyIntegral goal r (fun _ => 1) (initialWorld goal m) (ambiguousHistory goal) := by
  rw [ambiguous_likelihood]
  exact mul_pos h0 (sub_pos.mpr h1)

theorem ambiguous_prior_joint (P : Parameters) (prior : FaultMechanism → ℚ)
    (hn : ∀ m, 0 ≤ prior m) (ht : ∑ m, prior m = 1) (f : World → ℚ) :
    expect (initialBelief P.goal prior hn ht)
      (fun w => historyIntegral P.goal P.normal f w (ambiguousHistory P.goal)) =
      P.normal * (1-P.normal) * ∑ m, prior m * f (ambiguousWorld P.goal m) := by
  simp only [expect, initialBelief]
  simp_rw [ambiguous_integral]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  ring

theorem ambiguous_evidence_mass (P : Parameters) (prior : FaultMechanism → ℚ)
    (hn : ∀ m, 0 ≤ prior m) (ht : ∑ m, prior m = 1) :
    evidenceMass P (initialBelief P.goal prior hn ht) (ambiguousHistory P.goal) =
      P.normal * (1-P.normal) := by
  have h := history_disintegration P (ambiguousHistory P.goal)
    (initialBelief P.goal prior hn ht) (fun _ => 1)
  rw [expect_const, mul_one, ambiguous_prior_joint] at h
  simpa [ht] using h

/-- Any prior, including zero mechanism weights. Positive denominators are
proved from 0<r<1; no posterior assertion is made on an impossible prefix. -/
theorem ambiguous_joint_posterior (P : Parameters) (prior : FaultMechanism → ℚ)
    (hn : ∀ m, 0 ≤ prior m) (ht : ∑ m, prior m = 1)
    (h0 : 0 < P.normal) (h1 : P.normal < 1) (f : World → ℚ) :
    expect (jointFilter P (initialBelief P.goal prior hn ht) (ambiguousHistory P.goal)) f =
      ∑ m, prior m * f (ambiguousWorld P.goal m) := by
  have h := history_disintegration P (ambiguousHistory P.goal)
    (initialBelief P.goal prior hn ht) f
  rw [ambiguous_evidence_mass, ambiguous_prior_joint] at h
  exact (mul_left_cancel₀ (ne_of_gt (mul_pos h0 (sub_pos.mpr h1)))) h

/-- The same receipt fold continues to be correct in S, and fails in the newly
introduced G source at a positive-probability prefix. This does not reopen the
old S theorem: its source hypothesis is exactly the boundary being tested. -/
theorem old_observer_migration_failure :
    (RegisterDecisionObserver.summarize true (ambiguousHistory true)).q.child = some true ∧
    packedLookup (ambiguousWorld true .S).store 1 = some true ∧
    packedLookup (ambiguousWorld true .G).store 1 = some false ∧
    (RegisterDecisionObserver.summarize true (ambiguousHistory true)).q ≠
      RegisterDecisionObserverSource.projectLocal true (ambiguousWorld true .G) := by
  decide

/-- Forgetting mechanism/body correlation loses a prediction for a legal
next request even though both mechanisms gave the same 11/00 prefix. -/
theorem ambiguous_next_receipts (goal : Bool) (label : Bool) :
    observe goal (ambiguousWorld goal .S) childIdle (true,label) = (true,false) ∧
    observe goal (ambiguousWorld goal .G) childIdle (true,label) = (false,false) := by
  cases goal <;> exact ⟨rfl, rfl⟩

end UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.RegisterMechanismDecisionInformation
