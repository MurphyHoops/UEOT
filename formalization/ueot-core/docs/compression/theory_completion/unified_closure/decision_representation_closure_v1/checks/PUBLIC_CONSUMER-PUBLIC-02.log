  {Theta : Type} [Fintype Theta] {n : ℕ} (P : RegisterJointDecisionConsumer.Family Theta) (j : Fin n)
  (prior : Theta → ℚ) (hn : ∀ (t : Theta), 0 ≤ prior t) (ht : ∑ t, prior t = 1)
