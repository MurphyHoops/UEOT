      RegisterJointDecisionSource.Obs)
  (H : ℕ) (i : RegisterJointDecisionConsumer.Info Theta) (R : RegisterJointDecisionNativeConsumer.Realization P j i.1)
  (st : RegisterDecisionObserver.Stat) (cursor : Option ℕ)
