      have execution :=
        RegisterDecisionRepresentationNative.nativeRun j (RegisterJointDecisionNativeConsumer.mechanism P) M G H st
          cursor (R.world x) (RegisterJointDecisionNativeConsumer.tapeVector noise);
      have paid := (List.take k (List.map RegisterJointDecisionSource.nativeFee execution.records)).sum;
      have summary := RegisterDecisionObserver.summarizeFrom P.goal st (List.take k execution.history);
