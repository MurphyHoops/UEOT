import UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.CoreRegenerativeRepair
import UEOT.V3.Compression.CrossTrack.EndogenousCandidateFormation

/-!
# Source-derived formation and physical component cuts

The four histories are literal physical initial bodies: two encoded programs,
each healthy or damaged.  The response is the actual next-tick newborn event,
obtained by pushing the primitive 36-atom source law through `programStep`.
No response probability, formed parent, or successful recovery is an input.

This is a finite operational formation witness.  It does not supply the old
strong almost-sure persistence premise for an immortal population.
-/

namespace UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.CoreRegenerativeSource

open MeasureTheory
open UEOT.V3.Compression.CrossTrack
open UEOT.V3.CoreOperationalAssembly UEOT.V3.CompositionCarrierLift
open UEOT.V3.StatisticalDefect UEOT.V3.TotalVariation
open scoped BigOperators

abbrev PhysicalCell := Fin 8
abbrev SourceHistory := Bool × Bool

/-- Exactly the six code cells, main execution gate, and bootstrap status. -/
def physicalCell (x : Body) : PhysicalCell → Bool :=
  ![x.rowH.active, x.rowH.backup1, x.rowH.backup2,
    x.rowD.active, x.rowD.backup1, x.rowD.backup2, x.gate, x.bootstrap]

def physicalReadout (S : Finset PhysicalCell) (h : SourceHistory) : PhysicalCell → Option Bool :=
  fun v => if v ∈ S then some (physicalCell (programBody h.1 h.2 false) v) else none

def componentRegion (v : PhysicalCell) : Finset PhysicalCell := {v}

/-- Full declared physical readings identify these source initial states. -/
theorem physicalReadout_full_injective :
    Function.Injective (physicalReadout Finset.univ) := by
  rintro ⟨theta, i⟩ ⟨theta', i'⟩ h
  have hcode := congrFun h (1 : PhysicalCell)
  have hgate := congrFun h (6 : PhysicalCell)
  cases theta <;> cases i <;> cases theta' <;> cases i' <;>
    simp_all [physicalReadout, physicalCell, programBody, damageBody, encode,
      repeatBit, flipActive]

noncomputable def sourceNoisePMF (p : Parameters) (hp : Valid p) : PMF Noise :=
  PMF.ofFintype (fun z => ENNReal.ofReal (noiseWeight p z)) (by
    rw [← ENNReal.ofReal_sum_of_nonneg (fun z _ => (noiseWeight_pos p hp z).le)]
    rw [noiseWeight_sum]
    simp)

theorem sourceNoisePMF_apply (p : Parameters) (hp : Valid p) (z : Noise) :
    sourceNoisePMF p hp z = ENNReal.ofReal (noiseWeight p z) := rfl

/-- Future response is generated by executing the real program on real local noise. -/
noncomputable def newbornResponse (p : Parameters) (hp : Valid p) (x : Body) : Measure Bool :=
  (PMF.map (fun z => (programStep x z).newborn.isSome) (sourceNoisePMF p hp)).toMeasure

noncomputable def sourceResponse (p : Parameters) (hp : Valid p)
    (h : SourceHistory) (_ : Unit) : Measure Bool :=
  newbornResponse p hp (programBody h.1 h.2 false)

theorem sourceResponse_probability (p : Parameters) (hp : Valid p)
    (h : SourceHistory) (u : Unit) : IsProbabilityMeasure (sourceResponse p hp h u) := by
  unfold sourceResponse newbornResponse
  infer_instance

theorem birthIndicatorMean (p : Parameters) (a : Action) :
    (∑ z : Noise, noiseWeight p z * (if births a z then 1 else 0)) = birthRate p a := by
  cases a <;>
    simp [Noise, noiseWeight, survivalWeight, birthWeight, damageWeight,
      birthRate, births, Fintype.sum_prod_type, Fin.sum_univ_succ] <;> ring

/-- The probability of the true newborn output is calculated from actual execution. -/
theorem sourceResponse_true (p : Parameters) (hp : Valid p) (h : SourceHistory) :
    sourceResponse p hp h () {true} =
      ENNReal.ofReal (birthRate p (programAction h.1 h.2)) := by
  unfold sourceResponse newbornResponse
  rw [PMF.toMeasure_apply_singleton _ _ (by measurability), PMF.map_apply, tsum_fintype]
  simp only [sourceNoisePMF_apply]
  have ht : ∀ z : Noise,
      (if true = (programStep (programBody h.1 h.2 false) z).newborn.isSome then
        ENNReal.ofReal (noiseWeight p z) else 0) =
      ENNReal.ofReal (noiseWeight p z * (if births (programAction h.1 h.2) z then 1 else 0)) := by
    intro z
    rw [program_step_executes]
    cases hb : births (programAction h.1 h.2) z <;> simp [executedResult, hb]
  calc
    _ = ∑ z : Noise, ENNReal.ofReal
        (noiseWeight p z * (if births (programAction h.1 h.2) z then 1 else 0)) := by
      apply Finset.sum_congr rfl
      intro z _
      have hz := ht z
      split_ifs at hz ⊢ <;> simp_all
    _ = ENNReal.ofReal (birthRate p (programAction h.1 h.2)) := by
      rw [← ENNReal.ofReal_sum_of_nonneg]
      · rw [birthIndicatorMean]
      · intro z _
        exact mul_nonneg (noiseWeight_pos p hp z).le (by split <;> norm_num)

/-- Two actual physical programs induce different actual future response laws. -/
theorem sourceResponse_nontrivial (p : Parameters) (hp : Valid p) :
    sourceResponse p hp (false, false) () ≠ sourceResponse p hp (true, false) () := by
  intro h
  have he := congrArg (fun μ : Measure Bool => μ {true}) h
  rw [sourceResponse_true, sourceResponse_true] at he
  have ht := congrArg ENNReal.toReal he
  have hb : 0 ≤ p.commonBirth := hp.commonBirth_pos.le
  have hbg : 0 ≤ p.commonBirth + p.bloomOnly := by
    linarith [hp.commonBirth_pos, hp.advantage, hp.careOnly_pos]
  simp only [programAction, Bool.false_eq_true, ↓reduceIte, birthRate] at ht
  rw [ENNReal.toReal_ofReal hb, ENNReal.toReal_ofReal hbg] at ht
  linarith [hp.advantage, hp.careOnly_pos]

theorem full_physical_seed_zero_defect (p : Parameters) (hp : Valid p) :
    responseDefect physicalReadout (sourceResponse p hp) Finset.univ = 0 := by
  have hs : responseDiameterSet physicalReadout (sourceResponse p hp) Finset.univ = {0} := by
    ext d
    constructor
    · rintro ⟨h, h', u, he, rfl⟩
      have hh := physicalReadout_full_injective he
      subst h'
      letI := sourceResponse_probability p hp h u
      simp [tvDist_self_eq_zero]
    · intro hd
      have hd0 : d = 0 := by simpa using hd
      subst d
      refine ⟨(false, false), (false, false), (), rfl, ?_⟩
      letI := sourceResponse_probability p hp (false, false) ()
      simp [tvDist_self_eq_zero]
  rw [responseDefect, hs]
  simp

theorem physical_children_cover_seed :
    coalitionCovers componentRegion Finset.univ Finset.univ := by
  intro v _
  exact ⟨v, Finset.mem_univ v, by simp [componentRegion]⟩

/-- The old finite formation theorem is consumed with a proved physical source seed. -/
theorem actual_formed_candidate_family_nonempty (p : Parameters) (hp : Valid p) :
    (responseFormedCandidateFamily physicalReadout (sourceResponse p hp) componentRegion).Nonempty :=
  responseFormedCandidateFamily_nonempty_of_zeroDefectSeed
    physicalReadout (sourceResponse p hp) componentRegion Finset.univ
    (full_physical_seed_zero_defect p hp) physical_children_cover_seed

theorem cut_bootstrap_programStep (theta tag : Bool) (z : Noise) :
    programStep { programBody theta true tag with bootstrap := false } z =
      ⟨some { programBody theta true tag with bootstrap := false }, none, 0, 0, 5, .rejected⟩ := by
  cases theta <;> cases tag <;> rfl

theorem cut_bootstrap_newbornResponse_true (p : Parameters) (hp : Valid p) (theta tag : Bool) :
    newbornResponse p hp { programBody theta true tag with bootstrap := false } {true} = 0 := by
  unfold newbornResponse
  rw [PMF.toMeasure_apply_singleton _ _ (by measurability), PMF.map_apply, tsum_fintype]
  simp [cut_bootstrap_programStep]

/-- Cutting a real execution-support component changes the real future, under the same law. -/
theorem bootstrap_cut_changes_future (p : Parameters) (hp : Valid p) :
    sourceResponse p hp (true, true) () ≠
      newbornResponse p hp { programBody true true false with bootstrap := false } := by
  intro h
  have he := congrArg (fun μ : Measure Bool => μ {true}) h
  rw [sourceResponse_true, cut_bootstrap_newbornResponse_true] at he
  have ht := congrArg ENNReal.toReal he
  simp only [programAction, ↓reduceIte, birthRate, ENNReal.toReal_zero] at ht
  rw [ENNReal.toReal_ofReal hp.commonBirth_pos.le] at ht
  exact (ne_of_gt hp.commonBirth_pos) ht

end UEOT.V3.Compression.TheoryCompletion.UnifiedClosure.CoreRegenerativeSource
