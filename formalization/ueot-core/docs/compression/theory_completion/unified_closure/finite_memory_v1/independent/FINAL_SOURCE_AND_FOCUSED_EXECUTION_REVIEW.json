      "current_sha256": "a16ebe2b2e930623adf4f7ab40783af595387e3a1ee9726e6e7b98373454934a",
      "diff": "--- STATIC_REVIEW_03 source\n+++ final frozen source\n@@ -59,7 +59,7 @@\n     finiteMemoryCheck q R C initial = true ↔\n       ∀ y : Y, (initialSupport p₀ q y).Nonempty →\n         initialSupport p₀ q y ∈ supportWinning q R C := by\n-  letI : ∀ n x a z, Decidable (z ∈ (P n x a).support) :=\n+  let : ∀ n x a z, Decidable (z ∈ (P n x a).support) :=\n     fun _ _ _ _ => Classical.propDecidable _\n   let B : ℕ := 2 ^ Fintype.card X - 1\n   have hB : supportArenaCard q ≤ B := by\n"
    },
    {
      "path": "formalization/ueot-core/UEOT/V3/Compression/TheoryCompletion/UnifiedClosure/FiniteMemorySeparation.lean",
      "previous_sha256": "9904a25670122e4087ff3735da930508f73d94799278afb845c374d1b7d643ff",
      "current_sha256": "1c52baa3e029b45420ce7b393ee2d42479f7cc994f56f921222fdf7ac756ffa8",
      "diff": "--- STATIC_REVIEW_03 source\n+++ final frozen source\n@@ -106,11 +106,11 @@\n       intro h _\n       by_cases hh : h ∈ (microLaw initial observe source (stationaryPolicy ρ) n).support\n       · have hlast := hstate h hh\n-        cases x <;> simp [stationaryPolicy, certified, hlast, Fintype.sum_bool]\n+        cases x <;> simp [stationaryPolicy, certified, hlast]\n       · have hz : microLaw initial observe source (stationaryPolicy ρ) n h = 0 := by\n           by_contra hne\n           exact hh ((PMF.mem_support_iff _ _).mpr hne)\n-        simp only [hz, ENNReal.zero_toReal, zero_mul]\n+        simp only [hz, ENNReal.toReal_zero, zero_mul]\n     _ = _ := by\n       rw [← Finset.sum_mul, coverage_sum_toReal, one_mul]\n \n@@ -122,7 +122,8 @@\n         {xa | ¬ certified 0 xa.1 xa.2} = (ρ true).toReal := by\n   apply stationary_uncovered_of_supported_state ρ 0 false\n   intro h hh\n-  change h ∈ (PMF.pure false).support at hh\n+  change Bool at h\n+  change h ∈ (PMF.pure false : PMF Bool).support at hh\n   change h = false\n   simpa only [PMF.support_pure, Set.mem_singleton_iff] using hh\n \n@@ -134,10 +135,11 @@\n         {xa | ¬ certified 1 xa.1 xa.2} = (ρ false).toReal := by\n   apply stationary_uncovered_of_supported_state ρ 1 true\n   rintro ⟨b, a, z⟩ hh\n+  change Bool at b\n   have hs := (mem_microLaw_succ_support_iff\n     initial observe source (stationaryPolicy ρ) 0 b a z).mp hh\n   have hb_support := hs.1\n-  change b ∈ (PMF.pure false).support at hb_support\n+  change b ∈ (PMF.pure false : PMF Bool).support at hb_support\n   have hb : b = false := by\n     simpa only [PMF.support_pure, Set.mem_singleton_iff] using hb_support\n   have hz_support := hs.2.2\n"
    }
  ],
